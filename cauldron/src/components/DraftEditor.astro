---
const fields = [
  { label: 'Title', name: 'title', placeholder: 'Cozy Games for Rainy Nights' },
  { label: 'Slug', name: 'slug', placeholder: 'cozy-games-rainy-nights' },
  { label: 'Excerpt', name: 'excerpt', placeholder: 'A gentle guide to unwind with whimsical games.' },
  { label: 'Meta Description', name: 'metaDescription', placeholder: 'Preview copy for the meta description.' },
  { label: 'Tags', name: 'tags', placeholder: 'cozy, games, slow living' },
];
---
<section class="flex-1 overflow-y-auto border-r border-slate-950/60 bg-slate-950/30 px-8 py-8">
  <header class="max-w-2xl space-y-2">
    <p class="text-[0.7rem] uppercase tracking-[0.35em] text-slate-500">Editor</p>
    <h2 class="text-xl font-semibold text-slate-100">Shape your draft details</h2>
    <p class="text-sm leading-relaxed text-slate-400">
      These form controls will wire up to real data soon. For now, they outline the structure and rhythm of the editing experience.
    </p>
  </header>
  <form class="mt-8 space-y-6">
    {fields.map((field) => (
      <div class="space-y-2">
        <label for={field.name} class="text-[0.7rem] font-semibold uppercase tracking-[0.35em] text-slate-500">
          {field.label}
        </label>
        <input
          id={field.name}
          type="text"
          name={field.name}
          placeholder={field.placeholder}
          class="shadow-[inset_0_1px_0_rgba(15,23,42,0.6)]"
          disabled
        />
      </div>
    ))}
    <div class="space-y-2">
      <label for="sections" class="text-[0.7rem] font-semibold uppercase tracking-[0.35em] text-slate-500">
        Sections
      </label>
      <textarea
        id="sections"
        rows={8}
        placeholder="Markdown sections will be editable in the next iteration."
        class="resize-y shadow-[inset_0_1px_0_rgba(15,23,42,0.6)]"
        disabled
      />
    </div>
  </form>
</section>
