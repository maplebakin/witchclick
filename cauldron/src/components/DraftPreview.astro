---
const samplePreview = {
  title: 'Cozy Games for Rainy Nights',
  excerpt: 'A soft-focus collection of games that feel like warm tea and candlelight.',
  sections: [
    '### Why cozy games matter\nThey give you gentle goals and the freedom to wander.',
    '### Starter bundle\n- Stardew Valley\n- Alba: A Wildlife Adventure\n- Unpacking',
  ],
};
---
<section class="w-[360px] min-w-[320px] border-l border-slate-950/60 bg-slate-950/35 px-6 py-8 text-slate-200">
  <header class="space-y-1">
    <p class="text-[0.7rem] uppercase tracking-[0.35em] text-slate-500">Preview</p>
    <h2 class="text-lg font-semibold text-slate-100">Live rendering placeholder</h2>
    <p class="text-sm text-slate-400">This pane will reflect the WitchClick article template.</p>
  </header>
  <article class="mt-6 space-y-5 rounded-xl border border-slate-900/60 bg-slate-950/40 px-6 py-6 shadow-[0_12px_30px_rgba(15,23,42,0.45)]">
    <div class="space-y-2">
      <h1 class="text-2xl font-semibold text-slate-100">{samplePreview.title}</h1>
      <p class="text-sm text-slate-400">{samplePreview.excerpt}</p>
    </div>
    <div class="space-y-4 text-sm leading-relaxed">
      {samplePreview.sections.map((section) => (
        <section class="rounded-lg border border-slate-900/60 bg-slate-950/50 px-4 py-3">
          <div class="prose prose-invert prose-sm max-w-none text-slate-300" innerHTML={section} />
        </section>
      ))}
    </div>
  </article>
</section>
