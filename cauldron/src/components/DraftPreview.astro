---
const samplePreview = {
  title: 'Cozy Games for Rainy Nights',
  excerpt: 'A soft-focus collection of games that feel like warm tea and candlelight.',
  sections: [
    '### Why cozy games matter\nThey give you gentle goals and the freedom to wander.',
    '### Starter bundle\n- Stardew Valley\n- Alba: A Wildlife Adventure\n- Unpacking',
  ],
};
---
<section class="w-1/3 min-w-[320px] border-l border-slate-800/70 bg-slate-950/50 p-6 text-slate-200">
  <header class="mb-6">
    <h2 class="text-lg font-semibold text-slate-100">Live Preview (Placeholder)</h2>
    <p class="mt-1 text-sm text-slate-400">The real preview will mirror WitchClick’s layout.</p>
  </header>
  <article class="space-y-4">
    <div>
      <h1 class="text-2xl font-bold text-lime-200">{samplePreview.title}</h1>
      <p class="mt-2 text-sm text-slate-300">{samplePreview.excerpt}</p>
    </div>
    <div class="space-y-4 text-sm leading-relaxed">
      {samplePreview.sections.map((section) => (
        <section class="rounded border border-slate-800/60 bg-slate-900/60 p-4">
          <div innerHTML={section} />
        </section>
      ))}
    </div>
  </article>
</section>
