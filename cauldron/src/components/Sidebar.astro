---
const sections = [
  { label: 'Ideas', drafts: ['cozy-games.json'] },
  { label: 'In Progress', drafts: ['burnout-kit.json'] },
  { label: 'Ready to Publish', drafts: [] },
];
---
<aside class="hidden w-72 min-h-full flex-col border-r border-slate-950/70 bg-slate-950 px-5 py-6 text-slate-200 shadow-[inset_0_1px_0_rgba(148,163,184,0.03)] lg:flex">
  <header>
    <p class="text-[0.7rem] uppercase tracking-[0.35em] text-slate-500">Draft Library</p>
    <h2 class="mt-2 text-sm font-semibold text-slate-100">Work-in-progress files</h2>
  </header>
  <nav class="mt-6 flex-1 overflow-y-auto text-sm">
    <ul class="space-y-6">
      {sections.map((section) => (
        <li>
          <div class="flex items-center gap-2 text-[0.65rem] uppercase tracking-[0.4em] text-slate-500">
            <span aria-hidden="true" class="text-slate-700">▾</span>
            <span>{section.label}</span>
          </div>
          <ul class="mt-3 space-y-1 border-l border-slate-900/80 pl-4 text-xs">
            {section.drafts.length === 0 ? (
              <li class="pl-3 text-[0.7rem] italic text-slate-600">No drafts yet</li>
            ) : (
              section.drafts.map((draft) => (
                <li>
                  <a
                    href="#"
                    class="group flex items-center gap-2 rounded-md px-2 py-2 text-slate-300 transition-colors duration-150 ease-out hover:bg-slate-900/80 hover:text-white focus-visible:bg-slate-900/80 focus-visible:text-white"
                  >
                    <span aria-hidden="true" class="text-slate-600 transition-colors duration-150 ease-out group-hover:text-white">▸</span>
                    <span class="truncate">{draft}</span>
                  </a>
                </li>
              ))
            )}
          </ul>
        </li>
      ))}
    </ul>
  </nav>
</aside>
