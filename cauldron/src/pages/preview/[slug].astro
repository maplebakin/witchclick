---
import AppLayout from '../../layouts/AppLayout.astro';
import { Markdown } from 'astro/components';
import { readdir, readFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const cauldronRoot = path.resolve(__dirname, '..', '..', '..');
const draftsDir = path.join(cauldronRoot, 'drafts');

export async function getStaticPaths() {
  const files = await readdir(draftsDir);
  const jsonFiles = files.filter((file) => file.endsWith('.json')).sort();

  const draftEntries = await Promise.all(
    jsonFiles.map(async (file) => {
      const slug = file.replace(/\.json$/, '');
      const raw = await readFile(path.join(draftsDir, file), 'utf8');
      const data = JSON.parse(raw);
      return {
        slug,
        title: typeof data.title === 'string' ? data.title : slug,
        status: typeof data.status === 'string' ? data.status : 'draft',
        payload: data,
      };
    })
  );

  return draftEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      slug: entry.slug,
      spec: entry.payload,
      drafts: draftEntries.map(({ slug, title, status }) => ({ slug, title, status })),
    },
  }));
}

interface OutlineItem {
  heading?: string;
  id?: string;
}

interface Section {
  heading?: string;
  markdown?: string;
}

const { spec, slug, drafts } = Astro.props as {
  spec: Record<string, any>;
  slug: string;
  drafts: { slug: string; title: string; status?: string }[];
};

const sections: Section[] = Array.isArray(spec.sections) ? spec.sections : [];
const outline: OutlineItem[] = Array.isArray(spec.outline) ? spec.outline : [];
---
<AppLayout drafts={drafts} activeSlug={slug} title={spec.title ?? 'Draft Preview'}>
  <article class="flex flex-col gap-8">
    <header class="border-b border-slate-800 pb-4">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Slug: {slug}</p>
          <h2 class="mt-2 text-3xl font-semibold text-slate-100">{spec.title ?? 'Untitled draft'}</h2>
          <p class="mt-2 max-w-2xl text-sm text-slate-300">{spec.metaDescription ?? spec.excerpt}</p>
        </div>
        <div class="flex flex-col items-end gap-1 text-right text-xs text-slate-400">
          <span>Tags: {Array.isArray(spec.tags) ? spec.tags.join(', ') : '—'}</span>
          <span>Status: {spec.status ?? 'draft'}</span>
        </div>
      </div>
    </header>

    <section class="grid gap-6 xl:grid-cols-[260px_minmax(0,1fr)]">
      <div class="rounded-lg border border-slate-800 bg-slate-900/60 p-4">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Outline</h3>
        <ol class="mt-3 space-y-2 text-sm text-slate-300">
          {outline.length === 0 ? (
            <li class="text-slate-500">No outline provided.</li>
          ) : (
            outline.map((item, index) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 h-5 w-5 shrink-0 rounded-full bg-indigo-500/20 text-center text-xs font-semibold text-indigo-200">
                  {index + 1}
                </span>
                <div>
                  <p class="font-medium text-slate-100">{item.heading ?? 'Untitled section'}</p>
                  {item.id && <p class="text-xs text-slate-500">#{item.id}</p>}
                </div>
              </li>
            ))
          )}
        </ol>
      </div>
      <div class="space-y-8">
        {sections.length === 0 ? (
          <p class="text-slate-400">No sections to display yet. Start adding ritual content to the JSON file.</p>
        ) : (
          sections.map((section) => (
            <section class="rounded-lg border border-slate-800 bg-slate-900/40 p-5 shadow-inner">
              <header class="mb-4 border-b border-slate-800 pb-2">
                <h3 class="text-lg font-semibold text-slate-100">{section.heading ?? 'Untitled section'}</h3>
              </header>
              <div class="prose prose-invert max-w-none text-sm leading-relaxed">
                {section.markdown ? (
                  <Markdown content={section.markdown} />
                ) : (
                  <p class="italic text-slate-500">No markdown provided.</p>
                )}
              </div>
            </section>
          ))
        )}
      </div>
    </section>

    <section class="grid gap-4 xl:grid-cols-3">
      <div class="rounded-lg border border-slate-800 bg-slate-900/60 p-4 text-sm text-slate-300">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Entities</h3>
        <ul class="mt-3 space-y-2">
          {Array.isArray(spec.entities) && spec.entities.length > 0 ? (
            spec.entities.map((entity) => (
              <li class="rounded border border-slate-800/60 bg-slate-900/40 p-3">
                <p class="font-medium text-slate-100">{entity.name ?? 'Unnamed entity'}</p>
                <p class="text-xs uppercase tracking-wide text-indigo-300">{entity.type ?? '—'}</p>
                {entity.summary && <p class="mt-2 text-xs text-slate-400">{entity.summary}</p>}
              </li>
            ))
          ) : (
            <li class="text-slate-500">No entities defined.</li>
          )}
        </ul>
      </div>
      <div class="rounded-lg border border-slate-800 bg-slate-900/60 p-4 text-sm text-slate-300">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Internal link hints</h3>
        <ul class="mt-3 space-y-2">
          {Array.isArray(spec.internalLinkHints) && spec.internalLinkHints.length > 0 ? (
            spec.internalLinkHints.map((hint) => (
              <li class="rounded border border-slate-800/60 bg-slate-900/40 p-3">
                <p class="font-medium text-slate-100">{hint.anchor ?? 'Anchor missing'}</p>
                {hint.rationale && <p class="mt-2 text-xs text-slate-400">{hint.rationale}</p>}
              </li>
            ))
          ) : (
            <li class="text-slate-500">No internal link hints yet.</li>
          )}
        </ul>
      </div>
      <div class="rounded-lg border border-slate-800 bg-slate-900/60 p-4 text-sm text-slate-300">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-300">CTA & Ads</h3>
        <div class="mt-3 space-y-3">
          <div class="rounded border border-indigo-500/40 bg-indigo-500/10 p-3">
            <p class="text-xs uppercase tracking-wide text-indigo-200">{spec.cta?.type ?? 'No CTA'}</p>
            {spec.cta?.headline && <p class="mt-2 text-base font-semibold text-slate-100">{spec.cta.headline}</p>}
            {spec.cta?.body && <p class="mt-2 text-xs text-slate-300">{spec.cta.body}</p>}
            {spec.cta?.buttonLabel && <p class="mt-2 text-xs font-semibold text-indigo-200">Button: {spec.cta.buttonLabel}</p>}
          </div>
          <div class="rounded border border-slate-800/60 bg-slate-900/40 p-3">
            <p class="text-xs uppercase tracking-wide text-slate-400">Ad placements</p>
            <p class="mt-1 text-sm text-slate-200">
              {Array.isArray(spec.adPlacements) && spec.adPlacements.length > 0
                ? spec.adPlacements.join(', ')
                : 'None specified'}
            </p>
          </div>
          <div class="rounded border border-slate-800/60 bg-slate-900/40 p-3">
            <p class="text-xs uppercase tracking-wide text-slate-400">Affiliate hints</p>
            <ul class="mt-2 space-y-2">
              {Array.isArray(spec.affiliateHints) && spec.affiliateHints.length > 0 ? (
                spec.affiliateHints.map((hint) => (
                  <li class="rounded border border-slate-800/60 bg-slate-900/20 p-2">
                    <p class="font-medium text-slate-100">{hint.product ?? hint.key ?? 'Unnamed product'}</p>
                    {hint.rationale && <p class="text-xs text-slate-400">{hint.rationale}</p>}
                  </li>
                ))
              ) : (
                <li class="text-slate-500">No affiliate hints.</li>
              )}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-lg border border-slate-800 bg-slate-900/40 p-4 text-xs text-slate-400">
      <details>
        <summary class="cursor-pointer text-sm font-semibold text-slate-200">Raw spec JSON</summary>
        <pre class="mt-4 max-h-96 overflow-auto rounded bg-slate-950/80 p-4 text-[11px] leading-relaxed">{JSON.stringify(spec, null, 2)}</pre>
      </details>
    </section>
  </article>
</AppLayout>
