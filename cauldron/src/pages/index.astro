---
import AppLayout from '../layouts/AppLayout.astro';
import { readdir, readFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, '..', '..');
const draftsDir = path.join(rootDir, 'drafts');

const draftFiles = await readdir(draftsDir);
const drafts = await Promise.all(
  draftFiles
    .filter((file) => file.endsWith('.json'))
    .sort()
    .map(async (file) => {
      const slug = file.replace(/\.json$/, '');
      try {
        const raw = await readFile(path.join(draftsDir, file), 'utf8');
        const data = JSON.parse(raw);
        return {
          slug,
          title: typeof data.title === 'string' ? data.title : slug,
          status: typeof data.status === 'string' ? data.status : 'draft',
        };
      } catch (err) {
        return {
          slug,
          title: `${slug} (invalid JSON)`,
          status: 'error',
        };
      }
    })
);
---
<AppLayout drafts={drafts} title="Workspace Overview">
  <div class="space-y-6">
    <header class="border-b border-slate-800 pb-4">
      <h2 class="text-2xl font-semibold text-slate-100">Welcome back to the lab</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-400">
        Cauldron keeps drafts, prompts, and validation utilities close by so you can iterate quickly before publishing to WitchClick. Use the sidebar to jump into any draft preview or open your editor to adjust the JSON directly.
      </p>
    </header>
    <section class="grid gap-4 xl:grid-cols-2">
      <div class="rounded-lg border border-slate-800 bg-slate-900/60 p-5">
        <h3 class="text-lg font-medium text-slate-100">Quick actions</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          <li><kbd class="rounded bg-slate-800 px-2 py-1 text-xs text-slate-300">npm run dev</kbd> — preview the lab UI at <span class="font-mono">localhost:4370</span>.</li>
          <li><kbd class="rounded bg-slate-800 px-2 py-1 text-xs text-slate-300">npm run validate</kbd> — lint every draft against PostSpec v2.</li>
          <li><kbd class="rounded bg-slate-800 px-2 py-1 text-xs text-slate-300">npm run promote -- &lt;slug&gt;</kbd> — move a vetted draft into WitchClick ingest.</li>
        </ul>
      </div>
      <div class="rounded-lg border border-slate-800 bg-slate-900/60 p-5">
        <h3 class="text-lg font-medium text-slate-100">Draft inventory</h3>
        <ul class="mt-3 space-y-1 text-sm text-slate-300">
          {drafts.length === 0 ? (
            <li>No drafts yet. Start by creating a JSON file in <code class="font-mono text-xs">/cauldron/drafts/</code>.</li>
          ) : (
            drafts.map((draft) => (
              <li class="flex items-center justify-between gap-2 rounded px-2 py-1 hover:bg-slate-800/60">
                <a href={`/preview/${draft.slug}`} class="font-medium text-indigo-200 hover:text-indigo-100 focus-visible:text-indigo-100">{draft.title}</a>
                <span class="text-xs uppercase tracking-wide text-slate-500">{draft.status}</span>
              </li>
            ))
          )}
        </ul>
      </div>
    </section>
    <section class="rounded-lg border border-slate-800 bg-slate-900/60 p-5 text-sm text-slate-300">
      <h3 class="text-lg font-medium text-slate-100">Keyboard & workflow notes</h3>
      <ul class="mt-3 list-disc space-y-2 pl-5">
        <li>Use the browser's native find (<kbd>Ctrl</kbd> / <kbd>Cmd</kbd> + <kbd>F</kbd>) to jump between sections while editing.</li>
        <li>The sidebar keeps drafts accessible while you scroll through a preview. It favors large displays — stretch your window wide.</li>
        <li>Keep prompts synchronized with drafts by storing `.genprompt.yaml` files in the <code class="font-mono text-xs">prompts/</code> folder.</li>
      </ul>
    </section>
  </div>
</AppLayout>
