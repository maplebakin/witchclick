---
import Sidebar from '../components/Sidebar.astro';
import DraftEditor from '../components/DraftEditor.astro';
import DraftPreview from '../components/DraftPreview.astro';
import ControlBar from '../components/ControlBar.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cauldron · Draft Lab (Placeholder)</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="flex min-h-screen">
      <Sidebar />
      <section class="flex min-h-screen flex-1 flex-col">
        <ControlBar />
        <div class="flex flex-1">
          <DraftEditor />
          <DraftPreview />
        </div>
      </section>
    </main>
  </body>
</html>
