---
import '../styles/global.css';

interface DraftLink {
  slug: string;
  title: string;
  status?: string;
}

interface Props {
  title?: string;
  drafts: DraftLink[];
  activeSlug?: string;
}

const { title = 'Cauldron Workspace', drafts, activeSlug } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Cauldron</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-50 focus:rounded-md focus:bg-slate-800 focus:px-4 focus:py-2">
      Skip to preview
    </a>
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur">
      <div class="mx-auto flex max-w-cauldron items-center justify-between gap-6 px-6 py-4 xl:px-10">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-slate-400">WitchClick Lab</p>
          <h1 class="text-2xl font-semibold leading-tight text-slate-100">Cauldron</h1>
        </div>
        <nav class="hidden items-center gap-4 text-sm xl:flex">
          <a href="/" class="font-medium text-slate-300 hover:text-white focus-visible:text-white">Dashboard</a>
          <a href="/preview/clean-cursing" class="text-slate-400 hover:text-slate-100 focus-visible:text-slate-100">Preview</a>
          <a href="https://github.com/" class="text-slate-500 hover:text-slate-200 focus-visible:text-slate-200" rel="noreferrer" target="_blank">GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-cauldron px-4 py-8 xl:px-10">
      <div class="grid gap-8 xl:grid-cols-[320px_minmax(0,1fr)]">
        <aside class="hidden rounded-lg border border-slate-800 bg-slate-900/60 shadow-lg xl:flex xl:flex-col">
          <div class="border-b border-slate-800 px-5 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Drafts</h2>
            <p class="mt-1 text-xs text-slate-500">Use ↑ and ↓ to scan, Enter to open.</p>
          </div>
          <div class="flex-1 overflow-y-auto">
            <ul class="grid gap-px">
              {drafts.map((draft) => (
                <li>
                  <a
                    href={`/preview/${draft.slug}`}
                    class={`group flex flex-col gap-1 border-l-2 border-transparent px-5 py-4 text-left transition-colors duration-150 ease-out hover:bg-slate-800/60 focus-visible:bg-slate-800/60 ${
                      draft.slug === activeSlug ? 'border-indigo-400 bg-slate-800/50 text-white' : 'text-slate-300'
                    }`}
                  >
                    <span class="text-sm font-medium leading-tight group-hover:text-white group-focus-visible:text-white">{draft.title}</span>
                    {draft.status && (
                      <span class="text-xs uppercase tracking-wide text-slate-500">{draft.status}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
        <section class="min-h-[70vh] rounded-lg border border-slate-800 bg-slate-900/40 px-5 py-6 shadow-xl">
          <slot />
        </section>
      </div>
    </main>
  </body>
</html>
