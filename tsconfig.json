// tsconfig.json
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@preact/signals": ["src/lib/signalsShim.ts"]
    },
    "types": ["node", "astro/client"],
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules","tools/_compiled","dist"]
}
