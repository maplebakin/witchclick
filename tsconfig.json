// tsconfig.json
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node", "astro/client", "@playwright/test", "vitest"],
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*", "tests/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules","tools/_compiled","dist"]
}
