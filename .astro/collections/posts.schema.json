{
  "$ref": "#/definitions/posts",
  "definitions": {
    "posts": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "canonical": {
          "type": "string",
          "format": "uri"
        },
        "ogImage": {
          "type": "string"
        },
        "readingMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "tldr": {
          "type": "string",
          "maxLength": 320,
          "errorMessage": {
            "maxLength": "Keep TL;DR summaries concise"
          }
        },
        "spoons": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "affiliateAnchors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "text"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "internalLinks": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "anchor": {
                    "type": "string"
                  }
                },
                "required": [
                  "slug",
                  "anchor"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "text",
                  "href"
                ],
                "additionalProperties": false
              }
            ]
          },
          "default": []
        },
        "includeAds": {
          "type": "boolean",
          "default": false
        },
        "includeKofi": {
          "type": "boolean",
          "default": false
        },
        "downloadId": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}