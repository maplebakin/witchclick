---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PrimaryButton from "@/components/buttons/PrimaryButton.astro";
import PartnerProductCard from "@/components/PartnerProductCard.astro";
import { readPartnerBlocks, type PartnerRecord } from "@/utils/partners";
import { createItemListSchema } from "@/utils/structuredData";
import { readSettings } from "@/utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import { getLastUpdatedMeta } from "@/utils/lastUpdated";

const partnerBlocks = readPartnerBlocks();
const settings = readSettings();

type PartnerWithExtras = PartnerRecord & { image?: string };

const normalizePartner = (partner: PartnerRecord): PartnerWithExtras => {
  const record = partner as PartnerRecord & Record<string, unknown>;
  const imageValue = typeof record.image === "string" ? record.image : undefined;
  return { ...partner, image: imageValue } satisfies PartnerWithExtras;
};

const partnerSections = partnerBlocks.sections.map((section) => ({
  ...section,
  partners: section.partners.map(normalizePartner),
}));

const communityItems = partnerSections.flatMap((section) =>
  section.partners.map((partner) => ({
    name: partner.name,
    url: partner.url,
    description: partner.description,
  })),
);

const jsonLd = createItemListSchema(
  settings,
  {
    name: "WitchClick Partner Directory",
    url: "/partners",
    description: "Community shops, mutual aid funds, and collaborative services curated by WitchClick.",
    itemType: "Organization",
  },
  communityItems,
);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Partners" },
];

const lastUpdated = getLastUpdatedMeta(import.meta.url, { fallbackDate: partnerBlocks.updatedAt });
---
<Base
  title="Partners & Mutual Aid — WitchClick"
  description="Meet the makers, mutual aid funds, and practitioners we partner with across WitchClick hubs."
  ambientColor="#6366f1"
>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <HeadSlot slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </HeadSlot>

  <section class="partners-hero">
    <div class="partners-hero__inner">
      <p class="partners-hero__eyebrow">Partnership constellation</p>
      <h1 class="partners-hero__title">Shops, funds, and practitioners we trust</h1>
      <p class="partners-hero__lead">
        Every listing here is a relationship built through ritual collaborations, mutual aid, or seasonal co-creation. Browse by
        focus, support a fund, or explore affiliate highlights with clear impact tags.
      </p>
      {lastUpdated && (
        <p class="partners-hero__meta">
          Last updated <time datetime={lastUpdated.iso}>{lastUpdated.formatted}</time>
          {lastUpdated.isStale && <span class="partners-hero__stale">refresh in progress</span>}
        </p>
      )}
    </div>
  </section>

  {partnerSections.map((section) => (
    <section class="partners-section" id={section.slug}>
      <header class="partners-section__header">
        <h2>{section.title}</h2>
        {section.summary && <p>{section.summary}</p>}
      </header>
      <div class="partners-section__grid">
        {section.partners.length > 0 ? (
          section.partners.map((partner) => (
            <article class="card-panel card-tier-2 card-panel-soft partner-card">
              {partner.image && (
                <div class="partner-card__media">
                  <img src={partner.image} alt={`Preview of ${partner.name}`} loading="lazy" />
                </div>
              )}
              <header class="partner-card__header">
                <h3>{partner.name}</h3>
                {partner.impactTag && <span class="partner-card__impact">{partner.impactTag}</span>}
              </header>
              <p class="partner-card__description">{partner.description}</p>
              {partner.offerings?.length > 0 && (
                <ul class="partner-card__offerings">
                  {partner.offerings.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {partner.location && <p class="partner-card__meta">Based in {partner.location}</p>}
              <div class="partner-card__actions">
                <PrimaryButton href={partner.url} target="_blank" rel="noopener" iconAfter="↗">
                  Visit partner
                </PrimaryButton>
                {partner.notes && <span>{partner.notes}</span>}
              </div>
            </article>
          ))
        ) : (
          <p class="partner-card__empty">
            We will be adding allies for this constellation soon. In the meantime, you can suggest a partner below.
            <a href="#partner-request">Share a recommendation</a>.
          </p>
        )}
      </div>
    </section>
  ))}

  {partnerBlocks.affiliateHighlights.length > 0 && (
    <section class="partners-affiliates">
      <header class="partners-affiliates__header">
        <h2>Affiliate highlights</h2>
        <p>We receive a small commission when you purchase through these links. Each product includes an impact note so you know who benefits.</p>
      </header>
      <div class="partners-affiliates__grid">
        {partnerBlocks.affiliateHighlights.map((product) => (
          <PartnerProductCard product={product} />
        ))}
      </div>
    </section>
  )}

  <section id="partner-request" class="partners-request">
    <div class="partners-request__inner">
      <h2 class="partners-request__title">Suggest a partner</h2>
      <p class="partners-request__copy">
        Know a small business, mutual aid project, or creator who aligns with WitchClick values? Share their details and we will review for a future constellation.
      </p>
      <form class="partners-request__form" name="partner-requests" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="partner-requests" />
        <label class="partners-request__label">
          Partner name
          <input type="text" name="partner" placeholder="Example: Warmth Studio" class="partners-request__input" />
        </label>
        <label class="partners-request__label">
          Website or social link
          <input type="url" name="link" placeholder="https://..." class="partners-request__input" />
        </label>
        <label class="partners-request__label">
          Why they fit
          <textarea
            name="reason"
            rows="3"
            placeholder="Short note on their vibe, values, or offerings."
            class="partners-request__input"
          ></textarea>
        </label>
        <label class="partners-request__label">
          Your email (optional)
          <input type="email" name="email" inputmode="email" autocomplete="email" placeholder="you@example.com" class="partners-request__input" />
        </label>
        <button type="submit" class="partners-request__button">Send suggestion</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .partners-hero {
    margin: clamp(2rem, 6vw, 3.5rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: 3rem;
    background:
      radial-gradient(circle at top right, var(--theme-color-iris) 20%, transparent 60%),
      linear-gradient(135deg, var(--theme-surface-base) 94%, var(--theme-surface-panel) 92%);
  }

  .partners-hero__inner {
    max-width: 52rem;
    display: grid;
    gap: 0.85rem;
    color: color-mix(in srgb, var(--ink-body, #1f1a2b) 92%, white 8%);
  }

  .partners-hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--ambient-color, #6366f1) 70%, var(--ink-strong, currentColor) 30%);
  }

  .partners-hero__title {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 3.1rem);
  }

  .partners-hero__lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 80%, white 20%);
  }

  .partners-hero__meta {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 82%, white 18%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .partners-hero__meta time {
    font-weight: 600;
    color: color-mix(in srgb, var(--ink-strong, currentColor) 85%, white 15%);
  }

  .partners-hero__stale {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-color-gold) 45%, transparent 55%);
    background: color-mix(in srgb, var(--theme-color-night) 70%, var(--theme-color-gold) 30%);
    color: var(--theme-color-ink);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  .partners-section {
    margin: clamp(2rem, 6vw, 3.5rem) auto;
    display: grid;
    gap: 1.75rem;
  }

  .partners-section__header {
    display: grid;
    gap: 0.5rem;
    max-width: 48rem;
  }

  .partners-section__header h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .partners-section__header p {
    margin: 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 78%, white 22%);
  }

  .partners-section__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }

  .partner-card {
    --card-hover-translate: -0.3rem;
    --card-elevation-base: var(--elevation-tier-1);
    --card-elevation-hover: var(--elevation-tier-2);
    padding: clamp(1.35rem, 3vw, 1.85rem);
    border: 1px solid color-mix(in srgb, var(--theme-color-iris) 32%, var(--card-panel-border, currentColor) 68%);
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--theme-color-iris) 28%, transparent 72%), transparent),
      var(--card-panel-surface);
    box-shadow: var(--card-elevation-base, var(--elevation-tier-1));
    display: grid;
    gap: 0.75rem;
  }

  .partner-card:hover,
  .partner-card:focus-visible {
    border-color: color-mix(in srgb, var(--theme-color-iris) 45%, transparent 55%);
  }

  .partner-card__media {
    border-radius: calc(var(--card-radius, 1.5rem) - 0.5rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--theme-color-iris) 35%, transparent 65%);
    background: color-mix(in srgb, var(--theme-color-night) 60%, var(--theme-color-ink) 40%);
    aspect-ratio: 4 / 3;
  }

  .partner-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner-card__header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: baseline;
  }

  .partner-card__header h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .partner-card__impact {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--theme-color-iris) 10%, transparent);
    color: color-mix(in srgb, var(--theme-color-iris) 90%, var(--ink-strong, #1f1a2b) 30%);
  }

  .partner-card__description {
    margin: 0;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--ink-body, currentColor) 85%, white 15%);
  }

  .partner-card__offerings {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.35rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 78%, white 22%);
  }

  .partner-card__meta {
    margin: 0;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 75%, white 25%);
  }

  .partner-card__actions {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.9rem;
    align-items: center;
  }

  .partner-card__actions span {
    color: color-mix(in srgb, var(--ink-muted, currentColor) 75%, white 25%);
  }

  :global(.partner-card__actions .wc-button) {
    --btn-bg: color-mix(in srgb, rgba(99, 102, 241, 0.85) 55%, var(--theme-color-night) 45%);
    --btn-bg-hover: color-mix(in srgb, rgba(99, 102, 241, 0.9) 65%, var(--theme-color-night) 35%);
  }

  .partner-card__empty {
    margin: 0;
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 80%, white 20%);
    padding: 1.25rem;
    border-radius: var(--card-radius, 1.5rem);
    border: 1px dashed color-mix(in srgb, var(--theme-color-iris) 60%, transparent 40%);
    text-align: center;
  }

  .partner-card__empty a {
    color: var(--theme-text-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .partner-card__empty a:hover,
  .partner-card__empty a:focus-visible {
    text-decoration: underline;
  }

  .partners-request {
    margin: clamp(3rem, 6vw, 5rem) auto;
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 75%, transparent 25%);
    background: color-mix(in srgb, var(--theme-surface-panel) 90%, transparent 10%);
    box-shadow: var(--elevation-tier-1);
  }

  .partners-request__inner {
    max-width: 52rem;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
    text-align: center;
  }

  .partners-request__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .partners-request__copy {
    margin: 0;
    color: var(--theme-text-body);
    line-height: 1.6;
  }

  .partners-request__form {
    display: grid;
    gap: 0.75rem;
    text-align: left;
  }

  .partners-request__label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--theme-text-body);
  }

  .partners-request__input {
    width: 100%;
    border-radius: var(--wc-radius-md, 0.9rem);
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 75%, transparent 25%);
    background: var(--cozy-input-bg, rgba(255, 250, 245, 0.9));
    padding: 0.7rem 0.9rem;
    font-size: 0.95rem;
    color: var(--theme-text-strong);
  }

  .partners-request__button {
    justify-self: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-color-gold) 45%, transparent 55%);
    background: var(--cozy-button-bg, color-mix(in srgb, var(--theme-color-gold) 75%, transparent 25%));
    color: var(--theme-text-strong);
    font-weight: 600;
    padding: 0.7rem 1.5rem;
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .partners-request__button:hover,
  .partners-request__button:focus-visible {
    transform: translateY(-1px);
    box-shadow: var(--elevation-tier-1);
  }

  .partners-affiliates {
    margin: clamp(2rem, 6vw, 4rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: 3rem;
    background:
      radial-gradient(circle at top left, var(--theme-color-amethyst) 16%, transparent 60%),
      linear-gradient(140deg, var(--theme-surface-base) 94%, var(--theme-surface-panel) 90%);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .partners-affiliates__header {
    display: grid;
    gap: 0.5rem;
    max-width: 48rem;
  }

  .partners-affiliates__header h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.3rem);
  }

  .partners-affiliates__header p {
    margin: 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 78%, white 22%);
  }

  .partners-affiliates__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }

  @media (min-width: 768px) {
    .partners-section__grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .partners-affiliates__grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }
</style>
