---
import Base from "../../layouts/Base.astro";
import fs from "node:fs";
import { Fragment } from "astro/jsx-runtime";
import { readSettings } from "../../utils/settings";
import { createItemListSchema } from "../../utils/structuredData";

const title = "Tools & Prints";
const description = "Curated ritual tools, cozy prints, and affiliate picks.";
const productsPath = "./content/products.json";
const productsDoc = fs.existsSync(productsPath)
  ? JSON.parse(fs.readFileSync(productsPath, "utf8"))
  : { products: [] };
const allProducts = Array.isArray(productsDoc) ? productsDoc : productsDoc.products || [];
const settings = readSettings();
const productItems: { name: string; url: string; description?: string; image?: string }[] = allProducts
  .map((product: any) => {
    const name = typeof product?.name === "string" ? product.name : "";
    const url = typeof product?.url === "string" ? product.url : "";
    if (!name || !url) return null;

    const descriptionCandidate =
      typeof product?.description === "string"
        ? product.description
        : typeof product?.summary === "string"
          ? product.summary
          : undefined;

    return {
      name,
      url,
      description: descriptionCandidate,
      image: typeof product?.image === "string" ? product.image : undefined,
    };
  })
  .filter(Boolean);

const productListSchema =
  productItems.length > 0
    ? createItemListSchema(
        settings,
        {
          name: `${title} — WitchClick`,
          url: "/tools/",
          description,
          itemType: "Product",
        },
        productItems,
      )
    : null;
---
<Base {title} {description}>
  {productListSchema && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(productListSchema)} />
    </Fragment>
  )}
  <section class="mx-auto max-w-5xl space-y-6">
    <header class="space-y-2 text-center">
      <h1 class="text-4xl font-serif">{title}</h1>
      <p class="text-lg opacity-80">A lovingly curated shelf of tools, decks, and cozy ritual companions.</p>
      <p class="text-sm opacity-60">
        Some links may be affiliate enchanted—purchases help keep the coven's candles lit.
      </p>
    </header>

    {allProducts.length === 0 ? (
      <p class="text-center text-base opacity-70">No tools to share just yet. Check back after the next full moon.</p>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2">
        {allProducts.map((product) => (
          <li class="rounded-2xl border border-zinc-200/70 bg-white/80 p-4 shadow-sm backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-900/70">
            <h2 class="text-xl font-semibold">{product.name}</h2>
            {product.brand && <p class="text-sm opacity-70">{product.brand}</p>}
            <div class="mt-3 flex flex-wrap gap-2">
              {(product.tags || []).map((tag) => (
                <span class="rounded-full bg-purple-100 px-3 py-1 text-xs font-medium text-purple-900 dark:bg-purple-900/30 dark:text-purple-200">
                  {tag}
                </span>
              ))}
            </div>
            <a
              class="mt-4 inline-flex items-center gap-2 rounded-full border border-purple-400/60 px-4 py-2 text-sm font-medium text-purple-900 transition hover:bg-purple-100 dark:border-purple-300/40 dark:text-purple-100 dark:hover:bg-purple-900/40"
              href={`${product.url}${product.utm ? (product.url.includes('?') ? '&' : '?') + product.utm : ''}`}
              rel={product.rel ?? undefined}
              target="_blank"
            >
              Visit listing
              <span aria-hidden>↗</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
