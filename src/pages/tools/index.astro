---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrimaryButton from "../../components/buttons/PrimaryButton.astro";
import fs from "node:fs";
import HeadSlot from "@/components/HeadSlot.astro";
import { readSettings } from "../../utils/settings";
import { createItemListSchema } from "../../utils/structuredData";

const title = "Prints & Tools";
const description = "Free printables, ritual downloads, and curated tools for your practice.";

// Load downloadable prints
const downloadsPath = "./content/downloads";
const downloadFiles = fs.existsSync(downloadsPath)
  ? fs
      .readdirSync(downloadsPath)
      .filter((item) => item.endsWith(".json"))
      .map((file) => {
        try {
          const raw = fs.readFileSync(`${downloadsPath}/${file}`, "utf8");
          return JSON.parse(raw) as {
            slug?: string;
            name?: string;
            summary?: string;
            file?: string;
            url?: string;
            features?: string[];
            tags?: string[];
          };
        } catch (error) {
          console.warn(`Unable to parse download file ${file}:`, error);
          return null;
        }
      })
      .filter(Boolean)
      .filter((item): item is NonNullable<typeof item> => {
        if (!item) return false;
        const target = typeof item.file === "string" && item.file.trim().length > 0 ? item.file : item.url;
        if (typeof target !== "string" || target.trim().length === 0) return false;
        return !target.startsWith("/home/");
      })
  : [];

// Load affiliate products
const productsPath = "./content/products.json";
const productsDoc = fs.existsSync(productsPath)
  ? JSON.parse(fs.readFileSync(productsPath, "utf8"))
  : { products: [] };
const rawProducts = Array.isArray(productsDoc) ? productsDoc : productsDoc.products || [];
const settings = readSettings();

interface ProductEntry {
  name: string;
  url: string;
  description?: string;
  brand?: string;
  tags: string[];
  image?: string;
  rel?: string;
  utm?: string;
}

const products: ProductEntry[] = Array.isArray(rawProducts)
  ? rawProducts.reduce<ProductEntry[]>((acc, item) => {
      const product = item as Record<string, unknown>;
      const name = typeof product?.name === "string" ? product.name.trim() : "";
      const url = typeof product?.url === "string" ? product.url.trim() : "";
      if (!name || !url) {
        return acc;
      }

      const descriptionCandidate =
        typeof product?.description === "string"
          ? product.description
          : typeof product?.summary === "string"
            ? product.summary
            : undefined;

      const tags = Array.isArray(product?.tags)
        ? product.tags
            .map((tag) => (typeof tag === "string" ? tag : String(tag)))
            .filter((tag) => tag.trim().length > 0)
        : [];

      const entry: ProductEntry = {
        name,
        url,
        description: descriptionCandidate,
        brand: typeof product?.brand === "string" ? product.brand : undefined,
        tags,
        image: typeof product?.image === "string" ? product.image : undefined,
        rel: typeof product?.rel === "string" ? product.rel : undefined,
        utm: typeof product?.utm === "string" ? product.utm : undefined,
      };

      acc.push(entry);
      return acc;
    }, [])
  : [];

const productItems = products.map(({ name, url, description, image }) => ({
  name,
  url,
  description,
  image,
}));

const productListSchema =
  productItems.length > 0
    ? createItemListSchema(
        settings,
        {
          name: `${title} — WitchClick`,
          url: "/tools/",
          description,
          itemType: "Product",
        },
        productItems,
      )
    : null;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: title },
];
---
<Base {title} {description}>
  {productListSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(productListSchema)} />
    </HeadSlot>
  )}
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />

  <div class="tools-page-container">
    <header class="tools-page-header">
      <h1 class="tools-page-title">{title}</h1>
      <p class="tools-page-intro">Free printables, ritual downloads, and curated tools for everyday magic.</p>
    </header>

    <!-- SECTION 1: Free Prints & Downloads -->
    <section class="tools-section">
      <div class="tools-section__header">
        <h2 class="tools-section__title">Free Prints & Downloads</h2>
        <p class="tools-section__description">
          Print-at-home planners, ritual guides, and calendar reminders—all free to download and use.
        </p>
      </div>

      {downloadFiles.length === 0 ? (
        <div class="tools-empty">
          <p>New printables are brewing. Check out the <a href="/lab">Ritual Lab</a> for interactive ritual generators, or visit the <a href="/curses">White Magic Curses</a> collection for printable boundary-setting cards.</p>
        </div>
      ) : (
        <ul class="tools-grid">
          {downloadFiles.map((item) => (
            <li class="card-panel card-tier-1 card-panel-soft print-card">
              <div class="print-card__badge">Free Download</div>
              <h3 class="print-card__title">{item.name}</h3>
              {item.summary && <p class="print-card__description">{item.summary}</p>}
              {item.features && item.features.length > 0 && (
                <ul class="print-card__features">
                  {item.features.map((feature) => (
                    <li>• {feature}</li>
                  ))}
                </ul>
              )}
              {item.tags && item.tags.length > 0 && (
                <div class="print-card__tags">
                  {item.tags.map((tag) => (
                    <span class="print-card__tag">{tag}</span>
                  ))}
                </div>
              )}
              <div class="print-card__actions">
                <PrimaryButton
                  href={item.file || item.url}
                  iconAfter="↓"
                >
                  Download
                </PrimaryButton>
                <a href="/lab/three-day-sampler" class="print-card__preview-link">
                  View preview →
                </a>
              </div>
            </li>
          ))}
        </ul>
      )}

      <div class="tools-cta">
        <p class="tools-cta__text">Want more printables and ritual planners?</p>
        <PrimaryButton href="/lab" iconAfter="→">
          Visit the Ritual Lab
        </PrimaryButton>
      </div>
    </section>

    <!-- SECTION 2: Affiliate Tools -->
    <section class="tools-section tools-section--affiliate">
      <div class="tools-section__header">
        <h2 class="tools-section__title">Tools You Can Purchase</h2>
        <p class="tools-section__description">
          Curated ritual tools, journals, and supplies. Some links are affiliate-enchanted—purchases help keep the coven's candles lit.
        </p>
      </div>

      {products.length === 0 ? (
        <p class="tools-empty">
          No tools to share just yet. Visit the <a href="/about">About page</a> to see how we choose future listings.
        </p>
      ) : (
        <ul class="tools-grid">
          {products.map((product) => (
            <li class="card-panel card-tier-1 card-panel-soft tools-card">
              {product.image && (
                <div class="tools-card__media">
                  <img src={product.image} alt={`Preview of ${product.name}`} loading="lazy" />
                </div>
              )}
              <h3 class="tools-card__title">{product.name}</h3>
              {product.brand && <p class="tools-card__brand">{product.brand}</p>}
              <div class="tools-card__tags">
                {product.tags.map((tag) => (
                  <span class="tools-card__tag">{tag}</span>
                ))}
              </div>
              <div class="tools-card__actions">
                <PrimaryButton
                  href={`${product.url}${product.utm ? (product.url.includes('?') ? '&' : '?') + product.utm : ''}`}
                  rel={product.rel ?? undefined}
                  target="_blank"
                  iconAfter="↗"
                >
                  Visit listing
                </PrimaryButton>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Base>

<style>
  .tools-page-container {
    width: 100%;
    max-width: min(94vw, 90rem);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .tools-page-header {
    max-width: 48rem;
    margin: 0 auto clamp(3rem, 6vw, 4rem);
    text-align: center;
  }

  .tools-page-title {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-strong, #111827);
  }

  .tools-page-intro {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-body, #4b5563);
  }

  .tools-section {
    margin-bottom: clamp(4rem, 8vw, 6rem);
  }

  .tools-section--affiliate {
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-top: clamp(3rem, 6vw, 4rem);
    border-top: 1px solid color-mix(in srgb, var(--border-subtle, rgba(124, 58, 237, 0.15)) 80%, transparent 20%);
  }

  .tools-section__header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    max-width: 48rem;
  }

  .tools-section__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-strong, #111827);
  }

  .tools-section__description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-body, #6b7280);
  }

  .tools-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 768px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1440px) {
    .tools-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tools-empty {
    text-align: center;
    padding: clamp(2rem, 4vw, 3rem);
    font-size: 1rem;
    color: var(--text-body, #6b7280);
  }

  .tools-empty a {
    color: var(--text-accent, #7c3aed);
    text-decoration: underline;
  }

  /* Print Cards */
  .print-card {
    --card-hover-translate: -0.3rem;
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    position: relative;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--accent-purple-soft, #a78bfa) 12%, transparent) 0%, transparent 65%),
      var(--card-panel-surface);
  }

  .print-card__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent-green, #10b981) 90%, white 10%);
    color: white;
    border-radius: 999px;
  }

  .print-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-strong, #111827);
  }

  .print-card__description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-body, #6b7280);
    margin: 0;
  }

  .print-card__features {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-body, #6b7280);
  }

  .print-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .print-card__tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    background: color-mix(in srgb, var(--surface-soft, #f3f4f6) 90%, transparent 10%);
    color: var(--text-body, #6b7280);
    border-radius: 999px;
  }

  .print-card__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
  }

  .print-card__preview-link {
    font-size: 0.875rem;
    color: var(--text-accent, #7c3aed);
    text-decoration: none;
    font-weight: 500;
    text-align: center;
  }

  .print-card__preview-link:hover {
    text-decoration: underline;
  }

  /* Tools Cards */
  .tools-card {
    --card-hover-translate: -0.25rem;
    display: grid;
    gap: 0.875rem;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--card-panel-border-soft) 50%, transparent) 0%, transparent 70%),
      var(--card-panel-surface);
  }

  .tools-card__media {
    border-radius: calc(var(--card-radius, 1.5rem) - 0.5rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border-medium, rgba(124, 58, 237, 0.25)) 80%, transparent 20%);
    background: color-mix(in srgb, var(--surface-muted, #f9fafb) 95%, transparent 5%);
    aspect-ratio: 4 / 3;
  }

  .tools-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tools-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-strong, #111827);
  }

  .tools-card__brand {
    font-size: 0.875rem;
    color: var(--text-body, #9ca3af);
    margin: 0;
  }

  .tools-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tools-card__tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    background: color-mix(in srgb, var(--surface-soft, #f3f4f6) 90%, transparent 10%);
    color: var(--text-body, #6b7280);
    border-radius: 999px;
  }

  .tools-card__actions {
    margin-top: auto;
  }

  /* CTA Section */
  .tools-cta {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(2rem, 4vw, 2.5rem);
    text-align: center;
    background: color-mix(in srgb, var(--surface-panel-primary, #faf5ff) 80%, transparent 20%);
    border-radius: clamp(1.2rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--border-accent-medium, rgba(167, 139, 250, 0.3)) 70%, transparent 30%);
  }

  .tools-cta__text {
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    color: var(--text-strong, #111827);
  }
</style>
