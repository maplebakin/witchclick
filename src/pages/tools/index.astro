---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrimaryButton from "../../components/buttons/PrimaryButton.astro";
import fs from "node:fs";
import HeadSlot from "@/components/HeadSlot.astro";
import { readSettings } from "../../utils/settings";
import { createItemListSchema } from "../../utils/structuredData";
import { buildAffiliateTarget, readProductCatalog } from "@/utils/products";

const title = "Prints & Tools";
const description = "Free printables, ritual downloads, and curated tools for your practice.";

interface DownloadEntry {
  slug?: string;
  name?: string;
  summary?: string;
  file?: string;
  url?: string;
  features?: string[];
  tags?: string[];
  published?: boolean;
  status?: string;
}

interface NormalizedDownloadEntry extends DownloadEntry {
  target: string;
}

// Load downloadable prints
const downloadsPath = "./content/downloads";
const rawDownloads: DownloadEntry[] = fs.existsSync(downloadsPath)
  ? fs
      .readdirSync(downloadsPath)
      .filter((item) => item.endsWith(".json"))
      .map((file) => {
        try {
          const raw = fs.readFileSync(`${downloadsPath}/${file}`, "utf8");
          return JSON.parse(raw) as DownloadEntry;
        } catch (error) {
          console.warn(`Unable to parse download file ${file}:`, error);
          return null;
        }
      })
      .filter(Boolean)
      .filter((item): item is NonNullable<typeof item> => Boolean(item))
  : [];

function resolveDownloadTarget(item: DownloadEntry): string {
  const primary = typeof item.file === "string" && item.file.trim().length > 0 ? item.file : item.url;
  return typeof primary === "string" ? primary.trim() : "";
}

function isWebSafeDownloadTarget(target: string): boolean {
  if (!target) return false;
  if (target.startsWith("/home/")) return false;
  return target.startsWith("/") || target.startsWith("http://") || target.startsWith("https://");
}

const normalizedDownloads: NormalizedDownloadEntry[] = rawDownloads.map((item) => ({
  ...item,
  target: resolveDownloadTarget(item),
}));

const readyDownloads = normalizedDownloads.filter((item) => {
  const isPublished = item.published !== false;
  const isReadyStatus = String(item.status ?? "").toLowerCase() !== "coming-soon";
  return isPublished && isReadyStatus && isWebSafeDownloadTarget(item.target);
});

const comingSoonDownloads = normalizedDownloads.filter((item) => {
  const hasName = typeof item.name === "string" && item.name.trim().length > 0;
  if (!hasName) return false;
  if (readyDownloads.includes(item)) return false;
  return true;
});

// Load affiliate products
const settings = readSettings();

interface ProductEntry {
  key?: string;
  name: string;
  url: string;
  href: string;
  description?: string;
  brand?: string;
  tags: string[];
  image?: string;
  rel?: string;
  utm?: string;
}

const rawProducts = readProductCatalog();

const products: ProductEntry[] = Array.isArray(rawProducts)
  ? rawProducts.reduce<ProductEntry[]>((acc, item) => {
      const product = item as Record<string, unknown>;
      const key = typeof product?.key === "string" ? product.key.trim() : "";
      const name = typeof product?.name === "string" ? product.name.trim() : "";
      const url = typeof product?.url === "string" ? product.url.trim() : "";
      if (!name || !url) {
        return acc;
      }

      const descriptionCandidate =
        typeof product?.description === "string"
          ? product.description
          : typeof product?.summary === "string"
            ? product.summary
            : undefined;

      const tags = Array.isArray(product?.tags)
        ? product.tags
            .map((tag) => (typeof tag === "string" ? tag : String(tag)))
            .filter((tag) => tag.trim().length > 0)
        : [];

      const entry: ProductEntry = {
        key: key || undefined,
        name,
        url,
        href: key ? `/go/${key}` : buildAffiliateTarget(item),
        description: descriptionCandidate,
        brand: typeof product?.brand === "string" ? product.brand : undefined,
        tags,
        image: typeof product?.image === "string" ? product.image : undefined,
        rel: typeof product?.rel === "string" ? product.rel : undefined,
        utm: typeof product?.utm === "string" ? product.utm : undefined,
      };

      acc.push(entry);
      return acc;
    }, [])
  : [];

const productItems = products.map(({ name, href, description, image }) => ({
  name,
  url: href,
  description,
  image,
}));

const productListSchema =
  productItems.length > 0
    ? createItemListSchema(
        settings,
        {
          name: `${title} — WitchClick`,
          url: "/tools/",
          description,
          itemType: "Product",
        },
        productItems,
      )
    : null;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: title },
];
---
<Base {title} {description}>
  {productListSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(productListSchema)} />
    </HeadSlot>
  )}
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />

  <div class="tools-page-container">
    <header class="page-header">
      <p class="page-header__eyebrow">Printable library</p>
      <h1 class="page-header__title">{title}</h1>
      <p class="page-header__lead">Free printables, ritual downloads, and curated tools for everyday magic.</p>
    </header>

    <!-- SECTION 1: Free Prints & Downloads -->
    <section class="tools-section">
      <div class="tools-section__header">
        <h2 class="tools-section__title">Free Prints & Downloads</h2>
        <p class="tools-section__description">
          Print-at-home planners, ritual guides, and calendar reminders—all free to download and use.
        </p>
      </div>

      {readyDownloads.length === 0 && comingSoonDownloads.length === 0 ? (
        <div class="tools-empty">
          <p>
            New printables are brewing. Check out the <a href="/lab">Ritual Lab</a> for interactive ritual generators, or visit the <a href="/curses">White Magic Curses</a> collection for printable boundary-setting cards.
            If you have a wish list, drop a request in the <a href="#tools-request">printable request form</a> below.
          </p>
        </div>
      ) : (
        <div class="tools-download-tiers">
          {readyDownloads.length > 0 && (
            <div class="tools-download-tier">
              <h3 class="tools-tier-title">Ready to use</h3>
              <ul class="tools-grid tools-grid--ready">
                {readyDownloads.map((item) => (
                  <li class="card-panel card-tier-1 card-panel-soft print-card">
                    <div class="print-card__badge">Free Download</div>
                    <h4 class="print-card__title">{item.name}</h4>
                    {item.summary && <p class="print-card__description">{item.summary}</p>}
                    {item.features && item.features.length > 0 && (
                      <ul class="print-card__features">
                        {item.features.map((feature) => (
                          <li>• {feature}</li>
                        ))}
                      </ul>
                    )}
                    {item.tags && item.tags.length > 0 && (
                      <div class="print-card__tags">
                        {item.tags.map((tag) => (
                          <span class="print-card__tag">{tag}</span>
                        ))}
                      </div>
                    )}
                    <div class="print-card__actions">
                      <PrimaryButton href={item.target} iconAfter="↓">
                        Download
                      </PrimaryButton>
                      <a href="/lab/three-day-sampler" class="print-card__preview-link">
                        View preview →
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {comingSoonDownloads.length > 0 && (
            <details class="tools-coming-soon-disclosure" data-mobile-disclosure data-desktop-min="768">
              <summary class="tools-coming-soon-disclosure__summary" aria-controls="tools-coming-soon-panel" aria-expanded="false">
                See what's coming <span aria-hidden>→</span>
              </summary>
              <div id="tools-coming-soon-panel" class="tools-coming-soon">
                <h3 class="tools-tier-title tools-tier-title--muted">Coming soon</h3>
                <ul class="tools-coming-soon__list">
                  {comingSoonDownloads.map((item) => (
                    <li class="tools-coming-soon__item">
                      <div class="tools-coming-soon__copy">
                        <p class="tools-coming-soon__name">{item.name}</p>
                        {item.summary && <p class="tools-coming-soon__summary">{item.summary}</p>}
                      </div>
                      <span class="tools-coming-soon__status">In development</span>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          )}
        </div>
      )}

      <div class="tools-cta">
        <p class="tools-cta__text">Want more printables and ritual planners?</p>
        <PrimaryButton href="/lab" iconAfter="→">
          Visit the Ritual Lab
        </PrimaryButton>
      </div>
    </section>

    <!-- SECTION 2: Affiliate Tools -->
    <section class="tools-section tools-section--affiliate">
      <div class="tools-section__header">
        <h2 class="tools-section__title">Tools You Can Purchase</h2>
        <p class="tools-section__description">
          Curated ritual tools, journals, and supplies. Some links are affiliate-enchanted—purchases help keep the coven's candles lit.
        </p>
      </div>

      {products.length === 0 ? (
        <p class="tools-empty">
          No tools to share just yet. Visit the <a href="/about">About page</a> to see how we choose future listings, or add your suggestions in the <a href="#tools-request">tool request form</a> below.
        </p>
      ) : (
        <ul class="tools-grid">
          {products.map((product) => (
            <li class="card-panel card-tier-1 card-panel-soft tools-card">
              {product.image && (
                <div class="tools-card__media">
                  <img src={product.image} alt={`Preview of ${product.name}`} loading="lazy" />
                </div>
              )}
              <h3 class="tools-card__title">{product.name}</h3>
              {product.brand && <p class="tools-card__brand">{product.brand}</p>}
              <div class="tools-card__tags">
                {product.tags.map((tag) => (
                  <span class="tools-card__tag">{tag}</span>
                ))}
              </div>
              <div class="tools-card__actions">
                <PrimaryButton
                  href={product.href}
                  rel={product.rel ?? undefined}
                  target="_blank"
                  dataAffiliate={true}
                  iconAfter="↗"
                >
                  Visit listing
                </PrimaryButton>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section id="tools-request" class="tools-request">
      <div class="tools-request__inner">
        <h2 class="tools-request__title">Request a printable or tool</h2>
        <p class="tools-request__copy">
          Looking for something specific? Share the ritual tool, planner, or resource you want and we will add it to the cozy backlog.
        </p>
        <form class="tools-request__form" name="tools-request" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="tools-request" />
          <label class="tools-request__label">
            What would help you right now?
            <textarea
              name="request"
              rows="3"
              placeholder="Example: A one-page morning ritual tracker or a low-spoons cleaning reset checklist."
              class="tools-request__input"
            ></textarea>
          </label>
          <label class="tools-request__label">
            Email (optional)
            <input
              type="email"
              name="email"
              inputmode="email"
              autocomplete="email"
              placeholder="you@example.com"
              class="tools-request__input"
            />
          </label>
          <PrimaryButton type="submit">Send request</PrimaryButton>
        </form>
      </div>
    </section>
  </div>
</Base>

<script type="module" is:inline>
  const disclosureNodes = Array.from(document.querySelectorAll("[data-mobile-disclosure]"));

  const setupResponsiveDisclosure = (node) => {
    if (!(node instanceof HTMLDetailsElement)) return;
    const summary = node.querySelector("summary");
    const minWidth = Number(node.dataset.desktopMin || "768");
    const mediaQuery = window.matchMedia(`(min-width: ${minWidth}px)`);

    const syncState = () => {
      if (summary instanceof HTMLElement) {
        summary.setAttribute("aria-expanded", node.open ? "true" : "false");
      }
    };

    const applyViewportState = () => {
      node.open = mediaQuery.matches;
      syncState();
    };

    applyViewportState();
    node.addEventListener("toggle", syncState);
    mediaQuery.addEventListener("change", applyViewportState);
  };

  disclosureNodes.forEach(setupResponsiveDisclosure);
</script>

<style>
  .tools-page-container {
    width: 100%;
    max-width: min(94vw, 90rem);
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .tools-page-container .page-header {
    margin-inline: auto;
    margin-bottom: var(--page-header-gap);
    text-align: center;
  }

  .tools-section {
    margin-bottom: var(--page-section-gap);
  }

  .tools-section--affiliate {
    margin-top: var(--page-section-gap);
    padding-top: var(--page-header-gap);
    border-top: 1px solid color-mix(in srgb, var(--theme-border-subtle) 80%, transparent 20%);
  }

  .tools-section__header {
    margin-bottom: var(--page-header-gap);
    max-width: var(--content-max-width);
  }

  .tools-section__title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-strong, #111827);
  }

  .tools-section__description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-body, #6b7280);
  }

  .tools-download-tiers {
    display: grid;
    gap: var(--page-header-gap);
  }

  .tools-download-tier {
    display: grid;
    gap: var(--space-4);
  }

  .tools-tier-title {
    margin: 0;
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    font-weight: 600;
    color: var(--text-strong);
  }

  .tools-tier-title--muted {
    color: color-mix(in srgb, var(--text-body) 78%, transparent 22%);
  }

  .tools-grid {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tools-coming-soon {
    border-radius: var(--card-radius);
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 75%, transparent 25%);
    background: color-mix(in srgb, var(--surface-panel-primary) 76%, transparent 24%);
    padding: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .tools-coming-soon-disclosure {
    display: grid;
    gap: var(--space-3);
  }

  .tools-coming-soon-disclosure__summary {
    cursor: pointer;
    list-style: none;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 78%, transparent 22%);
    padding: 0.65rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-accent);
    background: color-mix(in srgb, var(--surface-muted) 80%, transparent 20%);
  }

  .tools-coming-soon-disclosure__summary::-webkit-details-marker {
    display: none;
  }

  .tools-coming-soon__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .tools-coming-soon__item {
    display: grid;
    gap: var(--space-2);
    align-items: start;
    padding: var(--space-3);
    border-radius: var(--wc-radius-md);
    border: 1px dashed color-mix(in srgb, var(--theme-border-subtle) 70%, transparent 30%);
    background: color-mix(in srgb, var(--surface-muted) 82%, transparent 18%);
  }

  .tools-coming-soon__copy {
    display: grid;
    gap: var(--space-1);
  }

  .tools-coming-soon__name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  .tools-coming-soon__summary {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-body);
  }

  .tools-coming-soon__status {
    display: inline-flex;
    justify-self: start;
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-body) 78%, transparent 22%);
    background: color-mix(in srgb, var(--surface-base) 85%, transparent 15%);
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 75%, transparent 25%);
  }

  @media (min-width: 768px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .tools-coming-soon-disclosure__summary {
      display: none;
    }

    .tools-coming-soon-disclosure:not([open]) > .tools-coming-soon {
      display: grid;
    }

    .tools-coming-soon__item {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1440px) {
    .tools-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tools-empty {
    text-align: center;
    padding: clamp(2rem, 4vw, 3rem);
    font-size: 1rem;
    color: var(--text-body, #6b7280);
  }

  .tools-empty a {
    color: var(--text-accent, #7c3aed);
    text-decoration: underline;
  }

  /* Print Cards */
  .print-card {
    --card-hover-translate: -0.3rem;
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    position: relative;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--accent-purple-soft, #a78bfa) 12%, transparent) 0%, transparent 65%),
      var(--card-panel-surface);
  }

  .print-card__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent-green, #10b981) 90%, white 10%);
    color: white;
    border-radius: 999px;
  }

  .print-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-strong, #111827);
  }

  .print-card__description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-body, #6b7280);
    margin: 0;
  }

  .print-card__features {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-body, #6b7280);
  }

  .print-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .print-card__tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    background: color-mix(in srgb, var(--surface-soft, #f3f4f6) 90%, transparent 10%);
    color: var(--text-body, #6b7280);
    border-radius: 999px;
  }

  .print-card__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
  }

  .print-card__preview-link {
    font-size: 0.875rem;
    color: var(--text-accent, #7c3aed);
    text-decoration: none;
    font-weight: 500;
    text-align: center;
  }

  .print-card__preview-link:hover {
    text-decoration: underline;
  }

  /* Tools Cards */
  .tools-card {
    --card-hover-translate: -0.25rem;
    display: grid;
    gap: 0.875rem;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--card-panel-border-soft) 50%, transparent) 0%, transparent 70%),
      var(--card-panel-surface);
  }

  .tools-card__media {
    border-radius: calc(var(--card-radius, 1.5rem) - 0.5rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--theme-border-medium) 80%, transparent 20%);
    background: color-mix(in srgb, var(--surface-muted, #f9fafb) 95%, transparent 5%);
    aspect-ratio: 4 / 3;
  }

  .tools-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tools-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-strong, #111827);
  }

  .tools-card__brand {
    font-size: 0.875rem;
    color: var(--text-body, #9ca3af);
    margin: 0;
  }

  .tools-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tools-card__tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    background: color-mix(in srgb, var(--surface-soft, #f3f4f6) 90%, transparent 10%);
    color: var(--text-body, #6b7280);
    border-radius: 999px;
  }

  .tools-card__actions {
    margin-top: auto;
  }

  /* CTA Section */
  .tools-cta {
    margin-top: var(--page-header-gap);
    padding: clamp(2rem, 4vw, 2.5rem);
    text-align: center;
    background: color-mix(in srgb, var(--surface-panel-primary, #faf5ff) 80%, transparent 20%);
    border-radius: clamp(1.2rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--theme-border-accent-medium) 70%, transparent 30%);
  }

  .tools-cta__text {
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    color: var(--text-strong, #111827);
  }

  /* Tools Request */
  .tools-request {
    margin: var(--page-section-gap) 0 0;
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 75%, transparent 25%);
    background: color-mix(in srgb, var(--surface-panel-primary, #faf5ff) 88%, transparent 12%);
    box-shadow: var(--elevation-tier-1);
  }

  .tools-request__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: grid;
    gap: 1rem;
    text-align: center;
  }

  .tools-request__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    color: var(--text-strong, #111827);
  }

  .tools-request__copy {
    margin: 0;
    color: var(--text-body, #4b5563);
    line-height: 1.6;
  }

  .tools-request__form {
    display: grid;
    gap: 0.75rem;
    text-align: left;
  }

  .tools-request__label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted, #6b7280);
  }

  .tools-request__input {
    width: 100%;
    border-radius: var(--wc-radius-md, 0.9rem);
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 75%, transparent 25%);
    background: var(--cozy-input-bg, rgba(255, 250, 245, 0.9));
    padding: 0.7rem 0.9rem;
    font-size: 0.95rem;
    color: var(--text-strong, #111827);
  }

  .tools-request__form :global(.wc-button) {
    justify-self: center;
  }

</style>
