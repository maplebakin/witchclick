---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrimaryButton from "../../components/buttons/PrimaryButton.astro";
import fs from "node:fs";
import HeadSlot from "@/components/HeadSlot.astro";
import { readSettings } from "../../utils/settings";
import { createItemListSchema } from "../../utils/structuredData";

const title = "Tools & Prints";
const description = "Curated ritual tools, cozy prints, and affiliate picks.";
const productsPath = "./content/products.json";
const productsDoc = fs.existsSync(productsPath)
  ? JSON.parse(fs.readFileSync(productsPath, "utf8"))
  : { products: [] };
const rawProducts = Array.isArray(productsDoc) ? productsDoc : productsDoc.products || [];
const settings = readSettings();

interface ProductEntry {
  name: string;
  url: string;
  description?: string;
  brand?: string;
  tags: string[];
  image?: string;
  rel?: string;
  utm?: string;
}

const products: ProductEntry[] = Array.isArray(rawProducts)
  ? rawProducts.reduce<ProductEntry[]>((acc, item) => {
      const product = item as Record<string, unknown>;
      const name = typeof product?.name === "string" ? product.name.trim() : "";
      const url = typeof product?.url === "string" ? product.url.trim() : "";
      if (!name || !url) {
        return acc;
      }

      const descriptionCandidate =
        typeof product?.description === "string"
          ? product.description
          : typeof product?.summary === "string"
            ? product.summary
            : undefined;

      const tags = Array.isArray(product?.tags)
        ? product.tags
            .map((tag) => (typeof tag === "string" ? tag : String(tag)))
            .filter((tag) => tag.trim().length > 0)
        : [];

      const entry: ProductEntry = {
        name,
        url,
        description: descriptionCandidate,
        brand: typeof product?.brand === "string" ? product.brand : undefined,
        tags,
        image: typeof product?.image === "string" ? product.image : undefined,
        rel: typeof product?.rel === "string" ? product.rel : undefined,
        utm: typeof product?.utm === "string" ? product.utm : undefined,
      };

      acc.push(entry);
      return acc;
    }, [])
  : [];

const productItems = products.map(({ name, url, description, image }) => ({
  name,
  url,
  description,
  image,
}));

const productListSchema =
  productItems.length > 0
    ? createItemListSchema(
        settings,
        {
          name: `${title} — WitchClick`,
          url: "/tools/",
          description,
          itemType: "Product",
        },
        productItems,
      )
    : null;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: title },
];
---
<Base {title} {description}>
  {productListSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(productListSchema)} />
    </HeadSlot>
  )}
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="mx-auto max-w-5xl space-y-6">
    <header class="space-y-2 text-center">
      <h1 class="text-4xl font-serif">{title}</h1>
      <p class="text-lg opacity-80">A lovingly curated shelf of tools, decks, and cozy ritual companions.</p>
      <p class="text-sm opacity-60">
        Some links may be affiliate enchanted—purchases help keep the coven's candles lit.
      </p>
    </header>

    {products.length === 0 ? (
      <p class="text-center text-base opacity-70">
        No tools to share just yet. Visit the
        <a class="ml-1 underline" href="/about/">About page</a>
        to see how we choose future listings.
      </p>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2">
        {products.map((product) => (
          <li class="card-panel card-tier-1 card-panel-soft tools-card">
            {product.image && (
              <div class="tools-card__media">
                <img src={product.image} alt={`Preview of ${product.name}`} loading="lazy" />
              </div>
            )}
            <h2 class="text-xl font-semibold">{product.name}</h2>
            {product.brand && <p class="text-sm opacity-70">{product.brand}</p>}
            <div class="mt-3 flex flex-wrap gap-2">
              {product.tags.map((tag) => (
                <span class="rounded-full bg-surface-soft px-3 py-1 text-xs font-medium text-primary dark:bg-surface-accent-night/30 dark:text-accent-faint">
                  {tag}
                </span>
              ))}
            </div>
            <div class="mt-4">
              <PrimaryButton
                href={`${product.url}${product.utm ? (product.url.includes('?') ? '&' : '?') + product.utm : ''}`}
                rel={product.rel ?? undefined}
                target="_blank"
                iconAfter="↗"
              >
                Visit listing
              </PrimaryButton>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .tools-card {
    --card-hover-translate: -0.25rem;
    --card-elevation-base: var(--elevation-tier-1);
    --card-elevation-hover: var(--elevation-tier-2);
    display: grid;
    gap: 0.75rem;
    min-height: 100%;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--card-panel-border-soft) 55%, transparent) 0%, transparent 75%),
      var(--card-panel-surface);
  }

  .tools-card__media {
    border-radius: calc(var(--card-radius, 1.5rem) - 0.5rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-iris) 35%, transparent 65%);
    background: color-mix(in srgb, var(--color-night) 55%, var(--color-ink) 45%);
    aspect-ratio: 4 / 3;
  }

  .tools-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tools-card h2 {
    color: color-mix(in srgb, var(--ink-strong, currentColor) 88%, white 12%);
  }

  .tools-card .wc-button {
    --btn-bg: color-mix(in srgb, var(--color-iris) 60%, var(--color-night) 40%);
    --btn-bg-hover: color-mix(in srgb, var(--color-iris) 70%, var(--color-night) 30%);
  }
</style>
