---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import { loadAllCurses, getCurseBySlug, resetCurseCache } from "../../utils/curses";
import HeadSlot from "@/components/HeadSlot.astro";
import { serializeJsonForScript } from "@/utils/serializeJson";
import SpoonsBadge from "../../components/SpoonsBadge.astro";
import { normalizeSpoonLevel } from "../../utils/augment";

export const prerender = true;

export function getStaticPaths() {
  const curses = loadAllCurses();
  return curses.map((curse) => ({ params: { slug: curse.slug } }));
}

const slug = (Astro.params.slug as string) ?? "";
let curse = getCurseBySlug(slug);

if (!curse) {
  resetCurseCache();
  curse = getCurseBySlug(slug);
}

if (!curse) {
  throw new Response('Not found', { status: 404 });
}

const settings = readSettings();
const title = curse.title;
const description = curse.invocation || "Clean refusal ritual, formerly framed as a white magic curse, to return energy with clarity.";
const canonical = buildCanonicalUrl(settings, { path: `/curses/${curse.slug}` });
const generator = curse.frontmatter?.generator ?? {};
const journaling = typeof generator?.journalingFollowUp === "string" ? generator.journalingFollowUp : "";
const altarItem = typeof generator?.altarItem === "string" ? generator.altarItem : "";
const sigilName = typeof generator?.sigilName === "string" ? generator.sigilName : "";
const tldr = typeof curse.tldr === "string" ? curse.tldr : typeof curse.frontmatter?.tldr === "string" ? curse.frontmatter.tldr : "";
const spoonLevel = normalizeSpoonLevel(curse.spoons ?? curse.frontmatter?.spoons ?? curse.frontmatter?.spoonLevel);
const ritualText = curse.sections.map((section) => section.content).join("\n");
const usesLiveFire = /\b(?:candle|flame|incense|hot wax|burn(?:ing|ed)?)\b/i.test(ritualText);

function sectionToPlainText(value: string): string {
  return value
    .replace(/<[^>]*>/g, " ")
    .replace(/[`*_>#\-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

const ritualSteps = curse.sections
  .map((section, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: section.label,
    text: sectionToPlainText(section.content),
  }))
  .filter((step) => step.name || step.text);

const ritualJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: title,
  description,
  url: canonical,
  step: ritualSteps,
  totalTime: curse.totalTime ?? undefined,
  author: {
    "@type": "Organization",
    name: settings.brandName ?? "WitchClick",
  },
};

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Clean Cursing", href: "/curses/" },
  { label: title },
];
---

<Base title={title} description={description} canon={canonical} wide={true}>
  <HeadSlot slot="head">
    <script type="application/ld+json" is:inline set:html={serializeJsonForScript(ritualJsonLd)} />
  </HeadSlot>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <article class="mx-auto max-w-3xl space-y-6 py-10">
    <header class="space-y-3 text-center">
      <p class="text-[0.8rem] uppercase tracking-[0.2em] text-accent">Clean Cursing Ritual</p>
      <h1 class="text-3xl font-semibold text-primary">{title}</h1>
      {curse.invocation && (
        <p class="text-sm italic text-secondary">{curse.invocation}</p>
      )}
      <div class="flex flex-wrap justify-center gap-2 text-[0.8rem] uppercase tracking-wide text-tertiary">
        {curse.tags.map((tag) => (
          <span class="rounded-full border border-line-muted px-2 py-0.5">{tag}</span>
        ))}
      </div>
      {(spoonLevel || tldr) && (
        <div class="curse-lede-callouts">
          {spoonLevel && <SpoonsBadge level={spoonLevel} class="curse-lede-callouts__badge" />}
          {tldr && (
            <aside class="curse-lede-callouts__summary" aria-label="TL;DR">
              <span class="curse-lede-callouts__label">TL;DR</span>
              <p>{tldr}</p>
            </aside>
          )}
        </div>
      )}
      <dl class="mx-auto grid max-w-xl grid-cols-1 gap-2 text-[0.8rem] text-muted sm:grid-cols-2">
        <div>
          <dt class="font-semibold uppercase tracking-wide text-tertiary">Type</dt>
          <dd class="capitalize">{generator?.type ?? '—'}</dd>
        </div>
        <div>
          <dt class="font-semibold uppercase tracking-wide text-tertiary">Target</dt>
          <dd class="capitalize">{generator?.target ?? '—'}</dd>
        </div>
        <div>
          <dt class="font-semibold uppercase tracking-wide text-tertiary">Tone</dt>
          <dd class="capitalize">{generator?.tone ?? '—'}</dd>
        </div>
        {sigilName && (
          <div>
            <dt class="font-semibold uppercase tracking-wide text-tertiary">Sigil</dt>
            <dd>{sigilName}</dd>
          </div>
        )}
        {altarItem && (
          <div>
            <dt class="font-semibold uppercase tracking-wide text-tertiary">Altar Item</dt>
            <dd>{altarItem}</dd>
          </div>
        )}
      </dl>
    </header>

    {usesLiveFire && (
      <aside class="rounded-2xl border border-warning bg-warning-soft p-5 text-sm text-body-strong" aria-labelledby="fire-safety-heading">
        <h2 id="fire-safety-heading" class="text-base font-semibold text-body-strong">Keep the fire symbolic, not literal</h2>
        <p class="mt-2">
          An LED candle or an unlit stand-in works. If you use flame, stay with it on a heat-safe surface, keep hair, fabric,
          children, and pets clear, and extinguish it before the ritual ends. Do not pour hot wax onto ordinary glass.
        </p>
      </aside>
    )}

    <div class="prose prose-purple mx-auto max-w-none">
      {curse.sections.map((section) => {
        const safeContent = section.content
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/\n/g, '<br/>');
        return (
          <section>
            <h2>{section.label}</h2>
            <p set:html={safeContent}></p>
          </section>
        );
      })}
    </div>

    {journaling && (
      <section class="rounded-2xl border border-line-subtle bg-surface-muted p-5">
        <h2 class="text-lg font-semibold text-primary">Journaling Follow-up</h2>
        <p class="mt-2 text-sm text-primary-strong">{journaling}</p>
      </section>
    )}
  </article>
</Base>

<style>
  .curse-lede-callouts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
  }

  :global(.curse-lede-callouts__badge) {
    margin-bottom: 0;
    justify-content: center;
  }

  .curse-lede-callouts__summary {
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--theme-surface-muted) 60%, transparent 40%);
    border: 1px solid color-mix(in srgb, var(--color-iris, #7c3aed) 20%, transparent);
    box-shadow: var(--theme-shadow-soft);
    text-align: left;
  }

  .curse-lede-callouts__summary p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-body, currentColor);
  }

  .curse-lede-callouts__label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-iris, #7c3aed) 60%, var(--ink-body, currentColor) 40%);
  }

  @media (min-width: 768px) {
    .curse-lede-callouts {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
    }

    :global(.curse-lede-callouts__badge) {
      align-self: flex-start;
    }

    .curse-lede-callouts__summary {
      flex: 1;
      max-width: 520px;
    }
  }
</style>
