---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrimaryButton from "../../components/buttons/PrimaryButton.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import { loadAllCurses } from "../../utils/curses";
import SpoonsBadge from "../../components/SpoonsBadge.astro";
import { normalizeSpoonLevel, summarizeMarkdown } from "../../utils/augment";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/curses" });
const curses = loadAllCurses();
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Curses" },
];
---

<Base
  title="White Magic Curses — WitchClick"
  description="Ethical energy returns and poetic accountability rituals for boundary keepers."
  canon={canonical}
  wide={true}
>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="mx-auto max-w-4xl space-y-6 py-8">
    <header class="space-y-2 text-center">
      <h1 class="text-3xl font-semibold tracking-tight text-primary">White Magic Curses</h1>
      <p class="text-sm text-muted">
        Honest energy work for people who refuse to stay silent or sink into bitterness.
      </p>
    </header>

    <div class="grid gap-6">
      {curses.length ? (
        curses.map((curse) => {
          const spoonLevel = normalizeSpoonLevel(
            curse.spoons ?? curse.frontmatter?.spoons ?? curse.frontmatter?.spoonLevel
          );
          const fallbackSummary = summarizeMarkdown(
            curse.sections.map((section) => section.content).join("\n\n")
          );
          const summarySource =
            typeof curse.tldr === "string" && curse.tldr.trim()
              ? curse.tldr.trim()
              : fallbackSummary;
          const summaryText = summarySource.length > 120
            ? `${summarySource.slice(0, 117)}…`
            : summarySource;

          return (
            <article class="rounded-2xl border border-line-subtle bg-surface-base p-5 shadow-sm transition hover:shadow-md">
              <h2 class="text-xl font-semibold text-primary">
                <a class="curses-card__link" href={`/curses/${curse.slug}`}>{curse.title}</a>
              </h2>
              {spoonLevel && (
                <div class="mt-3">
                  <SpoonsBadge level={spoonLevel} />
                </div>
              )}
              {summaryText && (
                <p class="curses-card__summary">{summaryText}</p>
              )}
              {curse.invocation && (
                <p class="mt-2 text-sm italic text-secondary">{curse.invocation}</p>
              )}
              <div class="mt-3 flex flex-wrap gap-2 text-[11px] uppercase tracking-wide text-tertiary">
                {curse.tags.map((tag) => (
                  <span class="rounded-full border border-line-muted px-2 py-0.5">{tag}</span>
                ))}
              </div>
              <div class="mt-4">
                <PrimaryButton href={`/curses/${curse.slug}`} iconAfter="→">
                  Read ritual
                </PrimaryButton>
              </div>
            </article>
          );
        })
      ) : (
        <p class="text-center text-sm text-muted">
          No curses are written yet. Start with the
          <a class="ml-1 underline" href="/about/">About page</a>
          to see how to request a ritual.
        </p>
      )}
    </div>
  </section>
</Base>

<style>
  .curses-card__link {
    color: inherit;
  }

  .curses-card__link:hover,
  .curses-card__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .curses-card__summary {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-body, var(--text-muted, rgba(71, 85, 105, 0.88)));
  }

  .grid .wc-button {
    --btn-bg: color-mix(in srgb, var(--color-iris) 60%, var(--color-night) 40%);
    --btn-bg-hover: color-mix(in srgb, var(--color-iris) 70%, var(--color-night) 30%);
  }
</style>
