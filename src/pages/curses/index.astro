---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PrimaryButton from "../../components/buttons/PrimaryButton.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import { loadAllCurses } from "../../utils/curses";
import SpoonsBadge from "../../components/SpoonsBadge.astro";
import { normalizeSpoonLevel, summarizeMarkdown } from "../../utils/augment";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/curses" });
const curses = loadAllCurses();
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Clean Cursing" },
];
---

<Base
  title="Clean Cursing — WitchClick"
  description="Truth-centered curse alternatives for boundaries, accountability, energetic return, and clean refusal."
  canon={canonical}
  wide={true}
>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="mx-auto max-w-4xl space-y-6 py-8">
    <header class="space-y-2 text-center">
      <p class="text-[0.8rem] uppercase tracking-[0.2em] text-accent">Boundary work without revenge theology</p>
      <h1 class="text-3xl font-semibold tracking-tight text-primary">Clean Cursing</h1>
      <p class="text-sm text-muted">
        Truth-centered curse alternatives for boundaries, accountability, energetic return, and clean refusal. These workings
        are symbolic and reflective: name the harm, return what is not yours, and keep bitterness from becoming the whole room.
      </p>
    </header>

    {curses.length > 0 && (
      <form class="curse-filters grid gap-4 rounded-2xl border border-line-subtle bg-surface-base p-4 sm:grid-cols-[minmax(0,1fr)_12rem_auto]" data-curse-filters>
        <label class="grid gap-1 text-sm font-semibold text-body-strong">
          Find a working
          <input
            class="min-h-11 rounded-lg border border-line-neutral bg-surface-card px-3 py-2 text-body-strong"
            type="search"
            name="query"
            placeholder="Try boundary, truth, release…"
            autocomplete="off"
            data-curse-query
          />
        </label>
        <label class="grid gap-1 text-sm font-semibold text-body-strong">
          Energy level
          <select
            class="min-h-11 rounded-lg border border-line-neutral bg-surface-card px-3 py-2 text-body-strong"
            name="spoons"
            data-curse-spoons
          >
            <option value="">Any energy</option>
            <option value="low">Low spoons</option>
            <option value="medium">Medium spoons</option>
            <option value="high">High spoons</option>
          </select>
        </label>
        <button class="min-h-11 self-end rounded-lg border border-line-neutral px-4 py-2 font-semibold text-body-strong hover:bg-surface-soft" type="reset">
          Clear
        </button>
        <p class="text-sm text-body-muted sm:col-span-3" aria-live="polite" aria-atomic="true" data-curse-status>
          Showing all {curses.length} workings.
        </p>
      </form>
    )}

    <div class="grid gap-6" data-curse-list>
      {curses.length ? (
        curses.map((curse) => {
          const spoonLevel = normalizeSpoonLevel(
            curse.spoons ?? curse.frontmatter?.spoons ?? curse.frontmatter?.spoonLevel
          );
          const fallbackSummary = summarizeMarkdown(
            curse.sections.map((section) => section.content).join("\n\n")
          );
          const summarySource =
            typeof curse.tldr === "string" && curse.tldr.trim()
              ? curse.tldr.trim()
              : fallbackSummary;
          const summaryText = summarySource.length > 120
            ? `${summarySource.slice(0, 117)}…`
            : summarySource;

          return (
            <article
              class="rounded-2xl border border-line-subtle bg-surface-base p-5 shadow-sm transition hover:shadow-md"
              data-curse-card
              data-curse-spoon={spoonLevel ?? ""}
              data-curse-search={`${curse.title} ${curse.invocation} ${summaryText} ${curse.tags.join(" ")}`.toLowerCase()}
            >
              <h2 class="text-xl font-semibold text-primary">
                <a class="curses-card__link" href={`/curses/${curse.slug}`}>{curse.title}</a>
              </h2>
              {spoonLevel && (
                <div class="mt-3">
                  <SpoonsBadge level={spoonLevel} />
                </div>
              )}
              {summaryText && (
                <p class="curses-card__summary">{summaryText}</p>
              )}
              {curse.invocation && (
                <p class="mt-2 text-sm italic text-secondary">{curse.invocation}</p>
              )}
              <div class="mt-3 flex flex-wrap gap-2 text-[0.8rem] uppercase tracking-wide text-tertiary">
                {curse.tags.map((tag) => (
                  <span class="rounded-full border border-line-muted px-2 py-0.5">{tag}</span>
                ))}
              </div>
              <div class="mt-4">
                <PrimaryButton href={`/curses/${curse.slug}`} iconAfter="→">
                  Read ritual
                </PrimaryButton>
              </div>
            </article>
          );
        })
      ) : (
        <p class="text-center text-sm text-muted">
          No curses are written yet. Start with the
          <a class="ml-1 underline" href="/about">About page</a>
          to see how to request a ritual.
        </p>
      )}
      <p class="rounded-2xl border border-line-subtle bg-surface-base p-5 text-center text-sm text-body-muted" hidden data-curse-empty>
        No workings match those filters. Try fewer words or a different energy level.
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-curse-filters]');
    if (!(form instanceof HTMLFormElement)) return;
    const queryInput = form.querySelector('[data-curse-query]');
    const spoonsInput = form.querySelector('[data-curse-spoons]');
    const status = form.querySelector('[data-curse-status]');
    const cards = Array.from(document.querySelectorAll('[data-curse-card]'));
    const empty = document.querySelector('[data-curse-empty]');
    if (!(queryInput instanceof HTMLInputElement) || !(spoonsInput instanceof HTMLSelectElement)) return;

    const update = () => {
      const query = queryInput.value.trim().toLowerCase();
      const spoons = spoonsInput.value;
      let visible = 0;
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const matchesQuery = !query || (card.dataset.curseSearch || '').includes(query);
        const matchesSpoons = !spoons || card.dataset.curseSpoon === spoons;
        card.hidden = !(matchesQuery && matchesSpoons);
        if (!card.hidden) visible += 1;
      });
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
      if (status instanceof HTMLElement) {
        status.textContent = visible === cards.length
          ? `Showing all ${cards.length} workings.`
          : `${visible} of ${cards.length} workings match.`;
      }
    };

    form.addEventListener('input', update);
    form.addEventListener('reset', () => window.setTimeout(update, 0));
  })();
</script>

<style>
  .curses-card__link {
    color: inherit;
  }

  .curses-card__link:hover,
  .curses-card__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .curses-card__summary {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-body, var(--theme-text-muted));
  }

  :global(.grid .wc-button) {
    --btn-bg: color-mix(in srgb, var(--theme-color-iris) 60%, var(--theme-color-night) 40%);
    --btn-bg-hover: color-mix(in srgb, var(--theme-color-iris) 70%, var(--theme-color-night) 30%);
  }
</style>
