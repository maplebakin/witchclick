---
import Base from "../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";
import HeadSlot from "@/components/HeadSlot.astro";
import EvergreenCta from "@/components/blocks/EvergreenCta.astro";
import Testimonials from "@/components/blocks/Testimonials.astro";
import { readSettings } from "../../utils/settings";
import { createCollectionPageSchema } from "../../utils/structuredData";
import { readEvergreenBlocks } from "../../utils/blocks";
import { collectUnique, loadRitualLabEntries } from "../../utils/ritualLab";

const title = "Ritual Lab";
const description = "Choose your intention, available time, and tools to receive a tailored ritual flow—then capture it as a printable or calendar reminder.";

const entries = loadRitualLabEntries();
const intents = collectUnique(entries.map((entry) => entry.intents));
const toolOptionsRaw = collectUnique(entries.map((entry) => [...entry.tools, ...entry.tags]));
const toolOptions = toolOptionsRaw.map((value) => ({ value, label: toLabel(value) }));
const timeOptions = [
  { value: 10, label: "Quick reset (≤10 min)" },
  { value: 20, label: "Focused refresh (≤20 min)" },
  { value: 40, label: "Deep dive (≤40 min)" },
];

const defaultIntent = intents[0] ?? "reset";
const defaultTime = timeOptions[0]?.value ?? 15;

const settings = readSettings();
const evergreenBlocks = readEvergreenBlocks();
const evergreenCta = evergreenBlocks.cta ?? null;
const testimonialSection = evergreenBlocks.testimonialSection ?? null;
const testimonials = evergreenBlocks.testimonials ?? [];

const downloadsDirectory = "./content/downloads";
const downloadFiles = fs.existsSync(downloadsDirectory)
  ? fs
      .readdirSync(downloadsDirectory)
      .filter((item) => item.endsWith(".json"))
      .map((file) => {
        try {
          const raw = fs.readFileSync(path.join(downloadsDirectory, file), "utf8");
          return JSON.parse(raw) as {
            slug?: string;
            name?: string;
            summary?: string;
            file?: string;
            url?: string;
            features?: string[];
            tags?: string[];
          };
        } catch (error) {
          console.warn(`Unable to parse download file ${file}:`, error);
          return null;
        }
      })
      .filter(Boolean)
  : [];

const downloads = (downloadFiles as {
  slug?: string;
  name?: string;
  summary?: string;
  file?: string;
  url?: string;
  features?: string[];
  tags?: string[];
}[]).filter((item) => {
  if (!item) return false;
  const target = typeof item.file === "string" && item.file.trim().length > 0 ? item.file : item.url;
  if (typeof target !== "string" || target.trim().length === 0) return false;
  return !target.startsWith("/home/");
});

const downloadCollectionSchema =
  downloads.length > 0
    ? createCollectionPageSchema(
        settings,
        {
          name: "Ritual Lab Printables",
          url: "/lab/#downloads",
          description:
            "Download ready-to-print planners or open them in your browser, then export to PDF for gentle ritual support.",
          itemType: "DigitalDocument",
        },
        downloads.map((item) => {
          const fileTarget = typeof item.file === "string" ? item.file.trim() : "";
          const urlTarget = typeof item.url === "string" ? item.url.trim() : "";
          const href = fileTarget || urlTarget || "#";
          return {
            name: item.name ?? "Ritual Lab download",
            url: href,
            description: item.summary,
          };
        }),
      )
    : null;

const automationIdeas = [
  "Save your chosen ritual to a shared calendar using the reminder download.",
  "Schedule a weekly email to yourself with Buttondown's digest feature and paste the ritual steps there.",
  "Batch print three copies of the sampler planner so you can circle back whenever you feel foggy.",
];

function toLabel(value: string): string {
  return value
    .split(/[\s_-]+/)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

const ritualData = entries.map((entry) => ({
  slug: entry.slug,
  title: entry.title,
  summary: entry.summary,
  intents: entry.intents,
  tools: entry.tools,
  tags: entry.tags,
  durationMinutes: entry.durationMinutes,
  materials: entry.materials,
  steps: entry.steps,
}));
---
<Base {title} {description}>
  {downloadCollectionSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(downloadCollectionSchema)} />
    </HeadSlot>
  )}
  <section class="mx-auto max-w-6xl space-y-6 py-12">
    <header class="space-y-3 text-center">
      <p class="text-sm uppercase tracking-widest text-accent">Phase 2 Lab</p>
      <h1 class="font-serif text-4xl">Prototype Ritual Generator</h1>
      <p class="mx-auto max-w-2xl text-base opacity-80">
        Pair your current intention with the tools you have on hand. The ritual lab suggests a sequence, offers alternates, and shares printable exports so you can carry the flow into your week.
      </p>
    </header>

    <div class="grid gap-8 lg:grid-cols-[320px_1fr]">
      <form id="lab-form" class="space-y-6 rounded-3xl border border-line-muted/60 bg-surface-base/80 p-6 shadow-lg backdrop-blur dark:border-line-accent-deep/40 dark:bg-surface-veil/70">
        <div class="space-y-2">
          <label for="intent" class="block text-sm font-semibold uppercase tracking-wide text-tertiary">
            Intention
          </label>
          <select
            id="intent"
            name="intent"
            class="w-full rounded-2xl border border-line-muted bg-surface-base px-4 py-3 text-sm font-medium text-primary shadow-sm focus:border-line-bold focus:outline-none focus:ring-2 focus:ring-focus/60 dark:border-line-accent dark:bg-surface-backdrop dark:text-accent-ghost"
          >
            {intents.map((intent) => (
              <option value={intent} selected={intent === defaultIntent}>
                {toLabel(intent)}
              </option>
            ))}
          </select>
        </div>

        <div class="space-y-2">
          <span class="block text-sm font-semibold uppercase tracking-wide text-tertiary">Tools & Texture</span>
          <p class="text-xs opacity-70">Pick what you have nearby—sound gear, journals, or group energy.</p>
          <div class="mt-3 grid gap-2">
            {toolOptions.map((tool) => (
              <label class="flex items-center gap-3 rounded-2xl border border-line-muted/80 bg-surface-muted/80 px-3 py-2 text-sm font-medium text-primary transition hover:border-line-bolder dark:border-line-accent/60 dark:bg-surface-accent-midnight/30 dark:text-accent-ghost">
                <input type="checkbox" name="tools" value={tool.value} class="h-4 w-4 rounded border-line-strong text-tertiary focus:ring-focus-strong" />
                <span>{tool.label}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="space-y-2">
          <label for="time" class="block text-sm font-semibold uppercase tracking-wide text-tertiary">
            Available Time
          </label>
          <select
            id="time"
            name="time"
            class="w-full rounded-2xl border border-line-muted bg-surface-base px-4 py-3 text-sm font-medium text-primary shadow-sm focus:border-line-bold focus:outline-none focus:ring-2 focus:ring-focus/60 dark:border-line-accent dark:bg-surface-backdrop dark:text-accent-ghost"
          >
            {timeOptions.map((option) => (
              <option value={option.value} selected={option.value === defaultTime}>
                {option.label}
              </option>
            ))}
          </select>
        </div>

        <button
          type="button"
          id="generate-btn"
          class="w-full rounded-2xl bg-surface-accent-strong px-4 py-3 text-sm font-semibold uppercase tracking-wide text-inverse shadow-md transition hover:bg-surface-accent focus:outline-none focus:ring-2 focus:ring-focus"
        >
          Refresh Ritual
        </button>
      </form>

      <div class="space-y-6">
        <section class="rounded-3xl border border-line-muted/60 bg-surface-base/90 p-6 shadow-lg backdrop-blur dark:border-line-accent-deep/50 dark:bg-surface-veil/70">
          <h2 class="font-serif text-2xl">Your Ritual Draft</h2>
          <div id="ritual-output" class="mt-4 space-y-4 text-base"></div>
        </section>

        <section class="rounded-3xl border border-line-muted/60 bg-surface-base/90 p-6 shadow-lg backdrop-blur dark:border-line-accent-deep/50 dark:bg-surface-veil/70">
          <h3 class="font-serif text-xl">Quick Automation Seeds</h3>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-sm opacity-80">
            {automationIdeas.map((idea) => (
              <li>{idea}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section id="printables" class="mx-auto max-w-6xl space-y-6 py-12">
    <header class="space-y-2 text-center">
      <h2 class="font-serif text-3xl">Printables & Planner Exports</h2>
      <p class="mx-auto max-w-2xl text-base opacity-80">
        Download ready-to-print planners or open them in your browser, then export to PDF. Leave your email if you want updates when new printables land—skipping is perfectly fine.
      </p>
    </header>

    <form
      class="mx-auto max-w-2xl space-y-3 rounded-3xl border border-line-muted/70 bg-surface-muted/80 p-6 shadow-lg backdrop-blur dark:border-line-accent-strong/60 dark:bg-surface-accent-midnight/40"
      name="ritual-lab-downloads"
      method="POST"
      data-netlify="true"
    >
      <input type="hidden" name="form-name" value="ritual-lab-downloads" />
      <label class="block text-sm font-medium text-primary dark:text-accent-ghost">
        Email (optional)
        <input
          type="email"
          name="email"
          inputmode="email"
          placeholder="you@example.com"
          class="mt-2 w-full rounded-2xl border border-line-muted bg-surface-base px-4 py-3 text-sm shadow-sm focus:border-line-bold focus:outline-none focus:ring-2 focus:ring-focus/60 dark:border-line-accent dark:bg-surface-backdrop dark:text-accent-ghost"
        />
      </label>
      <div class="flex flex-wrap items-center gap-3 text-xs opacity-70">
        <button type="submit" class="rounded-full bg-surface-accent-strong px-4 py-2 text-inverse shadow hover:bg-surface-accent">
          Send me future printables
        </button>
        <span>or</span>
        <a class="rounded-full border border-line-strong px-4 py-2 font-medium text-secondary hover:border-line-bold" href="#downloads">
          Skip & browse downloads
        </a>
      </div>
    </form>

    <div id="downloads" class="grid gap-6 md:grid-cols-2">
      {downloads.length === 0 ? (
        <p class="text-center text-base opacity-70">New printables are brewing—check back soon.</p>
      ) : (
        downloads.map((item) => (
          <article class="flex h-full flex-col justify-between rounded-3xl border border-line-muted/60 bg-surface-base/90 p-6 shadow-lg backdrop-blur dark:border-line-accent-deep/50 dark:bg-surface-veil/70">
            <div class="space-y-3">
              <h3 class="font-serif text-xl">{item.name}</h3>
              {item.summary && <p class="text-sm opacity-80">{item.summary}</p>}
              {item.features && item.features.length > 0 && (
                <ul class="list-disc space-y-1 pl-5 text-xs opacity-70">
                  {item.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              )}
              {item.tags && item.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <span class="rounded-full bg-surface-soft px-3 py-1 text-xs font-medium text-primary-strong dark:bg-surface-accent-night/40 dark:text-accent-ghost">
                      {toLabel(tag)}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <div class="mt-4 flex items-center gap-3">
              <a
                class="inline-flex items-center gap-2 rounded-full bg-surface-accent-strong px-4 py-2 text-sm font-semibold text-inverse shadow hover:bg-surface-accent"
                href={item.file || item.url}
              >
                Open Download
                <span aria-hidden>↗</span>
              </a>
              <a
                class="text-xs font-medium text-secondary underline hover:text-accent"
                href="/lab/three-day-sampler"
              >
                View printable preview
              </a>
            </div>
          </article>
        ))
      )}
    </div>
  </section>

  {evergreenCta && (
    <div class="lab-evergreen">
      <EvergreenCta {...evergreenCta} />
    </div>
  )}

  {testimonials.length > 0 && (
    <section class="lab-testimonials" aria-labelledby="lab-testimonials-heading">
      <div class="lab-testimonials__header">
        {testimonialSection?.eyebrow && <p class="lab-testimonials__eyebrow">{testimonialSection.eyebrow}</p>}
        <h2 id="lab-testimonials-heading" class="lab-testimonials__title">
          {testimonialSection?.title ?? "Community notes"}
        </h2>
        {testimonialSection?.description && (
          <p class="lab-testimonials__description">{testimonialSection.description}</p>
        )}
      </div>
      <Testimonials testimonials={testimonials} />
    </section>
  )}

  <section class="mx-auto max-w-6xl space-y-4 py-12">
    <h2 class="font-serif text-3xl">Reminders</h2>
    <p class="max-w-3xl text-base opacity-80">
      Prefer nudges over memory? Download the static reminder file below to add the three-day sampler to your calendar of choice. You can also copy the ritual steps into your task manager—no tracking pixels required.
    </p>
    <a
      class="inline-flex items-center gap-2 rounded-full border border-line-bolder px-5 py-2 text-sm font-semibold text-primary-strong transition hover:bg-surface-soft dark:border-line-accent dark:text-accent-ghost dark:hover:bg-surface-accent-night/40"
      href="/reminders/three-day-ritual-sampler.ics"
    >
      Download .ics reminders
      <span aria-hidden>↓</span>
    </a>
  </section>

  <script type="application/json" id="ritual-lab-data">{JSON.stringify({ entries: ritualData })}</script>
  <script type="module">
    const dataEl = document.getElementById("ritual-lab-data");
    const form = document.getElementById("lab-form");
    const output = document.getElementById("ritual-output");
    const generateBtn = document.getElementById("generate-btn");

    if (dataEl && form && output && generateBtn) {
      const payload = JSON.parse(dataEl.textContent || "{}");
      const entries = Array.isArray(payload.entries) ? payload.entries : [];

      const renderEntry = (entry) => {
        const container = document.createElement("div");
        container.className = "space-y-4";

        const heading = document.createElement("div");
        heading.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="font-serif text-xl">${entry.title}</h3>
              ${entry.summary ? `<p class="text-sm opacity-80">${entry.summary}</p>` : ""}
            </div>
            ${entry.durationMinutes ? `<span class="rounded-full bg-surface-soft px-3 py-1 text-xs font-semibold text-primary-strong">${entry.durationMinutes} min</span>` : ""}
          </div>
        `;
        container.appendChild(heading);

        if (entry.materials && entry.materials.length > 0) {
          const materials = document.createElement("div");
          materials.innerHTML = `
            <p class="text-xs font-semibold uppercase tracking-wide text-tertiary">Materials</p>
            <ul class="mt-1 flex flex-wrap gap-2 text-xs opacity-80">
              ${entry.materials
                .map((item) => `<li class="rounded-full bg-surface-muted px-3 py-1 text-primary-strong">${toTitle(item)}</li>`)
                .join("")}
            </ul>
          `;
          container.appendChild(materials);
        }

        if (entry.steps && entry.steps.length > 0) {
          const list = document.createElement("ol");
          list.className = "space-y-3 border-t border-line-subtle pt-4 text-sm";
          entry.steps.forEach((step, index) => {
            const item = document.createElement("li");
            item.innerHTML = `
              <div class="space-y-1">
                <div class="flex items-center gap-3">
                  <span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-soft font-semibold text-primary-strong">${index + 1}</span>
                  <div>
                    <p class="font-semibold">${step.title || `Step ${index + 1}`}</p>
                    ${step.duration ? `<p class="text-xs opacity-70">${step.duration}</p>` : ""}
                  </div>
                </div>
                <p class="pl-11 leading-relaxed opacity-90">${step.description}</p>
              </div>
            `;
            list.appendChild(item);
          });
          container.appendChild(list);
        }

        return container;
      };

      const toTitle = (value) => value.replace(/[-_]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

      const scoreEntry = (entry, state) => {
        let score = 0;
        if (state.intent && entry.intents.includes(state.intent.toLowerCase())) score += 5;
        if (state.tools.length > 0) {
          const matched = state.tools.filter((tool) => entry.tools.includes(tool.toLowerCase()));
          score += matched.length * 2;
        }
        if (
          Number.isFinite(state.maxMinutes) &&
          Number.isFinite(entry.durationMinutes) &&
          entry.durationMinutes <= state.maxMinutes
        ) {
          score += 3;
        }
        if (state.tools.includes("sound") && entry.tags.includes("sound")) score += 1;
        if (state.tools.includes("nosound") && entry.tags.includes("nosound")) score += 1;
        if (state.tools.includes("group") && entry.tags.includes("group")) score += 1;
        if (state.tools.includes("solo") && entry.tags.includes("solo")) score += 1;
        return score;
      };

      const buildPlan = (state) => {
        const scored = entries
          .map((entry) => ({ entry, score: scoreEntry(entry, state) }))
          .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title));
        const primary = scored.find((item) => item.score > 0)?.entry;
        const alternates = scored
          .filter((item) => item.entry !== primary && item.score > 0)
          .slice(0, 3)
          .map((item) => item.entry);
        return { primary, alternates };
      };

      const update = () => {
        const formData = new FormData(form);
        const intent = (formData.get("intent") || "").toString();
        const maxMinutesValue = parseInt((formData.get("time") || "0").toString(), 10);
        const tools = Array.from(form.querySelectorAll('input[name="tools"]:checked')).map((input) => input.value);
        const state = {
          intent,
          maxMinutes: Number.isFinite(maxMinutesValue) ? maxMinutesValue : undefined,
          tools,
        };

        const plan = buildPlan(state);
        output.innerHTML = "";

        if (plan.primary) {
          const primaryHeader = document.createElement("p");
          primaryHeader.className = "text-xs font-semibold uppercase tracking-wide text-tertiary";
          primaryHeader.textContent = "Primary match";
          output.appendChild(primaryHeader);
          output.appendChild(renderEntry(plan.primary));
        } else {
          const empty = document.createElement("p");
          empty.className = "text-sm opacity-70";
          empty.textContent = "No exact matches yet. Try toggling different tools or a longer time window.";
          output.appendChild(empty);
        }

        if (plan.alternates && plan.alternates.length > 0) {
          const altHeading = document.createElement("p");
          altHeading.className = "text-xs font-semibold uppercase tracking-wide text-tertiary";
          altHeading.textContent = "Other ideas";
          output.appendChild(altHeading);
          plan.alternates.forEach((entry) => {
            const wrapper = document.createElement("div");
            wrapper.className = "rounded-2xl border border-line-subtle/80 bg-surface-muted/60 p-4";
            wrapper.appendChild(renderEntry(entry));
            output.appendChild(wrapper);
          });
        }
      };

      generateBtn.addEventListener("click", update);
      form.addEventListener("change", (event) => {
        if ((event.target instanceof HTMLSelectElement && event.target.name !== "tools") || event.target instanceof HTMLInputElement) {
          update();
        }
      });

      // Seed initial plan
      output.innerHTML = "";
      if (payload.entries.length === 0) {
        const empty = document.createElement("p");
        empty.className = "text-sm opacity-70";
        empty.textContent = "Ritual data not found. Add labRitual metadata to content/posts entries to populate this space.";
        output.appendChild(empty);
      } else {
        update();
  }
}
</script>

<style>
  .lab-evergreen {
    margin: clamp(2.5rem, 6vw, 3.5rem) auto;
    max-width: min(48rem, 90vw);
  }

  .lab-testimonials {
    margin: clamp(3rem, 7vw, 4.5rem) auto;
    max-width: min(72rem, 94vw);
    display: grid;
    gap: clamp(1.6rem, 4vw, 2.6rem);
  }

  .lab-testimonials__header {
    display: grid;
    gap: 0.75rem;
    text-align: center;
  }

  .lab-testimonials__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(124, 58, 237, 0.7);
  }

  .lab-testimonials__title {
    margin: 0;
    font-family: var(--font-heading, var(--font-body, inherit));
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lab-testimonials__description {
    margin: 0 auto;
    max-width: 48rem;
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .lab-testimonials :global(.testimonials) {
    margin: 0;
  }
</style>
</Base>
