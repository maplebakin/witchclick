---
import Base from '../../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dir = './content/downloads';
  if (!fs.existsSync(dir)) return [];
  const files = fs.readdirSync(dir).filter(f=>f.endsWith('.json'));
  return files.map(f=>{
    const data = JSON.parse(fs.readFileSync(path.join(dir,f),'utf8'));
    return { params: { slug: data.slug || data.id }, props: { data } };
  });
}

const { data } = Astro.props;
const settings = JSON.parse(fs.readFileSync('./content/settings.json','utf8'));
const title = data?.name || 'Download';
const description = data?.summary || '';
const canon = `${String(settings.siteUrl||'https://example.com').replace(/\/$/,'')}/downloads/${data?.slug}`;
const hasExternal = !!(data?.url && data.url.trim());
const href = hasExternal ? data.url : (data?.file || '#');
const target = hasExternal ? '_blank' : undefined;
const rel = hasExternal ? 'noopener' : undefined;
---
<Base title={title} description={description} canon={canon}>
  <article class="prose prose-neutral max-w-none">
    <h1 class="mb-2">{title}</h1>
    {description && <p class="mt-0 text-sm text-gray-600">{description}</p>}

    <div class="my-6 grid gap-6 md:grid-cols-3">
      <div class="md:col-span-2">
        {data.cover && <img src={data.cover} alt={`${data.name} cover`} class="w-full rounded-xl border object-cover" loading="lazy" />}
        {Array.isArray(data.features) && data.features.length > 0 && (
          <>
            <h2 class="mt-6">What’s inside</h2>
            <ul>
              {data.features.map((f:string)=><li>{f}</li>)}
            </ul>
          </>
        )}
      </div>
      <aside class="md:col-span-1">
        <div class="sticky top-24 rounded-2xl border border-purple-200 bg-purple-50 p-4">
          {(data.price && data.currency) ? (
            <p class="m-0 text-lg font-semibold">
              {new Intl.NumberFormat(undefined, { style:'currency', currency:data.currency }).format(parseFloat(data.price))}
            </p>
          ) : <p class="m-0 text-lg font-semibold">Free</p>}
          <p class="mt-1 text-sm text-purple-900">Instant digital download.</p>
          <a href={href} target={target} rel={rel}
             class="mt-3 inline-block rounded-lg bg-purple-700 px-4 py-2 font-medium text-white hover:bg-purple-800"
             data-analytics="download_click" data-analytics-meta={data.id}>
            {hasExternal ? 'Buy now' : 'Download PDF'}
          </a>
          {data.file && !hasExternal && <p class="mt-2 text-xs text-purple-900">Opens a PDF. Save to keep.</p>}
        </div>
      </aside>
    </div>
  </article>
</Base>
