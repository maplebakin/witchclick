---
import Base from "../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";
import { readSettings, getSiteOrigin } from "../../utils/settings";

export async function getStaticPaths() {
  const dir = "./content/downloads";
  if (!fs.existsSync(dir)) return [];

  const files = fs.readdirSync(dir).filter((file) => file.endsWith(".json"));
  return files.map((file) => {
    const data = JSON.parse(fs.readFileSync(path.join(dir, file), "utf8"));
    return { params: { slug: data.slug || data.id }, props: { data } };
  });
}

const { data } = Astro.props;
const settings = readSettings();
const site = getSiteOrigin(settings) || "https://example.com";
const title = data?.name || "Download";
const description = data?.summary || "";
const canon = `${site}/downloads/${data?.slug}`;
const hasExternal = !!(data?.url && String(data.url).trim());
const href = hasExternal ? data.url : data?.file || "#";
const target = hasExternal ? "_blank" : undefined;
const rel = hasExternal ? "noopener" : undefined;
---
<Base title={title} description={description} canon={canon}>
  <article class="prose prose-neutral max-w-none">
    <h1 class="mb-2">{title}</h1>
    {description && <p class="mt-0 text-sm text-gray-600">{description}</p>}

    <div class="my-6 grid gap-6 md:grid-cols-3">
      <div class="md:col-span-2">
        {data.cover && (
          <img
            src={data.cover}
            alt={`${data.name} cover`}
            class="w-full rounded-xl border object-cover"
            loading="lazy"
          />
        )}
        {Array.isArray(data.features) && data.features.length > 0 && (
          <>
            <h2 class="mt-6">What’s inside</h2>
            <ul>
              {data.features.map((feature: string) => (
                <li>{feature}</li>
              ))}
            </ul>
          </>
        )}
      </div>
      <aside class="md:col-span-1">
        <div class="sticky top-24">
          <div class="card-panel card-tier-2 card-panel-strong card-panel-static">
            <span aria-hidden class="card-radial card-radial-soft" />
            <div class="relative z-10 space-y-4">
              <div class="space-y-2">
                <p class="card-eyebrow">Download</p>
                <span class="card-pill card-badge">
                  {data.price && data.currency
                    ? new Intl.NumberFormat(undefined, {
                        style: "currency",
                        currency: data.currency,
                      }).format(parseFloat(data.price))
                    : "Free"}
                </span>
                <p class="card-subtle text-sm leading-relaxed">Instant digital download.</p>
              </div>
              <a
                href={href}
                target={target}
                rel={rel}
                class="inline-flex w-full items-center justify-center rounded-full bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:ring-offset-2"
                data-analytics="download_click"
                data-analytics-meta={data.id}
              >
                {hasExternal ? "Buy now" : "Download PDF"}
              </a>
              {data.file && !hasExternal && (
                <p class="text-xs text-purple-900/80">Opens a PDF. Save to keep.</p>
              )}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </article>
</Base>
