---
import Base from '../../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
const settings = JSON.parse(fs.readFileSync('./content/settings.json','utf8'));
const dir = './content/downloads';
const items:any[] = [];
if (fs.existsSync(dir)) {
  for (const f of fs.readdirSync(dir).filter(x=>x.endsWith('.json'))) {
    try { items.push(JSON.parse(fs.readFileSync(path.join(dir,f),'utf8'))); } catch {}
  }
}
items.sort((a,b)=> (a.name||'').localeCompare(b.name||''));
---
<Base title="Downloads" description="Printable planners and cozy tools." canon={`${settings.siteUrl.replace(/\/$/,'')}/downloads`}>
  <section class="prose prose-neutral max-w-none">
    <h1>Downloads</h1>
    {items.length===0 && <p>No downloads yet.</p>}
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      {items.map((it)=>(
        <a href={`/downloads/${it.slug}`} class="block rounded-2xl border border-purple-200 bg-purple-50 p-4 hover:bg-purple-100">
          <div class="flex gap-4">
            {it.cover && <img src={it.cover} alt={`${it.name} cover`} class="h-20 w-20 rounded-lg object-cover" loading="lazy" />}
            <div>
              <h2 class="m-0 text-lg font-semibold">{it.name}</h2>
              <p class="m-0 text-sm text-purple-900">{it.summary}</p>
              <p class="m-0 mt-1 text-sm">
                {(it.price && it.currency) ? new Intl.NumberFormat(undefined,{style:'currency',currency:it.currency}).format(parseFloat(it.price)) : 'Free'}
              </p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
