---
import Base from "../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";
import { readSettings, getSiteOrigin } from "../../utils/settings";

const settings = readSettings();
const site = getSiteOrigin(settings);
const dir = "./content/downloads";
const items: any[] = [];

if (fs.existsSync(dir)) {
  for (const file of fs.readdirSync(dir).filter((name) => name.endsWith(".json"))) {
    try {
      const parsed = JSON.parse(fs.readFileSync(path.join(dir, file), "utf8"));
      items.push(parsed);
    } catch (error) {
      if (import.meta.env.DEV) {
        console.warn(`[downloads] Failed to parse ${file}:`, error);
      }
    }
  }
}

items.sort((a, b) => (a.name || "").localeCompare(b.name || ""));
---
<Base
  title="Downloads"
  description="Printable planners and cozy tools."
  canon={site ? `${site}/downloads` : ""}
>
  <section class="prose prose-neutral max-w-none">
    <h1>Downloads</h1>
    {items.length === 0 && <p>No downloads yet.</p>}
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {items.map((item) => (
        <a
          href={`/downloads/${item.slug}`}
          class="card-panel card-tier-1 card-panel-strong focus-visible:outline-none"
        >
          <span aria-hidden class="card-radial card-radial-top" />
          <span aria-hidden class="card-radial card-radial-bottom" />
          <div class="relative z-10 flex gap-4">
            {item.cover && (
              <img
                src={item.cover}
                alt={`${item.name} cover`}
                class="h-20 w-20 flex-none rounded-xl border border-white/60 object-cover shadow-sm"
                loading="lazy"
              />
            )}
            <div class="space-y-2">
              <h2 class="card-heading m-0 text-lg font-semibold">{item.name}</h2>
              <p class="m-0 text-sm text-purple-900/80 line-clamp-3">{item.summary}</p>
              <span class="card-pill card-badge">
                {item.price && item.currency
                  ? new Intl.NumberFormat(undefined, {
                      style: "currency",
                      currency: item.currency,
                    }).format(parseFloat(item.price))
                  : "Free"}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
