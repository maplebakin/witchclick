---
import Base from "../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";
import { readSettings, getSiteOrigin } from "../../utils/settings";
import { createCollectionPageSchema } from "../../utils/structuredData";
import { Fragment } from "astro/jsx-runtime";

const settings = readSettings();
const site = getSiteOrigin(settings);
const dir = "./content/downloads";
const items: any[] = [];

if (fs.existsSync(dir)) {
  for (const file of fs.readdirSync(dir).filter((name) => name.endsWith(".json"))) {
    try {
      const parsed = JSON.parse(fs.readFileSync(path.join(dir, file), "utf8"));
      items.push(parsed);
    } catch (error) {
      if (import.meta.env.DEV) {
        console.warn(`[downloads] Failed to parse ${file}:`, error);
      }
    }
  }
}

items.sort((a, b) => (a.name || "").localeCompare(b.name || ""));

const downloadsSchema = createCollectionPageSchema(
  settings,
  {
    name: "Downloads",
    url: "/downloads",
    description: "Printable planners and cozy tools.",
    itemType: "CreativeWork",
  },
  items.map((item) => ({
    name: item.name ?? "Download",
    url: `/downloads/${item.slug}`,
    description: item.summary ?? undefined,
    image: item.cover ?? undefined,
  })),
);
---
<Base
  title="Downloads"
  description="Printable planners and cozy tools."
  canon={site ? `${site}/downloads` : ""}
  desktopWide={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(downloadsSchema)} />
  </Fragment>

  <div class="grimoire-bg min-h-screen">
    <section class="downloads-canvas mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 xl:max-w-7xl xl:px-12">
      <section class="downloads-panel panel" aria-labelledby="downloads-heading">
        <header class="downloads-header">
          <div class="downloads-heading">
            <h1 id="downloads-heading" class="font-serif">Downloads</h1>
            <p>Printable planners and cozy tools.</p>
          </div>
          <div class="downloads-header-visual" aria-hidden="true">
            <span class="downloads-header-glyph">✂️</span>
            <span class="downloads-header-note">Ready-to-print rituals for your desk.</span>
          </div>
        </header>

        {items.length === 0 ? (
          <div class="downloads-empty soft-card" role="status">
            <span class="downloads-empty-icon" aria-hidden="true">✨</span>
            <p class="downloads-empty-copy">Fresh printable spells are on their way. Check back after the next moon.</p>
          </div>
        ) : (
          <div class="downloads-grid">
            {items.map((item) => (
              <a
                href={`/downloads/${item.slug}`}
                class="card-panel card-tier-1 card-panel-strong focus-visible:outline-none shadow-1"
              >
                <span aria-hidden class="card-radial card-radial-top" />
                <span aria-hidden class="card-radial card-radial-bottom" />
                <div class="relative z-10 flex gap-4">
                  {item.cover && (
                    <img
                      src={item.cover}
                      alt={`${item.name} cover`}
                      class="h-24 w-24 flex-none rounded-xl border border-white/60 object-cover shadow-sm lg:h-28 lg:w-28"
                      loading="lazy"
                    />
                  )}
                  <div class="space-y-2">
                    <h2 class="card-heading m-0 text-lg font-semibold">{item.name}</h2>
                    <p class="m-0 text-sm text-purple-900/80 line-clamp-3">{item.summary}</p>
                    <span class="card-pill card-badge">
                      {item.price && item.currency
                        ? new Intl.NumberFormat(undefined, {
                            style: "currency",
                            currency: item.currency,
                          }).format(parseFloat(item.price))
                        : "Free"}
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>
    </section>
  </div>
</Base>

<style>
  .downloads-canvas {
    color: var(--ink-body, currentColor);
  }

  .downloads-panel {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    gap: clamp(1.35rem, 4vw, 2.35rem);
  }

  .downloads-header {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    align-items: start;
  }

  .downloads-heading {
    display: grid;
    gap: 0.5rem;
  }

  .downloads-heading h1 {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 2.85rem);
    color: var(--ink-strong, currentColor);
  }

  .downloads-heading p {
    margin: 0;
    max-width: 40ch;
    font-size: 1rem;
    color: color-mix(in srgb, var(--ink-body, currentColor) 90%, white 10%);
  }

  .downloads-header-visual {
    display: none;
  }

  .downloads-header-glyph {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    filter: drop-shadow(0 12px 28px rgba(79, 70, 229, 0.25));
  }

  .downloads-header-note {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 75%, white 25%);
    max-width: 24ch;
  }

  .downloads-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .downloads-grid > * {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .downloads-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .downloads-header {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }

    .downloads-heading {
      grid-column: span 7;
    }

    .downloads-header-visual {
      display: flex;
      grid-column: span 5;
      justify-self: end;
      align-items: center;
      gap: 0.75rem;
      padding-left: 1.5rem;
      border-left: 1px solid color-mix(in srgb, var(--ambient-color, var(--color-primary)) 30%, transparent);
    }
  }

  @media (min-width: 1280px) {
    .downloads-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .downloads-header-note {
      max-width: 28ch;
    }
  }

  .downloads-empty {
    display: grid;
    place-items: center;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3.5vw, 2.1rem);
    text-align: center;
    color: color-mix(in srgb, var(--ink-body, currentColor) 88%, white 12%);
  }

  .downloads-empty-icon {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    filter: drop-shadow(0 6px 15px color-mix(in srgb, var(--glow-iris, transparent) 85%, transparent));
  }

  .downloads-empty-copy {
    margin: 0;
    max-width: 36ch;
    font-size: 0.95rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 75%, white 25%);
  }

  .downloads-empty p {
    margin: 0;
  }
</style>
