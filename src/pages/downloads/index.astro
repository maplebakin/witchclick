---
import Base from "../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";
import { readSettings, getSiteOrigin } from "../../utils/settings";

const settings = readSettings();
const site = getSiteOrigin(settings);
const dir = "./content/downloads";
const items: any[] = [];

if (fs.existsSync(dir)) {
  for (const file of fs.readdirSync(dir).filter((name) => name.endsWith(".json"))) {
    try {
      const parsed = JSON.parse(fs.readFileSync(path.join(dir, file), "utf8"));
      items.push(parsed);
    } catch (error) {
      if (import.meta.env.DEV) {
        console.warn(`[downloads] Failed to parse ${file}:`, error);
      }
    }
  }
}

items.sort((a, b) => (a.name || "").localeCompare(b.name || ""));
---
<Base
  title="Downloads"
  description="Printable planners and cozy tools."
  canon={site ? `${site}/downloads` : ""}
>
  <section class="glass-panel">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <p class="eyebrow text-purple-400/90">Printable library</p>
        <h1 class="mt-2 text-3xl font-semibold text-purple-900">Downloads</h1>
      </div>
      <p class="text-sm text-purple-700/80">Instant digital files to support your rituals.</p>
    </div>

    {items.length === 0 ? (
      <div class="mt-8 rounded-2xl border border-purple-200/70 bg-white/70 p-6 text-sm text-purple-700/80">
        No downloads yet. Add a JSON file to <code>content/downloads</code> to get started.
      </div>
    ) : (
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {items.map((item) => (
          <a
            href={`/downloads/${item.slug}`}
            class="surface-card group flex items-start gap-4 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-200/50"
          >
            {item.cover && (
              <img
                src={item.cover}
                alt={`${item.name} cover`}
                class="h-20 w-20 flex-none rounded-xl object-cover shadow-sm"
                loading="lazy"
              />
            )}
            <div class="flex flex-col gap-2">
              <h2 class="text-lg font-semibold text-purple-900 transition group-hover:text-purple-950">{item.name}</h2>
              <p class="text-sm leading-relaxed text-purple-700/90">{item.summary}</p>
              <p class="text-sm font-medium text-purple-700">
                {item.price && item.currency
                  ? new Intl.NumberFormat(undefined, {
                      style: "currency",
                      currency: item.currency,
                    }).format(parseFloat(item.price))
                  : "Free"}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</Base>
