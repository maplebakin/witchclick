---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

export const prerender = true;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Search" },
];
---

<Base title="Search — WitchClick" description="Search WitchClick posts and rituals.">
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />

  <section class="wc-section-shell">
    <header class="page-header">
      <h1 class="page-header__title">Search</h1>
      <p class="page-header__lead">Find rituals, guides, and meanderings by keyword or tag.</p>
    </header>

    <div class="mt-8 grid gap-4">
      <label for="search-query" class="text-sm font-medium text-body-strong">Search query</label>
      <input
        id="search-query"
        type="search"
        placeholder="Try: adhd, tarot, grounding"
        class="w-full rounded-xl border border-line-neutral bg-surface-base px-4 py-3 text-body-strong shadow-sm"
      />
    </div>

    <div id="search-loading" class="mt-6 hidden text-sm text-body-muted">Searching…</div>
    <div id="search-empty" class="mt-6 hidden rounded-2xl border border-line-neutral bg-surface-soft p-4 text-sm text-body-muted"></div>
    <div id="search-results" class="mt-6 grid gap-4"></div>
  </section>
</Base>

<script type="module" is:inline>
  (() => {
    const input = document.getElementById("search-query");
    const loading = document.getElementById("search-loading");
    const empty = document.getElementById("search-empty");
    const results = document.getElementById("search-results");

    if (!(input instanceof HTMLInputElement) || !loading || !empty || !results) return;

    /** @type {Array<{ slug: string; title: string; excerpt?: string; tags?: string[] }>} */
    let index = [];
    let loaded = false;
    let unavailable = false;
    let timerId;

    const escapeHtml = (value) =>
      String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#39;");

    const setLoading = (isLoading) => {
      loading.classList.toggle("hidden", !isLoading);
    };

    const setEmpty = (message) => {
      if (!message) {
        empty.classList.add("hidden");
        empty.textContent = "";
        return;
      }
      empty.classList.remove("hidden");
      empty.textContent = message;
    };

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const runResultEnterAnimation = () => {
      const cards = Array.from(results.children);

      cards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;
        const delayMs = Math.min(index, 5) * 30;
        card.style.setProperty("--result-enter-delay", `${delayMs}ms`);
      });

      results.classList.remove("result-enter");

      if (prefersReducedMotion()) return;

      void results.offsetWidth;
      results.classList.add("result-enter");
    };

    const clearResults = () => {
      results.classList.remove("result-enter");
      results.innerHTML = "";
    };

    const syncUrl = (query) => {
      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set("q", query);
      } else {
        url.searchParams.delete("q");
      }
      const next = `${url.pathname}${url.search}${url.hash}`;
      window.history.replaceState({}, "", next);
    };

    const ensureIndex = async () => {
      if (loaded || unavailable) return;

      setLoading(true);
      try {
        const response = await fetch("/search.json", { cache: "no-store" });
        if (!response.ok) throw new Error(`Bad response: ${response.status}`);
        const payload = await response.json();
        if (!Array.isArray(payload)) throw new Error("Invalid search payload");
        index = payload;
        loaded = true;
      } catch {
        unavailable = true;
        setEmpty("Search is loading — please try the search bar in the header.");
      } finally {
        setLoading(false);
      }
    };

    const render = (items) => {
      if (!items.length) {
        clearResults();
        return;
      }

      results.innerHTML = items
        .slice(0, 24)
        .map((item) => {
          const title = escapeHtml(item.title || item.slug || "Untitled");
          const excerpt = escapeHtml(typeof item.excerpt === "string" ? item.excerpt : "");
          const href = `/post/${encodeURIComponent(String(item.slug || "").trim())}`;

          return `
            <a href="${href}" class="block rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm transition-colors hover:bg-surface-soft">
              <h2 class="text-base font-semibold text-body-strong">${title}</h2>
              ${excerpt ? `<p class=\"mt-2 text-sm text-body-muted\">${excerpt}</p>` : ""}
            </a>
          `;
        })
        .join("");

      runResultEnterAnimation();
    };

    const runSearch = async (rawQuery, shouldSyncUrl) => {
      const query = String(rawQuery || "").trim().toLowerCase();
      if (shouldSyncUrl) {
        syncUrl(query);
      }

      if (!query) {
        clearResults();
        setEmpty("Type a keyword to start searching.");
        return;
      }

      await ensureIndex();
      if (!loaded || unavailable) {
        clearResults();
        return;
      }

      const normalized = query.startsWith("#") ? query.slice(1) : query;
      const matches = index.filter((item) => {
        const tags = Array.isArray(item.tags) ? item.tags.join(" ") : "";
        const haystack = `${item.title || ""} ${item.excerpt || ""} ${tags}`.toLowerCase();
        return haystack.includes(normalized);
      });

      if (!matches.length) {
        clearResults();
        setEmpty(`No results for “${rawQuery}”.`);
        return;
      }

      setEmpty("");
      render(matches);
    };

    input.addEventListener("input", (event) => {
      if (timerId) {
        window.clearTimeout(timerId);
      }

      const target = event.target;
      const value = target instanceof HTMLInputElement ? target.value : "";
      timerId = window.setTimeout(() => {
        runSearch(value, true);
      }, 120);
    });

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get("q")?.trim() || "";
    if (initialQuery) {
      input.value = initialQuery;
      runSearch(initialQuery, false);
    } else {
      setEmpty("Type a keyword to start searching.");
    }
  })();
</script>

<style is:inline>
  @keyframes search-result-enter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes search-result-item-enter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  #search-results.result-enter {
    opacity: 0;
    animation: search-result-enter 200ms ease forwards;
  }

  #search-results.result-enter > * {
    opacity: 0;
    animation: search-result-item-enter 200ms ease forwards;
    animation-delay: var(--result-enter-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    #search-results.result-enter,
    #search-results.result-enter > * {
      animation: none;
      opacity: 1;
    }
  }
</style>
