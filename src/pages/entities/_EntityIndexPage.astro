---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntityCard from "../../components/EntityCard.astro";
import { getTypeMetadata } from "../../data/typeMetadata";
import { getEntitiesForType } from "../../utils/entityIndex";

interface Props {
  type: string;
}

const { type } = Astro.props as Props;

const metadata = getTypeMetadata(type);
const entities = getEntitiesForType(type, metadata);

function formatTypeLabel(value: string): string {
  const spaced = value.replace(/[-_]/g, " ").replace(/([a-z])([A-Z])/g, "$1 $2");
  return spaced.charAt(0).toUpperCase() + spaced.slice(1);
}

const typeLabel = formatTypeLabel(type);
const lowerTypeLabel = typeLabel.toLowerCase();
const pageLead = [metadata.subtitle, metadata.introText].filter((value) => typeof value === "string" && value.trim().length > 0).join(" ");
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Entities", href: "/entities" },
  { label: typeLabel },
];
---
<Base title={metadata.title} description={metadata.subtitle} bodyDataType={type}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="max-w-screen-lg mx-auto py-8 md:py-12 px-4">
    <header class="page-header">
      <p class="page-header__eyebrow"><span aria-hidden="true">{metadata.icon}</span> {typeLabel} index</p>
      <h1 class="page-header__title">{metadata.title}</h1>
      <p class="page-header__lead">{pageLead}</p>
    </header>

    {entities.length === 0 ? (
      <div class="mt-10 rounded-2xl border border-dashed border-line-neutral-strong bg-surface-muted p-6 text-center text-sm text-body-muted">
        <p>
          No {lowerTypeLabel} entries are live yet. Share a note with the
          <a class="font-semibold text-brand-primary hover:underline" href="/about">WitchClick team</a>
          to request a feature or check back soon for fresh lore.
        </p>
      </div>
    ) : (
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
        {entities.map((entity) => (
          <EntityCard
            type={entity.type}
            slug={entity.slug}
            name={entity.name}
            summary={entity.summary}
            tags={entity.tags}
            isStub={entity.isStub}
            variant="grimoire"
            theme={metadata}
          />
        ))}
      </div>
    )}
  </section>
</Base>
