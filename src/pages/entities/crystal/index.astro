---
import Base from "../../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";

type Entity = { type: string; slug: string; name?: string; summary?: string; properties?: Record<string, any>; };

function findDir() {
  const roots = ["./content/entities/crystal", "./src/content/entities/crystal"];
  for (const r of roots) if (fs.existsSync(r)) return r;
  return "";
}

const dir = findDir();
let items: Entity[] = [];
if (dir) {
  for (const f of fs.readdirSync(dir).filter((x)=>x.endsWith(".json"))) {
    try {
      const raw = fs.readFileSync(path.join(dir, f), "utf8");
      const data = JSON.parse(raw);
      const slug = (data?.slug ? String(data.slug) : f.replace(/\.json$/, "")).toLowerCase();
      items.push({ type: "crystal", slug, name: data?.name || slug, summary: data?.summary || "", properties: data?.properties || {} });
    } catch {}
  }
}
items.sort((a,b)=> (a.name||"").localeCompare(b.name||""));

const pageTitle = "Crystals — A–Z";
---
<Base title={pageTitle}>
  <h1 class="mb-4 font-serif text-3xl">Crystals — A–Z</h1>
  {items.length === 0 ? (
    <p class="text-slate-600">No crystals yet.</p>
  ) : (
    <ul class="grid gap-4 sm:grid-cols-2">
      {items.map((e)=>(
        <li class="rounded-lg border bg-white p-4 shadow-sm">
          <a href={`/entities/crystal/${e.slug}`} class="text-lg font-semibold hover:underline">{e.name}</a>
          {e.summary && <p class="mt-1 text-sm text-slate-600">{e.summary}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
