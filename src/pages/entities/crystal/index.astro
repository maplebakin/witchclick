---
import Base from "../../../layouts/Base.astro";
import EntityCard from "../../../components/EntityCard.astro";
import { readAllEntities } from "../../../utils/entities";

const { crystal: crystalEntries = [] } = readAllEntities();

function toTitleCase(value) {
  return value
    .split(/\s+/)
    .map((word) => (word ? word[0].toUpperCase() + word.slice(1) : ""))
    .join(" ");
}

function collectFromValue(value) {
  if (Array.isArray(value)) {
    return value.flatMap((entry) => collectFromValue(entry));
  }
  if (typeof value === "string") {
    return value
      .split(/[,;/]| & |\band\b/i)
      .map((part) => part.trim())
      .filter(Boolean);
  }
  return [];
}

function extractKeywords(entity) {
  const properties = entity.properties ?? {};
  const keywords = new Set();

  [properties.tags, properties.keywords, properties.aspects, properties.vibes, properties.talismans].forEach((value) => {
    collectFromValue(value).forEach((keyword) => keywords.add(keyword));
  });

  if (properties.correspondences && typeof properties.correspondences === "object") {
    Object.values(properties.correspondences).forEach((value) => {
      collectFromValue(value).forEach((keyword) => keywords.add(keyword));
    });
  }

  [properties.element, properties.planet, properties.color, properties.chakra].forEach((value) => {
    collectFromValue(value).forEach((keyword) => keywords.add(keyword));
  });

  return Array.from(keywords);
}

const crystals = crystalEntries
  .map((entry) => {
    const rawSummary = typeof entry.summary === "string" ? entry.summary.trim() : "";
    const isStub = !rawSummary || /stub entity/i.test(rawSummary);
    const summary = isStub ? "" : rawSummary;
    const tags = extractKeywords(entry);
    const displayName = entry.name ? toTitleCase(entry.name) : toTitleCase(entry.slug.replace(/-/g, " "));

    return {
      ...entry,
      name: displayName,
      summary,
      isStub,
      tags,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="The Crystal Index" description="A luminous directory of the crystals held within the WitchClick grimoire.">
  <section class="py-12">
    <header class="space-y-4">
      <h1 class="text-4xl font-serif text-purple-900">The Crystal Index</h1>
      <p class="max-w-2xl text-base leading-relaxed text-purple-900/80">
        Each gemstone below hums with an old-world resonance. Wander the lattice of shimmering entries, glean their whispered
        virtues, and mark the stones whose lore still waits to be inscribed.
      </p>
    </header>

    {crystals.length === 0 ? (
      <p class="mt-10 rounded-2xl border border-dashed border-purple-200/70 bg-purple-50/40 p-6 text-sm text-purple-700">
        No crystal spirits have been catalogued yet. Add JSON files under <code class="rounded bg-white/70 px-2">content/entities/crystal</code>
        to awaken this index.
      </p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {crystals.map((crystal) => (
          <EntityCard
            type={crystal.type}
            slug={crystal.slug}
            name={crystal.name}
            summary={crystal.summary}
            tags={crystal.tags}
            isStub={crystal.isStub}
            variant="grimoire"
          />
        ))}
      </div>
    )}
  </section>
</Base>
