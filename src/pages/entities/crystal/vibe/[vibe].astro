---
import Base from "../../../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";

type Entity = { type: string; slug: string; name?: string; summary?: string; properties?: Record<string, any>; };

export async function getStaticPaths() {
  const VIBE_CANON: Record<string, string> = {
    reset: "Reset", refresh: "Reset", cleanse: "Reset", cleansing: "Reset", clear: "Reset", resetting: "Reset",
    ground: "Grounding", grounding: "Grounding", center: "Grounding", centering: "Grounding", root: "Grounding",
    gaming: "Gaming", game: "Gaming", focus: "Gaming", concentration: "Gaming", study: "Gaming", productivity: "Gaming",
    calm: "Calm", soothe: "Calm", soothing: "Calm", anxiety: "Calm", relax: "Calm", relaxation: "Calm",
    protection: "Protection", protect: "Protection", ward: "Protection",
    clarity: "Clarity", insight: "Clarity", vision: "Clarity",
    energy: "Energy", energize: "Energy", boost: "Energy"
  };
  const titleCase = (s: string) => (s || "").toLowerCase().replace(/\b([a-z])/g, (_m, c) => c.toUpperCase());
  const slugify   = (s: string) => String(s).toLowerCase().trim().replace(/[^a-z0-9\s-]/g, "").replace(/\s+/g, "-");
  const canonVibeFrom = (e: Entity): string => {
    const props = e.properties || {};
    let raw = String(props.vibe || "").toLowerCase().trim();
    if (!raw && Array.isArray(props.keywords)) {
      for (const kw of props.keywords) {
        const k = String(kw || "").toLowerCase().trim();
        if (VIBE_CANON[k]) { raw = k; break; }
      }
    }
    const mapped = VIBE_CANON[raw];
    return mapped ? mapped : (raw ? titleCase(raw) : "");
  };

  const findDir = () => {
    const roots = ["./content/entities/crystal", "./src/content/entities/crystal"];
    for (const r of roots) if (fs.existsSync(r)) return r;
    return "";
  };
  const dir = findDir();
  if (!dir) return [];

  /** load crystals */
  const items: Entity[] = [];
  for (const f of fs.readdirSync(dir).filter((x)=>x.endsWith(".json"))) {
    try {
      const raw = fs.readFileSync(path.join(dir, f), "utf8");
      const data = JSON.parse(raw);
      const slug = (data?.slug ? String(data.slug) : f.replace(/\.json$/, "")).toLowerCase();
      items.push({ type: "crystal", slug, name: data?.name || slug, summary: data?.summary || "", properties: data?.properties || {} });
    } catch {}
  }

  const vibes = new Set<string>();
  items.forEach((e)=> { const v = canonVibeFrom(e); if (v) vibes.add(v); });

  return Array.from(vibes).map((v) => ({
    params: { vibe: slugify(v) },
    props: {
      vibe: v,
      items: items.filter((e)=> canonVibeFrom(e) === v).sort((a,b)=> (a.name||"").localeCompare(b.name||""))
    }
  }));
}

const { vibe, items } = Astro.props as { vibe: string; items: Entity[] };
const pageTitle = `Crystals — ${vibe}`;
const pageDescription = `Crystals associated with the “${vibe}” vibe.`;
---
<Base title={pageTitle} description={pageDescription}>
  <h1 class="mb-2 font-serif text-3xl">Crystals — {vibe}</h1>
  <p class="mb-6 text-slate-700"><a class="hover:underline" href="/entities">← Entities</a> · <a class="hover:underline" href="/entities/crystal">All A–Z</a></p>

  {items.length === 0 ? (
    <p class="text-slate-600">No crystals found for this vibe.</p>
  ) : (
    <ul class="grid gap-4 sm:grid-cols-2">
      {items.map((e)=>(
        <li class="rounded-lg border bg-white p-4 shadow-sm">
          <a href={`/entities/crystal/${e.slug}`} class="text-lg font-semibold hover:underline">{e.name}</a>
          {e.summary && <p class="mt-1 text-sm text-slate-600">{e.summary}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
