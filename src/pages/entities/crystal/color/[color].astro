---
import Base from "../../../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";

type Entity = { type: string; slug: string; name?: string; summary?: string; properties?: Record<string, any>; };

export async function getStaticPaths() {
  const titleCase = (s: string) => (s || "").toLowerCase().replace(/\b([a-z])/g, (_m, c) => c.toUpperCase());
  const slugify   = (s: string) => String(s).toLowerCase().trim().replace(/[^a-z0-9\s-]/g, "").replace(/\s+/g, "-");

  const findDir = () => {
    const roots = ["./content/entities/crystal", "./src/content/entities/crystal"];
    for (const r of roots) if (fs.existsSync(r)) return r;
    return "";
  };
  const dir = findDir();
  if (!dir) return [];

  /** load crystals */
  const items: Entity[] = [];
  for (const f of fs.readdirSync(dir).filter((x)=>x.endsWith(".json"))) {
    try {
      const raw = fs.readFileSync(path.join(dir, f), "utf8");
      const data = JSON.parse(raw);
      const slug = (data?.slug ? String(data.slug) : f.replace(/\.json$/, "")).toLowerCase();
      items.push({ type: "crystal", slug, name: data?.name || slug, summary: data?.summary || "", properties: data?.properties || {} });
    } catch {}
  }

  const colors = new Set<string>();
  items.forEach((e)=> { const raw = (e.properties?.color ? String(e.properties.color) : "").trim(); if (raw) colors.add(titleCase(raw)); });

  return Array.from(colors).map((c) => ({
    params: { color: slugify(c) },
    props: {
      color: c,
      items: items.filter((e)=> {
        const raw = (e.properties?.color ? String(e.properties.color) : "").trim();
        return raw && titleCase(raw) === c;
      }).sort((a,b)=> (a.name||"").localeCompare(b.name||""))
    }
  }));
}

const { color, items } = Astro.props as { color: string; items: Entity[] };
const pageTitle = `Crystals — ${color}`;
const pageDescription = `Crystals in the “${color}” color family.`;
---
<Base title={pageTitle} description={pageDescription}>
  <h1 class="mb-2 font-serif text-3xl">Crystals — {color}</h1>
  <p class="mb-6 text-slate-700"><a class="hover:underline" href="/entities">← Entities</a> · <a class="hover:underline" href="/entities/crystal">All A–Z</a></p>

  {items.length === 0 ? (
    <p class="text-slate-600">No crystals found for this color.</p>
  ) : (
    <ul class="grid gap-4 sm:grid-cols-2">
      {items.map((e)=>(
        <li class="rounded-lg border bg-white p-4 shadow-sm">
          <a href={`/entities/crystal/${e.slug}`} class="text-lg font-semibold hover:underline">{e.name}</a>
          {e.summary && <p class="mt-1 text-sm text-slate-600">{e.summary}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
