---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { sections } from "../../data/typeMetadata";
import { mixColors, resolveTailwindColor, toRgba } from "../../utils/color";

const labelFor = (type: string) =>
  type
    .replace(/([A-Z])/g, " $1")
    .replace(/^./, (char) => char.toUpperCase());

const themedSections = sections.map((section) => {
  const accent = resolveTailwindColor(section.themeColor);
  const glow = toRgba(accent, 0.16);
  const border = toRgba(accent, 0.32);
  const highlight = mixColors("#ffffff", accent, 0.12);
  const surfaceTop = mixColors("#ffffff", accent, 0.08);
  const surfaceBottom = mixColors("#f3edff", accent, 0.22);
  const heading = mixColors(accent, "#140b1e", 0.28);
  const text = mixColors(accent, "#1a102b", 0.18);
  const ribbon = mixColors(accent, "#ffffff", 0.48);
  const cta = mixColors(accent, "#201333", 0.32);
  const ctaHover = mixColors(accent, "#120824", 0.18);
  const iconShadow = toRgba(accent, 0.35);

  return {
    ...section,
    accent,
    glow,
    border,
    highlight,
    surfaceTop,
    surfaceBottom,
    heading,
    text,
    ribbon,
    cta,
    ctaHover,
    iconShadow,
  };
});

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Entities" },
];
---

<Base title="The Grimoire — WitchClick" desktopWide={true}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section
    class="entity-hub wc-section-shell"
    style="--section-border: rgba(124, 58, 237, 0.22); --section-glow: rgba(124, 58, 237, 0.18); --section-highlight: rgba(212, 175, 55, 0.12); --section-veil: rgba(255, 255, 255, 0.3); --section-heading: #3b1b70; --section-text: color-mix(in srgb, #2a1a3f 92%, black 8%);"
  >
    <header class="entity-hub__header">
      <h1 class="entity-hub__title">The Grimoire</h1>
      <p class="entity-hub__intro">
        Choose your path through this digital grimoire — each chapter holds whispered wisdom waiting to unfold.
      </p>
    </header>

    <div class="entity-grid">
      {themedSections.map((section) => (
        <a
          href={section.href}
          class="entity-hub-card group grid gap-6 rounded-2xl border p-6 shadow-sm transition-transform duration-300 ease-out hover:-translate-y-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--glass-pill-border-active)] focus-visible:ring-offset-2"
          style={`--entity-card-border: ${section.border}; --entity-card-glow: ${section.glow}; --entity-card-highlight: ${section.highlight}; --entity-card-surface-top: ${section.surfaceTop}; --entity-card-surface-bottom: ${section.surfaceBottom}; --entity-card-heading: ${section.heading}; --entity-card-text: ${section.text}; --entity-card-label: ${section.ribbon}; --entity-card-cta: ${section.cta}; --entity-card-cta-hover: ${section.ctaHover}; --entity-card-icon: ${section.accent}; --entity-card-icon-shadow: ${section.iconShadow};`}
        >
          <div class="entity-card">
            <div class="entity-card-ribbon" aria-hidden="true">
              <span class="entity-card-icon">{section.icon}</span>
              <span class="entity-card-label">{labelFor(section.type)}</span>
            </div>
            <div class="entity-card-body">
              <h2 class="entity-card-title">{section.title}</h2>
              <p class="entity-card-summary">{section.subtitle}</p>
            </div>
          </div>
          <span class="entity-card-cta">
            Explore
            <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .entity-hub {
    width: min(100%, 76rem);
    margin-inline: auto;
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .entity-hub__header {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
    max-width: 48rem;
  }

  .entity-hub__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 5.5vw, 3.25rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--section-heading, #3b1b70);
  }

  .entity-hub__intro {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--section-text, color-mix(in srgb, #2a1a3f 92%, black 8%));
  }

  .entity-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  @media (min-width: 640px) {
    .entity-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .entity-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .entity-hub-card {
    --entity-card-border: rgba(124, 58, 237, 0.28);
    --entity-card-glow: rgba(124, 58, 237, 0.16);
    --entity-card-highlight: #f7f0ff;
    --entity-card-surface-top: #fefbff;
    --entity-card-surface-bottom: #f9f2ff;
    --entity-card-heading: color-mix(in srgb, #3b1b70 90%, black 10%);
    --entity-card-text: color-mix(in srgb, #3c2a55 90%, black 10%);
    --entity-card-label: color-mix(in srgb, var(--ink-muted, currentColor) 80%, white 20%);
    --entity-card-cta: color-mix(in srgb, var(--wc-ink-label) 68%, var(--ink-body, currentColor) 32%);
    --entity-card-cta-hover: color-mix(in srgb, var(--ink-strong, currentColor) 85%, var(--ambient-color, var(--color-primary)) 15%);
    --entity-card-icon: var(--ambient-color, var(--color-primary));
    --entity-card-icon-shadow: rgba(79, 70, 229, 0.28);
    border-color: color-mix(in srgb, var(--entity-card-border) 85%, transparent 15%);
    background:
      radial-gradient(120% 120% at 18% -15%, color-mix(in srgb, var(--entity-card-glow) 85%, transparent) 0%, transparent 70%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--entity-card-surface-top) 92%, var(--entity-card-highlight) 8%) 0%,
        color-mix(in srgb, var(--entity-card-surface-bottom) 94%, white 6%) 100%
      );
    color: var(--entity-card-text);
    box-shadow: var(--wc-shadow-soft, 0 20px 45px -25px rgba(15, 23, 42, 0.35));
    min-height: 100%;
  }

  .entity-hub-card:hover,
  .entity-hub-card:focus-visible {
    border-color: color-mix(in srgb, var(--section-border, rgba(124, 58, 237, 0.18)) 92%, transparent 8%);
    box-shadow: var(--wc-shadow-strong, 0 25px 60px -30px rgba(15, 23, 42, 0.45));
  }

  .entity-hub-card:focus-visible {
    box-shadow: var(--wc-shadow-strong, 0 25px 60px -30px rgba(15, 23, 42, 0.45)), 0 0 0 3px var(--glass-pill-border-active);
  }

  .entity-card {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .entity-card {
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.25rem);
      align-items: stretch;
    }
  }

  .entity-card-ribbon {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--entity-card-label);
  }

  .entity-card-icon {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--entity-card-icon);
    filter: drop-shadow(0 6px 18px var(--entity-card-icon-shadow));
  }

  .entity-card-label {
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .entity-card-ribbon {
      flex-direction: column;
      justify-content: space-between;
      border-right: 1px solid color-mix(in srgb, var(--ambient-color, var(--color-primary)) 28%, transparent);
      padding-right: 1rem;
      margin-right: clamp(1rem, 2vw, 1.5rem);
    }

    .entity-card-label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      letter-spacing: 0.4em;
    }
  }

  .entity-card-body h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 4vw, 2.15rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--entity-card-heading);
  }

  .entity-card-body p {
    margin-bottom: 0;
    line-height: 1.65;
    font-size: 1rem;
    color: var(--entity-card-text);
  }

  .entity-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--entity-card-cta);
    transition: color 220ms ease;
  }

  .entity-hub-card:hover .entity-card-cta,
  .entity-hub-card:focus-visible .entity-card-cta {
    color: var(--entity-card-cta-hover);
  }
</style>
