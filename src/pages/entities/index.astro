---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntitySearchPanel from "../../components/EntitySearchPanel.astro";
import { buildEntityIndex } from "../../utils/entities.js";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Entities" },
];

function startCase(value: string): string {
  return value
    .split(/[-_\s]+/)
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

const { items, facets } = buildEntityIndex();
const totalItems = items.length;

const params = Astro.url.searchParams;
const query = params.get("q")?.trim() ?? "";
const type = params.get("type")?.trim() ?? "";
const tagParams = params.getAll("tag");
const tag = tagParams.length > 0 ? tagParams[tagParams.length - 1]?.trim() ?? "" : "";

const normalizedQuery = query.toLowerCase();
const normalizedTag = tag.toLowerCase();

const filteredItems = items.filter((item) => {
  if (type && item.type !== type) return false;
  if (normalizedTag) {
    const hasTag = item.tags.some((value) => value.toLowerCase() === normalizedTag);
    if (!hasTag) return false;
  }
  if (!normalizedQuery) return true;
  const haystack = [
    item.name,
    item.summary,
    ...item.tags,
    ...item.keywords,
  ]
    .join(" ")
    .toLowerCase();
  return haystack.includes(normalizedQuery);
});

const resultCount = filteredItems.length;

function formatResultSummary(count: number, total: number) {
  if (count === total) {
    return `Showing all ${total} entities`;
  }
  if (count === 0) {
    return "No entities match your filters";
  }
  return `Showing ${count} of ${total} entities`;
}

const summaryText = formatResultSummary(resultCount, totalItems);

const state = { q: query, type, tag };
---
<Base title="Entities — WitchClick" description="Search the WitchClick grimoire for herbs, crystals, rituals, and more." desktopWide={false}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="entities-shell">
    <header class="entities-header">
      <h1 class="entities-title">Entities</h1>
      <p class="entities-intro">
        Each collection gathers cozy research on the materials, symbols, and tools we lean on. Search or filter to find the right ally.
      </p>
      <a
        href="/journal"
        class="entities-back"
      >
        ← Back to the journal
      </a>
    </header>

    <EntitySearchPanel facets={facets} state={state} />

    <div class="entities-status">
      <p class="entities-count" data-entity-count>{summaryText}</p>
      <span class="sr-only" aria-live="polite" data-entity-count-live>{summaryText}</span>
    </div>

    {resultCount === 0 ? (
      <p class="entities-empty">
        Nothing matches those filters yet. Try adjusting your search or clearing the tag.
      </p>
    ) : (
      <ul class="entities-results" data-entity-results>
        {filteredItems.map((item) => (
          <li class="entities-result" data-entity-result={item.slug}>
            <a href={`/entities/${item.slug}`} class="entities-result__link">
              <span class="entities-result__type">{startCase(item.type)}</span>
              <span class="entities-result__name">{item.name}</span>
            </a>
            {item.summary && <p class="entities-result__summary">{item.summary}</p>}
            {item.tags.length > 0 && (
              <ul class="entities-result__tags">
                {item.tags.slice(0, 6).map((tagValue) => (
                  <li class="entities-result__tag">{tagValue}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  <script type="module" src={Astro.resolve("../../scripts/entities-enhance.ts")}></script>
</Base>

<style>
  .entities-shell {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
    max-width: 72rem;
    margin-inline: auto;
  }

  .entities-header {
    display: grid;
    gap: 0.75rem;
  }

  .entities-title {
    font-family: var(--font-serif, "Cormorant Garamond", serif);
    font-size: clamp(2.5rem, 4vw, 3rem);
    color: var(--text-ink, #111827);
  }

  .entities-intro {
    font-size: 1rem;
    color: var(--text-body, #334155);
    max-width: 60ch;
  }

  .entities-back {
    font-size: 0.875rem;
    color: var(--text-body-muted, #64748b);
    text-decoration: none;
  }

  .entities-back:hover,
  .entities-back:focus-visible {
    color: var(--text-body-strong, #0f172a);
    outline: none;
    text-decoration: underline;
  }

  .entities-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .entities-count {
    font-size: 0.95rem;
    color: var(--text-body-strong, #1f2937);
  }

  .entities-empty {
    border-radius: 1.5rem;
    border: 1px dashed rgba(148, 163, 184, 0.45);
    padding: 1.5rem;
    font-size: 0.95rem;
    color: var(--text-body-muted, #475569);
    background: rgba(255, 255, 255, 0.8);
  }

  .entities-results {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entities-result {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: 1.75rem;
    border: 1px solid rgba(148, 163, 184, 0.35);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 45px -32px rgba(15, 23, 42, 0.18);
  }

  .entities-result__link {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    text-decoration: none;
    align-items: baseline;
  }

  .entities-result__link:focus-visible {
    outline: 2px solid var(--accent, #7c3aed);
    outline-offset: 4px;
    border-radius: 0.75rem;
  }

  .entities-result__type {
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-body-muted, #64748b);
  }

  .entities-result__name {
    font-family: var(--font-serif, "Cormorant Garamond", serif);
    font-size: 1.5rem;
    color: var(--text-ink, #111827);
  }

  .entities-result__summary {
    font-size: 0.95rem;
    color: var(--text-body, #334155);
    line-height: 1.65;
  }

  .entities-result__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entities-result__tag {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.45);
    background: rgba(255, 255, 255, 0.9);
    color: var(--text-body-muted, #475569);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 768px) {
    .entities-result {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
