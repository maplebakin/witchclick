---
import Base from "../../layouts/Base.astro";
import EntityCard from "../../components/EntityCard.astro";
import { readAllEntities } from "../../utils/entities";


const all = readAllEntities();
const typeNames = Object.keys(all).sort();
---
<Base title="Entities — WitchClick">
<h1 class="mb-6">Entities</h1>
{typeNames.length === 0 ? (
<p class="text-neutral-400">No entities yet. They are created automatically when you ingest a post that references them, or via your admin endpoint.</p>
) : (
typeNames.map((type) => (
<section class="mb-10">
<h2 class="text-xl font-semibold mb-3">{type}</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
{all[type].map((e) => (
<EntityCard type={e.type} slug={e.slug} name={e.name} summary={e.summary} />
))}
</div>
</section>
))
)}
</Base>