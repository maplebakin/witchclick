---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntityHubCard from "../../components/EntityHubCard.astro";
import { sections } from "../../data/typeMetadata";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Entities" },
];
---

<Base title="The Grimoire — WitchClick" desktopWide={true}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />

  <section class="max-w-screen-xl mx-auto py-8 md:py-12 px-4">
    <header class="page-header">
      <p class="page-header__eyebrow">Grimoire index</p>
      <h1 class="page-header__title">The Grimoire</h1>
      <p class="page-header__lead">
        A secular symbolic reference library for tarot, herbs, crystals, planets, spreads, and rituals. Use these entries as
        correspondences, reflective anchors, and language for choosing a lens.
      </p>
    </header>

    <div class="entity-grid mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:gap-8">
      {sections.map((section) => (
        <EntityHubCard section={section} />
      ))}
    </div>
  </section>
</Base>

<style>
  @media (min-width: 1024px) {
    .entity-grid > *:last-child:nth-child(3n - 2) {
      grid-column: 1 / -1;
      max-width: 600px;
      width: 100%;
      justify-self: center;
    }
  }
</style>
