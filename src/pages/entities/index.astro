---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { sections } from "../../data/typeMetadata";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Entities" },
];
---
<Base title="Entities — WitchClick" description="Browse gentle reference notes for herbs, tarot cards, crystals, and other allies." desktopWide={false}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="space-y-8">
    <header class="space-y-3">
      <h1 class="font-serif text-3xl text-ink">Entities</h1>
      <p class="text-base text-body">
        Each collection gathers cozy research on the materials, symbols, and tools we use in everyday ritual. Dip in when you need quick context or grounding.
      </p>
      <a
        href="/journal"
        class="inline-flex items-center gap-2 text-sm text-body-muted transition hover:text-body-strong"
      >
        ← Back to the journal
      </a>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      {sections.map((section) => (
        <a
          href={section.href}
          class="group flex flex-col gap-3 rounded-3xl border border-line-muted/40 bg-surface-base/80 p-6 shadow-soft transition hover:border-line-bold hover:text-body"
        >
          <span class="text-2xl text-ember">{section.icon}</span>
          <div class="space-y-1">
            <h2 class="font-serif text-xl text-ink group-hover:text-accent">{section.title}</h2>
            <p class="text-sm text-body-muted">{section.subtitle}</p>
          </div>
          <span class="text-xs uppercase tracking-[0.28em] text-body-subtle">Explore →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
