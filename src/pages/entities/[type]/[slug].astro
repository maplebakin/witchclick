    }

    .entity-graph-description {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  // Entity graph help toggle
  function initGraphHelp() {
    const maybeTrigger = document.querySelector('[data-graph-help-trigger]');
    const maybeLegend = document.querySelector('[data-graph-legend]');

    if (!(maybeTrigger instanceof HTMLElement) || !(maybeLegend instanceof HTMLElement)) return;

    const trigger = maybeTrigger;
    const legend = maybeLegend;

    let isOpen = false;

    trigger.addEventListener('click', () => {
      isOpen = !isOpen;

      if (isOpen) {
        legend.style.display = 'block';
        requestAnimationFrame(() => {
          legend.classList.add('is-visible');
        });
      } else {
        legend.classList.remove('is-visible');
        setTimeout(() => {
          if (!isOpen) {
            legend.style.display = 'none';
          }
        }, 250);
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        isOpen = false;
        legend.classList.remove('is-visible');
        setTimeout(() => {
          if (!isOpen && legend) {
            legend.style.display = 'none';
          }
        }, 250);
        trigger.focus();
      }
    });
  }

  function initEntitySubscribe() {
    const root = document.querySelector('[data-entity-subscribe]');
    if (!(root instanceof HTMLElement)) return;

    const form = root.querySelector('form');
    const input = root.querySelector('input[type="email"]');
    const status = root.querySelector('[data-subscribe-status]');
    const submit = root.querySelector('button[type="submit"]');

    if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement)) return;

    const devApi = root.getAttribute('data-dev-api') || '';
    const type = root.getAttribute('data-entity-type') || '';
    const slug = root.getAttribute('data-entity-slug') || '';
    const name = root.getAttribute('data-entity-name') || 'This entry';

    const setStatus = (message: string, variant: 'success' | 'error' | 'warning' | '' = '') => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.classList.remove('text-success', 'text-danger', 'text-warning');
      if (variant === 'success') status.classList.add('text-success');
      if (variant === 'error') status.classList.add('text-danger');
      if (variant === 'warning') status.classList.add('text-warning');
    };

    if (!devApi || !type || !slug) {
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      setStatus('Notifications open soon. Check back when the cozy mail room is ready.', 'warning');
      return;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = input.value.trim();
      if (!email) {
        setStatus('Please enter an email address to continue.', 'error');
        return;
      }

      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      setStatus('Saving your spot...', '');

      try {
        const response = await fetch(`${devApi}/entities/subscribe`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, slug, email, name, source: 'entity-stub' }),
        });
        const data = await response.json();
        if (!response.ok || data?.ok === false) {
          throw new Error(data?.error || 'Unable to save subscription');
        }

        if (data.status === 'complete') {
          setStatus('This lore is already complete. Refresh to see the latest.', 'warning');
        } else if (data.status === 'existing') {
          setStatus(`You are already on the list for ${name}.`, 'success');
        } else {
          setStatus(`You are all set. We will email when ${name} is complete.`, 'success');
        }

        const callback = (window as Window & {
          wcEntitySubscribeCallback?: (payload: { type: string; slug: string; email: string; status: string }) => void;
        }).wcEntitySubscribeCallback;
        if (typeof callback === 'function') {
          callback({ type, slug, email, status: data.status || 'subscribed' });
        }
        document.dispatchEvent(
          new CustomEvent('entity:subscribe', {
            detail: { type, slug, email, status: data.status || 'subscribed' },
          }),
        );
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Unable to save subscription';
        setStatus(message, 'error');
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  }

  // Init on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initGraphHelp();
      initEntitySubscribe();
    });
  } else {
    initGraphHelp();
    initEntitySubscribe();
  }
</script>
