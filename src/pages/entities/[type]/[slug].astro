      radial-gradient(circle at top right, color-mix(in srgb, var(--entity-accent-highlight, color-mix(in srgb, var(--theme-color-amethyst) 15%, transparent)) 35%, transparent) 0%, transparent 70%),
      var(--card-panel-surface);
    border: 1px dashed color-mix(in srgb, var(--entity-accent-border, color-mix(in srgb, var(--theme-color-amethyst) 25%, transparent)) 85%, transparent 15%);
    text-align: center;
    color: var(--theme-text-body, var(--text-body));
