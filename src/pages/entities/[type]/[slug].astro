  .entity-graph-help:hover {
    border-color: var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%));
    background: color-mix(in srgb, var(--entity-accent-surface, color-mix(in srgb, var(--theme-color-iris, #4b2a63) 10%, transparent 90%)) 100%, transparent 0%);
    transform: scale(1.1);
  }

  .entity-graph-help:focus-visible {
    outline: 2px solid var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%));
    outline-offset: 2px;
  }

  .entity-graph-legend {
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--entity-accent-border, color-mix(in srgb, var(--theme-color-gold, #d4af37) 25%, var(--theme-color-iris, #4b2a63) 20%)) 70%, transparent 30%);
    background: color-mix(in srgb, var(--entity-accent-surface, color-mix(in srgb, var(--theme-color-iris, #4b2a63) 10%, transparent 90%)) 40%, var(--card-panel-surface, rgba(255, 255, 255, 0.9)) 60%);
