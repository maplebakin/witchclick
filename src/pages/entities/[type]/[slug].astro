---
// src/pages/entities/[type]/[slug].astro — static build friendly
import Base from "../../../layouts/Base.astro";
import fs from "node:fs";
import path from "node:path";

export const prerender = true;

/** Build-time loader: discover all entity JSON files and emit params+props */
export async function getStaticPaths() {
  const root = path.join(process.cwd(), 'content', 'entities');
  const paths = [] as Array<{ params: { type: string; slug: string }, props: any }>;
  if (!fs.existsSync(root)) return [];

  const types = fs.readdirSync(root, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => d.name);

  for (const type of types) {
    const dir = path.join(root, type);
    const files = fs.readdirSync(dir).filter(f => f.endsWith('.json'));
    for (const f of files) {
      const slug = f.replace(/\.json$/, '');
      try {
        const j = JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'));
        const ent = {
          type: j.type || type,
          slug: j.slug || slug,
          name: j.name || slug,
          summary: j.summary || '',
          properties: j.properties || {},
          related: Array.isArray(j.related) ? j.related : [],
        };
        paths.push({ params: { type, slug }, props: { ent } });
      } catch {
        // skip malformed file
      }
    }
  }
  return paths;
}

const { ent } = Astro.props as { ent: {
  type: string; slug: string; name: string; summary?: string;
  properties?: Record<string, unknown>; related?: string[];
}};

function pretty(v: unknown) {
  try { return JSON.stringify(v, null, 2); } catch { return String(v); }
}
---
<Base title={`${ent.name} — ${ent.type} — WitchClick`}>
  <p class="text-xs uppercase tracking-wider text-neutral-400">{ent.type}</p>
  <h1 class="mb-3">{ent.name}</h1>
  {ent.summary && <p class="text-neutral-300">{ent.summary}</p>}

  {ent.properties && Object.keys(ent.properties).length > 0 ? (
    <section class="mt-8">
      <h2 class="text-xl font-semibold mb-2">Properties</h2>
      <pre class="bg-neutral-900 rounded-xl p-4 border border-neutral-800 overflow-x-auto"><code>{pretty(ent.properties)}</code></pre>
    </section>
  ) : null}
</Base>
