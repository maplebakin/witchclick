---
// src/pages/entities/[type]/[slug].astro
import Base from '../../../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const ROOT = process.cwd();
  const ENT_ROOT = path.join(ROOT, 'content', 'entities');
  const paths = [];

  if (fs.existsSync(ENT_ROOT)) {
    for (const t of fs.readdirSync(ENT_ROOT)) {
      const dir = path.join(ENT_ROOT, t);

      // inline isDir
      let isDir = false;
      try { isDir = fs.statSync(dir).isDirectory(); } catch {}
      if (!isDir) continue;

      // read *.json files defensively
      let files = [];
      try { files = fs.readdirSync(dir).filter(f => f.endsWith('.json')); } catch {}

      for (const f of files) {
        let data = null;
        try { data = JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8')); } catch {}
        if (!data) continue;

        const slug = String(data.slug || f.replace(/\.json$/, ''));
        const type = String(data.type || t);
        paths.push({
          params: { type, slug },
          props: { data: { ...data, type, slug } }
        });
      }
    }
  }

  return paths;
}

const { data } = Astro.props;
const settings = JSON.parse(fs.readFileSync('./content/settings.json','utf8'));

const title = data?.name || data?.slug || 'Entity';
const description = data?.summary || '';
const canon = `${String(settings.siteUrl||'https://example.com').replace(/\/$/,'')}/entities/${data?.type}/${data?.slug}`;
---
<Base title={title} description={description} canon={canon}>
  <article class="prose prose-neutral max-w-none">
    <h1 class="mb-2">{title}</h1>
    {description && <p class="mt-0 text-sm text-gray-600">{description}</p>}

    <h2>Properties</h2>
    <table>
      <tbody>
        {Object.entries(data?.properties || {}).map(([k, v]) => (
          <tr>
            <th class="text-left pr-4 align-top">{k}</th>
            <td>{Array.isArray(v) ? v.join(', ') : String(v)}</td>
          </tr>
        ))}
      </tbody>
    </table>

    {Array.isArray(data?.related) && data.related.length > 0 && (
      <>
        <h2>Related</h2>
        <ul>
          {data.related.map((r) => <li>{r}</li>)}
        </ul>
      </>
    )}
  </article>
</Base>
