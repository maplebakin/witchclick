---
// src/pages/entities/[type]/[slug].astro — static build friendly
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PostCard from "../../../components/PostCard.astro";
import fs from "node:fs";
import path from "node:path";
import { getTypeMetadata } from "../../../data/typeMetadata";
import { resolveTailwindColor, mixColors, toRgba } from "../../../utils/color";
import { toCssVariables } from "../../../utils/style";
import { getPostsForEntity } from "../../../utils/entityPosts";
import EntityRelationshipGraph from "../../../components/EntityRelationshipGraph.astro";
import {
  resolveEntityRefs,
  findInboundRelations,
  combineRelations,
} from "../../../utils/entityRelations";

export const prerender = true;

/** Build-time loader: discover all entity JSON files and emit params+props */
export async function getStaticPaths() {
  const root = path.join(process.cwd(), 'content', 'entities');
  const paths = [] as Array<{ params: { type: string; slug: string }, props: any }>;
  if (!fs.existsSync(root)) return [];

  const types = fs.readdirSync(root, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => d.name);

  for (const type of types) {
    const dir = path.join(root, type);
    const files = fs.readdirSync(dir).filter(f => f.endsWith('.json'));
    for (const f of files) {
      const slug = f.replace(/\.json$/, '');
      try {
        const j = JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'));
        const ent = {
          type: j.type || type,
          slug: j.slug || slug,
          name: j.name || slug,
          summary: j.summary || '',
          properties: j.properties || {},
          related: Array.isArray(j.related) ? j.related : [],
        };
        paths.push({ params: { type, slug }, props: { ent } });
      } catch {
        // skip malformed file
      }
    }
  }
  return paths;
}

const { ent } = Astro.props as {
  ent: {
    type: string;
    slug: string;
    name: string;
    summary?: string;
    properties?: Record<string, unknown>;
    related?: string[];
  };
};

const metadata = getTypeMetadata(ent.type);
const accentHex = resolveTailwindColor(metadata.themeColor);
const accentSoft = toRgba(accentHex, 0.18);
const accentSurface = toRgba(accentHex, 0.08);
const accentBorder = toRgba(accentHex, 0.25);
const accentHeading = mixColors(accentHex, "#1f2937", 0.42);
const accentSummary = mixColors(accentHex, "#1f2937", 0.55);
const accentLabel = toRgba(accentHex, 0.6);
const accentShadow = toRgba(accentHex, 0.2);

const themeVarString = toCssVariables({
  "entity-accent": accentHex,
  "entity-accent-soft": accentSoft,
  "entity-accent-surface": accentSurface,
  "entity-accent-border": accentBorder,
  "entity-accent-heading": accentHeading,
  "entity-accent-summary": accentSummary,
  "entity-accent-label": accentLabel,
  "entity-accent-shadow": accentShadow,
});

const summaryText = typeof ent.summary === "string" ? ent.summary.trim() : "";
const isStub = summaryText ? /stub/i.test(summaryText) : false;

const typeLabel = ent.type
  .split(/[-_\s]+/)
  .map((part) => (part ? part.charAt(0).toUpperCase() + part.slice(1) : ""))
  .join(" ");

const typeLabelLower = typeLabel.toLowerCase();

function startCase(value: string): string {
  return value
    .split(/[-_\s]+/)
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

function formatRelationType(value: string): string {
  return startCase(value);
}

const entityDisplayName = startCase(
  typeof ent.name === "string" && ent.name.trim() ? ent.name.trim() : ent.slug,
);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Entities", href: "/entities/" },
  { label: typeLabel, href: `/entities/${ent.type}/` },
  { label: entityDisplayName },
];

const outboundHeading = ent.type === "ritual"
  ? "Tools woven into this ritual"
  : "Allies woven into this lore";

const inboundHeading = ent.type === "ritual"
  ? "Companion rituals & lore"
  : "Rituals that call on this ally";

const propertyEntries = ent.properties && typeof ent.properties === "object"
  ? Object.entries(ent.properties)
  : [];

const outboundRelations = resolveEntityRefs(ent.related ?? []);
const inboundRelations = findInboundRelations(ent.type, ent.slug);
const relationNeighbors = combineRelations(outboundRelations, inboundRelations);
const graphNeighbors = relationNeighbors.map((relation) => ({
  type: relation.type,
  slug: relation.slug,
  name: relation.name,
  summary: relation.summary,
  direction: relation.direction,
}));
const centerNode = {
  type: ent.type,
  slug: ent.slug,
  name: entityDisplayName,
  summary: summaryText || metadata.stubLine,
};
const hasRelations = outboundRelations.length > 0 || inboundRelations.length > 0;

let relatedPosts: Array<{
  title: string;
  href: string;
  slug: string;
  excerpt?: string;
  publishedAt?: string;
}> = [];
try {
  // This helper will be wired to real content soon; we fall back quietly for now.
  const maybePosts = await getPostsForEntity?.(ent.type, ent.slug);
  if (Array.isArray(maybePosts)) {
    relatedPosts = maybePosts;
  }
} catch {
  relatedPosts = [];
}

function pretty(v: unknown) {
  try {
    return JSON.stringify(v, null, 2);
  } catch {
    return String(v);
  }
}
---
<Base title={`${ent.name} — ${typeLabel} — WitchClick`} wide ambientColor={accentHex}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <article class="entity-page" style={themeVarString ? `${themeVarString};` : undefined}>
    <a href={`/entities/${ent.type}/`} class="entity-back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      Back to All {typeLabel}s
    </a>
    <header class="entity-hero">
      <div class="entity-hero-sheen" aria-hidden="true" />
      <div class="entity-hero-inner">
        <span class="entity-hero-icon" aria-hidden="true">{metadata.icon}</span>
        <div class="entity-hero-heading">
          <p class="entity-hero-type" data-label={typeLabel}>{typeLabel}</p>
          <h1 class="entity-hero-title">{entityDisplayName}</h1>
        </div>
        {summaryText && !isStub && (
          <p class="entity-hero-summary">{summaryText}</p>
        )}
      </div>
    </header>

    {isStub ? (
      <section class="card-panel card-tier-2 card-panel-soft entity-stub-card" aria-live="polite">
        <h2 class="entity-stub-heading">Lore in Progress</h2>
        <p class="entity-stub-copy">{metadata.stubLine}</p>
        {/* Future: add subscription/notification CTA when lore completes. */}
      </section>
    ) : (
      <section class="entity-detail">
        {summaryText && (
          <div class="entity-detail-summary">
            <h2 class="entity-section-title">Overview</h2>
            <p>{summaryText}</p>
          </div>
        )}

        {propertyEntries.length > 0 && (
          <div class="entity-properties">
            <h2 class="entity-section-title">Properties</h2>
            <dl>
              {propertyEntries.map(([key, value]) => (
                <div class="entity-property">
                  <dt>{key}</dt>
                  <dd>{typeof value === "string" || typeof value === "number" ? String(value) : <pre><code>{pretty(value)}</code></pre>}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {hasRelations && (
          <div class="entity-relations">
            {outboundRelations.length > 0 && (
              <section class="entity-relations-section">
                <h2 class="entity-section-title">{outboundHeading}</h2>
                <ul class="entity-relations-list">
                  {outboundRelations.map((relation) => (
                    <li>
                      <a
                        class="entity-relations-link"
                        href={`/entities/${relation.type}/${relation.slug}`}
                      >
                        <span class="entity-relations-name">{relation.name}</span>
                        <span class="entity-relations-type">{formatRelationType(relation.type)}</span>
                      </a>
                      {relation.summary && (
                        <p class="entity-relations-summary">{relation.summary}</p>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {inboundRelations.length > 0 && (
              <section class="entity-relations-section">
                <h2 class="entity-section-title">{inboundHeading}</h2>
                <ul class="entity-relations-list">
                  {inboundRelations.map((relation) => (
                    <li>
                      <a
                        class="entity-relations-link inbound"
                        href={`/entities/${relation.type}/${relation.slug}`}
                      >
                        <span class="entity-relations-name">{relation.name}</span>
                        <span class="entity-relations-type">{formatRelationType(relation.type)}</span>
                      </a>
                      {relation.summary && (
                        <p class="entity-relations-summary">{relation.summary}</p>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        )}
      </section>
    )}

    {graphNeighbors.length > 0 && (
      <section class="entity-graph-section" aria-labelledby="relationship-graph-heading">
        <div class="entity-graph-header">
          <div class="entity-graph-heading-group">
            <h2 id="relationship-graph-heading" class="entity-graph-title">Connection Web</h2>
            <p class="entity-graph-description">
              Visual map of how this {typeLabel.toLowerCase()} connects to other allies and rituals in our collection.
              <button
                type="button"
                class="entity-graph-help"
                aria-label="Learn how to read this graph"
                data-graph-help-trigger
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </button>
            </p>
          </div>
          <div class="entity-graph-legend" data-graph-legend style="display: none;">
            <p class="entity-graph-legend-title">How to read this graph:</p>
            <ul class="entity-graph-legend-list">
              <li>
                <span class="entity-graph-legend-dot entity-graph-legend-dot--outbound"></span>
                <strong>Outbound:</strong> This {typeLabel.toLowerCase()} references these allies
              </li>
              <li>
                <span class="entity-graph-legend-dot entity-graph-legend-dot--inbound"></span>
                <strong>Inbound:</strong> These allies or rituals reference this {typeLabel.toLowerCase()}
              </li>
              <li>
                <span class="entity-graph-legend-dot entity-graph-legend-dot--center"></span>
                <strong>Center:</strong> You are here
              </li>
            </ul>
          </div>
        </div>
        <EntityRelationshipGraph center={centerNode} neighbors={graphNeighbors} />
      </section>
    )}

    <section class="card-panel card-tier-1 card-panel-soft entity-related">
      <div class="entity-related-header">
        <h2 class="entity-section-title">Related Posts</h2>
        <p class="entity-related-sub">Rituals and guides that already reference this ally.</p>
      </div>
      {relatedPosts.length > 0 ? (
        <ul class="entity-related-list">
          {relatedPosts.map((post) => (
            <li class="entity-related-item">
              <PostCard
                href={post.href}
                post={{
                  slug: post.slug,
                  title: post.title,
                  excerpt: post.excerpt,
                  tldr: post.excerpt,
                  publishedAt: post.publishedAt,
                }}
              />
            </li>
          ))}
        </ul>
      ) : (
        <div class="entity-related-placeholder">
          <p>
            No posts have woven {entityDisplayName} into our rituals yet. Visit the
            {" "}
            <a href="/hub">Lore Hub</a>
            {" "}
            to share a story or request a {typeLabelLower} update.
          </p>
        </div>
      )}
    </section>
  </article>
</Base>

<style>
  .entity-page {
    display: grid;
    gap: 3rem;
    margin-top: 2rem;
    margin-bottom: 4rem;
    color: var(--ink-body, #111827);
  }

  .entity-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--entity-accent, #7c4eb0);
    background: color-mix(in srgb, var(--entity-accent-surface, rgba(124, 78, 176, 0.08)) 80%, transparent 20%);
    border: 1px solid var(--entity-accent-border, rgba(124, 78, 176, 0.25));
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
    width: fit-content;
    min-height: 44px; /* Ensure minimum touch target */
  }

  .entity-back-link:hover {
    color: var(--entity-accent-heading, #4c1d95);
    background: color-mix(in srgb, var(--entity-accent-surface, rgba(124, 78, 176, 0.08)) 100%, white 0%);
    border-color: var(--entity-accent, #7c4eb0);
    transform: translateX(-2px);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--entity-accent-shadow, rgba(124, 78, 176, 0.2)) 60%, transparent 40%);
  }

  .entity-back-link:focus-visible {
    outline: 2px solid var(--entity-accent, #7c4eb0);
    outline-offset: 3px;
  }

  .entity-back-link:active {
    transform: translateX(-1px);
  }

  .entity-back-link svg {
    flex-shrink: 0;
  }

  .entity-hero {
    position: relative;
    border-radius: 2rem;
    padding: clamp(2rem, 6vw, 4rem);
    overflow: hidden;
    background: linear-gradient(135deg, var(--entity-accent-surface, rgba(124, 58, 237, 0.08)), rgba(255, 255, 255, 0.92));
    box-shadow: 0 28px 60px -35px var(--entity-accent-shadow, rgba(124, 58, 237, 0.2));
  }

  .entity-hero::before {
    content: "";
    position: absolute;
    inset: -30% -35% auto;
    height: 60%;
    border-radius: 50%;
    background: radial-gradient(circle at top, var(--entity-accent, rgba(124, 58, 237, 0.45)), transparent 70%);
    opacity: 0.25;
  }

  .entity-hero-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.3), transparent 60%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .entity-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
  }

  .entity-hero-icon {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .entity-hero-heading {
    display: grid;
    gap: 0.75rem;
  }

  .entity-hero-type {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--entity-accent-label, rgba(124, 58, 237, 0.6));
  }

  .entity-hero-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.1;
    font-family: var(--font-serif, "Literata", serif);
    color: var(--entity-accent-heading, #4c1d95);
  }

  .entity-hero-summary {
    max-width: 60ch;
    font-size: 1.1rem;
    color: var(--entity-accent-summary, #4338ca);
  }

  .entity-detail {
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: 1.75rem;
    border: 1px solid var(--entity-accent-border, rgba(124, 58, 237, 0.25));
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.85));
    box-shadow: 0 18px 45px -28px var(--entity-accent-shadow, rgba(124, 58, 237, 0.18));
  }

  .entity-detail-summary p {
    margin-top: 0.75rem;
    color: var(--ink-body, #111827);
    line-height: 1.7;
  }

  .entity-section-title {
    font-size: 1.35rem;
    font-weight: 600;
    font-family: var(--font-serif, "Literata", serif);
    color: var(--entity-accent-heading, #4c1d95);
  }

  .entity-properties dl {
    margin-top: 1rem;
    display: grid;
    gap: 1.5rem;
  }

  .entity-property dt {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--entity-accent-label, rgba(124, 58, 237, 0.6));
    margin-bottom: 0.35rem;
  }

  .entity-property dd {
    margin: 0;
    font-size: 1rem;
    color: var(--ink-strong, #1f2937);
  }

  .entity-property pre {
    margin: 0;
    padding: 1rem;
    background: rgba(15, 23, 42, 0.85);
    color: rgba(226, 232, 240, 0.95);
    border-radius: 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }

  .entity-stub-card {
    --card-hover-translate: 0;
    --card-elevation-base: var(--elevation-tier-1);
    --card-elevation-hover: var(--elevation-tier-1);
    padding: clamp(2rem, 5vw, 3rem);
    border-style: dashed;
    border-color: color-mix(in srgb, var(--entity-accent-border, rgba(124, 58, 237, 0.28)) 85%, var(--card-panel-border, currentColor) 15%);
    background:
      radial-gradient(circle at top, color-mix(in srgb, var(--entity-accent-highlight, rgba(124, 58, 237, 0.12)) 65%, transparent) 0%, transparent 65%),
      var(--card-panel-surface);
    text-align: center;
    display: grid;
    gap: 1rem;
  }

  .entity-stub-heading {
    font-size: 1.8rem;
    font-family: var(--font-serif, "Literata", serif);
    color: var(--entity-accent-heading, #4c1d95);
  }

  .entity-stub-copy {
    font-size: 1rem;
    color: var(--ink-body, #111827);
  }

  .entity-related {
    --card-hover-translate: 0;
    --card-elevation-base: var(--elevation-tier-1);
    --card-elevation-hover: var(--elevation-tier-1);
    display: grid;
    gap: 1.5rem;
    padding: clamp(2rem, 5vw, 3rem);
    border: 1px solid color-mix(in srgb, var(--entity-accent-border, rgba(124, 58, 237, 0.22)) 45%, transparent 55%);
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--entity-accent-highlight, rgba(124, 58, 237, 0.18)) 55%, transparent) 0%, transparent 70%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.95), var(--entity-accent-surface, rgba(124, 58, 237, 0.08)));
  }

  .entity-related-sub {
    margin-top: 0.25rem;
    font-size: 0.95rem;
    color: var(--ink-muted, #4b5563);
  }

  .entity-related-list {
    display: grid;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entity-related-item {
    display: block;
  }

  .entity-related-placeholder {
    padding: 1.75rem;
    border-radius: var(--card-radius, 1.5rem);
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--entity-accent-highlight, rgba(124, 58, 237, 0.15)) 35%, transparent) 0%, transparent 70%),
      var(--card-panel-surface);
    border: 1px dashed color-mix(in srgb, var(--entity-accent-border, rgba(124, 58, 237, 0.25)) 85%, transparent 15%);
    text-align: center;
    color: var(--ink-muted, #4b5563);
  }

  /* Entity Graph Section */
  .entity-graph-section {
    display: grid;
    gap: 2rem;
  }

  .entity-graph-header {
    display: grid;
    gap: 1rem;
  }

  .entity-graph-heading-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .entity-graph-title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-strong, #1a102c);
  }

  .entity-graph-description {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--ink-muted, #4b5563);
    margin: 0;
  }

  .entity-graph-help {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--entity-accent, #7c4eb0) 30%, transparent 70%);
    background: color-mix(in srgb, var(--entity-accent-surface, rgba(124, 78, 176, 0.08)) 60%, transparent 40%);
    color: var(--entity-accent, #7c4eb0);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .entity-graph-help:hover {
    border-color: var(--entity-accent, #7c4eb0);
    background: color-mix(in srgb, var(--entity-accent-surface, rgba(124, 78, 176, 0.08)) 100%, transparent 0%);
    transform: scale(1.1);
  }

  .entity-graph-help:focus-visible {
    outline: 2px solid var(--entity-accent, #7c4eb0);
    outline-offset: 2px;
  }

  .entity-graph-legend {
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--entity-accent-border, rgba(124, 78, 176, 0.25)) 70%, transparent 30%);
    background: color-mix(in srgb, var(--entity-accent-surface, rgba(124, 78, 176, 0.08)) 40%, var(--card-panel-surface, rgba(255, 255, 255, 0.9)) 60%);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .entity-graph-legend.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .entity-graph-legend-title {
    margin: 0 0 0.75rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-strong, #1a102c);
  }

  .entity-graph-legend-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.625rem;
    font-size: 0.875rem;
  }

  .entity-graph-legend-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .entity-graph-legend-dot {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .entity-graph-legend-dot--outbound {
    background: color-mix(in srgb, var(--entity-accent, #7c4eb0) 70%, transparent 30%);
    border: 2px solid var(--entity-accent, #7c4eb0);
  }

  .entity-graph-legend-dot--inbound {
    background: color-mix(in srgb, var(--color-gold, #d4af37) 70%, transparent 30%);
    border: 2px solid var(--color-gold, #d4af37);
  }

  .entity-graph-legend-dot--center {
    background: var(--ink-strong, #1a102c);
    border: 2px solid var(--ink-strong, #1a102c);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--entity-accent, #7c4eb0) 30%, transparent 70%);
  }

  @media (max-width: 768px) {
    .entity-page {
      gap: 2.5rem;
      margin-top: 1rem;
    }

    .entity-hero,
    .entity-detail,
    .entity-stub-card,
    .entity-related {
      border-radius: 1.5rem;
    }

    .entity-hero-title {
      font-size: clamp(2.25rem, 8vw, 3rem);
    }

    .entity-detail,
    .entity-stub-card,
    .entity-related {
      padding: clamp(1.5rem, 6vw, 2.5rem);
    }

    .entity-graph-description {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  // Entity graph help toggle
  function initGraphHelp() {
    const maybeTrigger = document.querySelector('[data-graph-help-trigger]');
    const maybeLegend = document.querySelector('[data-graph-legend]');

    if (!(maybeTrigger instanceof HTMLElement) || !(maybeLegend instanceof HTMLElement)) return;

    const trigger = maybeTrigger;
    const legend = maybeLegend;

    let isOpen = false;

    trigger.addEventListener('click', () => {
      isOpen = !isOpen;

      if (isOpen) {
        legend.style.display = 'block';
        requestAnimationFrame(() => {
          legend.classList.add('is-visible');
        });
      } else {
        legend.classList.remove('is-visible');
        setTimeout(() => {
          if (!isOpen) {
            legend.style.display = 'none';
          }
        }, 250);
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        isOpen = false;
        legend.classList.remove('is-visible');
        setTimeout(() => {
          if (!isOpen && legend) {
            legend.style.display = 'none';
          }
        }, 250);
        trigger.focus();
      }
    });
  }

  // Init on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGraphHelp);
  } else {
    initGraphHelp();
  }
</script>
