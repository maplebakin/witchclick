    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%)) 30%, transparent 70%);
    background: color-mix(in srgb, var(--entity-accent-surface, color-mix(in srgb, var(--theme-color-iris, #4b2a63) 10%, transparent 90%)) 60%, transparent 40%);
    color: var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%));
    cursor: pointer;
    transition: all 0.2s ease;
