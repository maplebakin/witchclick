---
// src/pages/entities/[type]/[slug].astro — static build friendly
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PostCard from "../../../components/PostCard.astro";
import fs from "node:fs";
import path from "node:path";
import { getTypeMetadata } from "../../../data/typeMetadata";
import { resolveTailwindColor, mixColors, toRgba } from "../../../utils/color";
import { toCssVariables } from "../../../utils/style";
import { getPostsForEntity } from "../../../utils/entityPosts";
import EntityRelationshipGraph from "../../../components/EntityRelationshipGraph.astro";
import {
  resolveEntityRefs,
  findInboundRelations,
  combineRelations,
} from "../../../utils/entityRelations";

export const prerender = true;

/** Build-time loader: discover all entity JSON files and emit params+props */
export async function getStaticPaths() {
  const root = path.join(process.cwd(), 'content', 'entities');
  const paths = [] as Array<{ params: { type: string; slug: string }, props: any }>;
  if (!fs.existsSync(root)) return [];

  const types = fs.readdirSync(root, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => d.name);

  for (const type of types) {
    const dir = path.join(root, type);
    const files = fs.readdirSync(dir).filter(f => f.endsWith('.json'));
    for (const f of files) {
      const slug = f.replace(/\.json$/, '');
      try {
        const j = JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'));
        const ent = {
          type: j.type || type,
          slug: j.slug || slug,
          name: j.name || slug,
          summary: j.summary || '',
          properties: j.properties || {},
          related: Array.isArray(j.related) ? j.related : [],
        };
        paths.push({ params: { type, slug }, props: { ent } });
      } catch {
        // skip malformed file
      }
    }
  }
  return paths;
}

const { ent } = Astro.props as {
  ent: {
    type: string;
    slug: string;
    name: string;
    summary?: string;
    properties?: Record<string, unknown>;
    related?: string[];
  };
};

const metadata = getTypeMetadata(ent.type);
const accentHex = resolveTailwindColor(metadata.themeColor);
const accentSoft = toRgba(accentHex, 0.18);
const accentSurface = toRgba(accentHex, 0.08);
const accentBorder = toRgba(accentHex, 0.25);
const accentHeading = mixColors(accentHex, "#1f2937", 0.42);
const accentSummary = mixColors(accentHex, "#1f2937", 0.55);
const accentLabel = toRgba(accentHex, 0.6);
const accentShadow = toRgba(accentHex, 0.2);

const themeVarString = toCssVariables({
  "entity-accent": accentHex,
  "entity-accent-soft": accentSoft,
  "entity-accent-surface": accentSurface,
  "entity-accent-border": accentBorder,
  "entity-accent-heading": accentHeading,
  "entity-accent-summary": accentSummary,
  "entity-accent-label": accentLabel,
  "entity-accent-shadow": accentShadow,
});

const summaryText = typeof ent.summary === "string" ? ent.summary.trim() : "";
const isStub = summaryText ? /stub/i.test(summaryText) : false;

const DEV_API = import.meta.env.PUBLIC_DEV_API || "";
const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const requestKey = Astro.url?.searchParams?.get("key") || "";
const canEditStub = isDev || (!!ADMIN_KEY && requestKey === ADMIN_KEY);
const stubAdminHref = requestKey ? `/admin/stubs?key=${encodeURIComponent(requestKey)}` : "/admin/stubs";

const typeLabel = ent.type
  .split(/[-_\s]+/)
  .map((part) => (part ? part.charAt(0).toUpperCase() + part.slice(1) : ""))
  .join(" ");

const typeLabelLower = typeLabel.toLowerCase();

function startCase(value: string): string {
  return value
    .split(/[-_\s]+/)
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

function formatRelationType(value: string): string {
  return startCase(value);
}

const entityDisplayName = startCase(
  typeof ent.name === "string" && ent.name.trim() ? ent.name.trim() : ent.slug,
);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Entities", href: "/entities" },
  { label: typeLabel, href: `/entities/${ent.type}` },
  { label: entityDisplayName },
];

const outboundHeading = ent.type === "ritual"
  ? "Tools woven into this ritual"
  : "Allies woven into this lore";

const inboundHeading = ent.type === "ritual"
  ? "Companion rituals & lore"
  : "Rituals that call on this ally";

const propertyEntries = ent.properties && typeof ent.properties === "object"
  ? Object.entries(ent.properties)
  : [];

const outboundRelations = resolveEntityRefs(ent.related ?? []);
const inboundRelations = findInboundRelations(ent.type, ent.slug);
const relationNeighbors = combineRelations(outboundRelations, inboundRelations);
const graphNeighbors = relationNeighbors.map((relation) => ({
  type: relation.type,
  slug: relation.slug,
  name: relation.name,
  summary: relation.summary,
  direction: relation.direction,
}));
const centerNode = {
  type: ent.type,
  slug: ent.slug,
  name: entityDisplayName,
  summary: summaryText || metadata.stubLine,
};
const hasRelations = outboundRelations.length > 0 || inboundRelations.length > 0;

let relatedPosts: Array<{
  title: string;
  href: string;
  slug: string;
  excerpt?: string;
  publishedAt?: string;
  category?: import('../../../utils/entityPosts').RelatedPost['category'];
}> = [];
try {
  // This helper will be wired to real content soon; we fall back quietly for now.
  const maybePosts = await getPostsForEntity?.(ent.type, ent.slug);
  if (Array.isArray(maybePosts)) {
    relatedPosts = maybePosts;
  }
} catch {
  relatedPosts = [];
}

function pretty(v: unknown) {
  try {
    return JSON.stringify(v, null, 2);
  } catch {
    return String(v);
  }
}
---
<Base title={`${ent.name} — ${typeLabel} — WitchClick`} wide ambientColor={accentHex} noindex={isStub}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <article class="entity-page" style={themeVarString ? `${themeVarString};` : undefined}>
    <a href={`/entities/${ent.type}`} class="entity-back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      Back to All {typeLabel}s
    </a>
    {isStub && (
      <div class="rounded-lg border border-dashed border-line-neutral bg-surface-soft px-4 py-3 text-sm text-body-muted mb-6">
        This entry is a placeholder. Full lore is being inscribed - check back soon.
      </div>
    )}
    <header class="entity-hero">
      <div class="entity-hero-sheen" aria-hidden="true" />
      <div class="entity-hero-inner">
        <span class="entity-hero-icon" aria-hidden="true">{metadata.icon}</span>
        <div class="entity-hero-heading">
          <p class="entity-hero-type" data-label={typeLabel}>{typeLabel}</p>
          <h1 class="entity-hero-title">{entityDisplayName}</h1>
        </div>
        {summaryText && !isStub && (
          <p class="entity-hero-summary">{summaryText}</p>
        )}
      </div>
    </header>

    {isStub ? (
      <section class="card-panel card-tier-2 card-panel-soft entity-stub-card" aria-live="polite">
        <h2 class="entity-stub-heading">Lore in Progress</h2>
        <p class="entity-stub-copy">{metadata.stubLine}</p>
        <div
          class="entity-stub-subscribe"
          data-entity-subscribe
          data-dev-api={DEV_API}
          data-entity-type={ent.type}
          data-entity-slug={ent.slug}
          data-entity-name={entityDisplayName}
        >
          <p class="entity-stub-subscribe-title">Want a gentle heads-up when this lore is ready?</p>
          <form class="entity-stub-subscribe-form">
            <label class="entity-stub-subscribe-label">
              Email address
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="entity-stub-subscribe-input"
              />
            </label>
            <button type="submit" class="wc-button wc-button--sm entity-stub-subscribe-button">
              Notify me
            </button>
          </form>
          <p class="entity-stub-subscribe-help">We’ll only email when this entry is completed. No spam, no fluff.</p>
          <p class="entity-stub-subscribe-status" data-subscribe-status aria-live="polite"></p>
        </div>
        {canEditStub && (
          <div class="entity-stub-actions">
            <p class="entity-stub-note">
              Content keepers: open the stub dashboard to finish this entry.
            </p>
            <a class="wc-button wc-button--sm" href={stubAdminHref}>
              Open Stub Dashboard
            </a>
          </div>
        )}
      </section>
    ) : (
      <section class="entity-detail">
        {summaryText && (
          <div class="entity-detail-summary">
            <h2 class="entity-section-title">Overview</h2>
            <p>{summaryText}</p>
          </div>
        )}

        {propertyEntries.length > 0 && (
          <div class="entity-properties">
            <h2 class="entity-section-title">Properties</h2>
            <dl>
              {propertyEntries.map(([key, value]) => (
                <div class="entity-property">
                  <dt>{key}</dt>
                  <dd>{typeof value === "string" || typeof value === "number" ? String(value) : <pre><code>{pretty(value)}</code></pre>}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {hasRelations && (
          <div class="entity-relations">
            {outboundRelations.length > 0 && (
              <section class="entity-relations-section">
                <h2 class="entity-section-title">{outboundHeading}</h2>
                <ul class="entity-relations-list">
                  {outboundRelations.map((relation) => (
                    <li>
                      <a
                        class="entity-relations-link"
                        href={`/entities/${relation.type}/${relation.slug}`}
                      >
                        <span class="entity-relations-name">{relation.name}</span>
                        <span class="entity-relations-type">{formatRelationType(relation.type)}</span>
                      </a>
                      {relation.summary && (
                        <p class="entity-relations-summary">{relation.summary}</p>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {inboundRelations.length > 0 && (
              <section class="entity-relations-section">
                <h2 class="entity-section-title">{inboundHeading}</h2>
                <ul class="entity-relations-list">
                  {inboundRelations.map((relation) => (
                    <li>
                      <a
                        class="entity-relations-link inbound"
                        href={`/entities/${relation.type}/${relation.slug}`}
                      >
                        <span class="entity-relations-name">{relation.name}</span>
                        <span class="entity-relations-type">{formatRelationType(relation.type)}</span>
                      </a>
                      {relation.summary && (
                        <p class="entity-relations-summary">{relation.summary}</p>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        )}
      </section>
    )}

    {graphNeighbors.length > 0 && (
      <section class="entity-graph-section" aria-labelledby="relationship-graph-heading">
        <div class="entity-graph-header">
          <div class="entity-graph-heading-group">
            <h2 id="relationship-graph-heading" class="entity-graph-title">Connection Web</h2>
            <p class="entity-graph-description">
              Visual map of how this {typeLabel.toLowerCase()} connects to other allies and rituals in our collection.
              <button
                type="button"
                class="entity-graph-help"
                aria-label="Learn how to read this graph"
                data-graph-help-trigger
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </button>
            </p>
          </div>
          <div class="entity-graph-legend" data-graph-legend style="display: none;">
            <p class="entity-graph-legend-title">How to read this graph:</p>
            <ul class="entity-graph-legend-list">
              <li>
                <span class="entity-graph-legend-dot entity-graph-legend-dot--outbound"></span>
                <strong>Outbound:</strong> This {typeLabel.toLowerCase()} references these allies
              </li>
              <li>
                <span class="entity-graph-legend-dot entity-graph-legend-dot--inbound"></span>
                <strong>Inbound:</strong> These allies or rituals reference this {typeLabel.toLowerCase()}
              </li>
              <li>
                <span class="entity-graph-legend-dot entity-graph-legend-dot--center"></span>
                <strong>Center:</strong> You are here
              </li>
            </ul>
          </div>
        </div>
        <EntityRelationshipGraph center={centerNode} neighbors={graphNeighbors} />
      </section>
    )}

    <section class="card-panel card-tier-1 card-panel-soft entity-related">
      <div class="entity-related-header">
        <h2 class="entity-section-title">Related Posts</h2>
        <p class="entity-related-sub">Rituals and guides that already reference this ally.</p>
      </div>
      {relatedPosts.length > 0 ? (
        <ul class="entity-related-list">
          {relatedPosts.map((post) => (
            <li class="entity-related-item">
              <PostCard
                href={post.href}
                post={{
                  slug: post.slug,
                  title: post.title,
                  excerpt: post.excerpt,
                  tldr: post.excerpt,
                  publishedAt: post.publishedAt,
                  category: post.category,
                }}
              />
            </li>
          ))}
        </ul>
      ) : (
        <div class="entity-related-placeholder">
          <p>
            No posts have woven {entityDisplayName} into our rituals yet. Visit the
            {" "}
            <a href="/hub">Lore Hub</a>
            {" "}
            to share a story or request a {typeLabelLower} update.
          </p>
        </div>
      )}
    </section>
  </article>
</Base>

<style>
  .entity-page {
    display: grid;
    gap: 3rem;
    margin-top: 2rem;
    margin-bottom: 4rem;
    color: var(--theme-text-body, var(--text-body));
  }

  .entity-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%));
    background: color-mix(in srgb, var(--entity-accent-surface, color-mix(in srgb, var(--theme-color-iris, #4b2a63) 10%, transparent 90%)) 80%, transparent 20%);
    border: 1px solid var(--entity-accent-border, color-mix(in srgb, var(--theme-color-gold, #d4af37) 25%, var(--theme-color-iris, #4b2a63) 20%));
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
    width: fit-content;
    min-height: 44px; /* Ensure minimum touch target */
  }

  .entity-back-link:hover {
    color: var(--entity-accent-heading, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%));
    background: color-mix(in srgb, var(--entity-accent-surface, color-mix(in srgb, var(--theme-color-iris, #4b2a63) 10%, transparent 90%)) 100%, white 0%);
    border-color: var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%));
    transform: translateX(-2px);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--entity-accent-shadow, color-mix(in srgb, var(--theme-color-iris, #4b2a63) 20%, transparent 80%)) 60%, transparent 40%);
  }

  .entity-back-link:focus-visible {
    outline: 2px solid var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%));
    outline-offset: 3px;
  }

  .entity-back-link:active {
    transform: translateX(-1px);
  }

  .entity-back-link svg {
    flex-shrink: 0;
  }

  .entity-hero {
    position: relative;
    border-radius: 2rem;
    padding: clamp(2rem, 6vw, 4rem);
    overflow: hidden;
    background: linear-gradient(135deg, var(--entity-accent-surface, color-mix(in srgb, var(--theme-color-iris, #4b2a63) 10%, transparent 90%)), var(--theme-surface-base));
    box-shadow: 0 28px 60px -35px var(--entity-accent-shadow, color-mix(in srgb, var(--theme-color-iris, #4b2a63) 20%, transparent 80%));
  }

  .entity-hero::before {
    content: "";
    position: absolute;
    inset: -30% -35% auto;
    height: 60%;
    border-radius: 50%;
    background: radial-gradient(circle at top, var(--entity-accent, color-mix(in srgb, var(--theme-color-amethyst) 45%, transparent)), transparent 70%);
    opacity: 0.25;
  }

  .entity-hero-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, color-mix(in srgb, var(--theme-text-primary) 30%, transparent), transparent 60%);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .entity-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
  }

  .entity-hero-icon {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .entity-hero-heading {
    display: grid;
    gap: 0.75rem;
  }

  .entity-hero-type {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--entity-accent-label, color-mix(in srgb, var(--theme-color-amethyst) 60%, transparent));
  }

  .entity-hero-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.1;
    font-family: var(--font-serif, "Literata", serif);
    color: var(--theme-text-strong, var(--text-strong));
  }

  .entity-hero-summary {
    max-width: 60ch;
    font-size: 1.1rem;
    color: var(--theme-text-body, var(--text-body));
  }

  .entity-detail {
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: 1.75rem;
    border: 1px solid var(--entity-accent-border, color-mix(in srgb, var(--theme-color-amethyst) 25%, transparent));
    background: linear-gradient(180deg, var(--theme-surface-base), var(--theme-surface-panel));
    box-shadow: 0 18px 45px -28px var(--entity-accent-shadow, color-mix(in srgb, var(--theme-color-amethyst) 18%, transparent));
  }

  .entity-detail-summary p {
    margin-top: 0.75rem;
    color: var(--theme-text-body, var(--text-body));
    line-height: 1.7;
  }

  .entity-section-title {
    font-size: 1.35rem;
    font-weight: 600;
    font-family: var(--font-serif, "Literata", serif);
    color: var(--theme-text-strong, var(--text-strong));
  }

  .entity-properties dl {
    margin-top: 1rem;
    display: grid;
    gap: 1.5rem;
  }

  .entity-property dt {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--entity-accent-label, color-mix(in srgb, var(--theme-color-amethyst) 60%, transparent));
    margin-bottom: 0.35rem;
  }

  .entity-property dd {
    margin: 0;
    font-size: 1rem;
    color: var(--theme-text-body, var(--text-body));
  }

  .entity-property pre {
    margin: 0;
    padding: 1rem;
    background: color-mix(in srgb, var(--theme-color-night) 85%, transparent);
    color: color-mix(in srgb, var(--theme-text-primary) 95%, transparent);
    border-radius: 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }

  .entity-stub-card {
    --card-hover-translate: 0;
    --card-elevation-base: var(--elevation-tier-1);
    --card-elevation-hover: var(--elevation-tier-1);
    padding: clamp(2rem, 5vw, 3rem);
    border-style: dashed;
    border-color: color-mix(in srgb, var(--entity-accent-border, color-mix(in srgb, var(--theme-color-amethyst) 28%, transparent)) 85%, var(--card-panel-border, currentColor) 15%);
    background:
      radial-gradient(circle at top, color-mix(in srgb, var(--entity-accent-highlight, color-mix(in srgb, var(--theme-color-amethyst) 12%, transparent)) 65%, transparent) 0%, transparent 65%),
      var(--card-panel-surface);
    text-align: center;
    display: grid;
    gap: 1rem;
  }

  .entity-stub-heading {
    font-size: 1.8rem;
    font-family: var(--font-serif, "Literata", serif);
    color: var(--theme-text-strong, var(--text-strong));
  }

  .entity-stub-copy {
    font-size: 1rem;
    color: var(--theme-text-body, var(--text-body));
  }

  .entity-stub-subscribe {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--wc-radius-lg, 1.25rem);
    border: 1px solid color-mix(in srgb, var(--entity-accent-border, rgba(76, 29, 149, 0.2)) 65%, transparent 35%);
    background: color-mix(in srgb, var(--card-panel-surface, #fffaf4) 82%, var(--entity-accent-surface, rgba(76, 29, 149, 0.08)) 18%);
  }

  .entity-stub-subscribe-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .entity-stub-subscribe-form {
    display: grid;
    gap: 0.65rem;
  }

  .entity-stub-subscribe-label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .entity-stub-subscribe-input {
    width: 100%;
    border-radius: var(--wc-radius-md, 0.9rem);
    border: 1px solid color-mix(in srgb, var(--entity-accent-border, rgba(76, 29, 149, 0.25)) 70%, transparent 30%);
    background: var(--cozy-input-bg, #fffaf5);
    padding: 0.65rem 0.85rem;
    font-size: 0.95rem;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .entity-stub-subscribe-input:focus-visible {
    outline: var(--focus-ring-width, 3px) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset, 3px);
    box-shadow: var(--focus-ring-shadow);
  }

  .entity-stub-subscribe-button {
    width: 100%;
  }

  .entity-stub-subscribe-help {
    margin: 0;
    font-size: 0.85rem;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .entity-stub-subscribe-status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .entity-stub-actions {
    display: grid;
    gap: 0.75rem;
    align-items: center;
    justify-items: center;
    margin-top: 0.5rem;
  }

  .entity-stub-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .entity-related {
