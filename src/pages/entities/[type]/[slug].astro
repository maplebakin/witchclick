  .entity-graph-legend-dot--outbound {
    background: color-mix(in srgb, var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%)) 70%, transparent 30%);
    border: 2px solid var(--entity-accent, color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, #4b2a63) 55%));
  }

  .entity-graph-legend-dot--inbound {
    background: color-mix(in srgb, var(--theme-color-gold, #d4af37) 70%, transparent 30%);
    border: 2px solid var(--theme-color-gold, #d4af37);
  }

  .entity-graph-legend-dot--center {
    background: var(--ink-strong, #1a102c);
    border: 2px solid var(--ink-strong, #1a102c);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--entity-accent, var(--text-accent, var(--theme-color-gold, #d4af37))) 30%, transparent 70%);
  }

  @media (max-width: 768px) {
