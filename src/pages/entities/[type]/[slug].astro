---
import { readAllEntities, flattenEntitySlug } from "../../../utils/entities.js";

export const prerender = true;

export async function getStaticPaths() {
  const all = readAllEntities();
  const paths: Array<{ params: { type: string; slug: string }; props: { flatSlug: string } }> = [];

  for (const [type, entries] of Object.entries(all)) {
    if (!Array.isArray(entries)) continue;
    for (const entity of entries) {
      const flatSlug = flattenEntitySlug(entity);
      if (!flatSlug) continue;
      paths.push({ params: { type, slug: entity.slug }, props: { flatSlug } });
    }
  }

  return paths;
}

const { flatSlug } = Astro.props as { flatSlug: string };

export default () => {
  return Astro.redirect(`/entities/${flatSlug}`, 301);
};
