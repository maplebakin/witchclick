      gap: 2.5rem;
      margin-top: 1rem;
    }

    .entity-hero,
    .entity-detail,
    .entity-stub-card,
    .entity-related {
      border-radius: 1.5rem;
    }

    .entity-hero-title {
      font-size: clamp(2.25rem, 8vw, 3rem);
    }

    .entity-detail,
    .entity-stub-card,
    .entity-related {
