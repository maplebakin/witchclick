---
// src/pages/entities/[type]/[slug].astro
import Base from '../../../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

function safeReadJSON(p:string, fallback:any=null){
  try { return JSON.parse(fs.readFileSync(p,'utf8')); } catch { return fallback; }
}

export async function getStaticPaths() {
  const ROOT = process.cwd();
  const ENT_ROOT = path.join(ROOT, 'content', 'entities');

  const paths: Array<{ params: { type: string; slug: string }, props: { data: any } }> = [];

  if (fs.existsSync(ENT_ROOT)) {
    const types = fs.readdirSync(ENT_ROOT).filter((d) => {
      const p = path.join(ENT_ROOT, d);
      try { return fs.statSync(p).isDirectory(); } catch { return false; }
    });

    for (const t of types) {
      const dir = path.join(ENT_ROOT, t);
      let files: string[] = [];
      try { files = fs.readdirSync(dir).filter((f) => f.endsWith('.json')); } catch {}
      for (const f of files) {
        const full = path.join(dir, f);
        const data = safeReadJSON(full, null);
        if (!data) continue;
        const slug = String(data.slug || f.replace(/\.json$/,''));
        paths.push({ params: { type: t, slug }, props: { data: { ...data, type: data.type || t, slug } } });
      }
    }
  }

  // optional: console.log('[entities:getStaticPaths] built', paths.length, 'paths');
  return paths;
}

const { data } = Astro.props;

const ROOT = process.cwd();
const settings = safeReadJSON(path.join(ROOT, 'content', 'settings.json'), { siteUrl: 'https://example.com' });

const title = data?.name || data?.slug || 'Entity';
const description = data?.summary || '';
const canon = `${String(settings.siteUrl||'https://example.com').replace(/\/$/,'')}/entities/${data?.type}/${data?.slug}`;
---
<Base title={title} description={description} canon={canon}>
  <article class="prose-witch max-w-none">
    <h1 class="mb-2">{title}</h1>
    {description && <p class="mt-0 text-sm text-gray-600">{description}</p>}

    <h2>Properties</h2>
    <table>
      <tbody>
        {Object.entries(data?.properties || {}).map(([k, v]) => (
          <tr>
            <th class="text-left pr-4 align-top">{k}</th>
            <td>{Array.isArray(v) ? v.join(', ') : String(v)}</td>
          </tr>
        ))}
      </tbody>
    </table>

    {Array.isArray(data?.related) && data.related.length > 0 && (
      <>
        <h2>Related</h2>
        <ul>
          {data.related.map((r) => <li>{r}</li>)}
        </ul>
      </>
    )}

    {!data && <p class="text-sm text-red-700">Entity not found.</p>}
  </article>
</Base>
