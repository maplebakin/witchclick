---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import JournalListItem from "@/components/JournalListItem.astro";
import Pagination from "@/components/Pagination.astro";
import LoadMoreButton from "@/components/LoadMoreButton";
import { getPaginatedPosts, toJournalListEntry, JOURNAL_PAGE_SIZE } from "@/utils/posts";

const title = "Journal — WitchClick";
const description = "Browse the newest WitchClick rituals, essays, and practical spellwork.";

const { totalPages, items } = getPaginatedPosts(1, JOURNAL_PAGE_SIZE);
const entries = items.map(toJournalListEntry);
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Journal" },
];
---
<Base {title} {description}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="space-y-8">
    <header class="space-y-3">
      <h1 class="font-serif text-3xl text-ink">Journal</h1>
      <p class="text-base text-body">
        Practical ritual notes, cozy planning frameworks, and secular spellcraft for tired brains.
      </p>
    </header>

    <div id="journal-list" class="journal-list space-y-6">
      {entries.map((entry) => (
        <JournalListItem
          slug={entry.slug}
          title={entry.title}
          excerpt={entry.summary}
          publishedAt={entry.date}
          tags={entry.tags}
        />
      ))}
    </div>

    {totalPages > 1 && (
      <>
        <LoadMoreButton
          currentPage={1}
          totalPages={totalPages}
          pageSize={JOURNAL_PAGE_SIZE}
          basePath="/journal/page"
          initialCount={entries.length}
        />
        <div data-journal-pagination>
          <Pagination page={1} {totalPages} />
        </div>
      </>
    )}

    {totalPages === 1 && <Pagination page={1} {totalPages} />}
  </section>
</Base>
