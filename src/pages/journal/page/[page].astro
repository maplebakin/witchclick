---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import JournalListItem from "@/components/JournalListItem.astro";
import Pagination from "@/components/Pagination.astro";
import { loadAllPosts, paginatePosts, firstParagraph } from "@/utils/posts";
import type { LoadedPost } from "@/utils/posts";
export const prerender = true;

export async function getStaticPaths() {
  const posts = loadAllPosts();
  const pageSize = 10;
  const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNumber = index + 2;
    return {
      params: { page: String(pageNumber) },
      props: { page: pageNumber, totalPages, pageSize },
    };
  });
}

const { page = 2, totalPages = 1, pageSize = 10 } = Astro.props as {
  page: number;
  totalPages: number;
  pageSize?: number;
};
const { items } = paginatePosts(page, pageSize);
const posts = items.map(mapToListEntry);

const title = `Journal — Page ${page}`;
const description = `Archive page ${page} of WitchClick journal entries.`;
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Journal", href: "/journal" },
  { label: `Page ${page}` },
];

function mapToListEntry(post: LoadedPost) {
  const data = post.data ?? {};
  const postTitle = typeof data.title === "string" && data.title.trim().length ? data.title.trim() : post.title;
  const excerptCandidate = [
    data.excerpt,
    data.description,
    data.metaDescription,
    firstParagraph(post.content),
  ].find((value) => typeof value === "string" && value.trim().length > 0);
  const tagsRaw = Array.isArray(data.tags)
    ? data.tags
    : typeof data.tags === "string"
      ? data.tags.split(",")
      : [];
  const tags = Array.from(
    new Set(
      tagsRaw
        .map((tag) => (typeof tag === "string" ? tag.trim() : ""))
        .filter((tag) => tag.length > 0),
    ),
  );
  const publishedAtCandidate = [data.publishedAt, data.pubDate, data.date].find(
    (value) => typeof value === "string" && value.trim().length > 0,
  );
  const publishedAt = publishedAtCandidate
    ? String(publishedAtCandidate)
    : post.date instanceof Date
      ? post.date.toISOString()
      : undefined;

  return {
    slug: post.slug,
    title: postTitle,
    excerpt: typeof excerptCandidate === "string" ? excerptCandidate.trim() : "",
    tags,
    publishedAt,
  };
}
---
<Base {title} {description}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="space-y-8">
    <header class="space-y-3">
      <h1 class="font-serif text-3xl text-ink">Journal</h1>
      <p class="text-base text-body">Archive page {page} of the WitchClick journal.</p>
    </header>

    <div class="space-y-6">
      {posts.map((post) => (
        <JournalListItem {...post} />
      ))}
    </div>

    <Pagination {page} {totalPages} baseHref="/journal/page" />
  </section>
</Base>
