---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import JournalListItem from "@/components/JournalListItem.astro";
import Pagination from "@/components/Pagination.astro";
import { loadAllPosts, getPaginatedPosts, toJournalListEntry, JOURNAL_PAGE_SIZE } from "@/utils/posts";

export const prerender = true;

export async function getStaticPaths() {
  const posts = loadAllPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / JOURNAL_PAGE_SIZE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNumber = index + 2;
    return {
      params: { page: String(pageNumber) },
      props: { page: pageNumber, totalPages, pageSize: JOURNAL_PAGE_SIZE },
    };
  });
}

const { page = 2, totalPages = 1, pageSize = JOURNAL_PAGE_SIZE } = Astro.props as {
  page: number;
  totalPages: number;
  pageSize?: number;
};
const { items } = getPaginatedPosts(page, pageSize);
const entries = items.map(toJournalListEntry);

const title = `Journal — Page ${page}`;
const description = `Archive page ${page} of WitchClick journal entries.`;
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Journal", href: "/journal" },
  { label: `Page ${page}` },
];

const isPartial = Astro.url.searchParams.get("partial") === "1";

if (isPartial) {
  return (
    <div id="journal-list" class="journal-list space-y-6">
      {entries.map((entry) => (
        <JournalListItem
          slug={entry.slug}
          title={entry.title}
          excerpt={entry.summary}
          publishedAt={entry.date}
          tags={entry.tags}
        />
      ))}
    </div>
  );
}
---
<Base {title} {description}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="space-y-8">
    <header class="space-y-3">
      <h1 class="font-serif text-3xl text-ink">Journal</h1>
      <p class="text-base text-body">Archive page {page} of the WitchClick journal.</p>
    </header>

    <div class="journal-list space-y-6">
      {entries.map((entry) => (
        <JournalListItem
          slug={entry.slug}
          title={entry.title}
          excerpt={entry.summary}
          publishedAt={entry.date}
          tags={entry.tags}
        />
      ))}
    </div>

    <Pagination {page} {totalPages} baseHref="/journal/page" />
  </section>
</Base>
