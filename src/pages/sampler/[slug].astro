--- 
import RitualSampler from '../../components/RitualSampler.astro';
import { loadAllPosts } from '../../utils/posts';
import { extractReflectionPrompts } from '../../utils/reflectionPrompts';

export async function getStaticPaths() {
    const posts = loadAllPosts();
    return posts.flatMap((post) => {
        const postData = post.data ?? {};
        const reflectionPrompts = extractReflectionPrompts(postData, post.content || '');
        if (reflectionPrompts.length === 0) return [];

        return [{
            params: { slug: post.slug },
            props: {
                title: postData.title || post.title,
                description: postData.description || postData.excerpt || '',
                reflectionPrompts: reflectionPrompts,
            },
        }];
    });
}

const { title, description, reflectionPrompts } = Astro.props;
---

<RitualSampler title={title} description={description} reflectionPrompts={reflectionPrompts} />
