---
import fs from "node:fs";
import path from "node:path";

import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

const title = "Spreads — WitchClick";
const description = "Download cozy tarot spreads and planning templates without any marketing fluff.";
const downloadsDirectory = path.join(process.cwd(), "content", "downloads");
const publicDownloadsDirectory = path.join(process.cwd(), "public", "downloads");

const ensureDirectory = (dir: string) => {
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }
};

const slugify = (value: string): string =>
  value
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-zA-Z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .toLowerCase();

const toSlug = (value: string | null | undefined): string => {
  const trimmed = typeof value === "string" ? value.trim() : "";
  return trimmed ? slugify(trimmed) : "";
};

const isFile = (filePath: string): boolean => {
  try {
    return fs.statSync(filePath).isFile();
  } catch {
    return false;
  }
};

ensureDirectory(publicDownloadsDirectory);

const assetLookup = new Map<string, string>();

const copyAssetToPublic = (sourcePath: string, ...keys: Array<string | null | undefined>): string => {
  if (!isFile(sourcePath)) return "";

  const ext = path.extname(sourcePath) || "";
  const base = path.basename(sourcePath, ext);
  const primarySlug = toSlug(base) || toSlug(keys[0]) || "download";
  const normalizedExt = ext.toLowerCase();
  const fileName = `${primarySlug}${normalizedExt}`;
  const targetPath = path.join(publicDownloadsDirectory, fileName);

  try {
    const shouldCopy = !fs.existsSync(targetPath) || fs.statSync(sourcePath).mtimeMs > fs.statSync(targetPath).mtimeMs;
    if (shouldCopy) {
      fs.copyFileSync(sourcePath, targetPath);
    }

    const lookupKeys = [primarySlug, ...keys.map(toSlug)].filter(Boolean);
    for (const key of lookupKeys) {
      assetLookup.set(key, fileName);
    }

    return `/downloads/${fileName}`;
  } catch (error) {
    console.warn(`Unable to prepare download asset ${sourcePath}:`, error);
    return "";
  }
};

const downloadFiles = fs.existsSync(downloadsDirectory)
  ? fs
      .readdirSync(downloadsDirectory)
      .filter((file) => file.endsWith(".json"))
      .map((file) => {
        try {
          const raw = fs.readFileSync(path.join(downloadsDirectory, file), "utf8");
          return JSON.parse(raw) as {
            slug?: string;
            name?: string;
            summary?: string;
            price?: string | number;
            currency?: string;
            file?: string;
            url?: string;
          };
        } catch (error) {
          console.warn(`Unable to parse download file ${file}:`, error);
          return null;
        }
      })
      .filter(Boolean)
  : [];

if (fs.existsSync(downloadsDirectory)) {
  fs.readdirSync(downloadsDirectory)
    .filter((file) => !file.endsWith(".json"))
    .forEach((file) => {
      const sourcePath = path.join(downloadsDirectory, file);
      copyAssetToPublic(sourcePath, path.basename(file, path.extname(file)));
    });
}

const parsedDownloads = downloadFiles as Array<{
  slug?: string;
  name?: string;
  summary?: string;
  price?: string | number;
  currency?: string;
  file?: string;
  url?: string;
}>;

const downloads = parsedDownloads
  .map((entry) => {
    const slug = entry?.slug ?? entry?.name ?? "download";
    const priceRaw = entry?.price;
    const priceNumber = typeof priceRaw === "number" ? priceRaw : typeof priceRaw === "string" ? Number(priceRaw) : NaN;
    const isFree = Number.isFinite(priceNumber) ? priceNumber === 0 : true;
    const fileTarget = typeof entry?.file === "string" ? entry.file.trim() : "";
    const urlTarget = typeof entry?.url === "string" ? entry.url.trim() : "";

    let href = "";

    if (urlTarget) {
      href = urlTarget;
    } else if (fileTarget) {
      const candidates = new Set<string>();

      if (path.isAbsolute(fileTarget)) {
        candidates.add(fileTarget);
      }

      const relativeFromDownloads = path.join(downloadsDirectory, fileTarget);
      candidates.add(relativeFromDownloads);

      if (fileTarget.startsWith("/")) {
        const trimmed = fileTarget.replace(/^\/+/, "");
        candidates.add(path.join(process.cwd(), trimmed));
      }

      const existingPath = Array.from(candidates).find(isFile);
      if (existingPath) {
        href = copyAssetToPublic(existingPath, slug, entry?.name ?? null);
      }
    }

    if (!href) {
      const lookupKey = toSlug(slug) || toSlug(entry?.name);
      const knownAsset = lookupKey ? assetLookup.get(lookupKey) : undefined;
      if (knownAsset) {
        href = `/downloads/${knownAsset}`;
      }
    }

    return {
      slug,
      name: entry?.name ?? "Download",
      summary: entry?.summary ?? "",
      href,
      isFree,
      price: Number.isFinite(priceNumber) ? priceNumber : null,
      currency: entry?.currency ?? "USD",
    };
  })
  .filter((item) => item.href.length > 0);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Spreads" },
];
---
<Base {title} {description}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <section class="space-y-8">
    <header class="space-y-3">
      <h1 class="font-serif text-3xl text-ink">Spreads & Printables</h1>
      <p class="text-base text-body">
        Quick tarot spreads and ritual planners you can open in your browser or download for later. No funnels, just cozy tools.
      </p>
    </header>

    {downloads.length === 0 ? (
      <p class="rounded-3xl border border-line-muted/40 bg-surface-base/70 p-6 text-sm text-body-muted">
        No downloads are available yet. Check back soon for fresh spreads.
      </p>
    ) : (
      <div class="space-y-6">
        {downloads.map((item) => (
          <article class="space-y-4 rounded-3xl border border-line-muted/50 bg-surface-base/80 p-6 shadow-soft" id={item.slug}>
            <header class="space-y-2">
              <h2 class="font-serif text-2xl text-ink">{item.name}</h2>
              {item.summary && <p class="text-base text-body">{item.summary}</p>}
            </header>
            <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-body-muted">
              <span class="rounded-full border border-line-muted/60 px-3 py-1 uppercase tracking-wide">
                {item.isFree ? "Free download" : `Paid resource${item.price ? ` — ${item.currency} ${item.price}` : ""}`}
              </span>
              <a
                href={item.href}
                class="inline-flex items-center gap-2 rounded-full border border-line-muted/60 px-4 py-2 font-medium text-body transition hover:border-line-bold hover:text-body-strong"
              >
                Open spread →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
