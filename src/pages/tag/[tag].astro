---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { loadAllPosts, estimateReadingMinutes, firstParagraph, extractHeroImage } from "../../utils/posts";
import { readSettings } from "../../utils/settings";
import { createCollectionPageSchema } from "../../utils/structuredData";
import { Fragment } from "astro/jsx-runtime";

export const prerender = true;

export function getStaticPaths() {
  const posts = loadAllPosts();
  const tags = new Set<string>();
  posts.forEach((post) => {
    const fm = post.data ?? {};
    const postTags = Array.isArray(fm.tags) ? fm.tags : [];
    postTags.forEach((tag) => tags.add(String(tag).toLowerCase()));
  });

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props as { tag: string };
const normalizedTag = tag.toLowerCase();
const settings = readSettings();
const allPosts = loadAllPosts();

const taggedPosts = allPosts
  .filter((post) => {
    const fm = post.data ?? {};
    const postTags = Array.isArray(fm.tags) ? fm.tags.map((t: any) => String(t).toLowerCase()) : [];
    return postTags.includes(normalizedTag);
  })
  .sort((a, b) => {
    const dateA = new Date(a.data?.publishedAt ?? a.data?.pubDate ?? a.data?.date ?? 0).getTime();
    const dateB = new Date(b.data?.publishedAt ?? b.data?.pubDate ?? b.data?.date ?? 0).getTime();
    return dateB - dateA;
  });

const cards = taggedPosts.map((post) => {
  const fm = post.data ?? {};
  const excerpt = fm.excerpt ?? fm.description ?? fm.metaDescription ?? firstParagraph(post.content);
  const hero = extractHeroImage(fm);
  const heroSrc = typeof hero.src === "string" && hero.src.trim() ? hero.src.trim() : undefined;
  const heroAlt = typeof hero.alt === "string" && hero.alt.trim() ? hero.alt.trim() : undefined;
  return {
    slug: post.slug,
    title: fm.title ?? post.title,
    excerpt,
    tags: Array.isArray(fm.tags) ? fm.tags : [],
    readingMinutes: fm.readingMinutes ?? estimateReadingMinutes(post.content),
    publishedAt: fm.publishedAt ?? fm.pubDate ?? fm.date ?? undefined,
    spoonLevel: typeof fm.spoonLevel === "string" ? fm.spoonLevel : undefined,
    spoons:
      typeof fm.spoons === "string"
        ? fm.spoons
        : typeof post.spoons === "string"
          ? post.spoons
          : undefined,
    tldr:
      typeof post.tldr === "string"
        ? post.tldr
        : typeof fm.tldr === "string"
          ? fm.tldr
          : undefined,
    heroImage: heroSrc,
    heroImageSrc: heroSrc,
    heroImageAlt: heroAlt,
    heroAlt: heroAlt,
  };
});

const collectionSchema = createCollectionPageSchema(
  settings,
  {
    name: `Tag: ${tag}`,
    url: `/tag/${normalizedTag}`,
    description: `Posts filed under the ${tag} tag`,
    itemType: "Article",
  },
  cards.map((card) => ({
    name: card.title,
    url: `/post/${card.slug}`,
    description: card.tldr ?? card.excerpt,
  })),
);
---
<Base title={`Tag: ${tag} — WitchClick`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <h1 class="mb-6">Tag: {tag}</h1>
  {cards.length === 0 ? (
    <p class="text-cloud-muted">
      No posts found for this tag yet. <a class="underline" href="/">Back to home</a>.
    </p>
  ) : (
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {cards.map((card) => (
        <PostCard
          post={{
            slug: card.slug,
            title: card.title,
            excerpt: card.excerpt,
            tldr: card.tldr,
            tags: card.tags,
            readingMinutes: card.readingMinutes,
            publishedAt: card.publishedAt,
            spoonLevel: card.spoonLevel,
            spoons: card.spoons,
            heroImage: card.heroImage,
            heroImageSrc: card.heroImageSrc,
            heroImageAlt: card.heroImageAlt,
            heroAlt: card.heroAlt,
          }}
          href={`/post/${card.slug}`}
        />
      ))}
    </div>
  )}
</Base>
