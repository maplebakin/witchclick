---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { loadAllPosts } from "../../utils/posts";
import { postsToCardData } from "../../utils/postTransforms";
import { readSettings } from "../../utils/settings";
import { createCollectionPageSchema } from "../../utils/structuredData";
import HeadSlot from "@/components/HeadSlot.astro";

export const prerender = true;

export function getStaticPaths() {
  const posts = loadAllPosts();
  const tags = new Set<string>();
  posts.forEach((post) => {
    const fm = post.data ?? {};
    const postTags = Array.isArray(fm.tags) ? fm.tags : [];
    postTags.forEach((tag) => tags.add(String(tag).toLowerCase()));
  });

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props as { tag: string };
const normalizedTag = tag.toLowerCase();
const settings = readSettings();
const allPosts = loadAllPosts();

const taggedPosts = allPosts
  .filter((post) => {
    const fm = post.data ?? {};
    const postTags = Array.isArray(fm.tags) ? fm.tags.map((t: any) => String(t).toLowerCase()) : [];
    return postTags.includes(normalizedTag);
  })
  .sort((a, b) => {
    const dateA = new Date(a.data?.publishedAt ?? a.data?.pubDate ?? a.data?.date ?? 0).getTime();
    const dateB = new Date(b.data?.publishedAt ?? b.data?.pubDate ?? b.data?.date ?? 0).getTime();
    return dateB - dateA;
  });

// Transform to card data
const cards = postsToCardData(taggedPosts);

const collectionSchema = createCollectionPageSchema(
  settings,
  {
    name: `Tag: ${tag}`,
    url: `/tag/${normalizedTag}`,
    description: `Posts filed under the ${tag} tag`,
    itemType: "Article",
  },
  cards.map((card) => ({
    name: card.title,
    url: `/post/${card.slug}`,
    description: card.tldr ?? card.excerpt,
  })),
);
---
<Base title={`Tag: ${tag} — WitchClick`}>
  <HeadSlot slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />
  </HeadSlot>

  <h1 class="mb-6">Tag: {tag}</h1>
  {cards.length === 0 ? (
    <p class="text-cloud-muted">
      No posts found for this tag yet. <a class="underline" href="/">Back to home</a>.
    </p>
  ) : (
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {cards.map((card) => (
        <PostCard
          href={`/post/${card.slug}`}
          post={{
            slug: card.slug,
            title: card.title,
            excerpt: card.excerpt,
            tldr: card.tldr,
            tags: card.tags,
            readingMinutes: card.readingMinutes,
            publishedAt: card.publishedAt,
            spoonLevel: card.spoonLevel,
            spoons: card.spoons,
            heroImage: card.heroImage,
            heroImageSrc: card.heroImageSrc,
            heroImageAlt: card.heroImageAlt,
            heroAlt: card.heroAlt,
            category: card.category,
          }}
        />
      ))}
    </div>
  )}
</Base>
