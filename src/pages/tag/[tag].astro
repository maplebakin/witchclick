---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { loadAllPosts } from "../../utils/posts";
import { postsToCardData } from "../../utils/postTransforms";
import { readSettings } from "../../utils/settings";
import { createCollectionPageSchema } from "../../utils/structuredData";
import HeadSlot from "@/components/HeadSlot.astro";
import { serializeJsonForScript } from "@/utils/serializeJson";
import { buildTagRouteEntries, canonicalTagHref, canonicalizeTagSlug, tagsFromFrontmatter } from "@/utils/tags";

export const prerender = true;

export function getStaticPaths() {
  const posts = loadAllPosts();
  return buildTagRouteEntries(posts).map((entry) => ({
    params: { tag: entry.routeTag },
    props: entry,
  }));
}

const { routeTag, canonicalTag, label, redirectTo } = Astro.props as {
  routeTag: string;
  canonicalTag: string;
  label: string;
  redirectTo: string | null;
};
const normalizedTag = canonicalizeTagSlug(canonicalTag || routeTag);
const settings = readSettings();
const allPosts = loadAllPosts();

const taggedPosts = allPosts
  .filter((post) => {
    const postTags = tagsFromFrontmatter(post.data ?? {});
    return postTags.some((tagValue) => canonicalizeTagSlug(tagValue) === normalizedTag);
  })
  .sort((a, b) => {
    const dateA = new Date(a.data?.publishedAt ?? a.data?.pubDate ?? a.data?.date ?? 0).getTime();
    const dateB = new Date(b.data?.publishedAt ?? b.data?.pubDate ?? b.data?.date ?? 0).getTime();
    return dateB - dateA;
  });

// Transform to card data
const cards = postsToCardData(taggedPosts);

const collectionSchema = createCollectionPageSchema(
  settings,
  {
    name: `Topic: ${label}`,
    url: canonicalTagHref(normalizedTag),
    description: `Posts filed under the ${label} topic`,
    itemType: "Article",
  },
  cards.map((card) => ({
    name: card.title,
    url: `/post/${card.slug}`,
    description: card.tldr ?? card.excerpt,
  })),
);
---
{redirectTo ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Redirecting topic — WitchClick</title>
      <meta name="robots" content="noindex,nofollow" />
      <link rel="canonical" href={redirectTo} />
      <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
      <script
        is:inline
        set:html={`window.location.replace(${serializeJsonForScript(redirectTo)});`}
      />
    </head>
    <body>
      <p>
        Redirecting to the canonical topic page:
        {" "}
        <a href={redirectTo}>{redirectTo}</a>
      </p>
    </body>
  </html>
) : (
  <Base
    title={`Topic: ${label} — WitchClick`}
    description={`Explore WitchClick articles filed under ${label}.`}
    canon={canonicalTagHref(normalizedTag)}
    noindex={cards.length < 2}
  >
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={serializeJsonForScript(collectionSchema)} />
    </HeadSlot>

    <h1 class="mb-6">Topic: {label}</h1>
    {cards.length === 0 ? (
      <p class="text-cloud-muted">
        No posts found for this topic yet. <a class="underline" href="/">Back to home</a>.
      </p>
    ) : (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {cards.map((card) => (
          <PostCard
            href={`/post/${card.slug}`}
            post={{
              slug: card.slug,
              title: card.title,
              excerpt: card.excerpt,
              tldr: card.tldr,
              tags: card.tags,
              readingMinutes: card.readingMinutes,
              publishedAt: card.publishedAt,
              spoonLevel: card.spoonLevel,
              spoons: card.spoons,
              heroImage: card.heroImage,
              heroImageSrc: card.heroImageSrc,
              heroImageAlt: card.heroImageAlt,
              heroAlt: card.heroAlt,
              category: card.category,
            }}
          />
        ))}
      </div>
    )}
  </Base>
)}
