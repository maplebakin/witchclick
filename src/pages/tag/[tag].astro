---
import fs from "node:fs";
import path from "node:path";
import matter from "gray-matter";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";

export const prerender = true;

export async function getStaticPaths() {
  const dir = path.join(process.cwd(), "content", "posts");
  const files = fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => f.endsWith(".md")) : [];

  const posts = files.map((file) => {
    const full = path.join(dir, file);
    const raw = fs.readFileSync(full, "utf8");
    const { data } = matter(raw);
    const slug = (data?.slug ? String(data.slug) : file.replace(/\.md$/, "")).toLowerCase();
    const tags = Array.isArray(data?.tags) ? data.tags.map((t: any) => String(t).toLowerCase()) : [];
    const dateFront = [data?.publishedAt, data?.pubDate, data?.date, data?.updatedAt].filter(Boolean);
    let date = new Date(dateFront[0] || 0);
    if (Number.isNaN(+date)) date = fs.statSync(full).mtime;
    return { slug, data: { ...data, tags }, date };
  });

  const tagSet = new Set<string>();
  posts.forEach((p) => p.data.tags?.forEach((t: string) => tagSet.add(t)));
  const tags = Array.from(tagSet).sort();

  return tags.map((t) => ({ params: { tag: t }, props: { tag: t } }));
}

const { tag } = Astro.props as { tag: string };

const dir = path.join(process.cwd(), "content", "posts");
const files = fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => f.endsWith(".md")) : [];
const pagePosts = files
  .map((file) => {
    const full = path.join(dir, file);
    const raw = fs.readFileSync(full, "utf8");
    const { data } = matter(raw);
    const slug = (data?.slug ? String(data.slug) : file.replace(/\.md$/, "")).toLowerCase();
    const tags = Array.isArray(data?.tags) ? data.tags.map((t: any) => String(t).toLowerCase()) : [];
    const dateFront = [data?.publishedAt, data?.pubDate, data?.date, data?.updatedAt].filter(Boolean);
    let date = new Date(dateFront[0] || 0);
    if (Number.isNaN(+date)) date = fs.statSync(full).mtime;
    return { slug, data: { ...data, tags }, date };
  })
  .filter((p) => p.data.tags.includes(tag.toLowerCase()))
  .sort((a, b) => +b.date - +a.date);
---
<Base title={`Tag: ${tag} — WitchClick`}>
  <section class="glass-panel">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <p class="eyebrow text-purple-400/90">Tag collection</p>
        <h1 class="mt-2 text-3xl font-semibold text-purple-900">#{tag}</h1>
      </div>
      <a class="text-sm font-medium text-purple-700 underline-offset-4 transition hover:text-purple-900 hover:underline" href="/">
        Back home
      </a>
    </div>
    {pagePosts.length === 0 ? (
      <div class="mt-8 rounded-2xl border border-purple-200/70 bg-white/70 p-6 text-sm text-purple-700/80">
        No posts found for this tag yet. Check back soon or browse the archive.
      </div>
    ) : (
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {pagePosts.map((p) => (
          <PostCard post={{ ...p.data, slug: p.slug }} href={`/post/${p.slug}`} />
        ))}
      </div>
    )}
  </section>
</Base>
