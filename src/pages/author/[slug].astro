---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import AuthorSpotlight from "@/components/AuthorSpotlight.astro";
import { loadAuthors, getAuthorBySlug } from "@/utils/authors";
import { getPostsByAuthor } from "@/utils/posts";
import { postsToCardData } from "@/utils/postTransforms";
import { createCollectionPageSchema } from "@/utils/structuredData";
import { readSettings } from "@/utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import { serializeJsonForScript } from "@/utils/serializeJson";

export const prerender = true;

export function getStaticPaths() {
  return loadAuthors().map((author) => ({
    params: { slug: author.slug },
  }));
}

const slug = Astro.params.slug as string;
const author = getAuthorBySlug(slug);

if (!author) {
  throw new Error(`Author not found: ${slug}`);
}

const posts = getPostsByAuthor(author.slug);
const cards = postsToCardData(posts);
const settings = readSettings();
const jsonLd = createCollectionPageSchema(
  settings,
  {
    name: `${author.name} — WitchClick`,
    url: `/author/${author.slug}`,
    description: author.bio ?? `${author.name} on WitchClick`,
    collectionType: "ProfilePage",
  },
  cards.map((card) => ({
    name: card.title,
    url: `/post/${card.slug}`,
    description: card.excerpt,
  })),
);
---
<Base
  title={`${author.name} — WitchClick`}
  description={author.bio ?? `${author.name}'s stories on WitchClick`}
>
  <HeadSlot slot="head">
    <script type="application/ld+json" is:inline set:html={serializeJsonForScript(jsonLd)} />
  </HeadSlot>

  <section class="author-page-hero">
    <div class="author-page-hero__inner">
      <p class="author-page-hero__eyebrow">Contributor</p>
      <h1 class="author-page-hero__title">{author.name}</h1>
      {author.focus && <p class="author-page-hero__focus">{author.focus}</p>}
    </div>
  </section>

  <section class="author-page-profile">
    <AuthorSpotlight author={author} linkToProfile={false} postCount={posts.length} />
  </section>

  {cards.length > 0 && (
    <section class="author-page-posts">
      <header>
        <h2>Recent stories</h2>
        <p>{`Browse ${posts.length} ${posts.length === 1 ? "story" : "stories"} from ${author.name}.`}</p>
      </header>
      <div class="author-page-posts__grid">
        {cards.map((card) => (
          <PostCard
            href={`/post/${card.slug}`}
            post={{
              slug: card.slug,
              title: card.title,
              excerpt: card.excerpt,
              tldr: card.tldr,
              tags: card.tags,
              readingMinutes: card.readingMinutes,
              publishedAt: card.publishedAt,
              spoonLevel: card.spoonLevel,
              spoons: card.spoons,
              heroImage: card.heroImage,
              heroImageSrc: card.heroImageSrc,
              heroImageAlt: card.heroImageAlt,
              heroAlt: card.heroAlt,
              category: card.category,
            }}
          />
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .author-page-hero {
    margin: clamp(2rem, 6vw, 3.5rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: 3rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--theme-color-amethyst) 20%, transparent), transparent 65%),
      linear-gradient(135deg, var(--theme-surface-base) 95%, var(--theme-surface-panel) 92%);
  }

  .author-page-hero__inner {
    max-width: 48rem;
    display: grid;
    gap: 0.65rem;
  }

  .author-page-hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--ambient-color, var(--text-accent)) 68%, var(--ink-strong, currentColor) 32%);
  }

  .author-page-hero__title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3rem);
  }

  .author-page-hero__focus {
    margin: 0;
    font-size: 1.05rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 78%, white 22%);
  }

  .author-page-profile {
    margin: clamp(2rem, 6vw, 3.5rem) auto;
    max-width: 48rem;
  }

  .author-page-posts {
    margin: clamp(2rem, 6vw, 3.5rem) auto;
    display: grid;
    gap: 1.5rem;
  }

  .author-page-posts header {
    display: grid;
    gap: 0.5rem;
  }

  .author-page-posts h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.2rem);
  }

  .author-page-posts p {
    margin: 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 78%, white 22%);
  }

  .author-page-posts__grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.6rem);
  }

  .author-page-posts__empty {
    font-size: 0.95rem;
    display: grid;
    gap: 0.9rem;
    padding: 1.5rem;
    border-radius: clamp(1.1rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 70%, transparent 30%);
    background: color-mix(in srgb, var(--theme-surface-panel) 92%, transparent 8%);
  }

  .author-page-posts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .author-page-posts__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-color-gold) 35%, transparent 65%);
    text-decoration: none;
    color: var(--theme-text-strong);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .author-page-posts__link:hover,
  .author-page-posts__link:focus-visible {
    background: color-mix(in srgb, var(--theme-color-gold) 15%, transparent 85%);
  }

  .author-page-posts__form {
    display: grid;
    gap: 0.65rem;
    max-width: 24rem;
  }

  .author-page-posts__label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 80%, white 20%);
  }

  .author-page-posts__input {
    width: 100%;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-border-subtle) 70%, transparent 30%);
    background: var(--cozy-input-bg, rgba(255, 250, 245, 0.9));
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
    color: var(--theme-text-strong);
  }

  .author-page-posts__button {
    justify-self: start;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-color-gold) 45%, transparent 55%);
    background: var(--cozy-button-bg, color-mix(in srgb, var(--theme-color-gold) 75%, transparent 25%));
    color: var(--theme-text-strong);
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .author-page-posts__button:hover,
  .author-page-posts__button:focus-visible {
    transform: translateY(-1px);
    box-shadow: var(--elevation-tier-1);
  }

  @media (min-width: 720px) {
    .author-page-posts__grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }
</style>
