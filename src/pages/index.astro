---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import { serializeJsonForScript } from "@/utils/serializeJson";
import SpoonsBadge from "@/components/SpoonsBadge.astro";
import { loadAllPosts, filterPostsByCategory, POST_CATEGORY_RITUAL } from "@/utils/posts";
import { postsToCardData } from "@/utils/postTransforms";
import { readSettings } from "@/utils/settings";
import { createCollectionPageSchema } from "@/utils/structuredData";
import type { CardPost } from "@/types/post";
import { selectDistinctHomeStories } from "@/utils/homeReading";

const title = "WitchClick — A living grimoire for symbolic self-work";

const allPosts = loadAllPosts();
const settings = readSettings();

// Filter for ritual posts only (default category for existing posts)
const ritualPosts = filterPostsByCategory(allPosts, POST_CATEGORY_RITUAL);

const pillarCards = [
  {
    label: "Clean Cursing",
    href: "/curses",
    eyebrow: "Boundaries",
  },
  {
    label: "Rituals & Spreads",
    href: "/hub",
    eyebrow: "Practice",
  },
  {
    label: "Grimoire",
    href: "/entities",
    eyebrow: "Reference",
  },
  {
    label: "Field Notes",
    href: "/meanderings",
    eyebrow: "Essays",
  },
];

const stateCards = [
  {
    label: "Ground",
    glyph: "cairn",
    href: "/hub/calm",
    need: "I need somewhere steady to land.",
    description: "Grounding rituals and quiet anchors for returning to the body.",
  },
  {
    label: "Focus",
    glyph: "focus",
    href: "/hub/focus",
    need: "I need to choose where attention goes.",
    description: "Attention rituals, tarot spreads, and small structures that do not turn you into a machine.",
  },
  {
    label: "Release",
    glyph: "threshold",
    href: "/hub/release",
    need: "I need to stop carrying this.",
    description: "Threshold rituals and clean cursing practices for giving the weight a shape.",
  },
];

// Transform to card data
const cardPosts: CardPost[] = postsToCardData(ritualPosts);

// Preserve chronological order, but do not advertise the same story twice
// when the publishing pipeline has generated a suffixed duplicate slug.
const { featured: latestPost, recent: gridPosts } = selectDistinctHomeStories(cardPosts, 6);
const latestPostHasImage = Boolean(latestPost && (latestPost.heroImageSrc || latestPost.heroImage));

// Create schema for the visible post collection without making the homepage only a feed.
const collectionSchema = latestPost ? createCollectionPageSchema(
  settings,
  {
    name: "WitchClick Symbolic Practice Space",
    url: "/",
    description: "A living grimoire for clean curses, tarot spreads, rituals, grimoire references, and reflective field notes.",
    itemType: "Article",
  },
  [latestPost, ...gridPosts].map((post) => ({
    name: post.title,
    url: `/post/${post.slug}`,
    description: post.tldr ?? post.excerpt,
    image: post.heroImage,
  })),
) : null;
---
<Base {title} desktopWide>
  {collectionSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={serializeJsonForScript(collectionSchema)} />
    </HeadSlot>
  )}

  <div class="home-shell">
    <header data-reveal class="home-masthead">
      <div class="home-masthead__inner">
        <p class="home-masthead__eyebrow">Secular mystical publishing hub</p>
        <h1 class="home-masthead__title">WitchClick is a living grimoire for symbolic self&#8209;work.</h1>
        <p class="home-masthead__tagline">
          Clean curses, tarot spreads, rituals, and reference notes for turning feeling into form.
        </p>
      </div>
      <figure class="home-transition-art" aria-hidden="true">
        <img
          src="/images/hero/creative-re-entry-ritual-for-personal-projects/chatgpt-image-apr-14-2026-10_12_00-am.png"
          alt=""
          loading="eager"
          decoding="async"
          width="1024"
          height="1536"
        />
      </figure>
    </header>

    <section data-reveal class="home-section home-states" aria-labelledby="home-states-heading">
      <div class="home-section__header home-section__header--compact">
        <p class="home-section__eyebrow">Start by need</p>
        <h2 id="home-states-heading" class="home-section__title">If you are arriving with a feeling, start there.</h2>
      </div>
      <div class="home-state-grid">
        {stateCards.map((card) => (
          <a class="home-state-card focus-ring" href={card.href}>
            <span class="home-state-card__topline">
              {card.glyph === "cairn" && (
                <svg class="home-state-card__glyph" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                  <path d="m16 4-5 6h10l-5-6Z" />
                  <path d="m7 17 3-5h12l3 5H7Z" />
                  <path d="m4 27 3-7h18l3 7H4Z" />
                </svg>
              )}
              {card.glyph === "focus" && (
                <svg class="home-state-card__glyph" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                  <circle cx="16" cy="16" r="10" />
                  <circle cx="16" cy="16" r="2" />
                </svg>
              )}
              {card.glyph === "threshold" && (
                <svg class="home-state-card__glyph" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                  <path d="M8 27V7h16v20M4 27h24" />
                  <path d="M17 12v10m-4-4 4 4 4-4" />
                </svg>
              )}
              <span class="home-state-card__action" aria-hidden="true">Choose <span>→</span></span>
            </span>
            <span class="home-state-card__need">{card.need}</span>
            <span class="home-state-card__label">{card.label}</span>
            <span class="home-state-card__description">{card.description}</span>
          </a>
        ))}
      </div>
    </section>

    {(latestPost || gridPosts.length > 0) && (
      <section
        data-reveal
        class="home-section home-reading"
        aria-labelledby={latestPost ? "home-featured-heading" : "home-recent-heading"}
      >
        {latestPost && (
          <div class="home-featured">
            <div class="home-posts__header">
              <div>
                <p class="home-section__eyebrow">Featured practice</p>
                <h2 id="home-featured-heading" class="home-section__title">A recent working from the grimoire</h2>
              </div>
              <a href="/hub" class="home-text-link">Browse rituals & spreads &rarr;</a>
            </div>

            <article class="home-posts__hero">
              <a href={`/post/${latestPost.slug}`} class:list={["group focus-ring", latestPostHasImage && "home-posts__hero-link--illustrated"]}>
                {latestPostHasImage && (
                  <img
                    src={latestPost.heroImageSrc || latestPost.heroImage}
                    alt=""
                    class="home-posts__hero-image"
                    loading="eager"
                    decoding="async"
                    onerror="this.style.display='none'"
                  />
                )}
                <div class:list={["home-posts__hero-content", !latestPostHasImage && "home-posts__hero-content--text-only"]}>
                  {!latestPostHasImage && (
                    <span class="home-posts__folio-overline" aria-hidden="true">From the reading desk</span>
                  )}
                  <h3 class:list={["home-posts__hero-title", !latestPostHasImage && "home-posts__hero-title--text-only"]}>{latestPost.title}</h3>
                  <p class="home-posts__hero-description">{latestPost.tldr || latestPost.excerpt}</p>
                  <div class="home-posts__hero-meta">
                    <span class="home-posts__reading-time">{latestPost.readingMinutes} min read</span>
                    <span class="home-posts__spoons">
                      <SpoonsBadge level={latestPost.spoonLevel || latestPost.spoons} />
                    </span>
                  </div>
                  {!latestPostHasImage && (
                    <span class="home-posts__folio-action" aria-hidden="true">Open this working <span>→</span></span>
                  )}
                </div>
              </a>
            </article>
          </div>
        )}

        {gridPosts.length > 0 && (
          <div class="home-recent">
            <div class="home-posts__header">
              <div>
                <p class="home-section__eyebrow">Recent updates</p>
                <h2 id="home-recent-heading" class="home-section__title">Fresh pages on the table</h2>
              </div>
            </div>
            <div class="home-recent-grid home-recent-grid--editorial">
              {gridPosts.map((post) => (
                <PostCard
                  href={`/post/${post.slug}`}
                  showTags={false}
                  showImagePlaceholder={false}
                  post={{
                    slug: post.slug,
                    title: post.title,
                    excerpt: post.excerpt,
                    tldr: post.tldr,
                    tags: post.tags,
                    readingMinutes: post.readingMinutes,
                    publishedAt: post.publishedAt,
                    spoonLevel: post.spoonLevel,
                    spoons: post.spoons,
                    heroImage: post.heroImage,
                    heroImageSrc: post.heroImageSrc,
                    heroImageAlt: post.heroImageAlt,
                    heroAlt: post.heroAlt,
                    category: post.category,
                  }}
                />
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    <section data-reveal class="home-section home-doorways" aria-labelledby="home-pillars-heading">
      <div class="home-section__header">
        <p class="home-section__eyebrow">Main shelves</p>
        <h2 id="home-pillars-heading" class="home-section__title">What can you do here?</h2>
      </div>
      <nav class="home-doorway-grid" aria-label="Main shelves">
        {pillarCards.map((card) => (
          <a class="home-text-link" href={card.href}>
            {card.eyebrow}: {card.label} &rarr;
          </a>
        ))}
      </nav>
    </section>

  </div>
</Base>

<style>
  :global(:root[data-scope="homepage"]) {
    --home-content-max: 80rem;
    --home-page-gutter: clamp(1.25rem, 4vw, 2.75rem);
    --home-spine-gutter: max(var(--home-page-gutter), calc((100vw - var(--home-content-max)) / 2));
  }

  :global(:root[data-scope="homepage"] :is(.site-header__inner, .site-main__container)) {
    --wc-container-max: calc(var(--home-content-max) + var(--home-page-gutter) * 2);
    --wc-container-padding: var(--home-page-gutter);
  }

  .home-shell {
    width: 100%;
    max-width: var(--home-content-max);
    margin-inline: auto;
  }

  .home-masthead,
  .home-states,
  .home-doorways {
    max-width: var(--home-content-max);
    margin-inline: auto;
  }

  .home-transition-art {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-3, 1rem);
    pointer-events: none;
  }

  .home-transition-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    filter: saturate(0.68) contrast(0.9) brightness(0.92) sepia(0.08);
  }

  .home-masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 58% 78% at 50% 42%,
      color-mix(in srgb, #F1C991 5%, transparent) 0%,
      transparent 72%
    );
  }

  .home-masthead::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      color-mix(in srgb, var(--text-strong) 6%, transparent 94%) 0px,
      transparent 1px,
      transparent 2px,
      color-mix(in srgb, var(--text-strong) 6%, transparent 94%) 3px
    );
    opacity: var(--texture-opacity, 0.025);
  }

  .home-masthead {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(2rem, 5vw, 3.75rem);
    border: 1px solid color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 22%, var(--theme-border-subtle, var(--border-subtle)) 78%);
    border-radius: clamp(1.15rem, 3vw, 1.75rem);
    background:
      radial-gradient(90% 70% at 50% 0%, color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 12%, transparent 88%), transparent 72%),
      linear-gradient(160deg, color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 88%, transparent 12%), color-mix(in srgb, var(--theme-surface-base, var(--surface-base)) 96%, transparent 4%));
    box-shadow: var(--elevation-tier-2, 0 18px 44px rgba(0, 0, 0, 0.08));
    text-align: left;
    overflow: visible;
  }

  .home-masthead__inner {
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }

  .home-masthead__eyebrow,
  .home-section__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 82%, var(--theme-text-muted, var(--text-muted)) 18%);
  }

  .home-masthead__title {
    margin: 0.45rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.4vw, 3.15rem);
    font-weight: 700;
    line-height: 1.08;
    text-wrap: balance;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .home-masthead__tagline {
    margin: 1rem 0 0;
    max-width: 48ch;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    line-height: 1.42;
    font-weight: 600;
    color: var(--theme-text-body, var(--text-body));
  }

  .home-section {
    margin-block: var(--page-section-gap);
  }

  .home-section__header {
    display: grid;
    gap: 0.45rem;
    max-width: 44rem;
    margin-bottom: 1.2rem;
  }

  .home-section__header--compact {
    max-width: 40rem;
  }

  .home-section__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    line-height: 1.14;
    text-wrap: balance;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .home-doorway-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }


  .home-state-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 0.65rem;
    min-height: 100%;
    padding: 24px;
    border: 1px solid var(--theme-border-subtle, var(--line-subtle));
    border-radius: var(--radius-3, 1rem);
    background: color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 82%, transparent 18%);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--elevation-tier-1, 0 8px 20px rgba(0, 0, 0, 0.05));
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    overflow: hidden;
  }

  .home-state-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2rem;
  }

  .home-state-card__glyph {
    display: block;
    width: 2rem;
    height: 2rem;
    color: var(--accent-mulberry);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .home-state-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-mulberry);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .home-state-card__action span {
    font-size: 1rem;
    line-height: 1;
    transition: transform 160ms ease;
  }

  .home-state-card:hover .home-state-card__action span,
  .home-state-card:focus-visible .home-state-card__action span {
    transform: translateX(2px);
  }


  .home-state-card > * {
    position: relative;
    z-index: 1;
  }


  .home-state-card:hover,
  .home-state-card:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 38%, var(--theme-border-subtle, var(--line-subtle)) 62%);
    box-shadow: var(--elevation-tier-2, 0 14px 32px rgba(0, 0, 0, 0.08));
  }


  .home-state-card__label {
    font-size: 1.25rem;
    font-weight: 750;
    line-height: 1.2;
    color: var(--theme-text-strong, var(--text-strong));
  }


  .home-state-card__description {
    color: var(--theme-text-muted, var(--text-muted));
    line-height: 1.58;
    font-size: 0.94rem;
  }

  .home-state-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-state-card {
    background: color-mix(in srgb, var(--theme-surface-base, var(--surface-base)) 88%, var(--theme-text-accent, var(--text-accent)) 4%);
  }

  .home-state-card__need {
    font-size: 0.86rem;
    font-weight: 650;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .home-posts__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .home-text-link {
    color: var(--theme-text-accent-strong, var(--text-accent));
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .home-text-link:hover,
  .home-text-link:focus-visible {
    text-decoration: underline;
  }

  .home-posts__hero > a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--theme-border-subtle, var(--line-subtle));
    border-radius: var(--radius-3, 1rem);
    background: var(--theme-surface-panel, var(--surface-panel));
    text-decoration: none;
    box-shadow: var(--elevation-tier-1, 0 8px 20px rgba(0, 0, 0, 0.05));
  }

  .home-posts__hero-image {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    max-height: 28rem;
    object-fit: cover;
    background: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 14%, transparent 86%);
  }

  .home-posts__hero > .home-posts__hero-link--illustrated {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    align-items: center;
  }

  .home-posts__hero-content {
    max-width: 72rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .home-posts__hero-content--text-only {
    padding-block: clamp(1.5rem, 4vw, 2.3rem);
  }

  .home-posts__hero-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    line-height: 1.17;
    font-weight: 700;
    color: var(--theme-text-strong, var(--text-strong));
    transition: color var(--dur-med, 200ms) var(--ease-out-curve, ease);
  }

  .home-posts__hero-title--text-only {
    font-size: clamp(1.9rem, 4vw, 2.65rem);
  }

  .group:hover .home-posts__hero-title,
  .group:focus-visible .home-posts__hero-title {
    color: var(--theme-text-accent-strong, var(--text-accent));
  }

  .home-posts__hero-description {
    margin: 0.85rem 0 0;
    max-width: 70ch;
    font-size: 1rem;
    line-height: 1.62;
    color: var(--theme-text-muted, var(--text-muted));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-posts__hero-meta {
    margin-top: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 1.4rem;
  }

  .home-posts__reading-time {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--theme-text-muted, var(--text-muted)) 88%, transparent 12%);
  }

  .home-posts__spoons {
    transform: scale(0.9);
    transform-origin: left center;
    color: color-mix(in srgb, var(--theme-text-muted, var(--text-muted)) 92%, transparent 8%);
  }

  .home-recent-grid {
    display: grid;
    gap: var(--grid-gap);
    margin-top: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .home-reading {
    position: relative;
    padding-inline-start: clamp(0.85rem, 2vw, 1.75rem);
    border-inline-start: 1px solid color-mix(in srgb, var(--theme-text-accent) 35%, var(--theme-border-subtle));
  }
  .home-reading::before {
    content: "";
    position: absolute;
    inset-inline-start: -3px;
    top: 0;
    width: 5px;
    height: 2.5rem;
    background: var(--accent-mulberry);
  }
  .home-recent { margin-top: clamp(2rem, 4vw, 3.5rem); }
  .home-recent-grid--editorial { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .home-recent-grid--editorial > :first-child { grid-row: span 2; }
  .home-doorways {
    padding-block-start: clamp(1.5rem, 3vw, 2.5rem);
    border-block-start: 1px solid var(--theme-border-subtle);
  }
  @media (max-width: 820px) {
    .home-recent-grid--editorial { grid-template-columns: 1fr; }
    .home-recent-grid--editorial > :first-child { grid-row: auto; }
  }
  @media (max-width: 820px) {
    .home-state-grid {
      grid-template-columns: 1fr;
    }

    .home-masthead {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .home-transition-art {
      aspect-ratio: 16 / 7;
      max-height: 15rem;
    }

    .home-posts__hero > .home-posts__hero-link--illustrated {
      grid-template-columns: 1fr;
    }

    .home-posts__hero-image {
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .home-posts__header {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 719px) {
    .home-masthead {
      text-align: left;
    }

    .home-posts__hero-meta {
      gap: 0.7rem;
    }
  }
  /* The three doorways share a layout, but carry their own quiet ink accents. */
  .home-state-card:nth-child(1) { --home-need-accent: #9cab9c; }
  .home-state-card:nth-child(2) { --home-need-accent: #8eaebe; }
  .home-state-card:nth-child(3) { --home-need-accent: var(--accent-mulberry); }

  .home-state-card {
    background:
      radial-gradient(ellipse 95% 75% at 100% 0, color-mix(in srgb, var(--home-need-accent) 12%, transparent), transparent 75%),
      color-mix(in srgb, var(--theme-surface-base, var(--surface-base)) 92%, var(--theme-text-accent, var(--text-accent)) 8%);
