---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import SpoonsBadge from "@/components/SpoonsBadge.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import { loadAllPosts, filterPostsByCategory, POST_CATEGORY_RITUAL, POST_CATEGORY_MEANDERING } from "@/utils/posts";
import { postsToCardData } from "@/utils/postTransforms";
import { readSettings } from "@/utils/settings";
import { createCollectionPageSchema } from "@/utils/structuredData";
import type { CardPost } from "@/types/post";

const title = "WitchClick — Cozy secular rituals for everyday magic";

const allPosts = loadAllPosts();
const settings = readSettings();

// Filter for ritual posts only (default category for existing posts)
const ritualPosts = filterPostsByCategory(allPosts, POST_CATEGORY_RITUAL);
const hasPublishedMeanderings = filterPostsByCategory(allPosts, POST_CATEGORY_MEANDERING).length > 0;

// Transform to card data
const cardPosts: CardPost[] = postsToCardData(ritualPosts);

// Most recent post as section hero, then supporting grid posts
const latestPost = cardPosts[0] ?? null;
const latestPostHasImage = Boolean(latestPost && (latestPost.heroImageSrc || latestPost.heroImage));
const gridPosts = cardPosts.slice(1, 7);
const hasMorePosts = cardPosts.length > 7;

// Create schema for the post collection
const collectionSchema = latestPost ? createCollectionPageSchema(
  settings,
  {
    name: "Recent Rituals & Essays",
    url: "/",
    description: "Gentle rituals, cozy tools, and reflections for when life feels loud.",
    itemType: "Article",
  },
  [latestPost, ...gridPosts].map((post) => ({
    name: post.title,
    url: `/post/${post.slug}`,
    description: post.tldr ?? post.excerpt,
    image: post.heroImage,
  })),
) : null;
---
<Base {title}>
  {collectionSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />
    </HeadSlot>
  )}

  <div class="mx-auto w-full max-w-6xl px-4">
    <header data-reveal class="home-masthead mb-0 text-center">
      <div class="home-masthead__inner mx-auto max-w-[var(--content-max-width)]">
        <h1 class="home-masthead__title">WitchClick</h1>
        <p class="home-masthead__tagline">
          Gentle rituals, cozy tools, and reflections for when life feels loud.
        </p>
        <p class="home-masthead__subline">
          Small practices for shadow work, rest, and everyday magic—designed with neurodivergent brains in mind.
        </p>
        <div class="home-masthead__sigil" aria-hidden="true"><span>✦</span></div>
      </div>
    </header>

    {latestPost && (
      <section data-reveal class="home-posts mb-[var(--page-section-gap)]" aria-labelledby="home-posts-heading">
        <div class="mx-auto w-full max-w-4xl">
          <div class="home-posts__header">
            <h2 id="home-posts-heading" class="font-serif text-2xl font-semibold text-body-strong sm:text-3xl">From the Grimoire</h2>
            <a href="/page/1" class="text-sm font-medium text-brand-accent transition-colors hover:text-brand-accent hover:underline">View all →</a>
          </div>

          <article class="home-posts__hero">
            <a href={`/post/${latestPost.slug}`} class="group block">
              {latestPostHasImage && (
                <img
                  src={latestPost.heroImageSrc || latestPost.heroImage}
                  alt={latestPost.heroAlt || latestPost.heroImageAlt || `Hero image for ${latestPost.title}`}
                  class="home-posts__hero-image"
                  loading="eager"
                  decoding="async"
                />
              )}
              <div class:list={["home-posts__hero-content", !latestPostHasImage && "home-posts__hero-content--text-only"]}>
                <h3 class:list={["home-posts__hero-title", !latestPostHasImage && "home-posts__hero-title--text-only"]}>{latestPost.title}</h3>
                <p class="home-posts__hero-description">{latestPost.tldr || latestPost.excerpt}</p>
                <div class="home-posts__hero-tags">
                  {latestPost.tags.slice(0, 3).map((tag) => (
                    <span class="home-posts__tag">#{String(tag).toLowerCase()}</span>
                  ))}
                </div>
                <div class="home-posts__hero-meta">
                  <span class="home-posts__reading-time">{latestPost.readingMinutes} min read</span>
                  <span class="home-posts__spoons">
                    <SpoonsBadge level={latestPost.spoonLevel || latestPost.spoons} />
                  </span>
                </div>
              </div>
            </a>
          </article>
        </div>

        {gridPosts.length > 0 && (
          <div data-reveal class="home-recent-grid">
            {gridPosts.map((post) => (
              <PostCard
                href={`/post/${post.slug}`}
                post={{
                  slug: post.slug,
                  title: post.title,
                  excerpt: post.excerpt,
                  tldr: post.tldr,
                  tags: post.tags,
                  readingMinutes: post.readingMinutes,
                  publishedAt: post.publishedAt,
                  spoonLevel: post.spoonLevel,
                  spoons: post.spoons,
                  heroImage: post.heroImage,
                  heroImageSrc: post.heroImageSrc,
                  heroImageAlt: post.heroImageAlt,
                  heroAlt: post.heroAlt,
                  category: post.category,
                }}
              />
            ))}
          </div>
        )}

        {hasMorePosts && (
          <div class="home-posts__footer">
            <a href="/page/1" class="text-sm text-body-muted transition-colors hover:text-brand-accent hover:underline">
              View all posts →
            </a>
          </div>
        )}
      </section>
    )}
  </div>

  <aside data-reveal class="my-[var(--page-section-gap)]">
    <Card class="max-w-lg mx-auto text-center" padding="lg">
      <h3 class="mb-2 font-serif text-xl font-semibold text-body-strong sm:text-2xl">Looking for more?</h3>
      <p class="mb-6 text-base text-body-muted">
        Explore printable tools, browse by topic, check out non-magickal rambles, or reach out if you need something specific.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        {hasPublishedMeanderings && <Button href="/meanderings" variant="secondary" size="sm">Meanderings</Button>}
        <Button href="/tools" variant="secondary" size="sm">Printable Tools</Button>
        <Button href="/entities" variant="secondary" size="sm">Browse Topics</Button>
        <Button href="/contact" variant="secondary" size="sm">Get in Touch</Button>
      </div>
    </Card>
  </aside>
</Base>

<style>
  .home-masthead {
    position: relative;
    padding-block: clamp(1.5rem, 4vw, 2rem) clamp(0.9rem, 2.5vw, 1.5rem);
  }

  @media (min-width: 769px) {
    .home-masthead {
      padding-top: 0;
    }
  }

  .home-masthead__inner {
    position: relative;
    isolation: isolate;
  }

  .home-masthead__inner::before {
    content: "";
    position: absolute;
    inset: auto 50% -1.2rem;
    width: min(38rem, 92%);
    height: clamp(7rem, 22vw, 11rem);
    transform: translateX(-50%);
    border-radius: 999px;
    pointer-events: none;
    z-index: -1;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 14%, transparent 86%) 0%,
      color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 7%, transparent 93%) 45%,
      transparent 78%
    );
  }

  .home-masthead__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .home-masthead__tagline {
    margin: 0.85rem auto 0;
    max-width: 36ch;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    line-height: 1.42;
    font-weight: 500;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .home-masthead__subline {
    margin: 1rem auto 0;
    max-width: 58ch;
    font-size: 1rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--theme-text-body, var(--text-body)) 90%, transparent 10%);
  }

  .home-masthead__sigil {
    margin-top: 1.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    color: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 78%, transparent 22%);
    font-size: 0.95rem;
  }

  .home-masthead__sigil::before,
  .home-masthead__sigil::after {
    content: "";
    width: clamp(4.25rem, 14vw, 6rem);
    height: 1px;
    background: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 44%, transparent 56%);
  }

  .home-posts__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .home-posts__hero {
    margin-top: 1.35rem;
  }

  .home-posts__hero > a {
    display: block;
  }

  .home-posts__hero-image {
    width: 100%;
    height: clamp(11rem, 32vw, 17.5rem);
    max-height: 280px;
    object-fit: cover;
    border-radius: 0.75rem 0.75rem 0 0;
    background: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 16%, transparent 84%);
  }

  .home-posts__hero-content {
    padding: 1.25rem;
    background: color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 5%, transparent 95%);
    border-radius: 0 0 0.75rem 0.75rem;
  }

  .home-posts__hero-content--text-only {
    padding-top: 2rem;
    background: transparent;
    border-radius: 0;
  }

  .home-posts__hero-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1.17;
    font-weight: 700;
    color: var(--theme-text-strong, var(--text-strong));
    transition: color var(--dur-med, 200ms) var(--ease-out-curve, ease);
  }

  .home-posts__hero-title--text-only {
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .group:hover .home-posts__hero-title,
  .group:focus-visible .home-posts__hero-title {
    color: var(--theme-text-accent-strong, var(--text-accent));
  }

  .home-posts__hero-description {
    margin: 0.85rem 0 0;
    max-width: 70ch;
    font-size: 1rem;
    line-height: 1.62;
    color: var(--theme-text-muted, var(--text-muted));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-posts__hero-tags {
    margin-top: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .home-posts__tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 24%, transparent 76%);
    background: color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 4%, transparent 96%);
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    line-height: 1.2;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .home-posts__hero-meta {
    margin-top: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 1.4rem;
  }

  .home-posts__reading-time {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--theme-text-muted, var(--text-muted)) 88%, transparent 12%);
  }

  .home-posts__spoons {
    transform: scale(0.9);
    transform-origin: left center;
    color: color-mix(in srgb, var(--theme-text-muted, var(--text-muted)) 92%, transparent 8%);
  }

  .home-posts__footer {
    margin-top: 1.35rem;
    text-align: right;
  }

  .home-recent-grid {
    display: grid;
    gap: var(--grid-gap);
    margin-top: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  @media (max-width: 719px) {
    .home-masthead__tagline {
      max-width: 26ch;
    }

    .home-posts__header {
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .home-posts__hero-content {
      padding-inline: 0;
      padding-bottom: 0;
    }

    .home-posts__hero-meta {
      gap: 0.7rem;
    }
  }
</style>
