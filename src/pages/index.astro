---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { loadAllPosts, estimateReadingMinutes, firstParagraph } from "../utils/posts";
import { readSettings } from "../utils/settings";

export const prerender = true;

const settings = readSettings();
const posts = loadAllPosts();

const PAGE_SIZE = 12;
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const pagePosts = posts.slice(0, PAGE_SIZE);

const heroPost = pagePosts[0] ?? null;
const hero = heroPost ? toViewModel(heroPost) : null;

const tagline =
  settings.disclosure && settings.disclosure.includes("affiliate")
    ? "Mindful routines, gentle rituals, and tools we genuinely love."
    : "Mindful routines, secular rituals, and cozy planning guides.";

const heroOgImage = heroPost?.data?.ogImage ?? undefined;
const heroBackgroundImage =
  heroPost?.data?.heroImageSrc ?? heroPost?.data?.ogImage ?? undefined;
const heroImageAlt = heroPost?.data?.heroImageAlt ?? hero?.title ?? undefined;
const heroTitle = hero?.title ?? "Cozy secular rituals for modern life";
const heroDescription = hero?.excerpt ?? tagline;
const heroCtaButtons = [
  ...(hero
    ? [
        {
          href: hero.href,
          label: "Read the latest guide",
          variant: "primary" as const,
        },
      ]
    : []),
  {
    href: "/downloads",
    label: "Explore printable tools",
    variant: "secondary" as const,
  },
];
const gridPosts = heroPost ? pagePosts.slice(1) : pagePosts;
const hasPosts = pagePosts.length > 0;

function toViewModel(post) {
  const fm = post.data ?? {};
  const excerpt = fm.excerpt ?? fm.description ?? fm.metaDescription ?? firstParagraph(post.content);
  const date = resolveDate(fm);
  const tags = Array.isArray(fm.tags) ? fm.tags : [];
  const readingMinutes = fm.readingMinutes ?? estimateReadingMinutes(post.content);
  return {
    slug: post.slug,
    title: fm.title ?? post.title,
    excerpt,
    tags,
    readingMinutes,
    publishedAt: date,
    href: `/post/${post.slug}`,
  };
}

function resolveDate(data) {
  const value = data?.publishedAt ?? data?.pubDate ?? data?.date ?? null;
  if (!value) return undefined;
  const date = new Date(value);
  if (Number.isNaN(+date)) return undefined;
  return date.toISOString();
}
---
<Base
  title={`${settings.brandName ?? "WitchClick"} — Cozy secular rituals & tools`}
  description={tagline}
  ogImage={heroOgImage ?? ""}
>
  <Hero
    eyebrow="Fresh from the coven"
    title={heroTitle}
    description={heroDescription}
    backgroundImage={heroBackgroundImage}
    imageAlt={heroImageAlt}
    ctaButtons={heroCtaButtons}
  />

  <section class="mt-12">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-2xl font-semibold text-purple-900">Latest rituals &amp; planners</h2>
      {totalPages > 1 && (
        <a class="text-sm font-medium text-purple-700 underline-offset-4 hover:underline" href="/page/2">
          Browse the archive →
        </a>
      )}
    </div>

    {hero && (
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <article class="md:col-span-2 rounded-3xl border border-purple-100 bg-white/80 p-6 shadow-sm">
          <p class="text-xs uppercase tracking-wide text-purple-500">Featured guide</p>
          <h3 class="mt-2 text-2xl font-semibold text-purple-900">{hero.title}</h3>
          <p class="mt-3 text-sm text-purple-700">{hero.excerpt}</p>
          <div class="mt-4 flex flex-wrap gap-2 text-xs">
            {hero.readingMinutes && (
              <span class="rounded-full border border-purple-200 bg-purple-50 px-3 py-0.5">⏱️ {hero.readingMinutes} min read</span>
            )}
            {hero.tags.slice(0, 4).map((tag) => (
              <span class="rounded-full border border-purple-200 bg-purple-50 px-3 py-0.5">#{String(tag).toLowerCase()}</span>
            ))}
          </div>
          <a
            class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-purple-700 underline-offset-4 hover:underline"
            href={hero.href}
          >
            Dive into the ritual
            <span aria-hidden="true">→</span>
          </a>
        </article>
        <div class="rounded-3xl border border-purple-100 bg-white/70 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-purple-900">Need a cozy starting place?</h3>
          <p class="mt-3 text-sm text-purple-700">
            Browse guided spreads, gentle accountability planners, and grounding prompts to keep your routines soft and sustainable.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-purple-700">
            <li>• <a class="underline-offset-4 hover:underline" href="/downloads">Printable downloads</a></li>
            <li>• <a class="underline-offset-4 hover:underline" href="/entities">Entity library &amp; correspondences</a></li>
            <li>• <a class="underline-offset-4 hover:underline" href="/post/pre-interview-grounding-ritual">Pre-interview grounding ritual</a></li>
          </ul>
        </div>
      </div>
    )}

    {hasPosts ? (
      gridPosts.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {gridPosts.map((post) => {
            const card = toViewModel(post);
            return (
              <PostCard
                post={{
                  slug: card.slug,
                  title: card.title,
                  excerpt: card.excerpt,
                  tags: card.tags,
                  readingMinutes: card.readingMinutes,
                  publishedAt: card.publishedAt,
                }}
                href={card.href}
              />
            );
          })}
        </div>
      ) : (
        <p class="mt-8 text-sm text-purple-700/70">
          More guides are brewing. Check back soon or explore the archive below.
        </p>
      )
    ) : (
      <p class="mt-8 text-sm text-purple-700/70">
        No posts found yet. Add a Markdown file to <code>content/posts</code> to get started.
      </p>
    )}
  </section>

  {totalPages > 1 ? (
    <Pagination page={1} totalPages={totalPages} baseHref="/page" />
  ) : null}
</Base>
