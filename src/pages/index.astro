---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { loadAllPosts, estimateReadingMinutes, firstParagraph } from "../utils/posts";
import { readSettings } from "../utils/settings";

export const prerender = true;

const settings = readSettings();
const posts = loadAllPosts();

const PAGE_SIZE = 12;
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const pagePosts = posts.slice(0, PAGE_SIZE);

const heroPost = pagePosts[0] ?? null;
const hero = heroPost ? toViewModel(heroPost) : null;

const tagline =
  settings.disclosure && settings.disclosure.includes("affiliate")
    ? "Mindful routines, gentle rituals, and tools we genuinely love."
    : "Mindful routines, secular rituals, and cozy planning guides.";

const heroOgImage = heroPost?.data?.ogImage ?? undefined;
const heroBackgroundImage =
  heroPost?.data?.heroImageSrc ?? heroPost?.data?.ogImage ?? undefined;
const heroImageAlt = heroPost?.data?.heroImageAlt ?? hero?.title ?? undefined;
const heroTitle = hero?.title ?? "Cozy secular rituals for modern life";
const heroDescription = hero?.excerpt ?? tagline;
const heroCtaButtons = [
  ...(hero
    ? [
        {
          href: hero.href,
          label: "Read the latest guide",
          variant: "primary" as const,
        },
      ]
    : []),
  {
    href: "/downloads",
    label: "Explore printable tools",
    variant: "secondary" as const,
  },
];
const gridPosts = heroPost ? pagePosts.slice(1) : pagePosts;
const hasPosts = pagePosts.length > 0;

function toViewModel(post) {
  const fm = post.data ?? {};
  const excerpt = fm.excerpt ?? fm.description ?? fm.metaDescription ?? firstParagraph(post.content);
  const date = resolveDate(fm);
  const tags = Array.isArray(fm.tags) ? fm.tags : [];
  const readingMinutes = fm.readingMinutes ?? estimateReadingMinutes(post.content);
  return {
    slug: post.slug,
    title: fm.title ?? post.title,
    excerpt,
    tags,
    readingMinutes,
    publishedAt: date,
    href: `/post/${post.slug}`,
  };
}

function resolveDate(data) {
  const value = data?.publishedAt ?? data?.pubDate ?? data?.date ?? null;
  if (!value) return undefined;
  const date = new Date(value);
  if (Number.isNaN(+date)) return undefined;
  return date.toISOString();
}
---
<Base
  title={`${settings.brandName ?? "WitchClick"} — Cozy secular rituals & tools`}
  description={tagline}
  ogImage={heroOgImage ?? ""}
  wide
>
  <div class="grimoire-bg min-h-screen">
    <section class="home-canvas mx-auto max-w-5xl px-4 py-12 sm:py-16">
      <div class="grimoire-card home-hero">
        <Hero
          eyebrow="Fresh from the coven"
          title={heroTitle}
          description={heroDescription}
          backgroundImage={heroBackgroundImage}
          imageAlt={heroImageAlt}
          ctaButtons={heroCtaButtons}
        />
      </div>

      <div class="grimoire-card home-feed">
        <div class="home-feed-header">
          <h2 class="home-feed-title font-serif">Latest rituals &amp; planners</h2>
          {totalPages > 1 && (
            <a class="home-feed-link" href="/page/2">
              Browse the archive →
            </a>
          )}
        </div>

        {hero && (
          <div class="home-feature">
            <article class="grimoire-card home-feature-card">
              <p class="home-feature-eyebrow">Featured guide</p>
              <h3 class="home-feature-title font-serif">{hero.title}</h3>
              <p class="home-feature-summary">{hero.excerpt}</p>
              <div class="home-feature-meta">
                {hero.readingMinutes && <span>⏱️ {hero.readingMinutes} min read</span>}
                {hero.tags.slice(0, 4).map((tag) => (
                  <span>#{String(tag).toLowerCase()}</span>
                ))}
              </div>
              <a class="home-feature-link" href={hero.href}>
                Dive into the ritual
                <span aria-hidden="true">→</span>
              </a>
            </article>

            <aside class="grimoire-card home-callout" aria-labelledby="home-callout-heading">
              <h3 id="home-callout-heading" class="font-serif">Need a cozy starting place?</h3>
              <p>
                Browse guided spreads, gentle accountability planners, and grounding prompts to keep your routines soft and sustainable.
              </p>
              <ul class="home-callout-list">
                <li><a href="/downloads">Printable downloads</a></li>
                <li><a href="/entities">Entity library &amp; correspondences</a></li>
                <li><a href="/post/pre-interview-grounding-ritual">Pre-interview grounding ritual</a></li>
              </ul>
            </aside>
          </div>
        )}

        {hasPosts ? (
          gridPosts.length > 0 ? (
            <div class="home-grid grid grid-cols-1 sm:grid-cols-2">
              {gridPosts.map((post) => {
                const card = toViewModel(post);
                return (
                  <PostCard
                    post={{
                      slug: card.slug,
                      title: card.title,
                      excerpt: card.excerpt,
                      tags: card.tags,
                      readingMinutes: card.readingMinutes,
                      publishedAt: card.publishedAt,
                    }}
                    href={card.href}
                  />
                );
              })}
            </div>
          ) : (
            <p class="home-empty">
              More guides are brewing. Check back soon or explore the archive below.
            </p>
          )
        ) : (
          <p class="home-empty">
            No posts found yet. Add a Markdown file to <code>content/posts</code> to get started.
          </p>
        )}
      </div>
    </section>

    {totalPages > 1 ? (
      <div class="mx-auto max-w-5xl px-4 pb-12">
        <Pagination page={1} totalPages={totalPages} baseHref="/page" />
      </div>
    ) : null}
  </div>
</Base>

<style>
  .home-canvas {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    color: var(--ink-body, currentColor);
  }

  .home-hero {
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .home-hero > section {
    background: transparent;
    border: 0;
    border-radius: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: none;
    padding: 0;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .home-hero > section .text-xs {
    letter-spacing: 0.32em;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 82%, white 18%);
  }

  .home-hero > section h1 {
    color: var(--ink-strong, currentColor);
    font-family: var(--font-serif, inherit);
  }

  .home-hero > section p {
    color: color-mix(in srgb, var(--ink-body, currentColor) 92%, white 8%);
  }

  .home-hero :is(a.bg-purple-700) {
    background: var(--action-primary);
    color: var(--action-primary-text);
    border-color: transparent;
  }

  .home-hero :is(a.bg-purple-700):hover,
  .home-hero :is(a.bg-purple-700):focus-visible {
    background: var(--action-primary-hover);
  }

  .home-hero :is(a.border) {
    background: var(--action-secondary-surface);
    border-color: var(--action-secondary-border);
    color: var(--action-secondary-text);
  }

  .home-hero :is(a.border):hover,
  .home-hero :is(a.border):focus-visible {
    background: var(--action-secondary-hover);
  }

  .home-feed {
    padding: clamp(1.75rem, 4vw, 2.85rem);
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.6rem);
  }

  .home-feed-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .home-feed-title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--ink-strong, currentColor);
  }

  .home-feed-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 68%, var(--ink-body, currentColor) 32%);
    text-decoration: none;
  }

  .home-feed-link:hover,
  .home-feed-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .home-feature {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.1rem);
  }

  @media (min-width: 768px) {
    .home-feature {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: stretch;
    }
  }

  .home-feature-card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3.5vw, 2.2rem);
  }

  .home-feature-eyebrow {
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 82%, white 18%);
    margin: 0;
  }

  .home-feature-title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--ink-strong, currentColor);
  }

  .home-feature-summary {
    margin: 0;
    color: var(--ink-body, currentColor);
  }

  .home-feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--ink-muted, currentColor);
  }

  .home-feature-meta span {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--panel-border-soft);
    padding: 0.35rem 0.85rem;
    background: color-mix(in srgb, var(--panel-surface-soft) 88%, transparent);
  }

  .home-feature-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 66%, var(--ink-body, currentColor) 34%);
    text-decoration: none;
  }

  .home-feature-link:hover,
  .home-feature-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .home-callout {
    padding: clamp(1.5rem, 3vw, 2rem);
    display: grid;
    gap: 1rem;
    color: var(--ink-body, currentColor);
  }

  .home-callout p {
    margin: 0;
  }

  .home-callout h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    color: var(--ink-strong, currentColor);
  }

  .home-callout-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    font-size: 0.95rem;
  }

  .home-callout-list li {
    position: relative;
    padding-left: 1.2rem;
  }

  .home-callout-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 65%, var(--ink-body, currentColor) 35%);
  }

  .home-callout a {
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 65%, var(--ink-body, currentColor) 35%);
    text-decoration: none;
  }

  .home-callout a:hover,
  .home-callout a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .home-grid {
    gap: clamp(1.5rem, 3vw, 2.35rem);
  }

  .home-grid .card-panel {
    color: var(--ink-strong, currentColor);
  }

  .home-empty {
    margin: 0;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 85%, white 15%);
  }

  .home-empty code {
    padding: 0.2rem 0.45rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--panel-surface-soft) 88%, transparent);
  }
</style>
