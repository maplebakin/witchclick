---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import EvergreenCta from '@/components/blocks/EvergreenCta.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import { loadAllPosts, estimateReadingMinutes, firstParagraph } from '@/utils/posts';
import { readSettings } from '@/utils/settings';
import { readEvergreenBlocks } from '@/utils/blocks';
import { createItemListSchema } from '@/utils/structuredData';
import { Fragment } from 'astro/jsx-runtime';

export const prerender = true;

const settings = readSettings();
const posts = loadAllPosts();
const evergreenBlocks = readEvergreenBlocks();

const PAGE_SIZE = 12;
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const pagePosts = posts.slice(0, PAGE_SIZE);

const heroPost = pagePosts[0] ?? null;
const hero = heroPost ? toViewModel(heroPost) : null;

const tagline =
  settings.disclosure && settings.disclosure.includes('affiliate')
    ? 'Mindful routines, gentle rituals, and tools we genuinely love.'
    : 'Mindful routines, secular rituals, and cozy planning guides.';

const heroOgImage = heroPost?.data?.ogImage ?? undefined;
const heroTitle = hero?.title ?? 'Cozy secular rituals for modern life';
const heroDescription = hero?.excerpt ?? tagline;
const heroPrimaryHref = hero?.href ?? '/rituals/';
const heroPrimaryLabel = hero ? 'Read the latest guide →' : 'Browse the latest rituals →';
const heroSecondaryHref = '/tools/';
const heroSecondaryLabel = 'Explore printable tools';

const gridPosts = heroPost ? pagePosts.slice(1) : pagePosts;
const hasPosts = pagePosts.length > 0;
const evergreenCta = evergreenBlocks.cta;
const evergreenTestimonials = evergreenBlocks.testimonials ?? [];
const moodRibbonIndex = 3;
const moodLinks = [
  { href: '/tools/', label: 'Printable planners' },
  { href: '/entities', label: 'Herbal allies' },
  { href: '/post/pre-interview-grounding-ritual', label: 'Grounding ritual' },
];
const homeStructuredItems = pagePosts.map((post) => {
  const card = toViewModel(post);
  return {
    name: card.title,
    url: card.href,
    description: card.excerpt,
  };
});
const homeItemList = createItemListSchema(
  settings,
  {
    name: `${settings.brandName ?? 'WitchClick'} — Latest rituals`,
    url: '/',
    description: tagline,
    itemType: 'Article',
  },
  homeStructuredItems,
);

function toViewModel(post) {
  const fm = post.data ?? {};
  const excerpt = fm.excerpt ?? fm.description ?? fm.metaDescription ?? firstParagraph(post.content);
  const date = resolveDate(fm);
  const tags = Array.isArray(fm.tags) ? fm.tags : [];
  const readingMinutes = fm.readingMinutes ?? estimateReadingMinutes(post.content);
  return {
    slug: post.slug,
    title: fm.title ?? post.title,
    excerpt,
    tags,
    readingMinutes,
    publishedAt: date,
    href: `/post/${post.slug}`,
  };
}

function resolveDate(data) {
  const value = data?.publishedAt ?? data?.pubDate ?? data?.date ?? null;
  if (!value) return undefined;
  const date = new Date(value);
  if (Number.isNaN(+date)) return undefined;
  return date.toISOString();
}
---
<Base
  title={`${settings.brandName ?? 'WitchClick'} — Cozy secular rituals & tools`}
  description={tagline}
  ogImage={heroOgImage ?? ''}
  desktopWide={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homeItemList)} />
  </Fragment>

  <Hero
    kicker="Fresh from the coven"
    title={heroTitle}
    blurb={heroDescription}
    primaryHref={heroPrimaryHref}
    primaryLabel={heroPrimaryLabel}
    secondaryHref={heroSecondaryHref}
    secondaryLabel={heroSecondaryLabel}
  />

  <div class="grimoire-bg min-h-screen">
    <section class="home-canvas mx-auto w-full px-4 py-12 sm:px-6 sm:py-16 lg:px-8 xl:px-12 2xl:px-16">
      <aside class="soft-card home-callout" aria-labelledby="home-callout-heading">
        <h3 id="home-callout-heading" class="font-serif">Need a cozy starting place?</h3>
        <p>
          Browse guided spreads, gentle accountability planners, and grounding prompts to keep your routines soft and sustainable.
        </p>
        <ul class="home-callout-list">
          <li><a href="/tools/">Printable downloads</a></li>
          <li><a href="/entities">Entity library &amp; correspondences</a></li>
          <li><a href="/post/pre-interview-grounding-ritual">Pre-interview grounding ritual</a></li>
        </ul>
      </aside>

      {(evergreenCta || evergreenTestimonials.length > 0) && (
        <section class="home-evergreen" aria-label="Evergreen invitations">
          {evergreenCta && (
            <EvergreenCta
              eyebrow={evergreenCta.eyebrow}
              title={evergreenCta.title}
              description={evergreenCta.description}
              form={evergreenCta.form}
            />
          )}
          {evergreenTestimonials.length > 0 && <Testimonials testimonials={evergreenTestimonials} />}
        </section>
      )}

      <section class="home-feed panel" aria-labelledby="latest-heading">
        <div class="home-feed-header">
          <h2 id="latest-heading" class="home-feed-title font-serif">Latest rituals &amp; planners</h2>
          {totalPages > 1 && (
            <a class="home-feed-link" href="/page/2">
              Browse the archive →
            </a>
          )}
        </div>

        {hero && (
          <div class="home-feature">
            <article class="soft-card home-feature-card">
              <p class="home-feature-eyebrow">Featured guide</p>
              <h3 class="home-feature-title font-serif">{hero.title}</h3>
              <p class="home-feature-summary">{hero.excerpt}</p>
              <div class="home-feature-meta">
                {hero.readingMinutes && <span>⏱️ {hero.readingMinutes} min read</span>}
                {hero.tags.slice(0, 4).map((tag) => (
                  <span>#{String(tag).toLowerCase()}</span>
                ))}
              </div>
              <a class="home-feature-link" href={hero.href}>
                Dive into the ritual
                <span aria-hidden="true">→</span>
              </a>
            </article>
          </div>
        )}

        {hasPosts ? (
          gridPosts.length > 0 ? (
            <div class="home-grid grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
              {gridPosts.map((post, index) => {
                const card = toViewModel(post);
                return (
                  <Fragment key={card.slug}>
                    <PostCard
                      class="shadow-1"
                      post={{
                        slug: card.slug,
                        title: card.title,
                        excerpt: card.excerpt,
                        tags: card.tags,
                        readingMinutes: card.readingMinutes,
                        publishedAt: card.publishedAt,
                      }}
                      href={card.href}
                    />
                    {index === moodRibbonIndex - 1 && gridPosts.length > moodRibbonIndex && (
                      <div class="home-grid-ribbon" aria-label="Browse by mood">
                        <p class="home-grid-ribbon-eyebrow">Browse by mood</p>
                        <div class="home-grid-ribbon-links">
                          {moodLinks.map((link) => (
                            <a href={link.href} key={link.href}>{link.label}</a>
                          ))}
                        </div>
                      </div>
                    )}
                  </Fragment>
                );
              })}
            </div>
          ) : (
            <p class="home-empty">
              More guides are brewing. Check back soon or explore the archive below.
            </p>
          )
        ) : (
          <p class="home-empty">
            No posts found yet. Add a Markdown file to <code>content/posts</code> to get started.
          </p>
        )}
      </section>
    </section>

    {totalPages > 1 ? (
      <div class="mx-auto w-full px-4 pb-12 sm:px-6 lg:px-8 xl:px-12 2xl:px-16">
        <Pagination page={1} totalPages={totalPages} baseHref="/page" />
      </div>
    ) : null}
  </div>
</Base>

<style>
  .home-canvas {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    color: var(--ink-body, currentColor);
  }

  .home-callout {
    padding: clamp(1.4rem, 3vw, 1.9rem);
    display: grid;
    gap: 1rem;
    color: var(--ink-body, currentColor);
  }

  .home-callout p {
    margin: 0;
  }

  .home-callout h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    color: var(--ink-strong, currentColor);
  }

  .home-callout-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
    font-size: 0.95rem;
  }

  .home-callout-list li {
    position: relative;
    padding-left: 1.2rem;
  }

  .home-callout-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 65%, var(--ink-body, currentColor) 35%);
  }

  .home-callout a {
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 65%, var(--ink-body, currentColor) 35%);
    text-decoration: none;
  }

  .home-callout a:hover,
  .home-callout a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .home-evergreen {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .home-evergreen > * {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .home-evergreen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-evergreen > * {
      height: 100%;
    }
  }

  .home-feed {
    padding: clamp(1.6rem, 4vw, 2.4rem);
    display: grid;
    gap: clamp(1.2rem, 3.5vw, 2.1rem);
  }

  .home-feed-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .home-feed-title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--ink-strong, currentColor);
  }

  .home-feed-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 68%, var(--ink-body, currentColor) 32%);
    text-decoration: none;
  }

  .home-feed-link:hover,
  .home-feed-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .home-feature {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.1rem);
  }

  .home-feature-card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.5rem, 3.5vw, 2.1rem);
  }

  @media (min-width: 1024px) {
    .home-feature {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .home-feature-card {
      grid-column: span 8;
    }
  }

  @media (min-width: 1280px) {
    .home-feature-card {
      grid-column: span 7;
    }
  }

  .home-feature-eyebrow {
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 82%, white 18%);
    margin: 0;
  }

  .home-feature-title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--ink-strong, currentColor);
  }

  .home-feature-summary {
    margin: 0;
    color: var(--ink-body, currentColor);
  }

  .home-feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--ink-muted, currentColor);
  }

  .home-feature-meta span {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--panel-border-soft);
    padding: 0.35rem 0.85rem;
    background: color-mix(in srgb, var(--panel-surface-soft) 92%, transparent);
  }

  .home-feature-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 66%, var(--ink-body, currentColor) 34%);
    text-decoration: none;
  }

  .home-feature-link:hover,
  .home-feature-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .home-grid {
    gap: clamp(1.5rem, 3vw, 2.35rem);
  }

  .home-grid > * {
    min-width: 0;
  }

  .home-grid .card-panel {
    color: var(--ink-strong, currentColor);
  }

  .home-grid-ribbon {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--panel-muted-surface) 78%, transparent);
    border: 1px solid color-mix(in srgb, var(--ambient-color, var(--color-primary)) 25%, transparent);
  }

  .home-grid-ribbon-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 72%, var(--ink-body, currentColor) 28%);
  }

  .home-grid-ribbon-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .home-grid-ribbon-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 15%, white 85%);
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 65%, var(--ink-body, currentColor) 35%);
    text-decoration: none;
    box-shadow: 0 10px 22px -18px rgba(15, 23, 42, 0.35);
  }

  .home-grid-ribbon-links a:hover,
  .home-grid-ribbon-links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  @media (min-width: 1280px) {
    .home-grid > :not(.home-grid-ribbon):nth-of-type(3n + 2) {
      transform: translateY(1.25rem);
    }
  }

  .home-empty {
    margin: 0;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 85%, white 15%);
  }

  .home-empty code {
    padding: 0.2rem 0.45rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--panel-surface-soft) 88%, transparent);
  }
</style>
