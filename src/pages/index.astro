---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import { loadAllPosts, filterPostsByCategory, POST_CATEGORY_RITUAL, POST_CATEGORY_MEANDERING } from "@/utils/posts";
import { postsToCardData } from "@/utils/postTransforms";
import { readSettings } from "@/utils/settings";
import { createCollectionPageSchema } from "@/utils/structuredData";
import type { CardPost } from "@/types/post";

const title = "WitchClick — Cozy secular rituals for everyday magic";

const allPosts = loadAllPosts();
const settings = readSettings();

// Filter for ritual posts only (default category for existing posts)
const ritualPosts = filterPostsByCategory(allPosts, POST_CATEGORY_RITUAL);
const hasPublishedMeanderings = filterPostsByCategory(allPosts, POST_CATEGORY_MEANDERING).length > 0;

// Transform to card data
const cardPosts: CardPost[] = postsToCardData(ritualPosts);

// Show featured post at the top
const featuredPost = cardPosts[0] ?? null;

// Show recent posts (12 total, excluding the featured one)
const recentPosts = cardPosts.slice(1, 13);
const bentoFeaturedPost = recentPosts[0] ?? null;
const bentoSidePosts = recentPosts.slice(1, 4);
const remainingRecentPosts = recentPosts.slice(4);

// Create schema for the post collection
const collectionSchema = featuredPost ? createCollectionPageSchema(
  settings,
  {
    name: "Recent Rituals & Essays",
    url: "/",
    description: "Gentle rituals, cozy tools, and reflections for when life feels loud.",
    itemType: "Article",
  },
  [featuredPost, ...recentPosts].map((post) => ({
    name: post.title,
    url: `/post/${post.slug}`,
    description: post.tldr ?? post.excerpt,
    image: post.heroImage,
  })),
) : null;
---
<Base {title}>
  {collectionSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />
    </HeadSlot>
  )}

  <div class="mx-auto w-full max-w-6xl px-4">
    <header data-reveal class="mb-[var(--page-header-gap)] pt-3 pb-6 text-center sm:pt-4 sm:pb-8">
      <div class="mx-auto max-w-[var(--content-max-width)]">
        <h1 class="mb-2 font-serif text-3xl font-bold tracking-tight text-body-strong sm:text-4xl">WitchClick</h1>
        <p class="mb-3 text-lg font-medium text-brand-accent sm:text-xl">
          Gentle rituals, cozy tools, and reflections for when life feels loud.
        </p>
        <p class="text-sm text-body">
          Small practices for shadow work, rest, and everyday magic—designed with neurodivergent brains in mind.
        </p>
      </div>
    </header>

    {featuredPost && (
      <article data-reveal class="mx-auto mb-[var(--page-header-gap)] w-full max-w-4xl">
        <a
          href={`/post/${featuredPost.slug}`}
          class="group block overflow-hidden rounded-2xl border border-line-neutral bg-surface-base shadow-lg transition-all hover:shadow-xl hover:-translate-y-0.5 lg:grid lg:grid-cols-2 lg:gap-0"
        >
          {(featuredPost.heroImage || featuredPost.heroImageSrc) && (
            <div class="overflow-hidden bg-surface-soft aspect-[3/2] lg:aspect-auto">
              <img
                src={featuredPost.heroImageSrc || featuredPost.heroImage}
                alt={featuredPost.heroAlt || featuredPost.heroImageAlt || `Hero image for ${featuredPost.title}`}
                class="h-full w-full object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
                loading="eager"
                decoding="async"
              />
            </div>
          )}
          <div class="p-6 sm:p-8 lg:p-10 lg:flex lg:flex-col lg:justify-center">
            <span class="mb-3 inline-block rounded-full bg-accent-soft/30 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-accent">
              Latest
            </span>
            <h2 class="mb-3 font-serif text-2xl font-bold text-body-strong sm:text-3xl">{featuredPost.title}</h2>
            <p class="mb-5 text-base leading-relaxed text-body opacity-95">{featuredPost.tldr || featuredPost.excerpt}</p>
            <div class="flex flex-wrap items-center gap-3">
              {featuredPost.tags.slice(0, 3).map((tag) => (
                <span class="rounded-full bg-surface-soft px-3 py-1 text-xs text-body-muted">{tag}</span>
              ))}
              <span class="text-xs text-body-subtle opacity-70">{featuredPost.readingMinutes} min read</span>
            </div>
          </div>
        </a>
      </article>
    )}

    {recentPosts.length > 0 && (
      <section data-reveal class="mb-[var(--page-section-gap)]" aria-labelledby="recent-posts-heading">
        <div class="mx-auto w-full max-w-4xl border-t border-line-neutral/60 pt-5 sm:pt-6">
          <div class="flex items-center justify-between mb-5 sm:mb-6">
            <h2 id="recent-posts-heading" class="font-serif text-2xl font-semibold text-body-strong sm:text-3xl">Recent Posts</h2>
            <a href="/page/1" class="text-sm font-medium text-brand-accent transition-colors hover:text-brand-accent hover:underline">View all →</a>
          </div>
        </div>
        {bentoFeaturedPost && (
          <div data-reveal class="home-bento">
            <div class="home-bento__item home-bento__item--feature">
              <PostCard
                layout="bento-featured"
                href={`/post/${bentoFeaturedPost.slug}`}
                post={{
                  slug: bentoFeaturedPost.slug,
                  title: bentoFeaturedPost.title,
                  excerpt: bentoFeaturedPost.excerpt,
                  tldr: bentoFeaturedPost.tldr,
                  tags: bentoFeaturedPost.tags,
                  readingMinutes: bentoFeaturedPost.readingMinutes,
                  publishedAt: bentoFeaturedPost.publishedAt,
                  spoonLevel: bentoFeaturedPost.spoonLevel,
                  spoons: bentoFeaturedPost.spoons,
                  heroImage: bentoFeaturedPost.heroImage,
                  heroImageSrc: bentoFeaturedPost.heroImageSrc,
                  heroImageAlt: bentoFeaturedPost.heroImageAlt,
                  heroAlt: bentoFeaturedPost.heroAlt,
                  category: bentoFeaturedPost.category,
                }}
              />
            </div>
            {bentoSidePosts.map((post, index) => (
              <div class:list={["home-bento__item", `home-bento__item--side-${index + 1}`]}>
                <PostCard
                  layout="bento-compact"
                  href={`/post/${post.slug}`}
                  post={{
                    slug: post.slug,
                    title: post.title,
                    excerpt: post.excerpt,
                    tldr: post.tldr,
                    tags: post.tags,
                    readingMinutes: post.readingMinutes,
                    publishedAt: post.publishedAt,
                    spoonLevel: post.spoonLevel,
                    spoons: post.spoons,
                    heroImage: post.heroImage,
                    heroImageSrc: post.heroImageSrc,
                    heroImageAlt: post.heroImageAlt,
                    heroAlt: post.heroAlt,
                    category: post.category,
                  }}
                />
              </div>
            ))}
          </div>
        )}

        {remainingRecentPosts.length > 0 && (
          <div data-reveal class="home-recent-grid">
            {remainingRecentPosts.map((post) => (
              <PostCard
                href={`/post/${post.slug}`}
                post={{
                  slug: post.slug,
                  title: post.title,
                  excerpt: post.excerpt,
                  tldr: post.tldr,
                  tags: post.tags,
                  readingMinutes: post.readingMinutes,
                  publishedAt: post.publishedAt,
                  spoonLevel: post.spoonLevel,
                  spoons: post.spoons,
                  heroImage: post.heroImage,
                  heroImageSrc: post.heroImageSrc,
                  heroImageAlt: post.heroImageAlt,
                  heroAlt: post.heroAlt,
                  category: post.category,
                }}
              />
            ))}
          </div>
        )}
      </section>
    )}
  </div>

  <aside data-reveal class="my-[var(--page-section-gap)]">
    <Card class="max-w-lg mx-auto text-center" padding="lg">
      <h3 class="mb-2 font-serif text-xl font-semibold text-body-strong sm:text-2xl">Looking for more?</h3>
      <p class="mb-6 text-base text-body-muted">
        Explore printable tools, browse by topic, check out non-magickal rambles, or reach out if you need something specific.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        {hasPublishedMeanderings && <Button href="/meanderings" variant="secondary" size="sm">Meanderings</Button>}
        <Button href="/tools" variant="secondary" size="sm">Printable Tools</Button>
        <Button href="/entities" variant="secondary" size="sm">Browse Topics</Button>
        <Button href="/contact" variant="secondary" size="sm">Get in Touch</Button>
      </div>
    </Card>
  </aside>
</Base>

<style>
  .home-bento {
    display: grid;
    gap: var(--grid-gap);
    grid-template-areas:
      "feature"
      "side-1"
      "side-2"
      "side-3";
  }

  .home-bento__item--feature {
    grid-area: feature;
  }

  .home-bento__item--side-1 {
    grid-area: side-1;
  }

  .home-bento__item--side-2 {
    grid-area: side-2;
  }

  .home-bento__item--side-3 {
    grid-area: side-3;
  }

  .home-bento :global(.ritual-card) {
    height: 100%;
  }

  .home-recent-grid {
    display: grid;
    gap: var(--grid-gap);
    margin-top: var(--page-header-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  @media (min-width: 960px) {
    .home-bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas:
        "feature feature side-1"
        "feature feature side-2"
        "feature feature side-3";
    }
  }
</style>
