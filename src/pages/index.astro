---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import { loadAllPosts, filterPostsByCategory, POST_CATEGORY_RITUAL } from "@/utils/posts";
import { postsToCardData } from "@/utils/postTransforms";
import { readSettings } from "@/utils/settings";
import { createCollectionPageSchema } from "@/utils/structuredData";
import type { CardPost } from "@/types/post";

const title = "WitchClick — Cozy secular rituals for everyday magic";

const allPosts = loadAllPosts();
const settings = readSettings();

// Filter for ritual posts only (default category for existing posts)
const ritualPosts = filterPostsByCategory(allPosts, POST_CATEGORY_RITUAL);

// Transform to card data
const cardPosts: CardPost[] = postsToCardData(ritualPosts);

// Show featured post at the top
const featuredPost = cardPosts[0] ?? null;

// Show recent posts (12 total, excluding the featured one)
const recentPosts = cardPosts.slice(1, 13);

// Create schema for the post collection
const collectionSchema = featuredPost ? createCollectionPageSchema(
  settings,
  {
    name: "Recent Rituals & Essays",
    url: "/",
    description: "Gentle rituals, cozy tools, and reflections for when life feels loud.",
    itemType: "Article",
  },
  [featuredPost, ...recentPosts].map((post) => ({
    name: post.title,
    url: `/post/${post.slug}`,
    description: post.tldr ?? post.excerpt,
    image: post.heroImage,
  })),
) : null;
---
<Base {title}>
  {collectionSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    </HeadSlot>
  )}

  <header class="blog-header">
    <div class="blog-header__content">
      <h1 class="blog-header__title">WitchClick</h1>
      <p class="blog-header__tagline">
        Gentle rituals, cozy tools, and reflections for when life feels loud.
      </p>
      <p class="blog-header__description">
        Small practices for shadow work, rest, and everyday magic—designed with neurodivergent brains in mind.
      </p>
    </div>
  </header>

  {featuredPost && (
    <article class="featured-post">
      <a href={`/post/${featuredPost.slug}`} class="featured-post__link">
        {(featuredPost.heroImage || featuredPost.heroImageSrc) && (
          <div class="featured-post__image-wrapper">
            <img
              src={featuredPost.heroImageSrc || featuredPost.heroImage}
              alt={featuredPost.heroAlt || featuredPost.heroImageAlt || `Hero image for ${featuredPost.title}`}
              class="featured-post__image"
              loading="eager"
              decoding="async"
            />
          </div>
        )}
        <div class="featured-post__content">
          <span class="featured-post__label">Latest</span>
          <h2 class="featured-post__title">{featuredPost.title}</h2>
          <p class="featured-post__excerpt">{featuredPost.tldr || featuredPost.excerpt}</p>
          <div class="featured-post__meta">
            {featuredPost.tags.slice(0, 3).map((tag) => (
              <span class="featured-post__tag">{tag}</span>
            ))}
            <span class="featured-post__read-time">{featuredPost.readingMinutes} min read</span>
          </div>
        </div>
      </a>
    </article>
  )}

  {recentPosts.length > 0 && (
    <section class="posts-section" aria-labelledby="recent-posts-heading">
      <div class="posts-section__header">
        <h2 id="recent-posts-heading" class="posts-section__title">Recent Posts</h2>
        <a href="/page/1" class="posts-section__view-all">View all →</a>
      </div>
      <div class="posts-grid">
        {recentPosts.map((post) => (
          <PostCard
            href={`/post/${post.slug}`}
            post={{
              slug: post.slug,
              title: post.title,
              excerpt: post.excerpt,
              tldr: post.tldr,
              tags: post.tags,
              readingMinutes: post.readingMinutes,
              publishedAt: post.publishedAt,
              spoonLevel: post.spoonLevel,
              spoons: post.spoons,
              heroImage: post.heroImage,
              heroImageSrc: post.heroImageSrc,
              heroImageAlt: post.heroImageAlt,
              heroAlt: post.heroAlt,
              category: post.category,
            }}
          />
        ))}
      </div>
    </section>
  )}

  <aside class="sidebar-cta">
    <div class="sidebar-cta__content">
      <h3 class="sidebar-cta__title">Looking for more?</h3>
      <p class="sidebar-cta__text">
        Explore printable tools, browse by topic, check out non-magickal rambles, or reach out if you need something specific.
      </p>
      <div class="sidebar-cta__links">
        <a href="/meanderings" class="sidebar-cta__link">Meanderings</a>
        <a href="/tools" class="sidebar-cta__link">Printable Tools</a>
        <a href="/entities" class="sidebar-cta__link">Browse Topics</a>
        <a href="/contact" class="sidebar-cta__link">Get in Touch</a>
      </div>
    </div>
  </aside>
</Base>

<style>
  /* Reduce top spacing from layout container */
  :global(.site-main__content) {
    margin-top: calc(-1 * clamp(1.5rem, 4vw, 2.5rem));
  }

  /* Blog Header */
  .blog-header {
    padding: clamp(0.75rem, 2vw, 1.25rem) 0 clamp(1rem, 3vw, 1.5rem);
    text-align: center;
  }

  .blog-header__content {
    max-width: 42rem;
    margin: 0 auto;
  }

  .blog-header__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-strong);
  }

  .blog-header__tagline {
    margin: 0 0 0.75rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.5;
    color: var(--text-accent);
  }

  .blog-header__description {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-body);
    opacity: 0.85;
  }

  /* Featured Post */
  .featured-post {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }

  .featured-post__link {
    display: block;
    border-radius: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--border-purple-medium, rgba(124, 78, 176, 0.3)) 90%, transparent 10%);
    background:
      linear-gradient(135deg, color-mix(in srgb, hsl(var(--surface-panel-primary)) 85%, transparent 15%) 0%, transparent 60%),
      hsl(var(--surface-panel-primary));
    box-shadow: var(--elevation-tier-2);
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 200ms ease;
    overflow: hidden;
  }

  .featured-post__link:hover,
  .featured-post__link:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--elevation-tier-3);
  }

  .featured-post__image-wrapper {
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: color-mix(in srgb, hsl(var(--surface-panel-primary)) 90%, transparent 10%);
  }

  .featured-post__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .featured-post__link:hover .featured-post__image,
  .featured-post__link:focus-visible .featured-post__image {
    transform: scale(1.03);
  }

  .featured-post__content {
    max-width: 48rem;
    padding: clamp(2rem, 5vw, 3rem);
  }

  .featured-post__label {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-accent);
    background: color-mix(in srgb, var(--accent-purple-soft) 20%, transparent 80%);
    border-radius: 999px;
  }

  .featured-post__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.3;
    color: var(--text-strong);
  }

  .featured-post__excerpt {
    margin: 0 0 1.25rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-body);
    opacity: 0.95;
  }

  .featured-post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .featured-post__tag {
    font-size: 0.85rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-purple-soft) 15%, transparent 85%);
    color: var(--text-accent);
  }

  .featured-post__read-time {
    font-size: 0.85rem;
    color: var(--text-body);
    opacity: 0.7;
  }

  /* Posts Section */
  .posts-section {
    margin: clamp(3rem, 6vw, 5rem) 0;
  }

  .posts-section__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .posts-section__title {
    margin: 0;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--text-strong);
  }

  .posts-section__view-all {
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-accent);
    transition: color 150ms ease;
  }

  .posts-section__view-all:hover,
  .posts-section__view-all:focus-visible {
    color: var(--text-strong);
    text-decoration: underline;
  }

  .posts-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }

  /* Sidebar CTA */
  .sidebar-cta {
    margin: clamp(3rem, 6vw, 5rem) 0;
    padding: clamp(2rem, 5vw, 2.5rem);
    border-radius: clamp(1.2rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--border-accent-medium, rgba(212, 175, 55, 0.3)) 85%, transparent 15%);
    background: color-mix(in srgb, var(--surface-card) 95%, transparent 5%);
    box-shadow: var(--elevation-tier-1);
  }

  .sidebar-cta__content {
    max-width: 32rem;
    margin: 0 auto;
    text-align: center;
  }

  .sidebar-cta__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--text-strong);
  }

  .sidebar-cta__text {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-body);
    opacity: 0.9;
  }

  .sidebar-cta__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .sidebar-cta__link {
    display: inline-block;
    padding: 0.65rem 1.35rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-strong);
    background: color-mix(in srgb, var(--surface-card-hover) 90%, transparent 10%);
    border: 1px solid color-mix(in srgb, var(--border-accent-medium) 70%, transparent 30%);
    border-radius: 999px;
    transition: all 150ms ease;
  }

  .sidebar-cta__link:hover,
  .sidebar-cta__link:focus-visible {
    background: var(--surface-card-hover);
    border-color: var(--border-accent-hover);
    transform: translateY(-1px);
  }

  /* Responsive adjustments */
  @media (min-width: 720px) {
    .posts-grid {
      grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    }

    .featured-post__link {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .featured-post__image-wrapper {
      aspect-ratio: auto;
      height: 100%;
    }

    .featured-post__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .featured-post__link {
      grid-template-columns: 5fr 7fr;
    }
  }

  /* Dawn theme adjustments */
  :root[data-comfort-theme="dawn"] .featured-post__link {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface-panel-primary) 95%, white 5%) 0%, transparent 60%),
      var(--surface-panel-primary);
  }

  :root[data-comfort-theme="dawn"] .sidebar-cta {
    background: color-mix(in srgb, var(--surface-card) 98%, white 2%);
  }
</style>
