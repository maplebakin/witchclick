---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import { loadAllPosts, filterPostsByCategory, POST_CATEGORY_RITUAL } from "@/utils/posts";
import { postsToCardData } from "@/utils/postTransforms";
import { readSettings } from "@/utils/settings";
import { createCollectionPageSchema } from "@/utils/structuredData";
import type { CardPost } from "@/types/post";

const title = "WitchClick — Cozy secular rituals for everyday magic";

const allPosts = loadAllPosts();
const settings = readSettings();

// Filter for ritual posts only (default category for existing posts)
const ritualPosts = filterPostsByCategory(allPosts, POST_CATEGORY_RITUAL);

// Transform to card data
const cardPosts: CardPost[] = postsToCardData(ritualPosts);

// Show featured post at the top
const featuredPost = cardPosts[0] ?? null;

// Show recent posts (12 total, excluding the featured one)
const recentPosts = cardPosts.slice(1, 13);

// Create schema for the post collection
const collectionSchema = featuredPost ? createCollectionPageSchema(
  settings,
  {
    name: "Recent Rituals & Essays",
    url: "/",
    description: "Gentle rituals, cozy tools, and reflections for when life feels loud.",
    itemType: "Article",
  },
  [featuredPost, ...recentPosts].map((post) => ({
    name: post.title,
    url: `/post/${post.slug}`,
    description: post.tldr ?? post.excerpt,
    image: post.heroImage,
  })),
) : null;
---
<Base {title}>
  {collectionSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />
    </HeadSlot>
  )}

  <header class="py-4 text-center">
    <div class="max-w-2xl mx-auto">
      <h1 class="mb-2 font-serif text-3xl font-bold tracking-tight text-neutral-800 sm:text-4xl">WitchClick</h1>
      <p class="mb-3 text-lg text-brand-accent sm:text-xl">
        Gentle rituals, cozy tools, and reflections for when life feels loud.
      </p>
      <p class="text-sm text-neutral-600 opacity-85">
        Small practices for shadow work, rest, and everyday magic—designed with neurodivergent brains in mind.
      </p>
    </div>
  </header>

  {featuredPost && (
    <article class="my-10 sm:my-16">
      <a
        href={`/post/${featuredPost.slug}`}
        class="block overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-lg transition-all hover:shadow-xl hover:-translate-y-0.5 lg:grid lg:grid-cols-2 lg:gap-0"
      >
        {(featuredPost.heroImage || featuredPost.heroImageSrc) && (
          <div class="overflow-hidden bg-neutral-100 aspect-[3/2] lg:aspect-auto">
            <img
              src={featuredPost.heroImageSrc || featuredPost.heroImage}
              alt={featuredPost.heroAlt || featuredPost.heroImageAlt || `Hero image for ${featuredPost.title}`}
              class="h-full w-full object-cover transition-transform duration-300 ease-in-out group-hover:scale-105"
              loading="eager"
              decoding="async"
            />
          </div>
        )}
        <div class="p-6 sm:p-8 lg:p-10 lg:flex lg:flex-col lg:justify-center">
          <span class="mb-3 inline-block rounded-full bg-accent-soft/30 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-accent">
            Latest
          </span>
          <h2 class="mb-3 font-serif text-2xl font-bold text-neutral-800 sm:text-3xl">{featuredPost.title}</h2>
          <p class="mb-5 text-base leading-relaxed text-neutral-700 opacity-95">{featuredPost.tldr || featuredPost.excerpt}</p>
          <div class="flex flex-wrap items-center gap-3">
            {featuredPost.tags.slice(0, 3).map((tag) => (
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-600">{tag}</span>
            ))}
            <span class="text-xs text-neutral-500 opacity-70">{featuredPost.readingMinutes} min read</span>
          </div>
        </div>
      </a>
    </article>
  )}

  {recentPosts.length > 0 && (
    <section class="my-12 sm:my-20" aria-labelledby="recent-posts-heading">
      <div class="flex items-center justify-between mb-6 sm:mb-8">
        <h2 id="recent-posts-heading" class="font-serif text-2xl font-semibold text-neutral-800 sm:text-3xl">Recent Posts</h2>
        <a href="/page/1" class="text-sm font-medium text-brand-accent transition-colors hover:text-brand-primary hover:underline">View all →</a>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:gap-8">
        {recentPosts.map((post) => (
          <PostCard
            href={`/post/${post.slug}`}
            post={{
              slug: post.slug,
              title: post.title,
              excerpt: post.excerpt,
              tldr: post.tldr,
              tags: post.tags,
              readingMinutes: post.readingMinutes,
              publishedAt: post.publishedAt,
              spoonLevel: post.spoonLevel,
              spoons: post.spoons,
              heroImage: post.heroImage,
              heroImageSrc: post.heroImageSrc,
              heroImageAlt: post.heroImageAlt,
              heroAlt: post.heroAlt,
              category: post.category,
            }}
          />
        ))}
      </div>
    </section>
  )}

  <aside class="my-12 sm:my-20">
    <Card class="max-w-lg mx-auto text-center" padding="lg">
      <h3 class="mb-2 font-serif text-xl font-semibold text-neutral-800 sm:text-2xl">Looking for more?</h3>
      <p class="mb-6 text-base text-neutral-600">
        Explore printable tools, browse by topic, check out non-magickal rambles, or reach out if you need something specific.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <Button href="/meanderings" variant="secondary" size="sm">Meanderings</Button>
        <Button href="/tools" variant="secondary" size="sm">Printable Tools</Button>
        <Button href="/entities" variant="secondary" size="sm">Browse Topics</Button>
        <Button href="/contact" variant="secondary" size="sm">Get in Touch</Button>
      </div>
    </Card>
  </aside>
</Base>

