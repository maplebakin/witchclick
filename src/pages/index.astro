---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import { serializeJsonForScript } from "@/utils/serializeJson";
import SpoonsBadge from "@/components/SpoonsBadge.astro";
import Button from "@/components/ui/Button.astro";
import { loadAllPosts, filterPostsByCategory, POST_CATEGORY_RITUAL } from "@/utils/posts";
import { postsToCardData } from "@/utils/postTransforms";
import { readSettings } from "@/utils/settings";
import { createCollectionPageSchema } from "@/utils/structuredData";
import type { CardPost } from "@/types/post";

const title = "WitchClick — A living grimoire for symbolic self-work";

const allPosts = loadAllPosts();
const settings = readSettings();

// Filter for ritual posts only (default category for existing posts)
const ritualPosts = filterPostsByCategory(allPosts, POST_CATEGORY_RITUAL);

const pillarCards = [
  {
    label: "Clean Cursing",
    href: "/curses",
    eyebrow: "Boundaries",
    description: "Truth-centered curse alternatives for boundaries, accountability, energetic return, and clean refusal.",
    action: "Enter the pillar",
  },
  {
    label: "Rituals & Spreads",
    href: "/hub",
    eyebrow: "Practice",
    description: "Tarot spreads, grounding rituals, and symbolic workings for turning feeling into form.",
    action: "Choose a working",
  },
  {
    label: "Grimoire",
    href: "/entities",
    eyebrow: "Reference",
    description: "Tarot, herbs, crystals, planets, rituals, and spreads gathered as secular symbolic reference.",
    action: "Open the index",
  },
  {
    label: "Field Notes",
    href: "/meanderings",
    eyebrow: "Essays",
    description: "Reflective notes on grief, attention, refusal, creativity, and strange ways of making meaning.",
    action: "Read notes",
  },
];

const stateCards = [
  {
    label: "Ground",
    href: "/hub/calm",
    need: "I need somewhere steady to land.",
    description: "Grounding rituals and quiet anchors for returning to the body.",
  },
  {
    label: "Focus",
    href: "/hub/focus",
    need: "I need to choose where attention goes.",
    description: "Attention rituals, tarot spreads, and small structures that do not turn you into a machine.",
  },
  {
    label: "Release",
    href: "/hub/release",
    need: "I need to stop carrying this.",
    description: "Threshold rituals and clean cursing practices for giving the weight a shape.",
  },
];

const approachNotes = [
  "Rituals are structures for attention, not supernatural guarantees.",
  "Tarot is treated as pattern language: cards ask questions, they do not issue verdicts.",
  "Clean cursing means symbolic refusal, ethical return, and emotional precision.",
];

// Transform to card data
const cardPosts: CardPost[] = postsToCardData(ritualPosts);

// Most recent post as section hero, then supporting grid posts
const latestPost = cardPosts[0] ?? null;
const latestPostHasImage = Boolean(latestPost && (latestPost.heroImageSrc || latestPost.heroImage));
const gridPosts = cardPosts.slice(1, 7);
const hasMorePosts = cardPosts.length > 7;

// Create schema for the visible post collection without making the homepage only a feed.
const collectionSchema = latestPost ? createCollectionPageSchema(
  settings,
  {
    name: "WitchClick Symbolic Practice Space",
    url: "/",
    description: "A living grimoire for clean curses, tarot spreads, rituals, grimoire references, and reflective field notes.",
    itemType: "Article",
  },
  [latestPost, ...gridPosts].map((post) => ({
    name: post.title,
    url: `/post/${post.slug}`,
    description: post.tldr ?? post.excerpt,
    image: post.heroImage,
  })),
) : null;
---
<Base {title}>
  {collectionSchema && (
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={serializeJsonForScript(collectionSchema)} />
    </HeadSlot>
  )}

  <div class="home-shell">
    <header data-reveal class="home-masthead">
      <div class="home-masthead__inner">
        <p class="home-masthead__eyebrow">Secular mystical publishing hub</p>
        <h1 class="home-masthead__title">WitchClick is a living grimoire for symbolic self-work.</h1>
        <p class="home-masthead__tagline">
          Clean curses, tarot spreads, rituals, and reference notes for turning feeling into form.
        </p>
        <p class="home-masthead__subline">
          Come here to mark a threshold, name a boundary, pull a card, look up a symbol, or find words for what your nervous
          system already knows.
        </p>
        <div class="home-masthead__actions" aria-label="Primary homepage actions">
          <Button href="/start" size="lg">Start here</Button>
          <Button href="/curses" variant="secondary" size="lg">Enter Clean Cursing</Button>
        </div>
      </div>
    </header>

    <section data-reveal class="home-section home-doorways" aria-labelledby="home-pillars-heading">
      <div class="home-section__header">
        <p class="home-section__eyebrow">Main shelves</p>
        <h2 id="home-pillars-heading" class="home-section__title">What can you do here?</h2>
        <p class="home-section__lead">
          WitchClick is organized around a few kinds of symbolic work: boundary, practice, reference, and reflection.
        </p>
      </div>
      <div class="home-doorway-grid">
        {pillarCards.map((card) => (
          <a class="home-doorway-card home-doorway-card--pillar focus-ring" href={card.href}>
            <span class="home-doorway-card__eyebrow">{card.eyebrow}</span>
            <span class="home-doorway-card__label">{card.label}</span>
            <span class="home-doorway-card__description">{card.description}</span>
            <span class="home-doorway-card__action">{card.action} &rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <section data-reveal class="home-section home-states" aria-labelledby="home-states-heading">
      <div class="home-section__header home-section__header--compact">
        <p class="home-section__eyebrow">Start by need</p>
        <h2 id="home-states-heading" class="home-section__title">If you are arriving with a feeling, start there.</h2>
      </div>
      <div class="home-state-grid">
        {stateCards.map((card) => (
          <a class="home-state-card focus-ring" href={card.href}>
            <span class="home-state-card__need">{card.need}</span>
            <span class="home-state-card__label">{card.label}</span>
            <span class="home-state-card__description">{card.description}</span>
          </a>
        ))}
      </div>
    </section>

    <section data-reveal class="home-section home-approach" aria-labelledby="home-approach-heading">
      <div class="home-section__header">
        <p class="home-section__eyebrow">How the magic works here</p>
        <h2 id="home-approach-heading" class="home-section__title">Symbolic, secular, and still strange.</h2>
        <p class="home-section__lead">
          WitchClick uses ritual, tarot, and grimoire language as reflective craft. The point is not prediction or control.
          The point is giving inner weather a form you can work with.
        </p>
      </div>
      <ul class="home-approach__list">
        {approachNotes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </section>

    {latestPost && (
      <section data-reveal class="home-section home-featured" aria-labelledby="home-featured-heading">
        <div class="home-posts__header">
          <div>
            <p class="home-section__eyebrow">Featured practice</p>
            <h2 id="home-featured-heading" class="home-section__title">A recent working from the grimoire</h2>
          </div>
          <a href="/hub" class="home-text-link">Browse rituals & spreads &rarr;</a>
        </div>

        <article class="home-posts__hero">
          <a href={`/post/${latestPost.slug}`} class="group block focus-ring">
            {latestPostHasImage && (
              <img
                src={latestPost.heroImageSrc || latestPost.heroImage}
                alt={latestPost.heroAlt || latestPost.heroImageAlt || `Hero image for ${latestPost.title}`}
                class="home-posts__hero-image"
                loading="eager"
                decoding="async"
                onerror="this.style.display='none'"
              />
            )}
            <div class:list={["home-posts__hero-content", !latestPostHasImage && "home-posts__hero-content--text-only"]}>
              <h3 class:list={["home-posts__hero-title", !latestPostHasImage && "home-posts__hero-title--text-only"]}>{latestPost.title}</h3>
              <p class="home-posts__hero-description">{latestPost.tldr || latestPost.excerpt}</p>
              <div class="home-posts__hero-tags">
                {latestPost.tags.slice(0, 3).map((tag) => (
                  <span class="home-posts__tag">#{String(tag).toLowerCase()}</span>
                ))}
              </div>
              <div class="home-posts__hero-meta">
                <span class="home-posts__reading-time">{latestPost.readingMinutes} min read</span>
                <span class="home-posts__spoons">
                  <SpoonsBadge level={latestPost.spoonLevel || latestPost.spoons} />
                </span>
              </div>
            </div>
          </a>
        </article>
      </section>
    )}

    {gridPosts.length > 0 && (
      <section data-reveal class="home-section home-recent" aria-labelledby="home-recent-heading">
        <div class="home-posts__header">
          <div>
            <p class="home-section__eyebrow">Recent updates</p>
            <h2 id="home-recent-heading" class="home-section__title">Fresh pages on the table</h2>
          </div>
          {hasMorePosts && (
            <a href="/hub" class="home-text-link">
              See rituals & spreads &rarr;
            </a>
          )}
        </div>
        <div class="home-recent-grid">
          {gridPosts.map((post) => (
            <PostCard
              href={`/post/${post.slug}`}
              post={{
                slug: post.slug,
                title: post.title,
                excerpt: post.excerpt,
                tldr: post.tldr,
                tags: post.tags,
                readingMinutes: post.readingMinutes,
                publishedAt: post.publishedAt,
                spoonLevel: post.spoonLevel,
                spoons: post.spoons,
                heroImage: post.heroImage,
                heroImageSrc: post.heroImageSrc,
                heroImageAlt: post.heroImageAlt,
                heroAlt: post.heroAlt,
                category: post.category,
              }}
            />
          ))}
        </div>
      </section>
    )}

    <aside data-reveal class="home-orientation" aria-labelledby="home-orientation-heading">
      <div>
        <p class="home-section__eyebrow">Need more context?</p>
        <h2 id="home-orientation-heading" class="home-orientation__title">Learn the shape of the space.</h2>
      </div>
      <nav class="home-orientation__links" aria-label="Homepage orientation links">
        <a class="home-text-link" href="/start">Start</a>
        <a class="home-text-link" href="/search">Search</a>
        <a class="home-text-link" href="/about">About</a>
        <a class="home-text-link" href="/tags">Topics</a>
      </nav>
    </aside>
  </div>
</Base>

<style>
  .home-shell {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
  }

  .home-masthead {
    position: relative;
    padding: clamp(2rem, 5vw, 3.75rem);
    border: 1px solid color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 22%, var(--theme-border-subtle, var(--border-subtle)) 78%);
    border-radius: clamp(1.15rem, 3vw, 1.75rem);
    background:
      radial-gradient(90% 70% at 50% 0%, color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 12%, transparent 88%), transparent 72%),
      linear-gradient(160deg, color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 88%, transparent 12%), color-mix(in srgb, var(--theme-surface-base, var(--surface-base)) 96%, transparent 4%));
    box-shadow: var(--elevation-tier-2, 0 18px 44px rgba(0, 0, 0, 0.08));
    text-align: center;
    overflow: hidden;
  }

  .home-masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent, color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 16%, transparent 84%), transparent) top / 100% 1px no-repeat,
      linear-gradient(90deg, transparent, color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 10%, transparent 90%), transparent) bottom / 100% 1px no-repeat;
  }

  .home-masthead__inner {
    position: relative;
    z-index: 1;
    margin-inline: auto;
    max-width: 56rem;
  }

  .home-masthead__eyebrow,
  .home-section__eyebrow,
  .home-doorway-card__eyebrow {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 82%, var(--theme-text-muted, var(--text-muted)) 18%);
  }

  .home-masthead__title {
    margin: 0.45rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .home-masthead__tagline {
    margin: 0.85rem auto 0;
    max-width: 38ch;
    font-size: clamp(1.22rem, 2.3vw, 1.55rem);
    line-height: 1.42;
    font-weight: 600;
    color: var(--theme-text-body, var(--text-body));
  }

  .home-masthead__subline {
    margin: 1rem auto 0;
    max-width: 62ch;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .home-masthead__actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .home-masthead__actions :global(a),
  .home-masthead__actions :global(button) {
    min-height: 44px;
    padding: 0.7rem 1.05rem;
    border-radius: var(--radius-2, 0.75rem);
    line-height: 1.15;
  }

  .home-masthead__actions :global(a:first-child),
  .home-masthead__actions :global(button:first-child) {
    box-shadow: 0 12px 28px -22px var(--theme-text-accent-strong, var(--text-accent));
  }

  .home-section {
    margin-block: var(--page-section-gap);
  }

  .home-section__header {
    display: grid;
    gap: 0.45rem;
    max-width: 44rem;
    margin-bottom: 1.2rem;
  }

  .home-section__header--compact {
    max-width: 40rem;
  }

  .home-section__title,
  .home-orientation__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    line-height: 1.14;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .home-section__lead {
    margin: 0;
    max-width: 62ch;
    color: var(--theme-text-muted, var(--text-muted));
    line-height: 1.65;
  }

  .home-doorway-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .home-doorway-card,
  .home-state-card {
    position: relative;
    display: grid;
    gap: 0.55rem;
    min-height: 100%;
    padding: 1rem;
    border: 1px solid var(--theme-border-subtle, var(--line-subtle));
    border-radius: var(--radius-3, 1rem);
    background: color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 82%, transparent 18%);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--elevation-tier-1, 0 8px 20px rgba(0, 0, 0, 0.05));
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    overflow: hidden;
  }

  .home-doorway-card--pillar::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 48%, transparent 52%), transparent 42%) left top / 3px 100% no-repeat,
      radial-gradient(120% 75% at 12% 0%, color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 10%, transparent 90%), transparent 64%);
    opacity: 0.8;
  }

  .home-doorway-card > *,
  .home-state-card > * {
    position: relative;
    z-index: 1;
  }

  .home-doorway-card:hover,
  .home-doorway-card:focus-visible,
  .home-state-card:hover,
  .home-state-card:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 38%, var(--theme-border-subtle, var(--line-subtle)) 62%);
    box-shadow: var(--elevation-tier-2, 0 14px 32px rgba(0, 0, 0, 0.08));
  }

  .home-doorway-card__label,
  .home-state-card__label {
    font-size: 1.1rem;
    font-weight: 750;
    line-height: 1.2;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .home-doorway-card__description,
  .home-state-card__description {
    color: var(--theme-text-muted, var(--text-muted));
    line-height: 1.58;
    font-size: 0.94rem;
  }

  .home-doorway-card__action {
    margin-top: 0.25rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--theme-text-accent-strong, var(--text-accent));
  }

  .home-state-grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-state-card {
    background: color-mix(in srgb, var(--theme-surface-base, var(--surface-base)) 88%, var(--theme-text-accent, var(--text-accent)) 4%);
  }

  .home-state-card__need {
    font-size: 0.86rem;
    font-weight: 650;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .home-approach {
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    border-top: 1px solid var(--theme-border-subtle, var(--line-subtle));
    border-bottom: 1px solid var(--theme-border-subtle, var(--line-subtle));
  }

  .home-approach__list {
    list-style: none;
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0 0;
    padding: 0;
  }

  .home-approach__list li {
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 44%, transparent 56%);
    color: var(--theme-text-body, var(--text-body));
    line-height: 1.6;
  }

  .home-posts__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .home-text-link {
    color: var(--theme-text-accent-strong, var(--text-accent));
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .home-text-link:hover,
  .home-text-link:focus-visible {
    text-decoration: underline;
  }

  .home-posts__hero > a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--theme-border-subtle, var(--line-subtle));
    border-radius: var(--radius-3, 1rem);
    background: var(--theme-surface-panel, var(--surface-panel));
    text-decoration: none;
    box-shadow: var(--elevation-tier-1, 0 8px 20px rgba(0, 0, 0, 0.05));
  }

  .home-posts__hero-image {
    width: 100%;
    height: clamp(11rem, 32vw, 17.5rem);
    max-height: 280px;
    object-fit: cover;
    background: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 14%, transparent 86%);
  }

  .home-posts__hero-content {
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .home-posts__hero-content--text-only {
    padding-block: clamp(1.5rem, 4vw, 2.3rem);
  }

  .home-posts__hero-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    line-height: 1.17;
    font-weight: 700;
    color: var(--theme-text-strong, var(--text-strong));
    transition: color var(--dur-med, 200ms) var(--ease-out-curve, ease);
  }

  .home-posts__hero-title--text-only {
    font-size: clamp(1.9rem, 4vw, 2.65rem);
  }

  .group:hover .home-posts__hero-title,
  .group:focus-visible .home-posts__hero-title {
    color: var(--theme-text-accent-strong, var(--text-accent));
  }

  .home-posts__hero-description {
    margin: 0.85rem 0 0;
    max-width: 70ch;
    font-size: 1rem;
    line-height: 1.62;
    color: var(--theme-text-muted, var(--text-muted));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-posts__hero-tags {
    margin-top: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .home-posts__tag {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-2, 0.75rem);
    border: 1px solid color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 22%, transparent 78%);
    background: color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 78%, transparent 22%);
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    line-height: 1.2;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .home-posts__hero-meta {
    margin-top: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 1.4rem;
  }

  .home-posts__reading-time {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--theme-text-muted, var(--text-muted)) 88%, transparent 12%);
  }

  .home-posts__spoons {
    transform: scale(0.9);
    transform-origin: left center;
    color: color-mix(in srgb, var(--theme-text-muted, var(--text-muted)) 92%, transparent 8%);
  }

  .home-recent-grid {
    display: grid;
    gap: var(--grid-gap);
    margin-top: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .home-orientation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block: var(--page-section-gap);
    padding-block: 1.2rem;
    border-top: 1px solid var(--theme-border-subtle, var(--line-subtle));
    border-bottom: 1px solid var(--theme-border-subtle, var(--line-subtle));
  }

  .home-orientation__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem 1rem;
  }

  @media (max-width: 820px) {
    .home-state-grid {
      grid-template-columns: 1fr;
    }

    .home-posts__header,
    .home-orientation {
      align-items: flex-start;
      flex-direction: column;
    }

    .home-orientation__links {
      justify-content: flex-start;
    }
  }

  @media (max-width: 719px) {
    .home-masthead {
      text-align: left;
    }

    .home-masthead__actions {
      align-items: stretch;
      justify-content: flex-start;
      gap: 0.6rem;
    }

    .home-masthead__actions :global(a),
