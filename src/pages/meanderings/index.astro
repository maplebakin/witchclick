---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import PrimaryButton from "@/components/buttons/PrimaryButton.astro";
import { loadAllPosts, filterPostsByCategory, POST_CATEGORY_MEANDERING } from "@/utils/posts";
import { postsToCardData } from "@/utils/postTransforms";
import type { CardPost } from "@/types/post";

const allPosts = loadAllPosts();

// Filter for meandering posts only
const meanderingPosts = filterPostsByCategory(allPosts, POST_CATEGORY_MEANDERING);

// Transform to card data
const cardPosts: CardPost[] = postsToCardData(meanderingPosts);

const featuredPost = cardPosts[0] ?? null;
const recentPosts = cardPosts.slice(1);
---

<Base title="Non-Magickal Meanderings — WitchClick">
  <header class="page-header">
    <p class="page-header__eyebrow">Non-magickal corner</p>
    <h1 class="page-header__title">Non-Magickal Meanderings</h1>
    <p class="page-header__lead">
      A soft landing for the parts of my brain that aren't strictly witchy. Life updates, half-baked theories, and whatever
      I'm currently fixated on.
    </p>
  </header>

  {featuredPost && (
    <article class="featured-post">
      <a href={`/post/${featuredPost.slug}`} class="featured-post__link">
        <div class="featured-post__content">
          <span class="featured-post__label">Latest Meandering</span>
          <h2 class="featured-post__title">{featuredPost.title}</h2>
          <p class="featured-post__excerpt">{featuredPost.tldr || featuredPost.excerpt}</p>
          <div class="featured-post__meta">
            {featuredPost.tags.slice(0, 3).map((tag) => (
              <span class="featured-post__tag">{tag}</span>
            ))}
            <span class="featured-post__read-time">{featuredPost.readingMinutes} min read</span>
          </div>
        </div>
      </a>
    </article>
  )}

  {!featuredPost && (
    <div class="no-posts">
      <p class="no-posts__text">
        No meanderings yet. Check back soon for non-magickal rambles and reflections.
      </p>
    </div>
  )}

  {recentPosts.length > 0 && (
    <section class="posts-section" aria-labelledby="recent-posts-heading">
      <div class="posts-section__header">
        <h2 id="recent-posts-heading" class="posts-section__title">All Meanderings</h2>
      </div>
      <div class="posts-grid">
        {recentPosts.map((post) => (
          <PostCard
            href={`/post/${post.slug}`}
            post={{
              slug: post.slug,
              title: post.title,
              excerpt: post.excerpt,
              tldr: post.tldr,
              tags: post.tags,
              readingMinutes: post.readingMinutes,
              publishedAt: post.publishedAt,
              spoonLevel: post.spoonLevel,
              spoons: post.spoons,
              heroImage: post.heroImage,
              heroImageSrc: post.heroImageSrc,
              heroImageAlt: post.heroImageAlt,
              heroAlt: post.heroAlt,
              category: post.category,
            }}
          />
        ))}
      </div>
    </section>
  )}

  <section class="meanderings-signup" aria-labelledby="meanderings-signup-heading">
    <div class="meanderings-signup__content">
      <h3 id="meanderings-signup-heading" class="meanderings-signup__title">Get the next meandering</h3>
      <p class="meanderings-signup__text">
        If you want a gentle ping when a new non-magickal post goes live, leave your email below.
        You can also subscribe by RSS.
      </p>
      <form class="meanderings-signup__form" name="meanderings-updates" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="meanderings-updates" />
        <div class="meanderings-signup__fields">
          <input
            type="email"
            name="email"
            inputmode="email"
            autocomplete="email"
            placeholder="you@example.com"
            class="meanderings-signup__input"
          />
          <PrimaryButton type="submit">Notify me</PrimaryButton>
        </div>
      </form>
      <div class="meanderings-signup__links">
        <a href="/rss.xml">RSS feed</a>
        <a href="/feed.json">JSON feed</a>
      </div>
    </div>
  </section>

  <aside class="sidebar-cta">
    <div class="sidebar-cta__content">
      <h3 class="sidebar-cta__title">Looking for rituals?</h3>
      <p class="sidebar-cta__text">
        If you're here for the magickal content, head back to the main page for rituals, spellwork, and cozy tools.
      </p>
      <div class="sidebar-cta__links">
        <a href="/" class="sidebar-cta__link">Browse Rituals</a>
        <a href="/tools" class="sidebar-cta__link">Printable Tools</a>
        <a href="/entities" class="sidebar-cta__link">Browse Topics</a>
      </div>
    </div>
  </aside>
</Base>

<style>
  .page-header {
    padding: clamp(2.5rem, 6vw, 4rem) 0 var(--page-header-gap);
    text-align: center;
    margin: 0 auto;
  }

  /* Featured Post */
  .featured-post {
    margin: var(--page-header-gap) 0;
  }

  .featured-post__link {
    display: block;
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--theme-color-gold, #d4af37) 32%, var(--theme-color-iris, #4b2a63) 22%);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--theme-surface-panel-primary) 85%, transparent 15%) 0%, transparent 60%),
      var(--surface-panel-primary);
    box-shadow: var(--elevation-tier-2);
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .featured-post__link:hover,
  .featured-post__link:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--elevation-tier-3);
  }

  .featured-post__content {
    max-width: var(--content-max-width);
  }

  .featured-post__label {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-text-accent);
    background: color-mix(in srgb, var(--accent-purple-soft) 20%, transparent 80%);
    border-radius: 999px;
  }

  .featured-post__title {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.3;
    color: var(--theme-text-strong);
  }

  .featured-post__excerpt {
    margin: 0 0 1.25rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--theme-text-body);
    opacity: 0.95;
  }

  .featured-post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .featured-post__tag {
    font-size: 0.85rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-purple-soft) 15%, transparent 85%);
    color: var(--theme-text-accent);
  }

  .featured-post__read-time {
    font-size: 0.85rem;
    color: var(--theme-text-body);
    opacity: 0.7;
  }

  /* No Posts */
  .no-posts {
    margin: var(--page-section-gap) 0;
    padding: clamp(2rem, 5vw, 3rem);
    text-align: center;
    border-radius: clamp(1.2rem, 3vw, 2rem);
    background: var(--surface-panel-primary);
    border: 1px solid var(--border-subtle);
  }

  .no-posts__text {
    margin: 0;
    font-size: 1.05rem;
    color: var(--theme-text-body);
    opacity: 0.85;
  }

  /* Posts Section */
  .posts-section {
    margin: var(--page-section-gap) 0;
  }

  .posts-section__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--page-header-gap);
  }

  .posts-section__title {
    margin: 0;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--theme-text-strong);
  }

  .posts-grid {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }

  /* Meanderings Signup */
  .meanderings-signup {
    margin: var(--page-section-gap) 0;
  }

  .meanderings-signup__content {
    border-radius: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--theme-color-gold, #d4af37) 25%, transparent 75%);
    background: linear-gradient(135deg, color-mix(in srgb, var(--theme-surface-panel-primary) 90%, transparent 10%) 0%, var(--surface-panel-primary) 100%);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: 1rem;
  }

  .meanderings-signup__title {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    color: var(--theme-text-strong);
  }

  .meanderings-signup__text {
    margin: 0;
    font-size: 1rem;
    color: var(--theme-text-body);
    opacity: 0.9;
  }

  .meanderings-signup__form {
    display: grid;
    gap: 0.75rem;
  }

  .meanderings-signup__fields {
    display: grid;
    gap: 0.75rem;
  }

  .meanderings-signup__input {
    width: 100%;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-color-gold, #d4af37) 35%, transparent 65%);
    background: var(--cozy-input-bg, rgba(255, 250, 245, 0.85));
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    color: var(--theme-text-strong);
  }

  .meanderings-signup__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .meanderings-signup__links a {
    color: var(--theme-text-accent);
    text-decoration: none;
  }

  .meanderings-signup__links a:hover,
  .meanderings-signup__links a:focus-visible {
    color: var(--theme-text-strong);
  }

  @media (min-width: 640px) {
    .meanderings-signup__fields {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  /* Responsive adjustments */
  @media (min-width: 720px) {
    .posts-grid {
      grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Sidebar CTA */
  .sidebar-cta {
    margin: var(--page-section-gap) 0;
    padding: clamp(2rem, 5vw, 2.5rem);
    border-radius: clamp(1.2rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--theme-border-accent-medium, rgba(212, 175, 55, 0.3)) 85%, transparent 15%);
    background: color-mix(in srgb, var(--theme-surface-card) 95%, transparent 5%);
    box-shadow: var(--elevation-tier-1);
  }

  .sidebar-cta__content {
    max-width: 32rem;
    margin: 0 auto;
    text-align: center;
  }

  .sidebar-cta__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--theme-text-strong);
  }

  .sidebar-cta__text {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--theme-text-body);
    opacity: 0.9;
  }

  .sidebar-cta__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .sidebar-cta__link {
    display: inline-block;
    padding: 0.65rem 1.35rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--theme-text-strong);
    background: color-mix(in srgb, var(--surface-card-hover) 90%, transparent 10%);
    border: 1px solid color-mix(in srgb, var(--theme-border-accent-medium) 70%, transparent 30%);
    border-radius: 999px;
    transition: all 150ms ease;
  }

  .sidebar-cta__link:hover,
  .sidebar-cta__link:focus-visible {
    background: var(--surface-card-hover);
    border-color: var(--theme-border-accent-hover);
    transform: translateY(-1px);
  }

  /* Dawn theme adjustments */
  :root[data-comfort-theme="dawn"] .featured-post__link {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface-panel-primary) 95%, white 5%) 0%, transparent 60%),
      var(--surface-panel-primary);
  }

  :root[data-comfort-theme="dawn"] .sidebar-cta {
    background: color-mix(in srgb, var(--theme-surface-card) 98%, white 2%);
  }
</style>
