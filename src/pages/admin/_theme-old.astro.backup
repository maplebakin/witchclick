---
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";


const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/theme" });

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const categoryOptions = [
  { value: "custom", label: "Custom" },
  { value: "seasonal", label: "Seasonal" },
  { value: "minimal", label: "Minimal" },
  { value: "vibrant", label: "Vibrant" },
  { value: "default", label: "Default" },
];

const fontOptions = [
  "Literata",
  "EB Garamond",
  "Playfair Display",
  "Fraunces",
  "Cormorant Garamond",
  "Parisienne",
  "Dancing Script",
  "Great Vibes",
  "Sacramento",
];
---

<Base
  title="WitchClick — Theme Editor"
  description="Create, edit, and manage theme presets with live preview"
  canon={canonical}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6" id="themeEditorRoot">
      <AdminNav currentPath="/admin/theme" />

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
        <!-- Sidebar: Theme Library -->
        <section class="lg:col-span-4 space-y-6">
          <div class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
            <header class="mb-5">
              <h1 class="text-xl font-semibold text-primary">Theme Library</h1>
              <p class="mt-1 text-sm text-body-muted">
                Create, manage, and activate theme presets
              </p>
            </header>

            <!-- Active Themes Display -->
            <dl class="space-y-2 text-sm mb-5 p-3 rounded-lg bg-surface-soft border border-line-subtle">
              <div class="flex items-center justify-between gap-3">
                <dt class="text-body-muted">Active midnight</dt>
                <dd class="font-medium text-primary" data-active="midnight">—</dd>
              </div>
              <div class="flex items-center justify-between gap-3">
                <dt class="text-body-muted">Active dawn</dt>
                <dd class="font-medium text-primary" data-active="dawn">—</dd>
              </div>
            </dl>

            <!-- Category Filter -->
            <div class="mb-5">
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Filter by category</span>
                <select id="categoryFilter" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2 text-sm">
                  <option value="">All categories</option>
                  {categoryOptions.map((cat) => (
                    <option value={cat.value}>{cat.label}</option>
                  ))}
                </select>
              </label>
            </div>

            <!-- Theme Lists -->
            <div class="space-y-5">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <h2 class="text-[13px] font-semibold uppercase tracking-wide text-body-muted">Midnight themes</h2>
                  <button
                    type="button"
                    class="rounded-lg border border-line-neutral px-3 py-1 text-xs font-medium hover:bg-surface-soft transition"
                    data-new-theme="midnight"
                  >
                    + New
                  </button>
                </div>
                <div class="space-y-2 max-h-64 overflow-y-auto" data-theme-list="midnight"></div>
              </div>

              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <h2 class="text-[13px] font-semibold uppercase tracking-wide text-body-muted">Dawn themes</h2>
                  <button
                    type="button"
                    class="rounded-lg border border-line-neutral px-3 py-1 text-xs font-medium hover:bg-surface-soft transition"
                    data-new-theme="dawn"
                  >
                    + New
                  </button>
                </div>
                <div class="space-y-2 max-h-64 overflow-y-auto" data-theme-list="dawn"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- Main Editor -->
        <section class="lg:col-span-8 space-y-6">
          <div class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
            <header class="mb-5">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div>
                  <h2 class="text-lg font-semibold text-primary">Theme Editor</h2>
                  <p class="mt-1 text-xs text-body-muted" data-breadcrumbs>Theme</p>
                </div>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    id="undoBtn"
                    class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium hover:bg-surface-soft transition disabled:opacity-50 disabled:cursor-not-allowed"
                    title="Undo (Ctrl+Z)"
                  >
                    ↶ Undo
                  </button>
                  <button
                    type="button"
                    id="redoBtn"
                    class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium hover:bg-surface-soft transition disabled:opacity-50 disabled:cursor-not-allowed"
                    title="Redo (Ctrl+Y)"
                  >
                    ↷ Redo
                  </button>
                </div>
              </div>
            </header>

            <!-- Basic Info -->
            <div class="grid gap-3 md:grid-cols-2 mb-5">
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Comfort mode</span>
                <select id="themeMode" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                  <option value="midnight">Midnight (dark)</option>
                  <option value="dawn">Dawn (light)</option>
                </select>
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Theme name *</span>
                <input
                  id="themeName"
                  type="text"
                  class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2"
                  placeholder="Cozy Midnight"
                />
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Slug *</span>
                <input
                  id="themeSlug"
                  type="text"
                  class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2"
                  placeholder="cozy-midnight"
                />
                <p class="mt-1 text-xs text-body-muted">Auto-generated from name if left blank</p>
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Category</span>
                <select id="themeCategory" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                  {categoryOptions.map((cat) => (
                    <option value={cat.value} selected={cat.value === 'custom'}>
                      {cat.label}
                    </option>
                  ))}
                </select>
              </label>
            </div>

            <!-- Main Colors -->
            <div class="rounded-lg border border-line-subtle bg-surface-soft/50 p-4 mb-5">
              <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-body-muted">Main colors</h3>
              <div class="grid gap-3 md:grid-cols-2">
                <label class="block text-sm">
                  <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Primary</span>
                  <div class="mt-1 flex items-center gap-2">
                    <input type="color" data-color-picker="primary" class="h-9 w-12 rounded border border-line-neutral cursor-pointer" />
                    <input
                      data-color-input="primary"
                      type="text"
                      class="flex-1 rounded-lg border border-line-neutral px-3 py-2 font-mono text-sm"
                      placeholder="#6b21a8"
                    />
                  </div>
                </label>
                <label class="block text-sm">
                  <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Accent</span>
                  <div class="mt-1 flex items-center gap-2">
                    <input type="color" data-color-picker="accent" class="h-9 w-12 rounded border border-line-neutral cursor-pointer" />
                    <input
                      data-color-input="accent"
                      type="text"
                      class="flex-1 rounded-lg border border-line-neutral px-3 py-2 font-mono text-sm"
                      placeholder="#d9b2c4"
                    />
                  </div>
                </label>
                <label class="block text-sm md:col-span-2">
                  <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Background</span>
                  <div class="mt-1 flex items-center gap-2">
                    <input type="color" data-color-picker="background" class="h-9 w-12 rounded border border-line-neutral cursor-pointer" />
                    <input
                      data-color-input="background"
                      type="text"
                      class="flex-1 rounded-lg border border-line-neutral px-3 py-2 font-mono text-sm"
                      placeholder="#0f0820"
                    />
                  </div>
                </label>
              </div>
            </div>

            <!-- Text Colors -->
            <div class="rounded-lg border border-line-subtle bg-surface-soft/50 p-4 mb-5">
              <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-body-muted">Text colors</h3>
              <div class="grid gap-3 md:grid-cols-2">
                <label class="block text-sm">
                  <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Primary text</span>
                  <div class="mt-1 flex items-center gap-2">
                    <input type="color" data-color-picker="textPrimary" class="h-9 w-12 rounded border border-line-neutral cursor-pointer" />
                    <input
                      data-color-input="textPrimary"
                      type="text"
                      class="flex-1 rounded-lg border border-line-neutral px-3 py-2 font-mono text-sm"
                      placeholder="#fdfcfe"
                    />
                  </div>
                </label>
                <label class="block text-sm">
                  <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Heading text</span>
                  <div class="mt-1 flex items-center gap-2">
                    <input type="color" data-color-picker="textHeading" class="h-9 w-12 rounded border border-line-neutral cursor-pointer" />
                    <input
                      data-color-input="textHeading"
                      type="text"
                      class="flex-1 rounded-lg border border-line-neutral px-3 py-2 font-mono text-sm"
                      placeholder="#ffffff"
                    />
                  </div>
                </label>
                <label class="block text-sm md:col-span-2">
                  <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Muted text</span>
                  <div class="mt-1 flex items-center gap-2">
                    <input type="color" data-color-picker="textMuted" class="h-9 w-12 rounded border border-line-neutral cursor-pointer" />
                    <input
                      data-color-input="textMuted"
                      type="text"
                      class="flex-1 rounded-lg border border-line-neutral px-3 py-2 font-mono text-sm"
                      placeholder="#d9b2c4"
                    />
                  </div>
                </label>
              </div>
            </div>

            <!-- Typography -->
            <div class="rounded-lg border border-line-subtle bg-surface-soft/50 p-4 mb-5">
              <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-body-muted">Typography</h3>
              <div class="grid gap-3 md:grid-cols-2">
                <label class="block text-sm">
                  <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Serif font</span>
                  <select id="themeFontSerif" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                    {fontOptions.map((font) => (
                      <option value={font}>{font}</option>
                    ))}
                  </select>
                </label>
                <label class="block text-sm">
                  <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Script font</span>
                  <select id="themeFontScript" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                    {fontOptions.map((font) => (
                      <option value={font}>{font}</option>
                    ))}
                  </select>
                </label>
              </div>
            </div>

            <!-- Contrast Checker -->
            <div class="rounded-lg border border-line-subtle bg-surface-soft/50 p-4 mb-5" data-contrast-display>
              <!-- Populated by JS -->
            </div>

            <!-- Live Preview -->
            <div class="rounded-2xl border-2 border-dashed border-line-neutral bg-surface-soft/60 p-6 mb-5" data-theme-preview>
              <div class="mb-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-body-muted">Live Preview</p>
              </div>

              <article class="rounded-xl border p-5 shadow-sm space-y-4" style="background: var(--preview-surface); border-color: var(--preview-border);">
                <p class="text-xs font-semibold uppercase tracking-wide" style="color: var(--preview-muted);">
                  Preview Card
                </p>
                <h3 class="text-2xl font-semibold" style="color: var(--preview-text-heading);">
                  Soft rituals for tired hearts
                </h3>
                <p class="text-sm leading-relaxed" style="color: var(--preview-text);">
                  This preview shows how your theme colors and fonts work together. Adjust the values above to see changes instantly.
                </p>
                <div class="flex flex-wrap gap-2">
                  <button type="button" class="px-4 py-2 rounded-full text-sm font-semibold transition" style="background: var(--preview-primary); color: white;">
                    Primary Button
                  </button>
                  <button type="button" class="px-4 py-2 rounded-full text-sm font-semibold border transition" style="border-color: var(--preview-border); color: var(--preview-text);">
                    Secondary Button
                  </button>
                </div>
              </article>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                id="saveThemeBtn"
                class="rounded-lg bg-success px-4 py-2 text-sm font-medium text-white hover:bg-success-strong transition"
                title="Save (Ctrl+S)"
              >
                💾 Save Theme
              </button>
              <button
                type="button"
                id="setActiveThemeBtn"
                class="rounded-lg bg-info px-4 py-2 text-sm font-medium text-white hover:bg-info-strong transition"
              >
                ⭐ Set as Active
              </button>
              <button
                type="button"
                id="duplicateThemeBtn"
                class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft transition"
              >
                📋 Duplicate
              </button>
              <button
                type="button"
                id="deleteThemeBtn"
                class="rounded-lg border border-danger px-4 py-2 text-sm font-medium text-danger hover:bg-danger hover:text-white transition"
              >
                🗑️ Delete
              </button>
              <div class="flex-grow"></div>
              <button
                type="button"
                id="exportBtn"
                class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft transition"
              >
                ⬇️ Export
              </button>
              <button
                type="button"
                id="exportAllBtn"
                class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft transition"
              >
                ⬇️ Export All
              </button>
              <button
                type="button"
                id="importBtn"
                class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft transition"
              >
                ⬆️ Import
              </button>
              <input type="file" id="importInput" accept=".json" class="hidden" />
            </div>

            <p class="text-sm mt-3" data-status></p>

            <div class="mt-5 p-4 rounded-lg bg-surface-soft border border-line-subtle text-xs text-body-muted space-y-2">
              <p><strong>💡 Keyboard shortcuts:</strong></p>
              <ul class="list-disc list-inside space-y-1 ml-2">
                <li><kbd class="px-1 py-0.5 bg-surface-base border border-line-neutral rounded">Ctrl+S</kbd> — Save theme</li>
                <li><kbd class="px-1 py-0.5 bg-surface-base border border-line-neutral rounded">Ctrl+Z</kbd> — Undo</li>
                <li><kbd class="px-1 py-0.5 bg-surface-base border border-line-neutral rounded">Ctrl+Y</kbd> — Redo</li>
              </ul>
            </div>
          </div>
        </section>
      </div>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">This dashboard is only available in development mode or with a valid admin key.</p>
    </section>
  )}

  {canUse && (
    <script>
      import '@/lib/theme-editor';
    </script>
  )}

  <style>
    [data-theme-preview] {
      --preview-primary: #6b21a8;
      --preview-accent: #d9b2c4;
      --preview-background: #0f0820;
      --preview-surface: #1a0d2e;
      --preview-border: #2e1b4a;
      --preview-text: #fdfcfe;
      --preview-text-heading: #ffffff;
      --preview-muted: #d9b2c4;
      transition: all 0.3s ease;
    }

    kbd {
      font-family: ui-monospace, monospace;
      font-size: 0.75rem;
    }
  </style>
</Base>
