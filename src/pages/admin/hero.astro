---
import Base from "../../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";

export const prerender = false;

const settings = readSettings();
const site = getSiteOrigin(settings) || "https://example.com";

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get("key") === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || "http://localhost:8787";
---
<Base
  title="WitchClick — Hero Image Uploader"
  description="Upload, attach, and publish hero images for posts."
  canon={`${site}/admin/hero`}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <section
      id="heroUploader"
      class="mx-auto max-w-4xl space-y-6 rounded-2xl border border-line-neutral bg-surface-base p-6 shadow-sm"
      data-dev-api={DEV_API}
      data-site-origin={site}
    >
      <header class="space-y-2">
        <h1 class="text-2xl font-semibold text-body-strong">Admin → Hero Image Uploader</h1>
        <p class="text-sm text-body-muted">
          Choose a post, drop in artwork (PNG, JPG, or WEBP up to 5&nbsp;MB), add alt text, and the uploader will
          store the file under <code class="rounded bg-surface-neutral-tint px-1 py-0.5 text-[11px]">/public/images/hero/&lt;slug&gt;</code>
          before wiring the frontmatter.
        </p>
      </header>

      <ol class="space-y-6">
        <li class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-surface-soft text-sm font-semibold text-secondary">
              1
            </span>
            <div class="flex-1 space-y-3">
              <div class="space-y-1">
                <h2 class="text-base font-semibold text-body-strong">Step 1 — Select a post</h2>
                <p class="text-sm text-body-subtle">
                  Choose an existing post that should receive a fresh hero image.
                </p>
              </div>
              <label class="block">
                <span class="text-xs font-medium uppercase tracking-wide text-body-subtle">Post</span>
                <select
                  class="mt-1 w-full rounded-lg border border-line-neutral-strong bg-surface-base px-3 py-2 text-sm focus:border-line-bold focus:outline-none"
                  data-post-select
                  disabled
                >
                  <option>Loading posts…</option>
                </select>
              </label>
            </div>
          </div>
        </li>

        <li class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-surface-soft text-sm font-semibold text-secondary">
              2
            </span>
            <div class="flex-1 space-y-3">
              <div class="space-y-1">
                <h2 class="text-base font-semibold text-body-strong">Step 2 — Load the hero prompt</h2>
                <p class="text-sm text-body-subtle">
                  We pull the saved hero prompt (or fallback alt text) so you can paste it into your image model.
                </p>
              </div>
              <div
                class="rounded-xl border border-line-subtle bg-surface-muted p-4 text-sm text-primary"
                data-hero-prompt-card
              >
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-medium">Hero prompt helper</span>
                  <button
                    class="rounded-md bg-surface-accent-strong px-3 py-1 text-xs font-medium text-inverse transition hover:bg-surface-accent-bolder disabled:cursor-not-allowed disabled:opacity-60"
                    data-copy-prompt
                    disabled
                  >
                    Copy prompt
                  </button>
                </div>
                <p class="mt-2 text-xs" data-hero-prompt-hint>
                  Select a post to load the saved hero image prompt (or alt text fallback) for your LLM.
                </p>
                <textarea
                  class="mt-3 hidden h-28 w-full resize-y rounded-md border border-line-muted bg-surface-base px-3 py-2 text-sm text-body focus:border-line-bold focus:outline-none"
                  readonly
                  data-hero-prompt
                ></textarea>
              </div>
            </div>
          </div>
        </li>

        <li class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-surface-soft text-sm font-semibold text-secondary">
              3
            </span>
            <div class="flex-1 space-y-4">
              <div class="space-y-1">
                <h2 class="text-base font-semibold text-body-strong">Step 3 — Upload hero artwork</h2>
                <p class="text-sm text-body-subtle">
                  With the prompt in hand, render a new hero image and import it from your device.
                </p>
              </div>
              <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
                <div class="relative">
                  <div
                    class="relative flex h-full flex-col items-center justify-center rounded-xl border-2 border-dashed border-line-neutral-strong bg-surface-neutral-soft px-6 py-10 text-center transition"
                    data-drop-zone
                  >
                    <input
                      type="file"
                      accept="image/png,image/jpeg,image/jpg,image/webp"
                      class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
                      data-file-input
                      aria-label="Upload hero image"
                      disabled
                    />
                    <div
                      class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-xl bg-surface-base/80 text-sm font-semibold text-secondary"
                      data-drop-overlay
                    >
                      Select a post above to unlock uploads.
                    </div>
                    <div class="space-y-2">
                      <p class="text-sm font-medium text-body">Drag &amp; drop hero artwork, or click to browse</p>
                      <p class="text-xs text-body-subtle" data-drop-hint>
                        Once a post is selected, you can upload PNG, JPG, or WEBP files up to 5&nbsp;MB.
                      </p>
                      <p class="text-xs text-body-muted" data-file-info></p>
                    </div>
                  </div>
                </div>
                <figure class="space-y-3">
                  <div class="relative overflow-hidden rounded-xl border border-line-neutral bg-surface-base shadow-sm">
                    <div
                      class="flex aspect-[3/2] items-center justify-center text-sm font-medium text-body-faint"
                      data-preview-placeholder
                    >
                      Your preview will appear here once you choose an image.
                    </div>
                    <img
                      data-preview
                      alt="Selected hero preview"
                      class="hidden h-full w-full object-cover"
                    />
                  </div>
                  <figcaption class="text-xs text-body-subtle" data-existing-hero>
                    Select a post to review its current hero details.
                  </figcaption>
                </figure>
              </div>
              <label class="block">
                <span class="text-xs font-medium uppercase tracking-wide text-body-subtle">Alt text</span>
                <input
                  type="text"
                  placeholder="Cozy cauldron simmering beside tarot cards on a window seat"
                  class="mt-1 w-full rounded-lg border border-line-neutral-strong px-3 py-2 text-sm focus:border-line-bold focus:outline-none disabled:cursor-not-allowed disabled:opacity-60"
                  data-alt-input
                  disabled
                />
                <p class="mt-1 text-xs text-body-faint">
                  Alt text helps screen readers understand the imagery—tweak it after uploading if needed.
                </p>
              </label>
            </div>
          </div>
        </li>

        <li class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-surface-soft text-sm font-semibold text-secondary">
              4
            </span>
            <div class="flex-1 space-y-4">
              <div class="space-y-1">
                <h2 class="text-base font-semibold text-body-strong">Step 4 — Attach and verify</h2>
                <p class="text-sm text-body-subtle">
                  When the preview and alt text look right, attach the hero image to update the post everywhere.
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <button
                  class="rounded-lg bg-surface-accent-bolder px-4 py-2 text-sm font-medium text-inverse transition hover:bg-surface-accent-deep disabled:cursor-not-allowed disabled:opacity-60"
                  data-submit
                  disabled
                >
                  Upload &amp; Attach
                </button>
                <span class="text-sm text-body-subtle" data-status></span>
              </div>
              <div
                class="hidden rounded-lg border border-line-success-soft bg-surface-success-soft px-4 py-3 text-sm text-success-strong"
                data-success
              ></div>
            </div>
          </div>
        </li>
      </ol>
    </section>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">These tools only run in <strong>development</strong> (or with a temporary key when hosted).</p>
      <ol class="mx-auto mt-4 list-decimal space-y-2 text-left text-sm text-body-muted">
        <li>Run <code>npm run dev:all</code> locally to start Astro + the admin API.</li>
        <li>Visit <code>/admin/hero</code> from the local site.</li>
        <li>If you later host with an adapter, set <code>PUBLIC_ADMIN_KEY</code> and append <code>?key=…</code>.</li>
      </ol>
    </section>
  )}

  {canUse && (
    <script is:inline>
      (function () {
        const root = document.getElementById('heroUploader');
        if (!root) return;
        const DEV_API = root.getAttribute('data-dev-api') || 'http://localhost:8787';
        const SITE_ORIGIN = root.getAttribute('data-site-origin') || 'https://example.com';
        const select = root.querySelector('[data-post-select]');
        const dropZone = root.querySelector('[data-drop-zone]');
        const fileInput = root.querySelector('[data-file-input]');
        const fileInfo = root.querySelector('[data-file-info]');
        const dropOverlay = root.querySelector('[data-drop-overlay]');
        const dropHint = root.querySelector('[data-drop-hint]');
        const preview = root.querySelector('[data-preview]');
        const previewPlaceholder = root.querySelector('[data-preview-placeholder]');
        const altInput = root.querySelector('[data-alt-input]');
        const existingHeroNote = root.querySelector('[data-existing-hero]');
        const submitButton = root.querySelector('[data-submit]');
        const statusEl = root.querySelector('[data-status]');
        const successEl = root.querySelector('[data-success]');
        const promptField = root.querySelector('[data-hero-prompt]');
        const promptHint = root.querySelector('[data-hero-prompt-hint]');
        const copyPromptButton = root.querySelector('[data-copy-prompt]');

        let posts = [];
        let selectedFile = null;
        let previewUrl = null;
        let altDirty = false;
        let lastPrefilledSlug = null;
        let isBusy = false;
        let dropEnabled = false;

        const MAX_SIZE = 5 * 1024 * 1024;
        const ACCEPTED_EXT = /\.(png|jpe?g|webp)$/i;

        function showPreviewPlaceholder(show) {
          const shouldShow = !!show;
          if (previewPlaceholder) {
            previewPlaceholder.classList.toggle('hidden', !shouldShow);
          }
          if (preview) {
            preview.classList.toggle('hidden', shouldShow);
          }
        }

        function clearFileSelection(options = {}) {
          selectedFile = null;
          if (fileInfo && !options.keepInfo) {
            fileInfo.textContent = '';
          }
          if (!options.keepPreview) {
            if (preview) {
              preview.removeAttribute('src');
              preview.removeAttribute('srcset');
            }
            showPreviewPlaceholder(true);
          }
          revokePreview();
          if (fileInput && !options.keepInput) {
            try {
              fileInput.value = '';
            } catch (err) {
              /* ignore */
            }
          }
        }

        function toAbsoluteHeroPath(path) {
          const value = String(path || '').trim();
          if (!value) return '';
          if (/^https?:/i.test(value)) return value;
          const site = SITE_ORIGIN.replace(/\/$/, '');
          if (value.startsWith('/')) return `${site}${value}`;
          return `${site}/${value}`;
        }

        function setAltInputDisabled(disabled) {
          if (!altInput) return;
          const on = !!disabled;
          altInput.disabled = on;
          altInput.classList.toggle('cursor-not-allowed', on);
          altInput.classList.toggle('opacity-60', on);
        }

        function refreshAltAvailability() {
          const disabled = isBusy || !(select && select.value);
          setAltInputDisabled(disabled);
        }

        function refreshDropZoneAvailability() {
          const hasPost = !!(select && select.value);
          dropEnabled = hasPost && !isBusy;
          if (fileInput) {
            fileInput.disabled = !dropEnabled;
          }
          if (dropZone) {
            dropZone.classList.toggle('opacity-60', !dropEnabled);
            dropZone.classList.toggle('cursor-not-allowed', !dropEnabled);
            dropZone.setAttribute('aria-disabled', dropEnabled ? 'false' : 'true');
          }
          let overlayMessage = '';
          if (!dropEnabled) {
            overlayMessage = hasPost
              ? 'Working… finish the current upload first.'
              : 'Select a post above to unlock uploads.';
          }
          if (dropOverlay) {
            dropOverlay.textContent = overlayMessage;
            dropOverlay.classList.toggle('hidden', dropEnabled);
          }
          if (dropHint) {
            dropHint.textContent = dropEnabled
              ? 'PNG, JPG, or WEBP up to 5 MB. Drag & drop or click to choose an image.'
              : hasPost
              ? 'Uploads are temporarily disabled while we process your image.'
              : 'Once a post is selected, you can upload PNG, JPG, or WEBP files up to 5 MB.';
          }
        }

        function refreshFormAvailability() {
          refreshDropZoneAvailability();
          refreshAltAvailability();
        }

        function setStatus(message, tone) {
          if (!statusEl) return;
          statusEl.textContent = message || '';
          statusEl.classList.remove('text-body-subtle', 'text-danger', 'text-success', 'text-info');
          if (!message) {
            statusEl.classList.add('text-body-subtle');
            return;
          }
          if (tone === 'error') statusEl.classList.add('text-danger');
          else if (tone === 'success') statusEl.classList.add('text-success');
          else if (tone === 'progress') statusEl.classList.add('text-info');
          else statusEl.classList.add('text-body-subtle');
        }

        function clearSuccess() {
          if (!successEl) return;
          successEl.classList.add('hidden');
          successEl.innerHTML = '';
        }

        function showSuccess(path, slug) {
          if (!successEl) return;
          const safePath = String(path || '');
          const safeSlug = encodeURIComponent(slug || '');
          const href = `${SITE_ORIGIN.replace(/\/$/, '')}/post/${safeSlug}`;
          successEl.innerHTML = `
            <strong class="font-semibold">Success!</strong>
            Hero saved to <code class="rounded bg-surface-success-tint px-1 py-0.5 text-[11px] text-success-deep">${safePath}</code>.
            <a class="ml-1 text-success-deep underline" href="${href}" target="_blank" rel="noopener">View post →</a>
          `;
          successEl.classList.remove('hidden');

          const absolutePath = toAbsoluteHeroPath(safePath);
          if (preview && absolutePath) {
            preview.src = absolutePath;
            showPreviewPlaceholder(false);
          }
          if (fileInfo && safePath) {
            fileInfo.textContent = `Stored at ${safePath}`;
          }
          clearFileSelection({ keepPreview: true, keepInfo: true, keepInput: true });

          const index = posts.findIndex((post) => post.slug === slug);
          if (index >= 0) {
            const updated = { ...posts[index] };
            updated.heroImage = safePath;
            if (altInput) {
              updated.heroAlt = altInput.value ? altInput.value.trim() : '';
            }
            posts[index] = updated;
            updateExistingHeroNote(updated);
          }
          altDirty = false;
          lastPrefilledSlug = slug || null;
        }

        function setPromptHint(message, tone) {
          if (!promptHint) return;
          promptHint.textContent = message || '';
          promptHint.classList.remove('text-primary', 'text-success', 'text-danger');
          if (tone === 'success') promptHint.classList.add('text-success');
          else if (tone === 'error') promptHint.classList.add('text-danger');
          else promptHint.classList.add('text-primary');
        }

        function cleanHeroAlt(value) {
          const text = typeof value === 'string' ? value.trim() : '';
          if (!text) return '';
          return text.replace(/\s*—\s*hero image$/i, '').trim();
        }

        function cleanHeroPrompt(value) {
          const text = typeof value === 'string' ? value.trim() : '';
          return text.replace(/\s*—\s*hero prompt$/i, '').trim();
        }

        function extractHeroDescription(post) {
          if (!post || typeof post !== 'object') return '';
          const prompt = cleanHeroPrompt(post.heroImagePrompt);
          if (prompt) return prompt;
          const heroAlt = cleanHeroAlt(post.heroAlt);
          if (heroAlt) return heroAlt;
          const legacyAlt = cleanHeroAlt(post.heroImageAlt);
          if (legacyAlt) return legacyAlt;
          return '';
        }

        function suggestHeroAlt(post) {
          if (!post || typeof post !== 'object') return '';
          const heroAlt = cleanHeroAlt(post.heroAlt);
          if (heroAlt) return heroAlt;
          const legacyAlt = cleanHeroAlt(post.heroImageAlt);
          if (legacyAlt) return legacyAlt;
          const prompt = extractHeroDescription(post);
          return prompt;
        }

        function applyAltSuggestion(post, options = {}) {
          if (!altInput) return;
          const slug = post?.slug || '';
          const suggestion = suggestHeroAlt(post);
          altInput.placeholder = suggestion
            ? `Try: ${suggestion}`
            : 'Describe the artwork for screen readers';
          const force = options.force === true;
          if (force || !altDirty || slug !== lastPrefilledSlug) {
            altInput.value = suggestion || '';
            altDirty = false;
            lastPrefilledSlug = slug;
          }
        }

        function updateExistingHeroNote(post) {
          if (!existingHeroNote) return;
          existingHeroNote.classList.remove('text-success', 'text-secondary');
          if (!post) {
            existingHeroNote.textContent = 'Select a post to review its current hero details.';
            return;
          }
          if (post.heroImage) {
            existingHeroNote.textContent = `Existing hero image: ${post.heroImage}. Uploading will replace this reference.`;
            existingHeroNote.classList.add('text-secondary');
          } else {
            existingHeroNote.textContent = 'No hero image attached yet. Uploading will add one to the post frontmatter.';
            existingHeroNote.classList.add('text-success');
          }
        }

        function updateHeroPromptUI() {
          if (!promptField || !copyPromptButton) {
            refreshFormAvailability();
            return;
          }
          if (!posts.length) {
            promptField.value = '';
            promptField.classList.add('hidden');
            copyPromptButton.disabled = true;
            setPromptHint('Ingest a post to enable the hero prompt helper.', 'error');
            updateExistingHeroNote(null);
            applyAltSuggestion(null, { force: true });
            clearFileSelection();
            refreshFormAvailability();
            return;
          }
          if (!select || !select.value) {
            promptField.value = '';
            promptField.classList.add('hidden');
            copyPromptButton.disabled = true;
            setPromptHint('Select a post to load the saved hero image prompt (or alt text fallback) for your LLM.', 'neutral');
            updateExistingHeroNote(null);
            applyAltSuggestion(null, { force: true });
            clearFileSelection();
            refreshFormAvailability();
            return;
          }
          const current = posts.find((post) => post.slug === select.value);
          const description = extractHeroDescription(current);
          updateExistingHeroNote(current || null);
          applyAltSuggestion(current || null);
          if (!selectedFile && !previewUrl) {
            const heroPath = current && current.heroImage ? toAbsoluteHeroPath(current.heroImage) : '';
            if (heroPath && preview) {
              preview.src = heroPath;
              preview.alt = current && current.heroAlt ? current.heroAlt : 'Hero image preview';
              showPreviewPlaceholder(false);
              if (fileInfo) {
                fileInfo.textContent = `Current hero: ${current.heroImage}`;
              }
            } else {
              clearFileSelection();
            }
          }
          if (description) {
            promptField.value = description;
            promptField.classList.remove('hidden');
            copyPromptButton.disabled = false;
            setPromptHint('Prompt ready. Copy it into your image model request.', 'success');
          } else {
            promptField.value = '';
            promptField.classList.add('hidden');
            copyPromptButton.disabled = true;
            setPromptHint('No hero prompt or alt text found yet. Add one in the post frontmatter.', 'error');
          }
          refreshFormAvailability();
        }

        function setBusy(on) {
          isBusy = !!on;
          if (submitButton) {
            submitButton.disabled = isBusy;
            submitButton.textContent = isBusy ? 'Uploading…' : 'Upload & Attach';
            submitButton.classList.toggle('opacity-60', isBusy);
          }
          if (select) {
            select.disabled = isBusy || posts.length === 0;
          }
          if (dropZone) {
            dropZone.classList.toggle('opacity-70', isBusy);
          }
          if (copyPromptButton) {
            if (isBusy) copyPromptButton.disabled = true;
            else updateHeroPromptUI();
          }
          refreshFormAvailability();
        }

        function renderOptions() {
          if (!select) return;
          const current = select.value;
          select.innerHTML = '';
          if (!posts.length) {
            const option = document.createElement('option');
            option.textContent = 'No posts available';
            option.disabled = true;
            option.selected = true;
            select.appendChild(option);
            select.disabled = true;
            if (submitButton) submitButton.disabled = true;
            updateHeroPromptUI();
            refreshFormAvailability();
            return;
          }
          const placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.textContent = 'Select a post…';
          placeholder.disabled = true;
          placeholder.selected = !posts.some((p) => p.slug === current);
          select.appendChild(placeholder);
          posts.forEach((post) => {
            const option = document.createElement('option');
            option.value = post.slug;
            option.textContent = post.title ? `${post.title} (${post.slug})` : post.slug;
            if (post.slug === current) option.selected = true;
            select.appendChild(option);
          });
          select.disabled = false;
          if (submitButton) submitButton.disabled = false;
          updateHeroPromptUI();
        }

        function revokePreview() {
          if (previewUrl) {
            try { URL.revokeObjectURL(previewUrl); } catch (err) { console.warn(err); }
            previewUrl = null;
          }
        }

        function useFile(file) {
          clearSuccess();
          if (!fileInfo || !preview) return;
          if (!file) {
            clearFileSelection();
            return;
          }
          if (!dropEnabled) {
            setStatus(
              isBusy
                ? 'Uploads are disabled while we finish the current request.'
                : 'Pick a post first.',
              'error'
            );
            clearFileSelection();
            return;
          }
          if (file.size > MAX_SIZE) {
            setStatus('Image must be 5 MB or smaller.', 'error');
            clearFileSelection();
            return;
          }
          const typeOk = file.type ? file.type.startsWith('image/') : ACCEPTED_EXT.test(file.name);
          const extOk = ACCEPTED_EXT.test(file.name || '');
          if (!typeOk || !extOk) {
            setStatus('Please choose a PNG, JPG, or WEBP image.', 'error');
            clearFileSelection();
            return;
          }
          selectedFile = file;
          revokePreview();
          previewUrl = URL.createObjectURL(file);
          preview.src = previewUrl;
          preview.alt = altInput && altInput.value ? altInput.value : 'Selected hero preview';
          showPreviewPlaceholder(false);
          const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
          fileInfo.textContent = `${file.name} • ${sizeMb} MB`;
          setStatus('Preview ready. Add alt text and click Upload & Attach.', 'progress');
        }

        function syncFileInput(file) {
          if (!fileInput || !file) return;
          if (typeof DataTransfer !== 'undefined') {
            try {
              const dt = new DataTransfer();
              dt.items.add(file);
              fileInput.files = dt.files;
            } catch (err) {
              console.warn(err);
            }
          }
        }

        async function readAsDataURL(file) {
          return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(new Error('Could not read image.'));
            reader.readAsDataURL(file);
          });
        }

        async function postJson(endpoint, payload) {
          const response = await fetch(`${DEV_API}${endpoint}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload || {}),
          });
          let data = null;
          try { data = await response.json(); } catch (err) { /* ignore */ }
          const ok = data && data.ok !== false && response.ok;
          if (!ok) {
            const message = (data && data.error) || `Request failed (${response.status})`;
            throw new Error(message);
          }
          return data;
        }

        async function loadPosts() {
          setStatus('Loading posts…', 'progress');
          try {
            const data = await postJson('/posts/list', {});
            posts = Array.isArray(data.items)
              ? data.items.map((item) => ({
                  slug: item?.slug,
                  title: item?.title,
                  heroImagePrompt: typeof item?.heroImagePrompt === 'string' ? item.heroImagePrompt : '',
                  heroAlt: typeof item?.heroAlt === 'string' ? item.heroAlt : '',
                  heroImageAlt: typeof item?.heroImageAlt === 'string' ? item.heroImageAlt : '',
                  heroImage: typeof item?.heroImage === 'string' ? item.heroImage : '',
                }))
              : [];
            renderOptions();
            if (!posts.length) {
              setStatus('No posts found. Ingest a post before uploading heroes.', 'error');
              setPromptHint('Ingest a post to enable the hero prompt helper.', 'error');
            } else {
              setStatus('Select a post, then choose an image to begin.', '');
              updateHeroPromptUI();
            }
          } catch (err) {
            setStatus(err && err.message ? err.message : 'Could not load posts.', 'error');
            setPromptHint('Could not load posts. Hero prompt helper is unavailable.', 'error');
            clearFileSelection();
            refreshFormAvailability();
          }
        }

        if (select) {
          select.addEventListener('change', () => {
            clearSuccess();
            setStatus('', '');
            altDirty = false;
            clearFileSelection();
            updateHeroPromptUI();
            refreshFormAvailability();
          });
        }

        if (altInput) {
          altInput.addEventListener('input', () => {
            altDirty = true;
            lastPrefilledSlug = select && select.value ? select.value : null;
          });
        }

        if (fileInput) {
          fileInput.addEventListener('change', (event) => {
            const target = event.currentTarget;
            const file = target && target.files ? target.files[0] : null;
            useFile(file || null);
          });
        }

        if (dropZone) {
          ['dragenter', 'dragover'].forEach((evt) => {
            dropZone.addEventListener(evt, (event) => {
              event.preventDefault();
              if (!dropEnabled) return;
              dropZone.classList.add('border-line-bolder', 'bg-surface-muted');
            });
          });
          ['dragleave', 'dragend', 'drop'].forEach((evt) => {
            dropZone.addEventListener(evt, (event) => {
              event.preventDefault();
              dropZone.classList.remove('border-line-bolder', 'bg-surface-muted');
            });
          });
          dropZone.addEventListener('drop', (event) => {
            event.preventDefault();
            if (!dropEnabled) return;
            const dt = event.dataTransfer;
            if (dt && dt.files && dt.files.length) {
              const file = dt.files[0];
              syncFileInput(file);
              useFile(file);
            }
          });
        }

        if (submitButton) {
          submitButton.addEventListener('click', async (event) => {
            event.preventDefault();
            clearSuccess();
            if (!select || !select.value) {
              setStatus('Pick a post first.', 'error');
              return;
            }
            if (!selectedFile) {
              setStatus('Choose an image before uploading.', 'error');
              return;
            }
            const alt = altInput ? altInput.value.trim() : '';
            try {
              setBusy(true);
              setStatus('Uploading image…', 'progress');
              const dataUrl = await readAsDataURL(selectedFile);
              if (typeof dataUrl !== 'string' || !dataUrl.startsWith('data:image/')) {
                throw new Error('Selected file is not a valid image.');
              }
              const upload = await postJson('/upload/hero', {
                slug: select.value,
                filename: selectedFile.name,
                contentBase64: dataUrl,
              });
              setStatus('Attaching hero metadata…', 'progress');
              const attach = await postJson('/posts/attach-hero', {
                slug: select.value,
                heroImage: upload.path,
                heroAlt: alt,
              });
              showSuccess(upload.path, select.value);
              setStatus(`Hero attached. Updated ${attach.path}.`, 'success');
            } catch (err) {
              setStatus(err && err.message ? err.message : 'Upload failed.', 'error');
            } finally {
              setBusy(false);
            }
          });
        }

        if (copyPromptButton && promptField) {
          copyPromptButton.addEventListener('click', async (event) => {
            event.preventDefault();
            const text = promptField.value.trim();
            if (!text) return;
            const original = copyPromptButton.textContent;
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(text);
                copyPromptButton.textContent = 'Copied!';
                setPromptHint('Copied. Paste it straight into your image model prompt.', 'success');
                setTimeout(() => {
                  copyPromptButton.textContent = original;
                  updateHeroPromptUI();
                }, 1600);
              } else {
                throw new Error('Clipboard API not available');
              }
            } catch (error) {
              setPromptHint('Clipboard unavailable. Select the text above and copy manually.', 'error');
              copyPromptButton.textContent = original;
            }
          });
        }

        refreshFormAvailability();
        updateHeroPromptUI();
        loadPosts();
      })();
    </script>
  )}
</Base>
