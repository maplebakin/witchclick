---
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";
import HeroWorkflow from "@/components/admin/HeroWorkflow.astro";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/hero" });

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get("key") === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || "http://localhost:8787";
const DEV_KEY = import.meta.env.PUBLIC_DEV_API_KEY || import.meta.env.PUBLIC_ADMIN_KEY || "";
---
<Base
  title="WitchClick — Hero Image Uploader"
  description="Upload, attach, and publish hero images for posts."
  canon={canonical}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6">
      <AdminNav currentPath="/admin/hero" />

      <section
        class="mx-auto max-w-4xl space-y-6"
        data-dev-api={DEV_API}
        data-dev-key={DEV_KEY}
      >
        <header class="space-y-2 rounded-2xl border border-line-subtle bg-surface-base p-6 shadow-sm">
          <h1 class="text-2xl font-semibold text-body-strong">Hero Image Uploader</h1>
          <p class="text-sm text-body-muted">
            Choose a post, drop in artwork (PNG, JPG, or WEBP), add alt text, and the uploader will
            store the file under <code class="rounded bg-neutral-100 px-1 py-0.5 text-[0.8rem] font-mono">/public/images/hero/&lt;slug&gt;</code>
            before wiring the frontmatter.
          </p>
          <p class="text-[0.8rem] text-body-muted">
            Keep source files under about 3.5&nbsp;MB when possible. The dev API accepts a 5&nbsp;MB JSON body, and base64 upload overhead means larger files may fail before reaching the server.
          </p>
        </header>

        <HeroWorkflow mode="picker" devApi={DEV_API} devKey={DEV_KEY} lockedMessage="Select a post to prepare its hero image." />
      </section>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-neutral-200 bg-white p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-neutral-600">These tools only run in <strong>development</strong> (or with a temporary key when hosted).</p>
      <ol class="mx-auto mt-4 list-decimal space-y-2 text-left text-sm text-neutral-600">
        <li>Run <code>npm run dev:all</code> locally to start Astro + the admin API.</li>
        <li>Visit <code>/admin/hero</code> from the local site.</li>
        <li>If you later host with an adapter, set <code>PUBLIC_ADMIN_KEY</code> and append <code>?key=…</code>.</li>
      </ol>
    </section>
  )}

</Base>
