---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../../utils/settings";
import { loadAllPosts, type LoadedPost } from "../../utils/posts";

export const prerender = false;

const settings = readSettings();
const site = getSiteOrigin(settings) || "https://example.com";

const posts: LoadedPost[] = loadAllPosts();
const heroDir = path.join(process.cwd(), "public", "hero-images");
let heroFiles: string[] = [];

try {
  heroFiles = fs
    .readdirSync(heroDir, { withFileTypes: true })
    .filter((entry) => entry.isFile())
    .map((entry) => entry.name)
    .filter((file) => /\.(png|jpe?g|webp|gif|avif)$/i.test(file));
} catch {
  heroFiles = [];
}

const heroFileSet = new Set(heroFiles.map((file) => `hero-images/${file}`));

interface HeroAdminPost {
  slug: string;
  title: string;
  heroPrompt: string | null;
  heroAlt: string;
  heroSrc: string | null;
  heroFile: string | null;
  heroExt: string;
  publishedAt: string | null;
  context: {
    excerpt: string;
    metaDescription: string;
    tags: string[];
    tone: string;
  };
  status: {
    hasPrompt: boolean;
    hasImage: boolean;
    hasAlt: boolean;
  };
}

function sanitize(value: unknown): string {
  return typeof value === "string" ? value.trim() : "";
}

function inferHeroFile(post: LoadedPost, normalizedSrc: string | null) {
  if (normalizedSrc && heroFileSet.has(normalizedSrc)) {
    return normalizedSrc;
  }

  const fallback = `hero-images/${post.slug}.png`;
  return heroFileSet.has(fallback) ? fallback : null;
}

const heroPosts: HeroAdminPost[] = posts.map((post) => {
  const rawPrompt = sanitize(post.data?.heroImagePrompt);
  const heroPrompt = rawPrompt.length ? rawPrompt : null;

  const rawSrc = sanitize(post.data?.heroImageSrc);
  const heroSrc = rawSrc.length ? rawSrc : null;
  const normalizedSrc = heroSrc ? heroSrc.replace(/^\/+/, "") : null;

  const heroFile = inferHeroFile(post, normalizedSrc);
  const heroExt = heroFile ? path.extname(heroFile) || ".png" : ".png";

  const rawAlt = sanitize(post.data?.heroImageAlt);
  const heroAlt = rawAlt;

  const publishedCandidate =
    (post.data?.publishedAt ?? post.data?.pubDate ?? post.data?.date ?? null) as
      | string
      | number
      | Date
      | null;

  let publishedAt: string | null = null;
  if (publishedCandidate) {
    const asDate = new Date(publishedCandidate);
    if (!Number.isNaN(+asDate)) {
      publishedAt = asDate.toISOString();
    }
  }

  const tags = Array.isArray(post.data?.tags)
    ? (post.data.tags as unknown[])
        .map((tag) => String(tag || "").trim())
        .filter(Boolean)
    : [];

  const excerpt = sanitize(post.data?.excerpt);
  const metaDescription = sanitize(post.data?.metaDescription);
  const tone = sanitize(post.data?.tone || post.data?.mood || "");

  return {
    slug: post.slug,
    title: post.title,
    heroPrompt,
    heroAlt,
    heroSrc,
    heroFile,
    heroExt,
    publishedAt,
    context: {
      excerpt,
      metaDescription,
      tags,
      tone,
    },
    status: {
      hasPrompt: Boolean(heroPrompt),
      hasImage: Boolean(heroFile || heroSrc),
      hasAlt: Boolean(heroAlt),
    },
  } satisfies HeroAdminPost;
});

const clientJson = JSON.stringify(heroPosts).replace(/</g, "\\u003c");

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get("key") === ADMIN_KEY;
const canUse = isDev || !!keyOk;
---
<Base
  title="WitchClick — Hero Images"
  description="Generate prompts, upload hero art, and wire metadata."
  canon={`${site}/admin/hero`}
  wide={true}
  noindex={true}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  {canUse ? (
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      <section class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm lg:col-span-4">
        <div class="flex items-center justify-between">
          <h1 class="text-xl font-semibold">Hero image workflow</h1>
          <span class="rounded-full bg-purple-100 px-2 py-1 text-xs font-medium text-purple-700">
            {heroPosts.length} post{heroPosts.length === 1 ? "" : "s"}
          </span>
        </div>
        <p class="mt-2 text-sm text-gray-700">
          Choose a post, generate a fresh hero prompt, upload the artwork, then copy the frontmatter snippet.
        </p>
        <label class="mt-4 block text-xs font-medium text-gray-600">
          Search posts
          <input
            id="hero-search"
            class="mt-1 w-full rounded-lg border px-3 py-2 text-sm"
            placeholder="tea ritual, grounding, cozy games"
            disabled={heroPosts.length === 0}
          />
        </label>
        <div
          id="hero-list"
          class="mt-4 max-h-[70vh] overflow-auto rounded-xl border border-gray-200 bg-gray-50"
        >
          {heroPosts.length === 0 ? (
            <p class="px-4 py-6 text-sm text-gray-600">
              No posts yet. Ingest a PostSpec to populate this list.
            </p>
          ) : (
            <p class="px-4 py-6 text-sm text-gray-600">Loading posts…</p>
          )}
        </div>
      </section>

      <section class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm lg:col-span-8">
        <h2 class="text-lg font-semibold">Prompt → file → upload → metadata</h2>
        <p class="mt-1 text-sm text-gray-700">
          Follow the loop: craft a vivid prompt, select the exported image, upload it into
          <code class="rounded bg-gray-100 px-1 py-0.5 text-[11px]">public/hero-images</code>, then wire the hero fields in
          frontmatter.
        </p>

        <div
          id="hero-empty"
          class="mt-6 rounded-xl border border-dashed border-purple-200 bg-purple-50/40 p-6 text-center text-sm text-purple-700"
        >
          Select a post from the list to get started.
        </div>

        <div id="hero-workflow" class="mt-6 hidden space-y-5">
          <div class="rounded-xl border border-gray-200 bg-white/80 p-4">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <div>
                <h3 id="hero-title" class="text-lg font-semibold text-gray-900"></h3>
                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-600">
                  <span>
                    Slug:
                    <code id="hero-slug" class="rounded bg-gray-100 px-1 py-0.5 text-[11px]"></code>
                  </span>
                  <span id="hero-published-wrap" class="hidden">
                    Published
                    <span id="hero-published"></span>
                  </span>
                </div>
              </div>
              <div class="flex flex-wrap gap-1 text-xs" id="hero-status"></div>
            </div>
          </div>

          <div class="rounded-xl border border-gray-200 bg-white/80 p-4">
            <h4 class="text-sm font-semibold text-gray-900">Step 1 — Generate the hero prompt</h4>
            <p id="hero-prompt-notice" class="mt-1 text-xs text-gray-600"></p>
            <textarea
              id="hero-prompt"
              class="mt-3 h-40 w-full rounded-lg border px-3 py-2 font-mono text-xs"
              placeholder="Generate or paste a hero image prompt for this post."
            ></textarea>
            <div class="mt-2 flex flex-wrap gap-2">
              <button
                id="hero-generate"
                type="button"
                class="rounded-lg border border-purple-200 bg-purple-50 px-3 py-2 text-sm text-purple-700 hover:bg-purple-100"
              >
                Generate prompt
              </button>
              <button id="hero-copy-prompt" type="button" class="rounded-lg border px-3 py-2 text-sm">
                Copy prompt
              </button>
            </div>
          </div>

          <div class="rounded-xl border border-gray-200 bg-white/80 p-4">
            <h4 class="text-sm font-semibold text-gray-900">Step 2 — Choose the hero image file</h4>
            <p class="mt-1 text-xs text-gray-600">
              Pick the exported artwork from your image tool. We will rename it to match the post slug.
            </p>
            <label class="mt-3 block text-xs font-medium text-gray-600">
              Hero image file
              <input
                id="hero-file"
                type="file"
                accept="image/png,image/jpeg,image/webp,image/gif,image/avif"
                class="mt-1 block w-full cursor-pointer rounded-lg border px-3 py-2 text-sm"
              />
            </label>
            <p id="hero-file-help" class="mt-2 text-xs text-gray-600"></p>
            <p id="hero-file-status" class="mt-2 text-sm text-gray-700"></p>
            <img id="hero-local-preview" class="mt-3 hidden max-h-48 w-full rounded-lg border object-cover" alt="" />
          </div>

          <div class="rounded-xl border border-gray-200 bg-white/80 p-4">
            <h4 class="text-sm font-semibold text-gray-900">Step 3 — Upload &amp; preview</h4>
            <p class="mt-1 text-xs text-gray-600">
              Uploading saves the file into
              <code class="rounded bg-gray-100 px-1 py-0.5 text-[11px]">public/hero-images</code> and refreshes the preview.
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <button
                id="hero-upload"
                type="button"
                class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700 hover:bg-emerald-100"
              >
                Upload image
              </button>
            </div>
            <p id="hero-upload-status" class="mt-2 text-sm text-gray-700"></p>
            <img
              id="hero-preview"
              class="mt-3 hidden max-h-64 w-full rounded-lg border object-cover"
              loading="lazy"
              alt=""
            />
          </div>

          <div class="rounded-xl border border-gray-200 bg-white/80 p-4">
            <h4 class="text-sm font-semibold text-gray-900">Step 4 — Frontmatter metadata</h4>
            <p class="mt-1 text-xs text-gray-600">
              Keep the alt text human-friendly and focused on what appears in the image.
            </p>
            <label class="mt-3 block text-xs font-medium text-gray-600">
              Hero alt text
              <input
                id="hero-alt"
                class="mt-1 w-full rounded-lg border px-3 py-2 text-sm"
                placeholder="Describe the scene for screen readers"
              />
            </label>
            <p id="hero-alt-notice" class="mt-1 text-xs text-gray-600"></p>
            <label class="mt-3 block text-xs font-medium text-gray-600">
              Frontmatter snippet
              <textarea id="hero-snippet" class="mt-1 h-32 w-full rounded-lg border px-3 py-2 font-mono text-xs" readonly></textarea>
            </label>
            <div class="mt-2 flex gap-2">
              <button id="hero-copy-snippet" type="button" class="rounded-lg border px-3 py-2 text-sm">
                Copy snippet
              </button>
            </div>
          </div>

          <p id="hero-action-status" class="text-sm text-gray-700"></p>
        </div>
      </section>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-purple-100 bg-white p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-gray-700">
        These tools only run in <strong>development</strong> (or with a temporary key when hosted on a server adapter).
      </p>
      <ol class="mx-auto mt-4 list-decimal space-y-2 text-left text-sm text-gray-700">
        <li>Run <code>npm run dev</code> locally.</li>
        <li>Use the ingestion CLI: <code>npm run ingest ./path/to/post.json</code>.</li>
        <li>If you later switch to serverless, set <code>PUBLIC_ADMIN_KEY</code> and visit <code>/admin?key=…</code>.</li>
      </ol>
    </section>
  )}

  {canUse && (
    <>
      <script type="application/json" id="hero-data">{clientJson}</script>
      <script
        type="module"
        src={new URL("../../scripts/admin-hero.ts", import.meta.url).toString()}
      ></script>
    </>
  )}
</Base>
