---
import Base from "../../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../../utils/settings";

export const prerender = false; // never emit in static builds

const settings = readSettings();
const site = getSiteOrigin(settings) || "https://example.com";

// Gate: dev OR query ?key=PUBLIC_ADMIN_KEY (useful if you later switch to a server adapter)
const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get("key") === ADMIN_KEY;
const canUse = isDev || !!keyOk;

// Dev API base (falls back to localhost if not set)
const DEV_API = import.meta.env.PUBLIC_DEV_API || "http://localhost:8787";
---
<Base
  title="WitchClick — Downloads Admin"
  description="Create and edit download products."
  canon={`${site}/admin/downloads`}
  wide={true}
>
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>

  {canUse ? (
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12" data-dev-api={DEV_API}>
      <section class="lg:col-span-4 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-2">
          <h1 class="text-xl font-semibold">Downloads</h1>
          <button id="newBtn" class="rounded-lg border px-3 py-1 text-sm">New</button>
        </div>
        <input id="search" placeholder="Search..." class="mb-3 w-full rounded-lg border px-3 py-2 text-sm" />
        <div id="list" class="max-h-[70vh] overflow-auto text-sm"></div>
      </section>

      <section class="lg:col-span-8 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
        <h2 class="mb-3 text-lg font-semibold">Editor</h2>
        <div class="grid gap-3 md:grid-cols-2">
          <label class="block"><span class="text-xs font-medium">Name</span><input id="name" class="mt-1 w-full rounded-lg border px-3 py-2" /></label>
          <label class="block"><span class="text-xs font-medium">Slug</span><input id="slug" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="tarot-study-planner" /></label>
          <label class="block"><span class="text-xs font-medium">Price</span><input id="price" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="5.00" /></label>
          <label class="block"><span class="text-xs font-medium">Currency</span><input id="currency" class="mt-1 w-full rounded-lg border px-3 py-2" value="USD" /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">Summary</span><input id="summary" class="mt-1 w-full rounded-lg border px-3 py-2" /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">Cover image URL (public)</span><input id="cover" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="/images/downloads/cover.jpg" /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">File URL (public PDF)</span><input id="file" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="/files/file.pdf" /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">External checkout URL (optional)</span><input id="url" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="https://ko-fi.com/s/..." /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">Features (one per line)</span><textarea id="features" class="mt-1 h-24 w-full rounded-lg border px-3 py-2"></textarea></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">Tags (comma-separated)</span><input id="tags" class="mt-1 w-full rounded-lg border px-3 py-2" /></label>
        </div>
        <div class="mt-4 flex gap-3">
          <button id="save" class="rounded-lg bg-green-600 px-4 py-2 text-white hover:bg-green-700">Save</button>
          <span id="status" class="self-center text-sm text-gray-700"></span>
        </div>
      </section>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-purple-100 bg-white p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-gray-700">These tools only run in <strong>development</strong> (or with a temporary key when hosted on a server adapter).</p>
      <ol class="mx-auto mt-4 list-decimal space-y-2 text-left text-sm text-gray-700">
        <li>Run <code>npm run dev</code> locally.</li>
        <li>Use the ingestion CLI: <code>npm run ingest ./path/to/post.json</code>.</li>
        <li>If you later switch to serverless, set <code>PUBLIC_ADMIN_KEY</code> and visit <code>/admin?key=…</code>.</li>
      </ol>
    </section>
  )}

  {canUse && (
    <script is:inline>
      (function(){
        var root = document.querySelector('[data-dev-api]');
        var API = root?.getAttribute('data-dev-api') || 'http://localhost:8787';
        var $ = function(id){ return document.getElementById(id); };

        function setStatus(msg, ok){ var el=$('status'); el.textContent=msg; el.style.color = ok===false ? '#7f1d1d' : '#065f46'; }

        function toLines(arr){ return (Array.isArray(arr)?arr:[]).join('\n'); }
        function fromLines(txt){ return String(txt||'').split('\n').map(function(s){return s.trim();}).filter(Boolean); }
        function fromCSV(txt){ return String(txt||'').split(',').map(function(s){return s.trim();}).filter(Boolean); }

        async function refresh(){
          var res = await fetch(API+'/downloads/list',{method:'POST'});
          var data = await res.json();
          var q = ($('search').value||'').toLowerCase().trim();
          var list = $('list'); list.innerHTML='';
          if (!data.ok) return setStatus('List error: '+(data.error||'unknown'), false);
          (data.items||[]).forEach(function(it){
            var name = String(it.name||'').toLowerCase(), slug = String(it.slug||'').toLowerCase();
            if (q && name.indexOf(q)===-1 && slug.indexOf(q)===-1) return;
            var a = document.createElement('a');
            a.href='#';
            a.className='block rounded px-2 py-1 hover:bg-purple-50';
            a.textContent = (it.name||'') + ' ('+(it.slug||'')+')';
            a.addEventListener('click', function(ev){ ev.preventDefault(); load(it.slug); });
            list.appendChild(a);
          });
        }

        async function load(slug){
          var res = await fetch(API+'/downloads/get',{method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({slug})});
          var data = await res.json();
          if (!data.ok) return setStatus('Load error: '+(data.error||'unknown'), false);
          var d = data.data;
          $('name').value = d.name || '';
          $('slug').value = d.slug || '';
          $('price').value = d.price || '';
          $('currency').value = d.currency || 'USD';
          $('summary').value = d.summary || '';
          $('cover').value = d.cover || '';
          $('file').value = d.file || '';
          $('url').value = d.url || '';
          $('features').value = toLines(d.features);
          $('tags').value = (d.tags||[]).join(', ');
          setStatus('Loaded '+d.slug);
        }

        $('newBtn').addEventListener('click', function(){
          ['name','slug','price','currency','summary','cover','file','url','features','tags'].forEach(function(id){ $(id).value=''; });
          $('currency').value='USD';
          setStatus('New download draft');
        });

        $('save').addEventListener('click', async function(){
          try {
            var payload = {
              name: $('name').value,
              slug: $('slug').value,
              price: $('price').value,
              currency: $('currency').value,
              summary: $('summary').value,
              cover: $('cover').value,
              file: $('file').value,
              url: $('url').value,
              features: fromLines($('features').value),
              tags: fromCSV($('tags').value)
            };
            var res = await fetch(API+'/downloads/save',{method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)});
            var data = await res.json();
            if (!data.ok) throw new Error(data.error||'save failed');
            setStatus('Saved → '+data.path);
            refresh();
          } catch (e) { setStatus('Save error: '+(e.message||String(e)), false); }
        });

        $('search').addEventListener('input', refresh);
        refresh();
      })();
    </script>
  )}
</Base>
