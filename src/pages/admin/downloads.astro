---
// Dev-only guard
if (import.meta.env.PROD) {
  // Never render admin in production builds/hosting
  return Astro.redirect("/journal", 301);
}

export const prerender = import.meta.env.PROD ? true : false; // Pre-render redirect only in prod builds

import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";


const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/downloads" });

// Gate: dev OR query ?key=PUBLIC_ADMIN_KEY (useful if you later switch to a server adapter)
const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get("key") === ADMIN_KEY;
const canUse = isDev || !!keyOk;

// Dev API base (falls back to localhost if not set)
const DEV_API = import.meta.env.PUBLIC_DEV_API || "http://localhost:8787";
---
<Base
  title="WitchClick — Downloads Admin"
  description="Create and edit download products."
  canon={canonical}
  wide={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6">
      <AdminNav currentPath="/admin/downloads" />

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12" data-dev-api={DEV_API}>
      <section class="lg:col-span-4 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-2">
          <h1 class="text-xl font-semibold">Downloads</h1>
          <button id="newBtn" class="rounded-lg border px-3 py-1 text-sm">New</button>
        </div>
        <input id="search" placeholder="Search..." class="mb-3 w-full rounded-lg border px-3 py-2 text-sm" />
        <div id="list" class="max-h-[70vh] overflow-auto text-sm"></div>
      </section>

      <section class="lg:col-span-8 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 class="text-lg font-semibold">Editor</h2>
          <span
            id="loadedIndicator"
            class="rounded-full bg-surface-muted px-3 py-1 text-xs font-medium text-body"
          >No download loaded</span>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
          <label class="block"><span class="text-xs font-medium">Name</span><input id="name" class="mt-1 w-full rounded-lg border px-3 py-2" /></label>
          <label class="block"><span class="text-xs font-medium">Slug</span><input id="slug" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="tarot-study-planner" /></label>
          <label class="block"><span class="text-xs font-medium">Price</span><input id="price" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="5.00" /></label>
          <label class="block"><span class="text-xs font-medium">Currency</span><input id="currency" class="mt-1 w-full rounded-lg border px-3 py-2" value="USD" /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">Summary</span><input id="summary" class="mt-1 w-full rounded-lg border px-3 py-2" /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">Cover image URL (public)</span><input id="cover" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="/images/downloads/cover.jpg" /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">File URL (public PDF)</span><input id="file" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="/files/file.pdf" /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">External checkout URL (optional)</span><input id="url" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="https://ko-fi.com/s/..." /></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">Features (one per line)</span><textarea id="features" class="mt-1 h-24 w-full rounded-lg border px-3 py-2"></textarea></label>
          <label class="block md:col-span-2"><span class="text-xs font-medium">Tags (comma-separated)</span><input id="tags" class="mt-1 w-full rounded-lg border px-3 py-2" /></label>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button id="save" class="rounded-lg bg-surface-success px-4 py-2 text-inverse hover:bg-surface-success-strong">Save</button>
          <button
            id="delete"
            class="rounded-lg border border-danger px-4 py-2 text-danger hover:bg-surface-danger hover:text-inverse disabled:cursor-not-allowed disabled:opacity-60"
            type="button"
            disabled
          >Delete</button>
          <label class="flex items-center gap-2 text-sm text-body-muted">
            <input id="archive" type="checkbox" class="rounded border-line-subtle" disabled />
            <span>Move to archive folder when deleting</span>
          </label>
          <span id="status" class="flex-1 text-sm text-body-muted"></span>
        </div>
      </section>
      </div>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">These tools only run in <strong>development</strong> (or with a temporary key when hosted on a server adapter).</p>
      <ol class="mx-auto mt-4 list-decimal space-y-2 text-left text-sm text-body-muted">
        <li>Run <code>npm run dev</code> locally.</li>
        <li>Use the ingestion CLI: <code>npm run ingest ./path/to/post.json</code>.</li>
        <li>If you later switch to serverless, set <code>PUBLIC_ADMIN_KEY</code> and visit <code>/admin?key=…</code>.</li>
      </ol>
    </section>
  )}

  {canUse && (
    <script is:inline>
      (function(){
        var root = document.querySelector('[data-dev-api]');
        var API = root?.getAttribute('data-dev-api') || 'http://localhost:8787';
        var $ = function(id){ return document.getElementById(id); };

        var currentSlug = null;

        function setStatus(msg, ok){
          var el=$('status');
          el.textContent=msg;
          el.style.color = ok===false ? '#7f1d1d' : '#065f46';
        }

        function updateSelectionDisplay(){
          var badge = $('loadedIndicator');
          if (badge){
            if (currentSlug){
              badge.textContent = 'Loaded: '+currentSlug;
              badge.classList.remove('bg-surface-base');
            } else {
              badge.textContent = 'New download draft';
            }
          }
          var items = $('list')?.querySelectorAll('[data-slug]') || [];
          items.forEach(function(node){
            if (node.getAttribute('data-slug') === currentSlug){
              node.classList.add('border-line-strong','bg-surface-muted');
              node.classList.remove('border-transparent');
            } else {
              node.classList.remove('border-line-strong','bg-surface-muted');
              node.classList.add('border-transparent');
            }
          });
          var del = $('delete');
          var arch = $('archive');
          if (del) del.disabled = !currentSlug;
          if (arch) arch.disabled = !currentSlug;
          if (!currentSlug && arch) arch.checked = false;
        }

        function clearForm(){
          ['name','slug','price','currency','summary','cover','file','url','features','tags'].forEach(function(id){
            var field = $(id);
            if (field) field.value='';
          });
          $('currency').value='USD';
          currentSlug = null;
          updateSelectionDisplay();
        }

        function toLines(arr){ return (Array.isArray(arr)?arr:[]).join('\n'); }
        function fromLines(txt){ return String(txt||'').split('\n').map(function(s){return s.trim();}).filter(Boolean); }
        function fromCSV(txt){ return String(txt||'').split(',').map(function(s){return s.trim();}).filter(Boolean); }

        async function refresh(){
          var res = await fetch(API+'/downloads/list',{method:'POST'});
          var data = await res.json();
          var q = ($('search').value||'').toLowerCase().trim();
          var list = $('list'); list.innerHTML='';
          if (!data.ok) return setStatus('List error: '+(data.error||'unknown'), false);
          (data.items||[]).forEach(function(it){
            var name = String(it.name||'').toLowerCase(), slug = String(it.slug||'').toLowerCase();
            if (q && name.indexOf(q)===-1 && slug.indexOf(q)===-1) return;
            var a = document.createElement('a');
            a.href='#';
            a.className='download-item block rounded border border-transparent px-2 py-1 transition hover:bg-surface-muted';
            a.setAttribute('data-slug', it.slug || '');
            a.textContent = (it.name||'') + ' ('+(it.slug||'')+')';
            a.addEventListener('click', function(ev){ ev.preventDefault(); load(it.slug); });
            list.appendChild(a);
          });
          updateSelectionDisplay();
        }

        async function load(slug){
          var res = await fetch(API+'/downloads/get',{method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({slug})});
          var data = await res.json();
          if (!data.ok) return setStatus('Load error: '+(data.error||'unknown'), false);
          var d = data.data;
          $('name').value = d.name || '';
          $('slug').value = d.slug || '';
          $('price').value = d.price || '';
          $('currency').value = d.currency || 'USD';
          $('summary').value = d.summary || '';
          $('cover').value = d.cover || '';
          $('file').value = d.file || '';
          $('url').value = d.url || '';
          $('features').value = toLines(d.features);
          $('tags').value = (d.tags||[]).join(', ');
          if ($('archive')) $('archive').checked = false;
          currentSlug = d.slug || slug || '';
          updateSelectionDisplay();
          setStatus('Loaded '+d.slug);
        }

        $('newBtn').addEventListener('click', function(){
          clearForm();
          setStatus('New download draft');
        });

        $('save').addEventListener('click', async function(){
          try {
            var payload = {
              name: $('name').value,
              slug: $('slug').value,
              price: $('price').value,
              currency: $('currency').value,
              summary: $('summary').value,
              cover: $('cover').value,
              file: $('file').value,
              url: $('url').value,
              features: fromLines($('features').value),
              tags: fromCSV($('tags').value)
            };
            var res = await fetch(API+'/downloads/save',{method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)});
            var data = await res.json();
            if (!data.ok) throw new Error(data.error||'save failed');
            setStatus('Saved → '+data.path);
            currentSlug = data.slug || payload.slug;
            updateSelectionDisplay();
            refresh();
          } catch (e) { setStatus('Save error: '+(e.message||String(e)), false); }
        });

        $('delete').addEventListener('click', async function(){
          var slug = currentSlug || $('slug').value;
          slug = String(slug||'').trim();
          if (!slug) return setStatus('Load a download before deleting', false);
          var archive = $('archive').checked;
          var promptMsg = archive ? ('Archive '+slug+'? The file will move to content/downloads/_archive.') : ('Delete '+slug+'? This removes the JSON file.');
          if (!confirm(promptMsg)) return setStatus('Deletion cancelled');
          try {
            var res = await fetch(API+'/downloads/delete',{method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({slug, archive})});
            var data = await res.json();
            if (!data.ok) throw new Error(data.error||'delete failed');
            var msg = archive && data.archivePath ? ('Archived '+slug+' → '+data.archivePath) : ('Deleted '+slug+'. Restore from version control if needed.');
            setStatus(msg);
            clearForm();
            refresh();
          } catch (e) {
            setStatus('Delete error: '+(e.message||String(e)), false);
          }
        });

        $('search').addEventListener('input', refresh);
        refresh();
      })();
    </script>
  )}
</Base>
