---
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import adminPostEditorScript from "../../scripts/adminPostEditor.js?url";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";


const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/posts" });

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';
---
<Base
  title="WitchClick — Post Editor"
  description="Edit, rename, or retire existing posts."
  canon={canonical}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6">
      <AdminNav currentPath="/admin/posts" />

      <div data-post-editor data-dev-api={DEV_API} class="space-y-6">
      <header class="rounded-2xl border border-line-subtle bg-surface-base p-6 shadow-sm">
        <div class="space-y-3">
          <div>
            <h1 class="text-2xl font-semibold text-body-strong">Post Editor</h1>
            <p class="mt-1 text-sm text-body-muted">
              Edit existing posts: update frontmatter, tweak markdown, or archive posts. Changes save directly to markdown files.
            </p>
          </div>
          <div class="rounded-lg border border-dashed border-line-subtle bg-surface-base/60 p-4 text-xs text-body-muted">
            <div class="font-semibold mb-2">💡 Quick guide:</div>
            <ul class="space-y-1.5 ml-4">
              <li><strong>Search:</strong> Find posts by title or slug in the left panel</li>
              <li><strong>Frontmatter:</strong> Edit YAML metadata (title, tags, dates, etc.)</li>
              <li><strong>Markdown:</strong> Update the post content directly</li>
              <li><strong>Save:</strong> Changes write immediately to the file system</li>
              <li><strong>Delete:</strong> Permanently removes the post file (use with caution!)</li>
            </ul>
          </div>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
        <aside class="lg:col-span-4 space-y-4 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-base font-semibold">Post Library</h3>
              <button
                type="button"
                data-refresh
                class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium hover:bg-surface-soft"
              >
                🔄 Refresh
              </button>
            </div>
            <p class="text-xs text-body-muted">Search and select a post to edit</p>
          </div>
          <input
            id="postSearch"
            type="search"
            placeholder="Search by title or slug…"
            data-search
            class="w-full rounded-lg border border-line-subtle px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
          <div class="space-y-2">
            <p data-list-status class="text-xs font-medium text-body-muted flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-info animate-pulse"></span>
              Loading…
            </p>
            <select
              data-post-list
              size="14"
              class="h-[28rem] w-full rounded-xl border border-line-subtle bg-surface-muted px-3 py-2 text-left text-sm font-medium text-primary focus:outline-none focus:ring-2 focus:ring-primary"
            ></select>
          </div>
        </aside>

        <section class="lg:col-span-8 space-y-4 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="flex-1">
              <h2 class="text-xl font-semibold">Editor Workspace</h2>
              <p data-meta class="text-xs text-body-muted mt-1">Select a post from the library to begin editing</p>
            </div>
            <button
              type="button"
              data-delete
              class="rounded-lg border-2 border-danger px-4 py-2 text-sm font-semibold text-danger hover:bg-danger hover:text-white transition"
              disabled
            >
              🗑 Delete Post
            </button>
          </div>

          <div class="space-y-3">
            <label class="block">
              <span class="text-xs font-medium">Frontmatter (YAML)</span>
              <textarea
                data-frontmatter
                class="mt-1 h-48 w-full rounded-lg border border-line-subtle px-3 py-2 font-mono text-xs"
                spellcheck="false"
                disabled
              ></textarea>
              <p class="mt-1 text-xs text-body-subtle">
                Tip: Entity references in frontmatter should use format: <code class="font-mono text-purple-600">entities: [&#123;type: "herb", slug: "peppermint"&#125;]</code>
              </p>
            </label>

            <label class="block">
              <span class="text-xs font-medium">Markdown</span>
              <textarea
                data-markdown
                class="mt-1 h-[28rem] w-full rounded-lg border border-line-subtle px-3 py-2 font-mono text-sm"
                spellcheck="false"
                disabled
              ></textarea>
            </label>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button
              type="button"
              data-save
              class="rounded-lg bg-surface-accent-bolder px-4 py-2 text-sm font-semibold text-inverse hover:bg-surface-accent-deep disabled:opacity-50"
              disabled
            >
              Save changes
            </button>
            <div data-status class="text-sm text-body-muted"></div>
          </div>

          <ul data-warnings class="hidden list-disc space-y-1 rounded-lg border border-warning bg-warning/10 px-3 py-2 text-xs text-warning"></ul>
        </section>
      </div>
      </div>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">These tools only run in <strong>development</strong> (or with a temporary key on a server adapter).</p>
      <p class="mt-3 text-sm text-body-muted">Use the ingestion CLI instead: <code>npm run ingest ./path/to/post.json</code></p>
    </section>
  )}

  {canUse && <script type="module" is:inline src={adminPostEditorScript}></script>}
</Base>
