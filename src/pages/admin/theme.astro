---
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";
import ThemeColorControl from "@/components/ThemeColorControl.astro";
import { getScopesByCategory } from "@/lib/theme-scopes";
import { COLOR_TOKEN_FIELDS } from "@/lib/color-token-schema";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/theme" });

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';

const pageScopes = getScopesByCategory('page');
const componentScopes = getScopesByCategory('component');

const categoryOptions = [
  { value: "custom", label: "Custom" },
  { value: "seasonal", label: "Seasonal" },
  { value: "minimal", label: "Minimal" },
  { value: "vibrant", label: "Vibrant" },
  { value: "default", label: "Default" },
];

const fontOptions = [
  "Literata",
  "EB Garamond",
  "Playfair Display",
  "Fraunces",
  "Cormorant Garamond",
  "Cinzel",
  "Parisienne",
  "Dancing Script",
  "Great Vibes",
  "Sacramento",
];
---

<Base
  title="WitchClick — Comprehensive Theme Editor"
  description="Create, edit, and manage theme presets with comprehensive controls"
  canon={canonical}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6" id="themeEditorRoot" data-dev-api={DEV_API}>
      <AdminNav currentPath="/admin/theme" />

      <div
        class="flex flex-wrap items-center gap-2 rounded-2xl border border-line-neutral bg-surface-base/80 p-2 shadow-sm"
        data-editor-tabs
      >
        <button
          type="button"
          class="rounded-xl px-4 py-2 text-sm font-medium transition data-[active='true']:bg-info data-[active='true']:text-white data-[active='true']:shadow"
          data-editor-tab="presets"
          data-active="true"
        >
          Theme presets
        </button>
        <button
          type="button"
          class="rounded-xl px-4 py-2 text-sm font-medium transition hover:bg-surface-soft/80"
          data-editor-tab="tokens"
        >
          Color tokens
        </button>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12" data-theme-panel="presets">
        <!-- Sidebar: Theme Library -->
        <section class="lg:col-span-3 space-y-6">
          <div class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
            <header class="mb-5">
              <h1 class="text-xl font-semibold text-primary">Theme Library</h1>
              <p class="mt-1 text-sm text-body-muted">
                Manage theme presets
              </p>
            </header>

            <!-- Active Themes Display -->
            <dl class="space-y-2 text-sm mb-5 p-3 rounded-lg bg-surface-soft border border-line-subtle">
              <div class="flex items-center justify-between gap-3">
                <dt class="text-body-muted">Active midnight</dt>
                <dd class="font-medium text-primary text-xs" data-active="midnight">—</dd>
              </div>
              <div class="flex items-center justify-between gap-3">
                <dt class="text-body-muted">Active dawn</dt>
                <dd class="font-medium text-primary text-xs" data-active="dawn">—</dd>
              </div>
            </dl>

            <!-- Category Filter -->
            <div class="mb-5">
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Filter</span>
                <select id="categoryFilter" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2 text-sm">
                  <option value="">All categories</option>
                  {categoryOptions.map((cat) => (
                    <option value={cat.value}>{cat.label}</option>
                  ))}
                </select>
              </label>
            </div>

            <!-- Theme Lists -->
            <div class="space-y-5">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <h2 class="text-[13px] font-semibold uppercase tracking-wide text-body-muted">Midnight</h2>
                  <button
                    type="button"
                    class="rounded-lg border border-line-neutral px-3 py-1 text-xs font-medium hover:bg-surface-soft transition"
                    data-new-theme="midnight"
                  >
                    + New
                  </button>
                </div>
                <div class="space-y-2 max-h-64 overflow-y-auto" data-theme-list="midnight"></div>
              </div>

              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <h2 class="text-[13px] font-semibold uppercase tracking-wide text-body-muted">Dawn</h2>
                  <button
                    type="button"
                    class="rounded-lg border border-line-neutral px-3 py-1 text-xs font-medium hover:bg-surface-soft transition"
                    data-new-theme="dawn"
                  >
                    + New
                  </button>
                </div>
                <div class="space-y-2 max-h-64 overflow-y-auto" data-theme-list="dawn"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- Main Editor -->
        <section class="lg:col-span-9 space-y-6">
          <!-- Editor Header -->
          <div class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
            <header class="mb-5">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div>
                  <h2 class="text-lg font-semibold text-primary">Theme Editor</h2>
                  <p class="mt-1 text-xs text-body-muted" data-breadcrumbs>Theme</p>
                </div>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    id="undoBtn"
                    class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium hover:bg-surface-soft transition disabled:opacity-50"
                    title="Undo (Ctrl+Z)"
                  >
                    ↶ Undo
                  </button>
                  <button
                    type="button"
                    id="redoBtn"
                    class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium hover:bg-surface-soft transition disabled:opacity-50"
                    title="Redo (Ctrl+Y)"
                  >
                    ↷ Redo
                  </button>
                </div>
              </div>
            </header>

            <!-- Basic Info -->
            <div class="grid gap-3 md:grid-cols-2">
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Comfort mode</span>
                <select id="themeMode" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                  <option value="midnight">Midnight (dark)</option>
                  <option value="dawn">Dawn (light)</option>
                </select>
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Theme name *</span>
                <input
                  id="themeName"
                  type="text"
                  class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2"
                  placeholder="Cozy Midnight"
                />
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Slug *</span>
                <input
                  id="themeSlug"
                  type="text"
                  class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2"
                  placeholder="cozy-midnight"
                />
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Category</span>
                <select id="themeCategory" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                  {categoryOptions.map((cat) => (
                    <option value={cat.value} selected={cat.value === 'custom'}>
                      {cat.label}
                    </option>
                  ))}
                </select>
              </label>
            </div>

            <!-- Scope Selector -->
            <div class="mt-5 p-4 rounded-lg border border-info/30 bg-info/5">
              <div class="mb-3 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-info">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="3" y1="9" x2="21" y2="9"></line>
                  <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
                <h3 class="text-sm font-semibold text-primary">Page/Component Styling</h3>
              </div>
              <p class="text-xs text-body-muted mb-3">
                Apply custom colors to specific pages or components. Start with "Global Theme" then override for specific areas.
              </p>

              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Currently Editing</span>
                <select id="scopeSelector" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2 font-medium">
                  <optgroup label="Pages">
                    {pageScopes.map((scope) => (
                      <option value={scope.id} selected={scope.id === 'global'}>
                        {scope.label} — {scope.description}
                      </option>
                    ))}
                  </optgroup>
                  <optgroup label="Components">
                    {componentScopes.map((scope) => (
                      <option value={scope.id}>
                        {scope.label} — {scope.description}
                      </option>
                    ))}
                  </optgroup>
                </select>
              </label>

              <div class="mt-3 p-3 rounded-lg bg-surface-soft/50 border border-line-subtle text-xs" data-scope-info>
                <div class="flex items-start gap-2">
                  <span class="text-body-muted">ℹ️</span>
                  <div>
                    <p class="font-medium text-primary mb-1" data-scope-label>Editing: Global Theme</p>
                    <p class="text-body-muted" data-scope-description>Default colors applied site-wide</p>
                    <p class="mt-2 text-body-muted" data-scope-status>
                      <span data-scope-has-override class="hidden">
                        ✓ This scope has custom overrides. <button type="button" data-clear-scope class="underline hover:text-primary">Clear overrides</button>
                      </span>
                      <span data-scope-no-override>
                        No custom overrides for this scope yet. Changes will create scope-specific styling.
                      </span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Core Brand Colors -->
          <details class="rounded-2xl border border-line-neutral bg-surface-base shadow-sm" open>
            <summary class="cursor-pointer p-5 hover:bg-surface-soft/50 transition">
              <h3 class="inline text-sm font-semibold uppercase tracking-wide text-body-muted">Core Brand Colors</h3>
              <p class="mt-1 text-xs text-body-muted">Foundation colors for the entire theme</p>
            </summary>
            <div class="px-5 pb-5 pt-2 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
              <ThemeColorControl label="Midnight" variableKey="colorMidnight" placeholder="#07020f" description="Deepest dark" />
              <ThemeColorControl label="Night" variableKey="colorNight" placeholder="#120725" description="Dark base" />
              <ThemeColorControl label="Iris" variableKey="colorIris" placeholder="#4b2a63" description="Purple accent" />
              <ThemeColorControl label="Amethyst" variableKey="colorAmethyst" placeholder="#7c4eb0" description="Bright purple" />
              <ThemeColorControl label="Dusk" variableKey="colorDusk" placeholder="#271534" description="Mid purple" />
              <ThemeColorControl label="Gold" variableKey="colorGold" placeholder="#d4af37" description="Gold accent" />
              <ThemeColorControl label="Rune" variableKey="colorRune" placeholder="#f8f3ff" description="Light tint" />
              <ThemeColorControl label="Fog" variableKey="colorFog" placeholder="#d7c8f3" description="Light purple" />
              <ThemeColorControl label="Ink" variableKey="colorInk" placeholder="#f4f1ff" description="Text base" />
            </div>
          </details>

          <!-- Surface & Background Colors -->
          <details class="rounded-2xl border border-line-neutral bg-surface-base shadow-sm" open>
            <summary class="cursor-pointer p-5 hover:bg-surface-soft/50 transition">
              <h3 class="inline text-sm font-semibold uppercase tracking-wide text-body-muted">Surface & Background Colors</h3>
              <p class="mt-1 text-xs text-body-muted">Card surfaces, panels, and background layers</p>
            </summary>
            <div class="px-5 pb-5 pt-2 grid gap-3 md:grid-cols-2">
              <ThemeColorControl label="Surface Plain" variableKey="surfacePlain" description="Base surface" />
              <ThemeColorControl label="Surface Plain Border" variableKey="surfacePlainBorder" description="Plain surface border" />
              <ThemeColorControl label="Card Panel Surface" variableKey="cardPanelSurface" description="Card background" />
              <ThemeColorControl label="Card Panel Surface Strong" variableKey="cardPanelSurfaceStrong" description="Emphasized card bg" />
              <ThemeColorControl label="Card Panel Border" variableKey="cardPanelBorder" description="Card border" />
              <ThemeColorControl label="Card Panel Border Strong" variableKey="cardPanelBorderStrong" description="Strong card border" />
              <ThemeColorControl label="Card Panel Border Soft" variableKey="cardPanelBorderSoft" description="Subtle card border" />
            </div>
          </details>

          <!-- Text Hierarchy Colors -->
          <details class="rounded-2xl border border-line-neutral bg-surface-base shadow-sm" open>
            <summary class="cursor-pointer p-5 hover:bg-surface-soft/50 transition">
              <h3 class="inline text-sm font-semibold uppercase tracking-wide text-body-muted">Text Hierarchy Colors</h3>
              <p class="mt-1 text-xs text-body-muted">All text colors from headings to hints</p>
            </summary>
            <div class="px-5 pb-5 pt-2 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
              <ThemeColorControl label="Text Primary" variableKey="textPrimary" description="Main text" />
              <ThemeColorControl label="Text Secondary" variableKey="textSecondary" description="Secondary text" />
              <ThemeColorControl label="Text Tertiary" variableKey="textTertiary" description="Tertiary text" />
              <ThemeColorControl label="Text Strong" variableKey="textStrong" description="Highest contrast" />
              <ThemeColorControl label="Text Hint" variableKey="textHint" description="Hint text" />
              <ThemeColorControl label="Text Disabled" variableKey="textDisabled" description="Disabled text" />
              <ThemeColorControl label="Text Body" variableKey="textBody" description="Paragraph text" />
              <ThemeColorControl label="Ink Body" variableKey="inkBody" description="Body text ink" />
              <ThemeColorControl label="Ink Strong" variableKey="inkStrong" description="Strong emphasis" />
              <ThemeColorControl label="Ink Muted" variableKey="inkMuted" description="Muted text" />
              <ThemeColorControl label="Text Subtle" variableKey="textSubtle" description="Subtle captions" />
              <ThemeColorControl label="Text Accent" variableKey="textAccent" description="Accent text" />
              <ThemeColorControl label="Text Accent Strong" variableKey="textAccentStrong" description="High emphasis accent" />
              <ThemeColorControl label="Link Color" variableKey="linkColor" description="Link text" />
            </div>
          </details>

          <!-- Card Component Styling -->
          <details class="rounded-2xl border border-line-neutral bg-surface-base shadow-sm" open>
            <summary class="cursor-pointer p-5 hover:bg-surface-soft/50 transition">
              <h3 class="inline text-sm font-semibold uppercase tracking-wide text-body-muted">Card Component Styling</h3>
              <p class="mt-1 text-xs text-body-muted">Badges, tags, and card-specific elements</p>
            </summary>
            <div class="px-5 pb-5 pt-2 space-y-4">
              <!-- Badges -->
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-body-muted mb-3">Badges</h4>
                <div class="grid gap-3 md:grid-cols-3">
                  <ThemeColorControl label="Badge Background" variableKey="cardBadgeBg" />
                  <ThemeColorControl label="Badge Border" variableKey="cardBadgeBorder" />
                  <ThemeColorControl label="Badge Text" variableKey="cardBadgeText" />
                </div>
              </div>

              <!-- Tags -->
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-body-muted mb-3">Tags</h4>
                <div class="grid gap-3 md:grid-cols-3">
                  <ThemeColorControl label="Tag Background" variableKey="cardTagBg" />
                  <ThemeColorControl label="Tag Border" variableKey="cardTagBorder" />
                  <ThemeColorControl label="Tag Text" variableKey="cardTagText" />
                </div>
              </div>

              <!-- Spoon Level -->
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-body-muted mb-3">Spoon Level Indicator</h4>
                <div class="grid gap-3 md:grid-cols-3">
                  <ThemeColorControl label="Spoon Background" variableKey="cardSpoonBg" />
                  <ThemeColorControl label="Spoon Border" variableKey="cardSpoonBorder" />
                  <ThemeColorControl label="Spoon Text" variableKey="cardSpoonText" />
                </div>
              </div>
            </div>
          </details>

          <!-- Interactive & Focus States -->
          <details class="rounded-2xl border border-line-neutral bg-surface-base shadow-sm">
            <summary class="cursor-pointer p-5 hover:bg-surface-soft/50 transition">
              <h3 class="inline text-sm font-semibold uppercase tracking-wide text-body-muted">Interactive & Focus States</h3>
              <p class="mt-1 text-xs text-body-muted">Focus rings and interactive element colors</p>
            </summary>
            <div class="px-5 pb-5 pt-2 grid gap-3 md:grid-cols-2">
              <ThemeColorControl label="Focus Ring Color" variableKey="focusRingColor" description="Global focus ring" />
              <ThemeColorControl label="Card Focus Outline" variableKey="cardFocusOutline" description="Card focus outline" />
            </div>
          </details>

          <!-- Semantic Status Colors -->
          <details class="rounded-2xl border border-line-neutral bg-surface-base shadow-sm">
            <summary class="cursor-pointer p-5 hover:bg-surface-soft/50 transition">
              <h3 class="inline text-sm font-semibold uppercase tracking-wide text-body-muted">Semantic Status Colors</h3>
              <p class="mt-1 text-xs text-body-muted">Success, warning, error, and info states</p>
            </summary>
            <div class="px-5 pb-5 pt-2 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
              <ThemeColorControl label="Success" variableKey="success" placeholder="#4ade80" />
              <ThemeColorControl label="Warning" variableKey="warning" placeholder="#fbbf24" />
              <ThemeColorControl label="Error" variableKey="error" placeholder="#f87171" />
              <ThemeColorControl label="Info" variableKey="info" placeholder="#60a5fa" />
            </div>
          </details>

          <!-- Typography -->
          <details class="rounded-2xl border border-line-neutral bg-surface-base shadow-sm">
            <summary class="cursor-pointer p-5 hover:bg-surface-soft/50 transition">
              <h3 class="inline text-sm font-semibold uppercase tracking-wide text-body-muted">Typography</h3>
              <p class="mt-1 text-xs text-body-muted">Font families for different text styles</p>
            </summary>
            <div class="px-5 pb-5 pt-2 grid gap-3 md:grid-cols-2">
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Serif Font (Body)</span>
                <select id="themeFontSerif" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                  {fontOptions.map((font) => (
                    <option value={font}>{font}</option>
                  ))}
                </select>
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Script Font (Decorative)</span>
                <select id="themeFontScript" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                  {fontOptions.map((font) => (
                    <option value={font}>{font}</option>
                  ))}
                </select>
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Heading Font</span>
                <select id="themeFontHeading" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                  {fontOptions.map((font) => (
                    <option value={font}>{font}</option>
                  ))}
                </select>
              </label>
              <label class="block text-sm">
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Accent Font</span>
                <select id="themeFontAccent" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
                  {fontOptions.map((font) => (
                    <option value={font}>{font}</option>
                  ))}
                </select>
              </label>
            </div>
          </details>

          <!-- Entity Grimoire Specific (shown only when grimoire scope is selected) -->
          <details class="rounded-2xl border border-line-neutral bg-surface-base shadow-sm" data-scope-section="grimoire" style="display: none;">
            <summary class="cursor-pointer p-5 hover:bg-surface-soft/50 transition">
              <h3 class="inline text-sm font-semibold uppercase tracking-wide text-body-muted">Entity Grimoire Styling</h3>
              <p class="mt-1 text-xs text-body-muted">Custom colors for the entity directory page</p>
            </summary>
            <div class="px-5 pb-5 pt-2 space-y-4">
              <!-- Card Surface Colors -->
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-body-muted mb-3">Card Surfaces</h4>
                <div class="grid gap-3 md:grid-cols-2">
                  <ThemeColorControl label="Card Border" variableKey="entityCardBorder" description="Card outline" />
                  <ThemeColorControl label="Card Glow" variableKey="entityCardGlow" description="Soft glow effect" />
                  <ThemeColorControl label="Card Highlight" variableKey="entityCardHighlight" description="Highlight accent" />
                  <ThemeColorControl label="Surface Top" variableKey="entityCardSurfaceTop" description="Top gradient" />
                  <ThemeColorControl label="Surface Bottom" variableKey="entityCardSurfaceBottom" description="Bottom gradient" />
                </div>
              </div>

              <!-- Card Text Colors -->
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-body-muted mb-3">Card Text</h4>
                <div class="grid gap-3 md:grid-cols-2">
                  <ThemeColorControl label="Heading" variableKey="entityCardHeading" description="Card title" />
                  <ThemeColorControl label="Text" variableKey="entityCardText" description="Card body text" />
                  <ThemeColorControl label="Label" variableKey="entityCardLabel" description="Ribbon label" />
                </div>
              </div>

              <!-- Interactive Elements -->
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-body-muted mb-3">Interactive Elements</h4>
                <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
                  <ThemeColorControl label="CTA Button" variableKey="entityCardCta" description="Call to action" />
                  <ThemeColorControl label="CTA Hover" variableKey="entityCardCtaHover" description="Button hover" />
                  <ThemeColorControl label="Icon Color" variableKey="entityCardIcon" description="Card icon" />
                  <ThemeColorControl label="Icon Shadow" variableKey="entityCardIconShadow" description="Icon glow" />
                </div>
              </div>
            </div>
          </details>

          <!-- Live Preview -->
          <div class="rounded-2xl border-2 border-dashed border-line-neutral bg-surface-soft/60 p-6" data-theme-preview>
            <div class="mb-4 flex items-center justify-between">
              <p class="text-xs font-semibold uppercase tracking-wide text-body-muted">Live Preview</p>
              <p class="text-xs text-body-muted" data-preview-scope-label>Global Theme</p>
            </div>

            <!-- Global Preview -->
            <div class="space-y-4" data-preview-content="global">
              <!-- Card Preview -->
              <article class="rounded-xl border p-5 shadow-sm space-y-4" style="background: var(--preview-card-surface); border-color: var(--preview-card-border);">
                <div class="flex items-center gap-2">
                  <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-1 rounded-full" style="background: var(--preview-badge-bg); border: 1px solid var(--preview-badge-border); color: var(--preview-badge-text);">
                    Badge
                  </span>
                  <span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-1 rounded-full" style="background: var(--preview-tag-bg); border: 1px solid var(--preview-tag-border); color: var(--preview-tag-text);">
                    Tag
                  </span>
                </div>
                <h3 class="text-2xl font-semibold" style="color: var(--preview-text-heading);">
                  Soft rituals for tired hearts
                </h3>
                <p class="text-sm leading-relaxed" style="color: var(--preview-text-primary);">
                  This preview shows how your theme colors work together. Adjust the values above to see changes instantly.
                </p>
                <p class="text-sm" style="color: var(--preview-text-secondary);">
                  Secondary text appears slightly muted for hierarchy.
                </p>
                <p class="text-xs" style="color: var(--preview-text-muted);">
                  Muted text for hints and supplementary information.
                </p>
                <a href="#" class="text-sm underline" style="color: var(--preview-link);">Example link text</a>
              </article>

              <!-- Status Colors Preview -->
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div class="p-3 rounded-lg text-center text-xs font-medium" style="background: var(--preview-success); color: white;">
                  Success
                </div>
                <div class="p-3 rounded-lg text-center text-xs font-medium" style="background: var(--preview-warning); color: white;">
                  Warning
                </div>
                <div class="p-3 rounded-lg text-center text-xs font-medium" style="background: var(--preview-error); color: white;">
                  Error
                </div>
                <div class="p-3 rounded-lg text-center text-xs font-medium" style="background: var(--preview-info); color: white;">
                  Info
                </div>
              </div>
            </div>

            <!-- Entity Grimoire Preview -->
            <div class="space-y-4 hidden" data-preview-content="grimoire">
              <article class="rounded-xl border p-6 shadow-lg space-y-4 relative overflow-hidden"
                style="background: linear-gradient(135deg, var(--preview-entity-surface-top) 0%, var(--preview-entity-surface-bottom) 100%);
                        border-color: var(--preview-entity-border);
                        box-shadow: 0 0 20px var(--preview-entity-glow);">

                <!-- Ribbon -->
                <div class="absolute top-0 right-0 px-4 py-2 rounded-bl-xl"
                  style="background: var(--preview-entity-label); border-left: 1px solid var(--preview-entity-border); border-bottom: 1px solid var(--preview-entity-border);">
                  <span class="text-[10px] font-semibold uppercase tracking-wide" style="color: var(--preview-entity-text);">
                    🔮 Crystal
                  </span>
                </div>

                <!-- Icon with glow -->
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full"
                  style="background: var(--preview-entity-icon); box-shadow: 0 4px 16px var(--preview-entity-icon-shadow);">
                  <span class="text-2xl">💎</span>
                </div>

                <!-- Content -->
                <h3 class="text-2xl font-semibold" style="color: var(--preview-entity-heading);">
                  Amethyst's Whisper
                </h3>
                <p class="text-sm leading-relaxed" style="color: var(--preview-entity-text);">
                  A crystal of tranquility and spiritual connection, amethyst calms the mind and opens pathways to higher wisdom.
                </p>

                <!-- CTA Button -->
                <button type="button" class="px-4 py-2 rounded-full text-sm font-semibold transition-all"
                  style="background: var(--preview-entity-cta); color: white;"
                  onmouseover="this.style.background = 'var(--preview-entity-cta-hover)'"
                  onmouseout="this.style.background = 'var(--preview-entity-cta)'">
                  Explore →
                </button>
              </article>

              <p class="text-xs text-body-muted text-center">
                Preview of Entity Grimoire card styling
              </p>
            </div>

            <!-- Header Preview -->
            <div class="space-y-4 hidden" data-preview-content="header">
              <div class="rounded-xl border p-4 shadow-sm" style="background: var(--preview-card-surface); border-color: var(--preview-card-border);">
                <div class="flex items-center justify-between">
                  <h3 class="text-xl font-semibold" style="color: var(--preview-text-heading);">Site Header</h3>
                  <nav class="flex gap-4">
                    <a href="#" class="text-sm" style="color: var(--preview-link);">Home</a>
                    <a href="#" class="text-sm" style="color: var(--preview-link);">About</a>
                    <a href="#" class="text-sm" style="color: var(--preview-link);">Grimoire</a>
                  </nav>
                </div>
              </div>
              <p class="text-xs text-body-muted text-center">
                Preview of header styling (navigation bar)
              </p>
            </div>

            <!-- Generic Component Preview -->
            <div class="space-y-4 hidden" data-preview-content="default">
              <article class="rounded-xl border p-5 shadow-sm space-y-3" style="background: var(--preview-card-surface); border-color: var(--preview-card-border);">
                <h3 class="text-lg font-semibold" style="color: var(--preview-text-heading);">
                  Component Preview
                </h3>
                <p class="text-sm" style="color: var(--preview-text-primary);">
                  This shows how your colors will look on this component. Customize colors above to style this specific area.
                </p>
                <div class="flex gap-2">
                  <span class="text-xs px-3 py-1 rounded-full" style="background: var(--preview-badge-bg); border: 1px solid var(--preview-badge-border); color: var(--preview-badge-text);">
                    Element
                  </span>
                  <span class="text-xs px-3 py-1 rounded-full" style="background: var(--preview-tag-bg); border: 1px solid var(--preview-tag-border); color: var(--preview-tag-text);">
                    Style
                  </span>
                </div>
              </article>
            </div>
          </div>

          <!-- Contrast Checker -->
          <div class="rounded-lg border border-line-subtle bg-surface-soft/50 p-4" data-contrast-display>
            <!-- Populated by JS -->
          </div>

          <!-- Action Buttons -->
          <div class="rounded-2xl border border-line-neutral bg-surface-base p-5 shadow-sm">
            <div class="flex flex-wrap gap-2 mb-3">
              <button
                type="button"
                id="saveThemeBtn"
                class="rounded-lg bg-success px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition"
                title="Save (Ctrl+S)"
              >
                💾 Save Theme
              </button>
              <button
                type="button"
                id="setActiveThemeBtn"
                class="rounded-lg bg-info px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition"
              >
                ⭐ Set as Active
              </button>
              <button
                type="button"
                id="duplicateThemeBtn"
                class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft transition"
              >
                📋 Duplicate
              </button>
              <button
                type="button"
                id="deleteThemeBtn"
                class="rounded-lg border border-danger px-4 py-2 text-sm font-medium text-danger hover:bg-danger hover:text-white transition"
              >
                🗑️ Delete
              </button>
              <div class="flex-grow"></div>
              <button
                type="button"
                id="exportBtn"
                class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft transition"
              >
                ⬇️ Export
              </button>
              <button
                type="button"
                id="exportAllBtn"
                class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft transition"
              >
                ⬇️ Export All
              </button>
              <button
                type="button"
                id="importBtn"
                class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft transition"
              >
                ⬆️ Import
              </button>
              <input type="file" id="importInput" accept=".json" class="hidden" />
            </div>

            <p class="text-sm" data-status></p>

            <div class="mt-3 p-4 rounded-lg bg-surface-soft border border-line-subtle text-xs text-body-muted space-y-2">
              <p><strong>💡 Keyboard shortcuts:</strong></p>
              <ul class="list-disc list-inside space-y-1 ml-2">
                <li><kbd class="px-1 py-0.5 bg-surface-base border border-line-neutral rounded">Ctrl+S</kbd> — Save theme</li>
                <li><kbd class="px-1 py-0.5 bg-surface-base border border-line-neutral rounded">Ctrl+Z</kbd> — Undo</li>
                <li><kbd class="px-1 py-0.5 bg-surface-base border border-line-neutral rounded">Ctrl+Y</kbd> — Redo</li>
              </ul>
            </div>
          </div>
        </section>
      </div>

      <div class="space-y-6 hidden" data-theme-panel="tokens" hidden>
        <section class="rounded-2xl border border-line-neutral bg-surface-base p-6 shadow-sm space-y-5">
          <header class="space-y-1">
            <h1 class="text-xl font-semibold text-primary">Global Color Tokens</h1>
            <p class="text-sm text-body-muted">
              Edit the typography token palette that powers <code>base.css</code> and <code>tokens.css</code>. Changes apply to all
              components once saved.
            </p>
          </header>

          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wide text-body-muted">Comfort mode:</span>
            <button
              type="button"
              class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium transition data-[active='true']:bg-info data-[active='true']:text-white"
              data-token-mode="midnight"
              data-active="true"
            >
              🌙 Midnight (dark)
            </button>
            <button
              type="button"
              class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium transition hover:bg-surface-soft"
              data-token-mode="dawn"
            >
              🌅 Dawn (light)
            </button>
            <button
              type="button"
              class="ml-auto inline-flex items-center gap-2 rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium transition hover:bg-surface-soft"
              id="resetColorTokensBtn"
            >
              ↺ Reset from disk
            </button>
          </div>

          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-token-fields>
            {COLOR_TOKEN_FIELDS.map((field) => (
              <label class="block text-sm" data-token-field={field.key}>
                <span class="text-xs font-medium uppercase tracking-wide text-body-muted flex items-center gap-2">
                  {field.label}
                  {field.description && (
                    <span class="text-[10px] normal-case font-normal opacity-75">({field.description})</span>
                  )}
                </span>
                <div class="mt-1 flex items-center gap-2">
                  <input
                    type="color"
                    class="h-9 w-12 rounded border border-line-neutral cursor-pointer"
                    data-token-picker={field.key}
                  />
                  <input
                    type="text"
                    class="flex-1 rounded-lg border border-line-neutral px-3 py-2 font-mono text-sm"
                    data-token-input={field.key}
                    placeholder={field.placeholder}
                  />
                </div>
              </label>
            ))}
          </div>

          <div class="rounded-xl border border-line-subtle bg-surface-soft/60 p-4">
            <p class="text-xs text-body-muted">Preview</p>
            <div class="mt-3 space-y-2" data-token-preview>
              <h2 class="text-xl font-semibold" data-token-preview-heading>Heading Example</h2>
              <p class="text-sm" data-token-preview-body>
                This paragraph reflects <code>--text-body</code> and updates live as you edit. Muted captions update below.
              </p>
              <p class="text-xs" data-token-preview-muted>
                Hint text uses <code>--text-muted</code> and <code>--text-subtle</code> tokens.
              </p>
              <a href="#" class="text-sm underline" data-token-preview-link>
                Sample link color
              </a>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button
              type="button"
              class="rounded-lg bg-success px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition"
              id="saveColorTokensBtn"
              disabled
            >
              💾 Save color tokens
            </button>
            <p class="text-sm text-body-muted" data-token-status></p>
          </div>
        </section>
      </div>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">This dashboard is only available in development mode or with a valid admin key.</p>
    </section>
  )}

  {canUse && (
    <script>
      import '@/lib/theme-editor';
      import '@/lib/color-token-editor';
    </script>
  )}

  <style>
    [data-theme-preview] {
      --preview-card-surface: #1a0d2e;
      --preview-card-border: rgba(212, 175, 55, 0.32);
      --preview-text-primary: rgba(244, 241, 255, 0.96);
      --preview-text-secondary: rgba(244, 241, 255, 0.85);
      --preview-text-heading: #ffffff;
      --preview-text-muted: #d9b2c4;
      --preview-link: #e0c07d;
      --preview-badge-bg: rgba(212, 175, 55, 0.30);
      --preview-badge-border: rgba(212, 175, 55, 0.55);
      --preview-badge-text: #f8f3ff;
      --preview-tag-bg: rgba(75, 42, 99, 0.26);
      --preview-tag-border: rgba(75, 42, 99, 0.42);
      --preview-tag-text: #f4f1ff;
      --preview-success: #4ade80;
      --preview-warning: #fbbf24;
      --preview-error: #f87171;
      --preview-info: #60a5fa;
      transition: all 0.3s ease;
    }

    details[open] > summary {
      margin-bottom: 0;
    }

    summary {
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    summary::before {
      content: '▶';
      display: inline-block;
      margin-right: 0.5rem;
      transition: transform 0.2s;
      font-size: 0.75rem;
    }

    details[open] > summary::before {
      transform: rotate(90deg);
    }

    kbd {
      font-family: ui-monospace, monospace;
      font-size: 0.75rem;
    }
  </style>
</Base>
