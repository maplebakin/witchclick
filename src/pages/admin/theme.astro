    .badge.warn { background: color-mix(in srgb, hsl(var(--amber-3)) 28%, transparent); border-color: color-mix(in srgb, hsl(var(--amber-3)) 55%, transparent); }

    button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .55rem .9rem; font: inherit; border-radius: var(--radius-1); border: 1px solid var(--border-subtle); color: var(--text-body); background: var(--surface-panel); box-shadow: var(--shadow-1); transition: box-shadow var(--dur-med) var(--ease-out-curve), transform var(--dur-med) var(--ease-out-curve); }
    button:hover { box-shadow: var(--shadow-2); transform: translateY(-1px); }
    button.primary { background: hsl(var(--accent-3)); color: var(--text-strong); border-color: color-mix(in srgb, hsl(var(--accent-3)) 60%, transparent); }
    button.danger  { background: hsl(var(--red-3)); color: white; border-color: color-mix(in srgb, hsl(var(--red-3)) 60%, transparent); }
    button.ghost   { background: transparent; border-color: var(--border-subtle); }
    button.accent  { background: hsl(var(--accent-1)); color: var(--text-strong); border-color: color-mix(in srgb, hsl(var(--accent-1)) 60%, transparent); }

    .status-row { display: flex; gap: var(--space-4); align-items: center; color: var(--text-muted); margin-top: var(--space-4); }
    .dot { display: inline-block; width: .75rem; height: .75rem; border-radius: 50%; vertical-align: middle; margin-right: .35rem; border: 1px solid var(--border-subtle); }
    .dot.success { background: var(--success, hsl(var(--green-3))); } .dot.warn { background: var(--warning, hsl(var(--amber-3))); } .dot.error { background: var(--error, hsl(var(--red-3))); } .dot.info { background: var(--info, color-mix(in srgb, hsl(var(--accent-1)) 55%, white 45%)); }

    .tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: var(--space-3); }
    .tag { padding: .25rem .5rem; border-radius: var(--radius-pill); background: color-mix(in srgb, hsl(var(--accent-2)) 26%, transparent); border: 1px solid color-mix(in srgb, hsl(var(--accent-2)) 42%, transparent); color: var(--text-body); font-size: .8rem; }

    .export-row { display: flex; gap: var(--space-3); flex-wrap: wrap; }

    /* tiny toast */
    :global(.toast) { position: fixed; inset: auto 16px 16px auto; background: var(--surface-elevated); border: 1px solid var(--border-subtle); color: hsl(var(--text-strong)); padding: .6rem .9rem; border-radius: var(--radius-1); box-shadow: var(--shadow-2); opacity: 0; transform: translateY(8px); transition: 180ms ease; z-index: 999; }
