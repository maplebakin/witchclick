---
// src/pages/admin/theme.astro
// Theme Lab — build themes, live preview, save to library, and Launch site-wide.

import Base from "@/layouts/Base.astro";
import themesSeed from "@/data/themes.generated.json";

const title = "Theme";
const _themesSeedJson = JSON.stringify(themesSeed);
---

<Base title={`Admin · ${title}`}>
  <!-- Seed themes JSON so client script can read it -->
  <script type="application/json" id="themesSeed">{_themesSeedJson}</script>

  <main class="wc-container wc-narrow" data-theme-preview>
    <header class="page-head">
      <h1>Theme Editor (HEX)</h1>
      <p class="subtitle">Make a theme, preview it like a real page, save it, and launch it site-wide.</p>
    </header>

    <!-- =========================
         THEME LIBRARY
    ========================== -->
    <section class="panel card-panel">
      <h2>Theme Library</h2>
      <div class="lib-actions">
        <button id="libExportAll" class="ghost">Export All Themes JSON</button>
        <button id="libNewTheme" class="primary">Save As New Theme</button>
        <button id="libUpdateTheme" class="ghost">Update Selected Theme</button>
        <button id="libLaunchTheme" class="accent">Launch Theme (site-wide)</button>
        <button id="libRevertTheme" class="ghost">Revert to Default</button>
      </div>

      <div class="library">
        <div class="library-list">
          <table class="theme-table">
            <thead>
              <tr><th>Name</th><th>ID</th><th>Mode</th><th>Actions</th></tr>
            </thead>
            <tbody id="themeRows"></tbody>
          </table>
        </div>

        <div class="library-detail">
          <label class="stack">
            <span>Theme Name</span>
            <input id="libName" type="text" placeholder="Cozy Midnight" />
          </label>
          <label class="stack">
            <span>Theme ID</span>
            <input id="libId" type="text" placeholder="cozy-midnight" />
          </label>
          <label class="stack">
            <span>Mode</span>
            <select id="libMode"><option value="dark">dark</option><option value="light">light</option></select>
          </label>
        </div>
      </div>
      <p class="hint">Select a theme → <b>Load</b> to preview, <b>Duplicate</b> to branch, <b>Remove</b> to prune. “Launch Theme” applies it across the site using a tiny loader in <code>Base.astro</code>.</p>
    </section>

    <!-- =========================
         MODE
    ========================== -->
    <section class="panel card-panel">
      <h2>Mode</h2>
      <div class="controls-grid">
        <label>
          <span>Mode</span>
          <select id="themeMode">
            <option value="midnight">Cozy Midnight (dark)</option>
            <option value="dawn">Cozy Dawn (light)</option>
          </select>
        </label>
      </div>
      <p class="hint">Sets <code>data-theme="cozy-midnight|cozy-dawn"</code> on <code>:root</code> (and syncs legacy <code>data-comfort-theme</code>).</p>
    </section>

    <!-- =========================
         ACCENTS (HEX)
    ========================== -->
    <section class="panel card-panel">
      <h2>Accents</h2>
      <div class="controls-grid">
        <label><span>Accent 1</span><input type="color" id="accent1Picker" /><input type="text" id="accent1Hex" placeholder="#b48cff" /></label>
        <label><span>Accent 2</span><input type="color" id="accent2Picker" /><input type="text" id="accent2Hex" placeholder="#9f73ff" /></label>
        <label><span>Accent 3</span><input type="color" id="accent3Picker" /><input type="text" id="accent3Hex" placeholder="#7e5bff" /></label>
      </div>
      <div class="swatch-row">
        <div class="swatch" data-swatch="accent-1"><span>--accent-1</span></div>
        <div class="swatch" data-swatch="accent-2"><span>--accent-2</span></div>
        <div class="swatch" data-swatch="accent-3"><span>--accent-3</span></div>
      </div>
    </section>

    <!-- =========================
         SURFACES / TEXT / BORDERS (HEX + ALPHA)
    ========================== -->
    <section class="panel card-panel">
      <h2>Core Tokens</h2>

      <h3>Surfaces</h3>
      <div class="controls-grid">
        <label><span>Surface Base</span><input type="color" id="surfaceBasePicker" /><input type="text" id="surfaceBaseHex" placeholder="#0f0a14" /><input type="range" id="surfaceBaseAlpha" min="0" max="100" value="100" /><small>Alpha</small></label>
        <label><span>Surface Panel</span><input type="color" id="surfacePanelPicker" /><input type="text" id="surfacePanelHex" placeholder="#140c18" /><input type="range" id="surfacePanelAlpha" min="0" max="100" value="92" /><small>Alpha</small></label>
        <label><span>Surface Card</span><input type="color" id="surfaceCardPicker" /><input type="text" id="surfaceCardHex" placeholder="#140c18" /><input type="range" id="surfaceCardAlpha" min="0" max="100" value="84" /><small>Alpha</small></label>
        <label><span>Surface Elevated</span><input type="color" id="surfaceElevatedPicker" /><input type="text" id="surfaceElevatedHex" placeholder="#1c1522" /><input type="range" id="surfaceElevatedAlpha" min="0" max="100" value="90" /><small>Alpha</small></label>
        <label><span>Surface Hover</span><input type="color" id="surfaceHoverPicker" /><input type="text" id="surfaceHoverHex" placeholder="#2a2035" /><input type="range" id="surfaceHoverAlpha" min="0" max="100" value="78" /><small>Alpha</small></label>
      </div>

      <h3>Text</h3>
      <div class="controls-grid">
        <label><span>Text Strong</span><input type="color" id="textStrongPicker" /><input type="text" id="textStrongHex" placeholder="#ffffff" /><input type="range" id="textStrongAlpha" min="0" max="100" value="98" /><small>Alpha</small></label>
        <label><span>Text Body</span><input type="color" id="textBodyPicker" /><input type="text" id="textBodyHex" placeholder="#f6f2ff" /><input type="range" id="textBodyAlpha" min="0" max="100" value="90" /><small>Alpha</small></label>
        <label><span>Text Muted</span><input type="color" id="textMutedPicker" /><input type="text" id="textMutedHex" placeholder="#e3daf6" /><input type="range" id="textMutedAlpha" min="0" max="100" value="75" /><small>Alpha</small></label>
      </div>

      <h3>Borders</h3>
      <div class="controls-grid">
        <label><span>Border Subtle</span><input type="color" id="borderSubtlePicker" /><input type="text" id="borderSubtleHex" placeholder="#2b2840" /><input type="range" id="borderSubtleAlpha" min="0" max="100" value="42" /><small>Alpha</small></label>
        <label><span>Border Strong</span><input type="color" id="borderStrongPicker" /><input type="text" id="borderStrongHex" placeholder="#6f658c" /><input type="range" id="borderStrongAlpha" min="0" max="100" value="60" /><small>Alpha</small></label>
      </div>
    </section>

    <!-- =========================
         SITE CHROME (Headers & Footers)
    ========================== -->
    <section class="panel card-panel">
      <h2>Site Chrome</h2>

      <h3>Page Background</h3>
      <div class="controls-grid">
        <label><span>Page Background</span><input type="color" id="pageBgPicker" /><input type="text" id="pageBgHex" placeholder="#07020f" /><input type="range" id="pageBgAlpha" min="0" max="100" value="100" /><small>Alpha</small></label>
      </div>

      <h3>Header</h3>
      <div class="controls-grid">
        <label><span>Header Background</span><input type="color" id="headerBgPicker" /><input type="text" id="headerBgHex" placeholder="#1a0f1f" /><input type="range" id="headerBgAlpha" min="0" max="100" value="58" /><small>Alpha</small></label>
        <label><span>Header Border</span><input type="color" id="headerBorderPicker" /><input type="text" id="headerBorderHex" placeholder="#3d2a52" /><input type="range" id="headerBorderAlpha" min="0" max="100" value="42" /><small>Alpha</small></label>
      </div>

      <h3>Footer</h3>
      <div class="controls-grid">
        <label><span>Footer Background</span><input type="color" id="footerBgPicker" /><input type="text" id="footerBgHex" placeholder="#07020f" /><input type="range" id="footerBgAlpha" min="0" max="100" value="85" /><small>Alpha</small></label>
        <label><span>Footer Border</span><input type="color" id="footerBorderPicker" /><input type="text" id="footerBorderHex" placeholder="#7a5e9a" /><input type="range" id="footerBorderAlpha" min="0" max="100" value="30" /><small>Alpha</small></label>
      </div>
      <p class="hint">These control the appearance of the site background, header, and footer across all pages.</p>
    </section>

    <!-- =========================
         STATUS COLORS
    ========================== -->
    <section class="panel card-panel">
      <h2>Status Colors</h2>
      <div class="controls-grid">
        <label><span>Success</span><input type="color" id="successPicker" /><input type="text" id="successHex" placeholder="#4ade80" /></label>
        <label><span>Warning</span><input type="color" id="warningPicker" /><input type="text" id="warningHex" placeholder="#facc15" /></label>
        <label><span>Error</span><input type="color" id="errorPicker" /><input type="text" id="errorHex" placeholder="#f87171" /></label>
        <label><span>Info</span><input type="color" id="infoPicker" /><input type="text" id="infoHex" placeholder="#60a5fa" /></label>
      </div>
      <div class="status-row" style="margin-top: var(--space-3);">
        <span class="dot success"></span> Success
        <span class="dot warn"></span> Warning
        <span class="dot error"></span> Error
        <span class="dot info"></span> Info
      </div>
      <p class="hint">These colors are used for status indicators, alerts, and feedback messages.</p>
    </section>

    <!-- =========================
         PREVIEW CONTROLS (optional)
    ========================== -->
    <section class="panel card-panel">
      <h2>Preview Toggles</h2>
      <div class="controls-grid">
        <fieldset class="stack">
          <legend>Card Text Color (preview)</legend>
          <div class="radio-row">
            <label class="radio"><input type="radio" name="cardText" value="strong" checked /> <span>Strong</span></label>
            <label class="radio"><input type="radio" name="cardText" value="body" /> <span>Body</span></label>
            <label class="radio"><input type="radio" name="cardText" value="muted" /> <span>Muted</span></label>
            <label class="radio"><input type="radio" name="cardText" value="accent" /> <span>Accent</span></label>
            <label class="radio"><input type="radio" name="cardText" value="custom" /> <span>Custom</span></label>
          </div>
        </fieldset>
        <label id="customCardTextBlock" style="display:none;">
          <span>Custom HEX (Card Text)</span>
          <input type="color" id="cardTextPicker" />
          <input type="text" id="cardTextHex" placeholder="#aaccff" />
        </label>

        <fieldset class="stack">
          <legend>Heading Text Color (preview)</legend>
          <div class="radio-row">
            <label class="radio"><input type="radio" name="headingText" value="strong" checked /> <span>Strong</span></label>
            <label class="radio"><input type="radio" name="headingText" value="body" /> <span>Body</span></label>
            <label class="radio"><input type="radio" name="headingText" value="muted" /> <span>Muted</span></label>
            <label class="radio"><input type="radio" name="headingText" value="accent" /> <span>Accent</span></label>
            <label class="radio"><input type="radio" name="headingText" value="custom" /> <span>Custom</span></label>
          </div>
        </fieldset>
        <label id="customHeadingTextBlock" style="display:none;">
          <span>Custom HEX (Heading)</span>
          <input type="color" id="headingTextPicker" />
          <input type="text" id="headingTextHex" placeholder="#ffd27a" />
        </label>
      </div>
      <p class="hint">These toggles only affect the preview.</p>
    </section>

    <!-- =========================
         PREVIEW (page-like)
    ========================== -->
    <section class="panel card-panel">
      <h2>Preview</h2>
      <p class="hint">This simulates a page: base background, a centered container, headings, body text, tags, and buttons.</p>

      <div class="page-preview">
        <div class="page-bg">
          <div class="page-container">
            <h3 class="preview-heading">Container Heading</h3>
            <p class="preview-body">This is body copy inside a container on <code>--surface-panel</code>. Borders, buttons, and tags below use your tokens.</p>

            <div class="cards">
              <div class="demo-card">
                <div class="badge">New</div>
                <h4>Soft Card</h4>
                <p>Surface: <code>--surface-card</code></p>
                <button class="ghost">Ghost</button>
              </div>

              <div class="demo-card elevated">
                <div class="badge alt">Info</div>
                <h4>Elevated Card</h4>
                <p>Surface: <code>--surface-elevated</code></p>
                <button class="primary">Primary</button>
              </div>

              <div class="demo-card focusable" tabindex="0">
                <div class="badge warn">Warn</div>
                <h4>Focusable Card</h4>
                <p>Check focus ring (<code>--ring-focus</code>).</p>
                <button class="danger">Danger</button>
              </div>
            </div>

            <div class="status-row">
              <span class="dot success"></span> Success
              <span class="dot warn"></span> Warning
              <span class="dot error"></span> Error
              <span class="dot info"></span> Info
            </div>

            <div class="tags">
              <span class="tag">entity</span>
              <span class="tag">ritual</span>
              <span class="tag">printable</span>
              <span class="tag">cozy</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         EXPORTS
    ========================== -->
    <section class="panel card-panel">
      <h2>Export</h2>
      <div class="export-row">
        <button id="exportThemeJson" class="primary">Export Theme JSON (active mode)</button>
        <button id="exportColorTokens" class="ghost">Export color-tokens.generated.css</button>
      </div>
      <p class="hint">Commit exported files if you want a build-time default. “Launch Theme” controls runtime.</p>
    </section>
  </main>

<script>
// ===== Utilities (HEX ↔ HSL) =====
const $ = (s) => document.querySelector(s);
const root = document.documentElement;

function clamp01(n) { return Math.min(1, Math.max(0, n)); }

function hexNormalize(str) {
  if (!str) return null;
  let v = str.trim().toLowerCase();
  if (!v.startsWith("#")) v = "#" + v;
  if (!/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v)) return null;
  if (v.length === 4) v = "#" + v.slice(1).split("").map(c => c + c).join("");
  return v;
}

function hexToRgb(hex) {
  const h = hexNormalize(hex);
  if (!h) return null;
  const num = parseInt(h.slice(1), 16);
  return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
}
function rgbToHex(r, g, b) {
  const to2 = (v) => v.toString(16).padStart(2, "0");
  return "#" + to2(r) + to2(g) + to2(b);
}
function rgbToHslObj(r, g, b) {
  r /= 255; g /= 255; b /= 255;
  const max = Math.max(r, g, b), min = Math.min(r, g, b);
  let h, s, l = (max + min) / 2;
  const d = max - min;
  if (d === 0) { h = 0; s = 0; }
  else {
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = (g - b) / d + (g < b ? 6 : 0); break;
      case g: h = (b - r) / d + 2; break;
      case b: h = (r - g) / d + 4; break; // ← fixed
    }
    h /= 6;
  }
  return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
}
function hexToHslString(hex, alphaPct = 100) {
  const rgb = hexToRgb(hex);
  if (!rgb) return null;
  const { h, s, l } = rgbToHslObj(rgb.r, rgb.g, rgb.b);
  const a = clamp01(alphaPct / 100);
  return `hsl(${h} ${s}% ${l}% / ${a})`;
}
function hslToRgb(h, s, l) {
  s /= 100; l /= 100;
  const k = n => (n + h/30) % 12;
  const a = s * Math.min(l, 1 - l);
  const f = n => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
  return { r: Math.round(255 * f(0)), g: Math.round(255 * f(8)), b: Math.round(255 * f(4)) };
}
function hslToHex(h, s, l) {
  const { r, g, b } = hslToRgb(h, s, l);
  return rgbToHex(r, g, b);
}
function hslStrToHex(hslStr) {
  try {
    const nums = hslStr.replace(/[^\d\s.]/g, " ").trim().split(/\s+/).map(Number);
    const [h, s, l] = nums;
    return hslToHex(h, s, l);
  } catch { return "#000000"; }
}
function rgbStrToHex(rgbStr) {
  try {
    const nums = rgbStr.replace(/[^\d\s.]/g, " ").trim().split(/\s+/).map(Number);
    const [r, g, b] = nums;
    return rgbToHex(Math.round(r), Math.round(g), Math.round(b));
  } catch { return "#000000"; }
}
function anyColorToHex(colorStr) {
  if (!colorStr) return "#000000";
  const str = colorStr.trim();
  if (str.startsWith("rgb")) return rgbStrToHex(str);
  if (str.startsWith("hsl")) return hslStrToHex(str);
  if (str.startsWith("#")) return hexNormalize(str) || "#000000";
  // Try as hsl without prefix
  return hslStrToHex(`hsl(${str})`);
}

function setVar(name, value) {
  if (!name || value == null || value === "") return;
  root.style.setProperty(name, value);
}
function getVar(name) {
  const cs = getComputedStyle(root);
  return cs.getPropertyValue(name).trim();
}

// ===== Theme attr bridge =====
function applyThemeAttr(mode) {
  const id = mode === 'dawn' ? 'cozy-dawn' : 'cozy-midnight';
  root.setAttribute('data-theme', id);
  root.setAttribute('data-comfort-theme', mode); // legacy sync
  try { localStorage.setItem('theme-mode', mode); } catch {}
}

// ===== HEX input visuals =====
function setHexVisual(textEl, hex) {
  const hx = hexNormalize(hex);
  if (!hx) { textEl.style.boxShadow = ""; textEl.style.borderColor = ""; return; }
  textEl.style.boxShadow = `inset 0 0 0 2px ${hx}`;
  textEl.style.borderColor = hx;
}

// ===== Derived accent vars for live preview =====
function updateDerivedAccentVars() {
  const a1 = `hsl(${getVar("--accent-1")})`;
  setVar("--text-accent", a1.replace(/^hsl\(|\)$/g, ""));  // bare h s% l% / a
  setVar("--ring-focus", `0 0 0 3px ${a1}`);
  setVar("--link-color", a1);
}

// ===== Nodes =====
const nodes = {
  // library
  themeRows: $("#themeRows"), libName: $("#libName"), libId: $("#libId"), libMode: $("#libMode"),
  libExportAll: $("#libExportAll"), libNewTheme: $("#libNewTheme"), libUpdateTheme: $("#libUpdateTheme"),
  libLaunchTheme: $("#libLaunchTheme"), libRevertTheme: $("#libRevertTheme"),

  // mode
  mode: $("#themeMode"),

  // accents
  accent1Picker: $("#accent1Picker"), accent1Hex: $("#accent1Hex"),
  accent2Picker: $("#accent2Picker"), accent2Hex: $("#accent2Hex"),
  accent3Picker: $("#accent3Picker"), accent3Hex: $("#accent3Hex"),

  // surfaces
  surfaceBasePicker: $("#surfaceBasePicker"), surfaceBaseHex: $("#surfaceBaseHex"), surfaceBaseAlpha: $("#surfaceBaseAlpha"),
  surfacePanelPicker: $("#surfacePanelPicker"), surfacePanelHex: $("#surfacePanelHex"), surfacePanelAlpha: $("#surfacePanelAlpha"),
  surfaceCardPicker: $("#surfaceCardPicker"), surfaceCardHex: $("#surfaceCardHex"), surfaceCardAlpha: $("#surfaceCardAlpha"),
  surfaceElevatedPicker: $("#surfaceElevatedPicker"), surfaceElevatedHex: $("#surfaceElevatedHex"), surfaceElevatedAlpha: $("#surfaceElevatedAlpha"),
  surfaceHoverPicker: $("#surfaceHoverPicker"), surfaceHoverHex: $("#surfaceHoverHex"), surfaceHoverAlpha: $("#surfaceHoverAlpha"),

  // text
  textStrongPicker: $("#textStrongPicker"), textStrongHex: $("#textStrongHex"), textStrongAlpha: $("#textStrongAlpha"),
  textBodyPicker: $("#textBodyPicker"), textBodyHex: $("#textBodyHex"), textBodyAlpha: $("#textBodyAlpha"),
  textMutedPicker: $("#textMutedPicker"), textMutedHex: $("#textMutedHex"), textMutedAlpha: $("#textMutedAlpha"),

  // borders
  borderSubtlePicker: $("#borderSubtlePicker"), borderSubtleHex: $("#borderSubtleHex"), borderSubtleAlpha: $("#borderSubtleAlpha"),
  borderStrongPicker: $("#borderStrongPicker"), borderStrongHex: $("#borderStrongHex"), borderStrongAlpha: $("#borderStrongAlpha"),

  // site chrome (page/header/footer)
  pageBgPicker: $("#pageBgPicker"), pageBgHex: $("#pageBgHex"), pageBgAlpha: $("#pageBgAlpha"),
  headerBgPicker: $("#headerBgPicker"), headerBgHex: $("#headerBgHex"), headerBgAlpha: $("#headerBgAlpha"),
  headerBorderPicker: $("#headerBorderPicker"), headerBorderHex: $("#headerBorderHex"), headerBorderAlpha: $("#headerBorderAlpha"),
  footerBgPicker: $("#footerBgPicker"), footerBgHex: $("#footerBgHex"), footerBgAlpha: $("#footerBgAlpha"),
  footerBorderPicker: $("#footerBorderPicker"), footerBorderHex: $("#footerBorderHex"), footerBorderAlpha: $("#footerBorderAlpha"),

  // status colors
  successPicker: $("#successPicker"), successHex: $("#successHex"),
  warningPicker: $("#warningPicker"), warningHex: $("#warningHex"),
  errorPicker: $("#errorPicker"), errorHex: $("#errorHex"),
  infoPicker: $("#infoPicker"), infoHex: $("#infoHex"),

  // preview controls
  cardTextRadios: document.getElementsByName("cardText"),
  customCardTextBlock: $("#customCardTextBlock"),
  cardTextPicker: $("#cardTextPicker"),
  cardTextHex: $("#cardTextHex"),
  headingTextRadios: document.getElementsByName("headingText"),
  customHeadingTextBlock: $("#customHeadingTextBlock"),
  headingTextPicker: $("#headingTextPicker"),
  headingTextHex: $("#headingTextHex"),

  // export
  exportThemeJson: $("#exportThemeJson"), exportColorTokens: $("#exportColorTokens"),
};

// ===== Bind helpers =====
function bindHexPair(colorEl, textEl, onChange) {
  colorEl.addEventListener("input", () => {
    textEl.value = colorEl.value; setHexVisual(textEl, textEl.value); onChange();
  });
  textEl.addEventListener("input", () => {
    const norm = hexNormalize(textEl.value);
    if (norm) colorEl.value = norm;
    setHexVisual(textEl, textEl.value); onChange();
  });
  setHexVisual(textEl, textEl.value || colorEl.value);
}

function applyAccent(hexId, varName) {
  const hex = nodes[hexId].value;
  const hsl = hexToHslString(hex, 100);
  if (hsl) {
    const just = hsl.replace(/^hsl\(|\)$/g, "");
    setVar(varName, just);
    refreshPreviewAll(); // <- centralize
  }
}

function applyStatusColor(hexNode, varName) {
  const hex = hexNode.value;
  if (hex && /^#[0-9a-fA-F]{6}$/.test(hex)) {
    setVar(varName, hex);
    refreshPreviewAll();
  }
}


function applyCore(hexNode, alphaNode, varName) {
  const hex = hexNode.value;
  const a = parseInt(alphaNode.value || "100", 10);
  const hsl = hexToHslString(hex, a);
  if (hsl) {
    setVar(varName, hsl.replace(/^hsl\(|\)$/g, ""));
    refreshPreviewAll(); // <- live update
  }
}


function paintAccentSwatches() {
  const a1 = `hsl(${getVar("--accent-1")})`;
  const a2 = `hsl(${getVar("--accent-2")})`;
  const a3 = `hsl(${getVar("--accent-3")})`;
  document.querySelectorAll("[data-swatch='accent-1']").forEach(el => el.style.setProperty("--bg", a1));
  document.querySelectorAll("[data-swatch='accent-2']").forEach(el => el.style.setProperty("--bg", a2));
  document.querySelectorAll("[data-swatch='accent-3']").forEach(el => el.style.setProperty("--bg", a3));
}

// ===== Preview (card body) text color =====
function tokenToVar(v) {
  const raw = getVar(v);
  return raw || "";
}
function setPreviewTextFromToken(tokenVar) {
  const v = tokenToVar(tokenVar);
  if (v) setVar("--preview-card-text", v);
}
function setPreviewTextFromAccent() {
  const a1 = `hsl(${getVar("--accent-1")})`;
  setVar("--preview-card-text", a1.replace(/^hsl\(|\)$/g, ""));
}
function setPreviewTextFromHex(hex) {
  const hsl = hexToHslString(hex, 100);
  if (hsl) setVar("--preview-card-text", hsl.replace(/^hsl\(|\)$/g, ""));
}
function currentCardTextChoice() {
  let val = "strong";
  nodes.cardTextRadios.forEach?.((r) => { if (r.checked) val = r.value; });
  if (!nodes.cardTextRadios.forEach) { for (const r of nodes.cardTextRadios) if (r.checked) val = r.value; }
  return val;
}
function refreshPreviewTextColor() {
  const choice = currentCardTextChoice();
  if (choice === "strong") setPreviewTextFromToken("--text-strong");
  else if (choice === "body") setPreviewTextFromToken("--text-body");
  else if (choice === "muted") setPreviewTextFromToken("--text-muted");
  else if (choice === "accent") setPreviewTextFromAccent();
  else if (choice === "custom") setPreviewTextFromHex(nodes.cardTextHex.value || nodes.cardTextPicker.value);
}

// ===== Preview (headings) text color =====
function setPreviewHeadingFromToken(tokenVar) {
  const v = tokenToVar(tokenVar);
  if (v) setVar("--preview-heading-text", v);
}
function setPreviewHeadingFromAccent() {
  const a1 = `hsl(${getVar("--accent-1")})`;
  setVar("--preview-heading-text", a1.replace(/^hsl\(|\)$/g, ""));
}
function setPreviewHeadingFromHex(hex) {
  const hsl = hexToHslString(hex, 100);
  if (hsl) setVar("--preview-heading-text", hsl.replace(/^hsl\(|\)$/g, ""));
}
function currentHeadingTextChoice() {
  let val = "strong";
  nodes.headingTextRadios.forEach?.((r) => { if (r.checked) val = r.value; });
  if (!nodes.headingTextRadios.forEach) { for (const r of nodes.headingTextRadios) if (r.checked) val = r.value; }
  return val;
}
function refreshPreviewHeadingColor() {
  const choice = currentHeadingTextChoice();
  if (choice === "strong") setPreviewHeadingFromToken("--text-strong");
  else if (choice === "body") setPreviewHeadingFromToken("--text-body");
  else if (choice === "muted") setPreviewHeadingFromToken("--text-muted");
  else if (choice === "accent") setPreviewHeadingFromAccent();
  else if (choice === "custom") setPreviewHeadingFromHex(nodes.headingTextHex.value || nodes.headingTextPicker.value);
}

// ===== Seed inputs from current tokens =====
function seedHexInputs() {
  const parseAlpha = (str) => { const m = str.match(/\/\s*([0-9.]+)/); return m ? Math.round(parseFloat(m[1]) * 100) : 100; };

  ["--accent-1","--accent-2","--accent-3"].forEach((v, i) => {
    const hex = hslStrToHex(`hsl(${getVar(v)})`);
    const pick = nodes[`accent${i+1}Picker`];
    const txt  = nodes[`accent${i+1}Hex`];
    pick.value = hex; txt.value = hex; setHexVisual(txt, hex);
  });

  // Status colors (these are plain color values, not HSL)
  [
    ["--success","success"],
    ["--warning","warning"],
    ["--error","error"],
    ["--info","info"]
  ].forEach(([v, key]) => {
    const computedVal = getVar(v);
    const hex = anyColorToHex(computedVal);
    const pick = nodes[`${key}Picker`];
    const txt  = nodes[`${key}Hex`];
    if (pick && txt) {
      pick.value = hex; txt.value = hex; setHexVisual(txt, hex);
    }
  });

  [
    ["--surface-base","surfaceBase"],
    ["--surface-panel","surfacePanel"],
    ["--surface-card","surfaceCard"],
    ["--surface-elevated","surfaceElevated"],
    ["--surface-hover","surfaceHover"],
    ["--text-strong","textStrong"],
    ["--text-body","textBody"],
    ["--text-muted","textMuted"],
    ["--border-subtle","borderSubtle"],
    ["--border-strong","borderStrong"]
  ].forEach(([v, key]) => {
    const computedVal = getVar(v);
    const hex = anyColorToHex(computedVal);
    const pick = nodes[`${key}Picker`];
    const txt  = nodes[`${key}Hex`];
    pick.value = hex; txt.value = hex; setHexVisual(txt, hex);
    const alphaEl = nodes[`${key}Alpha`];
    if (alphaEl) alphaEl.value = parseAlpha(computedVal);
  });

  const loadBase = (cssVar, fallback, pickerEl, hexEl, alphaEl) => {
    const raw = getVar(cssVar) || fallback;
    const hex = anyColorToHex(raw);
    if (pickerEl) pickerEl.value = hex;
    if (hexEl) { hexEl.value = hex; setHexVisual(hexEl, hex); }
    if (alphaEl) alphaEl.value = parseAlpha(raw || fallback);
  };

  loadBase("--page-bg-base", "263 76% 3% / 1", nodes.pageBgPicker, nodes.pageBgHex, nodes.pageBgAlpha);
  loadBase("--header-bg-base", "281 35% 9% / 1", nodes.headerBgPicker, nodes.headerBgHex, nodes.headerBgAlpha);
  loadBase("--header-border-base", "268 32% 24% / 1", nodes.headerBorderPicker, nodes.headerBorderHex, nodes.headerBorderAlpha);
  loadBase("--footer-bg-base", "263 76% 3% / 0.85", nodes.footerBgPicker, nodes.footerBgHex, nodes.footerBgAlpha);
  loadBase("--footer-border-base", "268 24% 49% / 0.3", nodes.footerBorderPicker, nodes.footerBorderHex, nodes.footerBorderAlpha);

  paintAccentSwatches();
  updateDerivedAccentVars();
  refreshPreviewTextColor();
  refreshPreviewHeadingColor();
}

// ===== Theme Library (in-memory) =====
let themes = [];
let selectedIndex = -1;

function download(filename, text, type = "application/json;charset=utf-8") {
  const blob = new Blob([text], { type });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = filename; a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 0);
}

function loadSeed() {
  try {
    const seedEl = document.getElementById("themesSeed");
    const payload = JSON.parse(seedEl?.textContent || "{}");
    themes = Array.isArray(payload?.themes) ? payload.themes.slice() : [];
  } catch { themes = []; }
  renderThemeTable();
  if (themes[0]) selectTheme(0);
}

function renderThemeTable() {
  nodes.themeRows.innerHTML = "";
  themes.forEach((t, i) => {
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td>${t.name ?? ""}</td>
      <td><code>${t.id ?? ""}</code></td>
      <td>${t.mode ?? ""}</td>
      <td class="row-actions">
        <button data-act="load" data-i="${i}">Load</button>
        <button data-act="dup" data-i="${i}">Duplicate</button>
        <button data-act="del" data-i="${i}">Remove</button>
      </td>`;
    nodes.themeRows.appendChild(tr);
  });
}

function selectTheme(i) {
  selectedIndex = i;
  const t = themes[i];
  if (!t) return;
  nodes.libName.value = t.name || "";
  nodes.libId.value = t.id || "";
  nodes.libMode.value = t.mode || "dark";
}

function applyThemeTokens(t) {
  const k = t.tokens || {};
  const map = {
    "--accent-1": "accent1",
    "--accent-2": "accent2",
    "--accent-3": "accent3",
    "--surface-base": "surfaceBase",
    "--surface-panel": "surfacePanel",
    "--surface-card": "surfaceCard",
    "--surface-elevated": "surfaceElevated",
    "--surface-hover": "surfaceHover",
    "--text-strong": "textStrong",
    "--text-body": "textBody",
    "--text-muted": "textMuted",
    "--border-subtle": "borderSubtle",
    "--border-strong": "borderStrong",
    "--page-bg-base": "pageBackground",
    "--header-bg-base": "headerBackground",
    "--header-border-base": "headerBorder",
    "--footer-bg-base": "footerBackground",
    "--footer-border-base": "footerBorder"
  };
  Object.entries(map).forEach(([cssVar, key]) => {
    const val = k[key];
    if (typeof val === "string" && val.startsWith("hsl(")) {
      setVar(cssVar, val.replace(/^hsl\(|\)$/g, ""));
    }
  });

  // Status colors (plain hex values)
  const statusMap = {
    "--success": "success",
    "--warning": "warning",
    "--error": "error",
    "--info": "info"
  };
  Object.entries(statusMap).forEach(([cssVar, key]) => {
    const val = k[key];
    if (typeof val === "string" && val.startsWith("#")) {
      setVar(cssVar, val);
    }
  });

  const mode = t.id?.includes("dawn") || t.mode === "light" ? "dawn" : "midnight";
  nodes.mode.value = mode;
  applyThemeAttr(mode);

  seedHexInputs();
}

nodes.themeRows?.addEventListener("click", (e) => {
  const btn = e.target.closest("button");
  if (!btn) return;
  const i = parseInt(btn.dataset.i, 10);
  const act = btn.dataset.act;
  const t = themes[i];
  if (!t) return;

  if (act === "load") {
    selectTheme(i); applyThemeTokens(t);
  } else if (act === "dup") {
    const copy = JSON.parse(JSON.stringify(t));
    copy.id = `${t.id}-copy`; copy.name = `${t.name} (Copy)`;
    themes.splice(i + 1, 0, copy); renderThemeTable();
  } else if (act === "del") {
    themes.splice(i, 1); renderThemeTable();
    if (selectedIndex === i) { selectedIndex = -1; nodes.libName.value = nodes.libId.value = ""; }
  }
});

function collectCurrentTokens() {
  const grab = (v) => `hsl(${getVar(v)})`;
  const grabPlain = (v) => getVar(v); // for plain hex colors
  return {
    accent1: grab("--accent-1"),
    accent2: grab("--accent-2"),
    accent3: grab("--accent-3"),
    accentInk: "hsl(250 60% 40%)",
    surfaceBase: grab("--surface-base"),
    surfacePanel: grab("--surface-panel"),
    surfaceCard: grab("--surface-card"),
    surfaceElevated: grab("--surface-elevated"),
    surfaceHover: grab("--surface-hover"),
    textStrong: grab("--text-strong"),
    textBody: grab("--text-body"),
    textMuted: grab("--text-muted"),
    borderSubtle: grab("--border-subtle"),
    borderStrong: grab("--border-strong"),
    pageBackground: grab("--page-bg-base"),
    headerBackground: grab("--header-bg-base"),
    headerBorder: grab("--header-border-base"),
    footerBackground: grab("--footer-bg-base"),
    footerBorder: grab("--footer-border-base"),
    success: grabPlain("--success"),
    warning: grabPlain("--warning"),
    error: grabPlain("--error"),
    info: grabPlain("--info")
  };
}

nodes.libNewTheme?.addEventListener("click", () => {
  const name = nodes.libName.value.trim() || "New Theme";
  const id = nodes.libId.value.trim() || (name.toLowerCase().replace(/\s+/g, "-"));
  const mode = nodes.libMode.value || "dark";
  const entry = { name, id, mode, tokens: collectCurrentTokens() };
  themes.push(entry); renderThemeTable(); selectTheme(themes.length - 1);
});

nodes.libUpdateTheme?.addEventListener("click", () => {
  if (selectedIndex < 0 || !themes[selectedIndex]) return;
  const name = nodes.libName.value.trim() || "Theme";
  const id = nodes.libId.value.trim() || (name.toLowerCase().replace(/\s+/g, "-"));
  const mode = nodes.libMode.value || "dark";
  themes[selectedIndex] = { name, id, mode, tokens: collectCurrentTokens() };
  renderThemeTable();
});

nodes.libExportAll?.addEventListener("click", () => {
  download("themes.generated.json", JSON.stringify({ themes }, null, 2));
});

// ===== LAUNCH THEME (site-wide)
function launchTheme(themeObj) {
  try {
    localStorage.setItem("wc-active-theme", JSON.stringify(themeObj));
    localStorage.setItem("wc-active-theme-id", themeObj.id || "");
  } catch {}
  applyThemeTokens(themeObj);
  const note = document.createElement("div");
  note.className = "toast"; note.textContent = `Launched: ${themeObj.name || themeObj.id || "Theme"}`;
  document.body.appendChild(note); setTimeout(() => note.classList.add("show"), 10);
  setTimeout(() => { note.classList.remove("show"); setTimeout(() => note.remove(), 300); }, 1800);
}
nodes.libLaunchTheme?.addEventListener("click", () => {
  const mode = nodes.mode.value === "dawn" ? "light" : "dark";
  const id = nodes.mode.value === "dawn" ? "cozy-dawn" : "cozy-midnight";
  const name = nodes.mode.value === "dawn" ? "Cozy Dawn" : "Cozy Midnight";
  launchTheme({ name, id, mode, tokens: collectCurrentTokens() });
});
nodes.libRevertTheme?.addEventListener("click", () => {
  try { localStorage.removeItem("wc-active-theme"); localStorage.removeItem("wc-active-theme-id"); } catch {}
  seedHexInputs();
  const note = document.createElement("div");
  note.className = "toast"; note.textContent = "Reverted to build defaults";
  document.body.appendChild(note); setTimeout(() => note.classList.add("show"), 10);
  setTimeout(() => { note.classList.remove("show"); setTimeout(() => note.remove(), 300); }, 1400);
});

// ===== Exporters
function exportThemeJson() {
  const mode = nodes.mode.value === "dawn" ? "light" : "dark";
  const id = nodes.mode.value === "dawn" ? "cozy-dawn" : "cozy-midnight";
  const name = nodes.mode.value === "dawn" ? "Cozy Dawn" : "Cozy Midnight";
  const theme = { name, id, mode, tokens: collectCurrentTokens() };
  download(`themes.${id}.json`, JSON.stringify({ themes: [theme] }, null, 2));
}
function exportColorTokensCss() {
  const css = `/* color-tokens.generated.css — exported from Theme Editor (HEX mode) */
:root {
  --text-accent: hsl(${getVar("--accent-1")});
  --border-subtle: hsl(${getVar("--border-subtle")});
  --border-strong: hsl(${getVar("--border-strong")});
  --ring-focus: 0 0 0 3px hsl(${getVar("--accent-1")});
  --link-color: hsl(${getVar("--accent-1")});
}
:root[data-theme="cozy-midnight"] { --surface-hover: hsl(${getVar("--surface-hover")}); }
:root[data-theme="cozy-dawn"]     { --surface-hover: hsl(${getVar("--surface-hover")}); }
:root[data-comfort-theme="dawn"]  { --surface-hover: hsl(${getVar("--surface-hover")}); }
`;
  download("color-tokens.generated.css", css, "text/css;charset=utf-8");
}
nodes.exportThemeJson?.addEventListener("click", exportThemeJson);
nodes.exportColorTokens?.addEventListener("click", exportColorTokensCss);

// ===== Mode wiring =====
const saved = (() => { try { return localStorage.getItem('theme-mode'); } catch { return null; } })();
nodes.mode.value = saved || nodes.mode.value || "midnight";
applyThemeAttr(nodes.mode.value);
nodes.mode.addEventListener("change", (e) => {
  applyThemeAttr(e.target.value);
  seedHexInputs();       // re-pull current tokens into the controls
  refreshPreviewAll();   // make preview match immediately
});


// ===== Bind editor inputs to tokens =====
// accents
bindHexPair(nodes.accent1Picker, nodes.accent1Hex, () => applyAccent("accent1Hex", "--accent-1"));
bindHexPair(nodes.accent2Picker, nodes.accent2Hex, () => applyAccent("accent2Hex", "--accent-2"));
bindHexPair(nodes.accent3Picker, nodes.accent3Hex, () => applyAccent("accent3Hex", "--accent-3"));
// surfaces
bindHexPair(nodes.surfaceBasePicker, nodes.surfaceBaseHex, () => applyCore(nodes.surfaceBaseHex, nodes.surfaceBaseAlpha, "--surface-base"));
nodes.surfaceBaseAlpha.addEventListener("input", () => applyCore(nodes.surfaceBaseHex, nodes.surfaceBaseAlpha, "--surface-base"));
bindHexPair(nodes.surfacePanelPicker, nodes.surfacePanelHex, () => applyCore(nodes.surfacePanelHex, nodes.surfacePanelAlpha, "--surface-panel"));
nodes.surfacePanelAlpha.addEventListener("input", () => applyCore(nodes.surfacePanelHex, nodes.surfacePanelAlpha, "--surface-panel"));
bindHexPair(nodes.surfaceCardPicker, nodes.surfaceCardHex, () => applyCore(nodes.surfaceCardHex, nodes.surfaceCardAlpha, "--surface-card"));
nodes.surfaceCardAlpha.addEventListener("input", () => applyCore(nodes.surfaceCardHex, nodes.surfaceCardAlpha, "--surface-card"));
bindHexPair(nodes.surfaceElevatedPicker, nodes.surfaceElevatedHex, () => applyCore(nodes.surfaceElevatedHex, nodes.surfaceElevatedAlpha, "--surface-elevated"));
nodes.surfaceElevatedAlpha.addEventListener("input", () => applyCore(nodes.surfaceElevatedHex, nodes.surfaceElevatedAlpha, "--surface-elevated"));
bindHexPair(nodes.surfaceHoverPicker, nodes.surfaceHoverHex, () => applyCore(nodes.surfaceHoverHex, nodes.surfaceHoverAlpha, "--surface-hover"));
nodes.surfaceHoverAlpha.addEventListener("input", () => applyCore(nodes.surfaceHoverHex, nodes.surfaceHoverAlpha, "--surface-hover"));
// text
bindHexPair(nodes.textStrongPicker, nodes.textStrongHex, () => applyCore(nodes.textStrongHex, nodes.textStrongAlpha, "--text-strong"));
nodes.textStrongAlpha.addEventListener("input", () => applyCore(nodes.textStrongHex, nodes.textStrongAlpha, "--text-strong"));
bindHexPair(nodes.textBodyPicker, nodes.textBodyHex, () => applyCore(nodes.textBodyHex, nodes.textBodyAlpha, "--text-body"));
nodes.textBodyAlpha.addEventListener("input", () => applyCore(nodes.textBodyHex, nodes.textBodyAlpha, "--text-body"));
bindHexPair(nodes.textMutedPicker, nodes.textMutedHex, () => applyCore(nodes.textMutedHex, nodes.textMutedAlpha, "--text-muted"));
nodes.textMutedAlpha.addEventListener("input", () => applyCore(nodes.textMutedHex, nodes.textMutedAlpha, "--text-muted"));
// borders
bindHexPair(nodes.borderSubtlePicker, nodes.borderSubtleHex, () => applyCore(nodes.borderSubtleHex, nodes.borderSubtleAlpha, "--border-subtle"));
nodes.borderSubtleAlpha.addEventListener("input", () => applyCore(nodes.borderSubtleHex, nodes.borderSubtleAlpha, "--border-subtle"));
bindHexPair(nodes.borderStrongPicker, nodes.borderStrongHex, () => applyCore(nodes.borderStrongHex, nodes.borderStrongAlpha, "--border-strong"));
nodes.borderStrongAlpha.addEventListener("input", () => applyCore(nodes.borderStrongHex, nodes.borderStrongAlpha, "--border-strong"));
// site chrome (page/header/footer)
bindHexPair(nodes.pageBgPicker, nodes.pageBgHex, () => applyCore(nodes.pageBgHex, nodes.pageBgAlpha, "--page-bg-base"));
nodes.pageBgAlpha.addEventListener("input", () => applyCore(nodes.pageBgHex, nodes.pageBgAlpha, "--page-bg-base"));
bindHexPair(nodes.headerBgPicker, nodes.headerBgHex, () => applyCore(nodes.headerBgHex, nodes.headerBgAlpha, "--header-bg-base"));
nodes.headerBgAlpha.addEventListener("input", () => applyCore(nodes.headerBgHex, nodes.headerBgAlpha, "--header-bg-base"));
bindHexPair(nodes.headerBorderPicker, nodes.headerBorderHex, () => applyCore(nodes.headerBorderHex, nodes.headerBorderAlpha, "--header-border-base"));
nodes.headerBorderAlpha.addEventListener("input", () => applyCore(nodes.headerBorderHex, nodes.headerBorderAlpha, "--header-border-base"));
bindHexPair(nodes.footerBgPicker, nodes.footerBgHex, () => applyCore(nodes.footerBgHex, nodes.footerBgAlpha, "--footer-bg-base"));
nodes.footerBgAlpha.addEventListener("input", () => applyCore(nodes.footerBgHex, nodes.footerBgAlpha, "--footer-bg-base"));
bindHexPair(nodes.footerBorderPicker, nodes.footerBorderHex, () => applyCore(nodes.footerBorderHex, nodes.footerBorderAlpha, "--footer-border-base"));
nodes.footerBorderAlpha.addEventListener("input", () => applyCore(nodes.footerBorderHex, nodes.footerBorderAlpha, "--footer-border-base"));
// status colors
bindHexPair(nodes.successPicker, nodes.successHex, () => applyStatusColor(nodes.successHex, "--success"));
bindHexPair(nodes.warningPicker, nodes.warningHex, () => applyStatusColor(nodes.warningHex, "--warning"));
bindHexPair(nodes.errorPicker, nodes.errorHex, () => applyStatusColor(nodes.errorHex, "--error"));
bindHexPair(nodes.infoPicker, nodes.infoHex, () => applyStatusColor(nodes.infoHex, "--info"));

// ===== Preview toggles wiring =====
function show(el, yes) { el.style.display = yes ? "" : "none"; }
const cardRadioHandler = () => { const c = currentCardTextChoice(); show(nodes.customCardTextBlock, c === "custom"); refreshPreviewTextColor(); };
const hRadioHandler = () => { const c = currentHeadingTextChoice(); show(nodes.customHeadingTextBlock, c === "custom"); refreshPreviewHeadingColor(); };
(nodes.cardTextRadios.forEach ? nodes.cardTextRadios : Array.from(nodes.cardTextRadios)).forEach(r => r.addEventListener("change", cardRadioHandler));
(nodes.headingTextRadios.forEach ? nodes.headingTextRadios : Array.from(nodes.headingTextRadios)).forEach(r => r.addEventListener("change", hRadioHandler));
bindHexPair(nodes.cardTextPicker, nodes.cardTextHex, () => { if (currentCardTextChoice() === "custom") refreshPreviewTextColor(); });
bindHexPair(nodes.headingTextPicker, nodes.headingTextHex, () => { if (currentHeadingTextChoice() === "custom") refreshPreviewHeadingColor(); });
// Repaint everything preview cares about
function refreshPreviewAll() {
  paintAccentSwatches();
  updateDerivedAccentVars();
  refreshPreviewTextColor();
  refreshPreviewHeadingColor();
}

// initial seed
seedHexInputs();
loadSeed();
refreshPreviewAll(); 
</script>


  <style>
    /* ===== Page chrome ===== */
    .wc-container { margin: var(--space-8) auto; }
    .wc-narrow { max-width: var(--container-narrow); }
    .page-head { margin-bottom: var(--space-6); }
    .page-head h1 { font-size: var(--fs-6); line-height: var(--lh-tight); letter-spacing: var(--tracking-tight); color: var(--text-strong); margin: 0 0 var(--space-2); }
    .page-head .subtitle { color: var(--text-muted); margin: 0; }

    .panel.card-panel {
      background: var(--surface-card); border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-1); border-radius: var(--radius-2);
      padding: var(--space-5); margin-bottom: var(--space-6);
    }
    .hint { color: var(--text-muted); margin-top: var(--space-2); }

    /* ===== Library ===== */
    .library { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-4); margin-top: var(--space-3); }
    .lib-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-3); }
    :global(.theme-table) { width: 100%; border-collapse: collapse; }
    :global(.theme-table th), :global(.theme-table td) { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--border-subtle); }
    :global(.theme-table th) { color: var(--text-muted); font-weight: 600; }
    :global(.row-actions) { display: flex; gap: .4rem; }
    .library-detail .stack { display: grid; gap: .4rem; margin-bottom: .8rem; }
    .library-detail input, .library-detail select {
      background: var(--surface-panel); color: var(--text-body); border: 1px solid var(--border-subtle);
      border-radius: var(--radius-1); padding: var(--space-2) var(--space-3);
    }

    /* ===== Controls ===== */
    .controls-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-3); align-items: end; }
    fieldset.stack { border: 1px solid var(--border-subtle); border-radius: var(--radius-1); padding: var(--space-3); }
    .radio-row { display: flex; flex-wrap: wrap; gap: .75rem 1rem; }
    .radio { display: inline-flex; align-items: center; gap: .5rem; }
    label { display: grid; gap: .4rem; grid-template-columns: 110px 1fr; align-items: center; }
    label > span { grid-column: 1 / -1; color: var(--text-strong); font-weight: 600; }
    input[type="text"] { background: var(--surface-panel); color: var(--text-body); border: 1px solid var(--border-subtle); border-radius: var(--radius-1); padding: var(--space-2) var(--space-3); transition: box-shadow 120ms ease, border-color 120ms ease; }
    input[type="color"] { width: 44px; height: 36px; border: 1px solid var(--border-subtle); border-radius: var(--radius-1); background: var(--surface-panel); }
    input[type="range"] { width: 100%; }
    label small { color: var(--text-muted); justify-self: start; }

    /* ===== Swatches ===== */
    .swatch-row { display: grid; gap: var(--space-3); grid-template-columns: repeat(3, minmax(0,1fr)); margin-top: var(--space-3); }
    .swatch { position: relative; border-radius: var(--radius-2); height: 56px; background: var(--bg, transparent); border: 1px solid hsl(var(--border-subtle)); box-shadow: var(--shadow-1); }
    .swatch span { position: absolute; bottom: 8px; left: 8px; background: color-mix(in srgb, black 20%, transparent); color: white; font-size: var(--fs-0); padding: 2px 6px; border-radius: var(--radius-pill); }

    /* ===== Page-like Preview ===== */
    .page-preview { border: 1px dashed hsl(var(--border-subtle)); border-radius: var(--radius-2); overflow: clip; }
    .page-bg { background: hsl(var(--surface-base)); padding: var(--space-6); }
    .page-container {
      background: hsl(var(--surface-panel)); border: 1px solid hsl(var(--border-subtle));
      border-radius: var(--radius-2); padding: var(--space-5);
      max-width: 820px; margin: 0 auto;
      color: hsl(var(--text-body));
    }
    .preview-heading { color: hsl(var(--text-strong)); margin: 0 0 var(--space-3); }

    /* ===== Cards in Preview ===== */
    .cards { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-top: var(--space-3); }
    .demo-card {
      background: hsl(var(--surface-card)); border: 1px solid hsl(var(--border-subtle));
      border-radius: var(--radius-2); padding: var(--space-4); box-shadow: var(--shadow-1);
      transition: transform var(--dur-med) var(--ease-out-curve), box-shadow var(--dur-med) var(--ease-out-curve);
      color: hsl(var(--preview-card-text, var(--text-body)));
    }
    .demo-card:hover { transform: translateY(-1px); box-shadow: var(--shadow-2); }
    .demo-card.elevated { background: hsl(var(--surface-elevated)); }
    .focusable:focus { outline: var(--ring-focus); outline-offset: 2px; }
    .demo-card h4 { margin: 0 0 .4rem; color: hsl(var(--preview-heading-text, var(--text-strong))); }
    .demo-card p { margin: 0 0 .8rem; }

    .badge {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .2rem .5rem; border-radius: var(--radius-pill);
      background: color-mix(in srgb, var(--text-accent) 30%, transparent);
      border: 1px solid color-mix(in srgb, var(--text-accent) 55%, transparent);
