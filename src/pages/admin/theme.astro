---
import Base from "../../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";

export const prerender = false;

const settings = readSettings();
const site = getSiteOrigin(settings) || "https://example.com";

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';

const defaultMidnight = {
  primary: "#6b21a8",
  accent: "#d9b2c4",
  background: "#faf7f5",
  fontSerif: "Literata",
  fontScript: "Parisienne",
};

const defaultDawn = {
  primary: "#9b86c8",
  accent: "#caa043",
  background: "#f6f0e8",
  fontSerif: "Literata",
  fontScript: "Parisienne",
};

const fontOptions = [
  "Literata",
  "Litera",
  "EB Garamond",
  "Playfair Display",
  "Fraunces",
  "Cormorant Garamond",
  "Parisienne",
  "Dancing Script",
  "Great Vibes",
  "Sacramento",
];
---
<Base
  title="WitchClick — Theme Dashboard"
  description="Craft, save, and activate WitchClick theme palettes."
  canon={`${site}/admin/theme`}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6">
      <AdminNav currentPath="/admin/theme" />

      <div
        class="grid grid-cols-1 gap-6 lg:grid-cols-12"
        data-theme-admin
        data-dev-api={DEV_API}
        data-default-midnight={JSON.stringify(defaultMidnight)}
        data-default-dawn={JSON.stringify(defaultDawn)}
        data-font-options={JSON.stringify(fontOptions)}
      >
      <section class="lg:col-span-4 space-y-6 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <header>
          <h1 class="text-xl font-semibold text-primary">Theme Dashboard</h1>
          <p class="mt-1 text-sm text-body-muted">
            Adjust palettes, typography, and assign active comfort themes for midnight and dawn.
          </p>
        </header>

        <dl class="space-y-2 text-sm">
          <div class="flex items-center justify-between gap-3">
            <dt class="text-body-muted">Active midnight theme</dt>
            <dd class="font-medium text-primary" data-active="midnight">—</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-body-muted">Active dawn theme</dt>
            <dd class="font-medium text-primary" data-active="dawn">—</dd>
          </div>
        </dl>

        <div class="space-y-5">
          <div>
            <div class="flex items-center justify-between gap-2">
              <h2 class="text-[13px] font-semibold uppercase tracking-wide text-body-muted">Midnight themes</h2>
              <button
                type="button"
                class="rounded-lg border border-line-neutral px-3 py-1 text-xs font-medium hover:bg-surface-soft"
                data-new-theme="midnight"
              >
                New
              </button>
            </div>
            <div class="mt-2 space-y-2" data-theme-list="midnight"></div>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2">
              <h2 class="text-[13px] font-semibold uppercase tracking-wide text-body-muted">Dawn themes</h2>
              <button
                type="button"
                class="rounded-lg border border-line-neutral px-3 py-1 text-xs font-medium hover:bg-surface-soft"
                data-new-theme="dawn"
              >
                New
              </button>
            </div>
            <div class="mt-2 space-y-2" data-theme-list="dawn"></div>
          </div>
        </div>
      </section>

      <section class="lg:col-span-8 space-y-4 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <header>
          <h2 class="text-lg font-semibold text-primary">Theme editor</h2>
          <p class="mt-1 text-sm text-body-muted">
            Update individual colour tokens and fonts, then save them as reusable themes.
          </p>
        </header>

        <div class="grid gap-3 md:grid-cols-2">
          <label class="block text-sm">
            <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Comfort mode</span>
            <select id="themeMode" class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2">
              <option value="midnight">Midnight (dark)</option>
              <option value="dawn">Dawn (light)</option>
            </select>
          </label>
          <label class="block text-sm">
            <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Theme name</span>
            <input
              id="themeLabel"
              class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2"
              placeholder="Cozy Midnight"
            />
          </label>
          <label class="block text-sm md:col-span-2">
            <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Slug</span>
            <input
              id="themeSlug"
              class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2"
              placeholder="cozy-midnight"
            />
            <p class="mt-1 text-xs text-body-muted">Leave blank to generate from the theme name.</p>
          </label>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
          <label class="block text-sm">
            <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Primary colour</span>
            <div class="mt-1 flex items-center gap-2">
              <input type="color" data-color-picker="primary" class="h-9 w-12 rounded border border-line-neutral" />
              <input
                data-color-input="primary"
                class="w-full rounded-lg border border-line-neutral px-3 py-2"
                placeholder="#6b21a8"
              />
            </div>
          </label>
          <label class="block text-sm">
            <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Accent colour</span>
            <div class="mt-1 flex items-center gap-2">
              <input type="color" data-color-picker="accent" class="h-9 w-12 rounded border border-line-neutral" />
              <input
                data-color-input="accent"
                class="w-full rounded-lg border border-line-neutral px-3 py-2"
                placeholder="#d9b2c4"
              />
            </div>
          </label>
          <label class="block text-sm md:col-span-2">
            <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Background colour</span>
            <div class="mt-1 flex items-center gap-2">
              <input type="color" data-color-picker="background" class="h-9 w-12 rounded border border-line-neutral" />
              <input
                data-color-input="background"
                class="w-full rounded-lg border border-line-neutral px-3 py-2"
                placeholder="#120725"
              />
            </div>
          </label>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
          <label class="block text-sm">
            <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Serif body font</span>
            <select
              id="themeFontSerif"
              class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2"
            >
              {fontOptions.map((font) => (
                <option value={font} selected={font === defaultMidnight.fontSerif}>
                  {font}
                </option>
              ))}
            </select>
          </label>
          <label class="block text-sm">
            <span class="text-xs font-medium uppercase tracking-wide text-body-muted">Script accent font</span>
            <select
              id="themeFontScript"
              class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2"
            >
              {fontOptions.map((font) => (
                <option value={font} selected={font === defaultMidnight.fontScript}>
                  {font}
                </option>
              ))}
            </select>
          </label>
        </div>

        <div
          class="rounded-2xl border border-line-subtle bg-surface-neutral-soft/60 p-4 md:p-6"
          data-theme-preview
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-body-muted">Live preview</p>
            <span
              class="rounded-full border border-line-neutral bg-surface-base px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-body"
              data-preview-mode
            >
              Midnight
            </span>
          </div>
          <div class="mt-4 grid gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
            <div class="space-y-4">
              <article class="preview-card space-y-3 rounded-xl border p-4 shadow-sm" data-preview-card>
                <p class="text-xs font-semibold uppercase tracking-wide text-body-muted" data-preview-eyebrow>
                  Hero example
                </p>
                <h3 class="text-lg font-semibold" data-preview-title>Soft rituals for tired hearts</h3>
                <p class="text-sm leading-relaxed" data-preview-body>
                  Gentle copy shows how serif body text feels in paragraphs. Adjust colours and fonts above to see instant
                  changes.
                </p>
                <div class="flex flex-wrap gap-2" data-preview-chips>
                  <span class="preview-chip" data-preview-chip="primary">Primary</span>
                  <span class="preview-chip" data-preview-chip="accent">Accent</span>
                  <span class="preview-chip" data-preview-chip="background">Background</span>
                </div>
                <div class="flex flex-wrap gap-2 pt-1" data-preview-actions>
                  <button type="button" class="preview-button preview-button--primary" data-preview-primary>
                    Primary CTA
                  </button>
                  <button type="button" class="preview-button preview-button--ghost" data-preview-secondary>
                    Secondary CTA
                  </button>
                </div>
              </article>
              <p class="text-sm" data-preview-copy>
                Body text uses <span class="font-semibold" data-preview-serif>Literata</span>. Script flourishes render as
                <span class="preview-script" data-preview-script>Moonlit Whispers</span>.
              </p>
            </div>
            <div class="space-y-4">
              <div class="rounded-xl border border-dashed border-line-muted/60 bg-surface-base/80 p-4" data-preview-surface>
                <p class="text-xs font-semibold uppercase tracking-wide text-body-muted">Palette swatches</p>
                <div class="mt-3 flex flex-col gap-2" data-preview-swatches></div>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="saveThemeBtn"
            class="rounded-lg bg-surface-success px-4 py-2 text-sm font-medium text-inverse hover:bg-surface-success-strong"
          >
            Save theme
          </button>
          <button
            type="button"
            id="setActiveThemeBtn"
            class="rounded-lg bg-surface-info px-4 py-2 text-sm font-medium text-inverse hover:bg-surface-info-strong"
          >
            Set as active midnight theme
          </button>
          <button
            type="button"
            id="loadActiveThemeBtn"
            class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft"
          >
            Load active theme
          </button>
          <button
            type="button"
            id="resetThemeBtn"
            class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft"
          >
            Load defaults
          </button>
        </div>

        <p class="mt-2 text-sm text-body-muted" data-status></p>
      </section>
      </div>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">This dashboard is only available in <strong>development</strong> (or with a temporary key).</p>
      <p class="mt-3 text-sm text-body-muted">Update <code>content/themes/*.json</code> manually when the panel is unavailable.</p>
    </section>
  )}

  {canUse && (
    <script is:inline>
      {`
        (function(){
          const root = document.querySelector('[data-theme-admin]');
          if (!root) return;

          const devApi = root.getAttribute('data-dev-api') || 'http://localhost:8787';
          const defaults = {
            midnight: parseDefaults(root.getAttribute('data-default-midnight'), {
              primary: '#6b21a8',
              accent: '#d9b2c4',
              background: '#faf7f5',
              fontSerif: 'Literata',
              fontScript: 'Parisienne'
            }),
            dawn: parseDefaults(root.getAttribute('data-default-dawn'), {
              primary: '#9b86c8',
              accent: '#caa043',
              background: '#f6f0e8',
              fontSerif: 'Literata',
              fontScript: 'Parisienne'
            })
          };

          const lists = {
            midnight: root.querySelector('[data-theme-list="midnight"]'),
            dawn: root.querySelector('[data-theme-list="dawn"]')
          };

          const activeLabels = {
            midnight: root.querySelector('[data-active="midnight"]'),
            dawn: root.querySelector('[data-active="dawn"]')
          };

          const modeSelect = root.querySelector('#themeMode');
          const labelInput = root.querySelector('#themeLabel');
          const slugInput = root.querySelector('#themeSlug');
          const fontSerifSelect = root.querySelector('#themeFontSerif');
          const fontScriptSelect = root.querySelector('#themeFontScript');
          const statusEl = root.querySelector('[data-status]');
          const fontChoices = parseFontOptions(root.getAttribute('data-font-options'));

          const colorFields = ['primary','accent','background'].reduce((acc, key) => {
            acc[key] = {
              picker: root.querySelector('[data-color-picker="' + key + '"]'),
              input: root.querySelector('[data-color-input="' + key + '"]')
            };
            return acc;
          }, {});

          const previewRoot = root.querySelector('[data-theme-preview]');
          const previewModeLabel = root.querySelector('[data-preview-mode]');
          const previewSerif = root.querySelector('[data-preview-serif]');
          const previewScript = root.querySelector('[data-preview-script]');
          const previewSwatches = root.querySelector('[data-preview-swatches]');

          const saveBtn = root.querySelector('#saveThemeBtn');
          const setActiveBtn = root.querySelector('#setActiveThemeBtn');
          const resetBtn = root.querySelector('#resetThemeBtn');
          const loadActiveBtn = root.querySelector('#loadActiveThemeBtn');
          const newButtons = Array.from(root.querySelectorAll('[data-new-theme]'));

          let state = {
            items: { midnight: [], dawn: [] },
            active: { midnight: null, dawn: null }
          };
          let current = null;

          function parseDefaults(raw, fallback){
            try {
              const parsed = JSON.parse(raw || 'null');
              if (parsed && typeof parsed === 'object') {
                const result = { ...fallback };
                ['primary','accent','background','fontSerif','fontScript'].forEach((key) => {
                  if (typeof parsed[key] === 'string' && parsed[key].trim()) {
                    result[key] = parsed[key];
                  }
                });
                return result;
              }
            } catch {}
            return { ...fallback };
          }

          function parseFontOptions(raw){
            try {
              const parsed = JSON.parse(raw || '[]');
              if (Array.isArray(parsed)) {
                const values = parsed
                  .map((item) => (typeof item === 'string' ? item.trim() : ''))
                  .filter(Boolean);
                return Array.from(new Set(values));
              }
            } catch {}
            return [];
          }

          function ensureFontOption(select, value){
            if (!select) return;
            const trimmed = typeof value === 'string' ? value.trim() : '';
            if (!trimmed) return;
            const options = Array.from(select.options || []);
            if (!options.some((option) => option.value === trimmed)) {
              const option = document.createElement('option');
              option.value = trimmed;
              option.textContent = trimmed;
              select.appendChild(option);
            }
            if (!fontChoices.includes(trimmed)) {
              fontChoices.push(trimmed);
            }
          }

          function setFontSelectValue(select, value, fallback){
            if (!select) return;
            const trimmed = typeof value === 'string' ? value.trim() : '';
            const fallbackValue = typeof fallback === 'string' ? fallback.trim() : '';
            const toUse = trimmed || fallbackValue;
            if (toUse) {
              ensureFontOption(select, toUse);
              select.value = toUse;
            } else {
              select.value = '';
            }
          }

          function getFontValue(select){
            if (!select) return '';
            const value = typeof select.value === 'string' ? select.value.trim() : '';
            return value;
          }

          function setStatus(message, tone){
            if (!statusEl) return;
            const base = 'mt-2 text-sm';
            if (!message) {
              statusEl.textContent = '';
              statusEl.className = base + ' text-body-muted';
              return;
            }
            if (tone === 'error') {
              statusEl.className = base + ' text-danger';
            } else if (tone === 'success') {
              statusEl.className = base + ' text-success';
            } else {
              statusEl.className = base + ' text-body-muted';
            }
            statusEl.textContent = message;
          }

          function normalizeHex(value){
            const str = String(value || '').trim();
            const match = /^#?([0-9a-fA-F]{6})$/.exec(str);
            return match ? '#' + match[1].toLowerCase() : '';
          }

          function hexToRgb(hex){
            const match = /^#?([0-9a-fA-F]{6})$/.exec(String(hex || '').trim());
            if (!match) return null;
            const value = match[1];
            return {
              r: parseInt(value.slice(0, 2), 16),
              g: parseInt(value.slice(2, 4), 16),
              b: parseInt(value.slice(4, 6), 16)
            };
          }

          function rgbToHex(r, g, b){
            const clamp = (v) => Math.max(0, Math.min(255, Math.round(v)));
            return '#' + [clamp(r), clamp(g), clamp(b)].map((v) => v.toString(16).padStart(2, '0')).join('');
          }

          function adjustHex(hex, amount){
            const rgb = hexToRgb(hex);
            if (!rgb) return hex;
            const safeAmount = Math.max(-1, Math.min(1, amount || 0));
            const towardWhite = safeAmount >= 0;
            const ratio = Math.abs(safeAmount);
            const target = towardWhite ? { r: 255, g: 255, b: 255 } : { r: 0, g: 0, b: 0 };
            const r = rgb.r + (target.r - rgb.r) * ratio;
            const g = rgb.g + (target.g - rgb.g) * ratio;
            const b = rgb.b + (target.b - rgb.b) * ratio;
            return rgbToHex(r, g, b);
          }

          function getLuminance(rgb){
            if (!rgb) return 0;
            const channel = (value) => {
              const v = value / 255;
              return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
            };
            return 0.2126 * channel(rgb.r) + 0.7152 * channel(rgb.g) + 0.0722 * channel(rgb.b);
          }

          function pickContrastColor(hex){
            const rgb = hexToRgb(hex);
            if (!rgb) return '#1f1630';
            const luminance = getLuminance(rgb);
            return luminance > 0.5 ? '#1f1630' : '#fdfcfe';
          }

          function toFontStack(name, fallback){
            const raw = String(name || '').trim();
            if (!raw) return fallback;
            const safe = raw.replace(/["']/g, '');
            return "'" + safe + "'" + (fallback ? ", " + fallback : "");
          }

          function refreshPreview(){
            if (!previewRoot) return;
            const mode = modeSelect && modeSelect.value === 'dawn' ? 'dawn' : 'midnight';
            const defaultsForMode = defaults[mode] || defaults.midnight;
            const primary =
              normalizeHex(colorFields.primary?.input?.value) || normalizeHex(defaultsForMode.primary) || '#8b7e8f';
            const accent =
              normalizeHex(colorFields.accent?.input?.value) || normalizeHex(defaultsForMode.accent) || '#d9b2c4';
            const background =
              normalizeHex(colorFields.background?.input?.value) || normalizeHex(defaultsForMode.background) || '#120725';
            const fontSerif = getFontValue(fontSerifSelect) || defaultsForMode.fontSerif;
            const fontScript = getFontValue(fontScriptSelect) || defaultsForMode.fontScript;

            const bgRgb = hexToRgb(background);
            const luminance = getLuminance(bgRgb);
            const textColor = pickContrastColor(background);
            const muted = adjustHex(background, luminance > 0.5 ? -0.25 : 0.35);
            const surface = adjustHex(background, luminance > 0.5 ? -0.08 : 0.22);
            const border = adjustHex(background, luminance > 0.5 ? -0.3 : 0.28);

            previewRoot.style.setProperty('--preview-primary', primary);
            previewRoot.style.setProperty('--preview-accent', accent);
            previewRoot.style.setProperty('--preview-background', background);
            previewRoot.style.setProperty('--preview-surface', surface);
            previewRoot.style.setProperty('--preview-border', border);
            previewRoot.style.setProperty('--preview-text', textColor);
            previewRoot.style.setProperty('--preview-muted', muted);
            previewRoot.style.setProperty('--preview-primary-contrast', pickContrastColor(primary));
            previewRoot.style.setProperty('--preview-accent-contrast', pickContrastColor(accent));
            previewRoot.style.setProperty('--preview-font-serif', toFontStack(fontSerif, 'serif'));
            previewRoot.style.setProperty('--preview-font-script', toFontStack(fontScript, 'cursive'));
            previewRoot.setAttribute('data-mode', mode);

            if (previewModeLabel) {
              previewModeLabel.textContent = mode === 'dawn' ? 'Dawn' : 'Midnight';
            }
            if (previewSerif) {
              const serifLabel = fontSerif || defaultsForMode.fontSerif;
              previewSerif.textContent = serifLabel;
              previewSerif.style.fontFamily = toFontStack(serifLabel, 'serif');
            }
            if (previewScript) {
              const scriptLabel = fontScript || defaultsForMode.fontScript;
              previewScript.textContent = scriptLabel;
              previewScript.style.fontFamily = toFontStack(scriptLabel, 'cursive');
            }

            if (previewSwatches) {
              previewSwatches.innerHTML = '';
              const swatchData = [
                { label: 'Primary', value: primary },
                { label: 'Accent', value: accent },
                { label: 'Background', value: background },
                { label: 'Surface', value: surface },
              ];
              swatchData.forEach((item) => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between gap-3 text-sm';
                const left = document.createElement('div');
                left.className = 'flex items-center gap-2';
                const circle = document.createElement('span');
                circle.className = 'h-6 w-6 rounded-full border border-white/60 shadow-sm';
                circle.style.backgroundColor = item.value;
                const label = document.createElement('span');
                label.textContent = item.label;
                left.appendChild(circle);
                left.appendChild(label);
                const code = document.createElement('code');
                code.className = 'text-xs text-body-muted';
                code.textContent = item.value;
                row.appendChild(left);
                row.appendChild(code);
                previewSwatches.appendChild(row);
              });
            }
          }

          function setColorField(key, value){
            const field = colorFields[key];
            if (!field) return;
            const normalized = typeof value === 'string' ? value.trim() : '';
            const hex = normalizeHex(normalized);
            if (field.picker) {
              if (hex) {
                field.picker.value = hex;
              } else if (defaults[current?.mode || 'midnight']) {
                const fallback = normalizeHex(defaults[current?.mode || 'midnight'][key]);
                if (fallback) field.picker.value = fallback;
              }
            }
            if (field.input) {
              field.input.value = normalized;
            }
          }

          function collectForm(){
            const mode = modeSelect && modeSelect.value === 'dawn' ? 'dawn' : 'midnight';
            const payload = {
              mode,
              label: labelInput ? labelInput.value.trim() : '',
              slug: slugInput ? slugInput.value.trim() : '',
              settings: {
                primary: colorFields.primary?.input?.value.trim() || '',
                accent: colorFields.accent?.input?.value.trim() || '',
                background: colorFields.background?.input?.value.trim() || '',
                fontSerif: getFontValue(fontSerifSelect),
                fontScript: getFontValue(fontScriptSelect)
              }
            };
            return payload;
          }

          function populateForm(theme){
            current = theme ? { ...theme, settings: { ...theme.settings } } : null;
            const mode = theme?.mode || 'midnight';
            const defaultsForMode = defaults[mode] || defaults.midnight;
            if (modeSelect) modeSelect.value = mode;
            if (labelInput) labelInput.value = theme?.label || '';
            if (slugInput) slugInput.value = theme?.slug || '';
            if (fontSerifSelect) {
              setFontSelectValue(fontSerifSelect, theme?.settings?.fontSerif, defaultsForMode.fontSerif);
            }
            if (fontScriptSelect) {
              setFontSelectValue(fontScriptSelect, theme?.settings?.fontScript, defaultsForMode.fontScript);
            }
            setColorField('primary', theme?.settings?.primary ?? defaultsForMode.primary);
            setColorField('accent', theme?.settings?.accent ?? defaultsForMode.accent);
            setColorField('background', theme?.settings?.background ?? defaultsForMode.background);
            updateSetActiveLabel();
            refreshPreview();
          }

          function updateSetActiveLabel(){
            if (!setActiveBtn) return;
            const mode = modeSelect && modeSelect.value === 'dawn' ? 'dawn' : 'midnight';
            setActiveBtn.textContent = mode === 'dawn' ? 'Set as active dawn theme' : 'Set as active midnight theme';
          }

          function updateActiveLabels(){
            (['midnight','dawn']).forEach((mode) => {
              if (!activeLabels[mode]) return;
              const slug = state.active[mode];
              if (!slug) {
                activeLabels[mode].textContent = '—';
                return;
              }
              const theme = findTheme(mode, slug);
              activeLabels[mode].textContent = theme ? theme.label : slug;
            });
          }

          function findTheme(mode, slug){
            const list = state.items[mode] || [];
            return list.find((item) => item.slug === slug) || null;
          }

          function renderLists(){
            ['midnight','dawn'].forEach((mode) => {
              const listEl = lists[mode];
              if (!listEl) return;
              const themes = state.items[mode] || [];
              listEl.innerHTML = '';
              if (!themes.length) {
                const empty = document.createElement('p');
                empty.className = 'text-xs text-body-muted';
                empty.textContent = 'No saved themes yet.';
                listEl.appendChild(empty);
                return;
              }
              themes.forEach((theme) => {
                const card = document.createElement('div');
                card.className =
                  'group rounded-xl border border-line-neutral bg-surface-base px-3 py-3 text-sm transition hover:border-line-bold hover:bg-surface-soft focus:outline-none focus-visible:ring-2 focus-visible:ring-line-bold focus-visible:ring-offset-2';
                card.setAttribute('role', 'button');
                card.tabIndex = 0;
                card.dataset.themeItem = theme.slug;

                const activateClassList = ['border-line-emerald', 'bg-surface-emerald-soft'];
                if (state.active[mode] === theme.slug) {
                  activateClassList.forEach((cls) => card.classList.add(cls));
                }

                const handleLoad = () => {
                  populateForm(theme);
                  setStatus('Loaded "' + theme.label + '".', 'success');
                };

                card.addEventListener('click', handleLoad);
                card.addEventListener('keydown', (event) => {
                  if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    handleLoad();
                  }
                });

                const header = document.createElement('div');
                header.className = 'flex items-center justify-between gap-3';
                const labelSpan = document.createElement('span');
                labelSpan.className = 'font-medium text-primary';
                labelSpan.textContent = theme.label;
                header.appendChild(labelSpan);

                const headerMeta = document.createElement('div');
                headerMeta.className = 'flex items-center gap-2';
                const modeBadge = document.createElement('span');
                modeBadge.className = 'rounded-full bg-surface-neutral-soft px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-body-muted';
                modeBadge.textContent = theme.mode === 'dawn' ? 'Dawn' : 'Midnight';
                headerMeta.appendChild(modeBadge);
                if (state.active[mode] === theme.slug) {
                  const badge = document.createElement('span');
                  badge.className = 'rounded bg-surface-success px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-inverse';
                  badge.textContent = 'Active';
                  headerMeta.appendChild(badge);
                }
                header.appendChild(headerMeta);

                const slugLine = document.createElement('p');
                slugLine.className = 'mt-1 text-[11px] text-body-muted';
                slugLine.textContent = theme.slug;

                const paletteRow = document.createElement('div');
                paletteRow.className = 'mt-3 flex flex-wrap items-center gap-2';
                ['primary', 'accent', 'background'].forEach((key) => {
                  const tone = typeof theme.settings?.[key] === 'string' ? theme.settings[key] : '';
                  if (!tone) return;
                  const chip = document.createElement('span');
                  chip.className =
                    'flex items-center gap-1 rounded-full border border-line-subtle bg-surface-base/70 px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide';
                  const dot = document.createElement('span');
                  dot.className = 'h-3 w-3 rounded-full border border-white/60 shadow-sm';
                  dot.style.backgroundColor = tone;
                  const code = document.createElement('span');
                  code.textContent = tone;
                  chip.appendChild(dot);
                  chip.appendChild(code);
                  paletteRow.appendChild(chip);
                });

                const actions = document.createElement('div');
                actions.className = 'mt-3 flex flex-wrap gap-2';
                const activateBtn = document.createElement('button');
                activateBtn.type = 'button';
                activateBtn.className = 'rounded-md border border-line-neutral px-2 py-1 text-[11px] font-semibold uppercase tracking-wide transition hover:bg-surface-soft';
                activateBtn.textContent = 'Activate';
                activateBtn.addEventListener('click', (event) => {
                  event.stopPropagation();
                  quickActivateTheme(theme);
                });
                actions.appendChild(activateBtn);

                card.appendChild(header);
                card.appendChild(slugLine);
                if (paletteRow.childElementCount) {
                  card.appendChild(paletteRow);
                }
                card.appendChild(actions);
                listEl.appendChild(card);
              });
            });
          }

          function toJSON(response){
            return response.json().catch(() => ({}));
          }

          async function fetchThemes(){
            const res = await fetch(devApi + '/themes/list', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: '{}'
            });
            const json = await toJSON(res);
            if (!json || json.ok !== true) {
              throw new Error(json?.error || 'Unable to load themes');
            }
            return json;
          }

          async function refresh(preferredMode, preferredSlug, options){
            const announce = options && options.showStatus;
            if (announce) {
              setStatus('Loading themes…');
            }
            try {
              const data = await fetchThemes();
              state = {
                items: data.items || { midnight: [], dawn: [] },
                active: data.active || { midnight: null, dawn: null }
              };
              renderLists();
              updateActiveLabels();
              const mode = preferredMode || current?.mode || 'midnight';
              const slug = preferredSlug || current?.slug || state.active[mode];
              if (slug) {
                const theme = findTheme(mode, slug);
                if (theme) {
                  populateForm(theme);
                } else {
                  startNewTheme(mode, true);
                }
              } else {
                startNewTheme(mode, true);
              }
              if (announce) {
                setStatus('Themes refreshed.', 'success');
              }
            } catch (error) {
              setStatus(error?.message || 'Failed to load themes.', 'error');
            }
          }

          function startNewTheme(mode, silent){
            const safeMode = mode === 'dawn' ? 'dawn' : 'midnight';
            const base = defaults[safeMode];
            populateForm({
              slug: '',
              label: '',
              mode: safeMode,
              settings: { ...base }
            });
            if (!silent) {
              setStatus('Ready to craft a new ' + (safeMode === 'dawn' ? 'dawn' : 'midnight') + ' theme.', null);
            }
          }

          async function saveTheme(){
            const payload = collectForm();
            try {
              setStatus('Saving theme…');
              const res = await fetch(devApi + '/themes/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              const json = await toJSON(res);
              if (!json || json.ok !== true) {
                throw new Error(json?.error || 'Theme save failed');
              }
              const theme = json.theme;
              setStatus('Saved "' + (theme?.label || payload.label || payload.slug) + '".', 'success');
              await refresh(theme?.mode || payload.mode, theme?.slug || payload.slug);
            } catch (error) {
              setStatus(error?.message || 'Theme save failed.', 'error');
            }
          }

          async function setThemeActive(mode, slug, label){
            const safeMode = mode === 'dawn' ? 'dawn' : 'midnight';
            const safeSlug = typeof slug === 'string' ? slug.trim() : '';
            if (!safeSlug) {
              setStatus('Save the theme before activating it.', 'error');
              return;
            }
            try {
              setStatus('Setting active theme…');
              const res = await fetch(devApi + '/themes/set-active', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mode: safeMode, slug: safeSlug })
              });
              const json = await toJSON(res);
              if (!json || json.ok !== true) {
                throw new Error(json?.error || 'Unable to set active theme');
              }
              const labelText = json?.theme?.label || label || safeSlug;
              setStatus('Activated "' + labelText + '" for ' + safeMode + '.', 'success');
              await refresh(safeMode, safeSlug);
            } catch (error) {
              setStatus(error?.message || 'Failed to activate theme.', 'error');
            }
          }

          async function activateTheme(){
            const payload = collectForm();
            await setThemeActive(payload.mode, payload.slug, payload.label || payload.slug);
          }

          async function quickActivateTheme(theme){
            if (!theme || typeof theme.slug !== 'string') return;
            await setThemeActive(theme.mode, theme.slug, theme.label);
          }

          function loadActiveTheme(){
            const mode = modeSelect && modeSelect.value === 'dawn' ? 'dawn' : 'midnight';
            const slug = state.active[mode];
            if (!slug) {
              startNewTheme(mode);
              setStatus('No active theme yet — loaded defaults.', null);
              return;
            }
            const theme = findTheme(mode, slug);
            if (theme) {
              populateForm(theme);
              setStatus('Loaded active ' + mode + ' theme.', 'success');
            } else {
              startNewTheme(mode);
              setStatus('Active theme file missing — restored defaults.', 'error');
            }
          }

          if (modeSelect) {
            modeSelect.addEventListener('change', () => {
              updateSetActiveLabel();
              refreshPreview();
            });
          }

          Object.keys(colorFields).forEach((key) => {
            const field = colorFields[key];
            if (field.picker) {
              field.picker.addEventListener('input', () => {
                if (field.input) {
                  field.input.value = field.picker.value;
                }
                refreshPreview();
              });
            }
            if (field.input) {
              field.input.addEventListener('input', () => {
                refreshPreview();
              });
              field.input.addEventListener('blur', () => {
                const hex = normalizeHex(field.input.value);
                if (hex && field.picker) {
                  field.picker.value = hex;
                }
                refreshPreview();
              });
            }
          });

          if (fontSerifSelect) {
            fontSerifSelect.addEventListener('change', () => refreshPreview());
          }
          if (fontScriptSelect) {
            fontScriptSelect.addEventListener('change', () => refreshPreview());
          }

          if (saveBtn) saveBtn.addEventListener('click', saveTheme);
          if (setActiveBtn) setActiveBtn.addEventListener('click', activateTheme);
          if (resetBtn) resetBtn.addEventListener('click', () => {
            const mode = modeSelect && modeSelect.value === 'dawn' ? 'dawn' : 'midnight';
            startNewTheme(mode);
          });
          if (loadActiveBtn) loadActiveBtn.addEventListener('click', loadActiveTheme);

          newButtons.forEach((button) => {
            button.addEventListener('click', () => {
              const mode = button.getAttribute('data-new-theme') === 'dawn' ? 'dawn' : 'midnight';
              startNewTheme(mode);
            });
          });

          refreshPreview();
          refresh(undefined, undefined, { showStatus: true });
        })();
      `}
    </script>
  )}

  <style>
    [data-theme-preview] {
      --preview-primary: #8b7e8f;
      --preview-accent: #d9b2c4;
      --preview-background: #120725;
      --preview-surface: #1d1033;
      --preview-border: #2e1b4a;
      --preview-text: #fdfcfe;
      --preview-muted: #d9b2c4;
      --preview-primary-contrast: #fdfcfe;
      --preview-accent-contrast: #1f1630;
      --preview-font-serif: 'Literata', serif;
      --preview-font-script: 'Parisienne', cursive;
      background: var(--preview-background);
      color: var(--preview-text);
      border-color: var(--preview-border);
      font-family: var(--preview-font-serif, 'Literata', serif);
      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }

    [data-theme-preview] .preview-card {
      background: var(--preview-surface);
      border-color: var(--preview-border);
      color: var(--preview-text);
      transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
      font-family: var(--preview-font-serif, 'Literata', serif);
    }

    [data-theme-preview] .preview-card h3 {
      font-family: var(--preview-font-serif, 'Literata', serif);
    }

    [data-theme-preview] .preview-card p[data-preview-eyebrow] {
      color: var(--preview-muted);
      letter-spacing: 0.1em;
    }

    [data-theme-preview] .preview-chip {
      background: var(--preview-surface);
      border: 1px solid var(--preview-border);
      border-radius: 9999px;
      padding: 0.2rem 0.55rem;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--preview-text);
    }

    [data-theme-preview] .preview-button {
      border-radius: 9999px;
      font-size: 0.8125rem;
      font-weight: 600;
      padding: 0.4rem 1.05rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    }

    [data-theme-preview] .preview-button--primary {
      background: var(--preview-primary);
      color: var(--preview-primary-contrast);
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.18);
    }

    [data-theme-preview] .preview-button--primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.22);
    }

    [data-theme-preview] .preview-button--ghost {
      border: 1px solid var(--preview-border);
      background: transparent;
      color: var(--preview-text);
    }

    [data-theme-preview] .preview-button--ghost:hover {
      background: var(--preview-surface);
    }

    [data-theme-preview] .preview-script {
      font-family: var(--preview-font-script, 'Parisienne', cursive);
      font-size: 1.125rem;
      color: var(--preview-text);
    }

    [data-theme-preview] [data-preview-copy] {
      color: var(--preview-text);
    }

    [data-theme-preview] [data-preview-surface] {
      border-color: var(--preview-border);
      color: var(--preview-text);
      background: var(--preview-surface);
    }

    [data-theme-preview] code {
      background: rgba(0, 0, 0, 0.18);
      color: var(--preview-text);
      border-radius: 0.375rem;
      padding: 0.125rem 0.375rem;
    }
  </style>
</Base>
