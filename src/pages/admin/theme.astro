---
import Base from "../../layouts/Base.astro";
import AdminNav from "@/components/AdminNav.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import { discoverIngestedPalettes, paletteAnchor } from "@/lib/ingested-palettes";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/theme" });
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const authorized = import.meta.env.DEV || !!(ADMIN_KEY && Astro.url.searchParams.get("key") === ADMIN_KEY);
const palettes = discoverIngestedPalettes();
const DEV_API = import.meta.env.PUBLIC_DEV_API || "http://localhost:8787";
---
<Base title="WitchClick — Ingested palettes" description="Ingested colour palettes and semantic coverage." canon={canonical} wide={true} noindex={true}>
  {authorized ? (
    <div class="palette-shelf space-y-6" data-theme-manifest-viewer>
      <AdminNav currentPath="/admin/theme" />
      <header><h1>Ingested palettes</h1><p>Colour examples and required-semantic coverage for each ingested kit.</p></header>
      <section class="kit-panel" data-palette-ingest data-dev-api={DEV_API} aria-labelledby="ingest-heading">
        <h2 id="ingest-heading">Ingest palette</h2>
        <p>Add a manifest and its matching CSS to the shelf. This does not activate a palette.</p>
        <div class="ingest-inputs">
          <label>manifest.json<input data-manifest-file type="file" accept=".json,application/json" /></label>
          <label>kit.css<input data-css-file type="file" accept=".css,text/css" /></label>
          <label>Admin token<input data-admin-token type="password" autocomplete="off" spellcheck="false" /><span>Used for this request only; never stored.</span></label>
        </div>
        <button type="button" data-ingest-button disabled>Ingest</button>
        <p data-ingest-status data-state="locked" role="status" aria-live="polite">Palette ingestion is locked. Enter an admin token and select both files to continue.</p>
      </section>
      <label class="palette-jump">Go to palette
        <select data-palette-jump disabled={!palettes.length}>
          <option value="">Choose a palette</option>
          {palettes.map(palette => <option value={paletteAnchor(palette.manifest.kitId, palette.manifest.version)}>{palette.name} — {palette.manifest.version}</option>)}
        </select>
      </label>
      {palettes.length ? palettes.map(palette => (
        <article class="kit-panel" tabindex="-1" id={paletteAnchor(palette.manifest.kitId, palette.manifest.version)} data-palette={palette.manifest.kitId} data-palette-version={palette.manifest.version}>
          <header class="palette-heading">
            <div><h2>{palette.name}</h2><p>Version {palette.manifest.version}</p></div>
            <span class="palette-status">{palette.status}</span>
          </header>
          <p class="coverage" data-required-semantics>Required semantics: <strong>{palette.requiredSemantics ? "Yes" : `No — ${palette.missing.length} roles missing`}</strong></p>
          <div class="palette-modes">
            {palette.modes.map(({ mode, swatches }) => (
              <section aria-label={`${palette.name} ${mode}`}>
                <h3>{mode}</h3>
                <div class="palette-swatches">
                  {swatches.map(swatch => (
                    <div class="palette-sample">
                      <span class="palette-swatch" aria-hidden="true" data-kit-swatch={swatch.id} data-kit-swatch-mode={mode} style={`background-color: ${swatch.value};`}></span>
                      <span>{swatch.label}</span><code>{swatch.value}</code>
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>
          <details>
            <summary>Kit details</summary>
            <dl>
              <div><dt>Kit ID</dt><dd>{palette.manifest.kitId}</dd></div>
              <div><dt>Schema / contract</dt><dd>{palette.manifest.schemaVersion} / {palette.manifest.contractVersion}</dd></div>
              <div><dt>CSS / namespace</dt><dd>{palette.manifest.cssFile} / {palette.manifest.namespace}</dd></div>
              <div><dt>Integrity ({palette.manifest.integrity.algorithm})</dt><dd data-kit-integrity><code>{palette.manifest.integrity.sha256}</code></dd></div>
              <div><dt>Contrast records</dt><dd data-kit-contrast-count>{palette.manifest.contrasts.length}</dd></div>
              <div><dt>Unrecorded contrast pairs</dt><dd>{palette.manifest.missingContrastPairs.length}</dd></div>
            </dl>
            <h3>Missing roles</h3>
            <p>{palette.missingRequired.length} required; {palette.missing.length - palette.missingRequired.length} optional.</p>
            {palette.missing.length ? <ul>{palette.missing.map(role => <li data-kit-missing-role={role.id}><code>{role.id}</code> ({role.requirement}){role.classification && ` — ${role.classification}`}{role.owningLayer && ` · ${role.owningLayer}`}</li>)}</ul> : <p>No roles are missing.</p>}
          </details>
        </article>
      )) : <section class="kit-panel"><p>No palettes have been ingested yet.</p></section>}
    </div>
  ) : <section class="kit-panel"><h1>Local admin access required</h1><p>Open this shelf in the local development session or use the existing admin access requirements.</p></section>}
</Base>
<style>
  .ingest-inputs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; margin-block: 1rem; }
  label { display: grid; gap: .5rem; } input, select { max-width: 100%; min-width: 0; padding: .65rem; color: var(--admin-text-body); background: var(--admin-surface-base); border: 1px solid var(--admin-border-strong); border-radius: .4rem; }
  label span { font-size: .85rem; }
  button { padding: .6rem 1rem; border: 1px solid var(--admin-border-strong); border-radius: .4rem; background: var(--admin-surface-base); color: var(--admin-text-strong); }
  button:disabled { cursor: not-allowed; } button:focus-visible, input:focus-visible, select:focus-visible, article:focus-visible { outline: 3px solid var(--admin-focus); outline-offset: 3px; }
  [data-ingest-status] { margin-top: 1rem; overflow-wrap: anywhere; }
  article { scroll-margin-top: 7rem; }
  .palette-shelf { color: var(--admin-text-body); }
  .kit-panel { padding: clamp(1rem, 3vw, 1.75rem); background: var(--admin-surface-muted); color: var(--admin-text-body); border: 1px solid var(--admin-border-subtle); border-radius: 1rem; }
  h1, h2, h3 { color: var(--admin-text-strong); line-height: 1.35; }
  h1 { font-size: 1.8rem; } h2 { font-size: 1.45rem; } h3 { font-size: 1rem; margin-block: 1rem .75rem; }
  p, li, dd { line-height: 1.6; }
  .palette-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .palette-heading p, dt { color: var(--admin-text-muted); }
  .palette-status { border: 1px solid var(--admin-border-strong); border-radius: 1rem; padding: .2rem .75rem; }
  .coverage { margin-block: 1rem; }
  .palette-modes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 1.5rem; }
  .palette-swatches { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 6rem), 1fr)); gap: .85rem; }
  .palette-sample { display: grid; gap: .25rem; align-content: start; font-size: .85rem; line-height: 1.5; }
  .palette-swatch { display: block; height: 2.5rem; border: 1px solid var(--admin-border-strong); border-radius: .4rem; }
  code, dd { overflow-wrap: anywhere; } code { font-size: .85rem; }
  details { margin-top: 1.5rem; border-top: 1px solid var(--admin-border-subtle); }
  summary { padding-block: 1rem; color: var(--admin-text-strong); cursor: pointer; }
  summary:focus-visible { outline: 3px solid var(--admin-focus); outline-offset: 3px; }
  dl { display: grid; gap: .75rem; } dd { margin: 0; }
  ul { list-style: disc; padding-left: 1.25rem; }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-palette-ingest]');
  if (panel) {
    const manifestFile = panel.querySelector<HTMLInputElement>('[data-manifest-file]')!;
    const cssFile = panel.querySelector<HTMLInputElement>('[data-css-file]')!;
    const token = panel.querySelector<HTMLInputElement>('[data-admin-token]')!;
    const button = panel.querySelector<HTMLButtonElement>('[data-ingest-button]')!;
    const status = panel.querySelector<HTMLElement>('[data-ingest-status]')!;
    let pending = false;
    const message = (state: string, text: string) => { status.dataset.state = state; status.textContent = text; };
    const update = () => {
      button.disabled = pending || !token.value.trim() || !manifestFile.files?.length || !cssFile.files?.length;
    };
    for (const input of [manifestFile, cssFile, token]) input.addEventListener('input', () => {
      if (!pending) message(token.value.trim() ? 'ready' : 'locked', token.value.trim() ? 'Select both files, then ingest. The palette will be shelved, not active.' : 'Palette ingestion is locked. An admin token is required.');
      update();
    });
    button.addEventListener('click', async () => {
      if (button.disabled || pending) return;
      pending = true; update();
      for (const input of [manifestFile, cssFile, token]) input.disabled = true;
      message('loading', 'Validating and shelving palette…');
      try {
        const manifest = await manifestFile.files![0]!.text();
        const css = await cssFile.files![0]!.text();
        const response = await fetch(`${panel.dataset.devApi}/palettes/ingest`, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token.value.trim()}` }, body: JSON.stringify({ manifest, css }) });
        if (response.status === 401 || response.status === 403) { message('locked', 'Palette ingestion is locked. A valid admin token is required; loopback access alone does not unlock it.'); return; }
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Palette ingestion failed.');
        message('success', `${result.kitId} ${result.version} — Required semantics: ${result.requiredSemantics ? 'Yes' : `No — ${result.missingCount} missing`}. Destination: ${result.path}. Shelved, not active. Refresh or restart the dev server if the shelf has not updated.`);
        manifestFile.value = ''; cssFile.value = ''; token.value = '';
      } catch (error) { message('error', error instanceof Error ? error.message : 'Palette ingestion failed.'); }
      finally { pending = false; for (const input of [manifestFile, cssFile, token]) input.disabled = false; update(); }
    });
  }
  const jump = document.querySelector<HTMLSelectElement>('[data-palette-jump]');
  const focusPalette = () => {
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const card = document.getElementById(id);
    if (!card?.hasAttribute('data-palette')) return;
    if (jump) jump.value = id;
    card.focus({ preventScroll: true });
    card.scrollIntoView({ block: 'start', behavior: 'auto' });
  };
  jump?.addEventListener('change', () => { if (jump.value) { location.hash = jump.value; focusPalette(); } });
  window.addEventListener('hashchange', focusPalette);
  focusPalette();
</script>
