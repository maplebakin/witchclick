---
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";


const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/calendar" });

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';
const DEV_KEY = import.meta.env.PUBLIC_DEV_API_KEY || import.meta.env.PUBLIC_ADMIN_KEY || '';
---
<Base
  title="WitchClick — Editorial Calendar"
  description="Manage seasonal editorial calendar and content planning."
  canon={canonical}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6">
      <AdminNav currentPath="/admin/calendar" />

      <div class="mx-auto max-w-6xl space-y-6" data-calendar-admin data-dev-api={DEV_API} data-dev-key={DEV_KEY}>
      <header>
        <h1 class="text-2xl font-semibold text-primary">Editorial Calendar</h1>
        <p class="mt-2 text-sm text-body-muted">
          Manage seasonal content planning and anchor posts.
        </p>
      </header>

      <section class="rounded-2xl border border-line-neutral bg-surface-base p-6 shadow-sm">
        <div class="mb-4 flex items-center justify-between gap-4">
          <p class="text-xs text-body-muted">Last updated: <span data-updated-at>—</span></p>
          <button type="button" class="text-xs font-medium text-primary hover:underline" id="addSeasonBtn">
            + Add season
          </button>
        </div>

        <div class="space-y-3">
          <p class="text-sm font-medium text-body">Season planner</p>
          <p class="text-xs text-body-muted">
            Manage slug, season label, theme, focus, publishing window, anchor posts, rituals, and notes for each season.
          </p>
        </div>

        <div class="mt-4 space-y-4" data-season-list>
          <p class="rounded-lg border border-dashed border-line-subtle bg-surface-soft p-6 text-center text-sm text-body-muted" data-empty-state>
            No seasons yet. Add the first season to begin planning.
          </p>
        </div>

        <div class="mt-6 flex items-center gap-3 border-t border-line-subtle pt-4">
          <button type="button" id="saveBtn" class="admin-btn-primary px-5 py-2.5 text-sm font-medium">
            Save Calendar
          </button>
          <button type="button" id="resetBtn" class="admin-btn-secondary px-5 py-2.5 text-sm font-medium">
            Reset
          </button>
          <button type="button" id="validateBtn" class="admin-btn-secondary px-5 py-2.5 text-sm font-medium">
            Validate seasons
          </button>
          <p class="ml-auto text-sm" data-status role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
      </section>
      </div>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">This dashboard is only available in <strong>development</strong>.</p>
    </section>
  )}

  {canUse && (
    <script is:inline>
      (function(){
        const root = document.querySelector('[data-calendar-admin]');
        if (!root) return;
        const devApi = root.getAttribute('data-dev-api');
        const devKey = root.getAttribute('data-dev-key');
        function apiFetch(path, options = {}) {
          const headers = { ...(options.headers || {}) };
          if (devKey) headers['X-WC-Dev-Key'] = devKey;
          return fetch(devApi + path, { ...options, headers });
        }
        const seasonsListEl = root.querySelector('[data-season-list]');
        const addSeasonBtn = root.querySelector('#addSeasonBtn');
        const updatedAtEl = root.querySelector('[data-updated-at]');
        const statusEl = root.querySelector('[data-status]');
        const saveBtn = root.querySelector('#saveBtn');
        const resetBtn = root.querySelector('#resetBtn');
        const validateBtn = root.querySelector('#validateBtn');
        let seasons = [];

        function setStatus(msg, tone) {
          if (!statusEl) return;
          statusEl.textContent = msg || '';
          statusEl.className = 'ml-auto text-sm ' + (tone === 'error' ? 'text-danger' : tone === 'success' ? 'text-success' : 'text-body-muted');
        }

        function escapeHtml(value) {
          return (value ?? '').toString().replace(/[&<>"']/g, function (char) {
            switch (char) {
              case '&':
                return '&amp;';
              case '<':
                return '&lt;';
              case '>':
                return '&gt;';
              case '"':
                return '&quot;';
              case '\'':
                return '&#39;';
              default:
                return char;
            }
          });
        }

        function createSeason() {
          return {
            slug: '',
            season: '',
            theme: '',
            focus: '',
            window: '',
            anchorPosts: [],
            rituals: [],
            notes: ''
          };
        }

        function normalizeSeason(raw) {
          const base = createSeason();
          const normalized = Object.assign(base, raw || {});
          normalized.slug = (normalized.slug ?? '').toString();
          normalized.season = (normalized.season ?? '').toString();
          normalized.theme = (normalized.theme ?? '').toString();
          normalized.focus = (normalized.focus ?? '').toString();
          normalized.window = (normalized.window ?? '').toString();
          normalized.notes = (normalized.notes ?? '').toString();
          normalized.anchorPosts = Array.isArray(raw?.anchorPosts)
            ? raw.anchorPosts.map((anchor) => ({
                title: (anchor?.title ?? '').toString(),
                slug: (anchor?.slug ?? '').toString()
              }))
            : [];
          normalized.rituals = Array.isArray(raw?.rituals)
            ? raw.rituals.map((entry) => (entry ?? '').toString())
            : [];
          return normalized;
        }

        function renderSeasonCard(season, index, total) {
          const anchorPosts = season.anchorPosts
            .map(
              (anchor, anchorIndex) => `
                <div class="rounded-lg border border-line-subtle bg-surface-soft p-3" data-anchor-index="${anchorIndex}">
                  <div class="mb-2 flex items-center justify-between gap-2">
                    <h4 class="text-sm font-semibold text-primary">Anchor ${anchorIndex + 1}</h4>
                    <button type="button" class="text-xs text-body-muted hover:text-danger" data-remove-anchor>Remove</button>
                  </div>
                  <label class="block">
                    <span class="text-xs font-medium text-body">Title<span class="text-danger">*</span></span>
                    <input type="text" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="anchorPosts.title" data-anchor-index="${anchorIndex}" value="${escapeHtml(anchor.title)}" placeholder="Anchor title" />
                    <p class="mt-1 text-xs text-danger hidden" data-anchor-error="title"></p>
                  </label>
                  <label class="mt-3 block">
                    <span class="text-xs font-medium text-body">Slug<span class="text-danger">*</span></span>
                    <input type="text" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="anchorPosts.slug" data-anchor-index="${anchorIndex}" value="${escapeHtml(anchor.slug)}" placeholder="anchor-post-slug" />
                    <p class="mt-1 text-xs text-danger hidden" data-anchor-error="slug"></p>
                  </label>
                </div>
              `
            )
            .join('');

          const rituals = season.rituals
            .map(
              (ritual, ritualIndex) => `
                <div class="flex items-start gap-3" data-ritual-index="${ritualIndex}">
                  <div class="flex-1">
                    <label class="block">
                      <span class="text-xs font-medium text-body">Ritual ${ritualIndex + 1}</span>
                      <input type="text" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="rituals" data-ritual-index="${ritualIndex}" value="${escapeHtml(ritual)}" placeholder="Example: Oct 3 — Moonlit boundary mapping" />
                      <p class="mt-1 text-xs text-danger hidden" data-ritual-error></p>
                    </label>
                  </div>
                  <button type="button" class="mt-5 text-xs text-body-muted hover:text-danger" data-remove-ritual>Remove</button>
                </div>
              `
            )
            .join('');

          return `
            <article class="rounded-2xl border border-line-subtle bg-surface-soft p-5" data-season-index="${index}">
              <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h3 class="text-lg font-semibold text-primary">Season ${index + 1}</h3>
                  <p class="text-xs text-body-muted">Keep slugs unique and focused.</p>
                </div>
                <div class="flex items-center gap-2">
                  <button type="button" class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium hover:bg-surface-base" data-move-up ${index === 0 ? 'disabled' : ''}>Move up</button>
                  <button type="button" class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium hover:bg-surface-base" data-move-down ${index === total - 1 ? 'disabled' : ''}>Move down</button>
                  <button type="button" class="rounded-lg border border-line-neutral px-3 py-1.5 text-xs font-medium text-danger hover:bg-surface-base" data-remove-season>Remove</button>
                </div>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <label class="block">
                  <span class="text-sm font-medium text-body">Slug<span class="text-danger">*</span></span>
                  <input type="text" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="slug" value="${escapeHtml(season.slug)}" placeholder="fall-boundaries-in-bloom" />
                  <p class="mt-1 text-xs text-danger hidden" data-error-field="slug"></p>
                </label>
                <label class="block">
                  <span class="text-sm font-medium text-body">Season name<span class="text-danger">*</span></span>
                  <input type="text" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="season" value="${escapeHtml(season.season)}" placeholder="Fall" />
                  <p class="mt-1 text-xs text-danger hidden" data-error-field="season"></p>
                </label>
                <label class="block">
                  <span class="text-sm font-medium text-body">Theme<span class="text-danger">*</span></span>
                  <input type="text" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="theme" value="${escapeHtml(season.theme)}" placeholder="Boundaries in Bloom" />
                  <p class="mt-1 text-xs text-danger hidden" data-error-field="theme"></p>
                </label>
                <label class="block">
                  <span class="text-sm font-medium text-body">Focus<span class="text-danger">*</span></span>
                  <input type="text" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="focus" value="${escapeHtml(season.focus)}" placeholder="Tending tender boundaries…" />
                  <p class="mt-1 text-xs text-danger hidden" data-error-field="focus"></p>
                </label>
                <label class="block md:col-span-2">
                  <span class="text-sm font-medium text-body">Window<span class="text-danger">*</span></span>
                  <input type="text" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="window" value="${escapeHtml(season.window)}" placeholder="September – November" />
                  <p class="mt-1 text-xs text-danger hidden" data-error-field="window"></p>
                </label>
              </div>

              <div class="mt-6 space-y-3">
                <div class="flex items-center justify-between">
                  <h4 class="text-sm font-semibold text-body">Anchor posts</h4>
                  <button type="button" class="text-xs font-medium text-primary hover:underline" data-add-anchor>Add anchor</button>
                </div>
                <div class="space-y-3" data-anchor-list>
                  ${anchorPosts || '<p class="rounded-lg border border-dashed border-line-subtle bg-surface-base p-4 text-center text-xs text-body-muted">No anchor posts yet.</p>'}
                </div>
              </div>

              <div class="mt-6 space-y-3">
                <div class="flex items-center justify-between">
                  <h4 class="text-sm font-semibold text-body">Rituals</h4>
                  <button type="button" class="text-xs font-medium text-primary hover:underline" data-add-ritual>Add ritual</button>
                </div>
                <div class="space-y-3" data-ritual-list>
                  ${rituals || '<p class="rounded-lg border border-dashed border-line-subtle bg-surface-base p-4 text-center text-xs text-body-muted">No rituals yet.</p>'}
                </div>
              </div>

              <div class="mt-6">
                <label class="block">
                  <span class="text-sm font-medium text-body">Notes</span>
                  <textarea rows="3" class="mt-1 w-full rounded-lg border border-line-neutral bg-surface-base px-3 py-2 text-sm" data-field="notes" placeholder="Optional context or partner features">${escapeHtml(season.notes)}</textarea>
                </label>
              </div>
            </article>
          `;
        }

        function renderSeasons() {
          if (!seasonsListEl) return;
          if (!seasons.length) {
            seasonsListEl.innerHTML = '<p class="rounded-lg border border-dashed border-line-subtle bg-surface-soft p-6 text-center text-sm text-body-muted" data-empty-state>No seasons yet. Add the first season to begin planning.</p>';
            return;
          }
          seasonsListEl.innerHTML = seasons
            .map((season, index) => renderSeasonCard(season, index, seasons.length))
            .join('');
          seasons.forEach((_, index) => validateSeason(index));
        }

        function setInputError(input, errorEl, message) {
          if (!errorEl) return;
          if (message) {
            errorEl.textContent = message;
            errorEl.classList.remove('hidden');
          } else {
            errorEl.textContent = '';
            errorEl.classList.add('hidden');
          }
          if (input) {
            input.classList.toggle('border-danger', !!message);
          }
        }

        function validateSeason(index) {
          if (!seasonsListEl) return true;
          const season = seasons[index];
          const card = seasonsListEl.querySelector('[data-season-index="' + index + '"]');
          if (!season || !card) return true;
          let valid = true;

          const requiredFields = [
            ['slug', 'Slug is required.'],
            ['season', 'Season name is required.'],
            ['theme', 'Theme is required.'],
            ['focus', 'Focus is required.'],
            ['window', 'Window is required.']
          ];

          for (const [field, message] of requiredFields) {
            const input = card.querySelector('[data-field="' + field + '"]');
            const errorEl = card.querySelector('[data-error-field="' + field + '"]');
            const value = (season[field] || '').trim();
            if (!value) {
              setInputError(input, errorEl, message);
              valid = false;
            } else {
              setInputError(input, errorEl, '');
            }
          }

          const anchorNodes = card.querySelectorAll('[data-anchor-index]');
          anchorNodes.forEach((node) => {
            const anchorIndex = Number(node.getAttribute('data-anchor-index'));
            const anchor = season.anchorPosts[anchorIndex] || { title: '', slug: '' };
            const titleInput = node.querySelector('[data-field="anchorPosts.title"]');
            const slugInput = node.querySelector('[data-field="anchorPosts.slug"]');
            const titleError = node.querySelector('[data-anchor-error="title"]');
            const slugError = node.querySelector('[data-anchor-error="slug"]');
            const title = (anchor.title || '').trim();
            const slug = (anchor.slug || '').trim();
            if (!title) {
              setInputError(titleInput, titleError, 'Title is required.');
              valid = false;
            } else {
              setInputError(titleInput, titleError, '');
            }
            if (!slug) {
              setInputError(slugInput, slugError, 'Slug is required.');
              valid = false;
            } else {
              setInputError(slugInput, slugError, '');
            }
          });

          const ritualNodes = card.querySelectorAll('[data-ritual-index]');
          ritualNodes.forEach((node) => {
            const ritualIndex = Number(node.getAttribute('data-ritual-index'));
            const ritualInput = node.querySelector('[data-field="rituals"]');
            const ritualError = node.querySelector('[data-ritual-error]');
            const ritualValue = (season.rituals[ritualIndex] || '').trim();
            if (!ritualValue) {
              setInputError(ritualInput, ritualError, 'Ritual description is required or remove this row.');
              valid = false;
            } else {
              setInputError(ritualInput, ritualError, '');
            }
          });

          return valid;
        }

        function validateAllSeasons() {
          let ok = true;
          seasons.forEach((_, index) => {
            if (!validateSeason(index)) ok = false;
          });
          return ok;
        }

        function sanitizeSeasons() {
          return seasons.map((season) => {
            const cleanedAnchors = season.anchorPosts.map((anchor) => ({
              title: (anchor.title || '').trim(),
              slug: (anchor.slug || '').trim()
            }));
            const cleanedRituals = season.rituals.map((ritual) => (ritual || '').trim());
            return {
              slug: (season.slug || '').trim(),
              season: (season.season || '').trim(),
              theme: (season.theme || '').trim(),
              focus: (season.focus || '').trim(),
              window: (season.window || '').trim(),
              anchorPosts: cleanedAnchors,
              rituals: cleanedRituals,
              notes: (season.notes || '').trim()
            };
          });
        }

        async function loadData() {
          try {
            setStatus('Loading…');
            const res = await apiFetch('/calendar/get', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
            const json = await res.json();
            if (!json?.ok) throw new Error(json?.error || 'Failed to load');
            const data = json.data || {};
            seasons = Array.isArray(data.seasons) ? data.seasons.map(normalizeSeason) : [];
            renderSeasons();
            if (updatedAtEl) updatedAtEl.textContent = data.updatedAt || '—';
            setStatus('Loaded.', 'success');
            setTimeout(() => setStatus(''), 2000);
          } catch (e) {
            setStatus(e?.message || 'Failed to load.', 'error');
          }
        }

        async function saveData() {
          if (!validateAllSeasons()) {
            setStatus('Please resolve validation errors before saving.', 'error');
            return;
          }
          try {
            setStatus('Saving…');
            const sanitized = sanitizeSeasons();
            const data = { seasons: sanitized };
            const res = await apiFetch('/calendar/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            const json = await res.json();
            if (!json?.ok) throw new Error(json?.error || 'Failed to save');
            seasons = sanitized.map((season) => normalizeSeason(season));
            renderSeasons();
            if (updatedAtEl && json.data?.updatedAt) updatedAtEl.textContent = json.data.updatedAt;
            setStatus('Saved!', 'success');
            setTimeout(() => setStatus(''), 3000);
          } catch (e) {
            setStatus(e?.message || 'Failed to save.', 'error');
          }
        }

        function handleListInput(event) {
          const target = event.target;
          if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;
          const field = target.getAttribute('data-field');
          if (!field) return;
          const card = target.closest('[data-season-index]');
          if (!card) return;
          const seasonIndex = Number(card.getAttribute('data-season-index'));
          if (!Number.isFinite(seasonIndex)) return;
          const season = seasons[seasonIndex];
          if (!season) return;

          if (field === 'rituals') {
            const ritualIndex = Number(target.getAttribute('data-ritual-index'));
            if (Number.isFinite(ritualIndex)) {
              season.rituals[ritualIndex] = target.value;
            }
          } else if (field.startsWith('anchorPosts.')) {
            const anchorIndex = Number(target.getAttribute('data-anchor-index'));
            if (Number.isFinite(anchorIndex)) {
              const key = field.split('.')[1];
              if (!season.anchorPosts[anchorIndex]) {
                season.anchorPosts[anchorIndex] = { title: '', slug: '' };
              }
              season.anchorPosts[anchorIndex][key] = target.value;
            }
          } else {
            season[field] = target.value;
          }
          validateSeason(seasonIndex);
        }

        function handleListClick(event) {
          const target = event.target;
          if (!(target instanceof HTMLElement)) return;
          const card = target.closest('[data-season-index]');
          const seasonIndex = card ? Number(card.getAttribute('data-season-index')) : -1;

          if (target.closest('[data-remove-season]')) {
            if (!Number.isFinite(seasonIndex) || seasonIndex < 0) return;
            seasons.splice(seasonIndex, 1);
            renderSeasons();
            setStatus('Season removed.', 'success');
            return;
          }

          if (target.closest('[data-move-up]')) {
            if (!Number.isFinite(seasonIndex) || seasonIndex <= 0) return;
            const tmp = seasons[seasonIndex - 1];
            seasons[seasonIndex - 1] = seasons[seasonIndex];
            seasons[seasonIndex] = tmp;
            renderSeasons();
            return;
          }

          if (target.closest('[data-move-down]')) {
            if (!Number.isFinite(seasonIndex) || seasonIndex < 0 || seasonIndex >= seasons.length - 1) return;
            const tmp = seasons[seasonIndex + 1];
            seasons[seasonIndex + 1] = seasons[seasonIndex];
            seasons[seasonIndex] = tmp;
            renderSeasons();
            return;
          }

          if (target.closest('[data-add-anchor]')) {
            if (!Number.isFinite(seasonIndex) || seasonIndex < 0) return;
            seasons[seasonIndex].anchorPosts.push({ title: '', slug: '' });
            renderSeasons();
            return;
          }

          if (target.closest('[data-remove-anchor]')) {
            if (!Number.isFinite(seasonIndex) || seasonIndex < 0) return;
            const anchorNode = target.closest('[data-anchor-index]');
            if (!anchorNode) return;
            const anchorIndex = Number(anchorNode.getAttribute('data-anchor-index'));
            if (!Number.isFinite(anchorIndex)) return;
            seasons[seasonIndex].anchorPosts.splice(anchorIndex, 1);
            renderSeasons();
            return;
          }

          if (target.closest('[data-add-ritual]')) {
            if (!Number.isFinite(seasonIndex) || seasonIndex < 0) return;
            seasons[seasonIndex].rituals.push('');
            renderSeasons();
            return;
          }

          if (target.closest('[data-remove-ritual]')) {
            if (!Number.isFinite(seasonIndex) || seasonIndex < 0) return;
            const ritualNode = target.closest('[data-ritual-index]');
            if (!ritualNode) return;
            const ritualIndex = Number(ritualNode.getAttribute('data-ritual-index'));
            if (!Number.isFinite(ritualIndex)) return;
            seasons[seasonIndex].rituals.splice(ritualIndex, 1);
            renderSeasons();
            return;
          }
        }

        if (seasonsListEl) {
          seasonsListEl.addEventListener('input', handleListInput);
          seasonsListEl.addEventListener('click', handleListClick);
        }

        if (addSeasonBtn) {
          addSeasonBtn.addEventListener('click', () => {
            seasons.push(createSeason());
            renderSeasons();
            setStatus('New season added.', 'success');
            setTimeout(() => setStatus(''), 2000);
          });
        }

        if (saveBtn) saveBtn.addEventListener('click', saveData);
        if (resetBtn) resetBtn.addEventListener('click', loadData);
        if (validateBtn) validateBtn.addEventListener('click', () => {
          if (validateAllSeasons()) {
            setStatus('All seasons look good!', 'success');
            setTimeout(() => setStatus(''), 3000);
          } else {
            setStatus('Please resolve validation errors before saving.', 'error');
          }
        });

        loadData();
      })();
    </script>
  )}
</Base>
