---
import Base from "../../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../../utils/settings";

export const prerender = false; // never emit in static builds

const settings = readSettings();
const site = getSiteOrigin(settings) || "https://example.com";

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';
---
<Base
  title="WitchClick — Write"
  description="Compose a post in Markdown."
  canon={`${site}/admin/write`}
  wide={true}
  noindex={true}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  {canUse ? (
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12" data-dev-api={DEV_API}>
      <section class="lg:col-span-8 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <h1 class="mb-3 text-xl font-semibold">Write a Post</h1>

        <div class="grid gap-3 md:grid-cols-2">
          <label class="block">
            <span class="text-xs font-medium">Title</span>
            <input id="title" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="Tea Ritual for Focus" />
          </label>
          <label class="block">
            <span class="text-xs font-medium">Slug (optional)</span>
            <input id="slug" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="tea-ritual-for-focus" />
            <p class="mt-1 text-[11px] text-body-subtle">Leave blank to auto-generate from the title.</p>
            <p id="slugPreview" class="mt-1 text-[11px] font-mono text-body-faint"></p>
          </label>
          <label class="block md:col-span-2">
            <span class="text-xs font-medium">Excerpt</span>
            <input id="excerpt" class="mt-1 w-full rounded-lg border px-3 py-2" />
            <p class="mt-1 text-[11px] text-body-subtle">Leave blank to auto-generate from your Markdown.</p>
          </label>
          <label class="block md:col-span-2">
            <span class="text-xs font-medium">Meta Description</span>
            <input id="meta" class="mt-1 w-full rounded-lg border px-3 py-2" />
            <p class="mt-1 text-[11px] text-body-subtle">Leave blank for an SEO-friendly summary (≈155 characters).</p>
          </label>
          <label class="block md:col-span-2">
            <span class="text-xs font-medium">Tags (comma or newline separated, 4–7 ideal)</span>
            <input id="tags" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="tea, ritual, focus, study" />
          </label>
        </div>

        <div class="mt-4 flex gap-4">
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="checkbox" id="ads" /> <span>Include ads (sidebar + end)</span>
          </label>
          <label class="inline-flex items-center gap-2 text-sm">
            <input type="checkbox" id="kofi" /> <span>Include Ko-fi block</span>
          </label>
        </div>

        <label class="mt-4 block">
          <span class="text-xs font-medium">Entities (optional, type:slug, comma-separated)</span>
          <input id="entities" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="herb:peppermint, crystal:fluorite" />
        </label>

        <label class="mt-4 block">
          <span class="text-xs font-medium">Markdown</span>
          <textarea id="markdown" class="mt-1 h-80 w-full rounded-lg border px-3 py-2 font-mono text-sm" placeholder="## Heading&#10;&#10;Your cozy content here..."></textarea>
        </label>

        <div class="mt-4 flex flex-col gap-2 md:flex-row md:items-center">
          <button id="save" class="rounded-lg bg-surface-accent-bolder px-4 py-2 text-inverse hover:bg-surface-accent-deep">Save</button>
          <button id="savePublish" class="rounded-lg border px-4 py-2">Save + Publish bundle</button>
          <div id="status" class="text-sm text-body-muted md:flex-1"></div>
        </div>
      </section>

      <aside class="lg:col-span-4 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <h2 class="mb-2 text-lg font-semibold">Tips</h2>
        <ul class="list-disc pl-5 text-sm">
          <li>Use <code>##</code> for section headings; they become the outline.</li>
          <li>4–7 tags is a sweet spot for SEO.</li>
          <li>Entities format: <code>type:slug</code> — valid types: herb, crystal, moonPhase, tarot, planetaryDay, ritual.</li>
          <li>Slug, excerpt, and meta description can be left blank — they&#39;ll be auto-generated from your title and Markdown.</li>
        </ul>
      </aside>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">These tools only run in <strong>development</strong> (or with a temporary key on a server adapter).</p>
      <p class="mt-3 text-sm text-body-muted">Use the ingestion CLI instead: <code>npm run ingest ./path/to/post.json</code></p>
    </section>
  )}

  {canUse && (
    <script is:inline>
      (function(){
        var $ = function(id){ return document.getElementById(id); };
        var root = document.querySelector('[data-dev-api]');
        var DEV_API = root?.getAttribute('data-dev-api') || 'http://localhost:8787';

        function setStatus(msg, ok, warnings){
          var el = $('status');
          if (!el) return;
          el.innerHTML = '';
          el.style.color = ok === false ? '#7f1d1d' : '#065f46';
          if (msg) {
            var span = document.createElement('span');
            span.textContent = msg;
            el.appendChild(span);
          }
          if (Array.isArray(warnings) && warnings.length) {
            var list = document.createElement('ul');
            list.className = 'mt-1 list-disc pl-4 text-[11px] text-warning';
            warnings.forEach(function(note){
              var li = document.createElement('li');
              li.textContent = note;
              list.appendChild(li);
            });
            el.appendChild(list);
          }
        }

        function slugify(value){
          var base = String(value || '').toLowerCase();
          if (typeof base.normalize === 'function') {
            base = base.normalize('NFKD');
          }
          base = base.replace(/[\u0300-\u036f]/g, '');
          return base
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/(^-|-$)/g, '');
        }

        var titleInput = $('title');
        var slugInput = $('slug');
        var slugPreview = $('slugPreview');
        var slugTouched = false;

        function currentSlug(){
          if (!slugInput) return '';
          var manual = slugify(slugInput.value);
          if (manual) return manual;
          if (titleInput) return slugify(titleInput.value);
          return '';
        }

        function renderSlug(){
          if (!slugPreview) return;
          var slug = currentSlug();
          if (slug) {
            slugPreview.textContent = 'Preview: /post/' + slug;
          } else {
            slugPreview.textContent = 'Slug will be generated from the title.';
          }
        }

        if (titleInput && slugInput) {
          titleInput.addEventListener('input', function(){
            if (!slugTouched) {
              slugInput.value = slugify(titleInput.value);
            }
            renderSlug();
          });

          slugInput.addEventListener('input', function(){
            slugTouched = slugInput.value.trim().length > 0;
            renderSlug();
          });

          slugInput.addEventListener('blur', function(){
            slugInput.value = slugify(slugInput.value);
            slugTouched = slugInput.value.trim().length > 0;
            renderSlug();
          });

          renderSlug();
        }

        function summarizeEntities(list){
          if (!Array.isArray(list) || !list.length) return '';
          return list
            .map(function(item){
              var type = item && item.type ? item.type : '?';
              var slug = item && item.slug ? item.slug : '?';
              return type + ':' + slug;
            })
            .join(', ');
        }

        async function savePost() {
          if (slugInput) {
            slugInput.value = slugify(slugInput.value);
            slugTouched = slugInput.value.trim().length > 0;
            renderSlug();
          }
          var payload = {
            title: $('title').value,
            slug: $('slug').value,
            excerpt: $('excerpt').value,
            metaDescription: $('meta').value,
            tags: $('tags').value,
            includeAds: $('ads').checked,
            includeKofi: $('kofi').checked,
            entities: $('entities').value,
            markdown: $('markdown').value
          };
          var res = await fetch(DEV_API + '/posts/save', {
            method: 'POST',
            headers: { 'Content-Type':'application/json' },
            body: JSON.stringify(payload)
          });
          var data = await res.json();
          if (!data.ok) throw new Error(data.error || 'save failed');
          return data;
        }

        $('save').addEventListener('click', async function(){
          try {
            setStatus('Saving...');
            var data = await savePost();
            var summary = summarizeEntities(data.entities);
            var message = 'Saved → ' + data.path + (summary ? ' · Entities: ' + summary : '');
            setStatus(message, true, data.warnings);
          }
          catch (e) { setStatus('Save error: ' + (e.message || String(e)), false); }
        });

        $('savePublish').addEventListener('click', async function(){
          try {
            setStatus('Saving...');
            var data = await savePost();
            var summary = summarizeEntities(data.entities);
            setStatus('Saved. Publishing...', true, data.warnings);
            var res = await fetch(DEV_API + '/bundle', { method:'POST' });
            var b = await res.json();
            if (!b.ok) throw new Error((b.steps && b.steps.map(function(s){return s.err;}).join('\n')) || b.error || 'bundle failed');
            var publishMsg = 'Published ✓  Open post: /post/' + data.slug + (summary ? ' · Entities: ' + summary : '');
            setStatus(publishMsg, true, data.warnings);
          } catch (e) {
            setStatus('Publish error: ' + (e.message || String(e)), false);
          }
        });
      })();
    </script>
  )}
</Base>
