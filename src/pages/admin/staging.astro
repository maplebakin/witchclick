---
/* Admin: Post Staging - Review, compare, and publish draft posts */
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";
import HeroWorkflow from "@/components/admin/HeroWorkflow.astro";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/staging" });

// Gate: dev OR query ?key=PUBLIC_ADMIN_KEY
const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get("key") === ADMIN_KEY;
const canUse = isDev || !!keyOk;
const DEV_API = import.meta.env.PUBLIC_DEV_API || "http://127.0.0.1:8787";
const DEV_KEY = import.meta.env.PUBLIC_DEV_API_KEY || import.meta.env.PUBLIC_ADMIN_KEY || "";

---

<Base
  title="WitchClick — Post Staging"
  description="Review, compare, and publish draft posts."
  canon={canonical}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {
    canUse ? (
      <div class="space-y-6" data-staging-root data-dev-api={DEV_API} data-dev-key={DEV_KEY}>
        <AdminNav currentPath="/admin/staging" />

        <section class="rounded-2xl border border-line-subtle bg-surface-base p-6 shadow-sm">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <h1 class="text-2xl font-semibold text-body-strong">Staging</h1>
                <p class="mt-1 text-sm text-body-muted">
                  Review drafts from newest to oldest. Open a draft to read it, prepare its hero, then make it publicly eligible locally.
                </p>
              </div>
              <button
                id="refreshBtn"
                class="admin-btn-secondary px-4 py-2 text-sm font-medium"
              >
                Refresh
              </button>
            </div>
            <div class="rounded-lg border border-dashed border-line-subtle bg-surface-base/60 p-4 text-[0.8rem] text-body-muted">
              <div class="mb-2 font-semibold">How it works:</div>
              <ol class="ml-4 list-decimal space-y-1">
                <li>
                  Ingest posts with <code>?draft=true</code> or use "Save as Draft" to stage them
                </li>
                <li>Review drafts here - compare different versions of the same topic</li>
                <li>Review preparation checks, then make a draft publicly eligible locally or permanently remove it</li>
                <li>Checks passed still requires final editorial review. Publishing here does not build or deploy the site.</li>
              </ol>
            </div>
          </div>
        </section>

        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
        <section class="rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm lg:col-span-4 lg:h-[calc(100vh-13rem)] lg:overflow-y-auto">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-xl font-semibold">Draft Posts</h2>
            <div class="flex items-center gap-3">
              <label class="inline-flex items-center gap-2 text-sm">
                <input type="checkbox" id="groupByTopic" />
                <span>Group by topic</span>
              </label>
              <span id="draftCount" class="text-sm text-body-muted" />
            </div>
          </div>

          <div class="mb-4 flex items-center gap-3">
            <input
              id="draftSearch"
              type="search"
              placeholder="Search drafts by title or slug..."
              class="admin-btn-secondary w-full px-3 py-2"
            />
            <button
              id="clearDraftSearch"
              type="button"
              class="admin-btn-secondary hidden px-3 py-2 text-sm"
              aria-label="Clear draft search"
            >
              ×
            </button>
          </div>

          <label class="mb-4 flex flex-wrap items-center gap-3 text-sm">
            <span>Readiness</span>
            <select id="readinessFilter" class="admin-btn-secondary px-3 py-2">
              <option value="all">All</option>
              <option value="checks-passed">Checks passed</option>
              <option value="needs-work">Needs work</option>
              <option value="missing-hero">Missing hero</option>
              <option value="placeholder-stub">Placeholder/stub</option>
              <option value="unknown">Unknown</option>
            </select>
          </label>
          <p id="stagingStatus" class="mb-3 text-sm text-body-muted" role="status" aria-live="polite"></p>

          <div id="draftsList" class="space-y-4">
            <div class="py-8 text-center text-body-muted">Loading drafts...</div>
          </div>
        </section>

        <div class="space-y-6 lg:col-span-8 lg:h-[calc(100vh-13rem)] lg:overflow-y-auto">
        <section id="emptyReview" class="rounded-2xl border border-dashed border-line-neutral bg-surface-base p-10 text-center text-body-muted">
          <h2 class="text-lg font-semibold text-body-strong">Choose an article to review</h2>
          <p class="mt-2 text-sm">The article preview, hero prompt, and local publication action will appear here.</p>
        </section>

        <section
          id="comparisonSection"
          class="hidden rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm"
        >
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-semibold">Compare Drafts</h2>
            <button
              id="closeCompare"
              class="text-sm text-body-muted hover:text-body"
            >
              Close
            </button>
          </div>
          <div id="comparisonContent" class="grid grid-cols-1 gap-4 lg:grid-cols-2" />
        </section>

        <section
          id="previewSection"
          class="hidden rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm"
        >
          <div class="mb-4 flex items-center justify-between">
            <h2 id="reviewTitle" class="text-xl font-semibold">Review draft</h2>
            <button id="closePreview" class="text-sm text-body-muted hover:text-body">
              Close
            </button>
          </div>
          <div id="previewContent" class="prose prose-neutral max-w-none" />
          <section class="mt-6 space-y-3 border-t border-line-neutral pt-6" aria-labelledby="staging-hero-heading">
            <h3 id="staging-hero-heading" class="text-lg font-semibold text-body-strong">Step 2 — Prepare the hero image</h3>
            <p class="text-sm text-body-muted">Review the saved prompt, create or choose artwork, then attach it and confirm its alt text. The draft stays private while you work.</p>
            <HeroWorkflow mode="embedded" devApi={DEV_API} devKey={DEV_KEY} lockedMessage="Open a draft to load its hero prompt here." />
          </section>
          <section class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-line-neutral pt-6" aria-labelledby="staging-publish-heading">
            <div>
              <h3 id="staging-publish-heading" class="font-semibold text-body-strong">Step 3 — Final review and publication</h3>
              <p class="text-sm text-body-muted">This makes the draft publicly eligible locally. It does not build or deploy the site.</p>
            </div>
            <button id="publishSelectedBtn" class="admin-btn-primary px-4 py-2 text-sm font-semibold" disabled>Review a draft first</button>
          </section>
        </section>
        </div>
        </div>
      </div>
    ) : (
      <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
        <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
        <p class="text-body-muted">
          These tools only run in <strong>development</strong> (or with a temporary key when hosted
          on a server adapter).
        </p>
      </section>
    )
  }

  {
	    canUse && (
	      <script is:inline>
	        (function () {
	          var root = document.querySelector("[data-staging-root]");
              if (!root) return;
          var requestedSlug = new URLSearchParams(window.location.search).get("slug") || "";
          var filteredDrafts = [];
          var activeSlug = "";
          var activeDraftPublished = false;
	          var $ = function (id) {
	            return document.getElementById(id);
	          };

          var devApi = (root.dataset.devApi || 'http://127.0.0.1:8787').replace(/\/+$/, '');
          function apiFetch(path, options) {
            options = options || {};
            options.headers = Object.assign({}, options.headers || {});
            if (root.dataset.devKey) options.headers['X-WC-Dev-Key'] = root.dataset.devKey;
            return fetch(devApi + path, options);
          }

          function checkStagingAccess(response) {
            if (response.status === 401 || response.status === 403) {
              throw new Error("Staging actions are locked by the local dev API. If DEV_API_TOKEN is configured, use its matching authorized dev API key. Otherwise run dev-api.js bound to loopback.");
            }
          }

          var drafts = [];
          var pending = new Set();
          var stateLabels = { 'checks-passed': 'Checks passed — final review needed', 'needs-work': 'Needs work', 'missing-hero': 'Missing hero', 'placeholder-stub': 'Placeholder/stub', 'unknown': 'Unknown' };
          function draftState(draft) { return Object.hasOwn(stateLabels, draft.state) ? draft.state : 'unknown'; }
          function draftReasons(draft) { return Array.isArray(draft.reasons) && draft.reasons.length ? draft.reasons : ['Readiness was not provided by the server. Refresh before publishing.']; }
          function publishAllowed(draft) { return draft.canPublish === true && ['checks-passed', 'missing-hero'].includes(draftState(draft)); }
          function setPending(slug, on) {
            if (on) pending.add(slug); else pending.delete(slug);
            renderDrafts();
          }

          function creationTime(draft) {
            var value = draft.createdAt || draft.publishedAt || (draft.promptMetadata && draft.promptMetadata.generatedAt) || '';
            var timestamp = Date.parse(value);
            return Number.isFinite(timestamp) ? timestamp : 0;
          }

          function updatePublishAction() {
            var button = $('publishSelectedBtn');
            if (!button) return;
            if (activeDraftPublished) {
              button.disabled = true;
              button.textContent = 'Made publicly eligible locally';
              return;
            }
            var draft = drafts.find(function(item){ return item.slug === activeSlug; });
            if (!draft) {
              button.disabled = true;
              button.textContent = 'Review a draft first';
              return;
            }
            button.disabled = pending.has(activeSlug) || !publishAllowed(draft);
            button.textContent = pending.has(activeSlug) ? 'Working…' : publishAllowed(draft) ? 'Make publicly eligible locally' : 'Publication blocked';
          }

          function getSearchQuery() {
            return (($("draftSearch") && $("draftSearch").value) || "").trim().toLowerCase();
          }

          function updateSearchUi() {
            var clearBtn = $("clearDraftSearch");
            var hasQuery = !!getSearchQuery();
            if (clearBtn) {
              clearBtn.classList.toggle("hidden", !hasQuery);
            }
          }

          function getVisibleDrafts() {
            var query = getSearchQuery();
            var state = $('readinessFilter').value;
            return drafts.filter(function (draft) {
              var title = String(draft.title || '').toLowerCase();
              var slug = String(draft.slug || '').toLowerCase();
              return (state === 'all' || draftState(draft) === state) && (!query || title.includes(query) || slug.includes(query));
            });
          }

          function formatDate(isoString) {
            var date = new Date(isoString);
            return date.toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
              hour: "2-digit",
              minute: "2-digit",
            });
          }

          function extractTopic(draft) {
            if (draft.promptMetadata && draft.promptMetadata.topic) {
              return draft.promptMetadata.topic.toLowerCase().trim();
            }
            // Fallback: extract main keywords from title
            var title = draft.title.toLowerCase();
            // Remove common words
            var cleaned = title
              .replace(/\b(a|an|the|for|to|of|and|with|your|my|in|on)\b/g, " ")
              .replace(/\s+/g, " ")
              .trim();
            return cleaned || title;
          }

          function groupDraftsByTopic(draftList) {
            var groups = {};
            for (var i = 0; i < draftList.length; i++) {
              var draft = draftList[i];
              var topic = extractTopic(draft);
              if (!groups[topic]) groups[topic] = [];
              groups[topic].push(draft);
            }
            return groups;
          }

          async function loadDrafts() {
	            try {
	              $("draftsList").innerHTML =
	                '<div class="py-8 text-center text-body-muted">Loading drafts...</div>';

	              var res = await apiFetch("/staging/list", { method: "POST" });
	              checkStagingAccess(res);
              var data = await res.json();

              if (!data.ok) throw new Error(data.error || "Failed to load drafts");

              drafts = (data.drafts || []).slice().sort(function(a, b) {
                return creationTime(b) - creationTime(a) || String(a.title || a.slug).localeCompare(String(b.title || b.slug));
              });
              updateSearchUi();
              renderDrafts();
              if (requestedSlug && !activeSlug && drafts.some(function(draft){ return draft.slug === requestedSlug; })) previewDraft(requestedSlug);
            } catch (e) {
              $("draftsList").textContent = 'Error: ' + (e.message || String(e));
            }
          }

          function renderDrafts() {
            var list = $("draftsList");
            var count = $("draftCount");
            var grouped = $("groupByTopic").checked;
            filteredDrafts = getVisibleDrafts();

            count.textContent =
              filteredDrafts.length + " of " + drafts.length + " draft" + (drafts.length === 1 ? "" : "s");

            if (!drafts.length) {
              list.innerHTML =
                '<div class="py-8 text-center text-body-muted">No drafts found. Ingest posts with <code>?draft=true</code> to stage them here.</div>';
              updatePublishAction();
              return;
            }

            if (!filteredDrafts.length) {
              list.innerHTML =
                '<div class="py-8 text-center text-body-muted">No drafts match.</div>';
              updatePublishAction();
              return;
            }

            if (grouped) {
              var groups = groupDraftsByTopic(filteredDrafts);
              var html = "";
              var topics = Object.keys(groups).sort(function(a, b) {
                return creationTime(groups[b][0]) - creationTime(groups[a][0]) || a.localeCompare(b);
              });

              for (var i = 0; i < topics.length; i++) {
                var topic = topics[i];
                var topicDrafts = groups[topic];
                html += '<div class="rounded-lg border border-line-subtle bg-surface-soft p-4">';
                html +=
                  '<div class="mb-3 flex items-center justify-between">';
                html +=
                  '<h3 class="text-sm font-semibold text-body-strong">' +
                  escapeHtml(topic) +
                  ' <span class="text-body-muted">(' +
                  topicDrafts.length +
                  ")</span></h3>";
                if (topicDrafts.length > 1) {
                  html +=
                    '<button class="compare-topic-btn rounded border border-line-neutral bg-surface-base px-2 py-1 text-[0.8rem] hover:bg-surface-soft" data-topic="' +
                    escapeHtml(topic) +
                    '">Compare All</button>';
                }
                html += "</div>";
                html += '<div class="space-y-2">';
                for (var j = 0; j < topicDrafts.length; j++) {
                  html += renderDraftCard(topicDrafts[j], true);
                }
                html += "</div></div>";
              }
              list.innerHTML = html;
            } else {
              var html = "";
              for (var i = 0; i < filteredDrafts.length; i++) {
                html += renderDraftCard(filteredDrafts[i], false);
              }
              list.innerHTML = html;
            }

            if (requestedSlug) {
              var match = list.querySelector('[data-slug="' + requestedSlug.replace(/"/g, '&quot;') + '"]');
              if (match && typeof match.scrollIntoView === "function") {
                match.scrollIntoView({ block: "nearest" });
              }
            }

            updatePublishAction();
          }

          function renderDraftCard(draft, compact) {
            var cardClass = compact
              ? "rounded border border-line-subtle bg-surface-base p-3"
              : "rounded-lg border border-line-subtle bg-surface-soft p-4";

            var html = '<div class="' + cardClass + '" data-slug="' + escapeHtml(draft.slug) + '">';

            html += '<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">';
            html += '<div class="min-w-0 flex-1">';
            html +=
              '<h4 class="font-semibold text-body-strong">' + escapeHtml(draft.title) + "</h4>";
            html +=
              '<p class="mt-1 text-sm text-body-muted line-clamp-2">' +
              escapeHtml(draft.excerpt) +
              "</p>";
            html += '<div class="mt-2 flex flex-wrap gap-2 text-[0.8rem] text-body-faint">';
            html += "<span>" + draft.wordCount + " words</span>";
            html += '<span class="text-line-subtle">•</span>';
            html += "<span>" + draft.readingMinutes + " min read</span>";
            html += '<span class="text-line-subtle">•</span>';
            html += "<span>Added " + formatDate(draft.createdAt || draft.publishedAt) + "</span>";
            if (draft.promptMetadata && draft.promptMetadata.topic) {
              html += '<span class="text-line-subtle">•</span>';
              html +=
                '<span class="rounded bg-surface-accent-soft px-1.5 py-0.5 text-primary">Topic: ' +
                escapeHtml(draft.promptMetadata.topic) +
                "</span>";
            }
            html += "</div>";

            if (draft.tags.length) {
              html += '<div class="mt-2 flex flex-wrap gap-1">';
              for (var i = 0; i < Math.min(draft.tags.length, 5); i++) {
                html +=
                  '<span class="rounded-full bg-surface-neutral-soft px-2 py-0.5 text-[0.8rem] text-body-muted">' +
                  escapeHtml(draft.tags[i]) +
                  "</span>";
              }
              if (draft.tags.length > 5) {
                html +=
                  '<span class="text-[0.8rem] text-body-faint">+' +
                  (draft.tags.length - 5) +
                  " more</span>";
              }
              html += "</div>";
            }

            html += '<p class="mt-3 text-sm font-semibold">' + escapeHtml(stateLabels[draftState(draft)]) + '</p>';
            html += '<ul class="mt-1 list-disc pl-5 text-sm">' + draftReasons(draft).map(function(reason){ return '<li>' + escapeHtml(reason) + '</li>'; }).join('') + '</ul>';
            var secondary = (Array.isArray(draft.blockers) ? draft.blockers : []).filter(function(blocker){ return !draftReasons(draft).some(function(reason){ return reason.includes(blocker); }); });
            if (secondary.length) html += '<p class="mt-2 text-sm">Blockers: ' + secondary.map(escapeHtml).join('; ') + '</p>';
            html += "</div>";

            var disabled = pending.has(draft.slug) ? ' disabled' : '';
            html += '<div class="flex flex-shrink-0 flex-col gap-2">';
            html +=
              '<button class="preview-btn admin-btn-secondary px-3 py-1.5 text-[0.8rem] font-medium" data-slug="' +
              escapeHtml(draft.slug) +
              '"' + disabled + '>Review &amp; prepare</button>';
            html +=
              '<button class="delete-btn admin-btn-secondary px-3 py-1.5 text-[0.8rem] font-medium text-danger" data-slug="' +
              escapeHtml(draft.slug) +
              '"' + disabled + '>Delete draft</button>';
            html += "</div>";

            html += "</div></div>";
            return html;
          }

          function escapeHtml(text) {
            var div = document.createElement("div");
            div.appendChild(document.createTextNode(text));
            return div.innerHTML.replace(/"/g, '&quot;');
          }

          // Bind once on the list; rerenders and comparisons never rebind controls.
          $('draftsList').addEventListener('click', function(event) {
            var button = event.target.closest('button');
            if (!button || button.disabled || !$('draftsList').contains(button)) return;
            var slug = button.getAttribute('data-slug');
            if (slug && pending.has(slug)) return;
            if (button.classList.contains('preview-btn')) previewDraft(slug);
            else if (button.classList.contains('publish-btn')) publishDraft(slug);
            else if (button.classList.contains('delete-btn')) deleteDraft(slug);
            else if (button.classList.contains('compare-topic-btn')) compareByTopic(button.getAttribute('data-topic'));
          });

          async function previewDraft(slug) {
            if (pending.has(slug)) return;
            activeSlug = slug;
            activeDraftPublished = false;
            updatePublishAction();
            $('reviewTitle').textContent = 'Loading draft…';
            $('previewContent').textContent = '';
            $('previewSection').classList.remove('hidden');
            if ($('emptyReview')) $('emptyReview').classList.add('hidden');
            $('comparisonSection').classList.add('hidden');
            var heroRoot = root.querySelector('[data-hero-workflow]');
            if (heroRoot) heroRoot.dispatchEvent(new CustomEvent('hero-workflow:reset'));
            setPending(slug, true);
            try {
              var res = await apiFetch("/staging/preview", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ slug: slug }),
              });
              checkStagingAccess(res);
              var data = await res.json();

              if (!data.ok) throw new Error(data.error || "Failed to load preview");

              renderPreview(data);
              $('reviewTitle').textContent = 'Step 1 — ' + (data.frontmatter.title || slug);
              if (heroRoot) {
                heroRoot.setAttribute('data-hero-slug', slug);
                heroRoot.dispatchEvent(new CustomEvent('hero-workflow:set-post', { detail: { slug: slug, expectedTitle: data.frontmatter.title, requireDraft: true } }));
              }
              $("previewSection").classList.remove("hidden");
              if ($('emptyReview')) $('emptyReview').classList.add('hidden');
              updatePublishAction();
            } catch (e) {
              activeSlug = '';
              $('reviewTitle').textContent = 'Could not load draft';
              $('previewContent').textContent = e.message || String(e);
              if (heroRoot) heroRoot.dispatchEvent(new CustomEvent('hero-workflow:reset'));
              updatePublishAction();
            } finally { setPending(slug, false); }
          }

          function renderPreview(data) {
            var content = $("previewContent");
            var html = "";

            html += "<h1>" + escapeHtml(data.frontmatter.title) + "</h1>";

            if (data.frontmatter.tags && data.frontmatter.tags.length) {
              html +=
                '<p class="text-sm text-body-muted">Tags: ' +
                data.frontmatter.tags.map(escapeHtml).join(", ") +
                "</p>";
            }

            // Simple markdown rendering (just headings and paragraphs)
            var lines = data.markdown.split("\n");
            for (var i = 0; i < lines.length; i++) {
              var line = lines[i];
              if (line.startsWith("## ")) {
                html += "<h2>" + escapeHtml(line.substring(3)) + "</h2>";
              } else if (line.startsWith("### ")) {
                html += "<h3>" + escapeHtml(line.substring(4)) + "</h3>";
              } else if (line.trim()) {
                html += "<p>" + escapeHtml(line) + "</p>";
              }
            }

            html +=
              '<p class="mt-4 text-[0.8rem] text-body-faint">~' +
              data.frontmatter.wordCount +
              " words • ~" +
              data.frontmatter.readingMinutes +
              " min read</p>";

            content.innerHTML = html;
          }

          async function compareByTopic(topic) {
            var groups = groupDraftsByTopic(filteredDrafts);
            var topicDrafts = groups[topic] || [];

            if (topicDrafts.length < 2) {
              alert("Need at least 2 drafts to compare");
              return;
            }

            // Load full content for comparison
            var promises = topicDrafts.map(async function (draft) {
              var res = await apiFetch("/staging/preview", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ slug: draft.slug }),
              });
              checkStagingAccess(res);
              return res.json();
            });

            try {
              var results = await Promise.all(promises);
              renderComparison(results);
              $("comparisonSection").classList.remove("hidden");
              $("previewSection").classList.add("hidden");
              if ($('emptyReview')) $('emptyReview').classList.add("hidden");
            } catch (e) {
              alert("Error loading comparison: " + (e.message || String(e)));
            }
          }

          function renderComparison(posts) {
            var content = $("comparisonContent");
            var html = "";

            for (var i = 0; i < posts.length; i++) {
              var post = posts[i];
              if (!post.ok) continue;

              html +=
                '<div class="rounded-lg border border-line-subtle bg-surface-soft p-4">';
              html += '<div class="mb-3 flex items-center justify-between">';
              html +=
                '<h3 class="font-semibold text-body-strong">' +
                escapeHtml(post.frontmatter.title) +
                "</h3>";
              html += "</div>";

              html += '<div class="mb-2 text-[0.8rem] text-body-muted">';
              html += post.frontmatter.wordCount + " words • ";
              html += post.frontmatter.readingMinutes + " min read • ";
              html += formatDate(post.frontmatter.publishedAt);
              html += "</div>";

              html +=
                '<div class="prose prose-sm max-h-96 overflow-y-auto rounded border border-line-subtle bg-surface-base p-3">';

              // Render markdown
              var lines = post.markdown.split("\n");
              for (var j = 0; j < lines.length; j++) {
                var line = lines[j];
                if (line.startsWith("## ")) {
                  html += "<h2>" + escapeHtml(line.substring(3)) + "</h2>";
                } else if (line.startsWith("### ")) {
                  html += "<h3>" + escapeHtml(line.substring(4)) + "</h3>";
                } else if (line.trim()) {
                  html += "<p>" + escapeHtml(line) + "</p>";
                }
              }

              html += "</div></div>";
            }

            content.innerHTML = html;
          }

          async function publishDraft(slug) {
            var draft = drafts.find(function(item){ return item.slug === slug; });
            if (!draft || activeSlug !== slug || pending.has(slug) || !publishAllowed(draft)) return;
            var noHero = draftState(draft) === 'missing-hero';
            var message = 'Make “' + draft.title + '” (' + slug + ') publicly eligible locally? This does not build or deploy the site.';
            if (noHero) message = 'You are publishing without a hero image or complete hero metadata.\n' + draftReasons(draft).join('; ') + '\n' + message;
            if (draft.visibilityBlockers && draft.visibilityBlockers.length) message += '\nRemaining visibility blockers: ' + draft.visibilityBlockers.join('; ');
            if (!confirm(message)) return;
            setPending(slug, true);
            try {
              var res = await apiFetch('/staging/publish', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ slug: slug, acknowledgeMissingHero: noHero }),
              });
              checkStagingAccess(res);
              var data = await res.json();
              if (!data.ok) {
                await loadDrafts();
                throw new Error(data.error || 'Failed to publish');
              }
              var result = data.message || 'Saved. Check local public eligibility; the site has not been built or deployed.';
              if (Array.isArray(data.warnings) && data.warnings.length) result += '\nArtwork warnings: ' + data.warnings.join('; ');
              $('stagingStatus').textContent = result;
              activeDraftPublished = true;
              updatePublishAction();
              await loadDrafts();
              $('comparisonSection').classList.add('hidden');
            } catch (e) {
              $('stagingStatus').textContent = 'Publication rejected: ' + (e.message || String(e));
            } finally { setPending(slug, false); }
          }

          async function deleteDraft(slug) {
            var draft = drafts.find(function(item){ return item.slug === slug; });
            if (!draft || pending.has(slug)) return;
            if (!confirm('Permanently remove the draft file for “' + draft.title + '” (' + slug + ')? This cannot be undone.')) return;
            setPending(slug, true);
            try {
              var res = await apiFetch('/staging/delete', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug: slug }),
              });
              checkStagingAccess(res);
              var data = await res.json();
              if (!data.ok) throw new Error(data.error || 'Failed to delete');
              $('stagingStatus').textContent = 'Draft file permanently removed: ' + data.title + ' (' + slug + ').';
              await loadDrafts();
              $('comparisonSection').classList.add('hidden'); $('previewSection').classList.add('hidden');
              activeSlug = ''; activeDraftPublished = false;
              var heroRoot = root.querySelector('[data-hero-workflow]');
              if (heroRoot) heroRoot.dispatchEvent(new CustomEvent('hero-workflow:reset'));
              if ($('emptyReview')) $('emptyReview').classList.remove('hidden');
            } catch (e) { $('stagingStatus').textContent = 'Deletion failed: ' + (e.message || String(e)); }
            finally { setPending(slug, false); }
          }

          // Event listeners
          $("refreshBtn").addEventListener("click", loadDrafts);
          $("publishSelectedBtn").addEventListener("click", function(){ if (activeSlug) publishDraft(activeSlug); });
          var stagingHeroRoot = root.querySelector('[data-hero-workflow]');
          if (stagingHeroRoot) stagingHeroRoot.addEventListener('hero-workflow:verified', function(event) {
            if (event.detail && event.detail.slug === activeSlug) loadDrafts();
          });
          $("groupByTopic").addEventListener("change", renderDrafts);
          $("readinessFilter").addEventListener("change", renderDrafts);
          $("draftSearch").addEventListener("input", function () {
            updateSearchUi();
            renderDrafts();
          });
          $("clearDraftSearch").addEventListener("click", function () {
            if ($("draftSearch")) {
              $("draftSearch").value = "";
              $("draftSearch").focus();
            }
            updateSearchUi();
            renderDrafts();
          });
          $("closePreview").addEventListener("click", function () {
            $("previewSection").classList.add("hidden");
            if ($('emptyReview') && $('comparisonSection').classList.contains('hidden')) $('emptyReview').classList.remove('hidden');
          });
          $("closeCompare").addEventListener("click", function () {
            $("comparisonSection").classList.add("hidden");
            if (activeSlug) $('previewSection').classList.remove('hidden');
            else if ($('emptyReview')) $('emptyReview').classList.remove('hidden');
          });

          // Initial load
          loadDrafts();
        })();
      </script>
    )
  }
</Base>
