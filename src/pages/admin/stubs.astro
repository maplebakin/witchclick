---
import Base from "../../layouts/Base.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import stubDashboardScript from "../../scripts/admin/admin-stub-dashboard.ts?url";
import { generateStubPrompts, serializeStubEntries } from "../../../server/lib/stubPromptGenerator.js";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/stubs" });

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get("key") === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || "http://localhost:8787";
const DEV_KEY = import.meta.env.PUBLIC_DEV_API_KEY || import.meta.env.PUBLIC_ADMIN_KEY || "";

const stubData = generateStubPrompts({ cwd: process.cwd() });
const stubEntries = serializeStubEntries(stubData.entries).map((entry: {
  type: string;
  slug: string;
  name: string;
  relativePath: string;
  prompt: string;
  references: Array<{ title: string; slug: string; sourcePath?: string }>;
}) => ({
  type: entry.type,
  slug: entry.slug,
  name: entry.name,
  prompt: entry.prompt,
  filePath: entry.relativePath,
  references: entry.references,
}));
const stubPayload = JSON.stringify(stubEntries);
---
<Base title="WitchClick — Stub Entities" description="Fill in entity stubs with AI-assisted prompts." canon={canonical} wide noindex>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6">
      <AdminNav currentPath="/admin/stubs" />

      <section class="rounded-2xl border border-line-subtle bg-surface-base p-6 shadow-sm">
        <div class="space-y-4">
          <div class="space-y-2">
            <p class="text-[11px] font-semibold uppercase tracking-wide text-primary">Entity upkeep</p>
            <h1 class="text-2xl font-semibold text-body-strong">Stub Prompt Dashboard</h1>
            <p class="text-sm text-body-muted">
              Internal links sometimes auto-create placeholder entities. This dashboard helps you copy a ready-made prompt, send it to your favorite model, and paste the completed JSON back into the site.
            </p>
          </div>
          <div class="rounded-xl border border-dashed border-line-subtle bg-surface-base/70 p-4 text-xs text-body-muted">
            <p class="font-semibold mb-1">Workflow</p>
            <ol class="list-decimal space-y-1 pl-5">
              <li>Select a stub in the left column.</li>
              <li>Copy the tailored prompt and generate the entity JSON.</li>
              <li>Paste the JSON, validate, and save directly to <code>content/entities</code>.</li>
            </ol>
          </div>
        </div>
      </section>

      <div
        class="grid grid-cols-1 gap-6 lg:grid-cols-12"
        data-stub-dashboard
        data-stubs={stubPayload}
        data-dev-api={DEV_API}
        data-dev-key={DEV_KEY}
      >
        <section class="lg:col-span-4 rounded-2xl border border-line-subtle bg-surface-base p-4 shadow-sm">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h2 class="text-lg font-semibold">Stub Library</h2>
              <p class="text-xs text-body-muted">Entities auto-created from post references.</p>
            </div>
            <span class="rounded-full bg-surface-accent px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-accent">
              <span data-stub-count>{stubEntries.length}</span> open
            </span>
          </div>
          <div class="mt-4 flex gap-2">
            <div class="flex-1">
              <label class="text-[11px] font-semibold uppercase tracking-wide text-body-muted">Search</label>
              <input
                class="mt-1 w-full rounded-lg border border-line-neutral px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
                placeholder="Search by name, slug, or type"
                data-stub-search
              />
            </div>
            <div class="flex flex-col justify-end">
              <button
                type="button"
                data-refresh
                class="admin-btn-secondary px-3 py-2 text-sm font-medium hover:border-line-bold"
                title="Reload stub list"
              >
                Refresh
              </button>
            </div>
          </div>
          <div
            data-stub-list
            class="mt-4 max-h-[70vh] overflow-y-auto space-y-3 pr-1"
          >
            <p class="text-sm text-body-muted px-2 py-3">Loading stub entries…</p>
          </div>
        </section>

        <section class="lg:col-span-8 rounded-2xl border border-line-subtle bg-surface-base p-4 shadow-sm">
          <div data-empty-state class="flex h-full flex-col items-center justify-center gap-2 text-center text-body-muted">
            <p class="text-lg font-semibold text-body-strong">Select a stub to get started</p>
            <p class="text-sm">You’ll see the tailored prompt, references, and a space to paste the finished JSON.</p>
          </div>

          <div data-detail-panel class="hidden space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line-subtle pb-3">
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-wide text-body-muted">Editing</p>
                <h2 class="text-xl font-semibold text-body-strong" data-selected-name>—</h2>
                <p class="text-sm text-body-muted" data-file-path>—</p>
              </div>
              <span class="rounded-full bg-surface-accent px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-accent" data-selected-type>
                —
              </span>
            </div>

            <div class="rounded-xl border border-line-subtle bg-surface-base/70 p-4">
              <div class="flex items-center justify-between gap-2">
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-primary">Step 1</p>
                  <h3 class="text-lg font-semibold">Copy the prompt</h3>
                  <p class="text-xs text-body-muted">
                    Paste this into your favorite LLM. It’s customized for the entity type and references.
                  </p>
                </div>
                <button
                  type="button"
                  class="admin-btn-primary px-3 py-1.5 text-sm font-semibold"
                  data-copy-prompt
                >
                  Copy Prompt
                </button>
              </div>
              <textarea
                readonly
                data-prompt-text
                class="mt-3 h-56 w-full rounded-lg border border-line-neutral bg-surface-base/70 px-3 py-2 font-mono text-xs"
              ></textarea>
              <div class="mt-3 rounded-lg border border-dashed border-line-subtle bg-surface-base/70 p-3 text-xs text-body-muted">
                <p class="font-semibold mb-1">
                  Referenced posts <span class="rounded-full bg-surface-accent px-2 py-0.5 text-[10px] font-semibold text-accent" data-reference-count>0</span>
                </p>
                <div data-reference-list class="space-y-2 text-body-muted text-xs"></div>
              </div>
            </div>

            <div class="rounded-xl border border-line-subtle bg-surface-base/70 p-4 space-y-4">
              <div class="flex items-center justify-between gap-2">
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-primary">Step 2</p>
                  <h3 class="text-lg font-semibold">Paste entity JSON</h3>
                  <p class="text-xs text-body-muted">Keep the keys: type, name, slug, summary, properties, related.</p>
                </div>
                <div class="flex gap-2">
                  <button
                    type="button"
                    data-validate
                    class="admin-btn-secondary px-3 py-1.5 text-sm font-medium"
                  >
                    Validate JSON
                  </button>
                  <button
                    type="button"
                    data-save
                    class="admin-btn-primary px-4 py-1.5 text-sm font-semibold"
                  >
                    Save Entity
                  </button>
                </div>
              </div>
              <textarea
                data-json-input
                class="h-56 w-full rounded-lg border border-line-neutral bg-surface-base/60 px-3 py-2 font-mono text-xs"
                placeholder='{"type":"ritual","slug":"desk-altar",...}'
              ></textarea>
              <div class="grid gap-3 md:grid-cols-3 rounded-lg border border-line-subtle bg-surface-base/50 p-3 text-sm">
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-body-muted">Summary Preview</p>
                  <p class="mt-1 text-body-strong text-sm" data-preview-summary>Waiting for validation…</p>
                </div>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-body-muted">Properties</p>
                  <p class="mt-1 text-body-strong" data-preview-props>—</p>
                </div>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-body-muted">Related Entities</p>
                  <p class="mt-1 text-body-strong text-sm" data-preview-related>—</p>
                </div>
              </div>
              <p class="text-xs text-body-muted">
                Saving writes directly to <code>content/entities/&lt;type&gt;/&lt;slug&gt;.json</code>. Keep Git running to review diffs.
              </p>
            </div>

            <p data-status class="text-sm text-body-muted" role="status" aria-live="polite" aria-atomic="true"></p>
          </div>
        </section>
      </div>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">
        This dashboard only runs in <strong>development</strong> (or with a temporary key when hosted on a server adapter).
      </p>
    </section>
  )}

  {canUse && <script type="module" is:inline src={stubDashboardScript}></script>}
</Base>
