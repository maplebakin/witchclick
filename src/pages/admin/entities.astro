---
/* Admin: Entities CRUD */
import Base from "../../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../../utils/settings";

export const prerender = false; // never emit in static builds

const settings = readSettings();
const site = getSiteOrigin(settings) || "https://example.com";

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';
const TYPES = ['crystal','herb','moonPhase','tarot','planetaryDay','ritual'] as const;
---
<Base
  title="WitchClick — Entities Admin"
  description="Create and edit entity JSON files."
  canon={`${site}/admin/entities`}
  wide={true}
  noindex={true}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  {canUse ? (
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12" data-dev-api={DEV_API}>
      <!-- Left: list -->
      <section class="lg:col-span-4 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-2">
          <h1 class="text-xl font-semibold">Entities</h1>
          <button id="newBtn" class="rounded-lg border px-3 py-1 text-sm">New</button>
        </div>
        <input id="search" placeholder="Search..." class="mb-3 w-full rounded-lg border px-3 py-2 text-sm" />
        <div id="list" class="max-h-[70vh] overflow-auto text-sm"></div>
      </section>

      <!-- Right: editor -->
      <section class="lg:col-span-8 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <h2 class="mb-3 text-lg font-semibold">Editor</h2>

        <div class="grid gap-3 md:grid-cols-2">
          <label class="block">
            <span class="text-xs font-medium">Type</span>
            <select id="type" class="mt-1 w-full rounded-lg border px-3 py-2">
              {TYPES.map(t => <option value={t}>{t}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-medium">Slug</span>
            <input id="slug" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="peppermint" />
            <p class="mt-1 text-xs text-body-faint">Leave blank to auto-fill from Name.</p>
          </label>
          <label class="block md:col-span-2">
            <span class="text-xs font-medium">Name</span>
            <input id="name" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="Peppermint" />
          </label>
          <label class="block md:col-span-2">
            <span class="text-xs font-medium">Summary</span>
            <textarea id="summary" class="mt-1 h-20 w-full rounded-lg border px-3 py-2"></textarea>
          </label>
        </div>

        <h3 class="mt-4 text-sm font-semibold">Properties</h3>
        <div id="props" class="mt-2 space-y-2"></div>
        <div class="mt-2 flex gap-2">
          <button id="addProp" class="rounded-lg border px-3 py-1 text-sm">Add property</button>
          <button id="suggest" class="rounded-lg border px-3 py-1 text-sm">Add suggestions</button>
        </div>

        <label class="mt-4 block">
          <span class="text-xs font-medium">Related (comma-separated slugs)</span>
          <input id="related" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="fluorite,new-moon" />
        </label>

        <div class="mt-4 flex gap-3">
          <button id="save" class="rounded-lg bg-surface-success px-4 py-2 text-inverse hover:bg-surface-success-strong">Save</button>
          <span id="status" class="self-center text-sm text-body-muted"></span>
        </div>
      </section>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">These tools only run in <strong>development</strong> (or with a temporary key on a server adapter).</p>
      <p class="mt-3 text-sm text-body-muted">Entities can still be edited by hand in <code>content/entities/*</code>.</p>
    </section>
  )}

  {canUse && (
    <script is:inline>
      (function () {
        var root = document.querySelector('[data-dev-api]');
        var DEV_API = root?.getAttribute('data-dev-api') || 'http://localhost:8787';
        var $ = function(id){ return document.getElementById(id); };

        var TYPES = ['crystal','herb','moonPhase','tarot','planetaryDay','ritual'];
        var SUGGEST = {
          crystal: [['color','green'],['chakra','heart,third-eye'],['intentions','focus,clarity'],['cleansing','moonlight,smoke']],
          herb: [['partUsed','leaf'],['intentions','focus,clarity'],['cautions','']],
          moonPhase: [['phase','New Moon'],['bestFor','intentions,new-beginnings'],['cautions','']],
          tarot: [['keywords','clarity,focus'],['upright',''],['reversed','']],
          planetaryDay: [['planet','Mercury'],['themes','communication,study'],['cautions','']],
          ritual: [['duration','5 minutes'],['tools','candle,tea'],['steps','breathe,intent,begin']]
        };

        function setStatus(msg, ok) {
          var el = $('status'); if (!el) return;
          el.textContent = msg;
          el.style.color = ok===false ? '#7f1d1d' : '#065f46';
        }
        function busy(on){
          ['newBtn','addProp','suggest','save'].forEach(function(id){
            var b=$(id); if(b){ b.disabled=!!on; b.style.opacity = on? .6 : 1; }
          });
        }

        function slugify(s) {
          return String(s || '')
            .normalize('NFKD').replace(/[\u0300-\u036f]/g,'')
            .toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
        }

        function propRow(key, value) {
          var wrap = document.createElement('div');
          wrap.className = 'grid grid-cols-5 gap-2';
          var k = document.createElement('input');
          k.className = 'col-span-2 rounded-lg border px-2 py-1 text-sm key';
          k.placeholder = 'key';
          k.value = key || '';
          var v = document.createElement('input');
          v.className = 'col-span-3 rounded-lg border px-2 py-1 text-sm val';
          v.placeholder = 'value (JSON, comma-list, number, boolean)';
          v.value = value || '';
          wrap.appendChild(k); wrap.appendChild(v);
          return wrap;
        }

        function parseValue(v) {
          if (!v) return '';
          if ((v[0]==='[' && v[v.length-1]===']') || (v[0]==='{' && v[v.length-1]==='}')) {
            try { return JSON.parse(v); } catch {}
          }
          if (v.indexOf(',') !== -1) return v.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
          if (/^-?\d+(\.\d+)?$/.test(v)) return Number(v);
          if (v === 'true') return true;
          if (v === 'false') return false;
          return v;
        }

        function collectProps() {
          var rows = Array.prototype.slice.call(document.querySelectorAll('#props > div'));
          var out = {};
          for (var i=0;i<rows.length;i++) {
            var r = rows[i];
            var k = r.querySelector('.key').value.trim();
            var v = r.querySelector('.val').value.trim();
            if (!k) continue;
            out[k] = parseValue(v);
          }
          return out;
        }

        var autoSlug = true;
        $('name').addEventListener('input', function(){
          if (!autoSlug) return;
          $('slug').value = slugify($('name').value);
        });
        $('slug').addEventListener('input', function(){
          autoSlug = $('slug').value.trim().length === 0;
        });

        function addSuggestionsFor(type){
          var rows = SUGGEST[type] || [];
          var holder = $('props');
          var existing = {};
          Array.prototype.forEach.call(holder.querySelectorAll('.key'), function(inp){ existing[inp.value.trim()] = true; });
          for (var i=0;i<rows.length;i++) {
            var kv = rows[i];
            if (existing[kv[0]]) continue;
            holder.appendChild(propRow(kv[0], kv[1]));
          }
        }

        async function refreshList() {
          try {
            var res = await fetch(DEV_API + '/entities/list', { method: 'POST' });
            var data = await res.json();
            if (!data.ok) { setStatus('List error: ' + (data.error || 'unknown'), false); return; }
            var q = ($('search').value || '').toLowerCase().trim();
            var list = $('list');
            list.innerHTML = '';
            var items = data.items || {};
            var types = Object.keys(items).sort();
            if (types.length === 0) { list.innerHTML = '<p class="text-body-subtle">No entities yet.</p>'; return; }
            for (var ti=0; ti<types.length; ti++) {
              var t = types[ti];
              var h = document.createElement('h4');
              h.className = 'mt-3 mb-1 text-xs uppercase tracking-wide text-body-faint';
              h.textContent = t;
              list.appendChild(h);
              var arr = items[t];
              for (var ai=0; ai<arr.length; ai++) {
                var it = arr[ai];
                var name = String(it.name || '').toLowerCase();
                var slug = String(it.slug || '').toLowerCase();
                if (q && name.indexOf(q) === -1 && slug.indexOf(q) === -1) continue;
                var a = document.createElement('a');
                a.href = '#';
                a.className = 'block rounded px-2 py-1 hover:bg-surface-muted';
                a.textContent = (it.name || '') + ' (' + (it.slug || '') + ')';
                (function(t2, s2){
                  a.addEventListener('click', function(ev){ ev.preventDefault(); loadEntity(t2, s2); });
                })(it.type, it.slug);
                list.appendChild(a);
              }
            }
          } catch (e) {
            setStatus('List error: ' + (e.message || String(e)), false);
          }
        }

        async function loadEntity(type, slug) {
          try {
            busy(true);
            var res = await fetch(DEV_API + '/entities/get', {
              method: 'POST',
              headers: { 'Content-Type':'application/json' },
              body: JSON.stringify({ type: type, slug: slug })
            });
            var data = await res.json();
            if (!data.ok) throw new Error(data.error || 'get failed');
            var ent = data.data || {};
            $('type').value = ent.type || type || 'herb';
            $('slug').value = ent.slug || slug || '';
            $('name').value = ent.name || '';
            $('summary').value = ent.summary || '';
            $('related').value = Array.isArray(ent.related) ? ent.related.join(',') : '';
            autoSlug = ($('slug').value || '') === slugify($('name').value || '');
            var props = ent.properties || {};
            var holder = $('props'); holder.innerHTML = '';
            var keys = Object.keys(props);
            if (keys.length === 0) holder.appendChild(propRow());
            for (var i=0; i<keys.length; i++) {
              var k = keys[i];
              var v = Array.isArray(props[k]) ? props[k].join(',') : (typeof props[k]==='object' ? JSON.stringify(props[k]) : String(props[k]));
              holder.appendChild(propRow(k, v));
            }
            setStatus('Loaded ' + type + '/' + slug);
          } catch (e) {
            setStatus('Load error: ' + (e.message || String(e)), false);
          } finally {
            busy(false);
          }
        }

        $('addProp').addEventListener('click', function(){ $('props').appendChild(propRow()); });
        $('suggest').addEventListener('click', function(){
          addSuggestionsFor(($('type').value || 'herb'));
          setStatus('Added suggestions for ' + $('type').value);
        });

        $('newBtn').addEventListener('click', function(){
          $('type').value = 'herb';
          $('slug').value = '';
          $('name').value = '';
          $('summary').value = '';
          $('related').value = '';
          $('props').innerHTML = '';
          $('props').appendChild(propRow());
          autoSlug = true;
          setStatus('New entity draft');
        });

        $('save').addEventListener('click', async function(){
          try {
            busy(true);
            var t = $('type').value;
            if (TYPES.indexOf(t) === -1) throw new Error('Invalid type');
            var slug = slugify($('slug').value || $('name').value);
            if (!slug) throw new Error('Slug required (or type a Name to auto-fill)');
            var payload = {
              type: t,
              slug: slug,
              name: $('name').value.trim(),
              summary: $('summary').value,
              properties: (function(){ // collect props
                var rows = Array.prototype.slice.call(document.querySelectorAll('#props > div'));
                var out = {};
                for (var i=0;i<rows.length;i++) {
                  var r = rows[i];
                  var k = r.querySelector('.key').value.trim();
                  var v = r.querySelector('.val').value.trim();
                  if (!k) continue;
                  // parseValue inline
                  if ((v[0]==='[' && v[v.length-1]===']') || (v[0]==='{' && v[v.length-1]==='}')) {
                    try { out[k] = JSON.parse(v); continue; } catch {}
                  }
                  if (v.indexOf(',') !== -1) out[k] = v.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
                  else if (/^-?\d+(\.\d+)?$/.test(v)) out[k] = Number(v);
                  else if (v === 'true') out[k] = true;
                  else if (v === 'false') out[k] = false;
                  else out[k] = v;
                }
                return out;
              })(),
              related: ($('related').value || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean)
            };

            try {
              var existing = await (await fetch(DEV_API + '/entities/get', { method:'POST', headers:{'Content-Type':'application/json' }, body: JSON.stringify({ type: t, slug }) })).json();
              if (existing && existing.ok && existing.data && !confirm('An entity with this slug exists. Overwrite?')) {
                setStatus('Save cancelled', false); busy(false); return;
              }
            } catch {}

            var res = await fetch(DEV_API + '/entities/save', {
              method: 'POST',
              headers: { 'Content-Type':'application/json' },
              body: JSON.stringify(payload)
            });
            var data = await res.json();
            if (!data.ok) throw new Error(data.error || 'save failed');
            $('slug').value = slug;
            setStatus('Saved ✓ → ' + data.path);
            refreshList();
          } catch (e) {
            setStatus('Save error: ' + (e.message || String(e)), false);
          } finally {
            busy(false);
          }
        });

        $('search').addEventListener('input', refreshList);
        (function init(){ document.getElementById('props').appendChild(propRow()); refreshList(); })();
      })();
    </script>
  )}
</Base>
