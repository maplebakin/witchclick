---
/* Admin: Entities CRUD */
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import adminEntitiesScript from "../../scripts/admin/adminEntities.ts?url";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";


const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin/entities" });

const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';
const DEV_KEY = import.meta.env.PUBLIC_DEV_API_KEY || import.meta.env.PUBLIC_ADMIN_KEY || '';
const TYPES = ['crystal','herb','moonPhase','planet','tarot','spread','planetaryDay','ritual'] as const;
---
<Base
  title="WitchClick — Entities Admin"
  description="Create and edit entity JSON files."
  canon={canonical}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6">
      <AdminNav currentPath="/admin/entities" />

      <section class="rounded-2xl border border-line-subtle bg-surface-base p-6 shadow-sm">
        <div class="space-y-3">
          <div>
            <h1 class="text-2xl font-semibold text-body-strong">Entity Manager</h1>
            <p class="text-sm text-body-muted mt-1">
              Create and edit entities like crystals, herbs, moon phases, planets, tarot cards, spreads, planetary days, and rituals. Entities power cross-references across your site.
            </p>
          </div>
          <div class="rounded-lg border border-dashed border-line-subtle bg-surface-base/60 p-4 text-[0.8rem] text-body-muted">
            <div class="font-semibold mb-2">🔮 Entity types:</div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-2 mt-2">
              <div class="flex items-center gap-2 rounded-md bg-surface-soft px-3 py-1.5">
                <span class="text-base">💎</span>
                <span class="font-medium">Crystals</span>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-surface-soft px-3 py-1.5">
                <span class="text-base">🌿</span>
                <span class="font-medium">Herbs</span>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-surface-soft px-3 py-1.5">
                <span class="text-base">🌙</span>
                <span class="font-medium">Moon Phases</span>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-surface-soft px-3 py-1.5">
                <span class="text-base">🪐</span>
                <span class="font-medium">Planets</span>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-surface-soft px-3 py-1.5">
                <span class="text-base">🎴</span>
                <span class="font-medium">Tarot</span>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-surface-soft px-3 py-1.5">
                <span class="text-base">🪄</span>
                <span class="font-medium">Spreads</span>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-surface-soft px-3 py-1.5">
                <span class="text-base">🪐</span>
                <span class="font-medium">Planetary Days</span>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-surface-soft px-3 py-1.5">
                <span class="text-base">✨</span>
                <span class="font-medium">Rituals</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12" data-dev-api={DEV_API} data-dev-key={DEV_KEY}>
      <!-- Left: list -->
      <section class="lg:col-span-4 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <div class="mb-4 space-y-2">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-lg font-semibold">Entity Library</h2>
            <button id="newBtn" class="admin-btn-primary px-3 py-1.5 text-sm font-semibold">+ New</button>
          </div>
          <p class="text-[0.8rem] text-body-muted">Search and select to edit, or create new</p>
        </div>
        <input id="search" placeholder="Search entities..." class="mb-3 w-full admin-btn-secondary px-3 py-2 text-sm" />
        <div class="mb-3 grid gap-3 md:grid-cols-3">
          <label class="block">
            <span class="text-[0.8rem] font-medium">Type</span>
            <select id="typeFilter" class="mt-1 w-full admin-btn-secondary px-3 py-2 text-sm">
              <option value="all">All</option>
            </select>
          </label>
          <label class="block">
            <span class="text-[0.8rem] font-medium">Status</span>
            <select id="statusFilter" class="mt-1 w-full admin-btn-secondary px-3 py-2 text-sm">
              <option value="all">All</option>
              <option value="published">Published</option>
              <option value="stub">Stub</option>
            </select>
          </label>
          <label class="block">
            <span class="text-[0.8rem] font-medium">Sort</span>
            <select id="sortFilter" class="mt-1 w-full admin-btn-secondary px-3 py-2 text-sm">
              <option value="az">A→Z</option>
              <option value="za">Z→A</option>
            </select>
          </label>
        </div>
        <p id="listStatus" class="mb-3 text-[0.8rem] font-medium text-body-muted">Loading entities…</p>
        <div id="list" class="max-h-[70vh] overflow-auto text-sm"></div>
      </section>

      <!-- Right: editor -->
      <section class="lg:col-span-8 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
        <div class="mb-4 space-y-2">
          <h2 class="text-lg font-semibold">Entity Editor</h2>
          <p class="text-[0.8rem] text-body-muted">Create or edit entity details and properties</p>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
          <label class="block">
            <span class="text-[0.8rem] font-medium">Type</span>
            <select id="type" class="mt-1 w-full admin-btn-secondary px-3 py-2">
              {TYPES.map(t => <option value={t}>{t}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-[0.8rem] font-medium">Slug</span>
            <input id="slug" class="mt-1 w-full admin-btn-secondary px-3 py-2" placeholder="peppermint" />
            <p class="mt-1 text-[0.8rem] text-body-faint">Leave blank to auto-fill from Name.</p>
          </label>
          <label class="block md:col-span-2">
            <span class="text-[0.8rem] font-medium">Name</span>
            <input id="name" class="mt-1 w-full admin-btn-secondary px-3 py-2" placeholder="Peppermint" />
          </label>
          <label class="block md:col-span-2">
            <span class="text-[0.8rem] font-medium">Summary</span>
            <textarea id="summary" class="mt-1 h-20 w-full admin-btn-secondary px-3 py-2"></textarea>
          </label>
        </div>

        <div class="mt-4 space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-semibold">Custom Properties</h3>
            <span class="text-[0.8rem] font-medium uppercase tracking-wide rounded-full bg-surface-accent-soft px-2 py-0.5 text-accent">Optional</span>
          </div>
          <p class="text-[0.8rem] text-body-muted">Add key-value pairs for entity-specific metadata (e.g., "chakra: heart", "planet: Venus")</p>
          <div id="props" class="space-y-2"></div>
          <div class="flex gap-2">
            <button id="addProp" class="admin-btn-secondary px-3 py-1.5 text-sm font-medium">+ Add Property</button>
            <button id="suggest" class="admin-btn-primary px-3 py-1.5 text-sm font-medium">✨ Add Suggestions</button>
          </div>
        </div>

        <label class="mt-4 block">
          <span class="text-[0.8rem] font-medium uppercase tracking-wide text-body-subtle">Related Entities</span>
          <input id="related" class="mt-1 w-full admin-btn-secondary px-3 py-2" placeholder="fluorite,new-moon,clear-quartz" />
          <p class="mt-1 text-[0.8rem] text-body-muted">Comma-separated slugs of related entities for cross-linking</p>
        </label>

        <div class="mt-6 flex gap-3 border-t border-line-subtle pt-4">
          <button id="save" class="admin-btn-primary px-6 py-2.5 text-sm font-semibold">💾 Save Entity</button>
          <button id="delete" class="admin-btn-secondary px-6 py-2.5 text-sm font-semibold text-danger">Delete entity</button>
          <span id="status" class="self-center text-sm text-body-muted"></span>
        </div>
      </section>
      </div>
    </div>
  ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">These tools only run in <strong>development</strong> (or with a temporary key on a server adapter).</p>
      <p class="mt-3 text-sm text-body-muted">Entities can still be edited by hand in <code>content/entities/*</code>.</p>
    </section>
  )}

  {canUse && <script type="module" is:inline src={adminEntitiesScript}></script>}
</Base>
