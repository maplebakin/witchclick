        function buildError(message, type, info){
          var err = new Error(message);
          err.type = type;
          if (info && typeof info === 'object') {
            Object.keys(info).forEach(function(key){ err[key] = info[key]; });
          }
          return err;
        }

        async function postSpec(spec, options){
          var dryRun = options && options.dryRun ? 'true' : 'false';
          var params = [];
          if (dryRun === 'true') params.push('dryRun=true');
          if (spec && spec._draft === true) params.push('draft=true');
          // Use dev-api.js endpoint - Astro static mode can't handle POST bodies
          var url = DEV_API + '/ingest' + (params.length ? '?' + params.join('&') : '');
          var res;
          try {
            res = await fetch(url, {
              method:'POST',
              headers:{'Content-Type':'application/json'},
              body: JSON.stringify(spec)
            });
          } catch (networkError) {
            throw buildError('Network error contacting ingest endpoint: ' + (networkError && networkError.message ? networkError.message : 'unknown network error'), 'network', {
              original: networkError
            });
          }

          var text;
          try {
            text = await res.text();
          } catch (readError) {
            text = '';
          }

          var data = {};
          if (text) {
            try { data = JSON.parse(text); }
            catch { data = { raw: text }; }
          }

          if (!res.ok) {
            throw buildError(
              'Server error (' + res.status + '): ' + (data && data.error ? data.error : res.statusText || 'Unknown error'),
              'http',
              { status: res.status, data: data }
            );
          }

          return data;
        }

        async function postCurse(spec, options){
          var dryRun = options && options.dryRun ? 'true' : 'false';
          var url = DEV_API + '/curses/ingest' + (dryRun === 'true' ? '?dryRun=true' : '');
          var res;
          try {
            res = await fetch(url, {
              method:'POST',
              headers:{'Content-Type':'application/json'},
              body: JSON.stringify({ spec, dryRun })
            });
          } catch (networkError) {
            throw buildError('Network error contacting curse ingest endpoint: ' + (networkError && networkError.message ? networkError.message : 'unknown network error'), 'network', {
              original: networkError
            });
          }

          var data;
          try {
            data = await res.json();
          } catch (parseError) {
            throw buildError('Curse ingest returned non-JSON response.', 'http', { status: res.status, original: parseError });
          }

          if (!res.ok || data.ok === false) {
            throw buildError(
              data && data.error ? data.error : 'Curse ingest error (' + res.status + ')',
              'http',
              { status: res.status, data: data }
            );
          }

          return data;
        }

        function handleSpecError(err){
          if (err && err.data && err.data.spec) {
            renderSpecSummary(err.data.spec);
          }
          var warnings = err && err.data ? extractArray(err.data.warnings) : [];
          var notes = err && err.data ? extractArray(err.data.normalizationReport) : [];
          var errors = err && err.data ? extractArray(err.data.errors) : [];
          var postStubs = err && err.data ? extractArray(err.data.postStubs) : [];
          if (err && err.type === 'network') {
            setStatus(err.message, false, warnings, notes, errors, postStubs);
            return;
          }
          if (err && err.type === 'http') {
            setStatus(err.message, false, warnings, notes, errors, postStubs);
            return;
          }
          setStatus((err && err.message) || 'Unexpected error', false, warnings, notes, errors, postStubs);
        }

        function handleCurseError(err){
          if (err && err.data && err.data.spec) {
            renderCurseSummary(err.data.spec);
            renderCursePreview(err.data.spec);
          }
          var errors = err && err.data ? extractArray(err.data.errors) : [];
          if (err && err.type === 'network') {
            setCurseStatus(err.message, false, errors);
            return;
          }
          if (err && err.type === 'http') {
            setCurseStatus(err.message, false, errors);
            return;
          }
          setCurseStatus((err && err.message) || 'Unexpected error', false, errors);
        }

        $('validateBtn').addEventListener('click', async function(){
          try{
            busy(true); setStatus('Validating…', null);
            var spec = parseSpec();
            var data = await postSpec(spec, { dryRun: true });
            var finalSpec = normalizeResponseSpec(data.spec, spec);
            renderSpecSummary(finalSpec);
            var warnings = extractArray(data.warnings);
            var notes = extractArray(data.normalizationReport);
            var errors = extractArray(data.errors);
            var postStubs = extractArray(data.postStubs);
            if (data.ok === false) {
              setStatus(data.error || 'Validation errors found.', false, warnings, notes, errors, postStubs);
              return;
            }
            setStatus('Valid ✓', true, warnings, notes, errors, postStubs);
          }catch(e){ handleSpecError(e); }
          finally{ busy(false); }
        });

        function wordCount(md){
          var text = String(md||'')
            .replace(/```[\s\S]*?```/g,' ')
            .replace(/`[^`]*`/g,' ')
            .replace(/<[^>]+>/g,' ')
            .replace(/[\*_#>~\-]+/g,' ');
          var m = text.match(/\b[\p{L}\p{N}’']+\b/gu);
          return m ? m.length : 0;
        }
        function renderPreview(spec){
          var el = $('preview'); el.innerHTML = '';
          var h1 = document.createElement('h1'); h1.textContent = spec.title || '(untitled)'; el.appendChild(h1);
          if (Array.isArray(spec.tags)){ var p = document.createElement('p'); p.className='text-sm text-body-subtle'; p.textContent='Tags: ' + spec.tags.join(', '); el.appendChild(p); }
          var totalWords = 0;
          for (var i=0;i<(spec.sections||[]).length;i++){
            var sec = spec.sections[i];
            var h2 = document.createElement('h2'); h2.textContent = sec.heading || 'Section'; el.appendChild(h2);
            var div = document.createElement('div');
            var safe = String(sec.markdown||'').trim().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
            div.innerHTML = safe;
            el.appendChild(div);
            totalWords += wordCount(sec.markdown||'');
          }
          var meta = document.createElement('p');
          meta.className='mt-4 text-xs text-body-faint';
          meta.textContent = '~' + totalWords + ' words • ~' + Math.max(1, Math.round(totalWords/200)) + ' min read';
          el.appendChild(meta);
        }

        function renderCursePreview(spec){
          var el = $('cursePreview');
          if (!el) return;
          el.innerHTML='';
          if (!spec) return;

          var h1=document.createElement('h1');
          h1.textContent = spec.title || '(untitled curse)';
          el.appendChild(h1);

          var tags = Array.isArray(spec.tags) ? spec.tags : [];
          if (tags.length) {
            var tagLine=document.createElement('p');
            tagLine.className='text-sm text-body-subtle';
            tagLine.textContent='Tags: ' + tags.join(', ');
            el.appendChild(tagLine);
          }

          function appendSection(label, value){
            var heading=document.createElement('h2');
            heading.textContent=label;
            el.appendChild(heading);
            var div=document.createElement('div');
            var safe=String(value || '').trim().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
            div.innerHTML=safe;
            el.appendChild(div);
          }

          appendSection('Opening Reflection', spec.openingReflection || '');
          appendSection('Invocation', spec.invocation || '');
          appendSection('Method', spec.method || '');
          appendSection('Closure & Aftercare', spec.closure || '');
          if (spec.safetyNotes) appendSection('Safety Notes', spec.safetyNotes);
        }

        $('previewBtn').addEventListener('click', async function(){
          try{
            busy(true); setStatus('Validating for preview…', null);
            var spec = parseSpec();
            var data = await postSpec(spec, { dryRun: true });
            var finalSpec = normalizeResponseSpec(data.spec, spec);
            renderSpecSummary(finalSpec);
            var warnings = extractArray(data.warnings);
            var notes = extractArray(data.normalizationReport);
            var errors = extractArray(data.errors);
            var postStubs = extractArray(data.postStubs);
            if (data.ok === false) {
              setStatus(data.error || 'Validation errors found.', false, warnings, notes, errors, postStubs);
              return;
            }
            renderPreview(finalSpec);
            setStatus('Preview ✓', true, warnings, notes, errors, postStubs);
          }catch(e){ handleSpecError(e); }
          finally{ busy(false); }
        });

        $('ingestBtn').addEventListener('click', async function(){
          try{
            busy(true); setStatus('Validating…', null);
            var spec = parseSpec();
            var dryRun = await postSpec(spec, { dryRun: true });
            var finalSpec = normalizeResponseSpec(dryRun.spec, spec);
            var isDraftMode = currentSaveMode === 'draft';
            finalSpec._draft = isDraftMode;
            renderSpecSummary(finalSpec);
            var warnings = extractArray(dryRun.warnings);
            var notes = extractArray(dryRun.normalizationReport);
            var errors = extractArray(dryRun.errors);
            var postStubs = extractArray(dryRun.postStubs);
            if (dryRun.ok === false) {
              setStatus(dryRun.error || 'Validation errors found.', false, warnings, notes, errors, postStubs);
              return;
            }
            setStatus(finalSpec._draft ? 'Validation passed. Saving draft…' : 'Validation passed. Ingesting…', null, warnings, notes, errors, postStubs);
            var data = await postSpec(finalSpec, { dryRun: false });
            if (data.ok === false) {
              setStatus(data.error || 'Ingest failed.', false, extractArray(data.warnings), extractArray(data.normalizationReport), extractArray(data.errors), extractArray(data.postStubs));
              return;
            }
            var ingestWarnings = extractArray(data.warnings);
            var ingestNotes = extractArray(data.normalizationReport);
            var mergedWarnings = ingestWarnings.length ? ingestWarnings : warnings;
            var mergedNotes = ingestNotes.length ? ingestNotes : notes;
            var createdPosts = extractArray(data.createdPosts);
            var location = data.path || ('src/content/posts/' + (data.slug || finalSpec.slug || 'post') + '.md');
            var slug = data.slug || (finalSpec && finalSpec.slug) || '';
            var msg;
            if (data.saved === false) {
              msg = finalSpec._draft ? 'Draft validated (dry run) → ' + location : 'Ingested (dry run) → ' + location;
            } else {
              msg = (finalSpec._draft ? 'Draft saved ✓' : 'Ingested ✓') + ' → ' + location;
            }
            if (createdPosts.length) {
              msg += ' • Created ' + createdPosts.length + ' stub post' + (createdPosts.length === 1 ? '' : 's');
            }
            if (finalSpec._draft) {
              msg += ' • <a href="/admin/staging" class="underline">View staging →</a>';
            }
            setStatus(msg, true, mergedWarnings, mergedNotes, extractArray(data.errors), createdPosts.map(function(p){ return {path: p}; }), slug);
          }catch(e){ handleSpecError(e); }
          finally{ busy(false); }
        });

        $('ingestPublishBtn').addEventListener('click', async function(){
          try{
            setSaveMode('publish');
            busy(true); setStatus('Validating…', null);
            var spec = parseSpec();
            var dryRun = await postSpec(spec, { dryRun: true });
            var finalSpec = normalizeResponseSpec(dryRun.spec, spec);
            finalSpec._draft = false;
            renderSpecSummary(finalSpec);
            var warnings = extractArray(dryRun.warnings);
            var notes = extractArray(dryRun.normalizationReport);
            var errors = extractArray(dryRun.errors);
            var postStubs = extractArray(dryRun.postStubs);
            if (dryRun.ok === false) {
              setStatus(dryRun.error || 'Validation errors found.', false, warnings, notes, errors, postStubs);
              return;
            }
            setStatus('Validation passed. Ingesting…', null, warnings, notes, errors, postStubs);
            var data = await postSpec(finalSpec, { dryRun: false });
            if (data.ok === false) {
              setStatus(data.error || 'Ingest failed.', false, extractArray(data.warnings), extractArray(data.normalizationReport), extractArray(data.errors), extractArray(data.postStubs));
              return;
            }
            var ingestWarnings = extractArray(data.warnings);
            var ingestNotes = extractArray(data.normalizationReport);
            var createdPosts = extractArray(data.createdPosts);
            var slug = data.slug || (finalSpec && finalSpec.slug) || '';
            setStatus('Ingested. Publishing…', true, ingestWarnings.length ? ingestWarnings : warnings, ingestNotes.length ? ingestNotes : notes, extractArray(data.errors), createdPosts.map(function(p){ return {path: p}; }));
            var r = await fetch(DEV_API + '/bundle', { method:'POST' });
            var b = await r.json();
            if (!b.ok) throw new Error((b.steps && b.steps.map(function(s){return s.err;}).filter(Boolean).join('\n')) || b.error || 'bundle failed');
            var slug = data.slug || (finalSpec && finalSpec.slug) || '';
            var publishMsg = 'Published ✓';
            if (createdPosts.length) {
              publishMsg += ' • Created ' + createdPosts.length + ' stub post' + (createdPosts.length === 1 ? '' : 's');
            }
            setStatus(publishMsg, true, ingestWarnings.length ? ingestWarnings : warnings, ingestNotes.length ? ingestNotes : notes, extractArray(data.errors), createdPosts.map(function(p){ return {path: p}; }), slug);
          }catch(e){ handleSpecError(e); }
          finally{ busy(false); }
        });

        $('clearBtn').addEventListener('click', function(){
          $('spec').value=''; $('preview').innerHTML=''; renderSpecSummary(null); setStatus('Cleared. Ready for new JSON.', null);
        });

        if (recentRefreshBtn) {
          recentRefreshBtn.addEventListener('click', function(){
            loadRecentPosts();
          });
        }
        if (recentFilterInput) {
          recentFilterInput.addEventListener('input', function(event){
            recentFilterText = event.currentTarget.value || '';
            renderRecentPosts();
          });
        }
        if (recentPanel) {
          recentPanel.addEventListener('click', function(event){
            var insertBtn = event.target.closest('[data-recent-insert]');
            if (insertBtn) {
              event.preventDefault();
              var slug = insertBtn.getAttribute('data-slug') || '';
              var post = recentPosts.find(function(item){ return item.slug === slug; });
              if (post) {
                insertStubForPost(post);
              }
            }
          });
        }

        if (recentListEl) {
          loadRecentPosts();
        }

        var curseTypeEl = $('curseType');
        if (curseTypeEl) {
          $('curseGenPrompt').addEventListener('click', async function(){
            try {
              curseBusy(true); setCurseStatus('Generating prompt...', null);
              var type = ($('curseType')?.value || CURSE_TYPES[0] || 'mirror');
              var target = ($('curseTarget')?.value || CURSE_TARGETS[0] || 'person');
              var tone = ($('curseTone')?.value || CURSE_TONES[0] || 'poetic');
              var topic = ($('curseTopic')?.value || '').trim();
              var sigil = ($('curseSigil')?.value || '').trim();
              var altar = ($('curseAltar')?.value || '').trim();
              var journal = ($('curseJournal')?.value || '').trim();
              var body = { type, target, tone };
              if (topic) body.topic = topic;
              if (sigil) body.sigilName = sigil;
              if (altar) body.altarItem = altar;
              if (journal) body.journalingFollowUp = journal;
              var res = await fetch(DEV_API + '/curses/prompt', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
              if (!res.ok) throw new Error('Prompt request failed (' + res.status + ')');
              var data = await res.json();
              if (!data.ok) throw new Error(data.error || 'Prompt request failed');
              $('cursePromptOut').value = data.prompt || '';
              setCurseStatus('Prompt ready ✓', true);
            } catch (e) {
              setCurseStatus('Prompt error: ' + (e && e.message ? e.message : String(e)), false);
            } finally {
              curseBusy(false);
            }
          });

          $('curseCopyPrompt').addEventListener('click', async function(){
            var field = $('cursePromptOut');
            try {
              await navigator.clipboard.writeText(field?.value || '');
              setCurseStatus('Copied ✓', true);
            } catch {
              if (field) {
                field.focus();
                field.select();
              }
              setCurseStatus('Press ⌘/Ctrl+C to copy', null);
            }
          });

          $('curseValidateBtn').addEventListener('click', async function(){
            try {
              curseBusy(true); setCurseStatus('Validating…', null);
              var spec = parseCurseSpec();
              var data = await postCurse(spec, { dryRun: true });
              var finalSpec = data && data.spec ? normalizeCurseSpec(data.spec) : spec;
              renderCurseSummary(finalSpec);
              renderCursePreview(finalSpec);
              setCurseStatus('Valid ✓', true, extractArray(data.errors));
            } catch (e) {
              handleCurseError(e);
            } finally {
              curseBusy(false);
            }
          });

          $('curseIngestBtn').addEventListener('click', async function(){
            try {
              curseBusy(true); setCurseStatus('Validating…', null);
              var spec = parseCurseSpec();
              var dryRun = await postCurse(spec, { dryRun: true });
              var finalSpec = dryRun && dryRun.spec ? normalizeCurseSpec(dryRun.spec) : spec;
              renderCurseSummary(finalSpec);
              renderCursePreview(finalSpec);
              var dryErrors = extractArray(dryRun.errors);
              if (dryRun.ok === false) {
                setCurseStatus(dryRun.error || 'Validation errors found.', false, dryErrors);
                return;
              }
              setCurseStatus('Validation passed. Ingesting…', null, dryErrors);
              var data = await postCurse(finalSpec, { dryRun: false });
              var path = data.path || ('archive/curses/' + (data.slug || finalSpec.slug || 'curse') + '.md');
              var message = (data.saved === false ? 'Saved (dry run only).' : 'Ingested ✓') + ' → ' + path;
              setCurseStatus(message, true, extractArray(data.errors));
            } catch (e) {
              handleCurseError(e);
            } finally {
              curseBusy(false);
            }
          });

          $('curseClearBtn').addEventListener('click', function(){
            $('curseSpec').value='';
            $('cursePreview').innerHTML='';
            renderCurseSummary(null);
            setCurseStatus('Cleared. Ready for new JSON.', null);
          });
        }
      })();
      </script>
    </>
  )}
</Base>
