---
/* Admin: Prompt → JSON → Preview → Ingest */
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import generatorStyles from "../../../server/lib/generatorStyles.js";
import { generatorPresetOptions } from "../../../server/lib/generatorPresets.js";
import normalizeDraftSpecScript from "../../scripts/normalizeDraftSpec.js?url";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";
import {
  CURSE_TARGETS,
  CURSE_TONES,
  CURSE_TYPES,
  CURSE_TAGS,
} from "../../../server/lib/curseSpecSchema.js";


const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin" });

const toLabel = (key: string) =>
  key
    .replace(/([A-Z])/g, " $1")
    .replace(/[-_]/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (c) => c.toUpperCase());

const presetOptions = generatorPresetOptions;

const styleOptions = Object.entries(generatorStyles)
  .map(([key, description]) => ({
    key,
    label: key === "cozy" ? "Cozy (default)" : toLabel(key),
    description,
  }))
  .sort((a, b) => {
    if (a.key === "cozy") return -1;
    if (b.key === "cozy") return 1;
    return a.label.localeCompare(b.label);
  });

const defaultModeDescription =
  "Use the master prompt for the full ritual + reflection flow, or choose a template for a specialty outline.";
const defaultStyleDescription =
  styleOptions.find((option) => option.key === "cozy")?.description ??
  "Write like a gentle, imperfect friend: warm, soft, everyday metaphors.";

const curseTypeOptions = CURSE_TYPES;
const curseTargetOptions = CURSE_TARGETS;
const curseToneOptions = CURSE_TONES;
const curseTags = CURSE_TAGS;

// Gate: dev OR query ?key=PUBLIC_ADMIN_KEY (useful if you later switch to a server adapter)
const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

// Dev API base (falls back to localhost if not set)
const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';
---
<Base
  title="WitchClick — Admin"
  description="Prompt, preview, ingest, publish."
  canon={canonical}
  wide={true}
  noindex={true}
>
  <HeadSlot slot="head">
    <meta name="robots" content="noindex" />
  </HeadSlot>

  {canUse ? (
    <div class="space-y-6">
      <AdminNav currentPath="/admin" />

      <section class="rounded-2xl border border-line-subtle bg-surface-base p-6 shadow-sm">
        <div class="space-y-3">
          <div>
            <h1 class="text-2xl font-semibold text-body-strong">Content Generator</h1>
            <p class="text-sm text-body-muted mt-1">
              AI-powered workflow for creating posts and curses. Generate prompts, validate JSON, preview content, and ingest to your site.
            </p>
          </div>
          <div class="rounded-lg border border-dashed border-line-subtle bg-surface-base/60 p-4 text-xs text-body-muted">
            <div class="font-semibold mb-2">📝 How it works:</div>
            <ol class="space-y-2 ml-4 list-decimal">
              <li><strong>Choose content type:</strong> Select Posts for articles or Curses for printable rituals</li>
              <li><strong>Generate prompt:</strong> Fill in topic and preferences, get an AI-ready prompt</li>
              <li><strong>Get JSON from AI:</strong> Paste prompt into your LLM (Claude, GPT, etc.), receive structured JSON</li>
              <li><strong>Validate & Preview:</strong> Check the JSON structure and preview how it'll look</li>
              <li><strong>Ingest:</strong> Save to your content directory as markdown files</li>
            </ol>
          </div>
        </div>
      </section>

      <div class="rounded-2xl border border-line-subtle bg-surface-base p-3 shadow-sm">
        <div class="flex items-center gap-3">
          <span class="text-sm font-medium text-body-muted">Content Type:</span>
          <button
            type="button"
            data-panel-toggle="posts"
            class="rounded-lg px-4 py-2 text-sm font-semibold text-primary hover:bg-surface-soft transition"
          >
            📄 Posts
          </button>
          <button
            type="button"
            data-panel-toggle="curses"
            class="rounded-lg px-4 py-2 text-sm font-semibold text-primary hover:bg-surface-soft transition"
          >
            ✨ Curses
          </button>
        </div>
      </div>

      <div
        data-panel-root
        data-dev-api={DEV_API}
        data-preset-options={JSON.stringify(presetOptions)}
        data-style-options={JSON.stringify(styleOptions)}
        data-default-mode={defaultModeDescription}
        data-default-style={defaultStyleDescription}
        data-curse-types={JSON.stringify(curseTypeOptions)}
        data-curse-targets={JSON.stringify(curseTargetOptions)}
        data-curse-tones={JSON.stringify(curseToneOptions)}
        data-curse-tags={JSON.stringify(curseTags)}
      >
        <div id="postsPanel" data-panel="posts" class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <section class="lg:col-span-5 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
            <div class="mb-4 space-y-2">
              <h2 class="text-xl font-semibold">Step 1: Build Generator Prompt</h2>
              <p class="text-xs text-body-muted">Configure your post preferences to generate an AI prompt</p>
            </div>
            <div class="grid gap-3">
              <label class="block">
                <span class="text-xs font-medium uppercase tracking-wide text-body-subtle">Topic</span>
                <input id="topic" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="tea ritual for focus" />
                <p class="mt-1 text-[11px] text-body-faint">What should this post be about?</p>
              </label>
              <label class="block">
                <span class="text-xs font-medium">Word count</span>
                <input id="words" type="number" class="mt-1 w-full rounded-lg border px-3 py-2" value="1200" />
              </label>
              <label class="block">
                <span class="text-xs font-medium">Template</span>
                <select id="mode" class="mt-1 w-full rounded-lg border px-3 py-2 text-sm">
                  <option value="" selected>Standard ritual workflow</option>
                  {presetOptions.map((option) => (
                    <option value={option.key}>{option.label}</option>
                  ))}
                </select>
                <p id="modeHelp" class="mt-1 text-[11px] text-body-subtle">{defaultModeDescription}</p>
              </label>
              <label class="block">
                <span class="text-xs font-medium">Writing style</span>
                <select id="style" class="mt-1 w-full rounded-lg border px-3 py-2 text-sm">
                  {styleOptions.map((option) => (
                    <option value={option.key} selected={option.key === "cozy"}>
                      {option.label}
                    </option>
                  ))}
                </select>
                <p id="styleHelp" class="mt-1 text-[11px] text-body-subtle">{defaultStyleDescription}</p>
              </label>
              <div class="flex gap-4 text-sm">
                <label class="inline-flex items-center gap-2">
                  <input type="checkbox" id="ads" /> <span>Include ads</span>
                </label>
                <label class="inline-flex items-center gap-2">
                  <input type="checkbox" id="kofi" checked /> <span>Include Ko-fi</span>
                </label>
              </div>
              <div class="flex gap-2">
                <button id="genPrompt" class="rounded-lg bg-surface-accent-bolder px-3 py-2 text-inverse hover:bg-surface-accent-deep">Generate Prompt</button>
                <button id="copyPrompt" class="rounded-lg border px-3 py-2">Copy</button>
              </div>
              <textarea id="promptOut" class="mt-2 h-64 w-full rounded-lg border px-3 py-2 font-mono text-xs" placeholder="Prompt will appear here…"></textarea>
              <p class="text-xs text-body-subtle">Paste this into your LLM → get JSON → paste into the box on the right.</p>
            </div>
          </section>

          <section class="lg:col-span-7 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm">
            <div class="mb-4 space-y-2">
              <h2 class="text-xl font-semibold">Step 2: Process JSON Content</h2>
              <p class="text-xs text-body-muted">Paste PostSpec JSON from your AI, then validate, preview, and ingest</p>
            </div>

            <textarea id="spec" class="h-56 w-full rounded-lg border px-3 py-2 font-mono text-xs" placeholder='Paste the PostSpec v2 JSON here (get it from your LLM using the generated prompt)'></textarea>

            <div class="mt-3 space-y-4 lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(300px,1fr)] lg:gap-6">
              <div class="space-y-3">
                <div class="flex flex-col gap-2">
                  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wide text-body-muted">
                    <span>Save mode</span>
                    <div class="inline-flex rounded-full border border-line-neutral bg-surface-neutral-soft p-1" data-save-mode>
                      <button type="button" data-mode="publish" class="rounded-full px-3 py-1 text-[11px] font-semibold text-body bg-surface-base shadow-sm">Publish</button>
                      <button type="button" data-mode="draft" class="rounded-full px-3 py-1 text-[11px] font-semibold text-body-muted">Draft</button>
                    </div>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <button id="validateBtn" class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft">✓ Validate</button>
                    <button id="previewBtn" class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft">👁 Preview</button>
                    <button id="ingestBtn" class="rounded-lg bg-success px-4 py-2 text-sm font-semibold text-white hover:opacity-90">💾 Save</button>
                    <button id="ingestPublishBtn" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">🚀 Publish Now</button>
                    <button id="clearBtn" class="rounded-lg border border-line-neutral px-4 py-2 text-sm font-medium hover:bg-surface-soft">Clear</button>
                  </div>
                  <div class="text-xs text-body-muted rounded-lg border border-dashed border-line-subtle bg-surface-base/60 px-3 py-2">
                    <strong>💡 Tip:</strong> Validate first to check for errors, Preview to see the rendered flow. Use the save mode toggle to store drafts without publishing. <a href="/admin/staging" class="text-primary hover:underline">View staged drafts →</a>
                  </div>
                </div>
                <div class="flex flex-col gap-3">
                  <div
                    id="status"
                    class="rounded-lg border border-line-slate bg-surface-cool-soft px-3 py-2 text-sm text-muted-strong"
                  ></div>
                  <div
                    id="specSummary"
                    class="rounded-lg border border-line-neutral bg-surface-neutral-soft p-3 text-[11px] text-body-muted"
                  ></div>
                </div>
                <div id="preview" class="prose prose-neutral mt-4 max-w-none border-t pt-4"></div>
              </div>
              <aside class="mt-6 space-y-3 rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm lg:mt-0" data-recent-panel>
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="text-sm font-semibold text-body-strong">Recent Posts</h3>
                    <p class="text-xs text-body-muted">Quick links to the latest ingestions.</p>
                  </div>
                  <button type="button" data-recent-refresh class="rounded-lg border border-line-neutral px-3 py-1 text-xs font-semibold hover:bg-surface-soft">↻ Refresh</button>
                </div>
                <label class="flex items-center gap-2 text-xs text-body-muted">
                  <span class="sr-only">Filter recent posts</span>
                  <input type="search" data-recent-filter class="w-full rounded-lg border border-line-neutral px-3 py-1.5 text-sm" placeholder="Filter posts…" />
                </label>
                <div class="space-y-2" data-recent-list>
                  <div class="rounded-lg border border-dashed border-line-subtle p-3 text-xs text-body-muted">Fetching recent posts…</div>
                </div>
                <p class="text-[11px] text-body-muted">Select a post to insert a JSON stub or jump to the editor.</p>
              </aside>
            </div>
          </section>
        </div>

        <div id="cursesPanel" data-panel="curses" class="hidden">
          <section class="rounded-2xl border border-line-neutral bg-surface-base p-4 shadow-sm space-y-3">
            <h2 class="text-xl font-semibold">Curses Dashboard moved</h2>
            <p class="text-sm text-body-muted">
              The curses generator and archive live in a dedicated dashboard optimized for print/PDF workflows.
            </p>
            <a href="/admin/curses" class="inline-flex items-center gap-2 rounded-lg bg-surface-accent-bolder px-4 py-2 text-inverse hover:bg-surface-accent-deep">
              Open Curses Dashboard →
            </a>
          </section>
        </div>
      </div>
      </div>
    ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-line-subtle bg-surface-base p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-body-muted">These tools only run in <strong>development</strong> (or with a temporary key when hosted on a server adapter).</p>
      <ol class="mx-auto mt-4 list-decimal space-y-2 text-left text-sm text-body-muted">
        <li>Run <code>npm run dev</code> locally.</li>
        <li>Use the ingestion CLI: <code>npm run ingest ./path/to/post.json</code>.</li>
        <li>If you later switch to serverless, set <code>PUBLIC_ADMIN_KEY</code> and visit <code>/admin?key=…</code>.</li>
      </ol>
    </section>
  )}

  {canUse && (
    <>
      <script type="module" is:inline src={normalizeDraftSpecScript}></script>
      <script is:inline>
      (function(){
        var root = document.querySelector('[data-panel-root]');
        var DEV_API = root?.getAttribute('data-dev-api') || 'http://localhost:8787';
        var $ = function(id){ return document.getElementById(id); };
        var rawPresets = root?.getAttribute('data-preset-options') || '[]';
        var rawStyles = root?.getAttribute('data-style-options') || '[]';
        var DEFAULT_MODE_DESC = root?.getAttribute('data-default-mode') || '';
        var DEFAULT_STYLE_DESC = root?.getAttribute('data-default-style') || '';
        var rawCurseTypes = root?.getAttribute('data-curse-types') || '[]';
        var rawCurseTargets = root?.getAttribute('data-curse-targets') || '[]';
        var rawCurseTones = root?.getAttribute('data-curse-tones') || '[]';
        var rawCurseTags = root?.getAttribute('data-curse-tags') || '[]';
        var saveModeContainer = root?.querySelector('[data-save-mode]');
        var currentSaveMode = 'publish';
        var recentPanel = root?.querySelector('[data-recent-panel]');
        var recentListEl = root?.querySelector('[data-recent-list]');
        var recentRefreshBtn = root?.querySelector('[data-recent-refresh]');
        var recentFilterInput = root?.querySelector('[data-recent-filter]');
        var recentPosts = [];
        var recentFilterText = '';
        var PRESET_OPTIONS = [];
        var STYLE_OPTIONS = [];
        var CURSE_TYPES = [];
        var CURSE_TARGETS = [];
        var CURSE_TONES = [];
        var CURSE_TAGS = [];
        try { PRESET_OPTIONS = JSON.parse(rawPresets); } catch {}
        try { STYLE_OPTIONS = JSON.parse(rawStyles); } catch {}
        try { CURSE_TYPES = JSON.parse(rawCurseTypes); } catch {}
        try { CURSE_TARGETS = JSON.parse(rawCurseTargets); } catch {}
        try { CURSE_TONES = JSON.parse(rawCurseTones); } catch {}
        try { CURSE_TAGS = JSON.parse(rawCurseTags); } catch {}

        var panelButtons = Array.from(document.querySelectorAll('[data-panel-toggle]'));
        var panels = Array.from(document.querySelectorAll('[data-panel]'));

        function showPanel(name){
          panels.forEach(function(panel){
            if (panel.getAttribute('data-panel') === name) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
          panelButtons.forEach(function(button){
            var active = button.getAttribute('data-panel-toggle') === name;
            if (active) {
              button.classList.add('bg-surface-base', 'shadow');
              button.setAttribute('aria-pressed', 'true');
            } else {
              button.classList.remove('bg-surface-base', 'shadow');
              button.setAttribute('aria-pressed', 'false');
            }
          });
        }

        panelButtons.forEach(function(button){
          button.addEventListener('click', function(){
            var target = button.getAttribute('data-panel-toggle') || 'posts';
            showPanel(target);
          });
        });

        showPanel('posts');
        if (saveModeContainer) {
          saveModeContainer.addEventListener('click', function(event){
            var target = event.target.closest('[data-mode]');
            if (!target) return;
            var mode = target.getAttribute('data-mode') || 'publish';
            setSaveMode(mode);
          });
          setSaveMode(currentSaveMode);
        }
        function setStatus(msg, ok, warnings, notes, errors, postStubs, slug){
          var el=$('status');
          if (!el) return;
          var base='rounded-lg border px-3 py-2 text-sm';
          if (ok === false) {
            el.className = base + ' border-line-danger bg-surface-danger-soft text-danger';
          } else if (ok === true) {
            el.className = base + ' border-line-emerald bg-surface-emerald-soft text-success-emerald';
          } else {
            el.className = base + ' border-line-slate bg-surface-cool-soft text-muted-strong';
          }
          el.innerHTML='';

          if (msg) {
            var p=document.createElement('p');
            p.className='font-medium';
            // Support HTML in message (for links)
            if (msg.indexOf('<a ') !== -1) {
              p.innerHTML=msg;
            } else {
              p.textContent=msg;
            }
            el.appendChild(p);
          }

          function appendList(label, items, className){
            if (!Array.isArray(items) || !items.length) return;
            var heading=document.createElement('p');
            heading.className='mt-2 text-[11px] font-semibold ' + className;
            heading.textContent=label + ':';
            el.appendChild(heading);
            var list=document.createElement('ul');
            list.className='mt-1 list-disc pl-5 text-[11px] ' + className;
            items.forEach(function(item){
              var li=document.createElement('li');
              li.textContent=String(item);
              list.appendChild(li);
            });
            el.appendChild(list);
          }

          appendList('Errors', errors, 'text-danger');
          appendList('Warnings', warnings, 'text-warning');
          appendList('Notes', notes, 'text-muted');

          if (Array.isArray(postStubs) && postStubs.length) {
            var stubsHeading=document.createElement('p');
            stubsHeading.className='mt-2 text-[11px] font-semibold text-info';
            stubsHeading.textContent='Post stubs that will be created:';
            el.appendChild(stubsHeading);
            var stubsList=document.createElement('ul');
            stubsList.className='mt-1 list-disc pl-5 text-[11px] text-info';
            postStubs.forEach(function(stub){
              var li=document.createElement('li');
              li.textContent=(stub.title || stub.slug) + ' (' + (stub.path || stub.slug) + ')';
              stubsList.appendChild(li);
            });
            el.appendChild(stubsList);
          }

          // Add action buttons after successful ingest
          if (ok === true && slug) {
            var actionsDiv = document.createElement('div');
            actionsDiv.className = 'mt-3 flex flex-wrap gap-2';

            // View Post button
            var viewBtn = document.createElement('a');
            viewBtn.href = '/post/' + encodeURIComponent(slug);
            viewBtn.target = '_blank';
            viewBtn.rel = 'noopener';
            viewBtn.className = 'inline-flex items-center gap-1.5 rounded-lg border border-line-neutral bg-surface-base px-3 py-1.5 text-sm font-medium text-primary hover:bg-surface-soft';
            viewBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>View Post';

            // Upload Hero button
            var heroBtn = document.createElement('a');
            heroBtn.href = '/admin/hero?post=' + encodeURIComponent(slug);
            heroBtn.className = 'inline-flex items-center gap-1.5 rounded-lg border border-line-neutral bg-surface-base px-3 py-1.5 text-sm font-medium text-primary hover:bg-surface-soft';
            heroBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>Upload Hero Image';

            // Edit Post button
            var editBtn = document.createElement('a');
            editBtn.href = '/admin/posts?slug=' + encodeURIComponent(slug);
            editBtn.className = 'inline-flex items-center gap-1.5 rounded-lg border border-line-neutral bg-surface-base px-3 py-1.5 text-sm font-medium text-primary hover:bg-surface-soft';
            editBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>Edit Post';

            actionsDiv.appendChild(viewBtn);
            actionsDiv.appendChild(heroBtn);
            actionsDiv.appendChild(editBtn);
            el.appendChild(actionsDiv);
          }

          if (!msg && !(Array.isArray(warnings) && warnings.length) && !(Array.isArray(notes) && notes.length)) {
            el.textContent='Ready for PostSpec JSON.';
          }
        }

        function setCurseStatus(msg, ok, errors){
          var el = $('curseStatus');
          if (!el) return;
          var base='rounded-lg border px-3 py-2 text-sm';
          if (ok === false) {
            el.className = base + ' border-line-danger bg-surface-danger-soft text-danger';
          } else if (ok === true) {
            el.className = base + ' border-line-emerald bg-surface-emerald-soft text-success-emerald';
          } else {
            el.className = base + ' border-line-slate bg-surface-cool-soft text-muted-strong';
          }
          el.innerHTML='';

          if (msg) {
            var p=document.createElement('p');
            p.className='font-medium';
            p.textContent=msg;
            el.appendChild(p);
          }

          if (Array.isArray(errors) && errors.length) {
            var list=document.createElement('ul');
            list.className='mt-2 list-disc pl-5 text-[11px] text-danger';
            errors.forEach(function(item){
              var li=document.createElement('li');
              li.textContent=String(item);
              list.appendChild(li);
            });
            el.appendChild(list);
          }

          if (!msg && !(Array.isArray(errors) && errors.length)) {
            el.textContent='Ready for CurseSpec JSON.';
          }
        }
        function busy(on){
          ['genPrompt','validateBtn','previewBtn','ingestBtn','ingestPublishBtn','copyPrompt']
            .forEach(function(id){ var b=$(id); if(b){ b.disabled=!!on; b.style.opacity = on ? .6 : 1; }});
        }

        function curseBusy(on){
          ['curseGenPrompt','curseValidateBtn','curseIngestBtn','curseCopyPrompt']
            .forEach(function(id){ var b=$(id); if(b){ b.disabled=!!on; b.style.opacity = on ? .6 : 1; }});
        }

        function summarizeEntities(list){
          if (!Array.isArray(list) || !list.length) return 'None';
          var sample = list.map(function(item){
            var type = item && item.type ? item.type : '?';
            var slug = item && item.slug ? item.slug : '?';
            return type + ':' + slug;
          });
          return sample.join(', ');
        }

        function summarizePlacements(list){
          if (!Array.isArray(list) || !list.length) return 'None';
          return list.join(', ');
        }

        function renderSpecSummary(spec){
          var panel = $('specSummary');
          if (!panel) return;
          panel.innerHTML='';
          var baseClass='rounded-lg border border-line-neutral bg-surface-neutral-soft p-3 text-[11px]';
          if (!spec) {
