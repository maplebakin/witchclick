---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../../utils/settings";
import HeadSlot from "@/components/HeadSlot.astro";
import AdminNav from "@/components/AdminNav.astro";
import { listCanonicalPostFiles, readPostFile, resolveCanonicalPostsDirectory } from "../../utils/postFiles";
import { extractHeroImage } from "../../utils/posts";
import { classifyAdminQueues, queueDefinitions, type QueuePost } from "../../utils/adminQueues";
import * as stubPromptGenerator from "../../../server/lib/stubPromptGenerator.js";

const { generatePostStubPrompts } = stubPromptGenerator as typeof stubPromptGenerator & {
  generatePostStubPrompts: (options?: { cwd?: string }) => { entries: Array<{ slug: string; title?: string; stubTriageStatus?: string }> };
};
const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/admin" });
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const canUse = import.meta.env.DEV || !!(ADMIN_KEY && url.searchParams.get("key") === ADMIN_KEY);
const posts: QueuePost[] = [];
let sourceError = "";
let queues = classifyAdminQueues([], []);
if (canUse) {
  try {
    const postsDir = resolveCanonicalPostsDirectory();
    if (!fs.existsSync(postsDir)) throw new Error("Canonical posts directory unavailable");
    for (const fileName of listCanonicalPostFiles(postsDir)) {
      const fallbackSlug = fileName.replace(/\.md$/, "");
      try {
        const record = readPostFile(path.join(postsDir, fileName));
        const hero = extractHeroImage(record.data);
        let availability: "present" | "missing" | "unknown" = "unknown";
        if (hero.src?.startsWith("/") && !hero.src.startsWith("//")) {
          const publicDir = path.resolve(process.cwd(), "public");
          const heroPath = path.resolve(publicDir, `.${decodeURIComponent(hero.src.split(/[?#]/)[0]!)}`);
          if (heroPath.startsWith(`${publicDir}${path.sep}`)) {
            availability = fs.existsSync(heroPath) && fs.statSync(heroPath).isFile() ? "present" : "missing";
          }
        }
        posts.push({ slug: record.slug ?? fallbackSlug, data: record.data, content: record.content, artwork: { ...hero, availability } });
      } catch {
        posts.push({ slug: fallbackSlug, readError: "Unknown: post source could not be read or parsed" });
      }
    }
    queues = classifyAdminQueues(posts, generatePostStubPrompts({ cwd: process.cwd() }).entries);
  } catch {
    sourceError = "Readiness is unknown: local post data or the stub detector could not be loaded. Reload the page after checking the local files.";
  }
}
const snapshotTime = new Date().toISOString();
const queueGroups = Object.fromEntries(queueDefinitions.map(({ id }) => {
  const items = id === "recent" ? queues[id].slice(0, 10) : queues[id];
  return [id, [items.slice(0, 5), items.slice(5)].filter((group) => group.length)];
}));
---

<Base title="WitchClick — Admin Dashboard" description="Work queues and next actions." canon={canonical} wide noindex>
  <HeadSlot slot="head"><meta name="robots" content="noindex" /></HeadSlot>
  {canUse ? (
    <div class="admin-dashboard space-y-6" data-dashboard-root>
      <AdminNav currentPath="/admin" />
      <section class="admin-dashboard__hero rounded-2xl border border-line-subtle p-6 shadow-sm">
        <h1 class="text-2xl font-semibold text-body-strong">Work queues</h1>
        <p class="mt-2 text-body-muted">One next step per post. Secondary blockers stay with its primary queue.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a class="admin-btn-primary px-4 py-3 font-semibold" href="/admin/generator">Generate a post</a>
          <a class="admin-btn-secondary px-4 py-3 font-semibold" href="/admin/write">Write a post</a>
        </div>
      </section>
      <section class="admin-dashboard__panel rounded-2xl border border-line-neutral p-4 shadow-sm">
        <h2 class="text-lg font-semibold text-body-strong">Open by Slug</h2>
        <form class="mt-3 grid gap-3 md:grid-cols-[minmax(0,1fr)_auto_auto]" data-open-slug-form>
          <label class="min-w-0"><span class="sr-only">Post or entity slug</span><input class="w-full px-3 py-3" type="text" name="slug" placeholder="rose-quartz or full-moon-release-ritual" autocomplete="off" required /></label>
          <button class="admin-btn-primary px-4 py-3 font-semibold" type="submit" name="target" value="post">Open Post</button>
          <button class="admin-btn-secondary px-4 py-3 font-semibold" type="submit" name="target" value="entity">Open Entity</button>
        </form>
        <p class="mt-2 text-sm text-body-muted" data-open-slug-status role="status"></p>
      </section>
      <p class="text-sm text-body-muted">Read-only snapshot at <time datetime={snapshotTime}>{snapshotTime.replace("T", " ").slice(0, 19)} UTC</time>. Reload after editing. Checks measure preparation, not editorial approval; remote artwork is unverified.</p>
      <div data-queue-status role="status" aria-live="polite">Loading work queues…</div>
      <div data-queue-host aria-busy="true"></div>
      <div hidden data-queue-template data-source-error={sourceError}>
        {sourceError ? <p class="admin-dashboard__panel rounded-xl border border-line-neutral p-4" role="alert">{sourceError}</p> : (
          <div class="space-y-5">
            {queueDefinitions.map((definition) => (
              <section class="admin-dashboard__panel rounded-2xl border border-line-neutral p-4 shadow-sm" data-queue={definition.id}>
                <h2 class="text-lg font-semibold text-body-strong">{definition.title} <span data-queue-count>({queues[definition.id].length})</span></h2>
                {definition.id === "decision" && <p class="mt-2 text-sm text-body-muted">Placeholders are separate from real drafts. Candidate and untriaged stubs also need their next step confirmed.</p>}
                {definition.id === "work" && <p class="mt-2 text-sm text-body-muted">Draft preparation problems, scheduling decisions, and items whose readiness is unknown.</p>}
                {definition.id === "recent" && <p class="mt-2 text-sm text-body-muted">Latest public-eligible posts, after artwork queues. Showing up to 10.</p>}
                {queues[definition.id].length === 0 ? <p class="mt-3 text-body-muted" data-queue-empty>{definition.empty}</p> : (
                  queueGroups[definition.id]!.map((group, groupIndex) => {
                    const Wrapper = groupIndex === 0 ? "div" : "details";
                    return (
                    <Wrapper class="mt-3">
                    {groupIndex > 0 && <summary class="dashboard-show-more">Show {group.length} more items</summary>}
                    <ul class="mt-3 space-y-3">
                    {group.map((item) => (
                      <li class="admin-dashboard__list-item rounded-xl border border-line-neutral p-4" data-queue-slug={item.slug}>
                        <div class="dashboard-queue-row">
                          <div class="min-w-0">
                            <h3 class="font-semibold text-body-strong">{item.title}</h3>
                            <p class="mt-1 text-sm text-body-muted">{item.contentType} · {item.state}</p>
                            <p class="mt-2 text-body-base">{item.reason}</p>
                            {item.blockers.length > 0 && <ul class="mt-2 flex flex-wrap gap-2" aria-label="Secondary blockers">{item.blockers.map((blocker) => <li class="dashboard-blocker">{blocker}</li>)}</ul>}
                          </div>
                          <a class="admin-btn-secondary dashboard-next-action px-4 py-3 font-semibold" href={item.href}>{item.action}</a>
                        </div>
                      </li>
                    ))}
                  </ul>
                  </Wrapper>
                  );
                  })
                )}
              </section>
            ))}
          </div>
        )}
      </div>
      <noscript><p>JavaScript is needed to display these work queues. You can still use the navigation above to review content.</p></noscript>
    </div>
  ) : <p>Local admin only. Use the development server or a valid admin key.</p>}
</Base>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-dashboard-root]');
    if (!root) return;
    const host = root.querySelector('[data-queue-host]');
    const status = root.querySelector('[data-queue-status]');
    const template = root.querySelector('[data-queue-template]');
    try {
      if (!host || !template || !status) throw new Error('Queue snapshot unavailable');
      host.replaceChildren(...template.childNodes);
      template.remove();
      host.setAttribute('aria-busy', 'false');
      status.textContent = template.dataset.sourceError ? 'Queues unavailable. Readiness is unknown.' : '';
    } catch {
      if (host) host.setAttribute('aria-busy', 'false');
      if (status) status.textContent = 'Queues could not be displayed. Readiness is unknown. Reload to try again.';
    }
    const form = root.querySelector('[data-open-slug-form]');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const slug = String(new FormData(form).get('slug') || '').trim().toLowerCase();
      const message = root.querySelector('[data-open-slug-status]');
      if (!slug) { if (message) message.textContent = 'Enter a slug to open its editor.'; return; }
      const target = event.submitter?.value === 'entity' ? 'entities' : 'posts';
      window.location.href = `/admin/${target}?slug=${encodeURIComponent(slug)}`;
    });
  })();
</script>

<style>
  .dashboard-queue-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .dashboard-queue-row h3, .dashboard-queue-row p, .dashboard-blocker { overflow-wrap: anywhere; }
  .dashboard-next-action { flex-shrink: 0; text-align: center; min-height: 2.75rem; }
  .dashboard-blocker { border: 1px solid var(--admin-border-subtle); border-radius: .5rem; padding: .25rem .5rem; font-size: .875rem; color: var(--admin-text-muted); }
  .dashboard-show-more { cursor: pointer; min-height: 2.75rem; padding: .75rem; color: var(--admin-text-primary); }
  .dashboard-show-more:focus-visible { outline: 2px solid var(--admin-focus); outline-offset: 2px; }
  @media (max-width: 640px) { .dashboard-queue-row { flex-direction: column; } .dashboard-next-action { width: 100%; } }
</style>
