        async function loadRecentPosts(){
          if (!recentListEl) return;
          recentListEl.innerHTML = '<div class="rounded-lg border border-dashed border-line-subtle p-3 text-xs text-body-muted">Loading recent posts…</div>';
          try{
            var res = await fetch(DEV_API + '/posts/list', { method: 'POST' });
            var data = await res.json();
            if (!data?.ok) throw new Error(data?.error || 'Unable to load posts');
            var items = Array.isArray(data.items) ? data.items : [];
            items.sort(function(a, b){
              var dateA = parseDateValue(a?.createdAt) || parseDateValue(a?.publishedAt) || 0;
              var dateB = parseDateValue(b?.createdAt) || parseDateValue(b?.publishedAt) || 0;
              return dateB - dateA;
            });
            recentPosts = items.slice(0, 10);
            renderRecentPosts();
          }catch(error){
            recentListEl.innerHTML = '<div class="rounded-lg border border-dashed border-line-subtle p-3 text-xs text-danger">Failed to load recent posts.</div>';
          }
