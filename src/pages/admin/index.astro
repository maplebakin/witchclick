---
/* Admin: Prompt → JSON → Preview → Ingest */
import Base from "../../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../../utils/settings";
import generatorStyles from "../../../server/lib/generatorStyles.js";
import { generatorPresetOptions } from "../../../server/lib/generatorPresets.js";

export const prerender = false; // never emit in static builds

const settings = readSettings();
const site = getSiteOrigin(settings) || "https://example.com";

const toLabel = (key: string) =>
  key
    .replace(/([A-Z])/g, " $1")
    .replace(/[-_]/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (c) => c.toUpperCase());

const presetOptions = generatorPresetOptions;

const styleOptions = Object.entries(generatorStyles)
  .map(([key, description]) => ({
    key,
    label: key === "cozy" ? "Cozy (default)" : toLabel(key),
    description,
  }))
  .sort((a, b) => {
    if (a.key === "cozy") return -1;
    if (b.key === "cozy") return 1;
    return a.label.localeCompare(b.label);
  });

const defaultModeDescription =
  "Use the master prompt for the full ritual + reflection flow, or choose a template for a specialty outline.";
const defaultStyleDescription =
  styleOptions.find((option) => option.key === "cozy")?.description ??
  "Write like a gentle, imperfect friend: warm, soft, everyday metaphors.";

// Gate: dev OR query ?key=PUBLIC_ADMIN_KEY (useful if you later switch to a server adapter)
const isDev = import.meta.env.DEV;
const ADMIN_KEY = import.meta.env.PUBLIC_ADMIN_KEY;
const url = new URL(Astro.request.url);
const keyOk = ADMIN_KEY && url.searchParams.get('key') === ADMIN_KEY;
const canUse = isDev || !!keyOk;

// Dev API base (falls back to localhost if not set)
const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';
---
<Base
  title="WitchClick — Admin"
  description="Prompt, preview, ingest, publish."
  canon={`${site}/admin`}
  wide={true}
  noindex={true}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  {canUse ? (
    <div class="space-y-6">
      <nav aria-label="Admin shortcuts" class="rounded-2xl border border-purple-100 bg-purple-50 px-4 py-3 text-sm text-purple-900">
        <span class="font-medium">Quick tools:</span>
        <a class="ml-3 underline underline-offset-4 hover:no-underline" href="/admin/entities">Entities Admin</a>
        <span aria-hidden="true" class="mx-2">•</span>
        <a class="underline underline-offset-4 hover:no-underline" href="/admin/downloads">Downloads Admin</a>
        <span aria-hidden="true" class="mx-2">•</span>
        <a class="underline underline-offset-4 hover:no-underline" href="/admin/hero">Hero Image Uploader</a>
      </nav>

      <div
        class="grid grid-cols-1 gap-6 lg:grid-cols-12"
        data-dev-api={DEV_API}
        data-preset-options={JSON.stringify(presetOptions)}
        data-style-options={JSON.stringify(styleOptions)}
        data-default-mode={defaultModeDescription}
        data-default-style={defaultStyleDescription}
      >
      {/* LEFT: Prompt builder */}
      <section class="lg:col-span-5 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
        <h1 class="mb-3 text-xl font-semibold">1) Build Post Generator Prompt</h1>
        <div class="grid gap-3">
          <label class="block">
            <span class="text-xs font-medium">Topic</span>
            <input id="topic" class="mt-1 w-full rounded-lg border px-3 py-2" placeholder="tea ritual for focus" />
          </label>
          <label class="block">
            <span class="text-xs font-medium">Word count</span>
            <input id="words" type="number" class="mt-1 w-full rounded-lg border px-3 py-2" value="1200" />
          </label>
          <label class="block">
            <span class="text-xs font-medium">Template</span>
            <select id="mode" class="mt-1 w-full rounded-lg border px-3 py-2 text-sm">
              <option value="" selected>Standard ritual workflow</option>
              {presetOptions.map((option) => (
                <option value={option.key}>{option.label}</option>
              ))}
            </select>
            <p id="modeHelp" class="mt-1 text-[11px] text-gray-600">{defaultModeDescription}</p>
          </label>
          <label class="block">
            <span class="text-xs font-medium">Writing style</span>
            <select id="style" class="mt-1 w-full rounded-lg border px-3 py-2 text-sm">
              {styleOptions.map((option) => (
                <option value={option.key} selected={option.key === "cozy"}>
                  {option.label}
                </option>
              ))}
            </select>
            <p id="styleHelp" class="mt-1 text-[11px] text-gray-600">{defaultStyleDescription}</p>
          </label>
          <div class="flex gap-4 text-sm">
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" id="ads" /> <span>Include ads</span>
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="checkbox" id="kofi" checked /> <span>Include Ko-fi</span>
            </label>
          </div>
          <div class="flex gap-2">
            <button id="genPrompt" class="rounded-lg bg-purple-700 px-3 py-2 text-white hover:bg-purple-800">Generate Prompt</button>
            <button id="copyPrompt" class="rounded-lg border px-3 py-2">Copy</button>
          </div>
          <textarea id="promptOut" class="mt-2 h-64 w-full rounded-lg border px-3 py-2 font-mono text-xs" placeholder="Prompt will appear here…"></textarea>
          <p class="text-xs text-gray-600">Paste this into your LLM → get JSON → paste into the box on the right.</p>
        </div>
      </section>

      {/* RIGHT: JSON preview / ingest / publish */}
      <section class="lg:col-span-7 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
        <h2 class="mb-3 text-xl font-semibold">2) Paste PostSpec JSON → Preview → Ingest → Publish</h2>

        <textarea id="spec" class="h-56 w-full rounded-lg border px-3 py-2 font-mono text-xs" placeholder='Paste the PostSpec v2 JSON here'></textarea>

        <div class="mt-3 flex flex-wrap gap-2">
          <button id="validateBtn" class="rounded-lg border px-3 py-2 text-sm">Validate</button>
          <button id="previewBtn" class="rounded-lg border px-3 py-2 text-sm">Preview</button>
          <button id="ingestBtn" class="rounded-lg bg-green-600 px-3 py-2 text-sm text-white hover:bg-green-700">Ingest</button>
          <button id="ingestPublishBtn" class="rounded-lg bg-indigo-600 px-3 py-2 text-sm text-white hover:bg-indigo-700">Ingest + Publish</button>
          <button id="clearBtn" class="rounded-lg border px-3 py-2 text-sm">Clear</button>
        </div>
        <div class="mt-3 flex flex-col gap-3">
          <div
            id="status"
            class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700"
          ></div>
          <div
            id="specSummary"
            class="rounded-lg border border-gray-200 bg-gray-50 p-3 text-[11px] text-gray-700"
          ></div>
        </div>

        <div id="preview" class="prose prose-neutral mt-4 max-w-none border-t pt-4"></div>
      </section>
      </div>
      </div>
    ) : (
    <section class="mx-auto max-w-3xl rounded-2xl border border-purple-100 bg-white p-6 text-center shadow-sm">
      <h1 class="mb-2 text-xl font-semibold">Admin is locked</h1>
      <p class="text-gray-700">These tools only run in <strong>development</strong> (or with a temporary key when hosted on a server adapter).</p>
      <ol class="mx-auto mt-4 list-decimal space-y-2 text-left text-sm text-gray-700">
        <li>Run <code>npm run dev</code> locally.</li>
        <li>Use the ingestion CLI: <code>npm run ingest ./path/to/post.json</code>.</li>
        <li>If you later switch to serverless, set <code>PUBLIC_ADMIN_KEY</code> and visit <code>/admin?key=…</code>.</li>
      </ol>
    </section>
  )}

  {canUse && (
    <script is:inline>
      (function(){
        var root = document.querySelector('[data-dev-api]');
        var DEV_API = root?.getAttribute('data-dev-api') || 'http://localhost:8787';
        var $ = function(id){ return document.getElementById(id); };
        var rawPresets = root?.getAttribute('data-preset-options') || '[]';
        var rawStyles = root?.getAttribute('data-style-options') || '[]';
        var DEFAULT_MODE_DESC = root?.getAttribute('data-default-mode') || '';
        var DEFAULT_STYLE_DESC = root?.getAttribute('data-default-style') || '';
        var PRESET_OPTIONS = [];
        var STYLE_OPTIONS = [];
        try { PRESET_OPTIONS = JSON.parse(rawPresets); } catch {}
        try { STYLE_OPTIONS = JSON.parse(rawStyles); } catch {}
        function setStatus(msg, ok, warnings, notes){
          var el=$('status');
          if (!el) return;
          var base='rounded-lg border px-3 py-2 text-sm';
          if (ok === false) {
            el.className = base + ' border-red-200 bg-red-50 text-red-700';
          } else if (ok === true) {
            el.className = base + ' border-emerald-200 bg-emerald-50 text-emerald-700';
          } else {
            el.className = base + ' border-slate-200 bg-slate-50 text-slate-700';
          }
          el.innerHTML='';

          if (msg) {
            var p=document.createElement('p');
            p.className='font-medium';
            p.textContent=msg;
            el.appendChild(p);
          }

          function appendList(label, items, className){
            if (!Array.isArray(items) || !items.length) return;
            var heading=document.createElement('p');
            heading.className='mt-2 text-[11px] font-semibold ' + className;
            heading.textContent=label + ':';
            el.appendChild(heading);
            var list=document.createElement('ul');
            list.className='mt-1 list-disc pl-5 text-[11px] ' + className;
            items.forEach(function(item){
              var li=document.createElement('li');
              li.textContent=String(item);
              list.appendChild(li);
            });
            el.appendChild(list);
          }

          appendList('Warnings', warnings, 'text-amber-700');
          appendList('Notes', notes, 'text-slate-600');

          if (!msg && !(Array.isArray(warnings) && warnings.length) && !(Array.isArray(notes) && notes.length)) {
            el.textContent='Ready for PostSpec JSON.';
          }
        }
        function busy(on){
          ['genPrompt','validateBtn','previewBtn','ingestBtn','ingestPublishBtn','copyPrompt']
            .forEach(function(id){ var b=$(id); if(b){ b.disabled=!!on; b.style.opacity = on ? .6 : 1; }});
        }

        function summarizeEntities(list){
          if (!Array.isArray(list) || !list.length) return 'None';
          var sample = list.map(function(item){
            var type = item && item.type ? item.type : '?';
            var slug = item && item.slug ? item.slug : '?';
            return type + ':' + slug;
          });
          return sample.join(', ');
        }

        function summarizePlacements(list){
          if (!Array.isArray(list) || !list.length) return 'None';
          return list.join(', ');
        }

        function renderSpecSummary(spec){
          var panel = $('specSummary');
          if (!panel) return;
          panel.innerHTML='';
          var baseClass='rounded-lg border border-gray-200 bg-gray-50 p-3 text-[11px]';
          if (!spec) {
            panel.className = baseClass + ' text-gray-600';
            var empty=document.createElement('p');
            empty.textContent='No PostSpec parsed yet. Paste JSON to inspect the structure.';
            panel.appendChild(empty);
            return;
          }

          panel.className = baseClass + ' text-gray-700';
          var title=document.createElement('p');
          title.className='text-xs font-semibold uppercase tracking-wide text-gray-500';
          title.textContent='Spec Summary';
          panel.appendChild(title);

          var tags=Array.isArray(spec.tags) ? spec.tags : [];
          var sections=Array.isArray(spec.sections) ? spec.sections : [];
          var outline=Array.isArray(spec.outline) ? spec.outline : [];
          var entities=Array.isArray(spec.entities) ? spec.entities : [];
          var internal=Array.isArray(spec.internalLinkHints) ? spec.internalLinkHints : [];
          var affiliates=Array.isArray(spec.affiliateHints) ? spec.affiliateHints : [];
          var placements=Array.isArray(spec.adPlacements) ? spec.adPlacements : [];
          var altTexts=Array.isArray(spec.altTexts) ? spec.altTexts : [];
          var totalWords=sections.reduce(function(sum, section){ return sum + wordCount(section && section.markdown || ''); }, 0);
          var reading=Math.max(1, Math.round(totalWords / 200));
          var ctaType=spec.cta && spec.cta.type ? spec.cta.type : 'none';
          var ctaDetail = ctaType === 'download'
            ? (spec.cta && spec.cta.id ? 'download (' + spec.cta.id + ')' : 'download (missing id)')
            : ctaType;

          function addRow(label, value){
            var row=document.createElement('div');
            row.className='grid grid-cols-[120px_1fr] gap-2';
            var dt=document.createElement('dt');
            dt.className='text-[11px] font-medium text-gray-500';
            dt.textContent=label;
            var dd=document.createElement('dd');
            dd.className='text-[11px] text-gray-800';
            dd.textContent=value;
            row.appendChild(dt);
            row.appendChild(dd);
            body.appendChild(row);
          }

          var body=document.createElement('dl');
          body.className='mt-2 space-y-1';

          addRow('Title', spec.title || '(missing)');
          addRow('Slug', spec.slug || '(missing)');
          addRow('Tags', (tags.length ? tags.length + ' — ' + tags.join(', ') : 'None'));
          addRow('Sections', sections.length ? sections.length + ' sections' : 'None');
          addRow('Outline', outline.length ? outline.length + ' items' : 'None');
          addRow('Word count', totalWords + ' (~' + reading + ' min read)');
          addRow('Hero prompt', spec.heroImagePrompt ? 'Provided' : 'None');
          addRow('Alt texts', altTexts.length ? altTexts.length + ' provided' : 'None');
          addRow('Entities', entities.length ? entities.length + ' — ' + summarizeEntities(entities) : 'None');
          addRow('Internal links', internal.length ? internal.length + ' hints' : 'None');
          addRow('Affiliate hints', affiliates.length ? affiliates.length + ' entries' : 'None');
          addRow('Ads', placements.length ? placements.length + ' — ' + summarizePlacements(placements) : 'None');
          addRow('CTA', ctaDetail);

          panel.appendChild(body);
        }

        function updateHelp(selectId, helpId, options, fallback){
          var select = $(selectId);
          var help = $(helpId);
          if (!select || !help) return;
          function render(){
            var value = select.value;
            var match = options.find(function(opt){ return opt.key === value; });
            help.textContent = match ? match.description : fallback;
          }
          select.addEventListener('change', render);
          render();
        }

        updateHelp('mode', 'modeHelp', PRESET_OPTIONS, DEFAULT_MODE_DESC);
        updateHelp('style', 'styleHelp', STYLE_OPTIONS, DEFAULT_STYLE_DESC);

        setStatus('Ready for PostSpec JSON.');
        renderSpecSummary(null);

        $('genPrompt').addEventListener('click', async function(){
          try{
            busy(true); setStatus('Generating prompt...', null);
            var body = {
              topic: $('topic').value || 'tea ritual for focus',
              words: Number($('words').value || 1200),
              ads: $('ads').checked ? 'on' : 'off',
              kofi: $('kofi').checked ? 'on' : 'off'
            };
            var mode = $('mode').value;
            if (mode) body.mode = mode;
            var style = $('style').value || 'cozy';
            body.style = style;
            var res = await fetch(DEV_API + '/genprompt', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
            if(!res.ok) throw new Error('gen failed ('+res.status+')');
            var data = await res.json();
            if (!data.ok) throw new Error(data.error || 'gen failed');
            $('promptOut').value = data.prompt || '';
            setStatus('Prompt ready ✓', true);
          }catch(e){ setStatus('Prompt error: ' + (e.message||String(e)), false); }
          finally{ busy(false); }
        });

        $('copyPrompt').addEventListener('click', async function(){
          try{ await navigator.clipboard.writeText($('promptOut').value || ''); setStatus('Copied ✓', true); }
          catch { $('promptOut').select(); document.execCommand('copy'); setStatus('Copied ✓', true); }
        });

        // --- JSON paste sanitizer helpers ---
        function deBackslashOutsideStrings(s){
          var out='', inStr=false, esc=false;
          for (var i=0;i<s.length;i++){
            var ch=s[i];
            if (inStr){
              out+=ch;
              if (esc){ esc=false; }
              else if (ch==='\\'){ esc=true; }
              else if (ch==='"'){ inStr=false; }
            } else {
              if (ch === '"'){ inStr=true; out+=ch; }
              else if (ch === '\\'){
                var next=s[i+1];
                if (next==='[' || next===']' || next==='{' || next==='}'){ continue; }
                out+=ch;
              } else { out+=ch; }
            }
          }
          return out;
        }

        function stripCodeFences(s){
          return s
            .replace(/^\s*```(?:json)?\s*/i, '')
            .replace(/\s*```\s*$/, '');
        }

        function normalizeQuotes(s){
          return s
            .replace(/[\u201C\u201D]/g, '"')
            .replace(/[\u2018\u2019]/g, "'");
        }

        function stripInvisible(s){
          return s.replace(/[\uFEFF\u200B-\u200F\u202A-\u202E\u00A0\r]/g, '');
        }

        function normalizeSpec(spec){
          if (!spec || typeof spec !== 'object') return spec;

          if (typeof spec.specVersion === 'string') {
            var parsedVersion = Number(spec.specVersion);
            if (!Number.isNaN(parsedVersion)) spec.specVersion = parsedVersion;
          }

          if (typeof spec.title === 'string') spec.title = spec.title.trim();
          if (typeof spec.slug === 'string') spec.slug = spec.slug.trim();
          if (typeof spec.metaDescription === 'string') spec.metaDescription = spec.metaDescription.trim();
          if (typeof spec.excerpt === 'string') spec.excerpt = spec.excerpt.trim();

          if (!Array.isArray(spec.tags)) {
            if (typeof spec.tags === 'string') {
              spec.tags = spec.tags.split(/[\n,]/).map(function(tag){ return tag.trim(); }).filter(Boolean);
            } else {
              spec.tags = [];
            }
          } else {
            spec.tags = spec.tags.map(function(tag){ return String(tag || '').trim(); }).filter(Boolean);
          }
          var seenTags = new Set();
          spec.tags = spec.tags.filter(function(tag){
            var lower = tag.toLowerCase();
            if (seenTags.has(lower)) return false;
            seenTags.add(lower);
            return true;
          });

          if (!Array.isArray(spec.sections)) {
            spec.sections = [];
          } else {
            spec.sections = spec.sections.map(function(section){
              var heading = section && typeof section.heading === 'string'
                ? section.heading
                : (section && typeof section.title === 'string' ? section.title : '');
              var markdown = section && typeof section.markdown === 'string'
                ? section.markdown
                : (section && typeof section.content === 'string' ? section.content : '');
              var cleaned = {
                heading: heading.trim(),
                markdown: String(markdown || '').trim(),
              };
              if (section && typeof section === 'object') {
                for (var key in section) {
                  if (key === 'heading' || key === 'markdown') continue;
                  cleaned[key] = section[key];
                }
              }
              return cleaned;
            });
          }

          if (!Array.isArray(spec.internalLinkHints)) spec.internalLinkHints = [];
          if (!Array.isArray(spec.affiliateHints)) spec.affiliateHints = [];
          if (spec.heroImagePrompt === false) spec.heroImagePrompt = null;
          if (spec.heroImagePrompt != null && typeof spec.heroImagePrompt !== 'string') {
            spec.heroImagePrompt = String(spec.heroImagePrompt);
          }

          return spec;
        }

        function parseSpec(){
          var raw = document.getElementById('spec').value;
          if (!raw.trim()) throw new Error('No JSON provided.');

          var base = stripInvisible(normalizeQuotes(stripCodeFences(raw)));
          var attempts = [base];
          var cleanedBackslashes = deBackslashOutsideStrings(base);
          if (cleanedBackslashes !== base) attempts.push(cleanedBackslashes);

          function tryParse(value){
            try {
              return JSON.parse(value);
            } catch(_e) {
              try {
                var maybe = JSON.parse(value);
                if (typeof maybe === 'string') {
                  return JSON.parse(maybe);
                }
              } catch(_err){}
            }
            return null;
          }

          var parsed = null;
          for (var i=0;i<attempts.length && !parsed;i++){
            parsed = tryParse(attempts[i]);
          }

          if (!parsed) {
            throw new Error('Invalid JSON — cleaned for fences/quotes, but structure still fails. Save to a file and validate with jq.');
          }

          return normalizeSpec(parsed);
        }


        function checkSpec(s){
          var errors = [], warnings = [];
          var rawType = (s && typeof s.contentType === 'string') ? s.contentType.trim().toLowerCase() : '';
          var contentType = rawType || 'ritual';
          var variantsRequiredFor = new Set(['ritual']);
          var requiresVariants = variantsRequiredFor.has(contentType);
          var version = Number(s.specVersion);
          if (version !== 2) errors.push('specVersion must be 2');
          if (!s.title || !s.slug) errors.push('title and slug are required');
          if (!Array.isArray(s.sections) || s.sections.length === 0) errors.push('sections[] required');
          var tags = Array.isArray(s.tags) ? s.tags : [];
          if (tags.length < 4 || tags.length > 7) errors.push('tags must be 4–7');
          var mdLen = (s.metaDescription || '').length;
          if (mdLen < 150 || mdLen > 160) warnings.push('metaDescription length ~'+mdLen+' (target 150–160)');
          var heads = (s.sections||[]).map(function(x){ return String(x.heading||'').toLowerCase(); });
          var body = (s.sections||[]).map(function(x){ return x.markdown||''; }).join('\n').toLowerCase();
          var hasOpening = heads.some(function(h){ return h === 'opening reflection' || (h.startsWith('opening') && /reflection|scene|note/.test(h)); });
          if (!hasOpening) errors.push('Missing section: Opening Reflection');
          var hasQuick = heads.some(function(h){ return /quick|low[- ]?energy|5[- ]?minute/.test(h); }) || /quick|low[- ]?energy/.test(body);
          var hasDeep  = heads.some(function(h){ return /deep( dive)?|long(er)?/.test(h); }) || /deep( dive)?/.test(body);
          if (requiresVariants) {
            if (!(hasQuick && hasDeep)) errors.push('Ritual variants required: Quick/Low-Energy and Deep');
          } else {
            var hasEither = hasQuick || hasDeep;
            if (hasEither && !(hasQuick && hasDeep)) {
              warnings.push('Ritual variants detected but incomplete — Quick + Deep should appear together when included.');
            } else if (hasQuick && hasDeep) {
              warnings.push('Ritual variants present, but contentType "' + contentType + '" does not require them.');
            }
          }
          var hasChecklist = heads.some(function(h){ return /checklist|summary|at a glance/.test(h); });
          if (!hasChecklist) errors.push('Missing section: Checklist/Summary');
          var hasReflect = heads.some(function(h){ return /reflection prompt|journal|reflection/.test(h); }) || /prompt|question/.test(body);
          if (!hasReflect) errors.push('Missing section: Reflection Prompt');
          if (!(typeof s.heroImagePrompt === 'string' || s.heroImagePrompt === null)) errors.push('heroImagePrompt must be string or null');
          if (!Array.isArray(s.internalLinkHints) || s.internalLinkHints.length < 3) warnings.push('internalLinkHints are sparse (aim 5–8).');
          return { ok: errors.length===0, errors: errors, warnings: warnings };
        }

        $('validateBtn').addEventListener('click', function(){
          try{
            var s=parseSpec();
            var res = checkSpec(s);
            renderSpecSummary(s);
            if (!res.ok) throw new Error(res.errors[0]);
            setStatus('Valid ✓', true, res.warnings);
          }catch(e){ setStatus(e.message, false); }
        });

        function wordCount(md){
          var text = String(md||'')
            .replace(/```[\s\S]*?```/g,' ')
            .replace(/`[^`]*`/g,' ')
            .replace(/<[^>]+>/g,' ')
            .replace(/[\*_#>~\-]+/g,' ');
          var m = text.match(/\b[\p{L}\p{N}’']+\b/gu);
          return m ? m.length : 0;
        }
        function renderPreview(spec){
          var el = $('preview'); el.innerHTML = '';
          var h1 = document.createElement('h1'); h1.textContent = spec.title || '(untitled)'; el.appendChild(h1);
          if (Array.isArray(spec.tags)){ var p = document.createElement('p'); p.className='text-sm text-gray-600'; p.textContent='Tags: ' + spec.tags.join(', '); el.appendChild(p); }
          var totalWords = 0;
          for (var i=0;i<(spec.sections||[]).length;i++){
            var sec = spec.sections[i];
            var h2 = document.createElement('h2'); h2.textContent = sec.heading || 'Section'; el.appendChild(h2);
            var div = document.createElement('div');
            var safe = String(sec.markdown||'').trim().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
            div.innerHTML = safe;
            el.appendChild(div);
            totalWords += wordCount(sec.markdown||'');
          }
          var meta = document.createElement('p');
          meta.className='mt-4 text-xs text-gray-500';
          meta.textContent = '~' + totalWords + ' words • ~' + Math.max(1, Math.round(totalWords/200)) + ' min read';
          el.appendChild(meta);
        }

        $('previewBtn').addEventListener('click', function(){
          try{
            var s=parseSpec(); var res=checkSpec(s);
            renderSpecSummary(s);
            if(!res.ok) throw new Error(res.errors[0]);
            renderPreview(s);
            setStatus('Preview ✓', true, res.warnings);
          }catch(e){ setStatus(e.message, false); }
        });

        async function ingest(spec){
          var res = await fetch(DEV_API + '/ingest', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(spec) });
          var data;
          try { data = await res.json(); }
          catch { data = {}; }
          if (!res.ok) {
            throw new Error((data && data.error) || ('ingest failed (' + res.status + ')'));
          }
          if (!data || data.ok === false) {
            throw new Error((data && data.error) || 'ingest failed');
          }
          return data;
        }

        $('ingestBtn').addEventListener('click', async function(){
          try{
            busy(true); setStatus('Ingesting…', null);
            var spec = parseSpec();
            var res=checkSpec(spec);
            renderSpecSummary(spec);
            if(!res.ok) throw new Error(res.errors[0]);
            var data = await ingest(spec);
            var finalSpec = data.spec || spec;
            renderSpecSummary(finalSpec);
            var location = data.path || ('content/posts/' + (data.slug || finalSpec.slug || 'post') + '.md');
            var slug = data.slug || (finalSpec && finalSpec.slug) || '';
            var msg = (data.saved === false ? 'Ingested (dry run)' : 'Ingested ✓') + ' → ' + location + (slug ? ' • Preview: /post/' + slug : '');
            setStatus(msg, true, res.warnings, data.normalizationReport);
          }catch(e){ setStatus(e.message, false); }
          finally{ busy(false); }
        });

        $('ingestPublishBtn').addEventListener('click', async function(){
          try{
            busy(true); setStatus('Ingesting…', null);
            var spec = parseSpec();
            var res=checkSpec(spec);
            renderSpecSummary(spec);
            if(!res.ok) throw new Error(res.errors[0]);
            var data = await ingest(spec);
            var finalSpec = data.spec || spec;
            renderSpecSummary(finalSpec);
            setStatus('Ingested. Publishing…', true, res.warnings, data.normalizationReport);
            var r = await fetch(DEV_API + '/bundle', { method:'POST' });
            var b = await r.json();
            if (!b.ok) throw new Error((b.steps && b.steps.map(function(s){return s.err;}).filter(Boolean).join('\n')) || b.error || 'bundle failed');
            var slug = data.slug || (finalSpec && finalSpec.slug) || '';
            var publishMsg = 'Published ✓' + (slug ? ' • Open post: /post/' + slug : '');
            setStatus(publishMsg, true, res.warnings, data.normalizationReport);
          }catch(e){ setStatus(e.message, false); }
          finally{ busy(false); }
        });

        $('clearBtn').addEventListener('click', function(){
          $('spec').value=''; $('preview').innerHTML=''; renderSpecSummary(null); setStatus('Cleared. Ready for new JSON.', null);
        });
      })();
    </script>
  )}
</Base>
