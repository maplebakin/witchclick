---
import Base from "../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../utils/settings";

const settings = readSettings();
const site = getSiteOrigin(settings);
---
<Base
  title="Privacy Policy"
  description="How we handle your data."
  canon={site ? `${site}/privacy` : ""}
>
  <section class="glass-panel">
    <article class="prose max-w-none">
      <p class="eyebrow text-purple-400/90">Trust first</p>
      <h1>Privacy Policy</h1>
      <p><em>Last updated: {new Date().toISOString().slice(0, 10)}</em></p>
      <h2>What we collect</h2>
      <p>
        This site is mostly static. We may capture lightweight analytics such as page views and outbound clicks to understand
        what’s useful. We never sell personal data.
      </p>
      <h2>Cookies</h2>
      <p>
        If ads or analytics are enabled, third parties may set cookies solely to measure performance and attribution. You can
        disable cookies in your browser settings at any time.
      </p>
      <h2>Contact</h2>
      <p>
        For privacy questions, email <a href="mailto:streamthreadsystems@gmail.com">streamthreadsystems@gmail.com</a> and we’ll
        respond as soon as we can.
      </p>
    </article>
  </section>
</Base>
