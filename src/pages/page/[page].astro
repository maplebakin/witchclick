---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { loadAllPosts, filterPostsByCategory, POST_CATEGORY_RITUAL } from "../../utils/posts";
import { postToCardData } from "../../utils/postTransforms";
import { readSettings } from "../../utils/settings";
import { createCollectionPageSchema } from "../../utils/structuredData";
import HeadSlot from "@/components/HeadSlot.astro";

export const prerender = true;

export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const allPosts = loadAllPosts();
  // Only include ritual posts in pagination
  const ritualPosts = filterPostsByCategory(allPosts, POST_CATEGORY_RITUAL);
  const totalPages = Math.max(1, Math.ceil(ritualPosts.length / PAGE_SIZE));

  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    const start = (page - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    const pagePosts = ritualPosts.slice(start, end);
    return {
      params: { page: String(page) },
      props: { page, totalPages, pagePosts },
    };
  });
}

const { page, totalPages, pagePosts } = Astro.props as {
  page: number;
  totalPages: number;
  pagePosts: ReturnType<typeof loadAllPosts>;
};

const settings = readSettings();
const pageUrl = page > 1 ? `/page/${page}` : "/";

// Transform posts to card data
const cardPosts = pagePosts.map(postToCardData);

const pageItemList = createCollectionPageSchema(
  settings,
  {
    name: `Archive — Page ${page}`,
    url: pageUrl,
    description: `Latest rituals and guides — page ${page}`,
    itemType: "Article",
  },
  cardPosts.map((card) => ({
    name: card.title,
    url: `/post/${card.slug}`,
    description: card.tldr ?? card.excerpt,
  })),
);
---
<Base title={`WitchClick — Page ${page}`}>
  <HeadSlot slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageItemList)} />
  </HeadSlot>

  <section class="archive-section wc-section-shell">
    <h1 class="archive-title">Latest posts — page {page}</h1>
    <div class="archive-grid">
      {cardPosts.map((card) => (
        <PostCard
          href={`/post/${card.slug}`}
          post={{
            slug: card.slug,
            title: card.title,
            excerpt: card.excerpt,
            tldr: card.tldr,
            tags: card.tags,
            readingMinutes: card.readingMinutes,
            publishedAt: card.publishedAt,
            spoonLevel: card.spoonLevel,
            spoons: card.spoons,
            heroImage: card.heroImage,
            heroImageSrc: card.heroImageSrc,
            heroImageAlt: card.heroImageAlt,
            heroAlt: card.heroAlt,
            category: card.category,
          }}
        />
      ))}
    </div>

    <Pagination page={page} totalPages={totalPages} baseHref="/page" />
  </section>
</Base>

<style>
  .archive-section {
    width: min(100%, 72rem);
    margin-inline: auto;
    display: grid;
    gap: clamp(2rem, 5vw, 2.75rem);
  }

  .archive-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 5vw, 2.85rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--section-heading, rgba(67, 33, 122, 0.96)) 92%, black 8%);
  }

  .archive-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  @media (min-width: 640px) {
    .archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .archive-section :global(nav[aria-label="Pagination"]) {
    margin-top: clamp(2.25rem, 5vw, 3rem);
  }
</style>
