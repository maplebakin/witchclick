---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { loadAllPosts, paginatePosts, estimateReadingMinutes, firstParagraph } from "../../utils/posts";

export const prerender = true;

export async function getStaticPaths() {
  const PAGE_SIZE = 12;
  const posts = loadAllPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));

  return Array.from({ length: totalPages }, (_, i) => {
    const page = i + 1;
    const { items } = paginatePosts(page, PAGE_SIZE);
    return {
      params: { page: String(page) },
      props: { page, totalPages, pagePosts: items },
    };
  });
}

const { page, totalPages, pagePosts } = Astro.props as {
  page: number;
  totalPages: number;
  pagePosts: ReturnType<typeof loadAllPosts>;
};

function toCard(post) {
  const fm = post.data ?? {};
  return {
    slug: post.slug,
    title: fm.title ?? post.title,
    excerpt: fm.excerpt ?? fm.description ?? fm.metaDescription ?? firstParagraph(post.content),
    tags: Array.isArray(fm.tags) ? fm.tags : [],
    readingMinutes: fm.readingMinutes ?? estimateReadingMinutes(post.content),
    publishedAt: fm.publishedAt ?? fm.pubDate ?? fm.date ?? undefined,
  };
}
---
<Base title={`WitchClick — Page ${page}`}>
  <section class="glass-panel">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <p class="eyebrow text-purple-400/90">Archive</p>
        <h1 class="mt-2 text-3xl font-semibold text-purple-900">Latest posts — page {page}</h1>
      </div>
      <p class="text-sm text-purple-700/80">Page {page} of {totalPages}</p>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {pagePosts.map((post) => {
        const card = toCard(post);
        return (
          <PostCard
            post={{
              slug: card.slug,
              title: card.title,
              excerpt: card.excerpt,
              tags: card.tags,
              readingMinutes: card.readingMinutes,
              publishedAt: card.publishedAt,
            }}
            href={`/post/${card.slug}`}
          />
        );
      })}
    </div>
  </section>

  <Pagination page={page} totalPages={totalPages} baseHref="/page" />
</Base>
