---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import { readSettings } from "@/utils/settings";
import { canonicalTagHref } from "@/utils/tags";

const title = "Start Here — Your Guide to WitchClick";
const description = "New to WitchClick? Start here. Discover secular rituals, ADHD-friendly practices, and cozy tools for everyday magic without dogma.";

const settings = readSettings();
const tagLinks = {
  secularTarot: canonicalTagHref("secular tarot"),
  ritual: canonicalTagHref("ritual"),
  adhdFriendly: canonicalTagHref("adhd-friendly"),
  gentleRituals: canonicalTagHref("gentle rituals"),
  ethicalCursing: canonicalTagHref("cursing ritual"),
};
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Start Here" },
];

// Simple WebPage structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": `${settings.siteUrl}/start`,
};
---

<Base {title} description={description}>
  <HeadSlot slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </HeadSlot>

  <div class="wc-section-shell">
    <article class="start-page-container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="start-page-header">
        <p class="start-page-label">
          Welcome
        </p>
        <h1 class="start-page-title">
          Start Here: Your Guide to WitchClick
        </h1>
        <p class="start-page-intro">
          Cozy, secular rituals and tools for everyday magic. No dogma, no gatekeeping, just practical prompts that meet you where you are.
        </p>
      </header>

      <div class="prose prose-lg dark:prose-invert max-w-none">
      <section class="mb-12">
        <h2>What is WitchClick?</h2>
        <p>
          WitchClick is a collection of <strong>secular rituals, tarot spreads, and gentle practices</strong> designed for
          modern, neurodivergent, and skeptically-curious folks. We believe ritual can be meaningful without requiring
          supernatural beliefs—it's about creating intentional space, processing emotions, and building sustainable habits.
        </p>
        <p>
          Whether you're ADHD-friendly seeking low-spoons options, a recovering ex-religious person looking for meaning without
          dogma, or just someone who wants cozy structure in your life—you're in the right place.
        </p>
      </section>

      <section class="mb-12 bg-surface-soft dark:bg-surface-inverse-muted p-6 rounded-lg">
        <h2 class="mt-0">Three Ways to Begin</h2>
        <p>We organize our content around three core needs:</p>

        <div class="grid md:grid-cols-3 gap-6 not-prose my-8">
          <a href="/hub/calm" class="block p-6 bg-surface-card dark:bg-surface-inverse-soft rounded-lg shadow-sm hover:shadow-md transition-shadow border-l-4 border-line-accent">
            <h3 class="text-xl font-bold mb-2 text-accent dark:text-info-soft">Calm</h3>
            <p class="text-sm text-body dark:text-inverse-soft">
              Grounding rituals, breathwork, and nervous system resets for when everything feels too much.
            </p>
          </a>

          <a href="/hub/focus" class="block p-6 bg-surface-card dark:bg-surface-inverse-soft rounded-lg shadow-sm hover:shadow-md transition-shadow border-l-4 border-info">
            <h3 class="text-xl font-bold mb-2 text-info dark:text-info-soft">Focus</h3>
            <p class="text-sm text-body dark:text-inverse-soft">
              ADHD-friendly rituals, tea ceremonies, and gentle accountability for sustainable attention.
            </p>
          </a>

          <a href="/hub/release" class="block p-6 bg-surface-card dark:bg-surface-inverse-soft rounded-lg shadow-sm hover:shadow-md transition-shadow border-l-4 border-orange-500">
            <h3 class="text-xl font-bold mb-2 text-orange-600 dark:text-orange-400">Release</h3>
            <p class="text-sm text-body dark:text-inverse-soft">
              Cord-cutting, boundary work, and ethical "cursing" rituals for letting go with softness.
            </p>
          </a>
        </div>
      </section>

      <section class="mb-12">
        <h2>Start with These Popular Posts</h2>
        <ul>
          <li>
            <a href="/post/tarot-as-a-secular-tool">Tarot as a Secular Tool</a> — Pattern-reading for everyday
            decisions, no mysticism required
          </li>
          <li>
            <a href="/post/when-everything-feels-pointless">When Everything Feels Pointless</a> — Gentle rituals to
            re-enter meaning when the fog rolls in
          </li>
          <li>
            <a href="/post/calming-strategies-when-partner-pisses-you-off">When Your Partner Pisses You Off</a> —
            Calm-first strategies that keep love in the room
          </li>
          <li>
            <a href="/post/secular-tarot-spread-for-a-sign">Secular Tarot Spread for Seeking a Sign</a> — Notice
            patterns, name options, choose a testable next step
          </li>
          <li>
            <a href="/post/anxiety-from-avoiding-responsibilities-gentle-rituals">When Avoiding Makes You Anxious</a> —
            Tiny, kind moves to re-enter your day without bullying yourself
          </li>
        </ul>
      </section>

      <section class="mb-12">
        <h2>Our Approach: What Makes WitchClick Different</h2>

        <h3>Secular & Science-Adjacent</h3>
        <p>
          We treat tarot as pattern recognition, rituals as embodied mindfulness, and "magic" as intentional
          action. No supernatural claims, just tools that work regardless of what you believe about them.
        </p>

        <h3>Neurodivergent-Friendly</h3>
        <p>
          Every ritual comes in <strong>two versions</strong>: a 5-minute low-spoons path and a deeper
          option for when you have more capacity. We honor energy fluctuation as normal.
        </p>

        <h3>Ethics-First</h3>
        <p>
          Our "cursing" rituals focus on energetic accountability—returning harm to its origin,
          setting boundaries, naming truth—not revenge or manipulation. We believe in clean magic.
        </p>

        <h3>No Gatekeeping</h3>
        <p>
          You don't need special tools, training, or lineage. A deck of playing cards can be a tarot deck.
          A kitchen candle can anchor a ritual. Your journal is your grimoire. Start where you are.
        </p>
      </section>

      <section class="mb-12">
        <h2>Explore by Interest</h2>
        <ul>
          <li><a href={tagLinks.secularTarot}>Secular Tarot</a> — Pattern-reading, spreads, and reflection prompts</li>
          <li><a href={tagLinks.ritual}>Rituals</a> — Grounding, releasing, focusing, and transitioning</li>
          <li><a href={tagLinks.adhdFriendly}>ADHD-Friendly</a> — Low-spoons options and neurodivergent support</li>
          <li><a href={tagLinks.gentleRituals}>Gentle Rituals</a> — When you need softness, not intensity</li>
          <li><a href={tagLinks.ethicalCursing}>Ethical Cursing</a> — Boundary work and energetic accountability</li>
          <li><a href="/entities/ritual">Ritual Library</a> — Browse all our structured practices</li>
          <li><a href="/entities/tarot">Tarot Card Reference</a> — Secular interpretations for every card</li>
        </ul>
      </section>

      <section class="mb-12 bg-info-faint dark:bg-surface-inverse-muted p-6 rounded-lg">
        <h2 class="mt-0">Looking for Something Specific?</h2>
        <ul class="mb-4">
          <li><strong>Job interview anxiety?</strong> Try the <a href="/post/pre-interview-grounding-ritual">Pre-Interview Grounding Ritual</a></li>
          <li><strong>First day at new job?</strong> Check out <a href="/post/first-day-new-job-secular-tarot-spread-journal">First-Day Tarot Spread</a></li>
          <li><strong>Relationship conflict?</strong> Start with <a href="/post/calming-strategies-when-partner-pisses-you-off">Calm-First Conflict Strategies</a></li>
          <li><strong>Feeling burnt out?</strong> Read <a href="/post/when-to-let-yourself-rest">When to Let Yourself Rest</a></li>
          <li><strong>Need to make a decision?</strong> Use <a href="/post/using-different-perspectives-a-gentle-practical-guide">Different Perspectives Guide</a></li>
          <li><strong>Creative block?</strong> Try <a href="/post/creativity-tarot-ritual">Creativity Tarot Ritual</a></li>
        </ul>
      </section>

      <section class="mb-12">
        <h2>Tools & Resources</h2>
        <ul>
          <li><a href="/lab">The Lab</a> — Experimental rituals and printable downloads</li>
          <li><a href="/curses">White Magic Curses</a> — Ethical boundary-setting rituals</li>
          <li><a href="/tools">Recommended Tools</a> — Curated affiliate links for decks, journals, and ritual supplies</li>
          <li><a href="/partners">Partners</a> — Small businesses and ethical brands we love</li>
        </ul>
      </section>

      <section class="mb-12">
        <h2>Stay Connected</h2>
        <p>
          Get gentle emails twice a month with new rituals, printable drops, and secular tarot spreads.
          No spam, just cozy prompts.
        </p>
        <p>
          <a href="https://witchclick.substack.com/api/v1/free" class="inline-block px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-lg transition-colors">
            Sign up for the WitchClick dispatch
          </a>
        </p>
      </section>

      <section>
        <h2>Questions?</h2>
        <p>
          Check out our <a href="/about">About page</a> to learn more about the humans behind WitchClick,
          or <a href="/contact">get in touch</a> if you have questions, feedback, or collaboration ideas.
        </p>
        <p class="text-sm text-body-subtle dark:text-inverse-muted mt-8">
          <strong>A note on affiliate links:</strong> Some links on this site are affiliate links, which means we may
          earn a small commission at no extra cost to you. We only recommend tools we genuinely use and love.
          <a href="/privacy">Learn more</a>.
        </p>
      </section>
      </div>
    </article>
  </div>
</Base>

<style>
  .start-page-container {
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2rem);
  }

  .start-page-header {
    margin-top: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  .start-page-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-accent, #ea580c);
    margin-bottom: 0.5rem;
  }

  .start-page-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text-strong, #111827);
  }

  .start-page-intro {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-body, #4b5563);
  }
</style>
