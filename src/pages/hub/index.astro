---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PrimaryButton from "@/components/buttons/PrimaryButton.astro";
import PostCard from "@/components/PostCard.astro";
import fs from "node:fs";
import path from "node:path";
import { createCollectionPageSchema } from "@/utils/structuredData";
import { readSettings } from "@/utils/settings";
import { getPostBySlug, extractHeroImage, getPostCategory } from "@/utils/posts";
import { HUB_DEFINITIONS } from "@/data/hubs";
import HeadSlot from "@/components/HeadSlot.astro";
import { serializeJsonForScript } from "@/utils/serializeJson";

const HUBS = [
  {
    slug: "release",
    title: "Release",
    description: "Threshold rituals, prompts, and supports for naming what is complete and choosing what no longer gets to measure you.",
    introSlug: "cozy-cursing-ritual-release-anger-banishment",
    accent: "var(--theme-warning, var(--theme-color-gold))",
    moods: ["angry", "overwhelmed", "stuck"],
  },
  {
    slug: "focus",
    title: "Focus",
    description: "Attention rituals, tarot spreads, and small structures for returning to what matters without turning yourself into a machine.",
    introSlug: "focus-tea-rituals-gentle-brains",
    accent: "var(--theme-info, var(--theme-color-iris))",
    moods: ["scattered", "distracted", "restless"],
  },
  {
    slug: "calm",
    title: "Calm",
    description: "Grounding practices, repair scripts, and reflective anchors for staying present when the world keeps asking too much.",
    introSlug: "calm-space-during-political-unrest-2",
    accent: "var(--theme-success, var(--theme-color-amethyst))",
    moods: ["anxious", "overstimulated", "raw"],
  },
] as const;

type HubConfig = (typeof HUBS)[number];

const publicDir = path.join(process.cwd(), "public");

function resolveHubImage(source: string | undefined): string | undefined {
  if (!source) return undefined;
  const trimmed = source.trim();
  if (!trimmed) return undefined;
  if (/^https?:\/\//i.test(trimmed)) return trimmed;
  if (!trimmed.startsWith("/")) return trimmed;
  const publicPath = path.join(publicDir, trimmed.replace(/^\/+/, ""));
  return fs.existsSync(publicPath) ? trimmed : undefined;
}

function resolveIntro(hub: HubConfig) {
  const post = getPostBySlug(hub.introSlug);
  if (!post) return null;
  const hero = extractHeroImage(post.data ?? {});
  const heroSrc = resolveHubImage(typeof hero.src === "string" && hero.src.trim() ? hero.src.trim() : undefined);
  const heroAlt = typeof hero.alt === "string" && hero.alt.trim() ? hero.alt.trim() : undefined;
  return {
    slug: post.slug,
    title: post.title,
    excerpt: post.data?.excerpt ?? post.data?.metaDescription ?? "",
    tldr: typeof post.tldr === "string" ? post.tldr : post.data?.tldr,
    tags: post.data?.tags ?? [],
    readingMinutes: post.data?.readingMinutes,
    publishedAt: post.data?.publishedAt ?? post.data?.pubDate ?? post.data?.date,
    spoons:
      typeof post.spoons === "string"
        ? post.spoons
        : typeof post.data?.spoons === "string"
          ? post.data.spoons
          : undefined,
    heroImage: heroSrc,
    heroImageSrc: heroSrc,
    heroImageAlt: heroAlt,
    heroAlt: heroAlt,
    category: getPostCategory(post),
  };
}

function countLiveHubPosts(hubSlug: string): number {
  const definition = HUB_DEFINITIONS[hubSlug];
  if (!definition) return 0;

  const live = new Set<string>();

  for (const playlist of definition.playlists) {
    for (const slug of playlist.posts) {
      if (getPostBySlug(slug)) {
        live.add(slug);
      }
    }
  }

  return live.size;
}

const hubCards = HUBS.map((hub) => ({
  ...hub,
  intro: resolveIntro(hub),
  livePostCount: countLiveHubPosts(hub.slug),
}));

const featuredHub = [...hubCards].sort((a, b) => b.livePostCount - a.livePostCount)[0] ?? null;

const settings = readSettings();
const collectionItems = hubCards.map((hub) => ({
  name: `${hub.title} Rituals & Spreads`,
  url: `/hub/${hub.slug}`,
  description: hub.description,
}));

const jsonLd = createCollectionPageSchema(
  settings,
  {
    name: "WitchClick Rituals & Spreads",
    url: "/hub",
    description: "Pathways into release, focus, and grounding rituals, tarot spreads, and symbolic workings.",
  },
  collectionItems,
);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Rituals & Spreads" },
];
---

<Base
  title="Rituals & Spreads — Ground, Focus, Release"
  description="Enter through Ground, Focus, or Release. Each WitchClick path gathers rituals, tarot spreads, and symbolic workings for choosing a lens."
  ambientColor="var(--theme-color-amethyst)"
>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <HeadSlot slot="head">
    <script type="application/ld+json" is:inline set:html={serializeJsonForScript(jsonLd)} />
  </HeadSlot>

  <header data-reveal class="page-header">
    <p class="page-header__eyebrow">Rituals & spreads</p>
    <h1 class="page-header__title">How are you feeling right now?</h1>
    <p class="page-header__lead">
      Start by need, then step into a working. These paths gather rituals, tarot spreads, and symbolic supports around
      grounding, attention, and threshold work.
    </p>
  </header>

  {featuredHub && (
    <section data-reveal class="hub-featured" aria-labelledby="featured-hub-title">
      <p class="hub-featured__eyebrow">Featured path</p>
        <div class="hub-featured__content">
          <div class="hub-featured__copy">
            <h2 id="featured-hub-title" class="hub-featured__title">{featuredHub.title}</h2>
            <p class="hub-featured__lead">{featuredHub.description}</p>
            <p class="hub-featured__meta">{featuredHub.livePostCount} live practices available</p>
        </div>
        <PrimaryButton href={`/hub/${featuredHub.slug}`} iconAfter="↗">
          Explore {featuredHub.title}
        </PrimaryButton>
      </div>
    </section>
  )}

  <section data-reveal class="hub-index-grid">
    <div class="hub-index-grid__inner">
      {hubCards.map((hub) => (
        <article class="card-panel card-tier-2 card-panel-soft hub-card" style={`--hub-accent: ${hub.accent}`}>
          <div class="hub-card__header">
            <p class="hub-card__eyebrow">{hub.title} path</p>
            <h2 class="hub-card__title">{hub.title}</h2>
            <div class="hub-card__moods" aria-label={`${hub.title} mood cues`}>
              {hub.moods.map((mood) => (
                <span class="card-pill hub-card__mood">{mood}</span>
              ))}
            </div>
            <p class="hub-card__description">{hub.description}</p>
          </div>
          <div class="hub-card__actions">
            <PrimaryButton href={`/hub/${hub.slug}`} iconAfter="↗">
              Explore
            </PrimaryButton>
            {hub.intro && (
              <PostCard
                class="hub-card__post"
                href={`/post/${hub.intro.slug}`}
                post={{
                  slug: hub.intro.slug,
                  title: hub.intro.title,
                  excerpt: hub.intro.excerpt,
                  tldr: hub.intro.tldr,
                  tags: hub.intro.tags,
                  readingMinutes: hub.intro.readingMinutes,
                  publishedAt: hub.intro.publishedAt,
                  spoons: hub.intro.spoons,
                  heroImage: hub.intro.heroImage,
                  heroImageSrc: hub.intro.heroImageSrc,
                  heroImageAlt: hub.intro.heroImageAlt,
                  heroAlt: hub.intro.heroAlt,
                  category: hub.intro.category,
                }}
              />
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

</Base>

<style>
  .page-header {
    margin-inline: auto;
    margin-bottom: var(--page-header-gap);
    text-align: center;
  }

  .hub-index-grid {
    margin: 0 auto;
  }

  .hub-featured {
    margin: 0 auto var(--page-section-gap);
    padding: var(--page-header-gap);
    border-radius: var(--card-radius);
    border: 1px solid color-mix(in srgb, var(--theme-border-strong) 65%, transparent 35%);
    border-left: 3px solid var(--theme-color-gold);
    background:
      linear-gradient(
        130deg,
        color-mix(in srgb, var(--theme-surface-panel) 88%, transparent 12%),
        color-mix(in srgb, var(--theme-surface-card) 82%, transparent 18%)
      );
    box-shadow: var(--theme-shadow-strong);
  }

  .hub-featured__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--theme-text-accent, var(--theme-color-gold)) 82%, var(--theme-text-strong) 18%);
  }

  .hub-featured__content {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
    align-items: end;
  }

  .hub-featured__copy {
    display: grid;
    gap: 0.5rem;
  }

  .hub-featured__title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    color: var(--theme-text-strong);
  }

  .hub-featured__lead {
    margin: 0;
    max-width: var(--content-max-width);
    color: var(--theme-text-body);
    line-height: 1.7;
  }

  .hub-featured__meta {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--theme-color-gold) 72%, var(--theme-text-strong) 28%);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hub-index-grid__inner {
    display: grid;
    gap: var(--grid-gap);
  }

  .hub-card {
    --card-hover-translate: -0.35rem;
    --card-elevation-base: var(--elevation-tier-2);
    --card-elevation-hover: var(--elevation-tier-3);
    position: relative;
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border: 1px solid var(--theme-border-subtle);
    background: var(--theme-background);
    box-shadow: var(--theme-shadow-strong);
  }

  .hub-card:hover,
  .hub-card:focus-visible {
    border-color: var(--theme-border-strong);
    transform: translateY(var(--card-hover-translate));
  }

  .hub-card__header {
    display: grid;
    gap: 0.5rem;
  }

  .hub-card__moods {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.1rem 0 0.15rem;
  }

  .hub-card__mood {
    border-color: color-mix(in srgb, var(--hub-accent, var(--theme-color-gold)) 20%, var(--theme-border-subtle) 80%);
    background: color-mix(in srgb, var(--theme-surface-panel) 88%, transparent 12%);
    color: color-mix(in srgb, var(--theme-text-body) 92%, transparent 8%);
    text-transform: none;
    letter-spacing: 0.01em;
  }

  .hub-card__eyebrow {
    margin: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: color-mix(in srgb, var(--hub-accent, var(--theme-color-amethyst)) 65%, var(--theme-ink-strong, currentColor) 35%);
  }

  .hub-card__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.3rem);
    color: var(--theme-text-strong);
  }

  .hub-card__description {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--theme-text-body);
  }

  .hub-card__actions {
    display: grid;
    gap: 1.25rem;
  }

  :global(.hub-card__actions .wc-button) {
    justify-self: start;
    --btn-bg: color-mix(in srgb, var(--hub-accent, var(--theme-text-accent)) 60%, var(--theme-color-night) 40%);
    --btn-bg-hover: color-mix(in srgb, var(--hub-accent, var(--theme-text-accent)) 68%, var(--theme-color-night) 32%);
    --btn-border: color-mix(in srgb, var(--hub-accent, var(--theme-text-accent)) 45%, transparent 55%);
  }

  :global(.hub-card__post) {
    display: block;
  }

  @media (min-width: 768px) {
    .hub-featured__content {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hub-index-grid__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .hub-index-grid__inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
