---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PostCard from "@/components/PostCard.astro";
import PartnerProductCard from "@/components/PartnerProductCard.astro";
import { createCollectionPageSchema } from "@/utils/structuredData";
import { readSettings } from "@/utils/settings";
import { getPostBySlug, extractHeroImage } from "@/utils/posts";
import { readPartnerBlocks } from "@/utils/partners";
import { readEditorialCalendar } from "@/utils/editorialCalendar";
import HeadSlot from "@/components/HeadSlot.astro";
import { HUB_DEFINITIONS } from "@/data/hubs";

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(HUB_DEFINITIONS).map((slug) => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug as string;
const hub = HUB_DEFINITIONS[slug];

if (!hub) {
  throw new Error(`Unknown hub: ${slug}`);
}

const partnerBlocks = readPartnerBlocks();
const partnerHighlight = hub.partnerHighlight
  ? partnerBlocks.affiliateHighlights.find((item) => item.slug === hub.partnerHighlight?.slug)
  : null;

type HubPost = NonNullable<ReturnType<typeof getPostBySlug>>;

const sections = hub.sections.map((section) => {
  const posts: HubPost[] = section.posts
    .map((postSlug) => getPostBySlug(postSlug))
    .filter((post): post is HubPost => Boolean(post));

  return { ...section, posts };
});

const uniquePosts = new Map<string, HubPost>();
for (const section of sections) {
  for (const post of section.posts) {
    if (!post) continue;
    if (!uniquePosts.has(post.slug)) {
      uniquePosts.set(post.slug, post);
    }
  }
}

const settings = readSettings();
const collectionItems = Array.from(uniquePosts.values()).map((post) => ({
  name: post.title,
  url: `/post/${post.slug}`,
  description: post.data?.excerpt ?? post.data?.metaDescription ?? "",
}));

const jsonLd = createCollectionPageSchema(
  settings,
  {
    name: `${hub.hero.title} — WitchClick`,
    url: `/hub/${hub.slug}`,
    description: hub.seoDescription,
    collectionType: "CollectionPage",
  },
  collectionItems,
);

const calendar = readEditorialCalendar();
const season = hub.seasonSlug ? calendar.seasons.find((entry) => entry.slug === hub.seasonSlug) ?? null : null;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Hubs", href: "/hub/" },
  { label: hub.hero.title },
];
---

<Base
  title={`${hub.hero.title} — WitchClick`}
  description={hub.seoDescription}
  ambientColor={hub.ambient}
>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <HeadSlot slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </HeadSlot>

  <section class="hub-hero">
    <div class="hub-hero__inner">
      <p class="hub-hero__eyebrow">{hub.hero.eyebrow}</p>
      <h1 class="hub-hero__title">{hub.hero.title}</h1>
      <p class="hub-hero__lead">{hub.hero.lead}</p>
    </div>
  </section>

  {sections.map((section) => (
    <section class="hub-section">
      <header class="hub-section__header">
        <h2>{section.title}</h2>
        <p>{section.description}</p>
      </header>
      <div class="hub-section__grid">
        {section.posts.map((post) => {
          const hero = extractHeroImage(post.data ?? {});
          return (
            <PostCard
              post={{
                slug: post.slug,
                title: post.title,
                excerpt: post.data?.excerpt ?? post.data?.metaDescription ?? "",
                tldr: typeof post.tldr === "string" ? post.tldr : post.data?.tldr,
                tags: post.data?.tags ?? [],
                readingMinutes: post.data?.readingMinutes,
                publishedAt: post.data?.publishedAt ?? post.data?.pubDate ?? post.data?.date,
                spoonLevel: post.data?.spoonLevel,
                spoons:
                  typeof post.spoons === "string"
                    ? post.spoons
                    : typeof post.data?.spoons === "string"
                      ? post.data.spoons
                      : undefined,
                heroImage: hero?.src,
                heroImageSrc: hero?.src,
                heroImageAlt: hero?.alt,
                heroAlt: hero?.alt,
              }}
            />
          );
        })}
      </div>
    </section>
  ))}

  {partnerHighlight && hub.partnerHighlight && (
    <section class="hub-partner">
      <div class="hub-partner__inner">
        <div class="hub-partner__content">
          <h2>Partner spotlight</h2>
          <p>{hub.partnerHighlight.blurb}</p>
          <p class="hub-partner__cta">
            Explore more community collaborations in our <a href="/partners/">Partners directory</a>.
          </p>
        </div>
        <PartnerProductCard product={partnerHighlight} />
      </div>
    </section>
  )}

  {season && (
    <section class="hub-season">
      <div class="hub-season__inner">
        <h2>{season.season}: {season.theme}</h2>
        <p class="hub-season__focus">{season.focus}</p>
        <div class="hub-season__grid">
          <div class="hub-season__panel">
            <h3>Anchor posts</h3>
            <ul>
              {season.anchorPosts.map((anchor) => (
                <li>
                  <a href={`/post/${anchor.slug}`}>{anchor.title}</a>
                </li>
              ))}
            </ul>
          </div>
          <div class="hub-season__panel">
            <h3>Upcoming rituals</h3>
            <ul>
              {season.rituals.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          {season.notes && (
            <div class="hub-season__panel hub-season__panel--notes">
              <h3>Editorial note</h3>
              <p>{season.notes}</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hub-hero {
    margin: clamp(2rem, 6vw, 3.75rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: 3rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--ambient-color, #7c3aed) 20%, transparent 80%), transparent),
      linear-gradient(135deg, rgba(255, 252, 247, 0.95), rgba(229, 231, 235, 0.92));
    color: color-mix(in srgb, var(--ink-body, #1f1a2b) 92%, white 8%);
  }

  .hub-hero__inner {
    max-width: 52rem;
    display: grid;
    gap: 0.8rem;
  }

  .hub-hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--ambient-color, #7c3aed) 68%, var(--ink-strong, currentColor) 32%);
  }

  .hub-hero__title {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3rem);
  }

  .hub-hero__lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 78%, white 22%);
  }

  .hub-section {
    margin: clamp(2rem, 6vw, 3.5rem) auto;
    display: grid;
    gap: 1.75rem;
  }

  .hub-section__header {
    display: grid;
    gap: 0.5rem;
    max-width: 48rem;
  }

  .hub-section__header h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    color: color-mix(in srgb, var(--ink-strong, currentColor) 88%, white 12%);
  }

  .hub-section__header p {
    margin: 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 78%, white 22%);
  }

  .hub-section__grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.6rem);
  }

  .hub-partner {
    margin: clamp(2rem, 6vw, 4rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: 3rem;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--ambient-color, #7c3aed) 24%, transparent 76%), transparent),
      linear-gradient(
        140deg,
        color-mix(in srgb, var(--color-night, #120725) 62%, var(--color-dusk, #271534) 38%),
        color-mix(in srgb, var(--color-night, #120725) 48%, var(--color-ink, #f4f1ff) 52%)
      );
    border: 1px solid color-mix(in srgb, var(--ambient-color, #7c3aed) 28%, var(--color-ink, #f4f1ff) 72%);
    box-shadow: 0 24px 40px rgba(12, 5, 23, 0.45);
  }

  .hub-partner__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hub-partner__content {
    display: grid;
    gap: 0.75rem;
    max-width: 38rem;
  }

  .hub-partner__content h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
  }

  .hub-partner__content p {
    margin: 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--ink-body, currentColor) 85%, white 15%);
  }

  .hub-partner__cta {
    font-size: 0.95rem;
  }

  .hub-partner__cta a {
    font-weight: 600;
    color: color-mix(in srgb, var(--ambient-color, #7c3aed) 70%, var(--ink-strong, currentColor) 30%);
  }

  .hub-season {
    margin: clamp(2rem, 6vw, 4rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: 3rem;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--ambient-color, #7c3aed) 18%, transparent 82%), transparent),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-night, #120725) 58%, var(--color-dusk, #271534) 42%),
        color-mix(in srgb, var(--color-night, #120725) 46%, var(--color-ink, #f4f1ff) 54%)
      );
    border: 1px solid color-mix(in srgb, var(--ambient-color, #7c3aed) 24%, var(--color-ink, #f4f1ff) 76%);
    box-shadow: 0 24px 40px rgba(12, 5, 23, 0.45);
  }

  .hub-season__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hub-season__focus {
    margin: 0;
    max-width: 48rem;
    font-size: 1.05rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 76%, white 24%);
  }

  .hub-season__grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .hub-season__panel {
    padding: clamp(1.25rem, 3vw, 1.85rem);
    border-radius: 1.75rem;
    background: color-mix(in srgb, var(--color-rune, #f8f3ff) 68%, var(--color-night, #120725) 32%);
    border: 1px solid color-mix(in srgb, var(--ambient-color, #7c3aed) 26%, var(--color-ink, #f4f1ff) 74%);
    box-shadow: 0 18px 28px rgba(12, 5, 23, 0.45);
  }

  .hub-season__panel h3 {
    margin: 0 0 0.65rem 0;
  }

  .hub-season__panel ul {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.45rem;
  }

  .hub-season__panel--notes {
    background: color-mix(in srgb, var(--ambient-color, #7c3aed) 48%, var(--color-rune, #f8f3ff) 52%);
    border-color: color-mix(in srgb, var(--ambient-color, #7c3aed) 42%, var(--color-ink, #f4f1ff) 58%);
  }

  @media (min-width: 768px) {
    .hub-section__grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .hub-partner__inner {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      align-items: center;
    }

    .hub-season__grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
</style>
