---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import HubPlaylistRow from "@/components/HubPlaylistRow.astro";
import PartnerProductCard from "@/components/PartnerProductCard.astro";
import { createCollectionPageSchema } from "@/utils/structuredData";
import { readSettings } from "@/utils/settings";
import { getPostBySlug, extractTagChips } from "@/utils/posts";
import { readPartnerBlocks } from "@/utils/partners";
import { readEditorialCalendar } from "@/utils/editorialCalendar";
import HeadSlot from "@/components/HeadSlot.astro";
import { HUB_DEFINITIONS } from "@/data/hubs";

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(HUB_DEFINITIONS).map((slug) => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug as string;
const hub = HUB_DEFINITIONS[slug];

if (!hub) {
  throw new Error(`Unknown hub: ${slug}`);
}

const partnerBlocks = readPartnerBlocks();
const partnerHighlight = hub.partnerHighlight
  ? partnerBlocks.affiliateHighlights.find((item) => item.slug === hub.partnerHighlight?.slug)
  : null;

type HubPost = NonNullable<ReturnType<typeof getPostBySlug>>;

const playlists = hub.playlists.map((playlist) => {
  const resolvedPosts = playlist.posts.map((postSlug) => ({
    postSlug,
    post: getPostBySlug(postSlug),
  }));

  const items = resolvedPosts
    .filter((entry): entry is { postSlug: string; post: HubPost } => Boolean(entry.post))
    .map((post) => {
      const data = post.post.data ?? {};

      return {
        slug: post.post.slug,
        title: post.post.title,
        href: `/post/${post.post.slug}`,
        excerpt: data.excerpt ?? data.metaDescription ?? post.post.tldr ?? "",
        chips: extractTagChips(data, 3),
      };
    });

  if (items.length < 2) {
    const missingPostSlugs = resolvedPosts.filter((entry) => !entry.post).map((entry) => entry.postSlug);
    console.warn(
      `[hub] Low live-card count for hub "${hub.slug}" playlist "${playlist.key}": ` +
      `${items.length}/${playlist.posts.length} live. Missing: ${missingPostSlugs.join(", ") || "none"}.`,
    );
  }

  return { ...playlist, posts: items };
});

const uniquePosts = new Map<string, HubPost>();
for (const playlist of hub.playlists) {
  for (const postSlug of playlist.posts) {
    const post = getPostBySlug(postSlug);
    if (!post || uniquePosts.has(post.slug)) continue;
    uniquePosts.set(post.slug, post);
  }
}

const settings = readSettings();
const collectionItems = Array.from(uniquePosts.values()).map((post) => ({
  name: post.title,
  url: `/post/${post.slug}`,
  description: post.data?.excerpt ?? post.data?.metaDescription ?? "",
}));

const jsonLd = createCollectionPageSchema(
  settings,
  {
    name: `${hub.hero.title} — WitchClick`,
    url: `/hub/${hub.slug}`,
    description: hub.seoDescription,
    collectionType: "CollectionPage",
  },
  collectionItems,
);

const calendar = readEditorialCalendar();
const season = hub.seasonSlug ? calendar.seasons.find((entry) => entry.slug === hub.seasonSlug) ?? null : null;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Hubs", href: "/hub/" },
  { label: hub.hero.title },
];
---

<Base
  title={`${hub.hero.title} — WitchClick`}
  description={hub.seoDescription}
  ambientColor={hub.ambient}
>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
    <HeadSlot slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    </HeadSlot>

  <section class="hub-hero">
    <div class="hub-hero__inner">
      <p class="hub-hero__eyebrow">{hub.hero.eyebrow}</p>
      <h1 class="hub-hero__title">{hub.hero.title}</h1>
      <p class="hub-hero__lead">{hub.hero.lead}</p>
    </div>
  </section>

  <div class="hub-playlists">
    {playlists.map((playlist) => (
      <HubPlaylistRow
        title={playlist.title}
        description={playlist.description}
        groupChips={playlist.chips}
        posts={playlist.posts}
      />
    ))}
  </div>

  {partnerHighlight && hub.partnerHighlight && (
    <section class="hub-partner">
      <div class="hub-partner__inner">
        <div class="hub-partner__content">
          <h2>Partner spotlight</h2>
          <p>{hub.partnerHighlight.blurb}</p>
          <p class="hub-partner__cta">
            Explore more community collaborations in our <a href="/partners">Partners directory</a>.
          </p>
        </div>
        <PartnerProductCard product={partnerHighlight} />
      </div>
    </section>
  )}

  {season && (
    <section class="hub-season">
      <div class="hub-season__inner">
        <h2>{season.season}: {season.theme}</h2>
        <p class="hub-season__focus">{season.focus}</p>
        <div class="hub-season__grid">
          <div class="hub-season__panel">
            <h3>Anchor posts</h3>
            <ul>
              {season.anchorPosts.map((anchor) => (
                <li>
                  <a href={`/post/${anchor.slug}`}>{anchor.title}</a>
                </li>
              ))}
            </ul>
          </div>
          <div class="hub-season__panel">
            <h3>Upcoming rituals</h3>
            <ul>
              {season.rituals.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          {season.notes && (
            <div class="hub-season__panel hub-season__panel--notes">
              <h3>Editorial note</h3>
              <p>{season.notes}</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hub-hero {
    margin: clamp(2rem, 6vw, 3.75rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--theme-background);
    color: var(--theme-text-primary);
    border: 1px solid var(--theme-color-amethyst);
    box-shadow: var(--theme-shadow-strong);
  }

  .hub-hero__inner {
    max-width: 52rem;
    display: grid;
    gap: 0.8rem;
  }

  .hub-hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.85rem;
    color: var(--theme-color-gold);
  }

  .hub-hero__title {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3rem);
    color: var(--theme-text-strong);
  }

  .hub-hero__lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--theme-text-body);
  }

  .hub-playlists {
    margin: clamp(2.25rem, 6vw, 4.25rem) auto;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .hub-playlists :global(.hub-playlist) {
    padding: clamp(1.75rem, 5vw, 2.75rem);
    border-radius: clamp(1.75rem, 4vw, 2.5rem);
    background: linear-gradient(145deg, var(--theme-color-night) 95%, var(--theme-color-midnight) 85%);
    border: 1px solid var(--theme-border-subtle);
    box-shadow: var(--theme-shadow-strong);
    animation: slideUpFadeIn 400ms ease-out backwards;
  }

  .hub-playlists :global(.hub-playlist:nth-child(1)) {
    animation-delay: 0ms;
  }

  .hub-playlists :global(.hub-playlist:nth-child(2)) {
    animation-delay: 50ms;
  }

  .hub-playlists :global(.hub-playlist:nth-child(3)) {
    animation-delay: 100ms;
  }

  .hub-playlists :global(.hub-playlist:nth-child(4)) {
    animation-delay: 150ms;
  }

  .hub-playlists :global(.hub-playlist:nth-child(n+5)) {
    animation-delay: 200ms;
  }

  @keyframes slideUpFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hub-playlists :global(.hub-playlist__title) {
    color: var(--theme-text-strong);
  }

  .hub-playlists :global(.hub-playlist__description) {
    color: var(--theme-text-body);
  }

  :global(:root[data-comfort-theme="dawn"]) .hub-playlists :global(.hub-playlist) {
    background: linear-gradient(145deg, var(--theme-surface-base) 94%, var(--theme-surface-panel) 90%);
    border-color: var(--theme-border-subtle);
    box-shadow: var(--theme-shadow-strong);
  }

  :global(:root[data-comfort-theme="dawn"]) .hub-playlists :global(.hub-playlist__title) {
    color: var(--theme-text-strong);
  }

  :global(:root[data-comfort-theme="dawn"]) .hub-playlists :global(.hub-playlist__description) {
    color: var(--theme-text-body);
  }

  .hub-partner {
    margin: clamp(2rem, 6vw, 4rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--surface-panel-primary);
    border: 1px solid var(--theme-border-subtle);
    box-shadow: var(--theme-shadow-strong);
  }

  .hub-partner__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hub-partner__content {
    display: grid;
    gap: 0.75rem;
    max-width: 38rem;
  }

  .hub-partner__content h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
  }

  .hub-partner__content p {
    margin: 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--ink-body, currentColor) 85%, white 15%);
  }

  .hub-partner__cta {
    font-size: 0.95rem;
  }

  .hub-partner__cta a {
    font-weight: 600;
    color: color-mix(in srgb, var(--ambient-color, var(--text-accent)) 70%, var(--ink-strong, currentColor) 30%);
  }

  .hub-season {
    margin: clamp(2rem, 6vw, 4rem) auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    border-radius: clamp(1.75rem, 4vw, 2.5rem);
    background: var(--surface-panel-primary);
    border: 1px solid var(--theme-border-subtle);
    box-shadow: var(--theme-shadow-strong);
  }

  .hub-season__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hub-season__focus {
    margin: 0;
    max-width: 48rem;
    font-size: 1.05rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 76%, white 24%);
  }

  .hub-season__grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .hub-season__panel {
    padding: clamp(1.25rem, 3vw, 1.85rem);
    border-radius: 1.75rem;
    background: var(--surface-card);
    border: 1px solid var(--theme-border-subtle);
    box-shadow: var(--theme-shadow-soft);
  }

  .hub-season__panel h3 {
    margin: 0 0 0.65rem 0;
  }

  .hub-season__panel ul {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.45rem;
  }

  .hub-season__panel--notes {
    background: var(--surface-elevated);
    border-color: var(--theme-color-amethyst);
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-playlists :global(.hub-playlist) {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .hub-playlists {
      gap: clamp(2.5rem, 6vw, 4rem);
    }

    .hub-partner__inner {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      align-items: center;
    }

    .hub-season__grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
</style>
