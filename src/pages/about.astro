---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { readSettings, buildCanonicalUrl } from "../utils/settings";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/about" });
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "About" },
];

const quickLinks = [
  { label: "Journal", href: "/journal" },
  { label: "Entities", href: "/entities" },
  { label: "Spreads", href: "/spreads" },
  { label: "Contact", href: "/contact" },
];
---
<Base title="About WitchClick" description="Why WitchClick exists and where to explore next." canon={canonical}>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  <article class="space-y-8">
    <header class="space-y-4">
      <h1 class="font-serif text-3xl text-ink">About WitchClick</h1>
      <p class="text-base text-body">
        WitchClick began as a simple altar for friends who wanted ritual support without dogma. We blend secular research, tarot prompts, cozy design, and neurodivergent-friendly pacing so you can build tiny spells that fit into real life.
      </p>
      <p class="text-base text-body">
        Every guide is written with transparency and consent in mind. Adapt what you find, ignore what doesn’t resonate, and treat rest as part of the work.
      </p>
    </header>

    <section class="space-y-3">
      <h2 class="font-serif text-2xl text-ink">Continue exploring</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {quickLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="flex items-center justify-between rounded-2xl border border-line-muted/50 bg-surface-base/80 px-4 py-3 text-sm font-medium text-body transition hover:border-line-bold hover:text-body-strong"
            >
              <span>{link.label}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Base>
