---
import Base from "../layouts/Base.astro";
import { readSettings, getSiteOrigin } from "../utils/settings";

const settings = readSettings();
const site = getSiteOrigin(settings);
---
<Base
  title="About"
  description="About the WitchClick project."
  canon={site ? `${site}/about` : ""}
>
  <article class="prose prose-neutral max-w-none">
    <h1>About WitchClick</h1>
    <p>WitchClick is a cozy corner for planners, gentle magic, and mindful routines. We share practical, low-pressure ideas.</p>
    <p>Nothing here is medical advice. Always do what feels safe and good for you.</p>
  </article>
</Base>
