---
// src/pages/post/[slug].astro
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import Disclosure from '../../components/Disclosure.astro';
import KofiBlock from '../../components/KofiBlock.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';
import { marked } from 'marked';

// Build-time: enumerate posts and pass their data+content in props
export async function getStaticPaths() {
  const dir = './content/posts';
  if (!fs.existsSync(dir)) return [];
  const files = fs.readdirSync(dir).filter((f) => f.endsWith('.md'));

  return files.map((file) => {
    const raw = fs.readFileSync(path.join(dir, file), 'utf8');
    const { data, content } = matter(raw);
    const slug = (data && data.slug) ? String(data.slug) : file.replace(/\.md$/, '');
    return { params: { slug }, props: { data, content } };
  });
}

const { data = {}, content = '' } = Astro.props;
const settings = JSON.parse(fs.readFileSync('./content/settings.json','utf8'));
const productsFile = fs.existsSync('./content/products.json')
  ? JSON.parse(fs.readFileSync('./content/products.json','utf8'))
  : { products: [] };

const title = data.title ?? 'Untitled';
const description = data.metaDescription ?? data.excerpt ?? '';
const canonical = `${String(settings.siteUrl || 'https://example.com').replace(/\/$/,'')}/post/${data.slug ?? ''}`;
const downloadId = data.downloadId || (data.cta && data.cta.id);
const includeAds = !!data.includeAds;
const includeKofi = !!data.includeKofi;

// ---- avoid angle-bracket generics in .astro frontmatter
type AffAnchor = { key: string; text: string };
type Product  = { key: string; url?: string; utm?: string };
type InternalLink = { slug: string; anchor: string };

const affiliateAnchors: AffAnchor[] =
  Array.isArray(data.affiliateAnchors) ? data.affiliateAnchors : [];
const allowedKeys = new Set((productsFile.products || []).map((p: any) => String(p.key)));

// Convert Markdown → HTML
const htmlRaw = marked.parse(content || '');

// -------- internal link injection (first natural occurrence per anchor) --------
const internalLinks: InternalLink[] = Array.isArray(data.internalLinks)
  ? data.internalLinks.map((l: any) => ({ slug: String(l.slug || ''), anchor: String(l.anchor || '') }))
  : [];

function escRe(s: string) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

// Avoid touching existing anchors/code/pre blocks
const CHUNK_RE = /(<a\b[^>]*>.*?<\/a>|<code\b[^>]*>.*?<\/code>|<pre\b[^>]*>.*?<\/pre>)/gis;

function linkInternalOnce(html: string, anchor: string, slug: string) {
  if (!anchor || !slug) return html;
  const re = new RegExp(escRe(anchor), 'i');
  const parts = html.split(CHUNK_RE);
  let linked = false;
  for (let i = 0; i < parts.length; i++) {
    if (i % 2 === 1) continue; // skip captured tags
    if (!linked && re.test(parts[i])) {
      parts[i] = parts[i].replace(re, (m) => `<a href="/post/${slug}">${m}</a>`);
      linked = true;
    }
  }
  return parts.join('');
}

function applyInternalLinks(html: string, links: InternalLink[]) {
  let out = html;
  for (const l of links) out = linkInternalOnce(out, l.anchor || '', l.slug || '');
  return out;
}

// -------- affiliate linking (first natural occurrence per allowed anchor) --------
const products: Product[] = productsFile.products || [];

function withUtm(u?: string, utm?: string) {
  if (!u) return '';
  if (!utm) return u;
  return u.includes('?') ? `${u}&${utm}` : `${u}?${utm}`;
}

function linkAffiliateOnce(html: string, text: string, href: string) {
  if (!text || !href) return html;
  const re = new RegExp(escRe(text), 'i');
  const parts = html.split(CHUNK_RE);
  let linked = false;
  for (let i = 0; i < parts.length; i++) {
    if (i % 2 === 1) continue; // skip existing anchors/code/pre
    if (!linked && re.test(parts[i])) {
      parts[i] = parts[i].replace(
        re,
        (m) => `<a href="${href}" rel="nofollow sponsored" target="_blank" data-analytics="aff_click">${m}</a>`
      );
      linked = true;
    }
  }
  return parts.join('');
}

let html = String(htmlRaw);
let hasAffiliates = false; // used by <Disclosure/>

for (const a of affiliateAnchors) {
  if (!allowedKeys.has(String(a.key))) continue;
  const prod = products.find((p) => String(p.key) === String(a.key));
  if (!prod || !prod.url) continue;
  const target = withUtm(String(prod.url).trim(), String(prod.utm || '').trim());
  const next = linkAffiliateOnce(html, String(a.text || ''), target);
  if (next !== html) hasAffiliates = true;
  html = next;
}

// Internal links after affiliates
html = applyInternalLinks(html, internalLinks);

// ---- ogImage (optional for JSON-LD)
const site = String(settings.siteUrl || 'https://example.com').replace(/\/$/, '');
const candidateOg = path.join(process.cwd(), 'public', 'og', `${data.slug || 'default'}.jpg`);
const ogImage = fs.existsSync(candidateOg) ? `${site}/og/${data.slug}.jpg` : '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: data.publishedAt || undefined,
  dateModified: data.publishedAt || undefined,
  url: `${site}/post/${data.slug || ''}`,
  image: ogImage ? [ogImage] : undefined,
  author: { '@type': 'Organization', name: settings.brandName || 'WitchClick' },
  publisher: { '@type': 'Organization', name: settings.brandName || 'WitchClick' }
};
---
<Base title={title} description={description} canon={canonical} wide={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <article class="prose prose-neutral max-w-none lg:col-span-8">
      <h1 class="mb-2">{title}</h1>
      <p class="mt-0 mb-4 text-sm text-gray-600">
        {data.publishedAt && <time datetime={data.publishedAt}>
          {new Date(data.publishedAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}
        </time>}
        {data.publishedAt && data.readingMinutes && <span> · </span>}
        {data.readingMinutes && <span>{data.readingMinutes} min read</span>}
      </p>

      <Disclosure show={includeAds || hasAffiliates} />

      <div set:html={html} />

      {downloadId && <DownloadCard id={downloadId} />}

      {includeAds && <AdSlot slot="end" class="mt-8" />}

      {includeKofi && <KofiBlock />}
    </article>

    {includeAds && (
      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-24">
          <AdSlot slot="side" />
        </div>
      </aside>
    )}
  </div>
</Base>
