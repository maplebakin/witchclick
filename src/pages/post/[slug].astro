---
// src/pages/post/[slug].astro
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import createDOMPurify from 'dompurify';
import { JSDOM } from 'jsdom';
import Base from "../../layouts/Base.astro";
import Disclosure from "../../components/Disclosure.astro";
import DownloadCard from "../../components/DownloadCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostRail from "../../components/PostRail.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import TldrCallout from "../../components/TldrCallout.astro";
import BackToTop from "../../components/BackToTop.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import { readSettings, buildCanonicalUrl, getSiteOrigin, toAbsoluteUrl } from "../../utils/settings";
import { normalizeSpoonLevel } from "../../utils/augment";
import { getAuthorBySlug, normalizeAuthorSlug, type AuthorProfile } from "../../utils/authors";
import { readEntity } from "../../utils/entities";
import { loadAllPosts, extractHeadingOutline } from "../../utils/posts";
import { getRelatedPosts } from "../../utils/recommendations";
import { canonicalTagHref } from "@/utils/tags";
import { autoLinkAffiliates } from "../../../tools/src/auto-affiliate.js";


export const prerender = true;

export async function getStaticPaths() {
  // Source static paths from canonical published content only.
  // loadAllPosts() already excludes drafts and future-dated scheduled posts.
  return loadAllPosts().map((post) => ({ params: { slug: post.slug } }));
}

const PRODUCTS_FILE = path.join(process.cwd(), 'content', 'products.json');

class Slugger {
  private seen: Record<string, number> = {};

  slug(text: string): string {
    let slug = text
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-")
      .replace(/^-+|-+$/g, "");

    const originalSlug = slug;
    const count = this.seen[originalSlug] || 0;

    if (count > 0) {
      slug = `${originalSlug}-${count}`;
    }

    this.seen[originalSlug] = count + 1;
    return slug;
  }
}

function loadProducts() {
  try {
    const raw = fs.readFileSync(PRODUCTS_FILE, 'utf8');
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed?.products) ? parsed.products : [];
  } catch {
    return [];
  }
}

function matchAffiliateProducts(
  postTags: string[],
  affiliateHintKeys: string[],
  allProducts: ReturnType<typeof loadProducts>,
) {
  // Prefer explicit hints from frontmatter
  if (affiliateHintKeys.length > 0) {
    const hinted = affiliateHintKeys
      .map((key) => allProducts.find((p: { key?: string }) => p.key === key))
      .filter(Boolean);
    if (hinted.length > 0) return hinted.slice(0, 3);
  }
  // Fall back to tag overlap scoring
  const normalized = postTags.map((t) => t.toLowerCase());
  const scored = allProducts
    .map((p: { tags?: string[]; [k: string]: unknown }) => ({
      product: p,
      score: (p.tags ?? []).filter((t: string) => normalized.includes(t.toLowerCase())).length,
    }))
    .filter((x: { score: number }) => x.score > 0)
    .sort((a: { score: number }, b: { score: number }) => b.score - a.score);
  return scored.slice(0, 3).map((x: { product: unknown }) => x.product);
}

function extractAffiliateHintKeys(data: Record<string, unknown>): string[] {
  const keys: string[] = [];
  const pushKey = (candidate: unknown) => {
    const key = String(candidate ?? '').trim();
    if (!key || keys.includes(key)) return;
    keys.push(key);
  };

  // Primary persisted shape from ingest: affiliateAnchors[{ key, text, insertedCount }]
  if (Array.isArray((data as { affiliateAnchors?: unknown[] }).affiliateAnchors)) {
    for (const entry of (data as { affiliateAnchors: unknown[] }).affiliateAnchors) {
      if (entry && typeof entry === 'object' && 'key' in entry) {
        pushKey((entry as { key?: unknown }).key);
      } else if (typeof entry === 'string') {
        // Legacy/manual fallback when anchors are stored as raw key strings
        pushKey(entry);
      }
    }
  }

  // Backward compatibility for older frontmatter shape: affiliateHints[]
  if (Array.isArray((data as { affiliateHints?: unknown[] }).affiliateHints)) {
    for (const entry of (data as { affiliateHints: unknown[] }).affiliateHints) {
      if (typeof entry === 'string') {
        pushKey(entry);
      } else if (entry && typeof entry === 'object' && 'key' in entry) {
        pushKey((entry as { key?: unknown }).key);
      }
    }
  }

  return keys;
}

async function buildPostFromSource(slug: string) {
  const normalized = slug.toLowerCase();
  const post = loadAllPosts().find((item) => item.slug === normalized);
  if (!post) return null;

  const markdown = post.content || '';
  let html = marked.parse(markdown || '') as string;
  let hasAffiliates = false;

  try {
    const dom = new JSDOM('<body></body>');
    const DOMPurify = createDOMPurify(dom.window);
    const safeHtml = DOMPurify.sanitize(html, { USE_PROFILES: { html: true } });
    const wrapper = dom.window.document.createElement('div');
    wrapper.innerHTML = safeHtml;
    const slugger = new Slugger();
    const headingNodes = wrapper.querySelectorAll('h2, h3, h4');
    headingNodes.forEach((node) => {
      const text = node.textContent?.trim();
      if (!text) return;
      const existing = node.getAttribute('id');
      const id = existing && existing.trim().length ? existing : slugger.slug(text);
      node.setAttribute('id', id);
    });
    html = wrapper.innerHTML;
  } catch {
    /* fall back to raw marked output */
  }

  try {
    const products = loadProducts();
    const linked = autoLinkAffiliates(html, products, { maxLinksPerPost: 3 });
    html = linked.html;
    hasAffiliates = linked.count > 0;
  } catch {
    /* ignore affiliate linking failures in dev */
  }

  const relatedPosts = getRelatedPosts({
    currentSlug: post.slug,
    currentData: post.data,
    limit: 4,
  });
  const headingOutline = extractHeadingOutline(markdown, { minLevel: 2, maxLevel: 3 });

  return {
    slug: post.slug,
    data: post.data,
    tldr: post.tldr,
    spoons: post.spoons,
    content: html,
    hasAffiliates,
    relatedPosts,
    headingOutline,
  };
}

const { slug } = Astro.params;
const CACHE_DIR = path.join(process.cwd(), '.cache/post-data');
const postFilePath = path.join(CACHE_DIR, `${slug}.json`);

let post = null;
if (fs.existsSync(postFilePath)) {
  post = JSON.parse(fs.readFileSync(postFilePath, 'utf-8'));
} else {
  post = await buildPostFromSource(slug);
}

if (!post) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found'
  });
}

const {
  data,
  content: html,
  hasAffiliates,
  relatedPosts: recommendations,
  headingOutline,
} = post;

const effectiveSlug = post.slug;
const settings = readSettings();
const siteOrigin = getSiteOrigin(settings);
const title = data.title ?? "Untitled";
const description = data.metaDescription ?? data.description ?? data.excerpt ?? '';

const publishedAt = data.publishedAt ?? data.pubDate ?? data.date ?? undefined;
const modifiedAt = data.updatedAt ?? publishedAt ?? undefined;
const canonical = buildCanonicalUrl(settings, { path: `/post/${effectiveSlug}` });

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Archive", href: "/page/1" },
  { label: title },
];

const readingMinutes = data.readingMinutes;
const spoonLevel = normalizeSpoonLevel(data.spoons ?? data.spoonLevel);
const tldr = data.tldr || '';
const heroImage = data.heroImage || '';
const heroAlt = data.heroAlt || title;

let ctaType: "kofi" | "download" | "none" = "none";
let ctaId: string | undefined;

if (data.downloadId) {
  ctaType = "download";
  ctaId = String(data.downloadId);
} else if (data.includeKofi) {
  ctaType = "kofi";
}

const authorSlugs = Array.isArray(data.authors) ? data.authors.map((s: string) => normalizeAuthorSlug(s)) : [];
const pageAuthors = authorSlugs.map((slug: string) => {
  const profile = getAuthorBySlug(slug);
  return {
    slug,
    name: profile?.name || slug,
    profile,
  }
});

interface AuthorSegment {
    slug: string;
    name: string;
    profile: AuthorProfile | undefined;
    href: string | null;
    label: string;
    separator: string | null;
}

const authorSegments: AuthorSegment[] = pageAuthors.map((author: { slug: string; name: string; profile: AuthorProfile | undefined }, index: number) => {
    let separator: string | null = null;
    if (index > 0) {
        separator = pageAuthors.length === 2 || index === pageAuthors.length - 1 ? 'ampersand' : 'comma';
    }
    return { ...author, href: author.profile ? `/author/${author.profile.slug}/` : null, label: author.name, separator };
});

const jsonLdAuthors = pageAuthors.map((author: { slug: string; name: string; profile: AuthorProfile | undefined }) => ({
    "@type": "Person" as const,
    name: author.name,
    url: author.profile ? `${siteOrigin}/author/${author.profile.slug}` : undefined,
}));

const jsonLdAuthor = jsonLdAuthors.length === 0 ? { "@type": "Organization", name: settings.brandName || "WitchClick" } : jsonLdAuthors.length === 1 ? jsonLdAuthors[0] : jsonLdAuthors;

const ogImage = data.ogImage ? toAbsoluteUrl(data.ogImage, settings) : `${siteOrigin}/og/${effectiveSlug}.jpg`;

const allProducts = loadProducts();
const postTags = Array.isArray(data.tags) ? data.tags.map((t: unknown) => String(t)) : [];
const affiliateHintKeys = extractAffiliateHintKeys(data as Record<string, unknown>);
const railProducts = matchAffiliateProducts(postTags, affiliateHintKeys, allProducts);

const entList = Array.isArray(data.entities) ? data.entities : [];
const resolvedEntities = entList.map((e: { type?: string; slug?: string }) => readEntity(String(e.type || ""), String(e.slug || ""))).filter(Boolean);
const railEntities = resolvedEntities.map((entity: any) => ({
  name: entity.name,
  href: `/entities/${entity.type}/${entity.slug}`,
  description: entity.summary,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  abstract: tldr || undefined,
  datePublished: publishedAt ? new Date(publishedAt).toISOString() : undefined,
  dateModified: modifiedAt ? new Date(modifiedAt).toISOString() : undefined,
  url: canonical,
  image: ogImage ? [ogImage] : undefined,
  author: jsonLdAuthor,
  publisher: { "@type": "Organization", name: settings.brandName || "WitchClick" },
};
---

<Base title={title} description={description} canon={canonical} wide={true} ogImage={ogImage} ogType="article">
  <HeadSlot slot="head">
    {publishedAt && <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />}
    {modifiedAt && <meta property="article:modified_time" content={new Date(modifiedAt).toISOString()} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </HeadSlot>

  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />

  <div class="flex w-full flex-col gap-12 px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
    <ReadingProgress target='[data-reading-target="article"]' />
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_320px] md:items-start">
      <article
        class="post-body flex min-w-0 flex-col gap-8 md:gap-10"
        aria-labelledby="post-title"
        data-reading-target="article"
      >
          <header class="card-panel card-tier-2 card-panel-strong card-panel-static overflow-hidden p-6 sm:p-8 lg:p-10">
            <div class:list={["flex flex-col gap-8 lg:gap-10", heroImage && "lg:flex-row lg:items-start"]}>
              {heroImage && (
                <figure class="relative aspect-[4/3] overflow-hidden rounded-xl border border-line-neutral-strong/60 bg-surface-soft shadow-sm lg:w-[42%]">
                  <img class="h-full w-full object-cover" src={heroImage} alt={heroAlt} loading="eager" />
                </figure>
              )}
              <div class="flex flex-1 flex-col gap-6">
                <p class="flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-widest text-body-subtle">
                  {publishedAt && <time datetime={new Date(publishedAt).toISOString()}>{new Date(publishedAt).toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" })}</time>}
                  {(publishedAt || readingMinutes) && <span aria-hidden="true">•</span>}
                  {readingMinutes && <span>{readingMinutes} minute read</span>}
                </p>

                <h1 id="post-title" class="font-serif text-3xl leading-tight sm:text-4xl lg:text-5xl text-body-strong">
                  {title}
                </h1>

                {authorSegments.length > 0 && (
                  <p class="flex flex-wrap items-center gap-y-2 text-sm text-body-muted">
                    By
                    {authorSegments.map((author) => (
                      <span class="inline-flex items-center">
                        {author.separator === 'comma' && <span class="px-1">,</span>}
                        {author.separator === 'ampersand' && <span class="px-1">&amp;</span>}
                        {author.href ? (
                          <a class="font-semibold transition-colors hover:text-brand-primary" href={author.href}>{author.label}</a>
                        ) : (
                          <span class="font-semibold text-body-strong">{author.label}</span>
                        )}
                      </span>
                    ))}
                  </p>
                )}

                {Array.isArray(data.tags) && data.tags.length > 0 && (
                  <ul class="mt-6 flex flex-wrap gap-2">
                    {data.tags.map((tag: any) => (
                      <li>
                        <a
                          href={canonicalTagHref(String(tag).toLowerCase())}
                          class="rounded-full bg-surface-soft px-3 py-1 text-xs text-body-muted transition-colors hover:text-brand-primary"
                        >
                          #{String(tag).toLowerCase()}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {(tldr || (data.tldrBullets && data.tldrBullets.length > 0) || spoonLevel) && (
                  <div class="mt-6">
                    <TldrCallout summary={tldr} bullets={data.tldrBullets || []} spoonLevel={spoonLevel} />
                  </div>
                )}
              </div>
            </div>
          </header>

          <div class="card-panel card-panel-strong card-panel-static flex flex-col gap-8 p-6 sm:p-8 lg:p-10">
            <div class="prose prose-lg max-w-none prose-headings:font-serif prose-a:text-brand-primary prose-blockquote:border-brand-primary/30" set:html={html} />
            <Disclosure show={hasAffiliates} />
            {ctaType === 'download' && ctaId && <DownloadCard id={ctaId} />}
            <ShareButtons title={title} url={canonical} />
          </div>
      </article>

      <PostRail
        recommendations={recommendations}
        entities={railEntities}
        toc={headingOutline}
        ctaType={ctaType}
        ctaId={ctaId}
        products={railProducts}
      />
    </div>

    </div>
  <BackToTop />
</Base>
