---
// src/pages/post/[slug].astro
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import Disclosure from "../../components/Disclosure.astro";
import KofiBlock from "../../components/KofiBlock.astro";
import DownloadCard from "../../components/DownloadCard.astro";

import fs from "node:fs";
import path from "node:path";
import matter from "gray-matter";
import { marked } from "marked";

// NEW: auto affiliate helper
import { autoLinkAffiliates } from "../../../tools/src/auto-affiliate";

export const prerender = true;

type PostData = Record<string, any>;
type PrevNext = { slug: string; title: string } | null;

export async function getStaticPaths() {
  const dir = "./content/posts";
  if (!fs.existsSync(dir)) return [];
  const files = fs.readdirSync(dir).filter((f) => f.endsWith(".md"));

  const parsed = files.map((file) => {
    const full = path.join(dir, file);
    const raw = fs.readFileSync(full, "utf8");
    const { data, content } = matter(raw);
    const slug = (data?.slug ? String(data.slug) : file.replace(/\.md$/, "")).toLowerCase();

    const frontDates = [data?.publishedAt, data?.pubDate, data?.date, data?.updatedAt].filter(Boolean) as string[];
    let date = new Date(frontDates[0] || 0);
    if (isNaN(+date)) date = fs.statSync(full).mtime;

    return { slug, title: String(data?.title || "Untitled"), date, data, content };
  });

  parsed.sort((a, b) => +b.date - +a.date);
  const indexBySlug = new Map(parsed.map((p, i) => [p.slug, i]));

  return parsed.map((p) => {
    const i = indexBySlug.get(p.slug)!;
    const prev = parsed[i - 1] ? { slug: parsed[i - 1].slug, title: parsed[i - 1].title } : null;
    const next = parsed[i + 1] ? { slug: parsed[i + 1].slug, title: parsed[i + 1].title } : null;
    return {
      params: { slug: p.slug },
      props: { data: p.data, content: p.content, effectiveSlug: p.slug, prev, next },
    };
  });
}

const {
  data = {} as PostData,
  content = "",
  effectiveSlug = Astro.params.slug as string,
  prev = null as PrevNext,
  next = null as PrevNext,
} = Astro.props;

// Settings (fallbacks ok)
let settings: any = { brandName: "WitchClick", siteUrl: "https://example.com" };
try {
  const s = fs.readFileSync("./content/settings.json", "utf8");
  settings = { ...settings, ...JSON.parse(s) };
} catch {}

const siteOrigin = String(settings.siteUrl || "https://example.com").replace(/\/$/, "");
const title = data.title ?? "Untitled";
const description =
  data.metaDescription ?? data.description ?? data.excerpt ?? firstSentence(content) ?? "";

const publishedAt = data.publishedAt || data.pubDate || data.date || undefined;
const modifiedAt = data.updatedAt || publishedAt || undefined;
const canonical = `${siteOrigin}/post/${effectiveSlug}`;

const readingMinutes =
  data.readingMinutes ?? Math.max(1, Math.ceil(wordCount(content) / 200));

const htmlRaw = marked.parse(content || "");
const htmlSafe = stripInlineHandlers(stripScripts(String(htmlRaw)));
let html = String(htmlSafe);

// Load products (either {products: []} or [] shape)
const productsFilePath = "./content/products.json";
const productsDoc = fs.existsSync(productsFilePath)
  ? JSON.parse(fs.readFileSync(productsFilePath, "utf8"))
  : { products: [] };
const allProducts = Array.isArray(productsDoc) ? productsDoc : (productsDoc.products || []);

// OG candidate image
const ogCandidate = path.join(process.cwd(), "public", "og", `${effectiveSlug}.jpg`);
const ogImage = fs.existsSync(ogCandidate) ? `${siteOrigin}/og/${effectiveSlug}.jpg` : "";

// Start with manual frontmatter anchors if present
let hasAffiliates = false;

const frontAnchors = Array.isArray(data.affiliateAnchors) ? data.affiliateAnchors : [];
if (frontAnchors.length > 0) {
  // Use the shared linker pipeline via autoLinkAffiliates but freeze to declared anchors by
  // temporarily mapping products to only those keys/texts.
  const declared = frontAnchors
    .map((a: any) => ({ key: String(a.key || ""), text: String(a.text || "") }))
    .filter((a: any) => a.key && a.text);

  for (const d of declared) {
    const prod = allProducts.find((p: any) => String(p.key) === d.key);
    if (!prod || !prod.url) continue;
    const { html: next, count } = autoLinkAffiliates(html, [{ ...prod }], { maxLinksPerPost: 1 });
    if (count > 0 && next !== html) {
      html = next;
      hasAffiliates = true;
    }
  }
} else {
  // AUTO MODE: derive anchors from product names/tags and link up to 3 total
  const { html: next, count } = autoLinkAffiliates(html, allProducts, { maxLinksPerPost: 3 });
  if (count > 0) {
    html = next;
    hasAffiliates = true;
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishedAt ? new Date(publishedAt).toISOString() : undefined,
  dateModified: modifiedAt ? new Date(modifiedAt).toISOString() : undefined,
  url: canonical,
  image: ogImage ? [ogImage] : undefined,
  author: { "@type": "Organization", name: settings.brandName || "WitchClick" },
  publisher: { "@type": "Organization", name: settings.brandName || "WitchClick" },
};

function wordCount(md: string): number {
  return md
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_`~\-]+/g, " ")
    .split(/\s+/)
    .filter(Boolean).length;
}

function firstSentence(md: string): string | null {
  const asText = md
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/[#>*_`~\-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  const m = asText.match(/^(.{40,200}?[.!?])\s/);
  return m ? m[1] : null;
}

function stripScripts(html: string) {
  return html.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, "");
}
function stripInlineHandlers(html: string) {
  return html
    .replace(/\s(on\w+)\s*=\s*"[^"]*"/gi, "")
    .replace(/\s(on\w+)\s*=\s*'[^']*'/gi, "");
}
---

<Base title={title} description={description} canon={canonical} wide={true} ogImage={ogImage}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    {publishedAt && (
      <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />
    )}
    {modifiedAt && (
      <meta property="article:modified_time" content={new Date(modifiedAt).toISOString()} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <article class="prose prose-neutral max-w-none lg:col-span-8">
      <h1 class="mb-2">{title}</h1>
      <p class="mt-0 mb-4 text-sm text-gray-600">
        {publishedAt && (
          <time datetime={new Date(publishedAt).toISOString()}>
            {new Date(publishedAt).toLocaleDateString(undefined, {
              year: "numeric",
              month: "short",
              day: "numeric",
            })}
          </time>
        )}
        {(publishedAt || readingMinutes) && <span> · </span>}
        {readingMinutes && <span>{readingMinutes} min read</span>}
      </p>

      <Disclosure show={hasAffiliates || !!data.includeAds} />

      <div set:html={html} />

      {data.downloadId && <DownloadCard id={data.downloadId} />}

      {data.includeAds && <AdSlot slot="end" class="mt-8" />}

      {data.includeKofi && <KofiBlock />}

      {(prev || next) && (
        <nav class="mt-10 border-t border-purple-100/60 pt-6 text-sm" aria-label="Post navigation">
          <ul class="flex flex-col gap-2 sm:flex-row sm:justify-between">
            <li>
              {prev && (
                <a class="underline underline-offset-4 hover:no-underline" href={`/post/${prev.slug}`}>
                  ← {prev.title}
                </a>
              )}
            </li>
            <li class="text-right">
              {next && (
                <a class="underline underline-offset-4 hover:no-underline" href={`/post/${next.slug}`}>
                  {next.title} →
                </a>
              )}
            </li>
          </ul>
        </nav>
      )}
    </article>

    {data.includeAds && (
      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-24">
          <AdSlot slot="side" />
        </div>
      </aside>
    )}
  </div>
</Base>
