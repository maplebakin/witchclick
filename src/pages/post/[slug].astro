---
// src/pages/post/[slug].astro — drop‑in replacement with Entities sidebar + Ko‑fi CTA randomizer
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import Disclosure from "../../components/Disclosure.astro";
import DownloadCard from "../../components/DownloadCard.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import CtaFooter from "../../components/CtaFooter.astro";
import ProductRecommendations from "../../components/ProductRecommendations.astro";
import Accordion from "../../components/Accordion.astro";
import CommentsSection from "../../components/CommentsSection.astro";
import AuthorSpotlight from "../../components/AuthorSpotlight.astro";
import { readEntity } from "../../utils/entities";
import { Fragment } from "astro/jsx-runtime";

import fs from "node:fs";
import path from "node:path";
import { marked } from "marked";
import createDOMPurify from "dompurify";
import { JSDOM } from "jsdom";

import { autoLinkAffiliates } from "../../../tools/src/auto-affiliate";
import { readSettings, getSiteOrigin, toAbsoluteUrl } from "../../utils/settings";
import {
  loadAllPosts,
  estimateReadingMinutes,
  firstParagraph,
  extractAuthorSlugs,
} from "../../utils/posts";
import { getAuthorBySlug, normalizeAuthorSlug, type AuthorProfile } from "../../utils/authors";

const dom = new JSDOM("<body></body>");
const DOMPurify = createDOMPurify(dom.window);

export const prerender = true;

type PostData = Record<string, any>;
type PrevNext = { slug: string; title: string } | null;

export async function getStaticPaths() {
  const posts = loadAllPosts();

  return posts.map((post, index) => {
    const prev = posts[index - 1]
      ? { slug: posts[index - 1].slug, title: posts[index - 1].title }
      : null;
    const next = posts[index + 1]
      ? { slug: posts[index + 1].slug, title: posts[index + 1].title }
      : null;

    return {
      params: { slug: post.slug },
      props: {
        data: post.data,
        content: post.content,
        effectiveSlug: post.slug,
        prev,
        next,
      },
    };
  });
}

const {
  data = {} as PostData,
  content = "",
  effectiveSlug = Astro.params.slug as string,
  prev = null as PrevNext,
  next = null as PrevNext,
} = Astro.props;

const settings = readSettings();
const siteOrigin = getSiteOrigin(settings) || "https://example.com";
const title = data.title ?? "Untitled";
const description =
  data.metaDescription ?? data.description ?? data.excerpt ?? firstParagraph(content);

const publishedAt = data.publishedAt ?? data.pubDate ?? data.date ?? undefined;
const modifiedAt = data.updatedAt ?? publishedAt ?? undefined;
const canonical = `${siteOrigin}/post/${effectiveSlug}`;

const readingMinutes = data.readingMinutes ?? estimateReadingMinutes(content);

const htmlRaw = marked.parse(content || "");
let html = DOMPurify.sanitize(String(htmlRaw), { USE_PROFILES: { html: true } });

const heroImage = typeof data.heroImage === "string" ? data.heroImage.trim() : "";
const heroAlt =
  typeof data.heroAlt === "string" && data.heroAlt.trim().length
    ? data.heroAlt.trim()
    : title;

function cleanSummaryText(value: unknown): string {
  if (typeof value !== "string") return "";
  return value
    .replace(/<[^>]*>/g, " ")
    .replace(/[`*_>#\-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

const tldrSource = data.tldr ?? data.tldrPoints ?? null;
const tldrSummaryCandidate =
  typeof data.tldrSummary === "string"
    ? data.tldrSummary
    : typeof tldrSource === "string"
      ? tldrSource
      : typeof data.excerpt === "string"
        ? data.excerpt
        : description;

const tldrSummaryRaw = cleanSummaryText(tldrSummaryCandidate);
const tldrSummary =
  tldrSummaryRaw.length > 220 ? `${tldrSummaryRaw.slice(0, 217)}…` : tldrSummaryRaw;

const tldrItemsRaw = Array.isArray(tldrSource)
  ? tldrSource
  : Array.isArray(data.tldrList)
    ? data.tldrList
    : Array.isArray(data.outline)
      ? data.outline.slice(0, 3)
      : [];

const tldrItems = tldrItemsRaw
  .map((item: unknown) => cleanSummaryText(item))
  .filter(Boolean);

const hasTldr = Boolean(tldrSummary) || tldrItems.length > 0;

let ctaType: "kofi" | "download" | "none" = "none";
let ctaId: string | undefined;

if (data && typeof data === "object") {
  if (data.downloadId) {
    ctaType = "download";
    ctaId = String(data.downloadId);
  } else if (data.includeKofi) {
    ctaType = "kofi";
  }
}

const productsFilePath = "./content/products.json";
const productsDoc = fs.existsSync(productsFilePath)
  ? JSON.parse(fs.readFileSync(productsFilePath, "utf8"))
  : { products: [] };
const allProducts = Array.isArray(productsDoc) ? productsDoc : productsDoc.products || [];

const postTagsRaw = Array.isArray(data.tags)
  ? data.tags
  : typeof data.tags === "string"
    ? data.tags.split(",")
    : [];

const postTags = Array.from(
  new Set(
    postTagsRaw
      .map((tag: any) => String(tag ?? "").split(","))
      .flat()
      .map((tag: string) => tag.trim().toLowerCase())
      .filter(Boolean),
  ),
);

const productRecommendations = (postTags.length
  ? allProducts.filter((product: any) => {
      if (!product || typeof product !== "object") return false;
      const tags = Array.isArray(product.tags)
        ? product.tags
            .map((tag: any) => String(tag ?? "").trim().toLowerCase())
            .filter(Boolean)
        : [];
      if (tags.length === 0) return false;
      return tags.some((tag: string) => postTags.includes(tag));
    })
  : [])
  .filter((product: any, index: number, list: any[]) => {
    const key = product?.key ? String(product.key) : null;
    if (!key) return true;
    return index === list.findIndex((item: any) => item?.key && String(item.key) === key);
  });

const authorEntriesRaw: unknown[] = [];
if (Array.isArray((data as any).authors)) {
  authorEntriesRaw.push(...((data as any).authors as unknown[]));
}
if ((data as any).author) {
  authorEntriesRaw.push((data as any).author);
}

type PageAuthor = { slug: string; name: string; profile: AuthorProfile | null };

const authorSlugs = extractAuthorSlugs(data ?? {});
const seenAuthorSlugs = new Set<string>();

const pageAuthors: PageAuthor[] = authorSlugs
  .filter((slug) => {
    if (!slug) return false;
    if (seenAuthorSlugs.has(slug)) return false;
    seenAuthorSlugs.add(slug);
    return true;
  })
  .map((slug) => {
    const profile = getAuthorBySlug(slug);
    let label = profile?.name ?? "";

    if (!label) {
      const match = authorEntriesRaw.find((entry) => {
        if (!entry) return false;
        if (typeof entry === "string") {
          return normalizeAuthorSlug(entry) === slug;
        }

        if (typeof entry === "object") {
          const record = entry as Record<string, any>;
          if (typeof record.slug === "string" && normalizeAuthorSlug(record.slug) === slug) {
            return true;
          }
          if (typeof record.name === "string" && normalizeAuthorSlug(record.name) === slug) {
            return true;
          }
        }

        return false;
      });

      if (typeof match === "string") {
        label = match;
      } else if (match && typeof match === "object") {
        const record = match as Record<string, any>;
        if (typeof record.name === "string" && record.name.trim()) {
          label = record.name;
        } else if (typeof record.title === "string" && record.title.trim()) {
          label = record.title;
        }
      }
    }

    if (!label) {
      label = slug
        .split("-")
        .filter(Boolean)
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(" ");
    }

    return { slug, name: label, profile } satisfies PageAuthor;
  });

const authorLinks = pageAuthors.map((author) => ({
  href: author.profile ? `/author/${author.profile.slug}/` : null,
  label: author.name,
  slug: author.slug,
}));

const authorsWithProfiles = pageAuthors
  .map((author) => author.profile)
  .filter((profile): profile is AuthorProfile => Boolean(profile));

const jsonLdAuthors = pageAuthors
  .map((author) => ({
    "@type": "Person",
    name: author.name,
    url: author.profile ? `${siteOrigin}/author/${author.profile.slug}` : undefined,
    description: author.profile?.bio,
  }))
  .filter((person) => Boolean(person.name));

const jsonLdAuthor =
  jsonLdAuthors.length === 0
    ? { "@type": "Organization", name: settings.brandName || "WitchClick" }
    : jsonLdAuthors.length === 1
      ? jsonLdAuthors[0]
      : jsonLdAuthors;

const ogCandidate = path.join(process.cwd(), "public", "og", `${effectiveSlug}.jpg`);
const ogImage = data.ogImage
  ? toAbsoluteUrl(data.ogImage, settings)
  : fs.existsSync(ogCandidate)
    ? `${siteOrigin}/og/${effectiveSlug}.jpg`
    : "";

let hasAffiliates = false;

const frontAnchors = Array.isArray(data.affiliateAnchors) ? data.affiliateAnchors : [];
if (frontAnchors.length > 0) {
  const declared = frontAnchors
    .map((a: any) => ({ key: String(a.key || ""), text: String(a.text || "") }))
    .filter((a: any) => a.key && a.text);

  for (const d of declared) {
    const prod = allProducts.find((p: any) => String(p.key) === d.key);
    if (!prod || !prod.url) continue;
    const { html: nextHtml, count } = autoLinkAffiliates(html, [{ ...prod }], { maxLinksPerPost: 1 });
    if (count > 0 && nextHtml !== html) {
      html = nextHtml;
      hasAffiliates = true;
    }
  }
} else {
  const { html: nextHtml, count } = autoLinkAffiliates(html, allProducts, { maxLinksPerPost: 3 });
  if (count > 0) {
    html = nextHtml;
    hasAffiliates = true;
  }
}

const entList = Array.isArray(data.entities) ? data.entities : [];
const resolvedEntities = entList
  .map((e: any) => {
    const entity = readEntity(String(e.type || ""), String(e.slug || ""));
    if (!entity) return null;

    return {
      ...entity,
      href: `/entities/${entity.type}/${entity.slug}`,
      description: entity.summary,
    };
  })
  .filter(Boolean);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishedAt ? new Date(publishedAt).toISOString() : undefined,
  dateModified: modifiedAt ? new Date(modifiedAt).toISOString() : undefined,
  url: canonical,
  image: ogImage ? [ogImage] : undefined,
  author: jsonLdAuthor,
  publisher: { "@type": "Organization", name: settings.brandName || "WitchClick" },
};
---

<Base title={title} description={description} canon={canonical} wide={true} ogImage={ogImage}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    {publishedAt && (
      <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />
    )}
    {modifiedAt && (
      <meta property="article:modified_time" content={new Date(modifiedAt).toISOString()} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="grimoire-bg min-h-screen">
    <section class="post-canvas mx-auto max-w-6xl px-4 py-12 lg:py-16">
      <div class="post-panel panel">
        <div class="post-layout grid grid-cols-1 lg:grid-cols-12">
          <article class="post-article prose prose-neutral max-w-none lg:col-span-8">
            {heroImage && (
              <figure class="mb-6 overflow-hidden rounded-3xl border border-purple-100 bg-purple-50 shadow-sm">
                <img
                  src={heroImage}
                  alt={heroAlt}
                  loading="eager"
                  class="h-auto w-full object-cover"
                />
              </figure>
            )}
            <h1 class="mb-2">{title}</h1>
            <p class="post-meta mt-0 mb-4 text-sm">
              {publishedAt && (
                <time datetime={new Date(publishedAt).toISOString()}>
                  {new Date(publishedAt).toLocaleDateString(undefined, {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              )}
              {(publishedAt || readingMinutes) && <span> · </span>}
              {readingMinutes && <span>{readingMinutes} minute read</span>}
            </p>

            {authorLinks.length > 0 && (
              <p class="post-byline">
                By
                {authorLinks.map((author, index) => (
                  <Fragment>
                    {index > 0 &&
                      (authorLinks.length === 2 ? (
                        <span class="post-byline__separator">&nbsp;&amp;&nbsp;</span>
                      ) : index === authorLinks.length - 1 ? (
                        <span class="post-byline__separator">,&nbsp;&amp;&nbsp;</span>
                      ) : (
                        <span class="post-byline__separator">,&nbsp;</span>
                      ))}
                    {author.href ? (
                      <a class="post-byline__link" href={author.href}>
                        {author.label}
                      </a>
                    ) : (
                      <span class="post-byline__name">{author.label}</span>
                    )}
                  </Fragment>
                ))}
              </p>
            )}

            <div class="mb-6 flex flex-wrap gap-2 text-xs uppercase tracking-wide text-purple-600">
              {Array.isArray(data.tags) &&
                data.tags.map((tag: any) => (
                  <span class="rounded-full border border-purple-200 bg-purple-50 px-3 py-0.5">#{String(tag).toLowerCase()}</span>
                ))}
            </div>

            {hasTldr && (
              <Accordion title="TL;DR" open={true}>
                {tldrSummary && <p class="wc-accordion__lead">{tldrSummary}</p>}
                {tldrItems.length > 0 && (
                  <ul class="wc-accordion__list">
                    {tldrItems.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </Accordion>
            )}

            {productRecommendations.length > 0 && (
              <ProductRecommendations products={productRecommendations} class="mb-8" />
            )}

            <div class="prose prose-neutral max-w-none" set:html={html} />

            <Disclosure show={hasAffiliates} />

            {Array.isArray(data.downloadId) ? null : data.downloadId ? (
              <DownloadCard id={String(data.downloadId)} />
            ) : null}

            <AdSlot slot="end" class="mt-10" />

            {authorsWithProfiles.length > 0 && (
              <section class="post-author-spotlights">
                <h2 class="post-author-spotlights__title">About the author{authorsWithProfiles.length > 1 ? "s" : ""}</h2>
                <div class="post-author-spotlights__grid">
                  {authorsWithProfiles.map((author) => (
                    <AuthorSpotlight author={author} compact={true} />
                  ))}
                </div>
              </section>
            )}
          </article>

          <aside class="post-sidebar lg:col-span-4 lg:pl-6">
            <div class="sticky top-24 space-y-6">
              <AdSlot slot="side" />
              <CtaFooter type={ctaType} id={ctaId} />
              {resolvedEntities.length > 0 && (
                <section class="post-entities soft-card">
                  <h2 class="post-entities-title">Referenced entities</h2>
                  <ul class="post-entities-list">
                    {resolvedEntities.map((entity: any) => (
                      <li>
                        <a class="post-entities-link" href={entity.href}>
                          {entity.name}
                        </a>
                        {entity.description && <p class="post-entities-summary">{entity.description}</p>}
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          </aside>
        </div>
      </div>

      <RelatedPosts currentSlug={effectiveSlug} tags={data.tags || []} prev={prev} next={next} />
      <CommentsSection slug={effectiveSlug} title={title} />
    </section>
  </div>
</Base>

<style>
  .post-canvas {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .post-panel {
    padding: clamp(1.85rem, 4.5vw, 2.85rem);
    color: var(--ink-body, currentColor);
  }

  .post-layout {
    align-items: start;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }

  .post-article h1 {
    color: var(--ink-strong, currentColor);
  }

  .post-meta {
    color: color-mix(in srgb, var(--ink-muted, currentColor) 82%, white 18%);
  }

  .post-byline {
    margin: -0.35rem 0 1.75rem;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 80%, white 20%);
  }

  .post-byline__link {
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 65%, var(--ink-strong, currentColor) 35%);
    font-weight: 600;
    text-decoration: none;
  }

  .post-byline__link:hover,
  .post-byline__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-byline__name {
    font-weight: 600;
  }

  .post-byline__separator {
    color: color-mix(in srgb, var(--ink-muted, currentColor) 80%, white 20%);
  }

  .post-sidebar .soft-card {
    padding: clamp(1.4rem, 3.5vw, 1.95rem);
    display: grid;
    gap: 0.9rem;
  }

  .post-entities-title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 68%, var(--ink-body, currentColor) 32%);
  }

  .post-entities-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--ink-body, currentColor) 88%, white 12%);
  }

  .post-entities-link {
    font-weight: 600;
    color: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 70%, var(--ink-strong, currentColor) 30%);
    text-decoration: none;
  }

  .post-entities-link:hover,
  .post-entities-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-author-spotlights {
    margin-top: clamp(2.75rem, 6vw, 3.75rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid color-mix(in srgb, rgba(148, 163, 184, 0.22) 70%, white 30%);
    display: grid;
    gap: 1.5rem;
  }

  .post-author-spotlights__title {
    margin: 0;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    font-weight: 700;
    color: color-mix(in srgb, var(--ink-strong, currentColor) 88%, white 12%);
  }

  .post-author-spotlights__grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  @media (min-width: 720px) {
    .post-author-spotlights__grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }

  .post-entities-summary {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--ink-muted, currentColor) 80%, white 20%);
  }

  @media (min-width: 1024px) {
    .post-sidebar .soft-card {
      position: relative;
    }
  }
</style>
