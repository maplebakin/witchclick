---
// src/pages/post/[slug].astro — drop‑in replacement with Entities sidebar + Ko‑fi CTA randomizer
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import Disclosure from "../../components/Disclosure.astro";
import DownloadCard from "../../components/DownloadCard.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import CtaFooter from "../../components/CtaFooter.astro";
import ProductRecommendations from "../../components/ProductRecommendations.astro";
import CommentsSection from "../../components/CommentsSection.astro";
import AuthorSpotlight from "../../components/AuthorSpotlight.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { readEntity } from "../../utils/entities";
import { Fragment } from "astro/jsx-runtime";
import SpoonsBadge from "../../components/SpoonsBadge.astro";

import fs from "node:fs";
import path from "node:path";
import { marked } from "marked";
import createDOMPurify from "dompurify";
import { JSDOM } from "jsdom";

import { autoLinkAffiliates } from "../../../tools/src/auto-affiliate";
import { readSettings, getSiteOrigin, toAbsoluteUrl } from "../../utils/settings";
import { normalizeSpoonLevel } from "../../utils/augment";
import {
  loadAllPosts,
  estimateReadingMinutes,
  firstParagraph,
  extractAuthorSlugs,
} from "../../utils/posts";
import { getAuthorBySlug, normalizeAuthorSlug, type AuthorProfile } from "../../utils/authors";

const dom = new JSDOM("<body></body>");
const DOMPurify = createDOMPurify(dom.window);

export const prerender = true;

type PostData = Record<string, any>;
type PrevNext = { slug: string; title: string } | null;

export async function getStaticPaths() {
  const posts = loadAllPosts();

  return posts.map((post, index) => {
    const prev = posts[index - 1]
      ? { slug: posts[index - 1].slug, title: posts[index - 1].title }
      : null;
    const next = posts[index + 1]
      ? { slug: posts[index + 1].slug, title: posts[index + 1].title }
      : null;

    return {
      params: { slug: post.slug },
      props: {
        data: post.data,
        content: post.content,
        effectiveSlug: post.slug,
        prev,
        next,
        tldr: post.tldr,
        spoons: post.spoons,
      },
    };
  });
}

const {
  data = {} as PostData,
  content = "",
  effectiveSlug = Astro.params.slug as string,
  prev = null as PrevNext,
  next = null as PrevNext,
  tldr: injectedTldr,
  spoons: injectedSpoons,
} = Astro.props;

const settings = readSettings();
const siteOrigin = getSiteOrigin(settings) || "https://example.com";
const title = data.title ?? "Untitled";
const description =
  data.metaDescription ?? data.description ?? data.excerpt ?? firstParagraph(content);

const publishedAt = data.publishedAt ?? data.pubDate ?? data.date ?? undefined;
const modifiedAt = data.updatedAt ?? publishedAt ?? undefined;
const canonical = `${siteOrigin}/post/${effectiveSlug}`;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Archive", href: "/page/1" },
  { label: title },
];

const readingMinutes = data.readingMinutes ?? estimateReadingMinutes(content);

const htmlRaw = marked.parse(content || "");
let html = DOMPurify.sanitize(String(htmlRaw), { USE_PROFILES: { html: true } });

const heroImage = typeof data.heroImage === "string" ? data.heroImage.trim() : "";
const heroAlt =
  typeof data.heroAlt === "string" && data.heroAlt.trim().length
    ? data.heroAlt.trim()
    : title;

const providedTldr =
  typeof data.tldr === "string"
    ? data.tldr
    : typeof injectedTldr === "string"
      ? injectedTldr
      : "";
const tldr = providedTldr.trim();

const spoonsRaw = data.spoons ?? data.spoonLevel ?? injectedSpoons ?? null;
const spoonLevel = normalizeSpoonLevel(spoonsRaw);

let ctaType: "kofi" | "download" | "none" = "none";
let ctaId: string | undefined;

if (data && typeof data === "object") {
  if (data.downloadId) {
    ctaType = "download";
    ctaId = String(data.downloadId);
  } else if (data.includeKofi) {
    ctaType = "kofi";
  }
}

const productsFilePath = "./content/products.json";
const productsDoc = fs.existsSync(productsFilePath)
  ? JSON.parse(fs.readFileSync(productsFilePath, "utf8"))
  : { products: [] };
const allProducts = Array.isArray(productsDoc) ? productsDoc : productsDoc.products || [];

const postTagsRaw = Array.isArray(data.tags)
  ? data.tags
  : typeof data.tags === "string"
    ? data.tags.split(",")
    : [];

const postTags = Array.from(
  new Set(
    postTagsRaw
      .map((tag: any) => String(tag ?? "").split(","))
      .flat()
      .map((tag: string) => tag.trim().toLowerCase())
      .filter(Boolean),
  ),
);

const productRecommendations = (postTags.length
  ? allProducts.filter((product: any) => {
      if (!product || typeof product !== "object") return false;
      const tags = Array.isArray(product.tags)
        ? product.tags
            .map((tag: any) => String(tag ?? "").trim().toLowerCase())
            .filter(Boolean)
        : [];
      if (tags.length === 0) return false;
      return tags.some((tag: string) => postTags.includes(tag));
    })
  : [])
  .filter((product: any, index: number, list: any[]) => {
    const key = product?.key ? String(product.key) : null;
    if (!key) return true;
    return index === list.findIndex((item: any) => item?.key && String(item.key) === key);
  });

const authorEntriesRaw: unknown[] = [];
if (Array.isArray((data as any).authors)) {
  authorEntriesRaw.push(...((data as any).authors as unknown[]));
}
if ((data as any).author) {
  authorEntriesRaw.push((data as any).author);
}

type PageAuthor = { slug: string; name: string; profile: AuthorProfile | null };

const authorSlugs = extractAuthorSlugs(data ?? {});
const seenAuthorSlugs = new Set<string>();

const pageAuthors: PageAuthor[] = authorSlugs
  .filter((slug) => {
    if (!slug) return false;
    if (seenAuthorSlugs.has(slug)) return false;
    seenAuthorSlugs.add(slug);
    return true;
  })
  .map((slug) => {
    const profile = getAuthorBySlug(slug);
    let label = profile?.name ?? "";

    if (!label) {
      const match = authorEntriesRaw.find((entry) => {
        if (!entry) return false;
        if (typeof entry === "string") {
          return normalizeAuthorSlug(entry) === slug;
        }

        if (typeof entry === "object") {
          const record = entry as Record<string, any>;
          if (typeof record.slug === "string" && normalizeAuthorSlug(record.slug) === slug) {
            return true;
          }
          if (typeof record.name === "string" && normalizeAuthorSlug(record.name) === slug) {
            return true;
          }
        }

        return false;
      });

      if (typeof match === "string") {
        label = match;
      } else if (match && typeof match === "object") {
        const record = match as Record<string, any>;
        if (typeof record.name === "string" && record.name.trim()) {
          label = record.name;
        } else if (typeof record.title === "string" && record.title.trim()) {
          label = record.title;
        }
      }
    }

    if (!label) {
      label = slug
        .split("-")
        .filter(Boolean)
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(" ");
    }

    return { slug, name: label, profile } satisfies PageAuthor;
  });

const authorLinks = pageAuthors.map((author) => ({
  href: author.profile ? `/author/${author.profile.slug}/` : null,
  label: author.name,
  slug: author.slug,
}));

const authorsWithProfiles = pageAuthors
  .map((author) => author.profile)
  .filter((profile): profile is AuthorProfile => Boolean(profile));

const jsonLdAuthors = pageAuthors
  .map((author) => ({
    "@type": "Person",
    name: author.name,
    url: author.profile ? `${siteOrigin}/author/${author.profile.slug}` : undefined,
    description: author.profile?.bio,
  }))
  .filter((person) => Boolean(person.name));

const jsonLdAuthor =
  jsonLdAuthors.length === 0
    ? { "@type": "Organization", name: settings.brandName || "WitchClick" }
    : jsonLdAuthors.length === 1
      ? jsonLdAuthors[0]
      : jsonLdAuthors;

const ogCandidate = path.join(process.cwd(), "public", "og", `${effectiveSlug}.jpg`);
const ogImage = data.ogImage
  ? toAbsoluteUrl(data.ogImage, settings)
  : fs.existsSync(ogCandidate)
    ? `${siteOrigin}/og/${effectiveSlug}.jpg`
    : "";

let hasAffiliates = false;

const frontAnchors = Array.isArray(data.affiliateAnchors) ? data.affiliateAnchors : [];
if (frontAnchors.length > 0) {
  const declared = frontAnchors
    .map((a: any) => ({ key: String(a.key || ""), text: String(a.text || "") }))
    .filter((a: any) => a.key && a.text);

  for (const d of declared) {
    const prod = allProducts.find((p: any) => String(p.key) === d.key);
    if (!prod || !prod.url) continue;
    const { html: nextHtml, count } = autoLinkAffiliates(html, [{ ...prod }], { maxLinksPerPost: 1 });
    if (count > 0 && nextHtml !== html) {
      html = nextHtml;
      hasAffiliates = true;
    }
  }
} else {
  const { html: nextHtml, count } = autoLinkAffiliates(html, allProducts, { maxLinksPerPost: 3 });
  if (count > 0) {
    html = nextHtml;
    hasAffiliates = true;
  }
}

const entList = Array.isArray(data.entities) ? data.entities : [];
const resolvedEntities = entList
  .map((e: any) => {
    const entity = readEntity(String(e.type || ""), String(e.slug || ""));
    if (!entity) return null;

    return {
      ...entity,
      href: `/entities/${entity.type}/${entity.slug}`,
      description: entity.summary,
    };
  })
  .filter(Boolean);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  abstract: tldr || undefined,
  datePublished: publishedAt ? new Date(publishedAt).toISOString() : undefined,
  dateModified: modifiedAt ? new Date(modifiedAt).toISOString() : undefined,
  url: canonical,
  image: ogImage ? [ogImage] : undefined,
  author: jsonLdAuthor,
  publisher: { "@type": "Organization", name: settings.brandName || "WitchClick" },
};
---

<Base title={title} description={description} canon={canonical} wide={true} ogImage={ogImage}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    {publishedAt && (
      <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />
    )}
    {modifiedAt && (
      <meta property="article:modified_time" content={new Date(modifiedAt).toISOString()} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />

  <div class="grimoire-bg">
    <div class="post-shell">
      <div class="post-layout">
        <article class="post-article" aria-labelledby="post-title">
          <header class="post-hero">
            <div class:list={["post-hero__layout", !heroImage && "post-hero__layout--text"]}>
              {heroImage && (
                <figure class="post-hero__media">
                  <img src={heroImage} alt={heroAlt} loading="eager" />
                </figure>
              )}
              <div class="post-hero__content">
                <p class="post-hero__meta">
                  {publishedAt && (
                    <time datetime={new Date(publishedAt).toISOString()}>
                      {new Date(publishedAt).toLocaleDateString(undefined, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                  )}
                  {(publishedAt || readingMinutes) && <span aria-hidden="true">•</span>}
                  {readingMinutes && <span>{readingMinutes} minute read</span>}
                </p>

                <h1 id="post-title" class="post-hero__title">{title}</h1>

                {authorLinks.length > 0 && (
                  <p class="post-byline">
                    By
                    {authorLinks.map((author, index) => (
                      <Fragment key={author.slug || author.label}>
                        {index > 0 &&
                          (authorLinks.length === 2 ? (
                            <span class="post-byline__separator">&nbsp;&amp;&nbsp;</span>
                          ) : index === authorLinks.length - 1 ? (
                            <span class="post-byline__separator">,&nbsp;&amp;&nbsp;</span>
                          ) : (
                            <span class="post-byline__separator">,&nbsp;</span>
                          ))}
                        {author.href ? (
                          <a class="post-byline__link" href={author.href}>
                            {author.label}
                          </a>
                        ) : (
                          <span class="post-byline__name">{author.label}</span>
                        )}
                      </Fragment>
                    ))}
                  </p>
                )}

                {Array.isArray(data.tags) && data.tags.length > 0 && (
                  <ul class="post-tags">
                    {data.tags.map((tag: any) => (
                      <li>
                        <span>#{String(tag).toLowerCase()}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {(spoonLevel || tldr) && (
                  <div class="post-callouts">
                    {spoonLevel && <SpoonsBadge level={spoonLevel} class="post-callouts__badge" />}
                    {tldr && (
                      <aside class="post-callouts__summary" aria-label="TL;DR">
                        <span class="post-callouts__label">TL;DR</span>
                        <p>{tldr}</p>
                      </aside>
                    )}
                  </div>
                )}
              </div>
            </div>
          </header>

          {productRecommendations.length > 0 && (
            <ProductRecommendations products={productRecommendations} class="post-product-recs" />
          )}

          <div class="post-body panel">
            <div class="post-body__content prose prose-neutral max-w-none" set:html={html} />

            <Disclosure show={hasAffiliates} />

            {Array.isArray(data.downloadId) ? null : data.downloadId ? (
              <DownloadCard id={String(data.downloadId)} />
            ) : null}

            <AdSlot slot="end" class="post-body__ad" />

            {authorsWithProfiles.length > 0 && (
              <section class="post-authors">
                <h2 class="post-authors__title">About the author{authorsWithProfiles.length > 1 ? "s" : ""}</h2>
                <div class="post-authors__grid">
                  {authorsWithProfiles.map((author) => (
                    <AuthorSpotlight author={author} compact={true} key={author.slug} />
                  ))}
                </div>
              </section>
            )}
          </div>
        </article>

        <aside class="post-sidebar" aria-label="Post sidebar">
          <div class="post-sidebar__stack">
            <div class="post-sidebar__card soft-card">
              <AdSlot slot="side" />
            </div>
            <CtaFooter type={ctaType} id={ctaId} />
            {resolvedEntities.length > 0 && (
              <section class="post-entities soft-card">
                <h2 class="post-entities__title">Referenced entities</h2>
                <ul class="post-entities__list">
                  {resolvedEntities.map((entity: any) => (
                    <li key={entity.href}>
                      <a class="post-entities__link" href={entity.href}>
                        {entity.name}
                      </a>
                      {entity.description && <p class="post-entities__summary">{entity.description}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </aside>
      </div>

      <div class="post-related panel">
        <RelatedPosts currentSlug={effectiveSlug} tags={data.tags || []} prev={prev} next={next} />
      </div>

      <div class="post-comments panel">
        <CommentsSection slug={effectiveSlug} title={title} />
      </div>
    </div>
  </div>
</Base>

<style>
  .post-shell {
    width: min(1100px, 100%);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 3.5rem) clamp(4rem, 8vw, 6rem);
    display: grid;
    gap: clamp(2.5rem, 6vw, 3.75rem);
    min-height: 100vh;
    --post-text-strong: color-mix(in srgb, var(--ink-strong, #f4f1ff) 96%, white 4%);
    --post-text-body: color-mix(in srgb, var(--ink-body, #f4f1ff) 96%, white 4%);
    --post-text-muted: color-mix(in srgb, var(--ink-muted, #d7c8f3) 92%, white 8%);
    --post-text-inverse-strong: color-mix(in srgb, white 96%, var(--ink-strong, #f4f1ff) 4%);
    --post-text-inverse-body: color-mix(in srgb, white 90%, var(--ink-body, #f4f1ff) 10%);
    --post-text-inverse-muted: color-mix(in srgb, var(--post-text-inverse-body) 78%, white 22%);
    --post-accent-strong: color-mix(
      in srgb,
      var(--ambient-color, hsl(270 60% 62%)) 48%,
      var(--post-text-strong) 52%
    );
    --post-accent-inverse: color-mix(
      in srgb,
      var(--ambient-color, hsl(270 60% 62%)) 55%,
      var(--post-text-inverse-strong) 45%
    );
    color: var(--post-text-body, var(--ink-body, #1f1633));
  }

  :root[data-comfort-theme="dawn"] .post-shell {
    --post-text-strong: color-mix(in srgb, var(--ink-strong, #2c1b3d) 94%, black 6%);
    --post-text-body: color-mix(in srgb, var(--ink-body, #3a274f) 92%, black 8%);
    --post-text-muted: color-mix(in srgb, var(--ink-muted, #5b4c69) 88%, black 12%);
    --post-text-inverse-strong: color-mix(
      in srgb,
      white 96%,
      var(--ambient-color, hsl(270 60% 62%)) 4%
    );
    --post-text-inverse-body: color-mix(
      in srgb,
      white 90%,
      var(--ambient-color, hsl(270 60% 62%)) 10%
    );
    --post-text-inverse-muted: color-mix(in srgb, var(--post-text-inverse-body) 80%, white 20%);
    --post-accent-strong: color-mix(
      in srgb,
      var(--ambient-color, hsl(270 60% 62%)) 42%,
      var(--post-text-strong) 58%
    );
    --post-accent-inverse: color-mix(
      in srgb,
      var(--ambient-color, hsl(270 60% 62%)) 58%,
      var(--post-text-inverse-strong) 42%
    );
  }

  .post-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 3.25rem);
  }

  @media (min-width: 1024px) {
    .post-layout {
      grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr);
      align-items: start;
      gap: clamp(2.5rem, 5vw, 3.5rem);
    }
  }

  .post-article {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .post-hero {
    position: relative;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: clamp(1.85rem, 4vw, 2.75rem);
    border: 1px solid color-mix(in srgb, var(--panel-border-strong, rgba(124, 58, 237, 0.35)) 80%, transparent 20%);
    background:
      radial-gradient(
        135% 120% at 8% -12%,
        color-mix(in srgb, var(--ambient-color, hsl(270 60% 62%)) 18%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        120% 120% at 95% -18%,
        color-mix(in srgb, rgba(255, 255, 255, 0.7) 65%, transparent) 0%,
        transparent 74%
      ),
      linear-gradient(
        170deg,
        color-mix(in srgb, white 94%, var(--ambient-color, hsl(270 60% 62%)) 6%) 0%,
        color-mix(in srgb, white 88%, var(--ambient-color, hsl(270 60% 62%)) 12%) 100%
      );
    box-shadow: 0 28px 70px -36px color-mix(in srgb, var(--ambient-color, hsl(270 60% 62%)) 32%, transparent 68%);
    overflow: hidden;
  }

  .post-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.4), transparent 65%);
    mix-blend-mode: screen;
    opacity: 0.4;
    pointer-events: none;
  }

  .post-hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .post-hero__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .post-hero__layout--text {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .post-hero__media {
    position: relative;
    border-radius: clamp(1.5rem, 3.5vw, 2.25rem);
    overflow: hidden;
    box-shadow: 0 26px 50px -32px rgba(17, 24, 39, 0.25);
    border: 1px solid color-mix(in srgb, rgba(124, 58, 237, 0.28) 80%, transparent 20%);
  }

  .post-hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-hero__content {
    display: grid;
    gap: clamp(1rem, 3vw, 1.75rem);
    color: var(--post-text-body);
  }

  .post-hero__meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--post-text-muted);
  }

  .post-hero__meta span[aria-hidden="true"] {
    font-size: 0.7rem;
    opacity: 0.6;
  }

  .post-hero__title {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 3.35rem);
    line-height: 1.08;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--post-text-strong);
  }

  .post-byline {
    margin: -0.25rem 0 0;
    font-size: 0.95rem;
    color: var(--post-text-body);
  }

  .post-byline__link {
    color: var(--post-accent-strong);
    font-weight: 600;
    text-decoration: none;
  }

  .post-byline__link:hover,
  .post-byline__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-byline__name {
    font-weight: 600;
  }

  .post-byline__separator {
    color: var(--post-text-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-tags li span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: color-mix(in srgb, rgba(124, 58, 237, 0.14) 82%, rgba(255, 255, 255, 0.92) 18%);
    border: 1px solid color-mix(in srgb, rgba(124, 58, 237, 0.3) 80%, transparent 20%);
    color: var(--post-text-strong);
  }

  .post-callouts {
    display: grid;
    gap: 1rem;
    align-items: start;
  }

  @media (min-width: 640px) {
    .post-callouts {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1.5rem;
    }

    .post-callouts__badge {
      align-self: start;
    }
  }

  .post-callouts__summary {
    margin: 0;
    padding: clamp(1.2rem, 3vw, 1.75rem);
    border-radius: clamp(1.35rem, 3vw, 1.8rem);
    background:
      radial-gradient(
        130% 120% at 12% -8%,
        color-mix(in srgb, rgba(255, 255, 255, 0.88) 92%, rgba(124, 58, 237, 0.14) 8%) 0%,
        transparent 75%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, rgba(255, 255, 255, 0.94) 92%, rgba(124, 58, 237, 0.08) 8%) 0%,
        color-mix(in srgb, rgba(255, 255, 255, 0.88) 90%, rgba(124, 58, 237, 0.16) 10%) 100%
      );
    border: 1px solid color-mix(in srgb, rgba(124, 58, 237, 0.22) 78%, transparent 22%);
