---
// src/pages/post/[slug].astro
import fs from 'node:fs';
import path from 'node:path';
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import Disclosure from "../../components/Disclosure.astro";
import DownloadCard from "../../components/DownloadCard.astro";
import ProductRecommendations from "../../components/ProductRecommendations.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostRail from "../../components/PostRail.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import TldrCallout from "../../components/TldrCallout.astro";
import BackToTop from "../../components/BackToTop.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import HeadSlot from "@/components/HeadSlot.astro";
import { readSettings, buildCanonicalUrl, getSiteOrigin } from "../../utils/settings";
import { normalizeSpoonLevel } from "../../utils/augment";
import { getAuthorBySlug, normalizeAuthorSlug, type AuthorProfile } from "../../utils/authors";
import { readEntity } from "../../utils/entities";


export const prerender = true;

export async function getStaticPaths() {
  const CACHE_DIR = path.join(process.cwd(), '.cache/post-data');
  if (!fs.existsSync(CACHE_DIR)) {
    return [];
  }
  const files = fs.readdirSync(CACHE_DIR);
  return files.map((file) => ({
    params: { slug: file.replace(/\.json$/, '') },
  }));
}

const { slug } = Astro.params;
const CACHE_DIR = path.join(process.cwd(), '.cache/post-data');
const postFilePath = path.join(CACHE_DIR, `${slug}.json`);

if (!fs.existsSync(postFilePath)) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found'
  });
}

const post = JSON.parse(fs.readFileSync(postFilePath, 'utf-8'));

const {
  data,
  content: html,
  hasAffiliates,
  relatedPosts: recommendations,
  headingOutline,
} = post;

const effectiveSlug = post.slug;
const reflectionPrompts = Array.isArray(data.reflectionPrompts) ? data.reflectionPrompts : [];

const settings = readSettings();
const showEndAd = Boolean(settings.ads?.provider) && data.includeAds !== false;
const siteOrigin = getSiteOrigin(settings);
const title = data.title ?? "Untitled";
const description = data.metaDescription ?? data.description ?? data.excerpt ?? '';

const publishedAt = data.publishedAt ?? data.pubDate ?? data.date ?? undefined;
const modifiedAt = data.updatedAt ?? publishedAt ?? undefined;
const canonical = buildCanonicalUrl(settings, { path: `/post/${effectiveSlug}` });

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Archive", href: "/page/1" },
  { label: title },
];

const readingMinutes = data.readingMinutes;
const spoonLevel = normalizeSpoonLevel(data.spoons ?? data.spoonLevel);
const tldr = data.tldr || '';
const heroImage = data.heroImage || '';
const heroAlt = data.heroAlt || title;

let ctaType: "kofi" | "download" | "none" = "none";
let ctaId: string | undefined;

if (data.downloadId) {
  ctaType = "download";
  ctaId = String(data.downloadId);
} else if (data.includeKofi) {
  ctaType = "kofi";
}

const authorSlugs = Array.isArray(data.authors) ? data.authors.map(s => normalizeAuthorSlug(s)) : [];
const pageAuthors = authorSlugs.map(slug => {
  const profile = getAuthorBySlug(slug);
  return {
    slug,
    name: profile?.name || slug,
    profile,
  }
});

const authorSegments = pageAuthors.map((author, index) => {
    let separator = null;
    if (index > 0) {
        separator = pageAuthors.length === 2 || index === pageAuthors.length - 1 ? 'ampersand' : 'comma';
    }
    return { ...author, href: author.profile ? `/author/${author.profile.slug}/` : null, label: author.name, separator };
});

const jsonLdAuthors = pageAuthors.map(author => ({
    "@type": "Person",
    name: author.name,
    url: author.profile ? `${siteOrigin}/author/${author.profile.slug}` : undefined,
}));

const jsonLdAuthor = jsonLdAuthors.length === 0 ? { "@type": "Organization", name: settings.brandName || "WitchClick" } : jsonLdAuthors.length === 1 ? jsonLdAuthors[0] : jsonLdAuthors;

const ogImage = data.ogImage ? toAbsoluteUrl(data.ogImage, settings) : `${siteOrigin}/og/${effectiveSlug}.jpg`;

const entList = Array.isArray(data.entities) ? data.entities : [];
const resolvedEntities = entList.map((e) => readEntity(String(e.type || ""), String(e.slug || ""))).filter(Boolean);
const railEntities = resolvedEntities.map((entity: any) => ({
  name: entity.name,
  href: `/entities/${entity.type}/${entity.slug}`,
  description: entity.summary,
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  abstract: tldr || undefined,
  datePublished: publishedAt ? new Date(publishedAt).toISOString() : undefined,
  dateModified: modifiedAt ? new Date(modifiedAt).toISOString() : undefined,
  url: canonical,
  image: ogImage ? [ogImage] : undefined,
  author: jsonLdAuthor,
  publisher: { "@type": "Organization", name: settings.brandName || "WitchClick" },
};
---

<Base title={title} description={description} canon={canonical} wide={true} ogImage={ogImage} ogType="article">
  <HeadSlot slot="head">
    {publishedAt && <meta property="article:published_time" content={new Date(publishedAt).toISOString()} />}
    {modifiedAt && <meta property="article:modified_time" content={new Date(modifiedAt).toISOString()} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </HeadSlot>

  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />

  <div class="flex w-full flex-col gap-12 px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
    <ReadingProgress target='[data-reading-target="article"]' />
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_320px] md:items-start">
      <article
        class="post-body flex min-w-0 flex-col gap-8 md:gap-10"
        aria-labelledby="post-title"
        data-reading-target="article"
      >
          <header class="card-panel card-tier-2 card-panel-strong card-panel-static overflow-hidden p-6 sm:p-8 lg:p-10">
            <div class:list={["flex flex-col gap-8 lg:gap-10", heroImage && "lg:flex-row lg:items-start"]}>
              {heroImage && (
                <figure class="relative aspect-[4/3] overflow-hidden rounded-xl border border-neutral-300/60 bg-neutral-100 shadow-sm lg:w-[42%]">
                  <img class="h-full w-full object-cover" src={heroImage} alt={heroAlt} loading="eager" />
                </figure>
              )}
              <div class="flex flex-1 flex-col gap-6">
                <p class="flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-widest text-neutral-500">
                  {publishedAt && <time datetime={new Date(publishedAt).toISOString()}>{new Date(publishedAt).toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" })}</time>}
                  {(publishedAt || readingMinutes) && <span aria-hidden="true">•</span>}
                  {readingMinutes && <span>{readingMinutes} minute read</span>}
                </p>

                <h1 id="post-title" class="font-serif text-3xl leading-tight sm:text-4xl lg:text-5xl text-body-strong">
                  {title}
                </h1>

                {authorSegments.length > 0 && (
                  <p class="flex flex-wrap items-center gap-y-2 text-sm text-neutral-600">
                    By
                    {authorSegments.map((author) => (
                      <span class="inline-flex items-center">
                        {author.separator === 'comma' && <span class="px-1">,</span>}
                        {author.separator === 'ampersand' && <span class="px-1">&amp;</span>}
                        <a class="font-semibold transition-colors hover:text-brand-primary" href={author.href}>{author.label}</a>
                      </span>
                    ))}
                  </p>
                )}

                {Array.isArray(data.tags) && data.tags.length > 0 && (
                  <ul class="mt-6 flex flex-wrap gap-2">
                    {data.tags.map((tag: any) => (
                      <li><span class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-600">#{String(tag).toLowerCase()}</span></li>
                    ))}
                  </ul>
                )}

                {(tldr || (data.tldrBullets && data.tldrBullets.length > 0) || spoonLevel) && (
                  <div class="mt-6">
                    <TldrCallout summary={tldr} bullets={data.tldrBullets || []} spoonLevel={spoonLevel} />
                  </div>
                )}
              </div>
            </div>
          </header>

          <div class="card-panel card-panel-strong card-panel-static flex flex-col gap-8 p-6 sm:p-8 lg:p-10">
            <div class="prose prose-lg max-w-none prose-headings:font-serif prose-a:text-brand-primary prose-blockquote:border-brand-primary/30" set:html={html} />
            <Disclosure show={hasAffiliates} />
            {ctaType === 'download' && ctaId && <DownloadCard id={ctaId} />}
            <ShareButtons title={title} url={canonical} />
          </div>
      </article>

      <PostRail
        recommendations={recommendations}
        entities={railEntities}
        toc={headingOutline}
        ctaType={ctaType}
        ctaId={ctaId}
      />
    </div>

    </div>
  <BackToTop />
</Base>
