---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Lost in the stacks — WitchClick"
  description="This WitchClick page could not be found. Return to a grounded ritual, reference, or search path."
  noindex={true}
>
  <section class="wc-section-shell mx-auto max-w-3xl py-16 text-center" aria-labelledby="missing-page-title">
    <p class="page-header__eyebrow">404 · a thread went missing</p>
    <h1 id="missing-page-title" class="page-header__title">Lost in the stacks</h1>
    <p class="page-header__lead mx-auto max-w-2xl">
      The page may have moved, or the path may have picked up an extra rune. Nothing is wrong with you. Choose a familiar doorway below.
    </p>
    <nav class="mt-8 flex flex-wrap justify-center gap-3" aria-label="404 recovery links">
      <a class="admin-btn-primary px-5 py-3" href="/search">Search WitchClick</a>
      <a class="admin-btn-secondary px-5 py-3" href="/start">Start here</a>
      <a class="admin-btn-secondary px-5 py-3" href="/hub">Rituals &amp; Spreads</a>
      <a class="admin-btn-secondary px-5 py-3" href="/entities">Grimoire</a>
    </nav>
  </section>
</Base>
