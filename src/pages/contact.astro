---
import Base from "../layouts/Base.astro";
import { readSettings, buildCanonicalUrl } from "../utils/settings";

const settings = readSettings();
const canonical = buildCanonicalUrl(settings, { path: "/contact" });
---
<Base
  title="Contact"
  description="How to reach the WitchClick team."
  canon={canonical}
>
  <article class="prose prose-neutral max-w-none">
    <h1>Contact</h1>
    <p>
      Questions or collaboration ideas? Email
      <a href="mailto:streamthreadsystems@gmail.com">streamthreadsystems@gmail.com</a>.
    </p>
    <p>We read every message and reply when we can.</p>
  </article>
</Base>
