---
export interface Props {
  // Either pass a whole post object (frontmatter-ish)...
  post?: {
    slug?: string
    title?: string
    excerpt?: string
    description?: string
    metaDescription?: string
    tags?: string[]
    readingMinutes?: number
    publishedAt?: string
    date?: string
  }
  // ...or pass these individually:
  href?: string
  title?: string
  excerpt?: string
  tags?: string[]
  readingMinutes?: number
  publishedAt?: string
}

const { post, href, title, excerpt, tags, readingMinutes, publishedAt } = Astro.props as Props

const link = href || (post?.slug ? `/post/${post.slug}` : '#')
const _title = (title ?? post?.title ?? 'Untitled')
const _excerpt = (excerpt ?? post?.excerpt ?? post?.description ?? post?.metaDescription ?? '')
const _tags: string[] = Array.isArray(tags ?? post?.tags) ? (tags ?? post?.tags) as string[] : []
const _mins = (readingMinutes ?? post?.readingMinutes) as number | undefined
const _publishedAt = (publishedAt ?? post?.publishedAt ?? post?.date) as string | undefined
const _dateLabel = formatDate(_publishedAt)

function formatDate(value?: string){
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(+date)) return '';
  return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
}
---
<a href={link} class="block rounded-2xl border border-purple-100/60 bg-white/70 p-5 shadow-sm transition hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-300">
  {_dateLabel && <p class="wc-smallcaps text-xs text-purple-500">{_dateLabel}</p>}
  <h3 class="wc-serif-heading mt-2 text-lg text-purple-900">{_title}</h3>
  {_excerpt && <p class="wc-sans-body mt-2 text-sm text-purple-700 line-clamp-3">{_excerpt}</p>}
  <div class="wc-smallcaps mt-4 flex flex-wrap gap-2 text-xs">
    {_mins && <span class="rounded-full border border-purple-200 bg-purple-50 px-2 py-0.5">⏱️ {_mins} min</span>}
    {_tags.slice(0, 6).map((t) => (
      <span class="rounded-full border border-purple-200 bg-purple-50 px-2 py-0.5">#{String(t).toLowerCase()}</span>
    ))}
  </div>
</a>
