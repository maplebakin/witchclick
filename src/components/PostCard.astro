---
export interface Props {
  // Either pass a whole post object (frontmatter-ish)...
  post?: {
    slug?: string
    title?: string
    excerpt?: string
    description?: string
    metaDescription?: string
    tags?: string[]
    readingMinutes?: number
    publishedAt?: string
    date?: string
  }
  // ...or pass these individually:
  href?: string
  title?: string
  excerpt?: string
  tags?: string[]
  readingMinutes?: number
}

const { post, href, title, excerpt, tags, readingMinutes } = Astro.props as Props

const link = href || (post?.slug ? `/post/${post.slug}` : '#')
const _title = (title ?? post?.title ?? 'Untitled')
const _excerpt = (excerpt ?? post?.excerpt ?? post?.description ?? post?.metaDescription ?? '')
const _tags: string[] = Array.isArray(tags ?? post?.tags) ? (tags ?? post?.tags) as string[] : []
const _mins = (readingMinutes ?? post?.readingMinutes) as number | undefined
---
<a href={link} class="block rounded-2xl border border-purple-100/60 bg-white/70 p-5 shadow-sm hover:shadow transition">
  <h3 class="text-lg font-semibold text-purple-900">{_title}</h3>
  {_excerpt && <p class="mt-2 text-sm text-purple-700">{_excerpt}</p>}
  <div class="mt-3 flex flex-wrap gap-2 text-xs">
    {_mins && <span class="rounded-full bg-purple-50 px-2 py-0.5 border border-purple-200">⏱️ {_mins} min</span>}
    {_tags.slice(0, 6).map((t) => (
      <span class="rounded-full bg-purple-50 px-2 py-0.5 border border-purple-200">#{String(t).toLowerCase()}</span>
    ))}
  </div>
</a>
