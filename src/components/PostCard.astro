---
import SpoonsBadge from "./SpoonsBadge.astro";
import { extractHeroImage } from "@/utils/posts";

export interface Props {
  // Either pass a whole post object (frontmatter-ish)...
  post?: {
    slug?: string
    title?: string
    excerpt?: string
    description?: string
    metaDescription?: string
    tags?: string[]
    readingMinutes?: number
    publishedAt?: string
    date?: string
    spoonLevel?: string
    spoons?: string
    tldr?: string
    heroImage?: unknown
    heroImageSrc?: unknown
    heroImageAlt?: unknown
    heroAlt?: unknown
    image?: unknown
    imageSrc?: unknown
    imageAlt?: unknown
    cardImage?: unknown
    cardImageAlt?: unknown
  }
  // ...or pass these individually:
  href?: string
  title?: string
  excerpt?: string
  tldr?: string
  tags?: string[]
  readingMinutes?: number
  publishedAt?: string
  spoonLevel?: string
  spoons?: string
  class?: string
  heroImage?: unknown
  heroImageSrc?: unknown
  heroImageAlt?: string
  heroAlt?: string
  image?: unknown
  imageSrc?: unknown
  imageAlt?: string
  cardImage?: unknown
  cardImageAlt?: string
  density?: "standard" | "compact"
}

const {
  post,
  href,
  title,
  excerpt,
  tldr,
  tags,
  readingMinutes,
  publishedAt,
  spoonLevel,
  spoons,
  class: className,
  heroImage,
  heroImageSrc,
  heroImageAlt,
  heroAlt,
  image,
  imageSrc,
  imageAlt,
  cardImage,
  cardImageAlt,
  density = "standard",
} = Astro.props as Props

const link = href || (post?.slug ? `/post/${post.slug}` : '#')
const _title = (title ?? post?.title ?? 'Untitled')
const _excerpt = (excerpt ?? post?.excerpt ?? post?.description ?? post?.metaDescription ?? '')
const _tags: string[] = Array.isArray(tags ?? post?.tags) ? (tags ?? post?.tags) as string[] : []
const _mins = (readingMinutes ?? post?.readingMinutes) as number | undefined
const _publishedAt = (publishedAt ?? post?.publishedAt ?? post?.date) as string | undefined
const _dateLabel = formatDate(_publishedAt)
const _spoonRaw = (spoons ?? spoonLevel ?? post?.spoons ?? post?.spoonLevel) as string | undefined
const _spoon = typeof _spoonRaw === 'string' ? normalizeSpoon(_spoonRaw) : ''
const _tldrRaw = typeof (tldr ?? post?.tldr) === 'string' ? String((tldr ?? post?.tldr) ?? '') : ''
const _summarySource = _tldrRaw.trim() ? _tldrRaw : _excerpt
const _summary = truncateSummary(_summarySource)

const heroContext = {
  ...(post && typeof post === 'object' ? post : {}),
  heroImage: heroImage ?? (post as any)?.heroImage,
  heroImageSrc: heroImageSrc ?? (post as any)?.heroImageSrc,
  heroImageAlt: heroImageAlt ?? (post as any)?.heroImageAlt,
  heroAlt: heroAlt ?? (post as any)?.heroAlt,
  image: image ?? (post as any)?.image,
  imageSrc: imageSrc ?? (post as any)?.imageSrc,
  imageAlt: imageAlt ?? (post as any)?.imageAlt,
  cardImage: cardImage ?? (post as any)?.cardImage,
  cardImageAlt: cardImageAlt ?? (post as any)?.cardImageAlt,
}

const heroImageData = extractHeroImage(heroContext)
const _heroSrc = typeof heroImageData.src === 'string' ? heroImageData.src : ''
const _heroAlt = typeof heroImageData.alt === 'string' && heroImageData.alt.trim() ? heroImageData.alt : _title
const _hasHero = Boolean(_heroSrc)

function formatDate(value?: string){
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(+date)) return '';
  return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
}

function normalizeSpoon(value: string | undefined | null): string {
  if (!value) return ''
  const normalized = String(value).trim().toLowerCase()
  return ['low', 'medium', 'high'].includes(normalized) ? normalized : ''
}

function truncateSummary(value: string | undefined | null, max = 120): string {
  const base = typeof value === 'string' ? value.replace(/\s+/g, ' ').trim() : ''
  if (!base) return ''
  if (base.length <= max) return base
  const slice = base.slice(0, max)
  const lastSpace = slice.lastIndexOf(' ')
  const safe = (lastSpace > 40 ? slice.slice(0, lastSpace) : slice).trim()
  if (!safe) return base.slice(0, max)
  return /[.!?…]$/.test(safe) ? safe : `${safe}…`
}
---
<a
  href={link}
  class:list={[
    "card-panel card-tier-1 card-panel-soft focus-visible:outline-none ritual-card",
    className,
    _spoon && `ritual-card--${_spoon}`,
    density === "compact" && "card-density-compact",
  ]}
  style={
    density === "compact"
      ? `--card-hover-translate: -0.2rem; --card-elevation-base: 0 16px 34px -24px rgba(11, 6, 20, 0.42); --card-elevation-hover: 0 20px 44px -26px rgba(11, 6, 20, 0.48); --card-elevation-active: 0 12px 24px -18px rgba(11, 6, 20, 0.38);`
      : undefined
  }
  data-spoon-level={_spoon || undefined}
>
  <span aria-hidden class="card-radial card-radial-top" />
  <span aria-hidden class="card-radial card-radial-bottom" />
  <div class="card-figure" data-has-image={_hasHero ? 'true' : undefined}>
    {_hasHero && (
      <img
        src={_heroSrc}
        alt={_heroAlt}
        loading="lazy"
        decoding="async"
        class="card-figure__media"
      />
    )}
  </div>
  <div class="card-body">
    {_spoon && <SpoonsBadge level={_spoon} />}
    {_dateLabel && (
      <div class="card-metadata">
        <span>{_dateLabel}</span>
        {_mins && <span>{_mins} min ritual</span>}
      </div>
    )}
    <div class="card-text">
      <h3 class="card-heading">{_title}</h3>
      {_summary && <p class="card-subtle">{_summary}</p>}
    </div>
    {_tags.length > 0 && (
      <div class="card-tags">
        {_tags.slice(0, 6).map((t) => (
          <span class="card-pill card-tag">#{String(t).toLowerCase()}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style is:inline>
  .card-density-compact .card-body {
    gap: var(--space-2, 0.5rem);
    padding: var(--space-3, 0.75rem) var(--space-3, 0.75rem) var(--space-4, 1rem);
  }

  .card-density-compact .card-text {
    gap: var(--space-1, 0.35rem);
  }

  .card-density-compact .card-heading {
    font-size: clamp(1.05rem, 2.8vw, 1.3rem);
  }

  .card-density-compact .card-subtle {
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .card-density-compact .card-tags {
    gap: var(--space-1, 0.35rem);
    margin-top: var(--space-2, 0.5rem);
  }

  .card-density-compact .card-pill {
    padding: 0.2rem 0.6rem;
    font-size: 0.7rem;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--card-tag-border) 65%, transparent 35%);
  }

  .card-density-compact .card-metadata {
    font-size: 0.78rem;
    gap: 0.35rem;
  }

  .card-density-compact .card-figure {
    margin: var(--space-3, 0.75rem) var(--space-3, 0.75rem) 0;
    border-radius: clamp(0.95rem, 2.8vw, 1.2rem);
  }

  .card-density-compact .card-radial {
    opacity: 0.48;
    filter: blur(1px);
  }

  .card-density-compact .card-panel::before {
    opacity: 0.28;
  }
</style>
