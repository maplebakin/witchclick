---
import SpoonsBadge from "./SpoonsBadge.astro";
import { extractHeroImage } from "@/utils/posts";
import { canonicalTagHref } from "@/utils/tags";

export interface Props {
  // Either pass a whole post object (frontmatter-ish)...
  post?: {
    slug?: string
    title?: string
    excerpt?: string
    description?: string
    metaDescription?: string
    tags?: string[]
    readingMinutes?: number
    publishedAt?: string
    date?: string
    spoonLevel?: string
    spoons?: string
    tldr?: string
    category?: string
    heroImage?: unknown
    heroImageSrc?: unknown
    heroImageAlt?: unknown
    heroAlt?: unknown
    image?: unknown
    imageSrc?: unknown
    imageAlt?: unknown
    cardImage?: unknown
    cardImageAlt?: unknown
  }
  // ...or pass these individually:
  href?: string
  title?: string
  excerpt?: string
  tldr?: string
  tags?: string[]
  readingMinutes?: number
  publishedAt?: string
  spoonLevel?: string
  spoons?: string
  category?: string
  class?: string
  heroImage?: unknown
  heroImageSrc?: unknown
  heroImageAlt?: string
  heroAlt?: string
  image?: unknown
  imageSrc?: unknown
  imageAlt?: string
  cardImage?: unknown
  cardImageAlt?: string
  layout?: 'default' | 'bento-featured' | 'bento-compact'
}

const {
  post,
  href,
  title,
  excerpt,
  tldr,
  tags,
  readingMinutes,
  publishedAt,
  spoonLevel,
  spoons,
  category,
  class: className,
  heroImage,
  heroImageSrc,
  heroImageAlt,
  heroAlt,
  image,
  imageSrc,
  imageAlt,
  cardImage,
  cardImageAlt,
  layout = 'default',
} = Astro.props as Props

const link = href || (post?.slug ? `/post/${post.slug}` : '#')
const _title = (title ?? post?.title ?? 'Untitled')
const _excerpt = (excerpt ?? post?.excerpt ?? post?.description ?? post?.metaDescription ?? '')
const _tags: string[] = Array.isArray(tags ?? post?.tags) ? (tags ?? post?.tags) as string[] : []
const _mins = (readingMinutes ?? post?.readingMinutes) as number | undefined
const _publishedAt = (publishedAt ?? post?.publishedAt ?? post?.date) as string | undefined
const _dateLabel = formatDate(_publishedAt)
const _spoonRaw = (spoons ?? spoonLevel ?? post?.spoons ?? post?.spoonLevel) as string | undefined
const _spoon = typeof _spoonRaw === 'string' ? normalizeSpoon(_spoonRaw) : ''
const _category = (category ?? post?.category ?? 'ritual') as string
const _showCategoryBadge = _category === 'meandering' // Only show badge for meanderings
const _tldrRaw = typeof (tldr ?? post?.tldr) === 'string' ? String((tldr ?? post?.tldr) ?? '') : ''
const _summarySource = _tldrRaw.trim() ? _tldrRaw : _excerpt
const _summary = truncateSummary(_summarySource)

const metadataItems = [
  _dateLabel,
  typeof _mins === 'number' && Number.isFinite(_mins) ? `${_mins} min read` : undefined,
].filter((value): value is string => Boolean(value))

const heroContext = {
  ...(post && typeof post === 'object' ? post : {}),
  heroImage: heroImage ?? (post as any)?.heroImage,
  heroImageSrc: heroImageSrc ?? (post as any)?.heroImageSrc,
  heroImageAlt: heroImageAlt ?? (post as any)?.heroImageAlt,
  heroAlt: heroAlt ?? (post as any)?.heroAlt,
  image: image ?? (post as any)?.image,
  imageSrc: imageSrc ?? (post as any)?.imageSrc,
  imageAlt: imageAlt ?? (post as any)?.imageAlt,
  cardImage: cardImage ?? (post as any)?.cardImage,
  cardImageAlt: cardImageAlt ?? (post as any)?.cardImageAlt,
}

const heroImageData = extractHeroImage(heroContext)
const _heroSrc = typeof heroImageData.src === 'string' ? heroImageData.src : ''
const _heroAlt = typeof heroImageData.alt === 'string' && heroImageData.alt.trim() ? heroImageData.alt : _title
const _hasHero = Boolean(_heroSrc)
const _cardLabel = _title ? `Read ${_title}` : 'Read post'
const _isCompact = layout === 'bento-compact'
const _isFeatured = layout === 'bento-featured'
const _visibleTags = _isCompact ? _tags.slice(0, 1) : _tags.slice(0, 6)

function formatDate(value?: string){
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(+date)) return '';
  return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
}

function normalizeSpoon(value: string | undefined | null): string {
  if (!value) return ''
  const normalized = String(value).trim().toLowerCase()
  return ['low', 'medium', 'high'].includes(normalized) ? normalized : ''
}

function truncateSummary(value: string | undefined | null, max = 120): string {
  const base = typeof value === 'string' ? value.replace(/\s+/g, ' ').trim() : ''
  if (!base) return ''
  if (base.length <= max) return base
  const slice = base.slice(0, max)
  const lastSpace = slice.lastIndexOf(' ')
  const safe = (lastSpace > 40 ? slice.slice(0, lastSpace) : slice).trim()
  if (!safe) return base.slice(0, max)
  return /[.!?…]$/.test(safe) ? safe : `${safe}…`
}
---
<article
  class:list={[
    "card-panel card-tier-1 card-panel-soft focus-visible:outline-none ritual-card",
    className,
    _spoon && `ritual-card--${_spoon}`,
    _isFeatured && "ritual-card--bento-featured",
    _isCompact && "ritual-card--bento-compact",
  ]}
  data-spoon-level={_spoon || undefined}
>
  <a href={link} class="ritual-card__overlay-link focus-ring" aria-label={_cardLabel}>
    <span class="sr-only">{_cardLabel}</span>
  </a>
  <span aria-hidden class="card-radial card-radial-top" />
  <span aria-hidden class="card-radial card-radial-bottom" />
  {!_isCompact && (
    <div class="card-figure" data-has-image={_hasHero ? 'true' : undefined}>
      {_hasHero && (
        <img
          src={_heroSrc}
          alt={_heroAlt}
          loading="lazy"
          decoding="async"
          class="card-figure__media"
        />
      )}
    </div>
  )}
  <div class="card-body">
    {!_isCompact && (
      <div class="card-badges">
        {_spoon && <SpoonsBadge level={_spoon} />}
        {_showCategoryBadge && (
          <span class="category-badge category-badge--meandering">
            meandering
          </span>
        )}
      </div>
    )}
    {!_isCompact && metadataItems.length > 0 && (
      <ul class="card-metadata">
        {metadataItems.map((item) => (
          <li class="card-metadata__item">{item}</li>
        ))}
      </ul>
    )}
    <div class="card-text">
      <h3 class="card-heading">{_title}</h3>
      {!_isCompact && _summary && <p class="card-subtle">{_summary}</p>}
    </div>
    {_visibleTags.length > 0 && (
      <div class="card-tags card-tags--linked">
        {_visibleTags.map((t) => (
          <a href={canonicalTagHref(String(t).toLowerCase())} class="card-pill card-tag" tabindex="-1">
            #{String(t).toLowerCase()}
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .ritual-card {
    position: relative;
  }

  .ritual-card__overlay-link {
    position: absolute;
    inset: 0;
    z-index: 10;
    border-radius: inherit;
  }

  .ritual-card > :not(.ritual-card__overlay-link) {
    pointer-events: none;
  }

  .ritual-card .card-tags--linked,
  .ritual-card .card-tags--linked * {
    pointer-events: auto;
  }

  .ritual-card .card-tags--linked {
    position: relative;
    z-index: 20;
  }

  .ritual-card--bento-featured .card-figure {
    aspect-ratio: 16 / 9;
  }

  .ritual-card--bento-featured .card-heading {
    font-size: clamp(1.45rem, 3vw, 1.9rem);
  }

  .ritual-card--bento-compact {
    grid-template-rows: 1fr;
  }

  .ritual-card--bento-compact .card-body {
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .ritual-card--bento-compact .card-heading {
    font-size: clamp(1rem, 2.1vw, 1.2rem);
  }

  .ritual-card--bento-compact .card-tags {
    margin-top: 0;
  }
</style>
