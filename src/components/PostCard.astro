---
export interface Props {
  // Either pass a whole post object (frontmatter-ish)...
  post?: {
    slug?: string
    title?: string
    excerpt?: string
    description?: string
    metaDescription?: string
    tags?: string[]
    readingMinutes?: number
    publishedAt?: string
    date?: string
  }
  // ...or pass these individually:
  href?: string
  title?: string
  excerpt?: string
  tags?: string[]
  readingMinutes?: number
  publishedAt?: string
  class?: string
}

const { post, href, title, excerpt, tags, readingMinutes, publishedAt, class: className } = Astro.props as Props

const link = href || (post?.slug ? `/post/${post.slug}` : '#')
const _title = (title ?? post?.title ?? 'Untitled')
const _excerpt = (excerpt ?? post?.excerpt ?? post?.description ?? post?.metaDescription ?? '')
const _tags: string[] = Array.isArray(tags ?? post?.tags) ? (tags ?? post?.tags) as string[] : []
const _mins = (readingMinutes ?? post?.readingMinutes) as number | undefined
const _publishedAt = (publishedAt ?? post?.publishedAt ?? post?.date) as string | undefined
const _dateLabel = formatDate(_publishedAt)

function formatDate(value?: string){
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(+date)) return '';
  return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
}
---
<a
  href={link}
  class:list={[
    "card-panel card-tier-1 card-panel-soft focus-visible:outline-none text-purple-900",
    className,
  ]}
>
  <span aria-hidden class="card-radial card-radial-top" />
  <span aria-hidden class="card-radial card-radial-bottom" />
  <div class="relative z-10 flex flex-col gap-4">
    {_dateLabel && <p class="card-eyebrow text-[var(--entity-label, rgba(88,28,135,0.65))]">{_dateLabel}</p>}
    <div class="space-y-2">
      <h3 class="card-heading text-lg font-semibold sm:text-xl">{_title}</h3>
      {_excerpt && <p class="card-subtle text-sm leading-relaxed line-clamp-3">{_excerpt}</p>}
    </div>
    <div class="mt-auto flex flex-wrap gap-2">
      {_mins && <span class="card-pill card-badge">⏱️ {_mins} min</span>}
      {_tags.slice(0, 6).map((t) => (
        <span class="card-pill card-tag">#{String(t).toLowerCase()}</span>
      ))}
    </div>
  </div>
</a>
