---
/**
 * AdminNav - Consistent navigation for all admin pages
 *
 * Props:
 * - currentPath: string - The current page path (e.g., "/admin/write")
 */

import "@/styles/admin.css";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navSections = [
  {
    label: "Content Creation",
    items: [
      { href: "/admin", label: "Generator", description: "Generate posts from prompts" },
      { href: "/admin/write", label: "Write", description: "Compose posts in markdown" },
      { href: "/admin/posts", label: "Posts", description: "Edit existing posts" },
    ]
  },
  {
    label: "Content Management",
    items: [
      { href: "/admin/entities", label: "Entities", description: "Manage crystals, herbs, tarot" },
      { href: "/admin/authors", label: "Authors", description: "Manage author profiles" },
      { href: "/admin/partners", label: "Partners", description: "Partner relationships" },
      { href: "/admin/calendar", label: "Calendar", description: "Editorial calendar" },
      { href: "/admin/downloads", label: "Downloads", description: "Digital downloads" },
    ]
  },
  {
    label: "Customization",
    items: [
      { href: "/admin/theme", label: "Theme", description: "Colors and typography" },
      { href: "/admin/hero", label: "Hero Images", description: "Upload hero images" },
      { href: "/admin/home", label: "Homepage", description: "Configure homepage" },
    ]
  },
  {
    label: "System",
    items: [
      { href: "/admin/products", label: "Products", description: "Affiliate products" },
      { href: "/admin/settings", label: "Settings", description: "Site configuration" },
    ]
  }
];

function isActive(itemPath: string, current: string): boolean {
  if (!current) return false;
  // Exact match for index
  if (itemPath === "/admin" && current === "/admin") return true;
  // Prefix match for other pages
  if (itemPath !== "/admin" && current.startsWith(itemPath)) return true;
  return false;
}

// Find current page info
let currentPageLabel = "Admin Panel";
let currentPageDescription = "";
for (const section of navSections) {
  for (const item of section.items) {
    if (isActive(item.href, currentPath)) {
      currentPageLabel = item.label;
      currentPageDescription = item.description;
      break;
    }
  }
}
---

<nav aria-label="Admin navigation" class="admin-nav" data-admin-nav>
  <div class="admin-nav-header">
    <button
      type="button"
      class="admin-nav-trigger"
      data-admin-trigger
      aria-expanded="false"
      aria-haspopup="true"
      aria-label="Open admin navigation menu"
    >
      <div class="admin-nav-trigger-content">
        <div class="admin-nav-trigger-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </div>
        <div class="admin-nav-trigger-text">
          <span class="admin-nav-trigger-label">{currentPageLabel}</span>
          <span class="admin-nav-trigger-description">{currentPageDescription}</span>
        </div>
        <svg class="admin-nav-trigger-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </button>

    <a href="/" class="admin-nav-home-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>View Site</span>
    </a>
  </div>

  <div class="admin-nav-dropdown" data-admin-dropdown>
    <div class="admin-nav-dropdown-content">
      {navSections.map((section) => (
        <div class="admin-nav-section">
          <h3 class="admin-nav-section-label">{section.label}</h3>
          <ul class="admin-nav-list">
            {section.items.map((item) => {
              const active = isActive(item.href, currentPath);
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={["admin-nav-link", { "admin-nav-link--active": active }]}
                    aria-current={active ? "page" : undefined}
                  >
                    <span class="admin-nav-link-label">{item.label}</span>
                    <span class="admin-nav-link-description">{item.description}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</nav>

<script>
  // Admin nav dropdown functionality
  function initAdminNav() {
    const nav = document.querySelector<HTMLElement>('[data-admin-nav]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-admin-trigger]');
    const dropdown = document.querySelector<HTMLElement>('[data-admin-dropdown]');

    if (!nav || !trigger || !dropdown) return;

    const navEl = nav;
    const triggerEl = trigger;
    const dropdownEl = dropdown;

    let isOpen = false;

    function openDropdown() {
      isOpen = true;
      navEl.classList.add('is-open');
      triggerEl.setAttribute('aria-expanded', 'true');
      dropdownEl.style.display = 'block';
      // Use requestAnimationFrame to ensure display:block is applied before adding the animation class
      requestAnimationFrame(() => {
        dropdownEl.classList.add('is-visible');
      });
    }

    function closeDropdown() {
      isOpen = false;
      navEl.classList.remove('is-open');
      triggerEl.setAttribute('aria-expanded', 'false');
      dropdownEl.classList.remove('is-visible');
      // Wait for transition to complete before hiding
      setTimeout(() => {
        if (!isOpen) {
          dropdownEl.style.display = 'none';
        }
      }, 200);
    }

    // Toggle handler
    triggerEl.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!isOpen) return;

      const target = e.target;
      if (!(target instanceof Node) || !navEl.contains(target)) {
        closeDropdown();
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDropdown();
        triggerEl.focus();
      }
    });
  }

  // Init on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdminNav);
  } else {
    initAdminNav();
  }
</script>

<style>
  .admin-nav {
    position: relative;
  }

  .admin-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-nav-trigger {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0;
    background: var(--admin-surface-base);
    border: 1px solid var(--admin-border-neutral);
    border-radius: 0.75rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .admin-nav-trigger:hover {
    background: var(--admin-surface-muted);
    border-color: var(--admin-border-strong);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
  }

  .admin-nav-trigger:focus-visible {
    outline: 2px solid var(--admin-accent);
    outline-offset: 2px;
  }

  .admin-nav.is-open .admin-nav-trigger {
    background: var(--admin-surface-hover);
    border-color: var(--admin-accent);
    box-shadow: 0 1px 3px 0 rgb(107 33 168 / 0.1);
  }

  .admin-nav-trigger-content {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
  }

  .admin-nav-trigger-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--admin-text-muted);
  }

  .admin-nav-trigger-text {
    flex: 1;
    min-width: 0;
    text-align: left;
  }

  .admin-nav-trigger-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--admin-text-primary);
    line-height: 1.25;
  }

  .admin-nav-trigger-description {
    display: block;
    font-size: 0.75rem;
    color: var(--admin-text-muted);
    line-height: 1.2;
  }

  .admin-nav-trigger-chevron {
    flex-shrink: 0;
    margin-right: 0.5rem;
    color: var(--admin-icon-muted);
    transition: transform 0.2s ease;
  }

  .admin-nav.is-open .admin-nav-trigger-chevron {
    transform: rotate(180deg);
  }

  .admin-nav-home-link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151;
    background: var(--admin-surface-base);
    border: 1px solid var(--admin-border-neutral);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .admin-nav-home-link:hover {
    background: var(--admin-surface-hover);
    color: var(--admin-text-primary);
    border-color: var(--admin-border-strong);
  }

  .admin-nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 50;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .admin-nav-dropdown.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .admin-nav-dropdown-content {
    background: var(--admin-surface-base);
    border: 1px solid var(--admin-border-subtle);
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
  }

  .admin-nav-section {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--admin-border-subtle);
  }

  .admin-nav-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .admin-nav-section-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
    margin: 0 0 0.25rem 0;
  }

  .admin-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .admin-nav-link {
    display: grid;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .admin-nav-link:hover {
    background: #f3f4f6;
    border-color: #d1d5db;
  }

  .admin-nav-link--active {
    background: #ede9fe;
    border-color: #a78bfa;
  }

  .admin-nav-link--active:hover {
    background: #ddd6fe;
    border-color: #8b5cf6;
  }

  .admin-nav-link-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
  }

  .admin-nav-link-description {
    font-size: 0.75rem;
    color: #4b5563;
    line-height: 1.2;
  }

  .admin-nav-link--active .admin-nav-link-label {
    color: #6b21a8;
  }

  .admin-nav-link--active .admin-nav-link-description {
    color: #7c3aed;
  }

  /* Responsive: grid on larger screens */
  @media (min-width: 768px) {
    .admin-nav-dropdown-content {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 1.5rem;
      padding: 1.25rem;
    }

    .admin-nav-section {
      padding-bottom: 0;
      margin-bottom: 0;
      border-bottom: none;
    }
  }

  @media (min-width: 1024px) {
    .admin-nav-dropdown-content {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
