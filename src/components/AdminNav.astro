---
/**
 * AdminNav - Consistent navigation for all admin pages
 *
 * Props:
 * - currentPath: string - The current page path (e.g., "/admin/write")
 */

import "@/styles/admin.css";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navSections = [
  {
    label: "Content Creation",
    items: [
      { href: "/admin", label: "Generator", description: "Generate posts from prompts" },
      { href: "/admin/write", label: "Write", description: "Compose posts in markdown" },
      { href: "/admin/posts", label: "Posts", description: "Edit existing posts" },
    ]
  },
  {
    label: "Content Management",
    items: [
      { href: "/admin/entities", label: "Entities", description: "Manage crystals, herbs, tarot" },
      { href: "/admin/authors", label: "Authors", description: "Manage author profiles" },
      { href: "/admin/partners", label: "Partners", description: "Partner relationships" },
      { href: "/admin/calendar", label: "Calendar", description: "Editorial calendar" },
      { href: "/admin/downloads", label: "Downloads", description: "Digital downloads" },
    ]
  },
  {
    label: "Customization",
    items: [
      { href: "/admin/theme", label: "Theme", description: "Colors and typography" },
      { href: "/admin/hero", label: "Hero Images", description: "Upload hero images" },
      { href: "/admin/home", label: "Homepage", description: "Configure homepage" },
    ]
  },
  {
    label: "System",
    items: [
      { href: "/admin/products", label: "Products", description: "Affiliate products" },
      { href: "/admin/settings", label: "Settings", description: "Site configuration" },
    ]
  }
];

function isActive(itemPath: string, current: string): boolean {
  if (!current) return false;
  // Exact match for index
  if (itemPath === "/admin" && current === "/admin") return true;
  // Prefix match for other pages
  if (itemPath !== "/admin" && current.startsWith(itemPath)) return true;
  return false;
}
---

<nav aria-label="Admin navigation" class="admin-nav" data-admin-nav>
  <div class="admin-nav-header">
    <div class="admin-nav-header-left">
      <h2 class="admin-nav-title">Admin Panel</h2>
      <button
        type="button"
        class="admin-nav-toggle"
        data-admin-toggle
        aria-expanded="true"
        aria-label="Toggle admin navigation"
      >
        <svg class="admin-nav-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
    </div>
    <a href="/" class="admin-nav-home-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>View Site</span>
    </a>
  </div>

  <div class="admin-nav-sections" data-admin-sections>
    {navSections.map((section) => (
      <div class="admin-nav-section">
        <h3 class="admin-nav-section-label">{section.label}</h3>
        <ul class="admin-nav-list">
          {section.items.map((item) => {
            const active = isActive(item.href, currentPath);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={["admin-nav-link", { "admin-nav-link--active": active }]}
                  aria-current={active ? "page" : undefined}
                >
                  <span class="admin-nav-link-label">{item.label}</span>
                  <span class="admin-nav-link-description">{item.description}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</nav>

<script>
  // Admin nav collapse/expand functionality
  const STORAGE_KEY = 'witchclick-admin-nav-collapsed';

  function initAdminNav() {
    const nav = document.querySelector('[data-admin-nav]');
    const toggle = document.querySelector('[data-admin-toggle]');
    const sections = document.querySelector('[data-admin-sections]');

    if (!nav || !toggle || !sections) return;

    // Load saved state
    const savedState = localStorage.getItem(STORAGE_KEY);
    const isCollapsed = savedState === 'true';

    // Apply initial state
    if (isCollapsed) {
      nav.classList.add('is-collapsed');
      toggle.setAttribute('aria-expanded', 'false');
    }

    // Toggle handler
    toggle.addEventListener('click', () => {
      const willCollapse = !nav.classList.contains('is-collapsed');

      if (willCollapse) {
        nav.classList.add('is-collapsed');
        toggle.setAttribute('aria-expanded', 'false');
        localStorage.setItem(STORAGE_KEY, 'true');
      } else {
        nav.classList.remove('is-collapsed');
        toggle.setAttribute('aria-expanded', 'true');
        localStorage.setItem(STORAGE_KEY, 'false');
      }
    });
  }

  // Init on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdminNav);
  } else {
    initAdminNav();
  }
</script>

<style>
  .admin-nav {
    background: var(--color-surface-base, #ffffff);
    border: 1px solid var(--color-line-subtle, #e5e7eb);
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
  }

  .admin-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line-subtle, #e5e7eb);
    margin-bottom: 1rem;
  }

  .admin-nav-header-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .admin-nav-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #111827; /* gray-900 - WCAG AAA compliant */
    margin: 0;
  }

  .admin-nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid #9ca3af; /* gray-400 */
    border-radius: 0.5rem;
    background: transparent;
    color: #374151; /* gray-700 - WCAG AA compliant (8.6:1) */
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .admin-nav-toggle:hover {
    background: #f3f4f6; /* gray-100 */
    color: #111827; /* gray-900 */
    border-color: #6b7280; /* gray-500 */
  }

  .admin-nav-toggle:focus-visible {
    outline: 2px solid var(--color-accent-deep, #7c3aed);
    outline-offset: 2px;
  }

  .admin-nav-toggle-icon {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  .admin-nav.is-collapsed .admin-nav-toggle-icon {
    transform: rotate(180deg);
  }

  .admin-nav-home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #374151; /* gray-700 - WCAG AA compliant */
    border: 1px solid #d1d5db; /* gray-300 */
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .admin-nav-home-link:hover {
    background: #f3f4f6; /* gray-100 */
    color: #111827; /* gray-900 */
    border-color: #9ca3af; /* gray-400 */
  }

  .admin-nav-sections {
    display: grid;
    gap: 1.5rem;
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .admin-nav.is-collapsed .admin-nav-sections {
    display: none;
  }

  .admin-nav.is-collapsed {
    padding-bottom: 1rem;
  }

  .admin-nav.is-collapsed .admin-nav-header {
    margin-bottom: 0;
    border-bottom: none;
    padding-bottom: 0;
  }

  .admin-nav-section {
    display: grid;
    gap: 0.5rem;
  }

  .admin-nav-section-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280; /* gray-500 - WCAG AA compliant (4.6:1) */
    margin: 0;
  }

  .admin-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .admin-nav-link {
    display: grid;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .admin-nav-link:hover {
    background: #f3f4f6; /* gray-100 */
    border-color: #d1d5db; /* gray-300 */
  }

  .admin-nav-link--active {
    background: #ede9fe; /* purple-100 */
    border-color: #a78bfa; /* purple-400 */
  }

  .admin-nav-link--active:hover {
    background: #ddd6fe; /* purple-200 */
    border-color: #8b5cf6; /* purple-500 */
  }

  .admin-nav-link-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827; /* gray-900 - WCAG AAA compliant */
  }

  .admin-nav-link-description {
    font-size: 0.75rem;
    color: #4b5563; /* gray-600 - WCAG AA compliant (7:1) */
    line-height: 1.2;
  }

  .admin-nav-link--active .admin-nav-link-label {
    color: #6b21a8; /* purple-800 - WCAG AA compliant (9.3:1) */
  }

  .admin-nav-link--active .admin-nav-link-description {
    color: #7c3aed; /* purple-700 - WCAG AA compliant (5.9:1) */
  }

  /* Responsive: horizontal on larger screens */
  @media (min-width: 1024px) {
    .admin-nav-sections {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .admin-nav-sections {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
