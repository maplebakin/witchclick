---
/**
 * AdminNav - Consistent navigation for all admin pages
 *
 * Props:
 * - currentPath: string - The current page path (e.g., "/admin/write")
 */

import "@/styles/admin.css";
import autumnWindowTokens from "@/styles/autumn-window.tokens.css?raw";
import QuickActions from "@/components/QuickActions.astro";
import GlobalSearch from "@/components/GlobalSearch.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
// Reuse the existing palette on admin pages without changing Base's theme selection.
const adminThemeTokens = autumnWindowTokens.replaceAll(
  ':root[data-theme="autumn-window"]',
  ':root:has([data-admin-nav])',
);

const navSections = [
  {
    label: "Dashboard",
    items: [
      { href: "/admin", label: "Work queues", description: "Overview and next actions" },
    ]
  },
  {
    label: "Create",
    items: [
      { href: "/admin/generator", label: "Generate a post", description: "Build prompts and save generated posts" },
      { href: "/admin/write", label: "Write a post", description: "Compose a new post in Markdown" },
      { href: "/admin/curses", label: "Generate a curse", description: "Build prompts and ingest curses" },
    ]
  },
  {
    label: "Review",
    items: [
      { href: "/admin/staging", label: "Review drafts", description: "Review, compare, and publish draft posts" },
      { href: "/admin/stubs", label: "Triage post stubs", description: "Review post stubs and replace them with completed drafts" },
      { href: "/admin/hero", label: "Complete hero images", description: "Upload artwork and attach it to posts" },
    ]
  },
  {
    label: "Library",
    items: [
      { href: "/admin/posts", label: "Posts", description: "Browse and edit existing posts" },
      { href: "/admin/entities", label: "Entities", description: "Create and edit entities, including entity stubs" },
      { href: "/admin/curses/archive", label: "Curse archive & editor", description: "Browse and edit archived curses" },
      { href: "/admin/downloads", label: "Downloads", description: "Create, edit, and archive download records" },
      { href: "/admin/authors", label: "Authors", description: "Create and edit author profiles" },
    ]
  },
  {
    label: "Site",
    items: [
      { href: "/admin/home", label: "Homepage", description: "Configure homepage content" },
      { href: "/admin/calendar", label: "Seasonal calendar", description: "Configure seasons, anchors, and rituals" },
      { href: "/admin/partners", label: "Partners & community", description: "Configure partner sections and affiliate highlights" },
      { href: "/admin/products", label: "Affiliate products", description: "Configure the affiliate product catalogue" },
      { href: "/admin/theme", label: "Themes & typography", description: "Configure palettes, fonts, and theme scopes" },
    ]
  },
  {
    label: "System",
    items: [
      { href: "/admin/settings", label: "Site settings", description: "Configure site settings" },
    ]
  }
];

const quickLinks = [
  { href: "/admin", label: "Work queues", description: "Overview and next actions", tone: "neutral" },
  { href: "/admin/generator", label: "Generate a post", description: "Create posts from prompts", tone: "accent" },
  { href: "/admin/staging", label: "Review drafts", description: "Review and publish drafts", tone: "accent" },
  { href: "/admin/posts", label: "Posts", description: "Browse and edit posts", tone: "accent" },
] as const;

// Match complete path segments and select only the most specific destination.
const currentPage = navSections
  .flatMap((section) => section.items)
  .filter((item) => item.href === currentPath || (
    item.href !== "/admin" && currentPath.startsWith(`${item.href}/`)
  ))
  .sort((a, b) => b.href.length - a.href.length)[0];
const activeHref = currentPage?.href;
const currentPageLabel = currentPage?.label ?? "Admin Panel";
const currentPageDescription = currentPage?.description ?? "";

---

<style is:global set:html={adminThemeTokens}></style>

<nav aria-label="Admin navigation" class="admin-nav" data-admin-nav>
  <div class="admin-nav-header">
    <button
      type="button"
      class="admin-nav-trigger"
      data-admin-trigger
      aria-expanded="false"
      aria-haspopup="true"
      aria-label="Open admin navigation menu"
    >
      <div class="admin-nav-trigger-content">
        <div class="admin-nav-trigger-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </div>
        <div class="admin-nav-trigger-text">
          <span class="admin-nav-trigger-label">{currentPageLabel}</span>
          <span class="admin-nav-trigger-description">{currentPageDescription}</span>
        </div>
        <svg class="admin-nav-trigger-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </button>

    <div class="admin-nav-quick-links">
      {quickLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "admin-nav-quick-link",
            {
              "admin-nav-quick-link--accent": link.tone === "accent",
              "admin-nav-quick-link--neutral": link.tone === "neutral",
            },
          ]}
          title={link.description}
        >
          <span class="admin-nav-quick-link-label">{link.label}</span>
          <span class="admin-nav-quick-link-description">{link.description}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="admin-nav-dropdown" data-admin-dropdown>
    <div class="admin-nav-dropdown-content">
      {navSections.map((section) => (
        <div class="admin-nav-section">
          <h3 class="admin-nav-section-label">{section.label}</h3>
          <ul class="admin-nav-list">
            {section.items.map((item) => {
              const active = item.href === activeHref;
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={["admin-nav-link", { "admin-nav-link--active": active }]}
                    aria-current={active ? "page" : undefined}
                  >
                    <span class="admin-nav-link-label">{item.label}</span>
                    <span class="admin-nav-link-description">{item.description}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</nav>

<QuickActions />
<GlobalSearch />

<script>
  // Admin nav dropdown functionality
  function initAdminNav() {
    const nav = document.querySelector<HTMLElement>('[data-admin-nav]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-admin-trigger]');
    const dropdown = document.querySelector<HTMLElement>('[data-admin-dropdown]');

    if (!nav || !trigger || !dropdown) return;

    const navEl = nav;
    const triggerEl = trigger;
    const dropdownEl = dropdown;

    let isOpen = false;

    function openDropdown() {
      isOpen = true;
      navEl.classList.add('is-open');
      triggerEl.setAttribute('aria-expanded', 'true');
      dropdownEl.style.display = 'block';
      // Use requestAnimationFrame to ensure display:block is applied before adding the animation class
      requestAnimationFrame(() => {
        dropdownEl.classList.add('is-visible');
      });
    }

    function closeDropdown() {
      isOpen = false;
      navEl.classList.remove('is-open');
      triggerEl.setAttribute('aria-expanded', 'false');
      dropdownEl.classList.remove('is-visible');
      // Wait for transition to complete before hiding
      setTimeout(() => {
        if (!isOpen) {
          dropdownEl.style.display = 'none';
        }
      }, 200);
    }

    // Toggle handler
    triggerEl.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!isOpen) return;

      const target = e.target;
      if (!(target instanceof Node) || !navEl.contains(target)) {
        closeDropdown();
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDropdown();
        triggerEl.focus();
      }
    });
  }

  // Init on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdminNav);
  } else {
    initAdminNav();
  }
</script>

<style>
  .admin-nav {
    position: relative;
  }

  .admin-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-nav-trigger {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0;
    background: var(--admin-surface-base);
    border: 1px solid var(--admin-border-neutral);
    border-radius: 0.75rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .admin-nav-trigger:hover {
    background: var(--admin-surface-muted);
    border-color: var(--admin-border-strong);
    box-shadow: 0 1px 3px 0 hsl(var(--neutral-9) / 0.1);
  }

  .admin-nav-trigger:focus-visible {
    outline: 2px solid var(--admin-focus);
    outline-offset: 2px;
  }

  :global(.admin-nav.is-open .admin-nav-trigger) {
    background: var(--admin-surface-hover);
    border-color: var(--admin-accent);
    box-shadow: 0 1px 3px 0 hsl(var(--accent-ink) / 0.1);
  }

  .admin-nav-trigger-content {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
  }

  .admin-nav-trigger-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--admin-text-muted);
  }

  .admin-nav-trigger-text {
    flex: 1;
    min-width: 0;
    text-align: left;
  }

  .admin-nav-trigger-label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--admin-text-primary);
    line-height: 1.25;
  }

  .admin-nav-trigger-description {
    display: block;
    font-size: 0.85rem;
    color: var(--admin-text-muted);
    line-height: 1.4;
  }

  .admin-nav-trigger-chevron {
    flex-shrink: 0;
    margin-right: 0.5rem;
    color: var(--admin-icon-muted);
    transition: transform 0.2s ease;
  }

  :global(.admin-nav.is-open .admin-nav-trigger-chevron) {
    transform: rotate(180deg);
  }

  .admin-nav-quick-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex-shrink: 1;
    min-width: 0;
  }

  .admin-nav-quick-link {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    min-height: 2.75rem;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    padding: 0.625rem 0.875rem;
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .admin-nav-quick-link--accent {
    color: var(--admin-accent-text);
    background: var(--admin-accent-soft);
    border: 1px solid var(--admin-accent-border);
  }

  .admin-nav-quick-link--accent:hover {
    background: var(--admin-accent-soft-hover);
    color: var(--admin-accent-text);
    border-color: var(--admin-accent);
    box-shadow: 0 1px 3px 0 hsl(var(--accent-2) / 0.2);
  }

  .admin-nav-quick-link--neutral {
    color: var(--admin-text-body);
    background: var(--admin-surface-base);
    border: 1px solid var(--admin-border-neutral);
  }

  .admin-nav-quick-link--neutral:hover {
    background: var(--admin-surface-hover);
    color: var(--admin-text-primary);
    border-color: var(--admin-border-strong);
  }

  .admin-nav-quick-link-label {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .admin-nav-quick-link-description {
    font-size: 0.85rem;
    line-height: 1.4;
    opacity: 1;
  }

  .admin-nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 50;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  :global(.admin-nav-dropdown.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  .admin-nav-dropdown-content {
    background: var(--admin-surface-base);
    border: 1px solid var(--admin-border-strong);
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.5), 0 4px 12px rgb(0 0 0 / 0.3);
    backdrop-filter: none;
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
  }

  .admin-nav-section {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--admin-border-subtle);
  }

  .admin-nav-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .admin-nav-section-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0 0 0.25rem 0;
  }

  .admin-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }

  .admin-nav-link {
    display: grid;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--wc-radius-sm, 0.75rem);
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .admin-nav-link:hover {
    background: var(--admin-hover-bg);
    border-color: var(--admin-border-neutral);
  }

  .admin-nav-link--active {
    background: var(--admin-accent-soft);
    border-color: var(--admin-accent-border);
  }

  .admin-nav-link--active:hover {
    background: var(--admin-accent-soft-hover);
  }

  .admin-nav-link-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--admin-text-strong);
  }

  .admin-nav-link-description {
    font-size: 0.85rem;
    color: var(--admin-text-muted);
    line-height: 1.4;
  }

  .admin-nav-link--active .admin-nav-link-label {
    color: var(--admin-accent-text);
  }

  .admin-nav-link--active .admin-nav-link-description {
    color: var(--admin-accent);
  }

  @media (max-width: 767px) {
    .admin-nav-header {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Responsive: grid on larger screens */
  @media (min-width: 768px) {
    .admin-nav-dropdown-content {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 1.5rem;
      padding: 1.25rem;
    }

    .admin-nav-section {
      padding-bottom: 0;
      margin-bottom: 0;
      border-bottom: none;
    }
  }

  @media (min-width: 1024px) {
    .admin-nav-dropdown-content {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
