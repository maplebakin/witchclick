---
// src/components/admin/HeroAttacher.astro
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
---
<Card as="li">
    <div class="flex items-start gap-4">
      <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-brand-accent/10 text-sm font-semibold text-brand-primary">
        4
      </span>
      <div class="flex-1 space-y-4">
        <div class="space-y-1">
          <h2 class="text-base font-semibold text-neutral-800">Step 4 — Attach and verify</h2>
          <p class="text-sm text-neutral-500">
            When the preview and alt text look right, attach the hero image to update the post everywhere.
          </p>
        </div>
        <div data-attach-summary class="space-y-2 rounded-lg border border-line-neutral p-4 text-sm text-body"></div>
        <div class="flex flex-wrap items-center gap-3">
          <Button
            variant="primary"
            size="sm"
            data-submit
            disabled
          >
            Attach to post
          </Button>
          <span class="text-sm text-neutral-500" data-status></span>
        </div>
        <button type="button" data-retry-verification class="admin-btn-secondary hidden px-4 py-2">Retry verification only</button>
        <div
          class="hidden rounded-lg border border-status-success-soft bg-status-success-soft px-4 py-3 text-sm text-status-success-strong"
          data-success
        ></div>
        <div
          class="hidden rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700"
          data-error
        ></div>
      </div>
    </div>
</Card>

<script>
  import { parse as parseYaml } from 'yaml';

  document.addEventListener('DOMContentLoaded', () => {
    const submitButton = document.querySelector<HTMLButtonElement>('[data-submit]');
    const card = submitButton?.closest('li');
    const root = card?.closest('#heroUploader');
    if (!submitButton || !card || !root) return;
    const status = card.querySelector<HTMLElement>('[data-status]')!;
    const success = card.querySelector<HTMLElement>('[data-success]')!;
    const error = card.querySelector<HTMLElement>('[data-error]')!;
    const summary = card.querySelector<HTMLElement>('[data-attach-summary]')!;
    const retry = card.querySelector<HTMLButtonElement>('[data-retry-verification]')!;
    const api = root.getAttribute('data-dev-api') || 'http://localhost:8787';
    const key = root.getAttribute('data-dev-key') || '';
    const getState = () => (window as any).heroUploaderState || {};
    const setState = (patch: Record<string, unknown>) => (window as any).setHeroUploaderState?.(patch);
    let busy = false;
    let attempt = 0;
    type Snapshot = { slug: string; token: number; path: string; alt: string };
    let saved: Snapshot | null = null;
    const imagePath = (state: any): string => state.uploadedImagePath || state.existingHeroPath || '';
    // Same path-like criteria as normalizeImageAlt in src/utils/posts.ts.
    function usefulAlt(alt: string, path: string) {
      return Boolean(alt.trim()) && !/^(?:[/\\]|[a-z]:[/\\])/i.test(alt) && !/^(?:https?:)?\/\//i.test(alt)
        && !/(?:^|\/)(?:images|hero-images)(?:\/|$)|chatgpt-image/i.test(alt)
        && !/(?:^|\/)[^/]+\.(?:avif|gif|jpe?g|png|svg|webp)(?:[?#]|$)/i.test(alt)
        && alt.trim().toLowerCase() !== path.split('/').pop()?.toLowerCase();
    }
    const current = (snapshot: Snapshot, id: number) => {
      const state = getState();
      return attempt === id && state.selectionToken === snapshot.token && state.selectedSlug === snapshot.slug
        && imagePath(state) === snapshot.path && state.altText.trim() === snapshot.alt;
    };
    async function request(path: string, body: unknown) {
      const response = await fetch(api + path, {
        method: 'POST', headers: { 'Content-Type': 'application/json', ...(key ? { 'X-WC-Dev-Key': key } : {}) },
        body: JSON.stringify(body),
      });
      const data = await response.json();
      if (!response.ok || data?.ok !== true) throw new Error(data?.error || 'Hero request failed.');
      return data;
    }
    function clearMessages() {
      success.replaceChildren(); success.classList.add('hidden');
      error.textContent = ''; error.classList.add('hidden');
    }
    function sync() {
      const state = getState();
      const path = imagePath(state);
      const alt = String(state.altText || '').trim();
      const valid = state.selectedSlug && path.startsWith(`/images/hero/${state.selectedSlug}/`) && usefulAlt(alt, path) && !state.filePending;
      submitButton!.disabled = busy || !valid || ['success', 'unverified'].includes(state.attachStatus);
      submitButton!.textContent = !state.uploadedImagePath && path ? 'Save alt text on existing hero' : 'Attach to post';
      retry.classList.toggle('hidden', !saved || state.attachStatus !== 'unverified');
      retry.disabled = busy;
      summary.replaceChildren();
      if (!state.selectedSlug) {
        summary.textContent = 'Select a post to prepare its hero image.';
      } else {
        for (const text of [`Post: ${state.postTitle} (${state.selectedSlug})`, `Image: ${path || 'Upload artwork first'}`, `Alt text: ${alt || 'Add a description of the image'}`]) {
          const line = document.createElement('p'); line.style.overflowWrap = 'anywhere'; line.textContent = text; summary.append(line);
        }
        if (path) {
          const image = document.createElement('img'); image.src = path; image.alt = alt || 'Artwork awaiting an alt description';
          image.className = 'mt-2 h-32 w-48 max-w-full rounded-lg object-contain'; summary.append(image);
        }
      }
      if (!busy && !['success', 'unverified'].includes(state.attachStatus)) {
        status.textContent = state.filePending ? 'Upload the newly selected artwork before attaching.'
          : !path ? 'Upload artwork before attaching.'
          : !usefulAlt(alt, path) ? 'Add descriptive alt text; paths and filenames are not useful descriptions.'
          : state.uploadedImagePath ? 'Uploaded — not attached yet. Review the summary, then attach.'
          : 'Existing hero selected. Review the summary and save corrected alt text without re-uploading.';
      }
      if (state.attachStatus === 'idle') clearMessages();
    }
    async function verify(snapshot: Snapshot, id: number) {
      try {
        const data = await request('/posts/load', { slug: snapshot.slug });
        if (!current(snapshot, id)) return;
        const frontmatter = parseYaml(data.frontmatter) as Record<string, unknown>;
        if (data.slug !== snapshot.slug || !frontmatter || frontmatter.heroImage !== snapshot.path
            || frontmatter.heroImageAlt !== snapshot.alt || frontmatter.heroAlt !== snapshot.alt) {
          throw new Error('The reread hero path or alt text does not match the saved summary.');
        }
        setState({ attachStatus: 'success', existingHeroPath: snapshot.path, uploadedImagePath: '', uploadStatus: 'idle', draft: frontmatter.draft === true });
        document.dispatchEvent(new CustomEvent('hero-verified', { detail: { slug: snapshot.slug, path: snapshot.path, alt: snapshot.alt } }));
        clearMessages();
        status.textContent = 'Hero image and alt text verified on the saved post.';
        const text = document.createElement('p'); text.style.overflowWrap = 'anywhere'; text.textContent = `Verified ${snapshot.path} for ${snapshot.slug}. Alt text: ${snapshot.alt}`;
        success.append(text);
        const links = [{ href: `/admin/posts?slug=${encodeURIComponent(snapshot.slug)}`, label: 'Open in Posts' }];
        if (frontmatter.draft === true) links.push({ href: `/admin/staging?slug=${encodeURIComponent(snapshot.slug)}`, label: 'Review in Staging' });
        else links.push({ href: `/post/${encodeURIComponent(snapshot.slug)}`, label: 'View live post' });
        for (const link of links) {
          const anchor = document.createElement('a'); anchor.href = link.href; anchor.textContent = link.label;
          anchor.className = 'mr-4 underline'; success.append(anchor);
        }
        success.classList.remove('hidden');
      } catch (failure: any) {
        if (!current(snapshot, id)) return;
        setState({ attachStatus: 'unverified' });
        status.textContent = 'Saved but not verified. Retry verification before relying on this result.';
        error.textContent = failure?.message || 'Could not reread the post.'; error.classList.remove('hidden');
      }
    }
    submitButton.addEventListener('click', async () => {
      if (busy || submitButton.disabled) return;
      const state = getState();
      const snapshot: Snapshot = { slug: state.selectedSlug, token: state.selectionToken, path: imagePath(state), alt: state.altText.trim() };
      const id = ++attempt;
      busy = true; saved = null; clearMessages();
      setState({ attachStatus: 'saving' }); sync(); status.textContent = 'Saving the hero shown in this summary…';
      try {
        await request('/posts/attach-hero', { slug: snapshot.slug, heroImage: snapshot.path, heroAlt: snapshot.alt });
        if (!current(snapshot, id)) return;
        saved = snapshot;
        setState({ attachStatus: 'verifying', pendingUploads: (getState().pendingUploads || []).filter((item: any) => item.path !== snapshot.path || item.slug !== snapshot.slug) });
        status.textContent = 'Saved. Rereading the post to verify the hero and alt text…';
        await verify(snapshot, id);
      } catch (failure: any) {
        if (!current(snapshot, id)) return;
        setState({ attachStatus: 'error' });
        status.textContent = 'Attachment failed; no verified success is reported.';
        error.textContent = failure?.message || 'Attach failed.'; error.classList.remove('hidden');
      } finally {
        if (attempt === id) { busy = false; sync(); }
      }
    });
    retry.addEventListener('click', async () => {
      if (busy || !saved) return;
      const snapshot = saved; const id = ++attempt;
      busy = true; clearMessages(); status.textContent = 'Rereading the saved post…'; sync();
      await verify(snapshot, id);
      if (attempt === id) { busy = false; sync(); }
    });
    document.addEventListener('post-selected', () => { attempt += 1; busy = false; saved = null; clearMessages(); sync(); });
    document.addEventListener('hero-state-changed', sync);
    sync();
  });
</script>
