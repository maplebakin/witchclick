---
// src/components/admin/ImageUploader.astro
import Card from "@/components/ui/Card.astro";
import Input from "@/components/ui/Input.astro";
---
<Card as="li">
  <div class="flex items-start gap-4">
    <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-brand-accent/10 text-sm font-semibold text-brand-primary">
      3
    </span>
    <div class="flex-1 space-y-4">
      <div class="space-y-1">
        <h2 class="text-base font-semibold text-neutral-800">Step 3 — Upload hero artwork</h2>
        <p class="text-sm text-neutral-500">
          With the prompt in hand, render a new hero image and import it from your device.
        </p>
      </div>
      <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <div class="relative">
          <div
            class="relative flex h-full flex-col items-center justify-center rounded-xl border-2 border-dashed border-neutral-300 bg-neutral-50 px-6 py-10 text-center transition"
            data-drop-zone
          >
            <input
              type="file"
              accept="image/png,image/jpeg,image/jpg,image/webp"
              class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
              data-file-input
              aria-label="Upload hero image"
              disabled
            />
            <div
              class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-xl bg-white/80 text-sm font-semibold text-neutral-500"
              data-drop-overlay
            >
              Select a post above to unlock uploads.
            </div>
            <div class="space-y-2">
              <p class="text-sm font-medium text-neutral-700">Drag &amp; drop hero artwork, or click to browse</p>
              <p class="text-[0.8rem] text-neutral-500" data-drop-hint>
                Once a post is selected, you can upload PNG, JPG, or WEBP files up to 5&nbsp;MB.
              </p>
              <p class="text-[0.8rem] text-neutral-500" data-file-info></p>
            </div>
          </div>
        </div>
        <figure class="space-y-3">
          <div class="relative overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm">
            <div
              class="flex aspect-[3/2] items-center justify-center text-sm font-medium text-neutral-400"
              data-preview-placeholder
            >
              Your preview will appear here once you choose an image.
            </div>
            <img
              data-preview
              alt="Selected hero preview"
              class="hidden h-full w-full object-cover"
            />
          </div>
          <figcaption class="text-[0.8rem] text-neutral-500" data-existing-hero>
            Select a post to review its current hero details.
          </figcaption>
        </figure>
      </div>
      <label class="block">
        <span class="text-[0.8rem] font-medium uppercase tracking-wide text-neutral-500">Alt text</span>
        <Input
          type="text"
          placeholder="Cozy cauldron simmering beside tarot cards on a window seat"
          class="mt-1"
          data-alt-input
          disabled
        />
        <p class="mt-1 text-[0.8rem] text-neutral-400">
          Alt text helps screen readers understand the imagery—tweak it after uploading if needed.
        </p>
      </label>
    </div>
  </div>
</Card>

<script>
    // This script is intentionally left sparse.
    // In the full refactor, the complex drag/drop, file reading, and preview logic
    // from the original hero.astro's inline script would be moved here.
    // It would also need to communicate with the other components, highlighting
    // the need for a shared state solution.
    document.addEventListener('DOMContentLoaded', () => {
        const root = document.querySelector('[data-drop-zone]');
        if (!root) return;

        // Simplified event listeners to show the concept
        root.addEventListener('dragenter', (event) => {
            event.preventDefault();
            // In a real implementation, we'd check if drops are enabled
            root.classList.add('border-brand-primary', 'bg-neutral-100');
        });

        root.addEventListener('dragleave', (event) => {
            event.preventDefault();
            root.classList.remove('border-brand-primary', 'bg-neutral-100');
        });

        root.addEventListener('drop', (event) => {
            event.preventDefault();
            root.classList.remove('border-brand-primary', 'bg-neutral-100');
            // Logic to handle file drop would go here
        });
    });
</script>
