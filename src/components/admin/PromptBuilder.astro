--- 
// src/components/admin/PromptBuilder.astro
import Card from "@/components/ui/Card.astro";
import Input from "@/components/ui/Input.astro";
import Select from "@/components/ui/Select.astro";
import Textarea from "@/components/ui/Textarea.astro";
import Button from "@/components/ui/Button.astro";

interface PresetOption {
  key: string;
  label: string;
  description: string;
}

interface StyleOption {
  key: string;
  label: string;
  description: string;
}

interface Props {
  presetOptions: PresetOption[];
  styleOptions: StyleOption[];
  defaultModeDescription: string;
  defaultStyleDescription: string;
  devApi: string;
  devKey?: string;
}

const { 
  presetOptions,
  styleOptions,
  defaultModeDescription,
  defaultStyleDescription
} = Astro.props;
---

<Card as="section" class="lg:col-span-5">
  <div class="mb-4 space-y-2">
    <h2 class="text-xl font-semibold">Step 1: Build Generator Prompt</h2>
    <p class="text-[0.8rem] text-body-muted">Enter a topic. The generating model will choose a useful structure and length unless you set an override.</p>
  </div>
  <div class="grid gap-4">
    <label class="block">
      <span class="text-[0.8rem] font-medium uppercase tracking-wide text-body-subtle">Topic</span>
      <Input id="topic" placeholder="Why creative burnout can make hobbies feel like obligations" />
      <p class="mt-1 text-[0.8rem] text-body-faint">What question, ritual, symbol, or lens should this post explore?</p>
    </label>
    <div class="flex gap-2">
      <Button id="genPrompt" variant="secondary" size="sm">Generate Prompt</Button>
      <Button id="copyPrompt" variant="primary" size="sm">Copy Prompt</Button>
    </div>
    <details class="rounded-lg border border-line-neutral p-3">
      <summary class="cursor-pointer font-medium">Advanced options (optional)</summary>
      <div class="mt-4 grid gap-4">
    <label class="block">
      <span class="text-[0.8rem] font-medium">Target length (automatic when blank)</span>
      <Input id="words" type="number" min="1" max="50000" placeholder="Automatic" />
    </label>
    <label class="block">
      <span class="text-[0.8rem] font-medium">Article approach</span>
      <Select id="mode">
        <option value="" selected>Automatic — let the model choose</option>
        {presetOptions.map((option) => (
          <option value={option.key}>{option.label}</option>
        ))}
      </Select>
      <p class="mt-1 text-[0.8rem] text-body-subtle" id="modeHelp">{defaultModeDescription}</p>
    </label>
    <label class="block">
      <span class="text-[0.8rem] font-medium">Writing voice</span>
      <Select id="style">
        {styleOptions.map((option) => (
          <option value={option.key}>{option.label}</option>
        ))}
      </Select>
      <p id="styleHelp" class="mt-1 text-[0.8rem] text-body-subtle">{defaultStyleDescription}</p>
    </label>
    <label class="block">
      <span class="text-[0.8rem] font-medium">Optional reflection questions (one per line)</span>
      <Textarea id="reflectionPrompts" placeholder="e.g., What measure of value are you ready to stop obeying?" />
      <p class="mt-1 text-[0.8rem] text-body-faint">Leave blank for no requested questions. Supplied questions override a specialist template’s usual question policy.</p>
    </label>
    <label class="block">
      <span class="text-[0.8rem] font-medium">Editorial instructions (optional)</span>
      <Textarea id="editorialInstructions" placeholder="Audience, emphasis, exclusions, or a preferred structure…" />
    </label>
    <div class="flex gap-4 text-sm">
      <label class="inline-flex items-center gap-2">
        <input type="checkbox" id="ads" class="w-4 h-4 rounded border-line-neutral text-primary focus:ring-primary/40" />
        <span>Allow ad placements</span>
      </label>
      <label class="inline-flex items-center gap-2">
        <input type="checkbox" id="kofi" checked class="w-4 h-4 rounded border-line-neutral text-primary focus:ring-primary/40" />
        <span>Include optional Ko-fi support CTA</span>
      </label>
    </div>
    <p class="text-[0.8rem] text-body-faint">Affiliate suggestions use the existing catalog only when relevant; none are required.</p>
      </div>
    </details>
    <Textarea id="promptOut" class="font-mono text-[0.8rem] h-64" placeholder="The generated prompt will appear here…"></Textarea>
    <p class="text-[0.8rem] text-body-muted">Send this prompt to your LLM, then paste the returned PostSpec JSON into the workflow on the right.</p>
  </div>
</Card>
