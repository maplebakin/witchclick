---
// src/components/CtaFooter.astro — fixed
// Astro frontmatter is server-side script; don't return JSX from here.
// We compute text/href, then render conditionally in the template below.
import { KO_FI_URL, KOFI_CTA_VARIANTS } from "./cta";

export interface Props {
  type: 'kofi' | 'download' | 'none';
  id?: string;
}

const { type, id } = Astro.props as Props;

let text = '';
let href = '';
let target: string | undefined;
let relAttr: string | undefined;

if (type === 'kofi') {
  const idx = Math.floor(Math.random() * KOFI_CTA_VARIANTS.length);
  text = KOFI_CTA_VARIANTS[idx];
  href = KO_FI_URL;
  target = '_blank';
  relAttr = 'noopener noreferrer';
} else if (type === 'download' && id) {
  text = 'Grab the printable that goes with this post.';
  href = `/download/${id}`;
}
---
{type !== 'none' && text && href && (
  <section class="flex flex-col gap-4">
    <p class="text-base leading-relaxed text-purple-800">{text}</p>
    <a
      href={href}
      target={target}
      rel={relAttr}
      class="inline-flex w-fit items-center gap-2 rounded-full bg-purple-700 px-5 py-2 text-sm font-semibold text-white shadow-md shadow-purple-300/40 transition hover:-translate-y-0.5 hover:bg-purple-800"
    >
      {type === 'kofi' ? 'Support on Ko‑fi' : 'Download'}
      <span aria-hidden="true">→</span>
    </a>
  </section>
)}
