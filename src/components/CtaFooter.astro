---
// src/components/CtaFooter.astro — fixed
// Astro frontmatter is server-side script; don't return JSX from here.
// We compute text/href, then render conditionally in the template below.
import { KOFI_CTA_VARIANTS } from "./cta"; // KO_FI_URL is removed

// New imports
import { readSettings } from '../utils/settings';

export interface Props {
  type: 'kofi' | 'download' | 'none';
  id?: string;
}

const { type, id } = Astro.props as Props;

let text = '';
let href = '';

// Read settings to get Ko-fi username
const settings = readSettings();
const kofiUsername = settings.kofiUsername || 'mirash'; // Fallback to a default or generic if not set
const baseKofiUrl = `https://ko-fi.com/${kofiUsername}`;

if (type === 'kofi') {
  const fallback =
    KOFI_CTA_VARIANTS[0] ??
    "If this post brought a little light, you can tip the witch at Ko‑fi.";
  const idx = Math.floor(Math.random() * KOFI_CTA_VARIANTS.length);
  const variant = KOFI_CTA_VARIANTS[idx] ?? fallback;
  text = variant;
  href = baseKofiUrl; // Use dynamic URL
} else if (type === 'download') {
  text = 'Explore cozy tools and printable rituals.';
  href = '/tools/';
}
---
{type !== 'none' && text && href && (
  <section class="cta-footer" aria-label="Support invitation" id={id}>
    <div class="cta-footer-content">
      <p class="cta-footer-copy">{text}</p>
      <a
        href={href}
        class="cta-footer-button"
        rel="noopener noreferrer"
        data-analytics={type === 'kofi' ? 'kofi_click' : 'post_download_cta'}
        data-analytics-meta={type}
      >
        {type === 'kofi' ? 'Support on Ko‑fi' : 'Download'}
      </a>
    </div>
  </section>
)}

<style>
  .cta-footer {
    margin-top: 2.5rem;
    border-radius: clamp(1.5rem, 3vw, 1.85rem);
    border: 1px solid color-mix(in srgb, var(--glass-panel-border, color-mix(in srgb, var(--theme-color-amethyst) 32%, transparent)) 70%, transparent);
    background: linear-gradient(160deg, color-mix(in srgb, var(--glass-panel-overlay, color-mix(in srgb, var(--theme-color-amethyst) 16%, transparent)) 88%, transparent) 0%, var(--theme-surface-base) 100%);
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .cta-footer-content {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .cta-footer-content {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.25rem;
    }
  }

  .cta-footer-copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink-body, currentColor) 92%, white 8%);
  }

  .cta-footer-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.7rem 1.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    background: radial-gradient(circle at 15% 15%, color-mix(in srgb, var(--action-primary) 95%, white 5%), var(--action-primary));
    color: var(--action-primary-text);
    box-shadow: 0 14px 32px -20px color-mix(in srgb, var(--action-primary) 55%, transparent);
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .cta-footer-button:hover,
  .cta-footer-button:focus-visible {
    background: var(--action-primary-hover);
    transform: translateY(-1px);
  }

  .cta-footer-button:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--action-primary) 25%, transparent),
      0 0 0 6px color-mix(in srgb, white 70%, transparent 30%);
  }

  @media (max-width: 639px) {
    .cta-footer-button {
      width: 100%;
    }
  }
</style>
