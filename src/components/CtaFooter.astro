---
// src/components/CtaFooter.astro — fixed
// Astro frontmatter is server-side script; don't return JSX from here.
// We compute text/href, then render conditionally in the template below.
import { KO_FI_URL, KOFI_CTA_VARIANTS } from "./cta";

export interface Props {
  type: 'kofi' | 'download' | 'none';
  id?: string;
}

const { type, id } = Astro.props as Props;

let text = '';
let href = '';

if (type === 'kofi') {
  const fallback =
    KOFI_CTA_VARIANTS[0] ??
    "If this post brought a little light, you can tip the witch at Ko‑fi.";
  const idx = Math.floor(Math.random() * KOFI_CTA_VARIANTS.length);
  const variant = KOFI_CTA_VARIANTS[idx] ?? fallback;
  text = variant;
  href = KO_FI_URL;
} else if (type === 'download') {
  text = 'Explore cozy tools and printable rituals.';
  href = '/tools/';
}
---
{type !== 'none' && text && href && (
  <section class="cta-footer" aria-label="Support invitation" id={id}>
    <div class="cta-footer-content">
      <p class="cta-footer-copy">{text}</p>
      <a
        href={href}
        class="cta-footer-button"
        rel="noopener noreferrer"
        data-analytics={type === 'kofi' ? 'kofi_click' : 'post_download_cta'}
        data-analytics-meta={type}
      >
        {type === 'kofi' ? 'Support on Ko‑fi' : 'Download'}
      </a>
    </div>
  </section>
)}

<style>
  .cta-footer {
    margin-top: 2.5rem;
    border-radius: clamp(1.5rem, 3vw, 1.85rem);
    border: 1px solid color-mix(in srgb, var(--color-iris, #7c4eb0) 35%, transparent 65%);
    background:
      radial-gradient(
        140% 150% at 12% 0%,
        color-mix(in srgb, var(--background-glow-cool, color-mix(in srgb, var(--color-iris, #7c4eb0) 32%, transparent 68%)) 75%, transparent 25%)
          0%,
        transparent 68%
      ),
      radial-gradient(
        120% 140% at 95% 18%,
        color-mix(in srgb, var(--background-glow-warm, color-mix(in srgb, var(--color-gold, #d4af37) 28%, transparent 72%)) 65%, transparent 35%)
          0%,
        transparent 72%
      ),
      linear-gradient(
        165deg,
        color-mix(in srgb, var(--background-gradient-top, var(--color-midnight, #07020f)) 82%, white 18%) 0%,
        color-mix(in srgb, var(--background-gradient-bottom, var(--color-night, #120725)) 88%, transparent 12%) 100%
      );
    padding: clamp(1.25rem, 3vw, 1.75rem);
    box-shadow: 0 24px 52px -30px color-mix(in srgb, var(--color-night, #120725) 55%, transparent 45%);
  }

  .cta-footer-content {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .cta-footer-content {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.25rem;
    }
  }

  .cta-footer-copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink-body, currentColor) 92%, white 8%);
  }

  .cta-footer-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.7rem 1.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    background: radial-gradient(
      circle at 18% 20%,
      color-mix(in srgb, var(--color-gold, #d4af37) 45%, var(--color-iris, #7c4eb0) 55%) 0%,
      color-mix(in srgb, var(--color-iris, #7c4eb0) 78%, var(--color-gold, #d4af37) 22%) 100%
    );
    color: color-mix(in srgb, var(--ink-body, #f4f1ff) 92%, white 8%);
    box-shadow: 0 16px 36px -24px color-mix(in srgb, var(--color-iris, #7c4eb0) 55%, transparent 45%);
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .cta-footer-button:hover,
  .cta-footer-button:focus-visible {
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--color-gold, #d4af37) 42%, var(--color-iris, #7c4eb0) 58%) 0%,
      color-mix(in srgb, var(--color-iris, #7c4eb0) 82%, var(--color-gold, #d4af37) 18%) 100%
    );
    transform: translateY(-1px);
    box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--color-iris, #7c4eb0) 58%, transparent 42%);
  }

  .cta-footer-button:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--color-iris, #7c4eb0) 35%, transparent),
      0 0 0 6px color-mix(in srgb, white 70%, transparent 30%);
  }

  @media (max-width: 639px) {
    .cta-footer-button {
      width: 100%;
    }
  }
</style>
