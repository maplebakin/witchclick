---
import { searchOpen } from '@/lib/uiState';
const label = Astro.props?.label ?? 'Search posts';
---
<div class={`fixed inset-0 z-40 ${searchOpen.value ? 'block' : 'hidden'}`} aria-hidden={!searchOpen.value}>
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="absolute inset-x-0 top-0 mx-auto mt-10 w-full max-w-2xl rounded-2xl bg-white dark:bg-zinc-900 p-4 shadow-xl">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold">{label}</h2>
      <button class="px-3 py-1 rounded-xl border" aria-label="Close search" onClick={() => (searchOpen.value = false)} client:load>
        ✕
      </button>
    </div>
    <!-- Replace with real search control when ready -->
    <input type="search" placeholder="Type to search…" class="w-full rounded-xl border px-3 py-2" />
  </div>
</div>
