---
// src/components/AdSlot.astro
import { readSettings } from "../utils/settings";

interface Props { slot?: 'side'|'end'|'lead'; class?: string }
const { slot = 'end', class: className = '' } = Astro.props as Props;

const settings = readSettings();
const ads = settings.ads || {};
const provider = ads.provider || 'none';
const slotMap = {
  side: ads.sidebarSlotId,
  end: ads.endSlotId,
  lead: ads.leadSlotId,
  ...(ads.slots || {}),
};
const slotId = slotMap?.[slot] || '';
const isAdsense = provider === 'adsense' && ads.adsenseClientId && slotId;
const isHouse = provider === 'house';
const baseClass = `ad ad--${slot} ${className}`.trim();
const ariaLabel = slot === 'side' ? 'Sponsored sidebar' : 'Sponsored message';
---
{isAdsense && (
  <aside id={`adsense-slot-${slotId}`} class={baseClass} data-slot={slot} aria-label={ariaLabel} role="complementary" style="display:none;">
    <p class="ad__label">Sponsored</p>
    <div class="ad__frame">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ads.adsenseClientId}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    </div>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const slotId = "{slotId}"; // Get slotId from Astro component context
        const adSlotElement = document.getElementById(`adsense-slot-${slotId}`);
        const CONSENT_KEY = 'cookie_consent_status';

        function loadAd() {
          try {
            if (localStorage.getItem(CONSENT_KEY) === 'accepted') {
              (window.adsbygoogle = window.adsbygoogle || []).push({});
              if (adSlotElement) {
                adSlotElement.style.display = ''; // Show the ad slot
              }
            } else {
              if (adSlotElement) {
                adSlotElement.style.display = 'none'; // Keep hidden if not accepted
              }
            }
          } catch (e) {
            console.error("AdSense load error:", e);
            if (adSlotElement) {
              adSlotElement.style.display = 'none';
            }
          }
        }

        // Initial check
        loadAd();

        // Listen for consent changes
        window.addEventListener('cookieConsentChanged', (event) => {
          if (event.detail.status === 'accepted') {
            loadAd();
          } else {
            // If ads were loaded and consent is revoked, clear/hide them
            if (adSlotElement) {
              adSlotElement.style.display = 'none';
              // Optionally, you might want to remove the AdSense iframe content here
              // to truly stop tracking, but simply hiding is usually sufficient
              // and less error-prone.
            }
          }
        });
      });
    </script>
  </aside>
)}

{isHouse && slot === 'side' && (
  <aside class={baseClass} role="complementary" aria-label={ariaLabel}>
    <p class="ad__label">Sponsored</p>
    <p class="ad__copy">Cozy tools that support this guide:</p>
    <ul class="ad__list">
      <li><a class="ad__link" href="/go/journal" rel="sponsored nofollow">linen journal</a></li>
      <li><a class="ad__link" href="/go/notebooks" rel="sponsored nofollow">dotted notebook</a></li>
      <li><a class="ad__link" href="/go/crystals" rel="sponsored nofollow">starter crystals</a></li>
    </ul>
  </aside>
)}

{isHouse && slot !== 'side' && (
  <aside class={baseClass} role="complementary" aria-label={ariaLabel}>
    <p class="ad__label">Sponsored</p>
    <p class="ad__copy">
      Thanks for reading. Support WitchClick with a
      <a class="ad__link" href="/go/notebooks" rel="sponsored nofollow">dotted notebook</a>
      or a
      <a class="ad__link" href="/go/journal" rel="sponsored nofollow">linen journal</a>.
    </p>
  </aside>
)}

{provider === 'adsense' && !isAdsense && (
  <aside class={`${baseClass} ad--placeholder`} aria-hidden="true" style="display: none;"></aside>
)}
