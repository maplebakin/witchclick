---
interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;
---
<section class:list={["witchclick-blurb", className].filter(Boolean)} aria-labelledby="witchclick-about">
  <div class="witchclick-blurb__inner">
    <h2 id="witchclick-about" class="witchclick-blurb__title">About WitchClick</h2>
    <p class="witchclick-blurb__copy">
      WitchClick gathers secular rituals, gentle planning aids, and printable tools for folks who want magic without burnout.
      Every guide is written to feel like a cozy friend walking beside you.
    </p>
    <div class="witchclick-blurb__links">
      <a class="witchclick-blurb__link focus-ring" href="/start">
        Start here guide
      </a>
      <a class="witchclick-blurb__link focus-ring" href="/tools">
        Browse tools &amp; printables
      </a>
    </div>
  </div>
</section>

<style is:inline>
  .witchclick-blurb {
    margin: 0;
  }

  .witchclick-blurb__inner {
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.6rem, 4vw, 2.3rem);
    border-radius: clamp(1.5rem, 3vw, 2rem);
    background:
      radial-gradient(120% 120% at 12% 18%, rgba(124, 78, 176, 0.22), transparent 70%),
      rgba(18, 7, 37, 0.9);
    border: 1px solid rgba(212, 175, 55, 0.28);
    box-shadow: 0 22px 55px -32px rgba(11, 6, 20, 0.55);
    color: rgba(249, 245, 255, 0.92);
  }

  .witchclick-blurb__title {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .witchclick-blurb__copy {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .witchclick-blurb__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .witchclick-blurb__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.45);
    background: rgba(24, 12, 40, 0.68);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  .witchclick-blurb__link:hover,
  .witchclick-blurb__link:focus-visible {
    transform: translateY(-1px);
    background: rgba(33, 15, 52, 0.82);
    border-color: rgba(212, 175, 55, 0.58);
  }

  :root[data-comfort-theme="dawn"] .witchclick-blurb__inner {
    background:
      radial-gradient(120% 120% at 12% 18%, rgba(180, 154, 217, 0.2), transparent 72%),
      rgba(252, 248, 242, 0.96);
    border-color: rgba(155, 134, 200, 0.32);
    color: rgba(58, 40, 84, 0.9);
  }

  :root[data-comfort-theme="dawn"] .witchclick-blurb__link {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(180, 154, 217, 0.35);
    color: rgba(87, 63, 115, 0.9);
  }

  :root[data-comfort-theme="dawn"] .witchclick-blurb__link:hover,
  :root[data-comfort-theme="dawn"] .witchclick-blurb__link:focus-visible {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(212, 175, 55, 0.42);
  }
</style>
