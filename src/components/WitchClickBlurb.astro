---
interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;
---
<section class:list={["witchclick-blurb", className].filter(Boolean)} aria-labelledby="witchclick-about">
  <div class="witchclick-blurb__inner">
    <h2 id="witchclick-about" class="witchclick-blurb__title">About WitchClick</h2>
    <p class="witchclick-blurb__copy">
      WitchClick gathers secular rituals, tarot spreads, and printable supports for people building value outside the usual
      measures. Choose the lens that helps, skip what does not, and move at a pace your actual life can hold.
    </p>
    <div class="witchclick-blurb__links">
      <a class="witchclick-blurb__link focus-ring" href="/start">
        Start here guide
      </a>
      <a class="witchclick-blurb__link focus-ring" href="/tools">
        Browse tools &amp; printables
      </a>
    </div>
  </div>
</section>

<style is:inline>
  .witchclick-blurb {
    margin: 0;
  }

  .witchclick-blurb__inner {
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.6rem, 4vw, 2.3rem);
    border-radius: clamp(1.5rem, 3vw, 2rem);
    background: radial-gradient(120% 120% at 12% 18%, color-mix(in srgb, var(--color-iris, hsl(var(--accent-ink) / 1)) 22%, transparent) 0%, transparent 70%), var(--theme-background);
    border: 1px solid var(--theme-border-subtle);
    box-shadow: var(--theme-shadow-soft);
    color: var(--theme-text-primary);
  }

  .witchclick-blurb__title {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .witchclick-blurb__copy {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .witchclick-blurb__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .witchclick-blurb__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--theme-border-subtle);
    background: var(--theme-surface-panel);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  .witchclick-blurb__link:hover,
  .witchclick-blurb__link:focus-visible {
    transform: translateY(-1px);
    background: var(--theme-surface-hover);
    border-color: var(--theme-border-strong);
  }

  :root[data-comfort-theme="dawn"] .witchclick-blurb__inner {
    background: radial-gradient(120% 120% at 12% 18%, color-mix(in srgb, var(--theme-color-amethyst) 20%, transparent) 72%), var(--theme-surface-base);
    border-color: var(--theme-border-subtle);
    color: var(--theme-text-primary);
  }

  :root[data-comfort-theme="dawn"] .witchclick-blurb__link {
    background: var(--theme-surface-base);
    border-color: var(--theme-border-subtle);
    color: var(--theme-text-primary);
  }

  :root[data-comfort-theme="dawn"] .witchclick-blurb__link:hover,
  :root[data-comfort-theme="dawn"] .witchclick-blurb__link:focus-visible {
    background: var(--theme-surface-hover);
    border-color: var(--theme-border-strong);
  }
</style>
