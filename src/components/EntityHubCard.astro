---
// src/components/EntityHubCard.astro
import { resolveTailwindColor } from "@/utils/color";

interface Section {
  type: string;
  title: string;
  subtitle: string;
  icon: string;
  href: string;
  themeColor: string;
}

interface Props {
  section: Section;
}

const { section } = Astro.props;

const labelFor = (type: string) =>
  type
    .replace(/([A-Z])/g, " $1")
    .replace(/^./, (char) => char.toUpperCase());

const accent = resolveTailwindColor(section.themeColor);
const styles = {
  '--entity-card-accent': accent,
  '--entity-card-icon': `color-mix(in srgb, var(--theme-entity-card-icon, var(--entity-card-icon)) 65%, ${accent} 35%)`,
  '--card-hover-translate': '-0.12rem',
};
---
<a
  href={section.href}
  class="entity-hub-card group grid min-h-full gap-6 rounded-xl border p-6 transition-all duration-200 ease-in-out hover:-translate-y-0.5 focus-visible:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2"
  style={Object.entries(styles).map(([key, value]) => `${key}: ${value}`).join(';')}
>
  <div class="grid items-start gap-4 lg:grid-cols-[minmax(0,0.4fr)_minmax(0,1fr)] lg:gap-2">
    <div class="flex flex-col items-start gap-2 text-[var(--entity-card-label)]">
      <span class="text-4xl text-[var(--entity-card-icon)]" style={`filter: drop-shadow(0 3px 8px color-mix(in srgb, var(--entity-card-icon-shadow) 45%, transparent 55%));`}>
        {section.icon}
      </span>
      <span class="text-[0.8rem] font-bold uppercase tracking-wide break-words">
        {labelFor(section.type)}
      </span>
    </div>
    <div class="space-y-2">
      <h2 class="font-serif text-2xl font-bold tracking-wider text-[var(--entity-card-heading)] sm:text-3xl">
        {section.title}
      </h2>
      <p class="text-base leading-relaxed text-[var(--entity-card-text)]">
        {section.subtitle}
      </p>
    </div>
  </div>
  <span class="inline-flex items-center gap-2 text-[0.8rem] font-bold uppercase tracking-wide text-[var(--entity-card-cta)] transition-colors group-hover:text-[var(--entity-card-cta-hover)]">
    Explore <span aria-hidden="true">→</span>
  </span>
</a>

<style is:inline>
  .entity-hub-card {
    border-color: var(--entity-card-border);
    background:
      radial-gradient(130% 120% at 8% 10%, color-mix(in srgb, var(--entity-card-highlight) 24%, transparent 76%), transparent 68%),
      linear-gradient(160deg, var(--entity-card-surface-top), var(--entity-card-surface-bottom));
    color: var(--entity-card-text);
    box-shadow: 0 12px 30px -24px color-mix(in srgb, var(--entity-card-glow) 70%, transparent 30%);
  }

  .entity-hub-card:hover,
  .entity-hub-card:focus-visible {
    border-color: color-mix(in srgb, var(--entity-card-accent) 36%, var(--entity-card-border) 64%);
    box-shadow: 0 16px 38px -26px color-mix(in srgb, var(--entity-card-accent) 18%, var(--entity-card-glow) 82%);
    outline-color: color-mix(in srgb, var(--entity-card-accent) 42%, var(--entity-card-border) 58%);
  }
</style>
