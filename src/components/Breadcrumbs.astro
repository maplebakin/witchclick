---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

const { items = [] } = Astro.props as { items?: BreadcrumbItem[] };
const trail = Array.isArray(items)
  ? items.filter((item): item is BreadcrumbItem => Boolean(item?.label))
  : [];

if (trail.length === 0) {
  return null;
}

const previous = trail.length > 1 ? trail[trail.length - 2] : null;
const previousHref = previous?.href;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  {previousHref && (
    <a class="breadcrumbs__back focus-ring" href={previousHref}>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span>Back to {previous.label}</span>
    </a>
  )}
  <ol class="breadcrumbs__list">
    {trail.map((item, index) => {
      const isCurrent = index === trail.length - 1;
      const isHome = index === 0 && item.label.toLowerCase() === 'home';
      return (
        <li class="breadcrumbs__item">
          {item.href && !isCurrent ? (
            <a class="breadcrumbs__link focus-ring" href={item.href}>
              {isHome ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              ) : null}
              {item.label}
            </a>
          ) : (
            <span class="breadcrumbs__current" aria-current={isCurrent ? "page" : undefined}>
              {item.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs {
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--theme-text-tertiary);
  }

  .breadcrumbs__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--theme-text-tertiary);
    background: color-mix(in srgb, var(--theme-color-gold, #d4af37) 8%, transparent 92%);
    border: 1px solid color-mix(in srgb, var(--theme-color-gold, #d4af37) 22%, transparent 78%);
    border-radius: var(--wc-radius-sm, 0.75rem);
    text-decoration: none;
    transition: all 0.2s ease;
    min-height: 36px; /* Ensure adequate touch target */
    width: fit-content;
  }

  .breadcrumbs__back:hover {
    background: color-mix(in srgb, var(--theme-color-gold, #d4af37) 12%, transparent 88%);
    border-color: color-mix(in srgb, var(--theme-color-gold, #d4af37) 35%, transparent 65%);
    color: var(--theme-ink-strong, #1a102c);
    transform: translateX(-2px);
  }

  .breadcrumbs__back:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 55%);
    outline-offset: 2px;
  }

  .breadcrumbs__back svg {
    flex-shrink: 0;
  }

  .breadcrumbs__list {
    display: none;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--theme-text-tertiary);
  }

  .breadcrumbs__item:not(:first-child)::before {
    content: "›";
    color: color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, transparent 55%);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0.125rem;
  }

  .breadcrumbs__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    color: var(--theme-text-tertiary);
    font-weight: 500;
    text-decoration: none;
    background: color-mix(in srgb, var(--theme-color-gold, #d4af37) 0%, transparent 100%);
    border: 1px solid transparent;
    border-radius: var(--wc-radius-sm, 0.75rem);
    transition: all 0.15s ease;
    min-height: 32px; /* Adequate touch target */
  }

  .breadcrumbs__link svg {
    flex-shrink: 0;
  }

  .breadcrumbs__link:hover,
  .breadcrumbs__link:focus-visible {
    color: var(--theme-ink-strong, #1a102c);
    background: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 8%, transparent 92%);
    border-color: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 20%, transparent 80%);
  }

  .breadcrumbs__link:focus-visible {
    outline: 2px solid var(--theme-color-iris, var(--theme-color-gold, #d4af37));
    outline-offset: 2px;
  }

  .breadcrumbs__current {
    display: inline-block;
    padding: 0.375rem 0.625rem;
    color: var(--theme-ink-strong, #1a102c);
    font-weight: 600;
    background: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 10%, transparent 90%);
    border: 1px solid color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 22%, transparent 78%);
    border-radius: var(--wc-radius-sm, 0.75rem);
  }

  @media (min-width: 640px) {
    .breadcrumbs__back {
      display: none;
    }

    .breadcrumbs__list {
      display: inline-flex;
    }
  }

  /* Dawn theme adjustments */
  :root[data-comfort-theme="dawn"] .breadcrumbs__back {
    background: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 6%, transparent 94%);
    border-color: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 18%, transparent 82%);
  }

  :root[data-comfort-theme="dawn"] .breadcrumbs__back:hover {
    background: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 12%, transparent 88%);
    border-color: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 32%, transparent 68%);
  }

  :root[data-comfort-theme="dawn"] .breadcrumbs__link:hover,
  :root[data-comfort-theme="dawn"] .breadcrumbs__link:focus-visible {
    background: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 10%, transparent 90%);
    border-color: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 24%, transparent 76%);
  }

  :root[data-comfort-theme="dawn"] .breadcrumbs__current {
    background: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 12%, transparent 88%);
    border-color: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 26%, transparent 74%);
  }
</style>
