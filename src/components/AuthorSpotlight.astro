---
import type { AuthorProfile } from "@/utils/authors";

interface Props {
  author: AuthorProfile;
  class?: string;
  compact?: boolean;
  linkToProfile?: boolean;
  postCount?: number;
}

const { author, class: className, compact = false, linkToProfile = true, postCount } = Astro.props as Props;
const authorUrl = `/author/${author.slug}/`;
const hasLinks = Array.isArray(author.links) && author.links.length > 0;
---
<article
  class:list={["card-panel", "card-tier-1", "card-panel-soft", "author-spotlight", compact && "author-spotlight--compact", className]}
  data-author-slug={author.slug}
>
  <div class="author-spotlight__header">
    <div>
      {linkToProfile ? (
        <a class="author-spotlight__name" href={authorUrl}>
          {author.name}
        </a>
      ) : (
        <span class="author-spotlight__name">{author.name}</span>
      )}
      {author.pronouns && <span class="author-spotlight__pronouns">{author.pronouns}</span>}
    </div>
    {author.title && <p class="author-spotlight__title">{author.title}</p>}
    {author.focus && <p class="author-spotlight__focus">{author.focus}</p>}
    {typeof postCount === "number" && (
      <p class="author-spotlight__count">{postCount} {postCount === 1 ? "story" : "stories"}</p>
    )}
  </div>

  {author.bio && <p class="author-spotlight__bio">{author.bio}</p>}

  {author.specialties?.length && author.specialties.length > 0 && (
    <ul class="author-spotlight__specialties">
      {author.specialties.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )}

  {hasLinks && (
    <ul class="author-spotlight__links">
      {author.links.map((link) => (
        <li>
          <a href={link.url} rel={link.rel} target="_blank">
            {link.title}
          </a>
        </li>
      ))}
    </ul>
  )}
</article>

<style>
  .author-spotlight {
    --card-hover-translate: -0.2rem;
    --card-elevation-base: var(--elevation-tier-1);
    --card-elevation-hover: var(--elevation-tier-2);
    border: 1px solid color-mix(in srgb, var(--ambient-color, hsl(var(--accent-2) / 1)) 32%, var(--card-panel-border, currentColor) 68%);
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--ambient-color, hsl(var(--accent-2) / 1)) 18%, transparent 82%), transparent),
      var(--card-panel-surface);
    padding: clamp(1.25rem, 3vw, 1.85rem);
    display: grid;
    gap: 0.75rem;
    color: color-mix(in srgb, var(--ink-body, var(--text-body)) 92%, white 8%);
  }

  .author-spotlight--compact {
    padding: clamp(1rem, 2.5vw, 1.4rem);
    gap: 0.5rem;
  }

  .author-spotlight__header {
    display: grid;
    gap: 0.35rem;
  }

  .author-spotlight__name {
    font-size: clamp(1.15rem, 2.6vw, 1.45rem);
    font-weight: 700;
    text-decoration: none;
    color: color-mix(in srgb, var(--ink-strong, var(--text-strong)) 85%, var(--ambient-color, hsl(var(--accent-2) / 1)) 15%);
  }

  .author-spotlight__name:hover,
  .author-spotlight__name:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .author-spotlight__pronouns {
    display: inline-flex;
    margin-left: 0.65rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, var(--ink-muted, var(--text-muted)) 78%, white 22%);
  }

  .author-spotlight__title,
  .author-spotlight__focus,
  .author-spotlight__count {
    margin: 0;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--ink-muted, var(--text-muted)) 82%, white 18%);
  }

  .author-spotlight__bio {
    margin: 0;
    line-height: 1.55;
  }

  .author-spotlight__specialties {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .author-spotlight__specialties li {
    background: color-mix(in srgb, var(--ambient-color, hsl(var(--accent-2) / 1)) 12%, white 88%);
    border-radius: 999px;
    padding: 0.25rem 0.9rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink-strong, hsl(var(--neutral-8) / 1)) 80%, white 20%);
  }

  .author-spotlight__links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .author-spotlight__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--ambient-color, hsl(var(--accent-2) / 1)) 70%, var(--ink-strong, hsl(var(--neutral-8) / 1)) 30%);
    text-decoration: none;
  }

  .author-spotlight__links a::after {
    content: "↗";
    font-size: 0.8rem;
  }

  .author-spotlight__links a:hover,
  .author-spotlight__links a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
