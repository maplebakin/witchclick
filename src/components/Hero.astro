---
const {
  kicker = 'Fresh from the coven',
  title = 'Cozy Cursing Ritual: Release Anger Through Banishment',
  blurb = 'A gentle, truth-centered ritual to name what hurt you, release it through symbolic banishment, and reclaim your peace—without causing harm.',
  primaryHref = '/posts/cozy-cursing-ritual',
  primaryLabel = 'Read the latest guide →',
  secondaryHref = '/tools',
  secondaryLabel = 'Explore printable tools',
  actionNote = 'Choose the featured ritual or explore printable tools to keep your practice grounded.',
  heroImageSrc = '',
  heroImageSrcset = '',
  heroImageSizes = '',
  heroImageAlt = ''
} = Astro.props;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '') || 'hero';

const noteText = typeof actionNote === 'string' ? actionNote.trim() : '';
const ctaDescriptionId = noteText ? `hero-cta-note-${slugify(title)}` : undefined;

const heroSrc = typeof heroImageSrc === 'string' ? heroImageSrc.trim() : '';
const hasHeroImage = heroSrc.length > 0;
const heroAlt = hasHeroImage
  ? (typeof heroImageAlt === 'string' && heroImageAlt.trim().length ? heroImageAlt.trim() : title)
  : '';
const providedSrcset = typeof heroImageSrcset === 'string' ? heroImageSrcset.trim() : '';
const autoSrcset = hasHeroImage
  ? [480, 768, 1080]
      .map((width) => `${heroSrc}${heroSrc.includes('?') ? '&' : '?'}w=${width} ${width}w`)
      .join(', ')
  : '';
const resolvedSrcset = providedSrcset || autoSrcset;
const resolvedSizes =
  typeof heroImageSizes === 'string' && heroImageSizes.trim().length
    ? heroImageSizes.trim()
    : '(max-width: 768px) 88vw, (max-width: 1200px) 360px, 420px';
const heroLoading = hasHeroImage ? 'eager' : 'lazy';
const heroFetchPriority = hasHeroImage ? 'high' : undefined;
---
<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__backdrop" aria-hidden="true"></div>
  <div class="wc-container home-hero__inner">
    <div class="home-hero__copy">
      <p class="home-hero__eyebrow">{kicker}</p>
      <h1 id="home-hero-title" class="home-hero__title">{title}</h1>
      <p class="home-hero__blurb">{blurb}</p>
      <div class="home-hero__actions">
        <a
          class="hero-cta hero-cta--primary"
          href={primaryHref}
          data-analytics="hero_primary"
          aria-describedby={ctaDescriptionId}
        >
          {primaryLabel}
        </a>
        <a
          class="hero-cta hero-cta--secondary"
          href={secondaryHref}
          data-analytics="hero_secondary"
          aria-describedby={ctaDescriptionId}
        >
          {secondaryLabel}
        </a>
      </div>
      {noteText && (
        <p id={ctaDescriptionId} class="home-hero__note">
          {noteText}
        </p>
      )}
    </div>
    {hasHeroImage && (
      <figure class="home-hero__media" aria-hidden={heroAlt ? undefined : 'true'}>
        <img
          class="home-hero__image"
          src={heroSrc}
          alt={heroAlt}
          loading={heroLoading}
          fetchpriority={heroFetchPriority}
          decoding="async"
          srcset={resolvedSrcset || undefined}
          sizes={resolvedSrcset ? resolvedSizes : undefined}
        />
      </figure>
    )}
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
    border-radius: clamp(1.75rem, 4vw, 2.5rem);
    background:
      radial-gradient(120% 120% at 18% 12%, rgba(212, 175, 55, 0.28), transparent 60%),
      radial-gradient(90% 100% at 82% 10%, rgba(124, 78, 176, 0.32), transparent 72%),
      linear-gradient(135deg, rgba(9, 4, 18, 0.92), rgba(22, 11, 33, 0.96));
  }

  .home-hero__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 70% at 10% 20%, rgba(255, 203, 128, 0.15), transparent 75%),
      radial-gradient(55% 65% at 90% 30%, rgba(151, 129, 215, 0.18), transparent 75%);
    mix-blend-mode: screen;
    opacity: 0.8;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.4rem, 4vw, 2.5rem);
    max-width: 72rem;
  }

  .home-hero__copy {
    display: grid;
    gap: clamp(1.2rem, 3vw, 2rem);
    max-width: 40rem;
  }

  .home-hero__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .home-hero__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    line-height: 1.08;
    color: var(--text-primary);
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 600;
  }

  .home-hero__blurb {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .home-hero__note {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-tertiary);
    max-width: 52ch;
  }

  .home-hero__media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .home-hero__media::after {
    content: "";
    position: absolute;
    inset: 12% 10%;
    border-radius: 1.8rem;
    background: radial-gradient(circle at 30% 25%, rgba(255, 209, 140, 0.22), transparent 60%);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .home-hero__image {
    width: min(100%, 21rem);
    border-radius: 1.8rem;
    border: 1px solid color-mix(in srgb, var(--color-border, rgba(212, 175, 55, 0.35)) 70%, transparent 30%);
    background: color-mix(in srgb, var(--color-overlay, rgba(18, 7, 37, 0.45)) 55%, transparent 45%);
    box-shadow: var(--shadow-soft, 0 24px 55px -30px rgba(11, 6, 20, 0.65));
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
  }

  .hero-cta {
    min-width: 0;
  }

  @media (max-width: 640px) {
    .home-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-cta {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 720px) {
    .home-hero__media {
      margin-inline: auto;
      max-width: min(85vw, 20rem);
    }

    .home-hero__note {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .home-hero__image {
      width: min(100%, 18rem);
    }
  }

  @media (max-width: 400px) {
    .home-hero {
      padding-block: 2.25rem;
    }

    .home-hero__actions {
      gap: var(--space-2, 0.5rem);
    }
  }

  @media (min-width: 960px) {
    .home-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
      gap: clamp(2rem, 5vw, 3.5rem);
    }

    .home-hero__media {
      justify-content: flex-end;
    }
  }

  /* Dawn theme overrides */
  :root[data-comfort-theme="dawn"] .home-hero {
    background:
      radial-gradient(110% 120% at 20% 12%, rgba(222, 192, 132, 0.22), transparent 62%),
      radial-gradient(90% 95% at 82% 18%, rgba(186, 166, 220, 0.24), transparent 70%),
      linear-gradient(135deg, rgba(248, 244, 236, 0.96), rgba(240, 233, 225, 0.96));
  }

  :root[data-comfort-theme="dawn"] .home-hero__image {
    border-color: color-mix(in srgb, var(--color-border, rgba(122, 94, 154, 0.35)) 75%, transparent 25%);
    background: color-mix(in srgb, var(--color-overlay, rgba(242, 236, 229, 0.48)) 60%, transparent 40%);
  }

  /* Dawn theme text colors are handled by CSS variables */
</style>
