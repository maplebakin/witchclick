---
const {
  kicker = 'Fresh from the coven',
  title = 'Cozy Cursing Ritual: Release Anger Through Banishment',
  blurb = 'A gentle, truth-centered ritual to name what hurt you, release it through symbolic banishment, and reclaim your peace—without causing harm.',
  primaryHref = '/posts/cozy-cursing-ritual',
  primaryLabel = 'Read the latest guide →',
  secondaryHref = '/tools',
  secondaryLabel = 'Explore printable tools',
  actionNote = 'Choose the featured ritual or explore printable tools to keep your practice grounded.',
  heroImageSrc = '',
  heroImageSrcset = '',
  heroImageSizes = '',
  heroImageAlt = ''
} = Astro.props;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '') || 'hero';

const noteText = typeof actionNote === 'string' ? actionNote.trim() : '';
const ctaDescriptionId = noteText ? `hero-cta-note-${slugify(title)}` : undefined;

const heroSrc = typeof heroImageSrc === 'string' ? heroImageSrc.trim() : '';
const hasHeroImage = heroSrc.length > 0;
const heroAlt = hasHeroImage
  ? (typeof heroImageAlt === 'string' && heroImageAlt.trim().length ? heroImageAlt.trim() : title)
  : '';
const providedSrcset = typeof heroImageSrcset === 'string' ? heroImageSrcset.trim() : '';
const autoSrcset = hasHeroImage
  ? [480, 768, 1080]
      .map((width) => `${heroSrc}${heroSrc.includes('?') ? '&' : '?'}w=${width} ${width}w`)
      .join(', ')
  : '';
const resolvedSrcset = providedSrcset || autoSrcset;
const resolvedSizes =
  typeof heroImageSizes === 'string' && heroImageSizes.trim().length
    ? heroImageSizes.trim()
    : '(max-width: 768px) 88vw, (max-width: 1200px) 360px, 420px';
const heroLoading = hasHeroImage ? 'eager' : 'lazy';
const heroFetchPriority = hasHeroImage ? 'high' : undefined;
---
<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__backdrop" aria-hidden="true"></div>
  <div class="wc-container home-hero__inner">
    <div class="home-hero__copy">
      <p class="home-hero__eyebrow">{kicker}</p>
      <h1 id="home-hero-title" class="home-hero__title">{title}</h1>
      <p class="home-hero__blurb">{blurb}</p>
      <div class="home-hero__actions">
        <a
          class="hero-cta hero-cta--primary"
          href={primaryHref}
          data-analytics="hero_primary"
          aria-describedby={ctaDescriptionId}
        >
          {primaryLabel}
        </a>
        <a
          class="hero-cta hero-cta--secondary"
          href={secondaryHref}
          data-analytics="hero_secondary"
          aria-describedby={ctaDescriptionId}
        >
          {secondaryLabel}
        </a>
      </div>
      {noteText && (
        <p id={ctaDescriptionId} class="home-hero__note">
          {noteText}
        </p>
      )}
    </div>
    {hasHeroImage && (
      <figure class="home-hero__media" aria-hidden={heroAlt ? undefined : 'true'}>
        <img
          class="home-hero__image"
          src={heroSrc}
          alt={heroAlt}
          loading={heroLoading}
          fetchpriority={heroFetchPriority}
          decoding="async"
          srcset={resolvedSrcset || undefined}
          sizes={resolvedSrcset ? resolvedSizes : undefined}
        />
      </figure>
    )}
  </div>
</section>

<style>
  .home-hero {
    --hero-surface: var(
      --hero-surface-layer,
      var(--glass-card, color-mix(in srgb, var(--theme-surface-panel) 88%, transparent 12%))
    );
    --hero-border-color: var(
      --hero-border-color-layer,
      color-mix(in srgb, var(--glass-border, var(--theme-color-gold, #d4af37)) 82%, transparent 18%)
    );
    --hero-shadow-layer: var(
      --hero-shadow-layer-fallback,
      var(--glass-shadow-strong, 0 32px 70px -40px rgba(11, 6, 20, 0.6))
    );
    --hero-backdrop-layer: var(
      --hero-backdrop,
      radial-gradient(
        circle at 18% 18%,
        color-mix(in srgb, var(--glass-highlight, var(--theme-color-gold, #d4af37)) 30%, transparent 70%),
        transparent 56%
      )
    );
    position: relative;
    padding-block: var(--hero-padding-block, clamp(4rem, 10vw, 7rem));
    overflow: hidden;
    border-radius: var(--hero-radius, clamp(2rem, 5vw, 3.25rem));
    border: var(--hero-border, 1px solid var(--hero-border-color));
    background: var(--hero-background, var(--hero-surface));
    box-shadow: var(--hero-shadow, var(--hero-shadow-layer));
  }

  .home-hero__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--hero-backdrop-layer);
    mix-blend-mode: screen;
    opacity: 0.85;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--hero-inner-gap, clamp(1.5rem, 4vw, 2.75rem));
    max-width: 72rem;
  }

  .home-hero__copy {
    display: grid;
    gap: var(--hero-copy-gap, clamp(1.5rem, 4vw, 2.5rem));
    max-width: 42rem;
  }

  .home-hero__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--hero-eyebrow-color, var(--theme-text-tertiary));
  }

  .home-hero__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.9rem, 6.2vw, 4.5rem);
    line-height: 1.05;
    color: var(--comfort-chip-text-strong, var(--theme-text-primary));
    text-transform: none;
    letter-spacing: 0.015em;
    font-weight: 600;
  }

  .home-hero__blurb {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(1.05rem, 2.6vw, 1.25rem);
    line-height: 1.75;
    color: var(--hero-blurb-color, var(--theme-text-secondary));
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.85rem, 2.4vw, 1.5rem);
  }

  .home-hero__note {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--hero-note-color, var(--theme-text-tertiary));
    max-width: 52ch;
  }

  .home-hero__media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .home-hero__media::after {
    content: "";
    position: absolute;
    inset: 10% 8%;
    border-radius: 2rem;
    background: radial-gradient(
      circle at 30% 20%,
      color-mix(in srgb, var(--glass-highlight, var(--theme-color-gold)) 32%, transparent 68%),
      transparent 65%
    );
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .home-hero__image {
    width: min(100%, 24rem);
    border-radius: 2rem;
    border: var(--hero-image-border, 1px solid color-mix(in srgb, var(--theme-color-gold, #d4af37) 35%, var(--theme-color-iris, #4b2a63) 25%));
    background: var(--hero-image-surface, rgba(24, 14, 34, 0.65));
    box-shadow: var(--hero-media-shadow, var(--glass-shadow-strong, 0 32px 70px -40px rgba(11, 6, 20, 0.6)));
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
  }

  .hero-cta {
    min-width: 0;
  }

  @media (max-width: 640px) {
    .home-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-cta {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 720px) {
    .home-hero__media {
      margin-inline: auto;
      max-width: min(85vw, 20rem);
    }

    .home-hero__note {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .home-hero__image {
      width: min(100%, 18rem);
    }
  }

  @media (max-width: 400px) {
    .home-hero {
      padding-block: 2.25rem;
    }

    .home-hero__actions {
      gap: var(--space-2, 0.5rem);
    }
  }

  @media (min-width: 960px) {
    .home-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
      gap: clamp(2rem, 5vw, 3.5rem);
    }

    .home-hero__media {
      justify-content: flex-end;
    }
  }

  /* Dawn theme text colors are handled by CSS variables */
</style>
