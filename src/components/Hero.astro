---
const {
  kicker = 'Fresh from the coven',
  title = 'Cozy Cursing Ritual: Release Anger Through Banishment',
  blurb = 'A gentle, truth-centered ritual to name what hurt you, release it through symbolic banishment, and reclaim your peace—without causing harm.',
  primaryHref = '/posts/cozy-cursing-ritual',
  primaryLabel = 'Read the latest guide →',
  secondaryHref = '/tools',
  secondaryLabel = 'Explore printable tools'
} = Astro.props;
---
<section role="banner" class="relative">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16 lg:py-20">
    <p class="mb-2 text-sm uppercase tracking-wide opacity-70">{kicker}</p>
    <h1 class="mb-4 text-3xl/tight font-bold md:text-5xl/tight">
      {title}
    </h1>
    <p class="mb-8 max-w-3xl text-base opacity-90 md:text-lg">
      {blurb}
    </p>
    <div class="flex flex-wrap gap-3">
      <a href={primaryHref} class="inline-flex items-center rounded-xl border px-4 py-2 font-medium hover:shadow">
        {primaryLabel}
      </a>
      <a href={secondaryHref} class="inline-flex items-center rounded-xl border px-4 py-2 font-medium hover:shadow">
        {secondaryLabel}
      </a>
    </div>
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -z-10 top-0 h-[40vh] bg-gradient-to-b from-zinc-100 to-transparent dark:from-zinc-900"></div>
</section>
