---
const {
  kicker = 'Fresh from the coven',
  title = 'Cozy Cursing Ritual: Release Anger Through Banishment',
  blurb = 'A gentle, truth-centered ritual to name what hurt you, release it through symbolic banishment, and reclaim your peace—without causing harm.',
  primaryHref = '/posts/cozy-cursing-ritual',
  primaryLabel = 'Read the latest guide →',
  secondaryHref = '/tools',
  secondaryLabel = 'Explore printable tools'
} = Astro.props;
---
<section role="banner" class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__backdrop" aria-hidden="true"></div>
  <div class="wc-container home-hero__inner">
    <p class="home-hero__eyebrow">{kicker}</p>
    <h1 id="home-hero-title" class="home-hero__title">{title}</h1>
    <p class="home-hero__blurb">{blurb}</p>
    <div class="home-hero__actions">
      <a class="hero-cta hero-cta--primary" href={primaryHref} data-analytics="hero_primary">
        {primaryLabel}
      </a>
      <a class="hero-cta hero-cta--secondary" href={secondaryHref} data-analytics="hero_secondary">
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }

  .home-hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(75% 60% at 15% 10%, rgba(212, 175, 55, 0.28), transparent 70%),
      radial-gradient(85% 65% at 85% 0%, rgba(124, 78, 176, 0.35), transparent 70%),
      linear-gradient(160deg, rgba(26, 14, 38, 0.92), rgba(12, 5, 23, 0.85));
    filter: saturate(1.1);
    opacity: 0.95;
    transform: translate3d(0, 0, 0) scale(1);
    animation: heroBackdropDrift 26s ease-in-out infinite;
    will-change: transform, opacity;
  }

  .home-hero::before {
    content: "";
    position: absolute;
    inset: -40% 20% auto;
    height: 55%;
    border-radius: 999px;
    background: radial-gradient(circle at 50% 0%, rgba(124, 78, 176, 0.32), transparent 70%);
    opacity: 0.35;
    filter: blur(35px);
    transform: translate3d(0, 0, 0) scale(0.95);
    animation: heroAuroraSweep 20s ease-in-out infinite;
    pointer-events: none;
  }

  .home-hero::after {
    content: "";
    position: absolute;
    inset: -20% 10% auto;
    height: 65%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.2), transparent 70%);
    filter: blur(40px);
    opacity: 0.35;
    pointer-events: none;
    transform: translate3d(0, 0, 0) scale(1);
    animation: heroHaloPulse 18s ease-in-out infinite;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.2rem, 4vw, 2rem);
    max-width: 72rem;
    animation: heroContentFloat 24s ease-in-out infinite;
  }

  .home-hero__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(244, 241, 255, 0.75);
  }

  .home-hero__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    color: rgba(244, 241, 255, 0.94);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .home-hero__blurb {
    margin: 0;
    max-width: 58ch;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    line-height: 1.75;
    color: rgba(244, 241, 255, 0.78);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3, 0.75rem);
  }

  .hero-cta {
    min-width: 0;
  }

  @media (max-width: 640px) {
    .home-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-cta {
      width: 100%;
      justify-content: center;
    }
  }

  /* Dawn theme overrides */
  :root[data-comfort-theme="dawn"] .home-hero__backdrop {
    background:
      radial-gradient(75% 60% at 15% 10%, rgba(155, 134, 200, 0.18), transparent 70%),
      radial-gradient(85% 65% at 85% 0%, rgba(180, 154, 217, 0.22), transparent 70%),
      linear-gradient(160deg, rgba(252, 248, 242, 0.92), rgba(248, 242, 238, 0.95));
  }

  :root[data-comfort-theme="dawn"] .home-hero::after {
    background: radial-gradient(circle at 50% 0%, rgba(155, 134, 200, 0.25), transparent 70%);
  }

  :root[data-comfort-theme="dawn"] .home-hero__eyebrow {
    color: rgba(44, 27, 61, 0.75);
  }

  :root[data-comfort-theme="dawn"] .home-hero__title {
    color: rgba(44, 27, 61, 0.94);
  }

  :root[data-comfort-theme="dawn"] .home-hero__blurb {
    color: rgba(44, 27, 61, 0.78);
  }

  @keyframes heroBackdropDrift {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-1.5%, 1.25%, 0) scale(1.03);
    }
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes heroHaloPulse {
    0% {
      opacity: 0.28;
      transform: translate3d(0, 0, 0) scale(0.96);
    }
    50% {
      opacity: 0.42;
      transform: translate3d(0, -4%, 0) scale(1.05);
    }
    100% {
      opacity: 0.28;
      transform: translate3d(0, 0, 0) scale(0.96);
    }
  }

  @keyframes heroAuroraSweep {
    0% {
      opacity: 0.28;
      transform: translate3d(-4%, 6%, 0) scale(0.9) rotate(-6deg);
    }
    50% {
      opacity: 0.42;
      transform: translate3d(3%, -4%, 0) scale(1.05) rotate(4deg);
    }
    100% {
      opacity: 0.28;
      transform: translate3d(-4%, 6%, 0) scale(0.9) rotate(-6deg);
    }
  }

  @keyframes heroContentFloat {
    0% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -0.35rem, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__backdrop,
    .home-hero::before,
    .home-hero::after,
    .home-hero__inner {
      animation: none !important;
      transform: none !important;
    }
  }
</style>
