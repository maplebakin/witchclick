---
import { getImage } from "astro:assets";

interface CTAButton {
  href: string;
  label: string;
  variant?: "primary" | "secondary";
  ariaLabel?: string;
  rel?: string;
  target?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  backgroundImage?: string;
  imageAlt?: string;
  ctaButtons?: CTAButton[];
  ctaDescription?: string;
  class?: string;
}

const {
  eyebrow = "Fresh from the coven",
  title,
  description,
  backgroundImage,
  imageAlt = title,
  ctaButtons = [],
  ctaDescription,
  class: className = "",
} = Astro.props as Props;

const hasImage = Boolean(backgroundImage);
const hasMultipleCtas = ctaButtons.length > 1;
const ctaDescriptionId = hasMultipleCtas && ctaDescription
  ? `hero-cta-description-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "hero"}`
  : undefined;
const ctaGroupLabel = hasMultipleCtas ? "Hero actions" : undefined;

let responsiveImage: Awaited<ReturnType<typeof getImage>> | null = null;
if (hasImage && backgroundImage) {
  try {
    const imageUrl = new URL(`../../public${backgroundImage}`, import.meta.url);
    responsiveImage = await getImage({
      src: imageUrl,
      widths: [480, 720, 1080],
      format: "webp",
      quality: "mid",
    });
  } catch (error) {
    if (import.meta.env?.DEV) {
      console.warn(`[Hero] Failed to create responsive image for ${backgroundImage}:`, error);
    }
    responsiveImage = null;
  }
}

const heroImageSrc = responsiveImage?.src ?? backgroundImage;
const heroImageSrcSet = responsiveImage?.srcSet?.attribute ?? undefined;
const heroImageWidth = responsiveImage?.attributes?.width;
const heroImageHeight = responsiveImage?.attributes?.height;
const heroImageSizes = "(max-width: 639px) 88vw, (max-width: 1023px) 60vw, 520px";
---
<section
  class:list={[
    "hero-panel panel",
    hasImage ? "hero-panel--with-media" : "hero-panel--simple",
    className,
  ]}
>
  <div class="hero-content">
    {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
    <h1 class="hero-title font-serif">{title}</h1>
    <p class="hero-summary">{description}</p>
    {ctaButtons.length > 0 && (
      <>
        {ctaDescriptionId && ctaDescription && (
          <p id={ctaDescriptionId} class="hero-actions-context">
            {ctaDescription}
          </p>
        )}
        <div
          class="hero-actions"
          role="group"
          aria-label={ctaGroupLabel}
          aria-describedby={ctaDescriptionId}
        >
          {ctaButtons.map((button) => {
            const variant = button.variant ?? "primary";
            const analyticsEvent = variant === "secondary" ? "hero_secondary_click" : "hero_primary_click";
            const analyticsProps = JSON.stringify({ label: button.label });
            return (
              <a
                href={button.href}
                aria-label={button.ariaLabel ?? undefined}
                target={button.target ?? undefined}
                rel={button.rel ?? undefined}
                class:list={[
                  "hero-cta",
                  variant === "secondary" ? "hero-cta--secondary" : "hero-cta--primary",
                ]}
                data-analytics={analyticsEvent}
                data-analytics-props={analyticsProps}
              >
                {button.label}
                {variant !== "secondary" && <span aria-hidden="true">→</span>}
              </a>
            );
          })}
        </div>
      </>
    )}
  </div>
  {hasImage && backgroundImage && (
    <div class="hero-media">
      <picture>
        {heroImageSrcSet && (
          <source type="image/webp" srcset={heroImageSrcSet} sizes={heroImageSizes} />
        )}
        <img
          src={heroImageSrc}
          srcset={heroImageSrcSet}
          sizes={heroImageSizes}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
          width={heroImageWidth}
          height={heroImageHeight}
        />
      </picture>
    </div>
  )}
</section>

<style>
  .hero-panel {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.75rem);
    padding: clamp(1.85rem, 4.5vw, 3rem);
    border-radius: clamp(1.8rem, 4vw, 2.6rem);
    border: 1px solid rgba(212, 175, 55, 0.28);
    background:
      radial-gradient(120% 120% at 10% -5%, rgba(212, 175, 55, 0.25), transparent 70%),
      radial-gradient(110% 120% at 90% 0%, rgba(124, 78, 176, 0.22), transparent 75%),
      linear-gradient(160deg, rgba(18, 7, 37, 0.92), rgba(9, 4, 20, 0.88));
    box-shadow: var(--shadow-soft);
    color: rgba(244, 241, 255, 0.9);
    overflow: hidden;
  }

  .hero-panel::before {
    content: "";
    position: absolute;
    inset: -20% -25% -30% -25%;
    background:
      radial-gradient(60% 60% at 30% 20%, rgba(212, 175, 55, 0.28), transparent 70%),
      radial-gradient(80% 60% at 85% 15%, rgba(124, 78, 176, 0.3), transparent 80%);
    opacity: 0.45;
    pointer-events: none;
    z-index: 0;
  }

  .hero-panel > * {
    position: relative;
    z-index: 1;
  }

  .hero-panel--with-media {
    align-items: center;
    gap: clamp(1.75rem, 5vw, 3rem);
  }

  @media (min-width: 1024px) {
    .hero-panel--with-media {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  .hero-content {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.6rem);
  }

  .hero-eyebrow {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    color: rgba(244, 241, 255, 0.65);
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.6rem, 5.5vw, 3.6rem);
    font-weight: 600;
    line-height: 1.08;
    color: var(--color-gold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-summary {
    margin: 0;
    max-width: 48ch;
    font-size: clamp(1.05rem, 3vw, 1.3rem);
    line-height: 1.7;
    color: rgba(244, 241, 255, 0.82);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-actions-context {
    margin: 0;
    margin-bottom: 0.35rem;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(244, 241, 255, 0.55);
  }

  .hero-media {
    position: relative;
    border-radius: clamp(1.4rem, 3vw, 1.75rem);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    border: 1px solid rgba(212, 175, 55, 0.28);
    background: linear-gradient(150deg, rgba(18, 7, 37, 0.88), rgba(9, 4, 20, 0.82));
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  .hero-media picture,
  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-media img {
    border-radius: clamp(1rem, 2.5vw, 1.4rem);
    object-fit: cover;
    max-height: clamp(14rem, 32vw, 20rem);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, white 75%, transparent);
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 639px) {
    .hero-panel {
      padding: clamp(1.5rem, 6vw, 2.5rem);
    }

    .hero-actions {
      gap: var(--space-2);
    }

    .hero-media {
      margin-inline: auto;
      max-width: min(90vw, 22rem);
    }
  }

  @media (max-width: 399px) {
    .hero-panel {
      padding: 1.25rem;
    }

    .hero-title {
      font-size: clamp(1.95rem, 8vw, 2.4rem);
    }

    .hero-cta {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta,
    .hero-media,
    .hero-panel {
      transition-duration: 0ms !important;
      transition: none;
    }
  }
</style>
