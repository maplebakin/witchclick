---
/**
 * GlobalSearch - Cmd+K global search modal for admin
 * Searches across posts, entities, authors, downloads
 */

const DEV_API = import.meta.env.PUBLIC_DEV_API || 'http://localhost:8787';
---

<div class="global-search-overlay" data-global-search-overlay>
  <div class="global-search-modal" data-global-search-modal>
    <div class="global-search-header">
      <svg class="global-search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input
        type="text"
        class="global-search-input"
        data-global-search-input
        placeholder="Search posts, entities, authors..."
        autocomplete="off"
        spellcheck="false"
        aria-controls="global-search-results"
        aria-expanded="false"
      />
      <kbd class="global-search-kbd">ESC</kbd>
    </div>

    <div class="global-search-body" data-global-search-body aria-live="polite" aria-atomic="true" aria-busy="false">
      <div class="global-search-empty" data-global-search-empty role="status" aria-live="polite">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <p>Type to search across all content</p>
      </div>

      <div class="global-search-results" data-global-search-results id="global-search-results" role="listbox" aria-label="Search results"></div>

      <div class="global-search-loading" data-global-search-loading role="status" aria-live="polite">
        <div class="global-search-spinner"></div>
        <p>Searching...</p>
      </div>
    </div>

    <div class="global-search-footer">
      <div class="global-search-footer-group">
        <kbd>↑</kbd><kbd>↓</kbd>
        <span>Navigate</span>
      </div>
      <div class="global-search-footer-group">
        <kbd>↵</kbd>
        <span>Open</span>
      </div>
      <div class="global-search-footer-group">
        <kbd>ESC</kbd>
        <span>Close</span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ DEV_API }}>
  function initGlobalSearch() {
    const overlay = document.querySelector('[data-global-search-overlay]');
    const modal = document.querySelector('[data-global-search-modal]');
    const input = document.querySelector('[data-global-search-input]');
    const body = document.querySelector('[data-global-search-body]');
    const resultsContainer = document.querySelector('[data-global-search-results]');
    const emptyState = document.querySelector('[data-global-search-empty]');
    const loadingState = document.querySelector('[data-global-search-loading]');

    if (!overlay || !input || !resultsContainer) return;

    if (modal instanceof HTMLElement) {
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
    }

    let isOpen = false;
    let searchTimeout = null;
    let selectedIndex = -1;
    let results = [];

    function open() {
      if (isOpen) return;
      isOpen = true;
      overlay.style.display = 'flex';
      requestAnimationFrame(() => {
        overlay.classList.add('is-visible');
        setTimeout(() => input.focus(), 100);
      });
      if (input instanceof HTMLElement) {
        input.setAttribute('aria-expanded', 'true');
      }
      if (body instanceof HTMLElement) {
        body.scrollTop = 0;
      }
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      overlay.classList.remove('is-visible');
      setTimeout(() => {
        overlay.style.display = 'none';
        input.value = '';
        resultsContainer.innerHTML = '';
        results = [];
        selectedIndex = -1;
        showEmpty();
        if (input instanceof HTMLElement) {
          input.setAttribute('aria-expanded', 'false');
        }
        if (body instanceof HTMLElement) {
          body.scrollTop = 0;
        }
      }, 200);
    }

    function showEmpty() {
      if (body instanceof HTMLElement) {
        body.setAttribute('aria-busy', 'false');
      }
      if (emptyState) emptyState.style.display = 'flex';
      if (loadingState) loadingState.style.display = 'none';
      resultsContainer.style.display = 'none';
    }

    function showLoading() {
      if (body instanceof HTMLElement) {
        body.setAttribute('aria-busy', 'true');
      }
      if (emptyState) emptyState.style.display = 'none';
      if (loadingState) loadingState.style.display = 'flex';
      resultsContainer.style.display = 'none';
    }

    function showResults() {
      if (body instanceof HTMLElement) {
        body.setAttribute('aria-busy', 'false');
      }
      if (emptyState) emptyState.style.display = 'none';
      if (loadingState) loadingState.style.display = 'none';
      resultsContainer.style.display = 'block';
    }

    async function search(query) {
      if (!query || query.length < 2) {
        showEmpty();
        results = [];
        selectedIndex = -1;
        return;
      }

      showLoading();

      try {
        const [postsRes, entitiesRes] = await Promise.all([
          fetch(`${DEV_API}/posts/list`, { method: 'POST' }).catch(() => null),
          fetch(`${DEV_API}/entities/list`, { method: 'POST' }).catch(() => null),
        ]);

        const postsData = postsRes ? await postsRes.json() : { items: [] };
        const entitiesData = entitiesRes ? await entitiesRes.json() : { entities: [] };

        const lowerQuery = query.toLowerCase();

        // Search posts
        const posts = (postsData.items || [])
          .filter((item) => {
            const title = (item.title || '').toLowerCase();
            const slug = (item.slug || '').toLowerCase();
            const excerpt = (item.excerpt || '').toLowerCase();
            return title.includes(lowerQuery) || slug.includes(lowerQuery) || excerpt.includes(lowerQuery);
          })
          .slice(0, 10)
          .map((item) => ({
            type: 'post',
            title: item.title || item.slug,
            slug: item.slug,
            description: item.excerpt || item.metaDescription || '',
            url: `/admin/posts?slug=${encodeURIComponent(item.slug)}`,
            icon: 'file-text',
          }));

        // Search entities
        const entities = (entitiesData.entities || [])
          .filter((item) => {
            const name = (item.name || '').toLowerCase();
            const slug = (item.slug || '').toLowerCase();
            const summary = (item.summary || '').toLowerCase();
            return name.includes(lowerQuery) || slug.includes(lowerQuery) || summary.includes(lowerQuery);
          })
          .slice(0, 10)
          .map((item) => ({
            type: 'entity',
            title: item.name || item.slug,
            slug: item.slug,
            description: `${item.type}: ${item.summary || ''}`.slice(0, 100),
            url: `/admin/entities?type=${item.type}&slug=${encodeURIComponent(item.slug)}`,
            icon: 'tag',
          }));

        results = [...posts, ...entities];

        if (results.length === 0) {
          resultsContainer.innerHTML = `
            <div class="global-search-no-results">
              <p>No results for "${query}"</p>
            </div>
          `;
        } else {
          resultsContainer.innerHTML = results
            .map(
              (result, index) => `
            <a
              href="${result.url}"
              class="global-search-result ${index === selectedIndex ? 'is-selected' : ''}"
              data-result-index="${index}"
            >
              <div class="global-search-result-icon">
                ${getIcon(result.icon)}
              </div>
              <div class="global-search-result-content">
                <div class="global-search-result-title">${escapeHtml(result.title)}</div>
                ${result.description ? `<div class="global-search-result-description">${escapeHtml(result.description)}</div>` : ''}
              </div>
              <div class="global-search-result-badge">${result.type}</div>
            </a>
          `
            )
            .join('');

          // Add click handlers
          const resultLinks = resultsContainer.querySelectorAll('.global-search-result');
          resultLinks.forEach((link, index) => {
            link.addEventListener('mouseenter', () => {
              selectedIndex = index;
              updateSelection();
            });
          });
        }

        showResults();
      } catch (err) {
        console.error('Search error:', err);
        resultsContainer.innerHTML = `
          <div class="global-search-no-results">
            <p>Search failed. Please try again.</p>
          </div>
        `;
        showResults();
      }
    }

    function updateSelection() {
      const resultLinks = resultsContainer.querySelectorAll('.global-search-result');
      resultLinks.forEach((link, index) => {
        if (index === selectedIndex) {
          link.classList.add('is-selected');
          link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          link.classList.remove('is-selected');
        }
      });
    }

    function navigateDown() {
      if (results.length === 0) return;
      selectedIndex = (selectedIndex + 1) % results.length;
      updateSelection();
    }

    function navigateUp() {
      if (results.length === 0) return;
      selectedIndex = selectedIndex <= 0 ? results.length - 1 : selectedIndex - 1;
      updateSelection();
    }

    function selectCurrent() {
      if (selectedIndex >= 0 && selectedIndex < results.length) {
        const result = results[selectedIndex];
        window.location.href = result.url;
      }
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function getIcon(icon) {
      const icons = {
        'file-text': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>',
        'tag': '<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line>',
      };
      return `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[icon] || icons['file-text']}</svg>`;
    }

    // Event listeners
    input.addEventListener('input', (e) => {
      if (searchTimeout) clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        search(e.target.value.trim());
      }, 300);
    });

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      // Cmd+K or Ctrl+K to open
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (isOpen) close();
        else open();
        return;
      }

      if (!isOpen) return;

      // ESC to close
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }

      // Arrow navigation
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        navigateDown();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        navigateUp();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        selectCurrent();
      }
    });

    // Click outside to close
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        close();
      }
    });

    // Initialize
    showEmpty();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobalSearch);
  } else {
    initGlobalSearch();
  }
</script>

<style>
  .global-search-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    background: color-mix(in srgb, var(--theme-color-night) 50%, transparent);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.global-search-overlay.is-visible) {
    opacity: 1;
  }

  .global-search-modal {
    width: 100%;
    max-width: 42rem;
    background: var(--theme-surface-base);
    border-radius: 1rem;
    box-shadow: var(--theme-shadow-strong);
    overflow: hidden;
    transform: scale(0.95);
    transition: transform 0.2s ease;
  }

  :global(.global-search-overlay.is-visible .global-search-modal) {
    transform: scale(1);
  }

  .global-search-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--theme-border-subtle);
  }

  .global-search-icon {
    flex-shrink: 0;
    color: var(--theme-text-muted);
  }

  .global-search-input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: none;
    outline: none;
    font-size: 1rem;
    color: var(--theme-text-primary);
  }

  .global-search-input::placeholder {
    color: var(--theme-text-muted);
  }

  .global-search-kbd {
    flex-shrink: 0;
    padding: 0.25rem 0.5rem;
    background: var(--theme-surface-soft);
    border: 1px solid var(--border-subtle);
    border-radius: var(--wc-radius-sm, 0.75rem);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--theme-text-muted);
  }

  .global-search-body {
    max-height: 24rem;
    overflow-y: auto;
  }

  .global-search-empty,
  .global-search-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    color: var(--theme-text-muted);
  }

  .global-search-empty svg,
  :global(.global-search-loading svg) {
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .global-search-empty p,
  .global-search-loading p {
    font-size: 0.875rem;
  }

  .global-search-spinner {
    width: 2rem;
    height: 2rem;
    margin-bottom: 1rem;
    border: 3px solid var(--theme-border-subtle);
    border-top-color: var(--theme-color-amethyst);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .global-search-results {
    display: none;
  }

  :global(.global-search-result) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
color: var(--theme-text-primary);
    transition: background 0.15s ease;
    border-bottom: 1px solid var(--theme-border-subtle);
  }

  :global(.global-search-result:hover),
  :global(.global-search-result.is-selected) {
    background: var(--theme-surface-soft);
  }

  :global(.global-search-result-icon) {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: var(--theme-surface-soft);
    border-radius: var(--wc-radius-sm, 0.75rem);
    color: var(--theme-text-muted);
  }

  :global(.global-search-result.is-selected .global-search-result-icon) {
    background: var(--theme-color-amethyst);
    color: var(--theme-color-amethyst);
  }

  :global(.global-search-result-content) {
    flex: 1;
    min-width: 0;
  }

  :global(.global-search-result-title) {
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--neutral-8) / 1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.global-search-result-description) {
    margin-top: 0.125rem;
    font-size: 0.8rem;
    color: var(--theme-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.global-search-result-badge) {
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    background: var(--theme-surface-soft);
    border-radius: var(--wc-radius-sm, 0.75rem);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--theme-text-muted);
  }

  :global(.global-search-result.is-selected .global-search-result-badge) {
    background: var(--theme-color-amethyst);
    color: var(--theme-color-amethyst);
  }

  :global(.global-search-no-results) {
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--theme-text-muted);
    font-size: 0.875rem;
  }

  .global-search-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 1.25rem;
    background: var(--theme-surface-soft);
    border-top: 1px solid var(--theme-border-subtle);
  }

  .global-search-footer-group {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8rem;
    color: var(--theme-text-muted);
  }

  .global-search-footer-group kbd {
    padding: 0.125rem 0.375rem;
    background: var(--theme-surface-base);
    border: 1px solid var(--border-subtle);
    border-radius: var(--wc-radius-sm, 0.75rem);
    font-size: 0.6875rem;
    font-weight: 600;
    box-shadow: 0 1px 2px hsl(var(--neutral-9) / 0.05);
  }

  @media (max-width: 768px) {
    .global-search-overlay {
      padding-top: 2rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .global-search-modal {
      max-width: 100%;
    }

    .global-search-footer {
      display: none;
    }
  }
</style>
