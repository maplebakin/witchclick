// Featherweight client-side search (no deps). Fetches /search.json at runtime
const uid = `search-${globalThis.crypto?.randomUUID?.() ?? Math.random().toString(36).slice(2)}`;
const resultsId = `${uid}-results`;
---
<div class="relative w-full max-w-sm" data-search>
  <label class="sr-only" for={uid}>Search posts</label>
  <div class="group relative flex items-center overflow-hidden rounded-full border border-purple-200/70 bg-white/80 px-4 shadow-sm transition focus-within:border-purple-300 focus-within:shadow-md">
    <svg
      class="mr-2 h-4 w-4 flex-none text-purple-400 transition group-focus-within:text-purple-500"
      viewBox="0 0 20 20"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M13.5 12.5L17 16"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle
        cx="9"
        cy="9"
        r="5.25"
        stroke="currentColor"
        stroke-width="1.5"
      />
    </svg>
    <input
      id={uid}
      type="search"
      placeholder="Search guides and planners…"
      class="peer w-full bg-transparent py-2 text-sm text-purple-900 placeholder:text-purple-400 focus:outline-none"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={resultsId}
    />
    <kbd class="hidden rounded-full border border-purple-100 bg-purple-50 px-2 py-1 text-[0.65rem] font-medium text-purple-500 sm:block" aria-hidden="true">⌘K</kbd>
  </div>
  <div
    id={resultsId}
    class="absolute left-0 right-0 z-50 mt-3 hidden overflow-hidden rounded-3xl border border-purple-200/70 bg-white/95 p-2 shadow-2xl shadow-purple-200/60 backdrop-blur"
    role="listbox"
    aria-live="polite"
    data-results
  ></div>
</div>

<script>
(() => {
  const root = document.currentScript?.previousElementSibling?.closest('[data-search]');
  if (!root) return;

  const input = root.querySelector('input');
  const results = root.querySelector('[data-results]');
  if (!input || !results) return;

  let data = [];
  let loaded = false;
  let visibleItems = [];
  let activeIndex = -1;

  async function ensure(){
    if (loaded) return;
    try {
      const r = await fetch('/search.json', { cache: 'no-store' });
      if (!r.ok) {
        throw new Error(`Request failed with status ${r.status}`);
      }
      data = await r.json();
      loaded = true;
    } catch (error) {
      if (typeof console !== 'undefined') {
        console.warn('[search] Failed to load search index', error);
      }
    }
  }

  function escapeHtml(value){
    return String(value).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function hideResults(){
    visibleItems = [];
    activeIndex = -1;
    results.classList.add('hidden');
    results.innerHTML = '';
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
  }

  function updateActive(){
    const options = results.querySelectorAll('[data-index]');
    if (!options.length) {
      input.removeAttribute('aria-activedescendant');
      return;
    }

    options.forEach((option, index) => {
      const isActive = index === activeIndex;
      option.setAttribute('aria-selected', isActive ? 'true' : 'false');
      option.classList.toggle('search-option-active', isActive);
      if (isActive) {
        const id = option.getAttribute('id');
        if (id) {
          input.setAttribute('aria-activedescendant', id);
        }
        if ('scrollIntoView' in option) {
          option.scrollIntoView({ block: 'nearest' });
        }
      }
    });

    if (activeIndex === -1) {
      input.removeAttribute('aria-activedescendant');
    }
  }

  function render(items, query){
    visibleItems = items.slice(0,8);

    if (!visibleItems.length){
      activeIndex = -1;
      input.removeAttribute('aria-activedescendant');
      input.setAttribute('aria-expanded', 'true');
      results.classList.remove('hidden');
      results.innerHTML = `
        <div class="search-option-empty" role="status">
          No matches for “${escapeHtml(query)}” yet. Try another keyword.
        </div>
      `;
      return;
    }

    input.setAttribute('aria-expanded', 'true');
    results.classList.remove('hidden');
    results.innerHTML = visibleItems.map((item, index) => {
      const optionId = `${resultsId}-option-${index}`;
      return `
        <a
          id="${optionId}"
          data-index="${index}"
          class="search-option group"
          href="/post/${escapeHtml(item.slug)}"
          role="option"
          aria-selected="false"
        >
          <div class="text-sm font-semibold text-purple-900 group-hover:text-purple-900">${escapeHtml(item.title)}</div>
          ${item.excerpt ? `<div class=\"mt-1 text-xs text-purple-600/90 line-clamp-2\">${escapeHtml(item.excerpt)}</div>` : ''}
        </a>
      `;
    }).join('');

    activeIndex = 0;
    updateActive();
  }

  async function handleSearch(){
    const query = input.value.trim().toLowerCase();
    if (!query){
      hideResults();
      return;
    }

    input.setAttribute('aria-busy', 'true');
    await ensure();
    input.removeAttribute('aria-busy');

    const items = data.filter(item => {
      const hay = `${item.title} ${item.excerpt} ${(item.tags||[]).join(' ')}`.toLowerCase();
      return hay.includes(query);
    });

    render(items, query);
  }

  let timerId;

  input.addEventListener('input', () => {
    if (timerId) {
      window.clearTimeout(timerId);
    }
    timerId = window.setTimeout(handleSearch, 120);
  });

  input.addEventListener('focus', async () => {
    if (input.value.trim()) {
      await handleSearch();
    }
  });

  input.addEventListener('keydown', async (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      if (!visibleItems.length) {
        await handleSearch();
      }

      if (!visibleItems.length) return;

      event.preventDefault();
      if (event.key === 'ArrowDown') {
        activeIndex = (activeIndex + 1) % visibleItems.length;
      } else {
        activeIndex = (activeIndex - 1 + visibleItems.length) % visibleItems.length;
      }
      updateActive();
    }

    if (event.key === 'Enter' && visibleItems.length && activeIndex >= 0) {
      const option = results.querySelector(`[data-index="${activeIndex}"]`);
      if (option instanceof HTMLAnchorElement) {
        event.preventDefault();
        option.click();
      }
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    const withinResults = target instanceof Node && results.contains(target);
    if (!withinResults && target !== input) {
      hideResults();
    }
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      const active = event.target;
      const tagName = active && active instanceof HTMLElement ? active.tagName.toLowerCase() : '';
      if (tagName && ['input', 'textarea'].includes(tagName)) return;
      event.preventDefault();
      input.focus();
      input.select();
    }

    if (event.key === 'Escape') {
      hideResults();
      input.blur();
    }
  });

  results.addEventListener('mousemove', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const option = target.closest('[data-index]');
    if (!option) return;
    const index = Number(option.getAttribute('data-index'));
    if (Number.isNaN(index) || index === activeIndex) return;
    activeIndex = index;
    updateActive();
  });
})();
</script>
