// Featherweight client-side search (no deps). Fetches /search.json at runtime
const uid = `search-${globalThis.crypto?.randomUUID?.() ?? Math.random().toString(36).slice(2)}`;
const resultsId = `${uid}-results`;
---
<div class="relative w-full max-w-sm" data-search>
  <label class="sr-only" for={uid}>Search posts</label>
  <div class="group relative flex items-center overflow-hidden rounded-full border border-purple-200/70 bg-white/80 px-4 shadow-sm transition focus-within:border-purple-300 focus-within:shadow-md">
    <svg
      class="mr-2 h-4 w-4 flex-none text-purple-400 transition group-focus-within:text-purple-500"
      viewBox="0 0 20 20"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M13.5 12.5L17 16"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle
        cx="9"
        cy="9"
        r="5.25"
        stroke="currentColor"
        stroke-width="1.5"
      />
    </svg>
    <input
      id={uid}
      type="search"
      placeholder="Search guides and planners…"
      class="peer w-full bg-transparent py-2 text-sm text-purple-900 placeholder:text-purple-400 focus:outline-none"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={resultsId}
    />
    <kbd class="hidden rounded-full border border-purple-100 bg-purple-50 px-2 py-1 text-[0.65rem] font-medium text-purple-500 sm:block" aria-hidden="true">⌘K</kbd>
  </div>
  <div
    id={resultsId}
    class="absolute left-0 right-0 z-50 mt-3 hidden overflow-hidden rounded-3xl border border-purple-200/70 bg-white/95 p-2 shadow-2xl shadow-purple-200/60 backdrop-blur"
    role="listbox"
    data-results
  ></div>
</div>

<script>
(() => {
  const root = document.currentScript?.previousElementSibling?.closest('[data-search]');
  if (!root) return;

  const input = root.querySelector('input');
  const results = root.querySelector('[data-results]');
  if (!input || !results) return;

  /**
   * @typedef {Object} SearchEntry
   * @property {string} title
   * @property {string=} excerpt
   * @property {string} slug
   * @property {string[]=} tags
   */

  /** @type {SearchEntry[]} */
  let data = [];
  let loaded = false;

  const MAX_VISIBLE_RESULTS = 8;

  /** @type {SearchEntry[]} */
  let visibleItems = [];
  let activeIndex = -1;

  /**
   * @param {string} slug
   */
  function resolveHref(slug){
    if (typeof slug !== 'string') return '/';
    const normalized = slug.trim();
    if (!normalized) return '/';
    return normalized.startsWith('/') ? normalized : `/post/${normalized.replace(/^\/+/, '')}`;
  }

  function hideResults(){
    visibleItems = [];
    activeIndex = -1;
    results.classList.add('hidden');
    results.innerHTML = '';
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
  }

  function syncActiveOption(){
    const options = results.querySelectorAll('[data-result-option]');
    if (!options.length || activeIndex < 0){
      input.removeAttribute('aria-activedescendant');
    }

    options.forEach((option, index) => {
      const isActive = index === activeIndex && activeIndex >= 0;
      option.setAttribute('data-active', String(isActive));
      option.setAttribute('aria-selected', String(isActive));
      if (isActive){
        const optionId = option.getAttribute('id');
        if (optionId){
          input.setAttribute('aria-activedescendant', optionId);
        }
        option.scrollIntoView({ block: 'nearest' });
      }
    });
  }

  async function ensure(){
    if (loaded) return;
    try {
      const r = await fetch('/search.json', { cache: 'no-store' });
      const json = await r.json();
      data = Array.isArray(json) ? json : [];
      loaded = true;
    } catch (error) {
      if (typeof console !== 'undefined') {
        console.warn('[search] Failed to load search index', error);
      }
    }
  }

  function escapeHtml(value){
    return String(value).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  /**
   * @param {SearchEntry[]} items
   */
  function render(items){
    visibleItems = items.slice(0, MAX_VISIBLE_RESULTS);

    if (!visibleItems.length){
      hideResults();
      return;
    }

    activeIndex = 0;

    input.setAttribute('aria-expanded', 'true');
    results.classList.remove('hidden');
    results.innerHTML = visibleItems
      .map((item, index) => `
      <a
        class="group block rounded-2xl px-4 py-3 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-300 hover:bg-purple-50/80 data-[active=true]:bg-purple-50/80 data-[active=true]:ring-1 data-[active=true]:ring-purple-200/80"
        href="${escapeHtml(resolveHref(item.slug))}"
        role="option"
        data-result-option
        data-index="${index}"
        data-active="${index === activeIndex}"
        aria-selected="${index === activeIndex}"
        tabindex="-1"
        id="${resultsId}-option-${index}"
      >
        <div class="text-sm font-semibold text-purple-900 group-hover:text-purple-900">${escapeHtml(item.title)}</div>
        ${item.excerpt ? `<div class=\"mt-1 text-xs text-purple-600/90 line-clamp-2\">${escapeHtml(item.excerpt)}</div>` : ''}
      </a>
    `)
      .join('');

    syncActiveOption();
  }

  async function handleSearch(){
    const query = input.value.trim().toLowerCase();
    if (!query){
      render([]);
      return;
    }

    input.setAttribute('aria-busy', 'true');
    await ensure();
    input.removeAttribute('aria-busy');

    const items = data.filter(item => {
      const hay = `${item.title} ${item.excerpt} ${(item.tags||[]).join(' ')}`.toLowerCase();
      return hay.includes(query);
    });

    render(items);
  }

  /** @type {ReturnType<typeof setTimeout> | undefined} */
  let timerId;

  input.addEventListener('input', () => {
    if (timerId) {
      window.clearTimeout(timerId);
    }
    timerId = window.setTimeout(handleSearch, 120);
  });

  input.addEventListener('focus', async () => {
    if (input.value.trim()) {
      await handleSearch();
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    const withinResults = target instanceof Node && results.contains(target);
    if (!withinResults && target !== input) {
      hideResults();
    }
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      const active = event.target;
      const tagName = active && active instanceof HTMLElement ? active.tagName.toLowerCase() : '';
      if (tagName && ['input', 'textarea'].includes(tagName)) return;
      event.preventDefault();
      input.focus();
      input.select();
    }

    if (event.key === 'Escape') {
      hideResults();
      input.blur();
    }
  });

  input.addEventListener('keydown', (event) => {
    if (!visibleItems.length) return;

    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const delta = event.key === 'ArrowDown' ? 1 : -1;
      activeIndex = (activeIndex + delta + visibleItems.length) % visibleItems.length;
      syncActiveOption();
      return;
    }

    if (event.key === 'Enter' && activeIndex >= 0) {
      event.preventDefault();
      const target = resolveHref(visibleItems[activeIndex].slug);
      window.location.href = target;
    }
  });

  results.addEventListener('mouseover', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-result-option]') : null;
    if (!target) return;
    const indexAttr = target.getAttribute('data-index');
    const index = Number(indexAttr);
    if (Number.isInteger(index) && index !== activeIndex) {
      activeIndex = index;
      syncActiveOption();
    }
  });

  results.addEventListener('focusin', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-result-option]') : null;
    if (!target) return;
    const indexAttr = target.getAttribute('data-index');
    const index = Number(indexAttr);
    if (Number.isInteger(index) && index !== activeIndex) {
      activeIndex = index;
      syncActiveOption();
    }
  });
})();
</script>
