---
// Featherweight client-side search (no deps). Fetches /search.json at runtime
import SearchTagSuggestions from "./SearchTagSuggestions.astro";

interface Props {
  showTagSuggestions?: boolean;
}

const { showTagSuggestions = true } = Astro.props as Props;
const uid = `search-${globalThis.crypto?.randomUUID?.() ?? Math.random().toString(36).slice(2)}`;
const resultsId = `${uid}-results`;
---
<div class="search-control" data-search>
  <label class="sr-only" for={uid}>Search posts</label>
  <input
    id={uid}
    type="search"
    placeholder="Search posts…"
    class="search-input"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls={resultsId}
  />
  <div
    id={resultsId}
    class="search-results hidden"
    role="listbox"
    data-results
  ></div>
  {showTagSuggestions && <SearchTagSuggestions inputId={uid} />}
</div>

<script type="module" is:inline>
(() => {
  const root = document.currentScript?.previousElementSibling?.closest('[data-search]');
  if (!(root instanceof HTMLElement)) return;

  const input = root.querySelector('input[type="search"]');
  const results = root.querySelector('[data-results]');
  const tags = root.querySelector('[data-search-tags]');
  if (!input || !results) return;

  /** @type {HTMLInputElement} */
  const searchInput = input;
  /** @type {HTMLDivElement} */
  const resultsList = results;
  /** @type {HTMLElement | null} */
  const tagList = tags instanceof HTMLElement ? tags : null;

  /** @type {Array<{ slug: string; title: string; excerpt?: string; tags?: string[] }>} */
  let data = [];
  let loaded = false;

  const ensure = async () => {
    if (loaded) return;
    try {
      const response = await fetch('/search.json', { cache: 'no-store' });
      const payload = await response.json();
      data = Array.isArray(payload) ? payload : [];
      loaded = true;
    } catch (error) {
      if (typeof console !== 'undefined') {
        console.warn('[search] Failed to load search index', error);
      }
    }
  };

  /**
   * @param {unknown} value
   * @returns {string}
   */
  const escapeHtml = (value) =>
    String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  /**
   * @param {Array<{ slug: string; title: string; excerpt?: string; tags?: string[] }>} items
   */
  const render = (items) => {
    if (items.length === 0) {
      resultsList.classList.add('hidden');
      resultsList.innerHTML = '';
      searchInput.setAttribute('aria-expanded', 'false');
      return;
    }

    searchInput.setAttribute('aria-expanded', 'true');
    resultsList.classList.remove('hidden');
    resultsList.innerHTML = items
      .slice(0, 8)
      .map((item) => {
        const excerpt = typeof item.excerpt === 'string' ? item.excerpt : '';
        return `
      <a class="search-result" href="/post/${escapeHtml(item.slug)}" role="option">
        <div class="search-result__title">${escapeHtml(item.title)}</div>
        ${excerpt ? `<div class=\"search-result__excerpt\">${escapeHtml(excerpt)}</div>` : ''}
      </a>`;
      })
      .join('');
  };

  const handleSearch = async () => {
    const query = searchInput.value.trim().toLowerCase();
    const normalizedQuery = query.startsWith('#') ? query.slice(1) : query;
    if (!normalizedQuery) {
      render([]);
      return;
    }

    searchInput.setAttribute('aria-busy', 'true');
    await ensure();
    searchInput.removeAttribute('aria-busy');

    const items = data.filter((item) => {
      const tags = Array.isArray(item.tags) ? item.tags : [];
      const haystack = `${item.title} ${item.excerpt ?? ''} ${tags.join(' ')}`.toLowerCase();
      return haystack.includes(normalizedQuery);
    });

    render(items);
  };

  /** @type {number | undefined} */
  let timerId;

  searchInput.addEventListener('input', () => {
    if (timerId !== undefined) {
      window.clearTimeout(timerId);
    }
    timerId = window.setTimeout(handleSearch, 120);
  });

  searchInput.addEventListener('focus', async () => {
    if (searchInput.value.trim()) {
      await handleSearch();
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) {
      return;
    }

    if (!resultsList.contains(target) && target !== searchInput) {
      resultsList.classList.add('hidden');
      searchInput.setAttribute('aria-expanded', 'false');
    }
  });

  if (tagList) {
    tagList.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const value = target.getAttribute('data-tag-value');
      if (!value) return;
      event.preventDefault();
      const formatted = value.startsWith('#') ? value : `#${value}`;
      searchInput.value = formatted;
      await handleSearch();
      searchInput.focus();
    });
  }
})();
</script>
