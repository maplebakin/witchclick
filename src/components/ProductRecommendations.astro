---
import { buildAffiliateTarget } from "@/utils/products";

interface ProductInput {
  key?: string;
  name?: string;
  brand?: string;
  url?: string;
  utm?: string;
  rel?: string;
  tags?: string[];
  image?: string;
}

interface Props {
  products?: ProductInput[];
  title?: string;
  class?: string;
}

const { products = [], title = "Affiliate recommendations", class: className = "" } = Astro.props as Props;

const filtered = Array.isArray(products)
  ? products
      .map((product) => ({ ...product }))
      .filter((product) => Boolean(buildAffiliateTarget(product)))
  : [];

const display = filtered.slice(0, 3);

const containerClass = ["product-recs", "soft-card", className].filter(Boolean).join(" ");

function buildHref(product: ProductInput): string {
  if (product?.key && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(product.key)) {
    return `/go/${product.key}`;
  }
  return buildAffiliateTarget(product);
}

function resolveImageSources(product: ProductInput) {
  const placeholder = buildPlaceholderSvg(product?.name);
  if (typeof product?.image === "string" && product.image.trim().length > 0) {
    return { src: product.image, fallback: placeholder, isPlaceholder: false };
  }
  return { src: placeholder, fallback: placeholder, isPlaceholder: true };
}

function buildPlaceholderSvg(label?: string): string {
  const raw = typeof label === "string" && label.trim().length > 0 ? label.trim() : "Affiliate pick";
  const safe = raw.length > 36 ? `${raw.slice(0, 33)}...` : raw;
  const svg = `
    <svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400" role="img" aria-label="${escapeSvgText(raw)}">
      <rect width="600" height="400" rx="28" fill="currentColor" fill-opacity="0.08" />
      <rect x="24" y="24" width="552" height="352" rx="22" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" />
      <text x="50%" y="52%" text-anchor="middle" dominant-baseline="middle" font-family="Georgia, 'Times New Roman', serif" font-size="24" fill="currentColor" fill-opacity="0.88">
        ${escapeSvgText(safe)}
      </text>
      <text x="50%" y="68%" text-anchor="middle" dominant-baseline="middle" font-family="system-ui, sans-serif" font-size="12" letter-spacing="2" fill="currentColor" fill-opacity="0.58">
        WITCHCLICK PICK
      </text>
    </svg>
  `;
  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
}

function escapeSvgText(value: string): string {
  return value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
---
{display.length > 0 && (
  <section class={containerClass} aria-labelledby="product-recs-title">
    <div class="product-recs-header">
      <h2 id="product-recs-title">{title}</h2>
      <p class="product-recs-subtitle">Products related to this post. We may earn commission on purchases.</p>
    </div>
    <ul class="product-recs-list">
      {display.map((product) => {
        const href = buildHref(product);
        const rel = Array.from(
          new Set(`${product?.rel ?? ""} sponsored nofollow noopener noreferrer`.trim().split(/\s+/)),
        ).join(" ");
        const imageSources = resolveImageSources(product);
        return (
          <li class="product-card">
            <a
              href={href}
              rel={rel}
              target="_blank"
              class="product-card-link"
              data-affiliate="true"
            >
              <img
                src={imageSources.src}
                data-fallback={imageSources.fallback}
                data-placeholder={imageSources.isPlaceholder ? "true" : "false"}
                alt={product?.name ?? "Affiliate product"}
                loading="lazy"
                decoding="async"
                class="product-card-image"
              />
            </a>
            <div class="product-card-body">
              <h3 class="product-card-title">{product?.name ?? "Affiliate product"}</h3>
              <a
                href={href}
                rel={rel}
                target="_blank"
                class="product-card-button"
                data-affiliate="true"
              >
                Browse options
              </a>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .product-recs {
    border-radius: 1.5rem;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--surface-panel) 72%, transparent 28%);
    border: 1px solid color-mix(in srgb, var(--border-subtle) 82%, transparent 18%);
    gap: 1.25rem;
    color: var(--text-body, currentColor);
  }

  .product-recs-header {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .product-recs h2 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-accent) 88%, var(--text-strong) 12%);
  }

  .product-recs-subtitle {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .product-recs-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }

  .product-card {
    display: grid;
    gap: 0.85rem;
  }

  .product-card-link {
    display: block;
    border-radius: var(--wc-radius-md, 0.9rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border-subtle) 92%, transparent 8%);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--surface-card) 88%, transparent 12%),
        color-mix(in srgb, var(--text-accent) 12%, var(--surface-card) 88%)
      );
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .product-card-link:focus-visible,
  .product-card-link:hover {
    border-color: color-mix(in srgb, var(--border-strong) 82%, transparent 18%);
    opacity: 0.9;
  }

  .product-card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .product-card-image.is-loaded,
  .product-card-image.is-fallback {
    opacity: 1;
  }

  .product-card-body {
    display: grid;
    gap: 0.6rem;
    padding: 0.5rem 0;
    color: var(--text-body, currentColor);
  }

  .product-card-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--text-strong) 92%, var(--text-accent) 8%);
  }

  .product-card-button {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--border-strong) 75%, transparent 25%);
    color: color-mix(in srgb, var(--text-accent) 86%, var(--text-strong) 14%);
    font-weight: 600;
    font-size: 0.8rem;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .product-card-button:hover,
  .product-card-button:focus-visible {
    border-color: color-mix(in srgb, var(--border-strong) 92%, transparent 8%);
    color: var(--text-accent);
    outline: none;
  }

  .product-card-button:focus-visible {
    box-shadow: var(--ring-focus);
  }

  @media (min-width: 640px) {
    .product-recs-list {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }
</style>

<script>
  function initProductRecsFallbacks() {
    const images = document.querySelectorAll('.product-card-image[data-fallback]');
    images.forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;
      const fallback = img.dataset.fallback;
      const markLoaded = () => {
        img.classList.add('is-loaded');
      };

      if (img.complete) {
        markLoaded();
      } else {
        img.addEventListener('load', markLoaded, { once: true });
      }

      img.addEventListener(
        'error',
        () => {
          if (fallback && img.src !== fallback) {
            img.src = fallback;
          }
          img.classList.add('is-fallback');
        },
        { once: true },
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductRecsFallbacks, { once: true });
  } else {
    initProductRecsFallbacks();
  }
</script>
