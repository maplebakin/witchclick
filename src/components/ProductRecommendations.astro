---
interface ProductInput {
  key?: string;
  name?: string;
  brand?: string;
  url?: string;
  utm?: string;
  rel?: string;
  tags?: string[];
  image?: string;
}

interface Props {
  products?: ProductInput[];
  title?: string;
  class?: string;
}

const { products = [], title = "Affiliate recommendations", class: className = "" } = Astro.props as Props;

const filtered = Array.isArray(products)
  ? products
      .map((product) => ({ ...product }))
      .filter((product) => typeof product?.url === "string" && product.url.trim().length > 0)
  : [];

const display = filtered.slice(0, 3);

const containerClass = ["product-recs", "soft-card", className].filter(Boolean).join(" ");

function buildHref(product: ProductInput): string {
  if (product?.key) {
    return `/go/${product.key}`;
  }
  const base = typeof product?.url === "string" ? product.url : "";
  if (!base) return "#";
  if (product?.utm && !base.includes("?")) {
    return `${base}?${product.utm}`;
  }
  return base;
}

function resolveImage(product: ProductInput): string {
  if (typeof product?.image === "string" && product.image.trim().length > 0) {
    return product.image;
  }
  const placeholderLabel = encodeURIComponent(product?.name ?? "Affiliate pick");
  return `https://placehold.co/600x400?text=${placeholderLabel}`;
}
---
{display.length > 0 && (
  <section class={containerClass} aria-labelledby="product-recs-title">
    <div class="product-recs-header">
      <h2 id="product-recs-title">{title}</h2>
      <p class="product-recs-subtitle">Products related to this post. We may earn commission on purchases.</p>
    </div>
    <ul class="product-recs-list">
      {display.map((product) => {
        const href = buildHref(product);
        const rel = product?.rel ?? "sponsored nofollow";
        const image = resolveImage(product);
        return (
          <li class="product-card">
            <a
              href={href}
              rel={rel}
              target="_blank"
              class="product-card-link"
              data-affiliate="true"
            >
              <img src={image} alt={product?.name ?? "Affiliate product"} loading="lazy" class="product-card-image" />
            </a>
            <div class="product-card-body">
              <h3 class="product-card-title">{product?.name ?? "Affiliate product"}</h3>
              <a
                href={href}
                rel={rel}
                target="_blank"
                class="product-card-button"
                data-affiliate="true"
              >
                Buy Now
              </a>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .product-recs {
    border-radius: 1.5rem;
    padding: 1.5rem;
    background: transparent;
    border: 1px solid rgba(124, 58, 237, 0.2);
    gap: 1.25rem;
    color: var(--ink-body, currentColor);
  }

  .product-recs-header {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .product-recs h2 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(212, 175, 55, 0.85);
  }

  .product-recs-subtitle {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(244, 241, 255, 0.7);
  }

  .product-recs-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }

  .product-card {
    display: grid;
    gap: 0.85rem;
  }

  .product-card-link {
    display: block;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(124, 58, 237, 0.25);
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .product-card-link:focus-visible,
  .product-card-link:hover {
    border-color: rgba(124, 58, 237, 0.45);
    opacity: 0.9;
  }

  .product-card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .product-card-body {
    display: grid;
    gap: 0.6rem;
    padding: 0.5rem 0;
    color: var(--ink-body, currentColor);
  }

  .product-card-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(244, 241, 255, 0.88);
  }

  .product-card-button {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: transparent;
    border: 1px solid rgba(124, 58, 237, 0.35);
    color: rgba(212, 175, 55, 0.85);
    font-weight: 600;
    font-size: 0.8rem;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .product-card-button:hover,
  .product-card-button:focus-visible {
    border-color: rgba(124, 58, 237, 0.55);
    color: rgba(212, 175, 55, 1);
    outline: none;
  }

  .product-card-button:focus-visible {
    box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.4);
  }

  @media (min-width: 640px) {
    .product-recs-list {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }
</style>
