---
import SearchBox from "./SearchBox.astro";
import ComfortSettings from "./ComfortSettings.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface NavLink {
  href: string;
  label: string;
  rel?: string;
  variant?: 'pill' | 'default';
}

interface AdminNavSection {
  label: string;
  items: NavLink[];
}

interface Props {
  brandName: string;
  navLinks: NavLink[];
  secondaryLinks?: NavLink[];
  utilityLinks?: NavLink[];
  adminSections?: AdminNavSection[];
  currentPath?: string;
}

const {
  brandName,
  navLinks = [],
  secondaryLinks = [],
  utilityLinks = [],
  adminSections = [],
  currentPath = "/",
} = Astro.props as Props;

const normalizedPath = currentPath.endsWith("/") && currentPath.length > 1
  ? currentPath
  : `${currentPath.replace(/\/$/, "")}/`;

const visibleAdminSections = adminSections.filter((section) =>
  section && Array.isArray(section.items) && section.items.length > 0
);
const hasAdminLinks = visibleAdminSections.length > 0;
const visibleSecondary = secondaryLinks.filter((link) => link && typeof link.href === "string");
const visibleUtility = utilityLinks.filter((link) => link && typeof link.href === "string");

function isActive(href: string): boolean {
  if (!href) return false;
  const normalized = href.endsWith("/") ? href : `${href}/`;
  if (normalized === "/") {
    return normalizedPath === normalized;
  }
  return normalizedPath.startsWith(normalized);
}
---
<header class="site-header" data-site-header>
  <div class="wc-container site-header__inner">
    <a class="site-logo" href="/">{brandName}</a>
    <nav class="site-nav" aria-label="Primary navigation">
      <button
        class="site-nav__toggle focus-ring"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span class="sr-only">Open menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M4 6h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Zm0 7h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Zm0 7h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Z"
          />
        </svg>
      </button>
      <ul class="site-nav__list">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              rel={item.rel}
              class:list={[
                "site-nav__link",
                item.variant === "pill" && "site-nav__link--pill",
              ].filter(Boolean)}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        {visibleSecondary.length > 0 && (
          <li class="site-nav__item site-nav__item--submenu">
            <button
              type="button"
              class="site-nav__button site-nav__button--more focus-ring"
              data-submenu-toggle
              aria-expanded="false"
              aria-controls="site-nav-secondary"
            >
              More
              <svg class="site-nav__button-caret" viewBox="0 0 12 8" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M10.59.59a2 2 0 0 1 0 2.82l-3.3 3.29a2 2 0 0 1-2.82 0L1.17 3.41A2 2 0 0 1 4 1.59l2 2 2-2a2 2 0 0 1 2.59 0Z"
                />
              </svg>
            </button>
            <div
              id="site-nav-secondary"
              class="site-nav__submenu"
              data-submenu
              aria-hidden="true"
            >
              <ul class="site-nav__submenu-list">
                {visibleSecondary.map((item) => (
                  <li>
                    <a class="site-nav__submenu-link" href={item.href} rel={item.rel}>
                      <span class="site-nav__submenu-label">{item.label}</span>
                      <span class="site-nav__submenu-meta">Dive deeper into {item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        )}
      </ul>
      <div class="site-nav__actions">
        <ThemeToggle class="site-nav__theme" />
        {visibleUtility.length > 0 && (
          <div class="site-nav__utility">
            {visibleUtility.map((item) => (
              <a class="site-nav__button site-nav__button--utility focus-ring" href={item.href} rel={item.rel}>
                {item.label}
              </a>
            ))}
          </div>
        )}
        <ComfortSettings />
        {hasAdminLinks && (
          <details class="site-nav__admin" data-admin-menu>
            <summary class="site-nav__button site-nav__button--admin focus-ring">
              Admin
              <svg class="site-nav__admin-caret" viewBox="0 0 12 8" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M10.59.59a2 2 0 0 1 0 2.82l-3.3 3.29a2 2 0 0 1-2.82 0L1.17 3.41A2 2 0 0 1 4 1.59l2 2 2-2a2 2 0 0 1 2.59 0Z"
                />
              </svg>
            </summary>
            <div class="site-nav__admin-dropdown" aria-label="Admin panel links">
              <div class="site-nav__admin-grid">
                {visibleAdminSections.map((section) => (
                  <div class="site-nav__admin-section">
                    <h3 class="site-nav__admin-section-label">{section.label}</h3>
                    <ul class="site-nav__admin-list">
                      {section.items.map((item) => (
                        <li>
                          <a class="site-nav__admin-link" href={item.href} rel={item.rel}>
                            {item.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </details>
        )}
        <button
          type="button"
          class="site-nav__button focus-ring"
          data-search-toggle
          aria-expanded="false"
          aria-controls="site-search-panel"
        >
          Search
        </button>
        <a class="site-nav__button site-nav__link--secondary focus-ring" href="/feed.json" rel="alternate">
          RSS
        </a>
      </div>
    </nav>
  </div>
  <div
    id="mobile-navigation"
    class="site-nav__mobile"
    data-mobile-drawer
    aria-hidden="true"
  >
    <div class="site-nav__mobile-header">
      <span class="site-logo">{brandName}</span>
      <button type="button" class="site-nav__toggle focus-ring" data-mobile-close aria-label="Close menu">
        ✕
      </button>
    </div>
    <div class="site-nav__mobile-theme">
      <ThemeToggle />
    </div>
    <div class="site-nav__mobile-search">
      <SearchBox />
    </div>
    <ul class="site-nav__mobile-list">
      {navLinks.map((item) => (
        <li>
          <a
            href={item.href}
            rel={item.rel}
            class="site-nav__mobile-link focus-ring"
            aria-current={isActive(item.href) ? "page" : undefined}
            data-mobile-link
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    {visibleSecondary.length > 0 && (
      <div class="site-nav__mobile-section">
        <p class="site-footer__title">More from WitchClick</p>
        <ul class="site-nav__mobile-subnav">
          {visibleSecondary.map((item) => (
            <li>
              <a
                class="site-nav__mobile-link site-nav__mobile-link--plain focus-ring"
                href={item.href}
                rel={item.rel}
                data-mobile-link
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    {hasAdminLinks && (
      <div class="site-nav__mobile-admin">
        <p class="site-footer__title">Admin Panel</p>
        {visibleAdminSections.map((section) => (
          <div class="site-nav__mobile-admin-section">
            <h4 class="site-nav__mobile-admin-label">{section.label}</h4>
            <ul class="site-nav__nav--stacked">
              {section.items.map((item) => (
                <li>
                  <a class="site-nav__mobile-link focus-ring" href={item.href} rel={item.rel} data-mobile-link>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
    {visibleUtility.length > 0 && (
      <div class="site-nav__mobile-section">
        <p class="site-footer__title">Quick links</p>
        <ul class="site-nav__mobile-subnav">
          {visibleUtility.map((item) => (
            <li>
              <a
                class="site-nav__mobile-link site-nav__mobile-link--plain focus-ring"
                href={item.href}
                rel={item.rel}
                data-mobile-link
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="site-nav__mobile-comfort">
      <ComfortSettings variant="stacked" />
    </div>
  </div>
  <div
    id="site-search-panel"
    class="site-search-panel"
    data-search-panel
    aria-hidden="true"
  >
    <div class="site-search-panel__backdrop" data-search-close aria-hidden="true"></div>
    <div class="site-search-panel__dialog" role="dialog" aria-modal="true">
      <div class="site-search-panel__header">
        <h2>Search WitchClick</h2>
        <button type="button" class="site-nav__toggle focus-ring" data-search-close aria-label="Close search">
          ✕
        </button>
      </div>
      <SearchBox />
    </div>
  </div>
</header>

<script is:inline>
  const body = document.body;
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileDrawer = document.querySelector('[data-mobile-drawer]');
  const searchToggle = document.querySelector('[data-search-toggle]');
  const searchPanel = document.querySelector('[data-search-panel]');

  const mobileCloseButtons = document.querySelectorAll('[data-mobile-close]');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');
  const searchCloseButtons = document.querySelectorAll('[data-search-close]');
  const submenuToggle = document.querySelector('[data-submenu-toggle]');
  const submenuPanel = document.querySelector('[data-submenu]');
  const submenuLinks = submenuPanel ? Array.from(submenuPanel.querySelectorAll('a')) : [];

  function setMenuOpen(open) {
    if (mobileDrawer) {
      mobileDrawer.classList.toggle('is-open', open);
      mobileDrawer.setAttribute('aria-hidden', String(!open));
    }
    if (menuToggle) {
      menuToggle.setAttribute('aria-expanded', String(open));
    }
    if (body) {
      body.setAttribute('data-menu-open', open ? 'true' : 'false');
    }
    if (open) {
      setSearchOpen(false);
      setSubmenuOpen(false);
    }
  }

  function setSearchOpen(open) {
    if (searchPanel) {
      searchPanel.classList.toggle('is-open', open);
      searchPanel.setAttribute('aria-hidden', String(!open));
    }
    if (searchToggle) {
      searchToggle.setAttribute('aria-expanded', String(open));
    }
    if (body) {
      body.setAttribute('data-search-open', open ? 'true' : 'false');
    }
    if (open) {
      setMenuOpen(false);
      const input = searchPanel?.querySelector('input');
      if (input) {
        window.setTimeout(() => input.focus(), 120);
      }
      setSubmenuOpen(false);
    }
  }

  function setSubmenuOpen(open) {
    if (submenuPanel) {
      submenuPanel.classList.toggle('is-open', open);
      submenuPanel.setAttribute('aria-hidden', String(!open));
    }
    if (submenuToggle) {
      submenuToggle.setAttribute('aria-expanded', String(open));
    }
    if (open) {
      setMenuOpen(false);
      setSearchOpen(false);
    }
  }

  menuToggle?.addEventListener('click', () => {
    const next = menuToggle.getAttribute('aria-expanded') !== 'true';
    setMenuOpen(next);
  });

  searchToggle?.addEventListener('click', () => {
    const next = searchToggle.getAttribute('aria-expanded') !== 'true';
    setSearchOpen(next);
  });

  mobileCloseButtons.forEach((button) => {
    button.addEventListener('click', () => setMenuOpen(false));
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  searchCloseButtons.forEach((button) => {
    button.addEventListener('click', () => setSearchOpen(false));
  });

  submenuToggle?.addEventListener('click', (event) => {
    event.preventDefault();
    const next = submenuToggle.getAttribute('aria-expanded') !== 'true';
    setSubmenuOpen(next);
  });

  submenuLinks.forEach((link) => {
    link.addEventListener('click', () => setSubmenuOpen(false));
  });

  const closeSubmenuOnOutsideClick = (event) => {
    if (!submenuPanel || !submenuToggle) return;
    if (!submenuPanel.classList.contains('is-open')) return;
    if (submenuToggle.contains(event.target)) return;
    if (submenuPanel.contains(event.target)) return;
    setSubmenuOpen(false);
  };

  document.addEventListener('click', closeSubmenuOnOutsideClick);

  const closeSubmenuOnBlur = () => {
    window.setTimeout(() => {
      if (!submenuPanel || !submenuToggle) return;
      const active = document.activeElement;
      if (active && (submenuPanel.contains(active) || submenuToggle.contains(active))) {
        return;
      }
      setSubmenuOpen(false);
    }, 0);
  };

  submenuPanel?.addEventListener('focusout', closeSubmenuOnBlur);
  submenuToggle?.addEventListener('blur', closeSubmenuOnBlur);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
      setSearchOpen(false);
      setSubmenuOpen(false);
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth < 921) {
      setSubmenuOpen(false);
    }
  });
    gap: var(--space-2, 0.5rem);
  }

  .site-nav__button--utility {
    background: color-mix(in srgb, var(--header-background) 65%, transparent 35%);
  }

  .site-nav__button--utility:hover,
  .site-nav__button--utility:focus-visible {
    background: color-mix(in srgb, var(--header-background) 50%, var(--color-iris) 50%);
  }

  .site-nav__button--admin {
    background: color-mix(in srgb, var(--header-background) 58%, var(--color-gold) 42%);
    border-color: color-mix(in srgb, var(--header-border) 45%, var(--color-gold) 55%);
  }

  .site-nav__button--admin:hover,
  .site-nav__button--admin:focus-visible {
    background: color-mix(in srgb, var(--header-background) 45%, var(--color-gold) 55%);
    border-color: color-mix(in srgb, var(--header-border) 35%, var(--color-gold) 65%);
  }

  .site-nav__item--submenu {
    position: relative;
  }

  .site-nav__link--pill {
    padding-inline: 1.1rem;
    padding-block: 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--header-border) 45%, var(--color-gold) 55%);
    background: color-mix(in srgb, var(--header-background) 55%, var(--color-gold) 45%);
    font-weight: 600;
  }

  .site-nav__link--pill:hover,
  .site-nav__link--pill:focus-visible {
    background: color-mix(in srgb, var(--header-background) 40%, var(--color-gold) 60%);
    color: var(--comfort-chip-text-strong, var(--text-accent-strong));
  }

  .site-nav__button--more {
    gap: var(--space-2, 0.5rem);
  }

  .site-nav__button-caret {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 160ms ease;
  }

  .site-nav__button[aria-expanded="true"] .site-nav__button-caret {
    transform: rotate(180deg);
  }

  .site-nav__admin {
    position: relative;
  }

  .site-nav__admin > summary {
    list-style: none;
    cursor: pointer;
  }

  .site-nav__admin > summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__admin-caret {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 160ms ease;
  }

  .site-nav__admin[open] .site-nav__admin-caret {
    transform: rotate(180deg);
  }

  .site-nav__admin-dropdown {
    position: absolute;
    right: 0;
    margin-top: var(--space-2, 0.5rem);
    padding: var(--space-5, 1.25rem);
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--header-border) 60%, transparent 40%);
    background: color-mix(in srgb, var(--header-background) 94%, transparent 6%);
    backdrop-filter: blur(12px);
    box-shadow: 0 28px 75px -32px color-mix(in srgb, var(--color-night) 68%, transparent 32%);
    min-width: 36rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.35rem);
    transition: opacity 160ms ease, transform 160ms ease;
    z-index: 40;
  }

  .site-nav__admin[open] .site-nav__admin-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-nav__admin-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5, 1.25rem);
  }

  .site-nav__admin-section {
    display: grid;
    gap: var(--space-2, 0.5rem);
  }

  .site-nav__admin-section-label {
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-gold) 72%, white 28%);
    margin: 0;
    padding-bottom: var(--space-1, 0.25rem);
    border-bottom: 1px solid color-mix(in srgb, var(--header-border) 45%, var(--color-gold) 55%);
  }

  .site-nav__admin-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.125rem;
  }

  .site-nav__admin-link {
    display: block;
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border-radius: 0.5rem;
    border: 1px solid transparent;
    background: color-mix(in srgb, var(--header-background) 70%, transparent 30%);
    color: color-mix(in srgb, var(--layout-shell-ink) 90%, white 10%);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .site-nav__admin-link:hover,
  .site-nav__admin-link:focus-visible {
    border-color: color-mix(in srgb, var(--header-border) 45%, var(--color-iris) 55%);
    background: color-mix(in srgb, var(--header-background) 52%, var(--color-iris) 48%);
    color: var(--comfort-chip-text-strong, var(--text-accent-strong));
    transform: translateX(0.125rem);
  }

  .site-nav__mobile-admin {
    margin-top: var(--space-6, 1.5rem);
    padding-top: var(--space-4, 1rem);
    border-top: 1px solid color-mix(in srgb, var(--header-border) 55%, transparent 45%);
    display: grid;
    gap: var(--space-4, 1rem);
  }

  .site-nav__mobile-theme {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem) 0;
  }

  .site-nav__mobile-admin-section {
    display: grid;
    gap: var(--space-2, 0.5rem);
  }

  .site-nav__mobile-admin-label {
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-gold) 65%, white 35%);
    margin: 0;
    padding-left: var(--space-2, 0.5rem);
  }

  .site-nav__nav--stacked {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2, 0.5rem);
  }

  .site-nav__mobile-section {
    margin-top: var(--space-6, 1.5rem);
    padding-top: var(--space-4, 1rem);
    border-top: 1px solid color-mix(in srgb, var(--header-border) 55%, transparent 45%);
    display: grid;
    gap: var(--space-3, 0.75rem);
  }

  .site-nav__mobile-subnav {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2, 0.5rem);
  }

  .site-nav__mobile-link--plain {
    border-bottom: 0;
    padding-block: var(--space-1, 0.25rem);
  }

  .site-search-panel {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    visibility: hidden;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .site-search-panel.is-open {
    visibility: visible;
    opacity: 1;
  }

  .site-search-panel__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(7, 2, 15, 0.78);
    backdrop-filter: blur(8px);
  }

  .site-search-panel__dialog {
    position: relative;
    width: min(92vw, 36rem);
    border-radius: 1.5rem;
    border: 1px solid rgba(212, 175, 55, 0.25);
    background: rgba(12, 5, 23, 0.95);
    padding: clamp(1.25rem, 4vw, 1.75rem);
    box-shadow: var(--shadow-2, 0 28px 75px -24px rgba(3, 2, 12, 0.72));
    z-index: 1;
    display: grid;
    gap: 1rem;
  }

  .site-search-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: rgba(244, 241, 255, 0.85);
  }

  .site-search-panel__header h2 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
</style>
