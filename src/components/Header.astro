---
import SearchBox from "./SearchBox.astro";
import ComfortSettings from "./ComfortSettings.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface NavLink {
  href: string;
  label: string;
  description?: string;
  rel?: string;
  variant?: 'pill' | 'default';
}

interface AdminNavSection {
  label: string;
  items: NavLink[];
}

interface Props {
  brandName: string;
  navLinks: NavLink[];
  secondaryLinks?: NavLink[];
  utilityLinks?: NavLink[];
  adminSections?: AdminNavSection[];
  currentPath?: string;
}

const {
  brandName,
  navLinks = [],
  secondaryLinks = [],
  utilityLinks = [],
  adminSections = [],
  currentPath = "/",
} = Astro.props as Props;

const normalizedPath = currentPath.endsWith("/") && currentPath.length > 1
  ? currentPath
  : `${currentPath.replace(/\/$/, "")}/`;

const visibleAdminSections = adminSections.filter((section) =>
  section && Array.isArray(section.items) && section.items.length > 0
);
const hasAdminLinks = visibleAdminSections.length > 0;
const visibleSecondary = secondaryLinks.filter((link) => link && typeof link.href === "string");
const visibleUtility = utilityLinks.filter((link) => link && typeof link.href === "string");
const showComfortControls = !normalizedPath.startsWith("/admin/");
const enableScrollReveal = !normalizedPath.startsWith("/admin/");
const hasPrimarySearchLink = navLinks.some((link) => link.href === "/search" || link.href === "/search/");
const hasSecondaryRssLink = visibleSecondary.some((link) =>
  link.href === "/rss.xml" || link.href === "/feed.json"
);

function isActive(href: string): boolean {
  if (!href) return false;
  const normalized = href.endsWith("/") ? href : `${href}/`;
  if (normalized === "/") {
    return normalizedPath === normalized;
  }
  return normalizedPath.startsWith(normalized);
}
---
<header
  class:list={[
    "site-header",
    enableScrollReveal ? "site-header--visible" : undefined,
  ]}
  data-site-header
  data-scroll-reveal={enableScrollReveal ? "true" : "false"}
>
  <div class="wc-container site-header__inner">
    <a class="site-logo" href="/">{brandName}</a>
    <nav class="site-nav" aria-label="Primary navigation">
      <button
        class="site-nav__toggle focus-ring"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span class="sr-only" data-menu-label>Open menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M4 6h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Zm0 7h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Zm0 7h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Z"
          />
        </svg>
      </button>
      <ul class="site-nav__list">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              rel={item.rel}
              class:list={[
                "site-nav__link",
                item.variant === "pill" && "site-nav__link--pill",
              ].filter(Boolean)}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        {visibleSecondary.length > 0 && (
          <li class="site-nav__item site-nav__item--submenu">
            <button
              type="button"
              class="site-nav__button site-nav__button--more focus-ring"
              data-submenu-toggle
              aria-expanded="false"
              aria-controls="site-nav-secondary"
            >
              More
              <svg class="site-nav__button-caret" viewBox="0 0 12 8" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M10.59.59a2 2 0 0 1 0 2.82l-3.3 3.29a2 2 0 0 1-2.82 0L1.17 3.41A2 2 0 0 1 4 1.59l2 2 2-2a2 2 0 0 1 2.59 0Z"
                />
              </svg>
            </button>
            <div
              id="site-nav-secondary"
              class="site-nav__submenu"
              data-submenu
              aria-hidden="true"
            >
              <ul class="site-nav__submenu-list">
                {visibleSecondary.map((item) => (
                  <li>
                    <a class="site-nav__submenu-link" href={item.href} rel={item.rel}>
                      <span class="site-nav__submenu-label">{item.label}</span>
                      <span class="site-nav__submenu-meta">{item.description ?? item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        )}
      </ul>
      <div class="site-nav__actions">
        {showComfortControls && (
          <div class="site-nav__comfort-group">
            <ThemeToggle class="site-nav__theme" />
            <ComfortSettings />
          </div>
        )}

        {!hasPrimarySearchLink && (
          <a
            href="/search"
            class="site-nav__button focus-ring"
            data-search-toggle
            aria-expanded="false"
            aria-controls="site-search-panel"
          >
            Search
          </a>
        )}

        {/* Utility links like Contact, etc. */}
        {visibleUtility.length > 0 && (
          <div class="site-nav__utility">
            {visibleUtility.map((item) => (
              <a
                class="site-nav__button site-nav__button--utility focus-ring"
                href={item.href}
                rel={item.rel}
              >
                {item.label}
              </a>
            ))}
          </div>
        )}

        {/* Admin panel is its own little island */}
        {hasAdminLinks && (
          <div class="site-nav__divider" aria-hidden="true"></div>
        )}
        {hasAdminLinks && (
          <details class="site-nav__admin" data-admin-menu>
            <summary class="site-nav__button site-nav__button--admin focus-ring">
              Admin
              <svg class="site-nav__admin-caret" viewBox="0 0 12 8" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M10.59.59a2 2 0 0 1 0 2.82l-3.3 3.29a2 2 0 0 1-2.82 0L1.17 3.41A2 2 0 0 1 4 1.59l2 2 2-2a2 2 0 0 1 2.59 0Z"
                />
              </svg>
            </summary>
            <div class="site-nav__admin-dropdown" aria-label="Admin panel links">
              <div class="site-nav__admin-grid">
                {visibleAdminSections.map((section) => (
                  <div class="site-nav__admin-section">
                    <h3 class="site-nav__admin-section-label">{section.label}</h3>
                    <ul class="site-nav__admin-list">
                      {section.items.map((item) => (
                        <li>
                          <a class="site-nav__admin-link" href={item.href} rel={item.rel}>
                            {item.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </details>
        )}

        {!hasSecondaryRssLink && (
          <a
            class="site-nav__button site-nav__link--secondary focus-ring"
            href="/feed.json"
            rel="alternate"
          >
            RSS
          </a>
        )}
      </div>
    </nav>
  </div>
  <div
    id="mobile-navigation"
    class="site-nav__mobile"
    data-mobile-drawer
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
  >
    <div class="site-nav__mobile-header">
      <span class="site-logo">{brandName}</span>
      <button type="button" class="site-nav__toggle focus-ring" data-mobile-close aria-label="Close menu">
        ✕
      </button>
    </div>
    <ul class="site-nav__mobile-list">
      {navLinks.map((item) => (
        <li>
          <a
            href={item.href}
            rel={item.rel}
            class="site-nav__mobile-link focus-ring"
            aria-current={isActive(item.href) ? "page" : undefined}
            data-mobile-link
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    {visibleSecondary.length > 0 && (
      <div class="site-nav__mobile-section">
        <p class="site-footer__title">More from WitchClick</p>
        <ul class="site-nav__mobile-subnav">
          {visibleSecondary.map((item) => (
            <li>
              <a
                class="site-nav__mobile-link site-nav__mobile-link--plain focus-ring"
                href={item.href}
                rel={item.rel}
                data-mobile-link
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    {showComfortControls && (
      <div class="site-nav__mobile-theme">
        <ThemeToggle />
      </div>
    )}
    {showComfortControls && (
      <div class="site-nav__mobile-comfort">
        <ComfortSettings variant="stacked" />
      </div>
    )}
    <div class="site-nav__mobile-search">
      <SearchBox />
    </div>
    {hasAdminLinks && (
      <div class="site-nav__mobile-admin">
        <p class="site-footer__title">Admin Panel</p>
        {visibleAdminSections.map((section) => (
          <div class="site-nav__mobile-admin-section">
            <h4 class="site-nav__mobile-admin-label">{section.label}</h4>
            <ul class="site-nav__nav--stacked">
              {section.items.map((item) => (
                <li>
                  <a class="site-nav__mobile-link focus-ring" href={item.href} rel={item.rel} data-mobile-link>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
    {visibleUtility.length > 0 && (
      <div class="site-nav__mobile-section">
        <p class="site-footer__title">Quick links</p>
        <ul class="site-nav__mobile-subnav">
          {visibleUtility.map((item) => (
            <li>
              <a
                class="site-nav__mobile-link site-nav__mobile-link--plain focus-ring"
                href={item.href}
                rel={item.rel}
                data-mobile-link
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    
  </div>
  <div
    id="site-search-panel"
    class="site-search-panel"
    data-search-panel
    aria-hidden="true"
  >
    <div class="site-search-panel__backdrop" data-search-close aria-hidden="true"></div>
    <div class="site-search-panel__dialog" role="dialog" aria-modal="true">
      <div class="site-search-panel__header">
        <h2>Search WitchClick</h2>
        <button type="button" class="site-nav__toggle focus-ring" data-search-close aria-label="Close search">
          ✕
        </button>
      </div>
      <SearchBox />
    </div>
  </div>
</header>

<script is:inline>
  const body = document.body;
  const siteHeader = document.querySelector('[data-site-header]');
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileDrawer = document.querySelector('[data-mobile-drawer]');
  const searchToggle = document.querySelector('[data-search-toggle]');
  const searchPanel = document.querySelector('[data-search-panel]');

  const mobileCloseButtons = document.querySelectorAll('[data-mobile-close]');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');
  const searchCloseButtons = document.querySelectorAll('[data-search-close]');
  const submenuToggle = document.querySelector('[data-submenu-toggle]');
  const submenuPanel = document.querySelector('[data-submenu]');
  const submenuLinks = submenuPanel ? Array.from(submenuPanel.querySelectorAll('a')) : [];
  const scrollRevealEnabled = siteHeader?.getAttribute('data-scroll-reveal') === 'true';
  const SCROLL_TOP_THRESHOLD = 10;
  const SCROLL_DIRECTION_THRESHOLD = 8;
  let lastScrollY = window.scrollY;
  let scrollAccumulator = 0;
  let lastDirection = 0;
  let menuReturnFocus = null;

  function setHeaderVisibility(visible) {
    if (!siteHeader || !scrollRevealEnabled) return;
    siteHeader.classList.toggle('site-header--hidden', !visible);
    siteHeader.classList.toggle('site-header--visible', visible);
  }

  function setMenuOpen(open, restoreFocus = false) {
    const wasOpen = mobileDrawer?.classList.contains('is-open') || false;
    if (mobileDrawer) {
      mobileDrawer.classList.toggle('is-open', open);
      mobileDrawer.setAttribute('aria-hidden', String(!open));
    }
    if (menuToggle) {
      menuToggle.setAttribute('aria-expanded', String(open));
      const label = menuToggle.querySelector('[data-menu-label]');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    }
    if (body) {
      body.setAttribute('data-menu-open', open ? 'true' : 'false');
    }
    if (open) {
      menuReturnFocus = document.activeElement;
      setSearchOpen(false);
      setSubmenuOpen(false);
      const closeButton = mobileDrawer?.querySelector('[data-mobile-close]');
      if (closeButton) window.setTimeout(() => closeButton.focus(), 0);
    } else if (wasOpen && restoreFocus) {
      const target = menuReturnFocus instanceof HTMLElement ? menuReturnFocus : menuToggle;
      if (target) window.setTimeout(() => target.focus(), 0);
    }
    setHeaderVisibility(true);
  }

  function setSearchOpen(open) {
    if (searchPanel) {
      searchPanel.classList.toggle('is-open', open);
      searchPanel.setAttribute('aria-hidden', String(!open));
    }
    if (searchToggle) {
      searchToggle.setAttribute('aria-expanded', String(open));
    }
    if (body) {
      body.setAttribute('data-search-open', open ? 'true' : 'false');
    }
    if (open) {
      setMenuOpen(false);
      const input = searchPanel?.querySelector('input');
      if (input) {
        window.setTimeout(() => input.focus(), 120);
      }
      setSubmenuOpen(false);
    }
    setHeaderVisibility(true);
  }

  function setSubmenuOpen(open) {
    if (submenuPanel) {
      submenuPanel.classList.toggle('is-open', open);
      submenuPanel.setAttribute('aria-hidden', String(!open));
    }
    if (submenuToggle) {
      submenuToggle.setAttribute('aria-expanded', String(open));
    }
    if (open) {
      setMenuOpen(false);
      setSearchOpen(false);
    }
    setHeaderVisibility(true);
  }

  function handleHeaderScroll() {
    if (!scrollRevealEnabled || !siteHeader) return;
    if (body?.getAttribute('data-menu-open') === 'true' || body?.getAttribute('data-search-open') === 'true') {
      setHeaderVisibility(true);
      lastScrollY = window.scrollY;
      scrollAccumulator = 0;
      lastDirection = 0;
      return;
    }

    const currentScrollY = window.scrollY;

    if (currentScrollY < SCROLL_TOP_THRESHOLD) {
      setHeaderVisibility(true);
      lastScrollY = currentScrollY;
      scrollAccumulator = 0;
      lastDirection = 0;
      return;
    }

    const delta = currentScrollY - lastScrollY;
    if (Math.abs(delta) < 1) return;

    const direction = delta > 0 ? 1 : -1;
    if (direction !== lastDirection) {
      scrollAccumulator = 0;
      lastDirection = direction;
    }

    scrollAccumulator += delta;

    if (direction > 0 && scrollAccumulator >= SCROLL_DIRECTION_THRESHOLD) {
      setHeaderVisibility(false);
      scrollAccumulator = 0;
    } else if (direction < 0 && Math.abs(scrollAccumulator) >= SCROLL_DIRECTION_THRESHOLD) {
      setHeaderVisibility(true);
      scrollAccumulator = 0;
    }

    lastScrollY = currentScrollY;
  }

  menuToggle?.addEventListener('click', () => {
    const next = menuToggle.getAttribute('aria-expanded') !== 'true';
    setMenuOpen(next, !next);
  });

  searchToggle?.addEventListener('click', (event) => {
    event.preventDefault();
    const next = searchToggle.getAttribute('aria-expanded') !== 'true';
    setSearchOpen(next);
  });

  mobileCloseButtons.forEach((button) => {
    button.addEventListener('click', () => setMenuOpen(false, true));
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  searchCloseButtons.forEach((button) => {
    button.addEventListener('click', () => setSearchOpen(false));
  });

  submenuToggle?.addEventListener('click', (event) => {
    event.preventDefault();
    const next = submenuToggle.getAttribute('aria-expanded') !== 'true';
    setSubmenuOpen(next);
  });

  submenuLinks.forEach((link) => {
    link.addEventListener('click', () => setSubmenuOpen(false));
  });

  const closeSubmenuOnOutsideClick = (event) => {
    if (!submenuPanel || !submenuToggle) return;
    if (!submenuPanel.classList.contains('is-open')) return;
    if (submenuToggle.contains(event.target)) return;
    if (submenuPanel.contains(event.target)) return;
    setSubmenuOpen(false);
  };

  document.addEventListener('click', closeSubmenuOnOutsideClick);

  const closeSubmenuOnBlur = () => {
    window.setTimeout(() => {
      if (!submenuPanel || !submenuToggle) return;
      const active = document.activeElement;
      if (active && (submenuPanel.contains(active) || submenuToggle.contains(active))) {
        return;
      }
      setSubmenuOpen(false);
    }, 0);
  };

  submenuPanel?.addEventListener('focusout', closeSubmenuOnBlur);
  submenuToggle?.addEventListener('blur', closeSubmenuOnBlur);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Tab' && mobileDrawer?.classList.contains('is-open')) {
      const focusable = Array.from(mobileDrawer.querySelectorAll('a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'))
        .filter((element) => element instanceof HTMLElement && element.offsetParent !== null);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (first && last) {
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    }
    if (event.key === 'Escape') {
      setMenuOpen(false, true);
      setSearchOpen(false);
      setSubmenuOpen(false);
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth < 921) {
      setSubmenuOpen(false);
    }
  });

  if (scrollRevealEnabled) {
    setHeaderVisibility(true);
    window.addEventListener('scroll', handleHeaderScroll, { passive: true });
  }
</script>

<style is:global>
  .site-nav__actions {
    gap: clamp(var(--space-3), 2vw, var(--space-4));
    align-items: center;
  }

  .site-nav__theme {
    display: inline-flex;
  }

  .site-nav__comfort-group {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-nav__utility {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-nav__mobile-comfort {
    padding: 0 var(--space-4);
  }

  .site-nav__button--utility {
    background: color-mix(in srgb, var(--glass-surface, var(--header-background)) 78%, transparent 22%);
    border-color: color-mix(in srgb, var(--glass-border, var(--header-border)) 88%, transparent 12%);
  }

  .site-nav__button--utility:hover,
  .site-nav__button--utility:focus-visible {
    background: color-mix(in srgb, var(--glass-hover, var(--header-background)) 82%, var(--glass-highlight, var(--theme-color-iris)) 18%);
    border-color: color-mix(in srgb, var(--glass-border, var(--header-border)) 65%, var(--glass-highlight, var(--theme-color-iris)) 35%);
  }

  .site-nav__button--admin {
    background: color-mix(in srgb, var(--glass-surface-strong, var(--header-background)) 78%, var(--glass-highlight, var(--theme-color-gold)) 22%);
    border-color: color-mix(in srgb, var(--glass-border-strong, var(--header-border)) 82%, transparent 18%);
    color: color-mix(in srgb, var(--layout-shell-ink) 95%, white 5%);
  }

  .site-nav__button--admin:hover,
  .site-nav__button--admin:focus-visible {
    background: color-mix(in srgb, var(--glass-hover, var(--header-background)) 76%, var(--glass-highlight, var(--theme-color-gold)) 24%);
    border-color: color-mix(in srgb, var(--glass-border-strong, var(--header-border)) 68%, var(--glass-highlight, var(--theme-color-gold)) 32%);
  }

  .site-nav__item--submenu {
    position: relative;
  }

  .site-nav__link--pill {
    padding-inline: calc(var(--header-link-padding-inline) * 1.05);
    font-weight: 600;
    letter-spacing: 0.04em;
    background: color-mix(in srgb, var(--header-background) 40%, var(--theme-color-gold) 60%);
    border-color: color-mix(in srgb, var(--header-border) 35%, var(--theme-color-gold) 65%);
    color: color-mix(in srgb, var(--layout-shell-ink) 96%, white 4%);
  }

  .site-nav__link--pill:hover,
  .site-nav__link--pill:focus-visible {
    background: color-mix(in srgb, var(--header-background) 32%, var(--theme-color-gold) 68%);
    border-color: color-mix(in srgb, var(--header-border) 28%, var(--theme-color-gold) 72%);
  }

  .site-nav__button--more {
    gap: var(--space-2);
    font-weight: 500;
  }

  .site-nav__button-caret {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 160ms ease;
  }

  .site-nav__button[aria-expanded="true"] .site-nav__button-caret {
    transform: rotate(180deg);
  }

  .site-nav__divider {
    width: 1px;
    height: 1.5rem;
    background: color-mix(in srgb, var(--header-border) 40%, transparent 60%);
    margin-inline: var(--space-1);
  }

  .site-nav__admin {
    position: relative;
    margin-inline: var(--space-2);
  }

  .site-nav__admin > summary {
    list-style: none;
    cursor: pointer;
  }

  .site-nav__admin > summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__admin-caret {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 160ms ease;
  }

  .site-nav__admin[open] .site-nav__admin-caret {
    transform: rotate(180deg);
  }

  .site-nav__admin-dropdown {
    position: absolute;
    right: 0;
    margin-top: var(--space-2);
    padding: clamp(var(--space-4), 2vw, var(--space-5));
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--glass-border, var(--header-border)) 85%, transparent 15%);
    background: color-mix(in srgb, var(--glass-surface-strong, var(--header-background)) 94%, transparent 6%);
    backdrop-filter: blur(var(--glass-blur, 16px));
    box-shadow: var(--glass-shadow-strong, var(--shadow-soft));
    min-width: clamp(24rem, 38vw, 36rem);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.35rem);
    transition: opacity 180ms ease, transform 180ms ease;
    z-index: 40;
  }

  .site-nav__admin[open] .site-nav__admin-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-nav__admin-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--space-4), 2vw, var(--space-5));
  }

  .site-nav__admin-section {
    display: grid;
    gap: var(--space-2);
  }

  .site-nav__admin-section-label {
    font-family: var(--font-body-ui);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    color: color-mix(in srgb, var(--layout-shell-ink) 88%, white 12%);
    margin: 0;
    padding-bottom: var(--space-1);
    border-bottom: 1px solid color-mix(in srgb, var(--header-border) 52%, transparent 48%);
  }

  .site-nav__admin-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .site-nav__admin-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: 0.75rem;
    border: 1px solid transparent;
    background: color-mix(in srgb, var(--glass-card, var(--header-background)) 82%, transparent 18%);
    color: color-mix(in srgb, var(--layout-shell-ink) 90%, white 10%);
