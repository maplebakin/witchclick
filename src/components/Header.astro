---
import SearchBox from "./SearchBox.astro";
import ComfortSettings from "./ComfortSettings.astro";

interface NavLink {
  href: string;
  label: string;
  rel?: string;
}

interface Props {
  brandName: string;
  navLinks: NavLink[];
  adminLinks?: NavLink[];
  currentPath?: string;
}

const {
  brandName,
  navLinks = [],
  adminLinks = [],
  currentPath = "/",
} = Astro.props as Props;

const normalizedPath = currentPath.endsWith("/") && currentPath.length > 1
  ? currentPath
  : `${currentPath.replace(/\/$/, "")}/`;

const visibleAdmin = adminLinks.filter((link) => link && typeof link.href === "string");

function isActive(href: string): boolean {
  if (!href) return false;
  const normalized = href.endsWith("/") ? href : `${href}/`;
  if (normalized === "/") {
    return normalizedPath === normalized;
  }
  return normalizedPath.startsWith(normalized);
}
---
<header class="site-header" data-site-header>
  <div class="wc-container site-header__inner">
    <a class="site-logo" href="/">{brandName}</a>
    <nav class="site-nav" aria-label="Primary navigation">
      <button
        class="site-nav__toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span class="sr-only">Open menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M4 6h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Zm0 7h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Zm0 7h16a1 1 0 1 0 0-2H4a1 1 0 0 0 0 2Z"
          />
        </svg>
      </button>
      <ul class="site-nav__list">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              rel={item.rel}
              class="site-nav__link"
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="site-nav__actions">
        <ComfortSettings />
        {visibleAdmin.length > 0 && (
          <details class="site-nav__dev" data-dev-menu>
            <summary class="site-nav__button site-nav__button--dev">
              Dev shortcuts
              <svg class="site-nav__dev-caret" viewBox="0 0 12 8" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M10.59.59a2 2 0 0 1 0 2.82l-3.3 3.29a2 2 0 0 1-2.82 0L1.17 3.41A2 2 0 0 1 4 1.59l2 2 2-2a2 2 0 0 1 2.59 0Z"
                />
              </svg>
            </summary>
            <div class="site-nav__dev-dropdown" aria-label="Developer links">
              <ul class="site-nav__dev-list">
                {visibleAdmin.map((item) => (
                  <li>
                    <a class="site-nav__dev-link" href={item.href} rel={item.rel}>
                      {item.label}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )}
        <button
          type="button"
          class="site-nav__button"
          data-search-toggle
          aria-expanded="false"
          aria-controls="site-search-panel"
        >
          Search
        </button>
        <a class="site-nav__button site-nav__link--secondary" href="/feed.json" rel="alternate">
          RSS
        </a>
      </div>
    </nav>
  </div>
  <div
    id="mobile-navigation"
    class="site-nav__mobile"
    data-mobile-drawer
    aria-hidden="true"
  >
    <div class="site-nav__mobile-header">
      <span class="site-logo">{brandName}</span>
      <button type="button" class="site-nav__toggle" data-mobile-close aria-label="Close menu">
        ✕
      </button>
    </div>
    <div class="site-nav__mobile-search">
      <SearchBox />
    </div>
    <ul class="site-nav__mobile-list">
      {navLinks.map((item) => (
        <li>
          <a
            href={item.href}
            rel={item.rel}
            class="site-nav__mobile-link"
            aria-current={isActive(item.href) ? "page" : undefined}
            data-mobile-link
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    {visibleAdmin.length > 0 && (
      <div class="site-nav__mobile-admin">
        <p class="site-footer__title">Dev shortcuts</p>
        <ul class="site-nav__nav--stacked">
          {visibleAdmin.map((item) => (
            <li>
              <a class="site-nav__mobile-link" href={item.href} rel={item.rel}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class="site-nav__mobile-comfort">
      <ComfortSettings variant="stacked" />
    </div>
  </div>
  <div
    id="site-search-panel"
    class="site-search-panel"
    data-search-panel
    aria-hidden="true"
  >
    <div class="site-search-panel__backdrop" data-search-close aria-hidden="true"></div>
    <div class="site-search-panel__dialog" role="dialog" aria-modal="true">
      <div class="site-search-panel__header">
        <h2>Search WitchClick</h2>
        <button type="button" class="site-nav__toggle" data-search-close aria-label="Close search">
          ✕
        </button>
      </div>
      <SearchBox />
    </div>
  </div>
</header>

<script is:inline>
  const body = document.body;
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileDrawer = document.querySelector('[data-mobile-drawer]');
  const searchToggle = document.querySelector('[data-search-toggle]');
  const searchPanel = document.querySelector('[data-search-panel]');

  const mobileCloseButtons = document.querySelectorAll('[data-mobile-close]');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');
  const searchCloseButtons = document.querySelectorAll('[data-search-close]');

  function setMenuOpen(open) {
    if (mobileDrawer) {
      mobileDrawer.classList.toggle('is-open', open);
      mobileDrawer.setAttribute('aria-hidden', String(!open));
    }
    if (menuToggle) {
      menuToggle.setAttribute('aria-expanded', String(open));
    }
    if (body) {
      body.setAttribute('data-menu-open', open ? 'true' : 'false');
    }
    if (open) {
      setSearchOpen(false);
    }
  }

  function setSearchOpen(open) {
    if (searchPanel) {
      searchPanel.classList.toggle('is-open', open);
      searchPanel.setAttribute('aria-hidden', String(!open));
    }
    if (searchToggle) {
      searchToggle.setAttribute('aria-expanded', String(open));
    }
    if (body) {
      body.setAttribute('data-search-open', open ? 'true' : 'false');
    }
    if (open) {
      setMenuOpen(false);
      const input = searchPanel?.querySelector('input');
      if (input) {
        window.setTimeout(() => input.focus(), 120);
      }
    }
  }

  menuToggle?.addEventListener('click', () => {
    const next = menuToggle.getAttribute('aria-expanded') !== 'true';
    setMenuOpen(next);
  });

  searchToggle?.addEventListener('click', () => {
    const next = searchToggle.getAttribute('aria-expanded') !== 'true';
    setSearchOpen(next);
  });

  mobileCloseButtons.forEach((button) => {
    button.addEventListener('click', () => setMenuOpen(false));
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  searchCloseButtons.forEach((button) => {
    button.addEventListener('click', () => setSearchOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
      setSearchOpen(false);
    }
  });
</script>

<style is:inline>
  .site-nav__actions {
    display: none;
  }

  @media (min-width: 921px) {
    .site-nav__actions {
      display: flex;
      align-items: center;
      gap: var(--space-2, 0.5rem);
    }
  }

  .site-nav__button--dev {
    border-style: dashed;
    color: rgba(244, 241, 255, 0.8);
  }

  .site-nav__dev {
    position: relative;
  }

  .site-nav__dev > summary {
    list-style: none;
    cursor: pointer;
  }

  .site-nav__dev > summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__dev-caret {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 160ms ease;
  }

  .site-nav__dev[open] .site-nav__dev-caret {
    transform: rotate(180deg);
  }

  .site-nav__dev-dropdown {
    position: absolute;
    right: 0;
    margin-top: var(--space-2, 0.5rem);
    padding: var(--space-4, 1rem);
    border-radius: 1rem;
    border: 1px solid rgba(212, 175, 55, 0.25);
    background: rgba(18, 7, 37, 0.95);
    box-shadow: var(--shadow-2, 0 28px 75px -24px rgba(3, 2, 12, 0.72));
    display: grid;
    gap: var(--space-2, 0.5rem);
    min-width: 16rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.35rem);
    transition: opacity 160ms ease, transform 160ms ease;
    z-index: 40;
  }

  .site-nav__dev[open] .site-nav__dev-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-nav__dev-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2, 0.5rem);
  }

  .site-nav__dev-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border-radius: 0.75rem;
    border: 1px solid transparent;
    background: rgba(124, 78, 176, 0.12);
    color: rgba(244, 241, 255, 0.85);
    font-family: var(--font-accent);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-nav__dev-link:hover,
  .site-nav__dev-link:focus-visible {
    border-color: rgba(212, 175, 55, 0.45);
    background: rgba(124, 78, 176, 0.25);
    color: var(--color-gold, #d4af37);
  }

  .site-nav__mobile-admin {
    margin-top: var(--space-6, 1.5rem);
    padding-top: var(--space-4, 1rem);
    border-top: 1px solid rgba(212, 175, 55, 0.18);
    display: grid;
    gap: var(--space-3, 0.75rem);
  }

  .site-nav__nav--stacked {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2, 0.5rem);
  }

  .site-search-panel {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    visibility: hidden;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .site-search-panel.is-open {
    visibility: visible;
    opacity: 1;
  }

  .site-search-panel__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(7, 2, 15, 0.78);
    backdrop-filter: blur(8px);
  }

  .site-search-panel__dialog {
    position: relative;
    width: min(92vw, 36rem);
    border-radius: 1.5rem;
    border: 1px solid rgba(212, 175, 55, 0.25);
    background: rgba(12, 5, 23, 0.95);
    padding: clamp(1.25rem, 4vw, 1.75rem);
    box-shadow: var(--shadow-2, 0 28px 75px -24px rgba(3, 2, 12, 0.72));
    z-index: 1;
    display: grid;
    gap: 1rem;
  }

  .site-search-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: rgba(244, 241, 255, 0.85);
  }

  .site-search-panel__header h2 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
</style>
