---
import { getRelatedPosts } from "../utils/recommendations";

interface Props {
  currentSlug: string;
  data?: Record<string, any>;
  limit?: number;
}

const { currentSlug, data = {}, limit = 4 } = Astro.props as Props;

const recommendations = getRelatedPosts({ currentSlug, currentData: data, limit });
---
{recommendations.length > 0 ? (
  <section class="related-posts" aria-label="Recommended posts">
    <h2 class="card-eyebrow">Recommended</h2>
    <ul class="related-posts__list">
      {recommendations.map((item) => (
        <li>
          <a class="card-panel card-tier-1 card-panel-soft related-posts__card" href={item.href}>
            <div class="card-body">
              <span class="card-heading">{item.title}</span>
              {item.excerpt && <span class="card-subtle">{item.excerpt}</span>}
              <span class="card-metadata">
                {item.readingMinutes && <span class="card-metadata__item">{item.readingMinutes} min</span>}
                {item.spoonLevel && <span class="card-metadata__item">{item.spoonLevel} spoons</span>}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
) : null}

<style>
  .related-posts {
    display: grid;
    gap: 1rem;
  }

  .related-posts__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .related-posts__card .card-body {
    gap: 0.5rem;
  }

  .related-posts__card .card-heading {
    font-size: 0.98rem;
  }

  .related-posts__card .card-subtle {
    font-size: 0.85rem;
    line-height: 1.5;
  }
</style>
