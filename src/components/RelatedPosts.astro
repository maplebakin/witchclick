---
import PostCard from "./PostCard.astro";
import { loadAllPosts, estimateReadingMinutes, firstParagraph } from "../utils/posts";

interface Props {
  currentSlug: string;
  tags?: string[];
  limit?: number;
}

const { currentSlug, tags = [], limit = 3 } = Astro.props as Props;

const normalizedTags = tags
  .map((tag) => String(tag).toLowerCase().trim())
  .filter(Boolean);

const posts = loadAllPosts().filter((post) => post.slug !== currentSlug);

function scorePost(postTags: string[]): number {
  if (normalizedTags.length === 0) return 0;
  const tagSet = new Set(postTags.map((tag) => tag.toLowerCase()));
  let score = 0;
  for (const tag of normalizedTags) {
    if (tagSet.has(tag)) score += 1;
  }
  return score;
}

const ranked = posts
  .map((post) => {
    const fm = post.data ?? {};
    const postTags = Array.isArray(fm.tags) ? fm.tags.map((tag: any) => String(tag)) : [];
    const score = scorePost(postTags);
    return {
      post,
      fm,
      postTags,
      score,
    };
  })
  .filter((entry) => entry.score > 0)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return +b.post.date - +a.post.date;
  })
  .slice(0, limit)
  .map((entry) => {
    const { post, fm, postTags } = entry;
    const excerpt =
      fm.excerpt ?? fm.description ?? fm.metaDescription ?? firstParagraph(post.content);
    const readingMinutes = fm.readingMinutes ?? estimateReadingMinutes(post.content);
    const publishedAt =
      fm.publishedAt ?? fm.pubDate ?? fm.date ?? (post.date ? post.date.toISOString() : undefined);

    return {
      slug: post.slug,
      title: fm.title ?? post.title,
      excerpt,
      tags: postTags,
      readingMinutes,
      publishedAt,
    };
  });
---
{ranked.length > 0 ? (
  <section class="glass-panel">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <div>
        <p class="eyebrow text-purple-400/90">Keep reading</p>
        <h2 class="mt-2 text-2xl font-semibold text-purple-900">You might also enjoy</h2>
      </div>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {ranked.map((card) => (
        <PostCard
          post={{
            slug: card.slug,
            title: card.title,
            excerpt: card.excerpt,
            tags: card.tags,
            readingMinutes: card.readingMinutes,
            publishedAt: card.publishedAt,
          }}
          href={`/post/${card.slug}`}
        />
      ))}
    </div>
  </section>
) : null}
