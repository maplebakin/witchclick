---
import ComfortSettings from "./ComfortSettings.astro";

const panelId = `comfort-fab-${globalThis.crypto?.randomUUID?.() ?? Math.random().toString(36).slice(2)}`;
---
<div class="comfort-fab" data-comfort-fab>
  <button
    type="button"
    class="comfort-fab__trigger focus-ring"
    data-comfort-fab-toggle
    aria-controls={panelId}
    aria-expanded="false"
  >
    <span class="comfort-fab__icon" aria-hidden="true">✶</span>
    <span class="comfort-fab__label">Comfort</span>
  </button>
  <div
    id={panelId}
    class="comfort-fab__panel"
    data-comfort-fab-panel
    hidden
    role="dialog"
    aria-modal="false"
    aria-label="Comfort settings"
  >
    <ComfortSettings variant="stacked" />
  </div>
</div>

<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;
    const root = document.currentScript?.previousElementSibling;
    if (!(root instanceof HTMLElement)) return;
    const toggle = root.querySelector('[data-comfort-fab-toggle]');
    const panel = root.querySelector('[data-comfort-fab-panel]');
    if (!(toggle instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;

    let open = false;

    const setOpen = (next) => {
      open = Boolean(next);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      root.classList.toggle('is-open', open);
      if (open) {
        panel.querySelector('input, button, summary')?.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', (event) => {
      event.preventDefault();
      setOpen(!open);
    });

    document.addEventListener('click', (event) => {
      if (!open) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (root.contains(target)) return;
      setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (!open) return;
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
    });

    const closeOnNavigate = () => setOpen(false);
    window.addEventListener('astro:page-load', closeOnNavigate);
    window.addEventListener('astro:after-swap', closeOnNavigate);
  })();
</script>

<style>
  .comfort-fab {
    position: fixed;
    inset-inline-end: clamp(1rem, 4vw, 2rem);
    inset-block-end: clamp(1rem, 4vw, 2rem);
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-end;
    pointer-events: none;
  }

  .comfort-fab__trigger {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--border-accent-strong) 45%, transparent 55%);
    background: color-mix(in srgb, var(--surface-panel-primary) 82%, transparent 18%);
    color: color-mix(in srgb, var(--text-strong) 94%, transparent 6%);
    font-family: var(--font-accent);
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 0.6rem 1.4rem;
    box-shadow: var(--shadow-soft, 0 18px 45px -28px rgba(11, 6, 20, 0.55));
    transition: transform 200ms ease, box-shadow 200ms ease, background-color 200ms ease;
  }

  .comfort-fab__trigger:hover,
  .comfort-fab__trigger:focus-visible,
  .comfort-fab.is-open .comfort-fab__trigger {
    background: color-mix(in srgb, var(--surface-panel-primary) 70%, var(--accent-purple-strong) 30%);
    transform: translateY(-2px);
    box-shadow: var(--shadow-strong, 0 28px 75px -24px rgba(3, 2, 12, 0.72));
  }

  :root[data-comfort-theme="dawn"] .comfort-fab__trigger {
    border-color: color-mix(in srgb, var(--accent-purple-strong) 45%, transparent 55%);
    background: color-mix(in srgb, var(--surface-panel-primary) 94%, transparent 6%);
    color: color-mix(in srgb, var(--text-strong) 92%, white 8%);
  }

  :root[data-comfort-theme="dawn"] .comfort-fab__trigger:hover,
  :root[data-comfort-theme="dawn"] .comfort-fab__trigger:focus-visible,
  :root[data-comfort-theme="dawn"] .comfort-fab.is-open .comfort-fab__trigger {
    background: color-mix(in srgb, var(--surface-panel-primary) 98%, transparent 2%);
  }

  .comfort-fab__icon {
    font-size: 1.1rem;
  }

  .comfort-fab__label {
    font-weight: 600;
  }

  .comfort-fab__panel {
    pointer-events: auto;
    width: min(22rem, calc(100vw - 2rem));
    border-radius: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--border-accent-medium) 38%, transparent 62%);
    background: color-mix(in srgb, var(--surface-panel-primary) 86%, transparent 14%);
    box-shadow: 0 24px 55px -24px rgba(12, 5, 23, 0.62);
    padding: 1rem;
    backdrop-filter: blur(20px);
    transform-origin: bottom right;
    animation: comfort-fab-in 220ms ease;
  }

  .comfort-fab:not(.is-open) .comfort-fab__panel {
    display: none;
  }

  :root[data-comfort-theme="dawn"] .comfort-fab__panel {
    border-color: color-mix(in srgb, var(--accent-purple-soft) 32%, transparent 68%);
    background: color-mix(in srgb, var(--surface-panel-primary) 98%, transparent 2%);
    box-shadow: 0 24px 55px -28px rgba(63, 49, 86, 0.25);
  }

  @keyframes comfort-fab-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 719px) {
    .comfort-fab {
      inset-inline-end: clamp(0.75rem, 4vw, 1.25rem);
      inset-block-end: clamp(0.75rem, 4vw, 1.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .comfort-fab__trigger {
      transition: none;
    }

    .comfort-fab__panel {
      animation: none;
    }
  }
</style>
