---
import { loadAllPosts } from "@/utils/posts";

interface Props {
  inputId: string;
  limit?: number;
}

const { inputId, limit = 8 } = Astro.props as Props;

const posts = loadAllPosts();
const counts = new Map<string, number>();

for (const post of posts) {
  const fm = post.data ?? {};
  const tagsRaw = Array.isArray(fm.tags)
    ? fm.tags
    : typeof fm.tags === "string"
      ? fm.tags.split(",")
      : [];
  for (const tag of tagsRaw) {
    if (typeof tag !== "string") continue;
    const cleaned = tag.trim();
    if (!cleaned) continue;
    const key = cleaned.toLowerCase();
    counts.set(key, (counts.get(key) ?? 0) + 1);
  }
}

const sorted = Array.from(counts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, Math.max(0, limit));

const tags = sorted.map(([value, count]) => ({
  value,
  label: `#${value}`,
  count,
}));
---
{tags.length > 0 && (
  <div class="search-tags" data-search-tags data-input-id={inputId}>
    <p class="search-tags__label" id={`${inputId}-tags-label`}>
      Quick tags
    </p>
    <div class="search-tags__list" role="list" aria-labelledby={`${inputId}-tags-label`}>
      {tags.map((tag) => (
        <button
          type="button"
          class="search-tags__chip focus-ring"
          data-tag-value={tag.value}
          role="listitem"
        >
          {tag.label}
        </button>
      ))}
    </div>
  </div>
)}

<style>
  .search-tags {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .search-tags__label {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-hint, rgba(244, 241, 255, 0.65)) 95%, transparent 5%);
  }

  .search-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .search-tags__chip {
    border: 1px solid color-mix(in srgb, var(--accent-purple-strong) 35%, transparent 65%);
    background: color-mix(in srgb, hsl(var(--surface-panel-primary)) 88%, transparent 12%);
    border-radius: 999px;
    font-size: 0.75rem;
    padding: 0.4rem 0.85rem;
    color: color-mix(in srgb, var(--text-secondary, rgba(244, 241, 255, 0.85)) 92%, transparent 8%);
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .search-tags__chip:hover,
  .search-tags__chip:focus-visible {
    border-color: color-mix(in srgb, var(--accent-purple-strong) 55%, transparent 45%);
    background: color-mix(in srgb, hsl(var(--surface-panel-primary)) 94%, transparent 6%);
    color: color-mix(in srgb, var(--link-color, #d4af37) 65%, var(--text-secondary, rgba(244, 241, 255, 0.85)) 35%);
  }

  :root[data-comfort-theme="dawn"] .search-tags__chip {
    border-color: color-mix(in srgb, var(--accent-purple-soft) 30%, transparent 70%);
    background: color-mix(in srgb, hsl(var(--surface-panel-primary)) 96%, transparent 4%);
    color: color-mix(in srgb, var(--text-body) 90%, white 10%);
  }

  :root[data-comfort-theme="dawn"] .search-tags__chip:hover,
  :root[data-comfort-theme="dawn"] .search-tags__chip:focus-visible {
    border-color: color-mix(in srgb, var(--accent-purple-soft) 40%, transparent 60%);
    background: color-mix(in srgb, hsl(var(--surface-panel-primary)) 98%, transparent 2%);
    color: color-mix(in srgb, var(--link-color, #caa043) 60%, var(--text-body) 40%);
  }
</style>
