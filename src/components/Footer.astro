---
import PrimaryButton from "./buttons/PrimaryButton.astro";

interface NavLink {
  href: string;
  label: string;
  rel?: string;
}

interface Props {
  brandName: string;
  navLinks?: NavLink[];
  secondaryNavLinks?: NavLink[];
  utilityLinks?: NavLink[];
  disclosure?: string;
}

const {
  brandName,
  navLinks = [],
  secondaryNavLinks = [],
  utilityLinks = [],
  disclosure = "",
} = Astro.props as Props;

const hasDisclosure = typeof disclosure === "string" && disclosure.trim().length > 0;
const isNavLink = (link: NavLink | undefined | null): link is NavLink =>
  Boolean(link && typeof link.href === "string" && typeof link.label === "string");

const primaryNav = navLinks.filter(isNavLink);
const secondaryNav = secondaryNavLinks.filter(isNavLink);
const utilityNav = utilityLinks.filter(isNavLink);
---
<footer class="site-footer" aria-label="Site footer">
  <div class="wc-container site-footer__inner">
    <div class="site-footer__grid">
      <div>
        <span class="site-logo" aria-label={`${brandName} logo`}>{brandName}</span>
        <p class="site-footer__blurb">
          Secular rituals, tarot, and reflective tools for choosing your lens and finding value where ordinary scoreboards fail.
        </p>
        {hasDisclosure && <p class="site-footer__disclosure">{disclosure}</p>}
      </div>
      {primaryNav.length > 0 && (
        <div>
          <p class="site-footer__title">Explore</p>
          <ul class="site-footer__nav">
            {primaryNav.map((link) => (
              <li>
                <a class="site-footer__link focus-ring" href={link.href} rel={link.rel}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      {secondaryNav.length > 0 && (
        <div>
          <p class="site-footer__title">Discover</p>
          <ul class="site-footer__nav">
            {secondaryNav.map((link) => (
              <li>
                <a class="site-footer__link focus-ring" href={link.href} rel={link.rel}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div>
        <p class="site-footer__title">Stay connected</p>
        <p class="site-footer__blurb">
          Subscribe for new reflections, ritual prompts, and practical notes for living beyond the metric.
        </p>
        <div class="site-footer__meta">
          <PrimaryButton href="/contact" iconAfter="↗">
            Reach out
          </PrimaryButton>
        </div>
        <div class="site-footer__feeds">
          <p class="site-footer__feeds-label">Self-host updates</p>
          <div class="site-footer__feed-links">
            <a class="site-footer__feed focus-ring" href="/rss.xml" rel="alternate" data-analytics="subscribe_rss">
              RSS feed
            </a>
            <a class="site-footer__feed focus-ring" href="/feed.json" rel="alternate" data-analytics="subscribe_json">
              JSON feed
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="site-footer__meta">
      {utilityNav.length > 0 && (
        <ul class="site-footer__nav site-footer__nav--inline">
          {utilityNav.map((link) => (
            <li>
              <a class="site-footer__link focus-ring" href={link.href} rel={link.rel}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <div class="site-footer__tail">
        <a class="site-footer__top focus-ring" href="#top">
          Back to top ↑
        </a>
        <p class="site-footer__copyright">© {new Date().getFullYear()} {brandName}. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
