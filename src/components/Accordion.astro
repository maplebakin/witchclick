---
interface Props {
  title: string;
  open?: boolean;
}

const { title, open = false } = Astro.props as Props;
---
<details class="wc-accordion" open={open ? true : undefined}>
  <summary class="wc-accordion__summary">{title}</summary>
  <div class="wc-accordion__panel">
    <slot />
  </div>
</details>

<style>
  .wc-accordion {
    --accordion-border: color-mix(
      in srgb,
      var(--ambient-color, hsl(var(--accent-2) / 1)) 45%,
      transparent 55%
    );
    --accordion-border-active: color-mix(
      in srgb,
      var(--ambient-color, hsl(var(--accent-2) / 1)) 58%,
      transparent 42%
    );
    --accordion-surface: color-mix(
      in srgb,
      var(--ambient-color, hsl(var(--accent-2) / 1)) 22%,
      black 78%
    );
    --accordion-surface-active: color-mix(
      in srgb,
      var(--ambient-color, hsl(var(--accent-2) / 1)) 28%,
      black 72%
    );
    border-radius: 1rem;
    border: 1px solid var(--accordion-border);
    background: linear-gradient(160deg, var(--accordion-surface) 0%, color-mix(in srgb,
            var(--ambient-color, hsl(var(--accent-2) / 1)) 16%, black 84%) 100%);
    box-shadow: 0 20px 45px -28px color-mix(in srgb, var(--ambient-color, hsl(var(--accent-2) / 1)) 38%, black 62%);
    color: var(--action-primary-text, var(--text-strong));
    overflow: hidden;
  }

  .wc-accordion[open] {
    border-color: var(--accordion-border-active);
    background: linear-gradient(160deg, var(--accordion-surface-active) 0%, color-mix(in srgb,
            var(--ambient-color, hsl(var(--accent-2) / 1)) 20%, black 80%) 100%);
  }

  .wc-accordion__summary {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    font-family: var(--font-accent);
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    color: inherit;
  }

  .wc-accordion__summary::before {
    content: '✶';
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .wc-accordion__summary::after {
    content: '⌄';
    margin-left: auto;
    transition: transform 200ms ease;
  }

  .wc-accordion[open] .wc-accordion__summary::after {
    transform: rotate(180deg);
  }

  .wc-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .wc-accordion__summary:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--action-primary-text, var(--text-strong)) 70%, white 30%);
    outline-offset: 3px;
  }

  .wc-accordion__panel {
    padding: 1rem 1.1rem 1.25rem;
    display: grid;
    gap: 0.75rem;
    font-family: var(--font-body-ui, var(--font-body));
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--action-primary-text, var(--text-strong)) 94%, white 6%);
  }

  :global(.wc-accordion__lead) {
    margin: 0;
  }

  :global(.wc-accordion__list) {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.45rem;
  }

  :global(.wc-accordion__list li::marker) {
    color: color-mix(in srgb, var(--action-primary-text, var(--text-strong)) 65%, white 35%);
  }

  :root[data-comfort-theme="dawn"] .wc-accordion {
    --accordion-border: color-mix(
      in srgb,
      var(--panel-border-soft, color-mix(in srgb, var(--border-subtle) 72%, transparent 28%)) 65%,
      transparent 35%
    );
    --accordion-border-active: color-mix(
      in srgb,
      var(--panel-border-strong, color-mix(in srgb, var(--border-strong) 72%, transparent 28%)) 70%,
      transparent 30%
    );
    background: linear-gradient(160deg, color-mix(in oklab, var(--panel-surface-soft, var(--surface-card)) 94%, white 6%) 0%,
        color-mix(in oklab, var(--panel-surface-strong, var(--surface-elevated)) 88%, white 12%) 100%);
    box-shadow: 0 20px 45px -28px color-mix(in srgb, var(--surface-tint, hsl(var(--accent-1) / 1)) 26%, transparent 74%);
    color: var(--ink-strong, var(--text-strong));
  }

  :root[data-comfort-theme="dawn"] .wc-accordion[open] {
    background: linear-gradient(160deg, color-mix(in oklab, var(--panel-surface-strong, var(--surface-elevated)) 92%, white 8%) 0%,
        color-mix(in oklab, var(--panel-surface-strong, var(--surface-elevated)) 82%, white 18%) 100%);
  }

  :global(:root[data-comfort-theme="dawn"] .wc-accordion__summary) {
    color: var(--ink-strong, var(--text-strong));
  }

  :root[data-comfort-theme="dawn"] .wc-accordion__panel {
    color: var(--ink-body, var(--text-body));
  }

  :global(:root[data-comfort-theme="dawn"] .wc-accordion__list li::marker) {
    color: color-mix(in srgb, var(--action-primary, hsl(var(--accent-2) / 1)) 45%, transparent 55%);
  }
</style>
