---
interface Props {
  page: number;
  totalPages: number;
  /** base href without trailing slash, e.g. '/page' or '/tag/some-tag' */
  baseHref?: string;
}

const { page = 1, totalPages = 1, baseHref = "/page" } = Astro.props as Props;
const p = Number(page);
---
<nav class="mt-12 flex flex-wrap items-center justify-center gap-3" aria-label="Pagination">
  {p > 1 ? (
    <a
      class="inline-flex items-center gap-1 rounded-full border border-line-muted bg-surface-base/80 px-4 py-2 text-sm font-medium text-secondary transition hover:border-line-strong hover:bg-surface-muted"
      href={`${baseHref}/${p - 1}`}
      rel="prev"
    >
      ← Previous
    </a>
  ) : (
    <span class="inline-flex items-center gap-1 rounded-full border border-line-subtle px-4 py-2 text-sm text-accent-soft" aria-disabled="true">
      ← Previous
    </span>
  )}

  <span class="text-sm text-secondary/80">Page {p} of {totalPages}</span>

  {p < totalPages ? (
    <a
      class="inline-flex items-center gap-1 rounded-full border border-line-muted bg-surface-base/80 px-4 py-2 text-sm font-medium text-secondary transition hover:border-line-strong hover:bg-surface-muted"
      href={`${baseHref}/${p + 1}`}
      rel="next"
    >
      Next →
    </a>
  ) : (
    <span class="inline-flex items-center gap-1 rounded-full border border-line-subtle px-4 py-2 text-sm text-accent-soft" aria-disabled="true">
      Next →
    </span>
  )}
</nav>
