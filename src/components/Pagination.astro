---
interface Props {
  page: number;
  totalPages: number;
  /** base href without trailing slash, e.g. '/journal/page' */
  baseHref?: string;
}

const { page = 1, totalPages = 1, baseHref = "/journal/page" } = Astro.props as Props;
const current = Number(page);
const prevHref = current > 1 ? `${baseHref}/${current - 1}` : null;
const nextHref = current < totalPages ? `${baseHref}/${current + 1}` : null;
---
<nav aria-label="Pagination" class="mt-12 border-t border-line-muted/40 pt-6">
  <ul class="flex flex-col items-start gap-4 text-sm text-body-muted sm:flex-row sm:items-center sm:justify-between">
    <li>
      {prevHref ? (
        <a href={prevHref} rel="prev" class="inline-flex items-center gap-2 rounded-full border border-line-muted/60 px-4 py-2 transition hover:border-line-bold hover:text-body">
          ← Newer entries
        </a>
      ) : (
        <span class="inline-flex items-center gap-2 rounded-full border border-transparent px-4 py-2 text-body-subtle">
          ← Newer entries
        </span>
      )}
    </li>
    <li class="text-xs uppercase tracking-[0.3em] text-body-subtle">
      Page {current} of {totalPages}
    </li>
    <li>
      {nextHref ? (
        <a href={nextHref} rel="next" class="inline-flex items-center gap-2 rounded-full border border-line-muted/60 px-4 py-2 transition hover:border-line-bold hover:text-body">
          Older entries →
        </a>
      ) : (
        <span class="inline-flex items-center gap-2 rounded-full border border-transparent px-4 py-2 text-body-subtle">
          Older entries →
        </span>
      )}
    </li>
  </ul>
</nav>
