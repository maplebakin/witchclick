---
// src/components/ui/Select.astro
import type { HTMLAttributes } from 'astro/types';

type Props = {
  class?: string;
} & HTMLAttributes<'select'>;

const {
  class: className,
  ...props
} = Astro.props;

const baseClasses = [
  'block',
  'w-full',
  'rounded-lg',
  'border',
  'bg-surface-base',
  'px-3',
  'py-2',
  'text-sm',
  'text-body-strong',
  'transition-all',
  'focus:border-primary',
  'focus:ring-2',
  'focus:ring-primary/40',
  'focus:outline-none',
  'disabled:cursor-not-allowed',
  'disabled:opacity-60',
  'disabled:bg-surface-neutral-soft',
];

const classes = [
  ...baseClasses,
  'border-line-neutral', // Default border
  className,
].join(' ');
---

<select class={classes} {...props}>
  <slot />
</select>
