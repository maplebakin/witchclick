---
import comfortPreferencesUrl from "../scripts/comfort-preferences.js?url";

interface Props {
  variant?: 'inline' | 'stacked';
}

const { variant = 'inline' } = Astro.props as Props;
const isStacked = variant === 'stacked';
const summaryId = `comfort-summary-${variant}`;
const fontToggleId = `comfort-font-${variant}`;
const themeToggleId = `comfort-theme-${variant}`;
---
<details
  class:list={["comfort-settings", isStacked && "comfort-settings--stacked"].filter(Boolean)}
  open={isStacked ? true : undefined}
>
  <summary id={summaryId} class="comfort-settings__summary">
    <span class="comfort-settings__sparkle" aria-hidden="true">✶</span>
    <span>
      Comfort
      <span class="comfort-settings__subtitle">Tweak text & glow</span>
    </span>
  </summary>
  <div class="comfort-settings__panel" role="group" aria-labelledby={summaryId}>
    <p class="comfort-settings__hint">Choose what feels easiest right now.</p>
    <div class="comfort-settings__option">
      <input
        id={fontToggleId}
        class="comfort-settings__control"
        type="checkbox"
        data-comfort-font-toggle
      />
      <label class="comfort-settings__label" for={fontToggleId}>
        <span class="comfort-settings__label-text">Sans-serif body text</span>
        <span class="comfort-settings__description">Switch to Inter for smoother tracking.</span>
      </label>
    </div>
    <div class="comfort-settings__option">
      <input
        id={themeToggleId}
        class="comfort-settings__control"
        type="checkbox"
        data-comfort-theme-toggle
      />
      <label class="comfort-settings__label" for={themeToggleId}>
        <span class="comfort-settings__label-text">Calm parchment contrast</span>
        <span class="comfort-settings__description">Soften gradients for a gentler glow.</span>
      </label>
    </div>
  </div>
</details>

<script type="module" is:inline src={comfortPreferencesUrl} />
<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;
    const script = document.currentScript;
    let host = script?.previousElementSibling;
    while (host && !host.classList?.contains('comfort-settings')) {
      host = host.previousElementSibling;
    }
    if (!host) return;

    const run = () => {
      const comfort = window.__wcComfort;
      if (!comfort) return false;

      const fontToggles = Array.from(
        host.querySelectorAll<HTMLInputElement>('[data-comfort-font-toggle]')
      );
      const themeToggles = Array.from(
        host.querySelectorAll<HTMLInputElement>('[data-comfort-theme-toggle]')
      );

      const sync = (prefs) => {
        fontToggles.forEach((toggle) => {
          toggle.checked = prefs.font === 'sans';
        });
        themeToggles.forEach((toggle) => {
          toggle.checked = prefs.theme === 'dawn';
        });
      };

      const unsubscribe = comfort.subscribe(sync);

      fontToggles.forEach((toggle) => {
        toggle.addEventListener('change', () => {
          comfort.set({ font: toggle.checked ? 'sans' : 'serif' });
        });
      });

      themeToggles.forEach((toggle) => {
        toggle.addEventListener('change', () => {
          comfort.set({ theme: toggle.checked ? 'dawn' : 'midnight' });
        });
      });

      window.addEventListener(
        'astro:beforeunload',
        () => {
          unsubscribe();
        },
        { once: true },
      );

      return true;
    };

    const start = () => {
      if (run()) return;
      window.addEventListener('wc:comfort-ready', run, { once: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>

<style is:inline>
  .comfort-settings {
    position: relative;
    width: 100%;
  }

  .comfort-settings__summary {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    border-radius: 999px;
    border: 1px solid var(--comfort-chip-border, color-mix(in srgb, var(--theme-color-gold, var(--text-accent)) 28%, var(--theme-color-iris, hsl(var(--accent-ink) / 1)) 22%));
    background: var(--comfort-chip-bg, hsl(var(--neutral-9) / 0.45));
    color: var(--comfort-chip-text, var(--theme-ink-strong));
    font-family: var(--font-accent);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .comfort-settings__summary::-webkit-details-marker {
    display: none;
  }

  .comfort-settings__summary:hover,
  .comfort-settings__summary:focus-visible {
    background: var(--comfort-chip-bg-hover, color-mix(in srgb, var(--comfort-chip-bg) 85%, white 15%));
    border-color: var(--comfort-chip-border-strong, color-mix(in srgb, var(--theme-color-gold, var(--text-accent)) 45%, var(--theme-color-iris, hsl(var(--accent-ink) / 1)) 35%));
    color: var(--comfort-chip-text-strong, var(--theme-text-strong));
  }

  .comfort-settings__sparkle {
    font-size: 1rem;
    opacity: 0.8;
  }

  .comfort-settings__subtitle {
    display: block;
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: none;
    opacity: 0.7;
  }

  .comfort-settings__panel {
    position: absolute;
    right: 0;
    z-index: 35;
    margin-top: var(--space-2, 0.5rem);
    padding: var(--space-5, 1.5rem);
    border-radius: 1.5rem;
    border: 1px solid var(--comfort-tray-border, color-mix(in srgb, var(--theme-color-gold, var(--text-accent)) 28%, var(--theme-color-iris, hsl(var(--accent-ink) / 1)) 22%));
    background: var(--comfort-tray-surface, hsl(var(--neutral-9) / 0.78));
    box-shadow: var(--comfort-tray-shadow, 0 28px 60px -32px hsl(var(--neutral-9) / 0.65));
    min-width: 18rem;
    display: grid;
    gap: var(--space-4, 1rem);
  }

  .comfort-settings--stacked .comfort-settings__panel {
    position: static;
    margin-top: var(--space-4, 1rem);
    min-width: 0;
  }

  .comfort-settings__hint {
    font-size: 0.9rem;
    color: var(--comfort-tray-hint, var(--theme-text-tertiary));
    margin: 0;
  }

  .comfort-settings__option {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-3, 0.75rem);
  }

  .comfort-settings__control {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 0.35rem;
    border: 1px solid var(--comfort-tray-border-strong, color-mix(in srgb, var(--theme-color-gold, var(--text-accent)) 45%, var(--theme-color-iris, hsl(var(--accent-ink) / 1)) 30%));
    background: var(--comfort-chip-surface, hsl(var(--neutral-9) / 0.65));
    accent-color: var(--comfort-chip-accent, var(--theme-color-amethyst));
  }

  .comfort-settings__label {
    display: grid;
    gap: var(--space-1, 0.25rem);
    cursor: pointer;
  }

  .comfort-settings__label-text {
    font-family: var(--font-accent);
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .comfort-settings__description {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--comfort-tray-hint, var(--theme-text-tertiary));
  }

  @media (max-width: 1100px) {
    .comfort-settings__panel {
      position: static;
      margin-top: var(--space-4, 1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .comfort-settings__summary {
      transition: none;
    }
  }
</style>
