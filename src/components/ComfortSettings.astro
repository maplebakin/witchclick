---
interface Props {
  variant?: 'inline' | 'stacked';
}

const { variant = 'inline' } = Astro.props as Props;
const summaryId = `comfort-summary-${variant}`;
const fontToggleId = `comfort-font-${variant}`;
const themeToggleId = `comfort-theme-${variant}`;
---
<details class:list={["comfort-settings", variant === "stacked" && "comfort-settings--stacked"].filter(Boolean)}>
  <summary id={summaryId} class="comfort-settings__summary">
    <span class="comfort-settings__sparkle" aria-hidden="true">✶</span>
    <span>
      Comfort
      <span class="comfort-settings__subtitle">Tweak text & glow</span>
    </span>
  </summary>
  <div class="comfort-settings__panel" role="group" aria-labelledby={summaryId}>
    <p class="comfort-settings__hint">Choose what feels easiest right now.</p>
    <div class="comfort-settings__option">
      <input
        id={fontToggleId}
        class="comfort-settings__control"
        type="checkbox"
        data-comfort-font-toggle
      />
      <label class="comfort-settings__label" for={fontToggleId}>
        <span class="comfort-settings__label-text">Sans-serif body text</span>
        <span class="comfort-settings__description">Switch to Inter for smoother tracking.</span>
      </label>
    </div>
    <div class="comfort-settings__option">
      <input
        id={themeToggleId}
        class="comfort-settings__control"
        type="checkbox"
        data-comfort-theme-toggle
      />
      <label class="comfort-settings__label" for={themeToggleId}>
        <span class="comfort-settings__label-text">Calm parchment contrast</span>
        <span class="comfort-settings__description">Soften gradients for a gentler glow.</span>
      </label>
    </div>
  </div>
</details>

<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;
    if (window.__wcComfortLoaded) return;
    window.__wcComfortLoaded = true;

    const storageKey = 'witchclick-comfort';
    const defaults = { theme: 'midnight', font: 'serif' };

    const applyPreferences = (prefs) => {
      const root = document.documentElement;
      const body = document.body;
      if (!root) return;

      if (prefs.font === 'sans') {
        root.setAttribute('data-comfort-font', 'sans');
        body?.setAttribute('data-comfort-font', 'sans');
      } else {
        root.removeAttribute('data-comfort-font');
        body?.removeAttribute('data-comfort-font');
      }

      if (prefs.theme === 'dawn') {
        root.setAttribute('data-comfort-theme', 'dawn');
        body?.setAttribute('data-comfort-theme', 'dawn');
      } else {
        root.removeAttribute('data-comfort-theme');
        body?.removeAttribute('data-comfort-theme');
      }
    };

    const persist = (prefs) => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(prefs));
      } catch (error) {
        /* no-op */
      }
    };

    const setup = () => {
      let current = { ...defaults };
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored) {
          current = { ...current, ...JSON.parse(stored) };
        }
      } catch (error) {
        /* no-op */
      }

      applyPreferences(current);

      const fontToggles = Array.from(document.querySelectorAll('[data-comfort-font-toggle]'));
      const themeToggles = Array.from(document.querySelectorAll('[data-comfort-theme-toggle]'));

      const syncInputs = () => {
        fontToggles.forEach((toggle) => {
          toggle.checked = current.font === 'sans';
        });
        themeToggles.forEach((toggle) => {
          toggle.checked = current.theme === 'dawn';
        });
      };

      syncInputs();

      fontToggles.forEach((toggle) => {
        toggle.addEventListener('change', () => {
          current = { ...current, font: toggle.checked ? 'sans' : 'serif' };
          applyPreferences(current);
          persist(current);
          syncInputs();
        });
      });

      themeToggles.forEach((toggle) => {
        toggle.addEventListener('change', () => {
          current = { ...current, theme: toggle.checked ? 'dawn' : 'midnight' };
          applyPreferences(current);
          persist(current);
          syncInputs();
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup, { once: true });
    } else {
      setup();
    }
  })();
</script>

<style is:inline>
  .comfort-settings {
    position: relative;
  }

  .comfort-settings__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    background: rgba(12, 5, 23, 0.45);
    font-family: var(--font-accent);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .comfort-settings__summary::-webkit-details-marker {
    display: none;
  }

  .comfort-settings__summary:focus-visible {
    outline: 2px solid var(--color-gold, #d4af37);
    outline-offset: 3px;
  }

  .comfort-settings__sparkle {
    font-size: 1rem;
    opacity: 0.85;
  }

  .comfort-settings__subtitle {
    display: block;
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: none;
    opacity: 0.75;
  }

  .comfort-settings__panel {
    position: absolute;
    right: 0;
    z-index: 35;
    margin-top: var(--space-2, 0.5rem);
    padding: var(--space-4, 1rem);
    border-radius: 1rem;
    border: 1px solid rgba(212, 175, 55, 0.25);
    background: rgba(12, 5, 23, 0.92);
    box-shadow: var(--shadow-soft, 0 18px 45px -28px rgba(11, 6, 20, 0.55));
    min-width: 18rem;
    display: grid;
    gap: var(--space-3, 0.75rem);
  }

  .comfort-settings--stacked .comfort-settings__panel {
    position: static;
    margin-top: var(--space-3, 0.75rem);
    min-width: 0;
  }

  .comfort-settings__hint {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .comfort-settings__option {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-2, 0.5rem);
  }

  .comfort-settings__control {
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 0.35rem;
    border: 1px solid rgba(212, 175, 55, 0.4);
    background: rgba(12, 5, 23, 0.65);
    accent-color: var(--color-gold, #d4af37);
  }

  .comfort-settings__label {
    display: grid;
    gap: 0.2rem;
    cursor: pointer;
  }

  .comfort-settings__label-text {
    font-family: var(--font-accent);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .comfort-settings__description {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-tertiary);
  }

  @media (max-width: 920px) {
    .comfort-settings {
      width: 100%;
    }

    .comfort-settings__summary {
      width: 100%;
      justify-content: space-between;
    }

    .comfort-settings__panel {
      position: static;
      margin-top: var(--space-3, 0.75rem);
    }
  }

  :root[data-comfort-theme='dawn'] .comfort-settings__summary {
    border-color: rgba(121, 90, 150, 0.35);
    background: rgba(250, 246, 240, 0.85);
    color: var(--color-ink, #2c1b3d);
  }

  :root[data-comfort-theme='dawn'] .comfort-settings__panel {
    background: rgba(255, 252, 247, 0.95);
    border-color: rgba(121, 90, 150, 0.28);
    color: var(--color-ink, #2c1b3d);
    box-shadow: 0 18px 45px -28px rgba(71, 54, 96, 0.25);
  }

  :root[data-comfort-theme='dawn'] .comfort-settings__control {
    background: rgba(252, 248, 242, 0.9);
    border-color: rgba(121, 90, 150, 0.45);
  }

  /* Dawn theme text colors are handled by CSS variables */
</style>
