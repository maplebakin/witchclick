---
import type { TypeMetadataEntry } from "../data/typeMetadata";
import { resolveTailwindColor, mixColors, toRgba } from "../utils/color";
import { toCssVariables } from "../utils/style";

export interface Props {
  type: string;
  slug: string;
  name: string;
  summary?: string;
  tags?: string[];
  variant?: "default" | "grimoire";
  isStub?: boolean;
  theme?: TypeMetadataEntry;
}

const {
  type,
  slug,
  name,
  summary = "",
  tags = [],
  variant = "default",
  isStub = false,
  theme = undefined,
} = Astro.props as Props;

const summaryText = typeof summary === "string" ? summary.trim() : "";
const stubFromSummary = summaryText ? /stub entity/i.test(summaryText) : false;
const showStubBadge = variant === "grimoire" && (isStub || stubFromSummary);

const keywords = Array.isArray(tags)
  ? Array.from(
      new Map(
        tags
          .map((tag) => (typeof tag === "string" ? tag.trim() : ""))
          .filter(Boolean)
          .map((tag) => [tag.toLowerCase(), tag])
      ).values()
    )
  : [];

const accentHex = resolveTailwindColor(theme?.themeColor ?? "violet-500");
const accentBorder = toRgba(accentHex, 0.28);
const accentSurface = toRgba(accentHex, 0.1);
const accentOverlay = toRgba(accentHex, 0.22);
const accentLabel = toRgba(accentHex, 0.6);
const accentHeading = "var(--theme-text-strong, var(--text-strong))";
const accentSummary = "var(--theme-text-body, var(--text-body))";
const accentKeywordBg = toRgba(accentHex, 0.16);
const accentKeywordBorder = toRgba(accentHex, 0.35);
const accentKeywordText = mixColors(accentHex, "#111827", 0.35);
const accentBadgeBg = toRgba(accentHex, 0.2);
const accentBadgeBorder = toRgba(accentHex, 0.38);
const accentBadgeText = mixColors(accentHex, "#111827", 0.3);
const accentPlaceholder = "var(--theme-text-muted, var(--text-muted))";
const accentStar = toRgba(accentHex, 0.35);

const cardGradientClass = theme?.cardStyleClass ?? "from-gradient-default-start/20 to-gradient-default-end/40";
const stubLine = theme?.stubLine ?? "Lore pending — the scribes are still etching this entry.";

const themeVarString = toCssVariables({
  "entity-border": accentBorder,
  "entity-surface": accentSurface,
  "entity-overlay": accentOverlay,
  "entity-label": accentLabel,
  "entity-heading": accentHeading,
  "entity-summary": accentSummary,
  "entity-keyword-bg": accentKeywordBg,
  "entity-keyword-border": accentKeywordBorder,
  "entity-keyword-text": accentKeywordText,
  "entity-badge-bg": accentBadgeBg,
  "entity-badge-border": accentBadgeBorder,
  "entity-badge-text": accentBadgeText,
  "entity-placeholder": accentPlaceholder,
  "entity-star": accentStar,
});

const displaySummary = variant === "grimoire" ? (stubFromSummary ? "" : summaryText) : summaryText;
const placeholderSummary = variant === "grimoire" && showStubBadge ? stubLine : "";
const summaryContent = displaySummary || placeholderSummary;

const typeLabel =
  variant === "grimoire"
    ? type
        .split(/[-_\s]+/)
        .filter((part): part is string => Boolean(part && part.trim()))
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(" ")
    : type;
---
{variant === "grimoire" ? (
  <a
    href={`/entities/${type}/${slug}`}
    class:list={[
      "focus-ring",
      "entity-card relative block overflow-hidden rounded-3xl border bg-gradient-to-br via-surface-base/80 p-6 shadow-[0_20px_45px_-25px_rgba(15,23,42,0.35)] transition-transform duration-300 hover:-translate-y-1 hover:shadow-[0_25px_60px_-30px_rgba(15,23,42,0.45)]",
      cardGradientClass,
      showStubBadge && "opacity-60",
    ]}
    style={themeVarString ? `${themeVarString};` : undefined}
  >
    <span aria-hidden class="entity-card-overlay pointer-events-none absolute inset-0" />
    <span aria-hidden class="entity-card-orb pointer-events-none absolute -top-8 right-8 h-28 w-28 rounded-full border" />
    <span
      aria-hidden
      class="entity-card-glow pointer-events-none absolute bottom-0 left-0 h-24 w-24 -translate-x-10 translate-y-12 rotate-12"
    />
    <span aria-hidden class="entity-card-star pointer-events-none absolute top-5 right-6 text-4xl">✶</span>

    <div class="relative z-10 flex flex-col gap-4">
      <div class="flex items-start justify-start gap-3 flex-wrap">
  <span class="entity-card-label text-xs uppercase">{typeLabel}</span>
  {showStubBadge && (
    <span class="entity-card-badge rounded-full border px-3 py-1 text-[11px] font-semibold uppercase tracking-wide shadow-sm">
      Stub — coming soon
    </span>
  )}
</div>


      <div class="space-y-3">
        <h3 class="entity-card-title text-2xl font-serif tracking-wide drop-shadow-[0_1px_0_rgba(255,255,255,0.6)]">
          {name}
        </h3>
        {summaryContent && (
          <p class:list={["entity-card-summary text-sm italic", showStubBadge && !displaySummary ? "entity-card-placeholder" : ""]}>
            {summaryContent}
          </p>
        )}
      </div>

      {keywords.length > 0 ? (
        <div class="mt-auto flex flex-wrap gap-2">
          {keywords.map((tag) => (
            <span class="card-pill card-tag entity-card-tag">{tag}</span>
          ))}
        </div>
      ) : (
        showStubBadge && <p class="entity-card-empty-keywords mt-auto text-xs uppercase tracking-[0.25em]">Keywords forthcoming</p>
      )}
    </div>
  </a>
) : (
  <a href={`/entities/${type}/${slug}`} class="card-panel card-tier-1 card-panel-soft focus-visible:outline-none group">
    <span aria-hidden class="card-radial card-radial-bottom" />
    <div class="card-body">
      <div class="card-eyebrow">{type}</div>
      <h3 class="card-heading">{name}</h3>
      {displaySummary && <p class="card-subtle">{displaySummary}</p>}
    </div>
  </a>
)}

<style>
  .entity-card {
    background-color: var(--entity-surface, var(--theme-surface-base));
    border-color: var(--entity-border, color-mix(in srgb, var(--theme-color-amethyst) 28%, transparent));
    overflow: hidden; /* <-- stop clipping */
    height: auto; /* <-- let content determine height */
  }

  .entity-card-overlay {
    background: radial-gradient(circle at top, var(--entity-overlay, color-mix(in srgb, var(--theme-color-amethyst) 22%, transparent)), transparent 65%);
  }

  .entity-card-orb {
    border-color: var(--entity-border, rgba(124, 58, 237, 0.22));
    background: radial-gradient(circle at top, var(--entity-overlay, rgba(124, 58, 237, 0.22)), transparent 70%);
    filter: blur(2px);
  }

  .entity-card-glow {
    background: linear-gradient(135deg, var(--entity-overlay, color-mix(in srgb, var(--theme-color-amethyst) 18%, transparent)) 0%, transparent 80%);
  }

  .entity-card-star {
    color: var(--entity-star, color-mix(in srgb, var(--theme-color-amethyst) 40%, transparent));
  }

    .entity-card-label {
    color: var(--entity-label, color-mix(in srgb, var(--theme-color-amethyst) 65%, transparent));
    letter-spacing: 0.18em;   /* gentle, still “label-y” but not absurd */
    font-size: 0.7rem;        /* slightly small to keep it compact */
    overflow-wrap: anywhere;
    word-break: break-word;
    max-width: 100%;
    display: inline-block;
  }

  .entity-card-badge {
    background: var(--entity-badge-bg, color-mix(in srgb, var(--theme-color-amethyst) 18%, transparent));
    border-color: var(--entity-badge-border, color-mix(in srgb, var(--theme-color-amethyst) 35%, transparent));
    color: var(--entity-badge-text, color-mix(in srgb, var(--theme-color-amethyst) 85%, transparent));
  }

  .entity-card-title {
    color: var(--entity-heading, var(--theme-text-strong, var(--text-strong)));
  }

  .entity-card-summary {
    color: var(--entity-summary, var(--theme-text-body, var(--text-body)));
    line-height: 1.5;
    overflow: visible;
    text-overflow: clip;
    display: block;
    -webkit-line-clamp: unset;
    -webkit-box-orient: unset;
  }

  .entity-card-placeholder {
    color: var(--entity-placeholder, var(--theme-text-muted, var(--text-muted)));
  }

  .entity-card-tag {
    --card-pill-text: var(--entity-keyword-text, rgba(88, 28, 135, 0.85));
    --card-pill-bg: var(--entity-keyword-bg, color-mix(in srgb, var(--theme-color-amethyst) 16%, transparent));
    --card-pill-border: var(--entity-keyword-border, color-mix(in srgb, var(--theme-color-amethyst) 35%, transparent));
  }

  .entity-card-empty-keywords {
    color: var(--entity-placeholder, var(--theme-text-muted, var(--text-muted)));
  }
</style>
