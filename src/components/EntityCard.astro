---
export interface Props {
type: string;
slug: string;
name: string;
summary?: string;
}
const { type, slug, name, summary = '' } = Astro.props as Props;
---
<a
  href={`/entities/${type}/${slug}`}
  class="surface-card group block h-full transform transition hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-200/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-300"
>
  <p class="eyebrow text-purple-400/90">{type}</p>
  <h3 class="mt-3 text-lg font-semibold text-purple-900 transition group-hover:text-purple-950">{name}</h3>
  {summary && <p class="mt-3 text-sm leading-relaxed text-purple-700/90">{summary}</p>}
</a>