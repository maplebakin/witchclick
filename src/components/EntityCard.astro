---
import type { TypeMetadataEntry } from "../data/typeMetadata";
import { toCssVariables } from "../utils/style";

export interface Props {
  type: string;
  slug: string;
  name: string;
  summary?: string;
  tags?: string[];
  variant?: "default" | "grimoire";
  isStub?: boolean;
  theme?: TypeMetadataEntry;
}

const {
  type,
  slug,
  name,
  summary = "",
  tags = [],
  variant = "default",
  isStub = false,
  theme = undefined,
} = Astro.props as Props;

function stripInlineMarkdown(value: string): string {
  return value
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[`*_~]+/g, "")
    .trim();
}

const summaryText = typeof summary === "string" ? stripInlineMarkdown(summary) : "";
const stubFromSummary = summaryText ? /stub entity/i.test(summaryText) : false;
const showStubBadge = variant === "grimoire" && (isStub || stubFromSummary);

const keywords = Array.isArray(tags)
  ? Array.from(
      new Map(
        tags
          .map((tag) => (typeof tag === "string" ? tag.trim() : ""))
          .filter(Boolean)
          .map((tag) => [tag.toLowerCase(), tag])
      ).values()
    )
  : [];

const accentTone = "var(--theme-color-gold, var(--theme-text-accent, var(--text-accent)))";
const accentBorder = `color-mix(in srgb, ${accentTone} 24%, transparent)`;
const accentSurface = "var(--theme-surface-panel, var(--surface-panel))";
const accentOverlay = `color-mix(in srgb, ${accentTone} 16%, transparent)`;
const accentLabel = "var(--theme-text-subtle, var(--text-muted))";
const accentHeading = "var(--theme-text-strong, var(--text-strong))";
const accentSummary = "var(--theme-text-body, var(--text-body))";
const accentKeywordBg = `color-mix(in srgb, ${accentTone} 12%, transparent)`;
const accentKeywordBorder = `color-mix(in srgb, ${accentTone} 24%, transparent)`;
const accentKeywordText = "var(--theme-text-accent, var(--text-accent))";
const accentBadgeBg = `color-mix(in srgb, ${accentTone} 14%, transparent)`;
const accentBadgeBorder = `color-mix(in srgb, ${accentTone} 26%, transparent)`;
const accentBadgeText = "var(--theme-text-accent, var(--text-accent))";
const accentPlaceholder = "var(--theme-text-muted, var(--text-muted))";

const cardGradientClass = theme?.cardStyleClass ?? "from-gradient-default-start/20 to-gradient-default-end/40";
const stubLine = theme?.stubLine ?? "Entry in progress — this reference is still being drafted.";

const themeVarString = toCssVariables({
  "entity-border": accentBorder,
  "entity-surface": accentSurface,
  "entity-overlay": accentOverlay,
  "entity-label": accentLabel,
  "entity-heading": accentHeading,
  "entity-summary": accentSummary,
  "entity-keyword-bg": accentKeywordBg,
  "entity-keyword-border": accentKeywordBorder,
  "entity-keyword-text": accentKeywordText,
  "entity-badge-bg": accentBadgeBg,
  "entity-badge-border": accentBadgeBorder,
  "entity-badge-text": accentBadgeText,
  "entity-placeholder": accentPlaceholder,
});

const displaySummary = variant === "grimoire" ? (stubFromSummary ? "" : summaryText) : summaryText;
const placeholderSummary = variant === "grimoire" && showStubBadge ? stubLine : "";
const summaryContent = displaySummary || placeholderSummary;

const typeLabel =
  variant === "grimoire"
    ? type
        .split(/[-_\s]+/)
        .filter((part): part is string => Boolean(part && part.trim()))
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(" ")
    : type;
---
{variant === "grimoire" ? (
  <a
    href={`/entities/${type}/${slug}`}
    class:list={[
      "focus-ring",
      "entity-card relative block h-full overflow-hidden rounded-xl border bg-gradient-to-br via-surface-base/80 p-6 shadow-[0_12px_30px_-24px_hsl(var(--neutral-8)_/_0.28)] transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-[0_16px_38px_-26px_hsl(var(--neutral-8)_/_0.34)]",
      cardGradientClass,
      showStubBadge && "opacity-60",
    ]}
    style={themeVarString ? `${themeVarString};` : undefined}
  >
    <span aria-hidden class="entity-card-overlay pointer-events-none absolute inset-0" />

    <div class="entity-card-inner relative z-10 flex h-full flex-col gap-4">
      <div class="flex items-start justify-start gap-3 flex-wrap">
  <span class="entity-card-label text-[0.8rem] uppercase">{typeLabel}</span>
  {showStubBadge && (
    <span class="entity-card-badge rounded-full border px-3 py-1 text-[0.8rem] font-semibold uppercase tracking-wide shadow-sm">
      Stub — coming soon
    </span>
  )}
</div>

      <div class="entity-card-copy flex flex-1 flex-col space-y-3">
        <h3 class="entity-card-title text-2xl font-serif tracking-wide">
          {name}
        </h3>
        {summaryContent && (
          <p class:list={["entity-card-summary text-sm", showStubBadge && !displaySummary ? "entity-card-placeholder" : ""]}>
            {summaryContent}
          </p>
        )}
      </div>

      {keywords.length > 0 ? (
        <div class="entity-card-keywords mt-auto flex flex-wrap gap-2">
          {keywords.map((tag) => (
            <span class="card-pill card-tag entity-card-tag">{tag}</span>
          ))}
        </div>
      ) : (
        showStubBadge && <p class="entity-card-empty-keywords mt-auto text-[0.8rem] uppercase tracking-[0.25em]">Keywords forthcoming</p>
      )}
    </div>
  </a>
) : (
  <a href={`/entities/${type}/${slug}`} class="card-panel card-tier-1 card-panel-soft focus-visible:outline-none group">
    <span aria-hidden class="card-radial card-radial-bottom" />
    <div class="card-body">
      <div class="card-eyebrow">{type}</div>
      <h3 class="card-heading">{name}</h3>
      {displaySummary && <p class="card-subtle">{displaySummary}</p>}
    </div>
  </a>
)}

<style>
  .entity-card {
    background-color: var(--entity-surface, var(--theme-surface-panel, var(--surface-panel)));
    border-color: var(--entity-border, color-mix(in srgb, var(--theme-color-gold) 24%, transparent));
    overflow: hidden;
    height: 100%;
  }

  .entity-card-overlay {
    background: linear-gradient(180deg, var(--entity-overlay, color-mix(in srgb, var(--theme-color-gold) 8%, transparent)), transparent 58%);
    opacity: 0.45;
  }

    .entity-card-label {
    color: var(--entity-label, var(--theme-text-subtle, var(--text-muted)));
    letter-spacing: 0.18em;   /* gentle, still “label-y” but not absurd */
    font-size: 0.8rem;        /* slightly small to keep it compact */
    overflow-wrap: anywhere;
    word-break: break-word;
    max-width: 100%;
    display: inline-block;
  }

  .entity-card-badge {
    background: var(--entity-badge-bg, color-mix(in srgb, var(--theme-color-gold) 14%, transparent));
    border-color: var(--entity-badge-border, color-mix(in srgb, var(--theme-color-gold) 26%, transparent));
    color: var(--entity-badge-text, var(--theme-text-accent, var(--text-accent)));
  }

  .entity-card-title {
    color: var(--entity-heading, var(--theme-text-strong, var(--text-strong)));
  }

  .entity-card-copy {
    min-height: 0;
  }

  .entity-card-summary {
    color: var(--entity-summary, var(--theme-text-body, var(--text-body)));
    line-height: 1.5;
    font-style: normal;
    flex: 1 1 auto;
    overflow: visible;
    text-overflow: clip;
    display: block;
    -webkit-line-clamp: unset;
    -webkit-box-orient: unset;
  }

  .entity-card-placeholder {
    color: var(--entity-placeholder, var(--theme-text-muted, var(--text-muted)));
  }

  .entity-card-tag {
    --card-pill-text: var(--entity-keyword-text, hsl(var(--accent-ink) / 0.85));
    --card-pill-bg: var(--entity-keyword-bg, color-mix(in srgb, var(--theme-color-gold) 12%, transparent));
    --card-pill-border: var(--entity-keyword-border, color-mix(in srgb, var(--theme-color-gold) 24%, transparent));
  }

  .entity-card-empty-keywords {
    color: var(--entity-placeholder, var(--theme-text-muted, var(--text-muted)));
  }
</style>
