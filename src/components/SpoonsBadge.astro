---
import { randomUUID } from "node:crypto";
import type { SpoonLevel } from "../utils/augment";

export interface Props {
  level?: string | SpoonLevel;
  class?: string;
}

const { level, class: className } = Astro.props as Props;

const normalized = typeof level === "string" ? level.trim().toLowerCase() : "";
const validLevels: SpoonLevel[] = ["low", "medium", "high"];
const spoonLevel = validLevels.includes(normalized as SpoonLevel)
  ? (normalized as SpoonLevel)
  : undefined;

const meta: Record<SpoonLevel, { label: string; tooltip: string }> = {
  low: { label: "Low spoons", tooltip: "Low spoons: quick read/short ritual" },
  medium: { label: "Medium spoons", tooltip: "Medium spoons: moderate time/energy" },
  high: { label: "High spoons", tooltip: "High spoons: deep read or multi-step ritual" },
};

const tooltipId = spoonLevel ? `spoons-tip-${randomUUID().slice(0, 8)}` : "";
---
{spoonLevel && (
  <span
    class:list={["card-spoon", "spoons-badge", spoonLevel && `spoons-badge--${spoonLevel}`, className]}
    data-spoon-level={spoonLevel}
    tabindex="0"
    aria-describedby={tooltipId}
  >
    <span class="spoons-badge__dot" aria-hidden="true" />
    <span class="spoons-badge__text">{meta[spoonLevel].label}</span>
    <span id={tooltipId} role="tooltip" class="spoons-badge__tooltip">
      {meta[spoonLevel].tooltip}
    </span>
  </span>
)}

<style>
  .spoons-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: default;
    outline: none;
  }

  .spoons-badge:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent-purple-strong) 65%, transparent);
    outline-offset: 2px;
  }

  .spoons-badge__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--card-spoon-text, #ede9fe) 88%, transparent 12%);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--card-spoon-border, rgba(124, 58, 237, 0.35)) 75%, transparent 25%);
  }

  .spoons-badge__text {
    letter-spacing: 0.14em;
  }

  .spoons-badge__tooltip {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.35rem);
    transform: translate(-50%, -0.3rem);
    width: max-content;
    max-width: 220px;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    font-size: 0.65rem;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text-body);
    background: color-mix(in srgb, var(--surface-card) 85%, var(--accent-purple-soft) 15%);
    border: 1px solid color-mix(in srgb, var(--accent-purple-soft) 20%, transparent);
    box-shadow: 0 10px 28px -22px rgba(17, 24, 39, 0.55);
    pointer-events: none;
    opacity: 0;
    transition: opacity 150ms ease, transform 150ms ease;
    z-index: 10;
  }

  .spoons-badge:hover .spoons-badge__tooltip,
  .spoons-badge:focus-visible .spoons-badge__tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .spoons-badge__tooltip::after {
    content: "";
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: inherit;
    border-left: inherit;
    border-top: inherit;
  }

  .spoons-badge--low .spoons-badge__dot {
    background: color-mix(in srgb, rgba(116, 198, 178, 0.25) 80%, transparent 20%);
    box-shadow: inset 0 0 0 2px rgba(116, 198, 178, 0.45);
  }

  .spoons-badge--medium .spoons-badge__dot {
    background: color-mix(in srgb, rgba(212, 175, 55, 0.25) 80%, transparent 20%);
    box-shadow: inset 0 0 0 2px rgba(212, 175, 55, 0.48);
  }

  .spoons-badge--high .spoons-badge__dot {
    background: color-mix(in srgb, rgba(226, 110, 154, 0.25) 80%, transparent 20%);
    box-shadow: inset 0 0 0 2px rgba(226, 110, 154, 0.48);
  }
</style>
