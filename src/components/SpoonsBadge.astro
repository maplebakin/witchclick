---
import type { SpoonLevel } from "../utils/augment";

export interface Props {
  level?: string | SpoonLevel;
  class?: string;
}

const { level, class: className } = Astro.props as Props;

const normalized = typeof level === "string" ? level.trim().toLowerCase() : "";
const validLevels: SpoonLevel[] = ["low", "medium", "high"];
const spoonLevel = validLevels.includes(normalized as SpoonLevel)
  ? (normalized as SpoonLevel)
  : undefined;

const meta: Record<SpoonLevel, { label: string; tooltip: string }> = {
  low: { label: "Low spoons", tooltip: "Low spoons: quick read/short ritual" },
  medium: { label: "Medium spoons", tooltip: "Medium spoons: moderate time/energy" },
  high: { label: "High spoons", tooltip: "High spoons: deep read or multi-step ritual" },
};

---
{spoonLevel && (
  <span
    class:list={["card-spoon", "spoons-badge", spoonLevel && `spoons-badge--${spoonLevel}`, className]}
    data-spoon-level={spoonLevel}
    aria-label={meta[spoonLevel].tooltip}
  >
    <span class="spoons-badge__dot" aria-hidden="true" />
    <span class="spoons-badge__text">{meta[spoonLevel].label}</span>
    <span aria-hidden="true" class="spoons-badge__tooltip">
      {meta[spoonLevel].tooltip}
    </span>
  </span>
)}

<style>
  .spoons-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: default;
    outline: none;
  }

  .spoons-badge__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--spoon-color, var(--text-muted));
    box-shadow: none;
  }

  .spoons-badge__text {
    letter-spacing: 0.14em;
  }

  .spoons-badge__tooltip {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.35rem);
    transform: translate(-50%, -0.3rem);
    width: max-content;
    max-width: 220px;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    font-size: 0.8rem;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text-body);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 10px 28px -22px hsl(var(--neutral-8) / 0.55);
    pointer-events: none;
    opacity: 0;
    transition: opacity 150ms ease, transform 150ms ease;
    z-index: 10;
  }

  .spoons-badge:hover .spoons-badge__tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .spoons-badge__tooltip::after {
    content: "";
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: inherit;
    border-left: inherit;
    border-top: inherit;
  }

  .spoons-badge--low {
    --spoon-color: var(--spoon-low, var(--text-muted));
  }

  .spoons-badge--medium {
    --spoon-color: var(--spoon-medium, var(--text-muted));
  }

  .spoons-badge--high {
    --spoon-color: var(--spoon-high, var(--text-muted));
  }

  /* One/two/three dots in the existing slot: effort also reads without hue. */
  .spoons-badge--medium .spoons-badge__dot {
    background:
      radial-gradient(circle at 20% 50%, var(--spoon-color) 0 1.5px, transparent 1.6px),
      radial-gradient(circle at 80% 50%, var(--spoon-color) 0 1.5px, transparent 1.6px);
  }

  .spoons-badge--high .spoons-badge__dot {
    background:
      radial-gradient(circle at 50% 20%, var(--spoon-color) 0 1.5px, transparent 1.6px),
      radial-gradient(circle at 20% 80%, var(--spoon-color) 0 1.5px, transparent 1.6px),
      radial-gradient(circle at 80% 80%, var(--spoon-color) 0 1.5px, transparent 1.6px);
  }
</style>
