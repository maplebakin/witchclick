---
import { loadAllPosts } from "@/utils/posts";
import { postToCardData } from "@/utils/postTransforms";
import { canonicalizeTagSlug } from "@/utils/tags";

interface PlaylistPost {
  slug: string;
  title: string;
  excerpt: string;
  href: string;
  chips: string[];
}

interface Props {
  title: string;
  description: string;
  groupChips: string[];
  posts: PlaylistPost[];
  maxChipsPerCard?: number;
}

const { title, description, groupChips, posts, maxChipsPerCard = 3 } = Astro.props as Props;
const headingId = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-') || 'playlist'}-heading`;
const primaryChip = groupChips[0] ?? "";
const primaryChipCanonical = canonicalizeTagSlug(primaryChip);

const fallbackPosts: PlaylistPost[] =
  posts.length === 0 && primaryChipCanonical
    ? loadAllPosts()
        .map((post) => postToCardData(post))
        .filter((card) =>
          card.tags.some((tag) => canonicalizeTagSlug(tag) === primaryChipCanonical),
        )
        .slice(0, 4)
        .map((card) => ({
          slug: card.slug,
          title: card.title,
          excerpt: card.tldr ?? card.excerpt ?? "",
          href: `/post/${card.slug}`,
          chips: card.tags,
        }))
    : [];

const visiblePosts = posts.length > 0 ? posts : fallbackPosts;
---
{visiblePosts.length > 0 && (
  <section class="hub-playlist" aria-labelledby={headingId}>
    <header class="hub-playlist__header">
      <div>
        <h2 id={headingId} class="hub-playlist__title">
          {title}
        </h2>
        <p class="hub-playlist__description">{description}</p>
      </div>
      {groupChips.length > 0 && (
        <ul class="hub-playlist__chips">
          {groupChips.map((chip) => (
            <li>{chip}</li>
          ))}
        </ul>
      )}
    </header>
    <div class="hub-playlist__grid">
      {visiblePosts.map((post) => (
        <a class="hub-playlist__card" href={post.href}>
          <span class="hub-playlist__card-title">{post.title}</span>
          {post.excerpt && <span class="hub-playlist__card-excerpt">{post.excerpt}</span>}
          {post.chips.length > 0 && (
            <ul class="hub-playlist__card-chips">
              {post.chips.slice(0, maxChipsPerCard).map((chip) => (
                <li>{chip}</li>
              ))}
              {post.chips.length > maxChipsPerCard && (
                <li class="hub-playlist__chip-overflow">
                  +{post.chips.length - maxChipsPerCard}
                </li>
              )}
            </ul>
          )}
        </a>
      ))}
    </div>
  </section>
)}

<style is:inline>
  .hub-playlist {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    --hub-playlist-card-surface: var(--surface-card-dark);
    --hub-playlist-card-border: color-mix(in srgb, var(--theme-color-gold) 32%, var(--theme-color-iris) 24%);
    --hub-playlist-card-border-hover: color-mix(in srgb, var(--theme-color-gold) 45%, transparent 55%);
    --hub-playlist-card-shadow: var(--theme-shadow-soft);
    --hub-playlist-card-shadow-hover: var(--theme-shadow-strong);
  }

  .hub-playlist__header {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hub-playlist__title {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    letter-spacing: 0.16em;
  }

  .hub-playlist__description {
    margin: 0;
    max-width: 52ch;
    color: var(--theme-text-body);
    font-size: 1rem;
    line-height: 1.6;
  }

  .hub-playlist__chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hub-playlist__chips li {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border-chip-accent);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hub-playlist__grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .hub-playlist__card {
    display: grid;
    gap: 0.55rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    border-radius: 1.4rem;
    border: 1px solid var(--hub-playlist-card-border);
    background: var(--hub-playlist-card-surface);
    text-decoration: none;
    color: var(--theme-text-strong);
    box-shadow: var(--hub-playlist-card-shadow);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .hub-playlist__card:hover,
  .hub-playlist__card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--hub-playlist-card-border-hover);
    box-shadow: var(--hub-playlist-card-shadow-hover);
  }

  .hub-playlist__card-title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .hub-playlist__card-excerpt {
    color: var(--theme-text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .hub-playlist__card-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hub-playlist__card-chips li {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--surface-chip-accent);
    color: var(--theme-text-body);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hub-playlist__chip-overflow {
    background: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 24%, transparent 76%) !important;
    color: var(--theme-text-strong);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .hub-playlist__header {
      gap: 0.6rem;
    }

    .hub-playlist__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
