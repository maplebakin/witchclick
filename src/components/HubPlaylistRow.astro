---
interface PlaylistPost {
  slug: string;
  title: string;
  excerpt: string;
  href: string;
  chips: string[];
}

interface Props {
  title: string;
  description: string;
  groupChips: string[];
  posts: PlaylistPost[];
  maxChipsPerCard?: number;
}

const { title, description, groupChips, posts, maxChipsPerCard = 3 } = Astro.props as Props;
const headingId = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-') || 'playlist'}-heading`;
---
<section class="hub-playlist" aria-labelledby={headingId}>
  <header class="hub-playlist__header">
    <div>
      <h2 id={headingId} class="hub-playlist__title">
        {title}
      </h2>
      <p class="hub-playlist__description">{description}</p>
    </div>
    {groupChips.length > 0 && (
      <ul class="hub-playlist__chips">
        {groupChips.map((chip) => (
          <li>{chip}</li>
        ))}
      </ul>
    )}
  </header>
  <div class="hub-playlist__grid">
    {posts.map((post) => (
      <a class="hub-playlist__card" href={post.href}>
        <span class="hub-playlist__card-title">{post.title}</span>
        {post.excerpt && <span class="hub-playlist__card-excerpt">{post.excerpt}</span>}
        {post.chips.length > 0 && (
          <ul class="hub-playlist__card-chips">
            {post.chips.slice(0, maxChipsPerCard).map((chip) => (
              <li>{chip}</li>
            ))}
            {post.chips.length > maxChipsPerCard && (
              <li class="hub-playlist__chip-overflow">
                +{post.chips.length - maxChipsPerCard}
              </li>
            )}
          </ul>
        )}
      </a>
    ))}
  </div>
</section>

<style is:inline>
  .hub-playlist {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .hub-playlist__header {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hub-playlist__title {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hub-playlist__description {
    margin: 0;
    max-width: 52ch;
    color: rgba(249, 245, 255, 0.78);
    font-size: 1rem;
    line-height: 1.6;
  }

  .hub-playlist__chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hub-playlist__chips li {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.32);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hub-playlist__grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .hub-playlist__card {
    display: grid;
    gap: 0.55rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    border-radius: 1.4rem;
    border: 1px solid rgba(124, 78, 176, 0.28);
    background: rgba(12, 5, 23, 0.82);
    text-decoration: none;
    color: inherit;
    box-shadow: 0 18px 48px -30px rgba(8, 5, 18, 0.65);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .hub-playlist__card:hover,
  .hub-playlist__card:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 55, 0.45);
    box-shadow: 0 22px 55px -28px rgba(12, 7, 26, 0.7);
  }

  .hub-playlist__card-title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .hub-playlist__card-excerpt {
    color: rgba(249, 245, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .hub-playlist__card-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hub-playlist__card-chips li {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.15);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hub-playlist__chip-overflow {
    background: rgba(124, 78, 176, 0.2) !important;
    font-weight: 600;
  }

  :root[data-comfort-theme="dawn"] .hub-playlist__description {
    color: rgba(87, 63, 115, 0.75);
  }

  :root[data-comfort-theme="dawn"] .hub-playlist__chips li {
    border-color: rgba(155, 134, 200, 0.45);
  }

  :root[data-comfort-theme="dawn"] .hub-playlist__card {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(180, 154, 217, 0.3);
    box-shadow: 0 18px 42px -28px rgba(83, 63, 112, 0.35);
    color: rgba(58, 40, 84, 0.9);
  }

  :root[data-comfort-theme="dawn"] .hub-playlist__card:hover,
  :root[data-comfort-theme="dawn"] .hub-playlist__card:focus-visible {
    border-color: rgba(212, 175, 55, 0.45);
  }

  :root[data-comfort-theme="dawn"] .hub-playlist__card-excerpt {
    color: rgba(87, 63, 115, 0.65);
  }

  :root[data-comfort-theme="dawn"] .hub-playlist__card-chips li {
    background: rgba(186, 166, 220, 0.25);
    color: rgba(87, 63, 115, 0.75);
  }

  :root[data-comfort-theme="dawn"] .hub-playlist__chip-overflow {
    background: rgba(155, 134, 200, 0.35) !important;
  }

  @media (max-width: 640px) {
    .hub-playlist__header {
      gap: 0.6rem;
    }

    .hub-playlist__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
