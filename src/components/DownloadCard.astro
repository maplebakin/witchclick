---
import fs from 'node:fs';
interface Props { id?: string }
const { id = '' } = Astro.props as Props;
if (!id) { return; }

const dir = './content/downloads';
let data: any = null;
try {
  const files = fs.readdirSync(dir).filter(f => f.endsWith('.json'));
  for (const f of files) {
    const j = JSON.parse(fs.readFileSync(`${dir}/${f}`,'utf8'));
    if (j.id === id || j.slug === id) { data = j; break; }
  }
} catch {}

if (!data || data.published === false) { return; }
const hasExternal = !!(data.url && data.url.trim());
const rawHref = hasExternal ? data.url : (data.file || '');
const href = /^(?:https?:\/\/|\/)/i.test(rawHref) ? rawHref : '';
if (!href) { return; }
const target = hasExternal ? '_blank' : undefined;
const rel = hasExternal ? 'sponsored nofollow noopener noreferrer' : undefined;
---
<aside class="my-8">
  <div class="card-panel card-tier-2 card-panel-strong card-panel-static">
    <span aria-hidden class="card-radial card-radial-soft" />
    <div class="relative z-10 flex flex-col gap-5 sm:flex-row sm:items-start">
      {data.cover && (
        <img
          src={data.cover}
          alt={`${data.name} cover`}
          class="h-24 w-24 flex-none rounded-xl border border-line-contrast/60 object-cover shadow-sm"
          loading="lazy"
        />
      )}
      <div class="min-w-0 space-y-4">
        <header class="space-y-2">
          <p class="card-eyebrow">Download</p>
          <h3 class="card-heading text-xl font-semibold">{data.name}</h3>
        </header>
        {data.summary && <p class="card-subtle text-sm leading-relaxed">{data.summary}</p>}
        {Array.isArray(data.features) && data.features.length > 0 && (
          <ul class="grid gap-2 text-sm text-primary/90 sm:list-none sm:gap-1">
            {data.features.slice(0, 3).map((f: string) => (
              <li class="flex items-start gap-2">
                <span aria-hidden class="mt-1 text-[0.8rem] text-accent">✶</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="flex flex-wrap items-center gap-3">
          <span class="card-pill card-badge">
            {(data.price && data.currency)
              ? new Intl.NumberFormat(undefined, { style: "currency", currency: data.currency }).format(
                  parseFloat(data.price)
                )
              : "Free"}
          </span>
          <a
            href={href}
            target={target}
            rel={rel}
            class="inline-flex items-center justify-center rounded-full bg-surface-accent-bolder px-4 py-2 text-sm font-semibold text-inverse transition hover:bg-surface-accent-deep focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus-soft focus-visible:ring-offset-2"
            data-analytics="download_click"
            data-analytics-meta={data.id}
          >
            {hasExternal ? "Browse options" : "Open download"}
          </a>
          <a
            href="/tools"
            class="text-sm font-semibold text-secondary underline-offset-4 transition hover:text-primary hover:underline"
          >
            Browse tools
          </a>
        </div>
      </div>
    </div>
  </div>
</aside>
