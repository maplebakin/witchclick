---
interface Props {
  href?: string;
  target?: string;
  rel?: string;
  dataAffiliate?: boolean;
  type?: "button" | "submit" | "reset";
  size?: "md" | "sm";
  iconAfter?: string;
  iconBefore?: string;
}

const {
  href,
  target,
  rel,
  dataAffiliate = false,
  type = "button",
  size = "md",
  iconAfter = "",
  iconBefore = "",
} = Astro.props as Props;

const classes = ["wc-button", "focus-ring", size === "sm" ? "wc-button--sm" : ""].filter(Boolean).join(" ");

let computedRel = rel ?? undefined;
if (target === "_blank") {
  if (computedRel) {
    computedRel = computedRel.includes("noopener") ? computedRel : `${computedRel} noopener`;
  } else {
    computedRel = "noopener";
  }
}
---
{href ? (
  <a
    class={classes}
    href={href}
    target={target}
    rel={computedRel}
    data-affiliate={dataAffiliate ? "true" : undefined}
  >
    {iconBefore && <span aria-hidden="true" class="wc-button__icon">{iconBefore}</span>}
    <span class="wc-button__label">
      <slot />
    </span>
    {iconAfter && <span aria-hidden="true" class="wc-button__icon">{iconAfter}</span>}
  </a>
) : (
  <button class={classes} type={type}>
    {iconBefore && <span aria-hidden="true" class="wc-button__icon">{iconBefore}</span>}
    <span class="wc-button__label">
      <slot />
    </span>
    {iconAfter && <span aria-hidden="true" class="wc-button__icon">{iconAfter}</span>}
  </button>
)}

<style>
  .wc-button {
    --btn-bg: color-mix(in srgb, var(--surface-panel-primary) 78%, var(--text-accent, var(--theme-color-gold)) 22%);
    --btn-bg-hover: color-mix(in srgb, var(--surface-panel-primary) 72%, var(--text-accent, var(--theme-color-gold)) 28%);
    --btn-text: var(--theme-text-strong);
    --btn-border: color-mix(in srgb, var(--border-accent-strong) 40%, transparent 60%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: calc(var(--space-2) + 0.15rem) var(--space-4);
    border-radius: var(--radius-2, 0.75rem);
    border: 1px solid var(--btn-border);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    box-shadow: 0 14px 32px -26px color-mix(in srgb, var(--color-night, var(--surface-panel)) 54%, transparent 46%);
    transition: background 160ms ease, transform 160ms ease, color 160ms ease, border-color 160ms ease, box-shadow 200ms ease;
    text-decoration: none;
  }

  .wc-button:hover,
  .wc-button:focus-visible {
    background: var(--btn-bg-hover);
    color: var(--btn-text);
    border-color: color-mix(in srgb, var(--border-accent-strong) 60%, transparent 40%);
    box-shadow: 0 18px 40px -28px color-mix(in srgb, var(--color-night, var(--surface-panel)) 48%, transparent 52%);
  }

  .wc-button:active {
    transform: translateY(1px);
  }

  .wc-button--sm {
    padding: var(--space-1) var(--space-3);
    font-size: 0.85rem;
  }

  .wc-button__label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .wc-button__icon {
    font-size: 0.95em;
    line-height: 1;
  }

  :global(:root[data-comfort-theme="dawn"]) .wc-button {
    --btn-bg: color-mix(in srgb, var(--theme-text-strong) 14%, var(--text-accent, var(--theme-color-gold)) 86%);
    --btn-bg-hover: color-mix(in srgb, var(--theme-text-strong) 20%, var(--text-accent, var(--theme-color-gold)) 80%);
    --btn-text: color-mix(in srgb, var(--theme-text-strong) 92%, white 8%);
    --btn-border: color-mix(in srgb, var(--border-accent-strong) 45%, transparent 55%);
  }
</style>
