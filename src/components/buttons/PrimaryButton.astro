---
interface Props {
  href?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  size?: "md" | "sm";
  iconAfter?: string;
  iconBefore?: string;
}

const {
  href,
  target,
  rel,
  type = "button",
  size = "md",
  iconAfter = "",
  iconBefore = "",
} = Astro.props as Props;

const classes = ["wc-button", "focus-ring", size === "sm" ? "wc-button--sm" : ""].filter(Boolean).join(" ");

let computedRel = rel ?? undefined;
if (target === "_blank") {
  if (computedRel) {
    computedRel = computedRel.includes("noopener") ? computedRel : `${computedRel} noopener`;
  } else {
    computedRel = "noopener";
  }
}
---
{href ? (
  <a class={classes} href={href} target={target} rel={computedRel}>
    {iconBefore && <span aria-hidden="true" class="wc-button__icon">{iconBefore}</span>}
    <span class="wc-button__label">
      <slot />
    </span>
    {iconAfter && <span aria-hidden="true" class="wc-button__icon">{iconAfter}</span>}
  </a>
) : (
  <button class={classes} type={type}>
    {iconBefore && <span aria-hidden="true" class="wc-button__icon">{iconBefore}</span>}
    <span class="wc-button__label">
      <slot />
    </span>
    {iconAfter && <span aria-hidden="true" class="wc-button__icon">{iconAfter}</span>}
  </button>
)}

<style>
  .wc-button {
    --btn-bg: color-mix(in srgb, var(--surface-panel-primary) 78%, var(--accent-purple-strong) 22%);
    --btn-bg-hover: color-mix(in srgb, var(--surface-panel-primary) 68%, var(--accent-purple-strong) 32%);
    --btn-text: var(--text-strong);
    --btn-border: color-mix(in srgb, var(--border-accent-strong) 40%, transparent 60%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: calc(var(--space-2) + 0.15rem) var(--space-4);
    border-radius: 999px;
    border: 1px solid var(--btn-border);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-accent);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.2;
    transition: background 160ms ease, transform 160ms ease, color 160ms ease, border-color 160ms ease;
    text-decoration: none;
  }

  .wc-button:hover,
  .wc-button:focus-visible {
    background: var(--btn-bg-hover);
    color: var(--btn-text);
    border-color: color-mix(in srgb, var(--border-accent-strong) 60%, transparent 40%);
  }

  .wc-button:active {
    transform: translateY(1px);
  }

  .wc-button--sm {
    padding: var(--space-1) var(--space-3);
    font-size: 0.85rem;
  }

  .wc-button__label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .wc-button__icon {
    font-size: 0.95em;
    line-height: 1;
  }

  :global(:root[data-comfort-theme="dawn"]) .wc-button {
    --btn-bg: color-mix(in srgb, var(--text-strong) 18%, var(--accent-purple-strong) 82%);
    --btn-bg-hover: color-mix(in srgb, var(--text-strong) 24%, var(--accent-purple-strong) 76%);
    --btn-text: color-mix(in srgb, var(--text-strong) 92%, white 8%);
    --btn-border: color-mix(in srgb, var(--border-accent-strong) 45%, transparent 55%);
  }
</style>
