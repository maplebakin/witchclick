---
import SpoonsBadge from "./SpoonsBadge.astro";
import type { SpoonLevel } from "../utils/augment";

interface Props {
  summary?: string;
  bullets?: string[];
  spoonLevel?: SpoonLevel | string | null;
  class?: string;
}

const { summary = "", bullets = [], spoonLevel, class: className } = Astro.props as Props;

const normalizedBullets = (Array.isArray(bullets) ? bullets : [])
  .filter((entry): entry is string => typeof entry === "string" && entry.trim().length > 0);

const hasList = normalizedBullets.length > 0;
const description = summary.trim();
---
<aside
  class:list={[
    "tldr-callout",
    hasList ? "tldr-callout--with-list" : "",
    className,
  ].filter(Boolean)}
  aria-label="TL;DR"
>
  <header class="tldr-callout__header">
    <span class="tldr-callout__chip" aria-hidden="true">TL;DR</span>
    {spoonLevel && (
      <SpoonsBadge level={spoonLevel} class="tldr-callout__spoons" />
    )}
  </header>
  {description && <p class="tldr-callout__summary">{description}</p>}
  {hasList && (
    <ul class="tldr-callout__list">
      {normalizedBullets.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )}
</aside>

<style is:inline>
  .tldr-callout {
    position: relative;
    display: grid;
    gap: 0.85rem;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-inline-start: 3px solid var(--theme-text-accent, var(--text-accent));
    background: color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 4%, transparent 96%);
    color: var(--theme-text-body, var(--text-body));
    max-width: min(100%, 72ch);
  }

  .tldr-callout__header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: 0.75rem;
  }

  .tldr-callout__chip {
    display: inline-block;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--theme-text-accent, var(--text-accent));
  }

  .tldr-callout__spoons {
    transform: scale(0.92);
    transform-origin: left center;
  }

  .tldr-callout__summary {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--theme-text-body, var(--text-body));
  }

  .tldr-callout__list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--theme-text-body, var(--text-body));
    list-style: disc;
  }

  .tldr-callout__list li::marker {
    color: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 72%, transparent 28%);
  }

  @media (max-width: 720px) {
    .tldr-callout {
      padding-left: 1.25rem;
    }
  }
</style>
