---
import SpoonsBadge from "./SpoonsBadge.astro";
import type { SpoonLevel } from "../utils/augment";

interface Props {
  summary?: string;
  bullets?: string[];
  spoonLevel?: SpoonLevel | string | null;
  class?: string;
}

const { summary = "", bullets = [], spoonLevel, class: className } = Astro.props as Props;

const normalizedBullets = (Array.isArray(bullets) ? bullets : [])
  .filter((entry): entry is string => typeof entry === "string" && entry.trim().length > 0);

const hasList = normalizedBullets.length > 0;
const description = summary.trim();
---
<aside
  class:list={[
    "tldr-callout",
    hasList ? "tldr-callout--with-list" : "",
    className,
  ].filter(Boolean)}
  aria-label="TL;DR"
>
  <header class="tldr-callout__header">
    <span class="tldr-callout__chip" aria-hidden="true">TL;DR</span>
    {spoonLevel && (
      <SpoonsBadge level={spoonLevel} class="tldr-callout__spoons" />
    )}
  </header>
  {description && <p class="tldr-callout__summary">{description}</p>}
  {hasList && (
    <ul class="tldr-callout__list">
      {normalizedBullets.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )}
</aside>

<style is:inline>
  .tldr-callout {
    position: relative;
    display: grid;
    gap: 0.85rem;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    border-radius: clamp(1.35rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--color-gold, #d4af37) 28%, transparent 72%);
    background:
      radial-gradient(80% 120% at 15% 10%, color-mix(in srgb, var(--color-gold, #d4af37) 28%, transparent) 0%, transparent 70%),
      radial-gradient(85% 120% at 85% 15%, color-mix(in srgb, var(--color-iris, #4b2a63) 22%, transparent) 0%, transparent 68%),
      color-mix(in srgb, var(--color-night, #120725) 92%, transparent 8%);
    box-shadow: 0 18px 48px -28px rgba(11, 6, 20, 0.65);
    color: rgba(249, 245, 255, 0.95);
    max-width: min(100%, 72ch);
  }

  .tldr-callout__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tldr-callout__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    background: rgba(12, 5, 23, 0.68);
    border: 1px solid rgba(212, 175, 55, 0.42);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .tldr-callout__spoons {
    transform: scale(0.92);
    transform-origin: left center;
  }

  .tldr-callout__summary {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(249, 245, 255, 0.9);
  }

  .tldr-callout__list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
    font-size: 0.96rem;
    line-height: 1.55;
    color: rgba(249, 245, 255, 0.88);
    list-style: disc;
  }

  .tldr-callout__list li::marker {
    color: rgba(212, 175, 55, 0.75);
  }

  :root[data-comfort-theme="dawn"] .tldr-callout {
    background:
      radial-gradient(80% 120% at 15% 10%, rgba(212, 175, 55, 0.16), transparent 72%),
      radial-gradient(85% 120% at 85% 15%, rgba(155, 134, 200, 0.18), transparent 70%),
      rgba(252, 248, 242, 0.94);
    border-color: rgba(155, 134, 200, 0.35);
    box-shadow: 0 20px 55px -30px rgba(93, 76, 128, 0.32);
    color: rgba(58, 40, 84, 0.95);
  }

  :root[data-comfort-theme="dawn"] .tldr-callout__chip {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(155, 134, 200, 0.4);
    color: rgba(85, 63, 115, 0.82);
  }

  :root[data-comfort-theme="dawn"] .tldr-callout__summary,
  :root[data-comfort-theme="dawn"] .tldr-callout__list {
    color: rgba(58, 40, 84, 0.9);
  }

  @media (max-width: 720px) {
    .tldr-callout {
      padding: 1.2rem 1.35rem;
    }
  }
</style>
