---
import type { AffiliateHighlight } from "@/utils/partners";

interface Props {
  product: AffiliateHighlight;
  class?: string;
}

const { product, class: className } = Astro.props as Props;
const impactLabel = product.impactTag?.trim();
const ethicalNote = product.ethicalNote?.trim();
const ctaLabel = product.ctaLabel?.trim() || "Visit partner";
---
<a class:list={["card-panel", "card-tier-2", "card-panel-strong", className]} href={product.url} target="_blank" rel="nofollow noopener">
  <span aria-hidden class="card-radial card-radial-top" />
  <div class="card-body">
    {impactLabel && <span class="card-badge partner-impact-badge">{impactLabel}</span>}
    <h3 class="card-heading">{product.name}</h3>
    <p class="card-subtle">{product.description}</p>
    {ethicalNote && <p class="card-note">{ethicalNote}</p>}
    <span class="partner-cta">{ctaLabel} ↗</span>
  </div>
</a>

<style>
  .partner-impact-badge {
    align-self: start;
    display: inline-flex;
    width: fit-content;
    background: color-mix(in srgb, hsl(var(--green-3) / 0.15) 80%, var(--card-badge-bg) 20%);
    border-color: hsl(var(--green-3) / 0.35);
    color: color-mix(in srgb, var(--theme-text-strong) 88%, hsl(var(--green-3) / 1) 12%);
  }

  .card-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--theme-text-muted);
    line-height: 1.5;
  }

  .partner-cta {
    font-weight: 600;
    color: var(--theme-text-accent);
    font-size: 0.95rem;
  }
</style>
