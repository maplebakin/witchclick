---
interface Testimonial {
  quote: string;
  author: string;
  role?: string;
}

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props as Props;
if (!Array.isArray(testimonials) || testimonials.length === 0) {
  return null;
}
---
<section class="testimonials" aria-label="Community notes">
  <div class="testimonials-grid">
    {testimonials.map((item) => (
      <figure class="testimonial-card">
        <blockquote>
          <span aria-hidden="true" class="testimonial-quote-mark">“</span>
          <p>{item.quote}</p>
        </blockquote>
        <figcaption>
          <p class="testimonial-author">{item.author}</p>
          {item.role && <p class="testimonial-role">{item.role}</p>}
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .testimonials {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.4rem);
  }

  .testimonials-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.6rem);
  }

  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  .testimonial-card {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 1.5rem;
    background: color-mix(in srgb, rgba(255, 255, 255, 0.9) 70%, var(--glass-panel-overlay, rgba(124, 58, 237, 0.12)) 30%);
    border: 1px solid color-mix(in srgb, var(--glass-panel-border, rgba(124, 58, 237, 0.32)) 70%, transparent);
    box-shadow: var(--elevation-tier-1);
    display: grid;
    gap: 1rem;
  }

  blockquote {
    margin: 0;
    position: relative;
    padding-left: 1.5rem;
    color: var(--surface-text-secondary);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .testimonial-quote-mark {
    position: absolute;
    left: 0;
    top: -0.6rem;
    font-size: 2.5rem;
    color: color-mix(in srgb, var(--glass-pill-border-active, rgba(91, 33, 182, 0.48)) 80%, white 20%);
  }

  figcaption {
    margin: 0;
  }

  .testimonial-author {
    margin: 0;
    font-weight: 600;
    color: var(--surface-text-strong);
  }

  .testimonial-role {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--surface-text-muted);
  }
</style>
