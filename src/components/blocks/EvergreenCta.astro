---
interface FormConfig {
  action: string;
  method?: string;
  emailFieldName?: string;
  emailPlaceholder?: string;
  submitLabel?: string;
  disclaimer?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  form: FormConfig;
}

const { eyebrow, title, description, form } = Astro.props as Props;
const method = (form.method ?? "post").toLowerCase();
const emailFieldName = form.emailFieldName ?? "email";
const emailPlaceholder = form.emailPlaceholder ?? "you@example.com";
const submitLabel = form.submitLabel ?? "Sign up";
const disclaimer = form.disclaimer ?? "No spam, just seasonal rituals.";
const formId = `cta-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "newsletter"}`;
---
<section class="evergreen-cta panel" aria-labelledby={`${formId}-title`}>
  {eyebrow && <p class="cta-eyebrow">{eyebrow}</p>}
  <h2 id={`${formId}-title`} class="cta-title font-serif">{title}</h2>
  <p class="cta-description">{description}</p>
  <form class="cta-form" method={method} action={form.action} target="_blank">
    <label class="sr-only" for={`${formId}-email`}>
      Email address
    </label>
    <div class="cta-form-fields">
      <input
        id={`${formId}-email`}
        name={emailFieldName}
        type="email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder={emailPlaceholder}
      />
      <button
        type="submit"
        class="cta-submit"
        data-analytics="newsletter_submit"
        data-analytics-props={JSON.stringify({ form: formId })}
      >
        {submitLabel}
      </button>
    </div>
    {disclaimer && <p class="cta-disclaimer">{disclaimer}</p>}
  </form>
</section>

<style>
  .evergreen-cta {
    display: grid;
    gap: clamp(0.85rem, 2.5vw, 1.4rem);
    padding: clamp(1.6rem, 4vw, 2.4rem);
    border-radius: clamp(1.5rem, 3vw, 1.9rem);
    /* Midnight theme: dark card with light text */
    background:
      radial-gradient(85% 120% at 12% 8%, color-mix(in srgb, var(--theme-color-gold, var(--text-accent)) 18%, transparent) 0%, transparent 68%),
      radial-gradient(80% 100% at 88% 5%, color-mix(in srgb, var(--theme-color-iris, hsl(var(--accent-ink) / 1)) 20%, transparent) 0%, transparent 70%),
      color-mix(in srgb, var(--theme-color-night, var(--surface-base)) 88%, transparent 12%);
    border: 1px solid color-mix(in srgb, var(--theme-color-gold, var(--text-accent)) 35%, var(--theme-color-iris, hsl(var(--accent-ink) / 1)) 25%);
    box-shadow: 0 22px 55px -32px hsl(var(--neutral-9) / 0.5);
  }

  .cta-eyebrow {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--theme-text-tertiary);
  }

  .cta-title {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--theme-text-primary);
  }

  .cta-description {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--theme-text-secondary);
  }

  .cta-form {
    display: grid;
    gap: 0.75rem;
  }

  .cta-form-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cta-form-fields input {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-color-gold, var(--text-accent)) 25%, var(--theme-color-iris, hsl(var(--accent-ink) / 1)) 25%);
    background: hsl(var(--neutral-0) / 0.95);
    font-size: 0.95rem;
    color: var(--text-strong);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .cta-form-fields input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  .cta-form-fields input:focus-visible {
    outline: none;
    border-color: hsl(var(--accent-2) / 0.5);
    box-shadow: 0 0 0 3px hsl(var(--accent-2) / 0.15);
  }

  .cta-submit {
    flex: 0 0 auto;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    border: none;
    background: var(--action-primary);
    color: var(--action-primary-text);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
    box-shadow: 0 12px 28px -18px color-mix(in srgb, var(--action-primary) 50%, transparent);
  }

  .cta-submit:hover,
  .cta-submit:focus-visible {
    background: var(--action-primary-hover);
    transform: translateY(-1px);
  }

  .cta-submit:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--action-primary) 25%, transparent),
      0 0 0 6px color-mix(in srgb, white 70%, transparent 30%);
  }

  .cta-disclaimer {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-hint);
  }

  /* Dawn theme overrides */
  :root[data-comfort-theme="dawn"] .evergreen-cta {
    background:
      radial-gradient(85% 120% at 12% 8%, hsl(var(--accent-2) / 0.15), transparent 68%),
      radial-gradient(80% 100% at 88% 5%, hsl(var(--accent-2) / 0.18), transparent 70%),
      hsl(var(--neutral-0) / 0.95);
    border-color: color-mix(in srgb, hsl(var(--accent-ink) / 0.35) 75%, transparent 25%);
    box-shadow: 0 22px 55px -32px hsl(var(--neutral-7) / 0.32);
  }

  :root[data-comfort-theme="dawn"] .cta-form-fields input {
    border-color: hsl(var(--accent-ink) / 0.35);
    background: hsl(var(--neutral-0) / 0.98);
  }

  :root[data-comfort-theme="dawn"] .cta-form-fields input:focus-visible {
    border-color: hsl(var(--accent-ink) / 0.55);
    box-shadow: 0 0 0 3px hsl(var(--accent-ink) / 0.18);
  }

  @media (max-width: 540px) {
    .cta-form-fields {
      flex-direction: column;
    }

    .cta-form-fields input {
      flex: 1 1 auto;
      width: 100%;
    }

    .cta-submit {
      display: inline-flex;
      align-items: center;
      width: 100%;
      align-self: stretch;
      justify-content: center;
    }
  }
</style>
