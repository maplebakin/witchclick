---
import CtaFooter from "./CtaFooter.astro";
import ProductRecommendations from "./ProductRecommendations.astro";

interface Recommendation {
  title: string;
  href: string;
  excerpt?: string;
  readingMinutes?: number;
  spoonLevel?: string;
}

interface EntityItem {
  name: string;
  href: string;
  description?: string;
}

interface TocItem {
  id: string;
  label: string;
  level: number;
}

interface ProductItem {
  key?: string;
  name?: string;
  brand?: string;
  url?: string;
  utm?: string;
  rel?: string;
  tags?: string[];
  image?: string;
}

interface Props {
  recommendations?: Recommendation[];
  entities?: EntityItem[];
  toc?: TocItem[];
  ctaType?: "kofi" | "download" | "none";
  ctaId?: string;
  products?: ProductItem[];
}

const {
  recommendations = [],
  entities = [],
  toc = [],
  ctaType = "none",
  ctaId,
  products = [],
} = Astro.props as Props;

const hasRecommendations = recommendations.length > 0;
const hasEntities = entities.length > 0;
const hasCta = ctaType !== "none";
const hasToc = toc.length > 0;
const hasProducts = products.length > 0;
const showRail = hasRecommendations || hasEntities || hasCta || hasToc || hasProducts;

// Calculate content counts for mobile trigger badge
const contentCount = recommendations.length + entities.length + (hasToc ? 1 : 0);
const contentItems: string[] = [];
if (hasRecommendations) contentItems.push(`${recommendations.length} related ${recommendations.length === 1 ? 'post' : 'posts'}`);
if (hasEntities) contentItems.push(`${entities.length} ${entities.length === 1 ? 'entity' : 'entities'}`);
if (hasToc) contentItems.push('table of contents');
const contentSummary = contentItems.join(' • ');
---
{showRail && (
  <aside class="post-rail" aria-label="Article navigation" data-post-rail>
    <button
      type="button"
      class="post-rail__mobile-trigger"
      data-rail-trigger
      aria-expanded="false"
      aria-controls="post-rail-panel"
      aria-label={`Explore ${contentCount} related ${contentCount === 1 ? 'item' : 'items'}`}
    >
      <span class="post-rail__trigger-content">
        <span class="post-rail__trigger-label">Keep exploring</span>
        <span class="post-rail__trigger-badge">{contentSummary}</span>
      </span>
      <svg class="post-rail__trigger-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>

    <div class="post-rail__panel" id="post-rail-panel" data-rail-panel>
      {hasRecommendations && (
        <section class="post-rail__section" aria-label="Recommended posts">
          <h2 class="post-rail__title">Recommended</h2>
          <ul class="post-rail__cards">
            {recommendations.map((item) => (
              <li>
                <a class="post-rail__card" href={item.href}>
                  <span class="post-rail__card-title">{item.title}</span>
                  {item.excerpt && <span class="post-rail__card-excerpt">{item.excerpt}</span>}
                  <span class="post-rail__card-meta">
                    {item.readingMinutes && <span>{item.readingMinutes} min read</span>}
                    {item.spoonLevel && <span>{item.spoonLevel} spoons</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(hasEntities || hasCta) && (
        <section class="post-rail__section" aria-label="Keep exploring">
          <h2 class="post-rail__title">Keep exploring</h2>
          {hasEntities && (
            <ul class="post-rail__entities">
              {entities.map((entity) => (
                <li>
                  <a class="post-rail__entity" href={entity.href}>
                    <span class="post-rail__entity-name">{entity.name}</span>
                    {entity.description && (
                      <span class="post-rail__entity-description">{entity.description}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {hasCta && <CtaFooter type={ctaType} id={ctaId} />}
        </section>
      )}

      {hasProducts && (
        <section class="post-rail__section" aria-label="Recommended products">
          <ProductRecommendations products={products} title="Cozy picks" />
        </section>
      )}

      {hasToc && (
        <nav class="post-rail__section post-rail__toc" aria-label="On this page">
          <h2 class="post-rail__title">On this page</h2>
          <ol class="post-rail__toc-list">
            {toc.map((item) => (
              <li class:list={["post-rail__toc-item", item.level > 2 && "post-rail__toc-item--nested"].filter(Boolean)}>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </aside>
)}

<style is:inline>
  .post-rail {
    position: relative;
    display: grid;
    gap: 1rem;
    --rail-section-surface: color-mix(in srgb, var(--theme-surface-panel, var(--surface-panel)) 88%, transparent 12%);
    --rail-section-border: color-mix(in srgb, var(--theme-border-subtle, var(--border-subtle)) 78%, transparent 22%);
    --rail-section-shadow: 0 16px 34px -30px color-mix(in srgb, var(--theme-color-night, var(--surface-base)) 68%, transparent 32%);
    --rail-item-divider: color-mix(in srgb, var(--theme-border-subtle, var(--border-subtle)) 72%, transparent 28%);
    --rail-item-hover: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 78%, var(--theme-text-strong, var(--text-strong)) 22%);
  }

  .post-rail__mobile-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 0.95rem 1.15rem;
    border-radius: 1rem;
    border: 1px solid var(--rail-section-border);
    background: var(--rail-section-surface);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--theme-text-strong, var(--text-strong));
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    min-height: 44px;
  }

  .post-rail__mobile-trigger:hover {
    border-color: color-mix(in srgb, var(--theme-border-strong, var(--border-strong)) 72%, transparent 28%);
  }

  .post-rail__mobile-trigger:focus-visible {
    outline: 2px solid var(--theme-focus-ring-color, var(--text-accent));
    outline-offset: 3px;
  }

  :global(.post-rail__mobile-trigger[aria-expanded="true"]) {
    border-color: color-mix(in srgb, var(--theme-border-strong, var(--border-strong)) 72%, transparent 28%);
  }

  .post-rail__trigger-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: left;
  }

  .post-rail__trigger-label {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .post-rail__trigger-badge {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--theme-text-body, var(--text-body));
  }

  .post-rail__trigger-chevron {
    flex-shrink: 0;
    color: var(--theme-text-accent, var(--text-accent));
    transition: transform 0.2s ease;
  }

  :global(.post-rail__mobile-trigger[aria-expanded="true"] .post-rail__trigger-chevron) {
    transform: rotate(180deg);
  }

  .post-rail__panel {
    display: none;
    gap: clamp(1rem, 2.2vw, 1.35rem);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  :global(.post-rail__panel.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.post-rail.is-open .post-rail__panel) {
    display: grid;
  }

  .post-rail__section {
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 2.2vw, 1.25rem);
    border-radius: clamp(0.95rem, 2vw, 1.15rem);
    border: 1px solid var(--rail-section-border);
    background: var(--rail-section-surface);
    box-shadow: var(--rail-section-shadow);
  }

  .post-rail__title {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .post-rail__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .post-rail__card {
    display: grid;
    gap: 0.35rem;
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 1px solid var(--rail-item-divider);
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-rail__cards li:last-child .post-rail__card {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .post-rail__cards li:first-child .post-rail__card {
    padding-top: 0;
  }

  .post-rail__card:hover {
    color: var(--rail-item-hover);
  }

  .post-rail__card:focus-visible {
    outline: 2px solid var(--theme-focus-ring-color);
    outline-offset: 3px;
  }

  .post-rail__card-title {
    font-weight: 600;
    font-size: 0.94rem;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .post-rail__card-excerpt {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--theme-text-muted, var(--text-muted));
  }

  .post-rail__card-meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--theme-text-accent, var(--text-accent));
  }

  .post-rail__entities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .post-rail__entity {
    display: grid;
    gap: 0.32rem;
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 1px solid var(--rail-item-divider);
    border-radius: 0;
    background: transparent;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-rail__entities li:last-child .post-rail__entity {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .post-rail__entities li:first-child .post-rail__entity {
    padding-top: 0;
  }

  .post-rail__entity:hover {
    color: var(--rail-item-hover);
  }

  .post-rail__entity:focus-visible {
    outline: 2px solid var(--theme-focus-ring-color);
    outline-offset: 3px;
  }

  .post-rail__entity-name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--theme-text-strong, var(--text-strong));
  }

  .post-rail__entity-description {
    font-size: 0.8rem;
    color: var(--theme-text-subtle, var(--text-muted));
    line-height: 1.45;
  }

  .post-rail__toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
    font-size: 0.82rem;
  }

  .post-rail__toc-item a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    width: 100%;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rail-item-divider);
    color: var(--theme-text-primary, var(--text-strong));
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-rail__toc-item:first-child a {
    padding-top: 0;
  }

  .post-rail__toc-item:last-child a {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .post-rail__toc-item a:hover,
  .post-rail__toc-item a:focus-visible {
    color: var(--rail-item-hover);
  }

  .post-rail__toc-item--nested {
    padding-left: 1rem;
    position: relative;
  }

  .post-rail__toc-item--nested::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 1.05rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--theme-text-accent, var(--text-accent)) 45%, transparent 55%);
  }

  :global(.post-rail__section .product-recs) {
    background: transparent;
    border: 0;
    padding: 0;
    border-radius: 0;
    color: inherit;
  }

  :global(.post-rail__section .product-recs-header) {
    margin-bottom: 0.2rem;
  }

  :global(.post-rail__section .product-recs-list) {
    gap: 1rem;
  }

  :global(.post-rail__section .product-card-link) {
    border-color: var(--rail-item-divider);
    background: color-mix(in srgb, var(--theme-surface-card, var(--surface-card)) 88%, transparent 12%);
  }

  :global(.post-rail__section .product-card-body) {
    padding: 0.15rem 0 0;
  }

  :global(.post-rail__section .product-card-button) {
    border-color: var(--rail-item-divider);
  }

  @media (min-width: 768px) {
    .post-rail__mobile-trigger {
      display: none;
    }

    .post-rail__panel {
      display: grid;
      position: sticky;
      top: 6.75rem;
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // PostRail mobile toggle functionality
  function initPostRail() {
    const rail = document.querySelector<HTMLElement>('[data-post-rail]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-rail-trigger]');
    const panel = document.querySelector<HTMLDivElement>('[data-rail-panel]');

    if (!rail || !trigger || !panel) return;

    let isOpen = false;

    function toggle() {
      isOpen = !isOpen;

      if (isOpen) {
        rail!.classList.add('is-open');
        trigger!.setAttribute('aria-expanded', 'true');
        panel!.style.display = 'grid';
        // Use requestAnimationFrame to ensure display:grid is applied before animation
        requestAnimationFrame(() => {
          panel!.classList.add('is-visible');
        });
      } else {
        rail!.classList.remove('is-open');
        trigger!.setAttribute('aria-expanded', 'false');
        panel!.classList.remove('is-visible');
        // Wait for transition to complete before hiding
        setTimeout(() => {
          if (!isOpen && panel) {
            panel.style.display = 'none';
          }
        }, 250);
      }
    }

    trigger.addEventListener('click', toggle);

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggle();
        trigger!.focus();
      }
    });
  }

  // Init on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPostRail);
  } else {
    initPostRail();
  }
</script>
