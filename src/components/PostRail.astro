---
import CtaFooter from "./CtaFooter.astro";

interface Recommendation {
  title: string;
  href: string;
  excerpt?: string;
  readingMinutes?: number;
  spoonLevel?: string;
}

interface EntityItem {
  name: string;
  href: string;
  description?: string;
}

interface TocItem {
  id: string;
  label: string;
  level: number;
}

interface Props {
  recommendations?: Recommendation[];
  entities?: EntityItem[];
  toc?: TocItem[];
  ctaType?: "kofi" | "download" | "none";
  ctaId?: string;
}

const {
  recommendations = [],
  entities = [],
  toc = [],
  ctaType = "none",
  ctaId,
} = Astro.props as Props;

const hasRecommendations = recommendations.length > 0;
const hasEntities = entities.length > 0;
const hasCta = ctaType !== "none";
const hasToc = toc.length > 0;
const showRail = hasRecommendations || hasEntities || hasCta || hasToc;
---
{showRail && (
  <aside class="post-rail" aria-label="Article navigation">
    <details class="post-rail__mobile-trigger">
      <summary class="post-rail__summary">Keep exploring</summary>
    </details>

    <div class="post-rail__panel">
      {hasRecommendations && (
        <section class="post-rail__section" aria-label="Recommended posts">
          <h2 class="post-rail__title">Recommended</h2>
          <ul class="post-rail__cards">
            {recommendations.map((item) => (
              <li>
                <a class="post-rail__card" href={item.href}>
                  <span class="post-rail__card-title">{item.title}</span>
                  {item.excerpt && <span class="post-rail__card-excerpt">{item.excerpt}</span>}
                  <span class="post-rail__card-meta">
                    {item.readingMinutes && <span>{item.readingMinutes} min read</span>}
                    {item.spoonLevel && <span>{item.spoonLevel} spoons</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(hasEntities || hasCta) && (
        <section class="post-rail__section" aria-label="Keep exploring">
          <h2 class="post-rail__title">Keep exploring</h2>
          {hasEntities && (
            <ul class="post-rail__entities">
              {entities.map((entity) => (
                <li>
                  <a class="post-rail__entity" href={entity.href}>
                    <span class="post-rail__entity-name">{entity.name}</span>
                    {entity.description && (
                      <span class="post-rail__entity-description">{entity.description}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {hasCta && <CtaFooter type={ctaType} id={ctaId} />}
        </section>
      )}

      {hasToc && (
        <nav class="post-rail__section post-rail__toc" aria-label="On this page">
          <h2 class="post-rail__title">On this page</h2>
          <ol class="post-rail__toc-list">
            {toc.map((item) => (
              <li class:list={["post-rail__toc-item", item.level > 2 && "post-rail__toc-item--nested"].filter(Boolean)}>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </aside>
)}

<style is:inline>
  .post-rail {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  /* Mobile trigger */
  .post-rail__mobile-trigger {
    display: block;
  }

  .post-rail__mobile-trigger[open] ~ .post-rail__panel {
    display: grid;
  }

  .post-rail__summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1.1rem;
    border-radius: 1rem;
    border: 1px solid rgba(212, 175, 55, 0.35);
    background: rgba(18, 7, 37, 0.8);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Content panel - hidden on mobile by default, shown when trigger open */
  .post-rail__panel {
    display: none;
    gap: 1.5rem;
    border-radius: clamp(1.35rem, 3vw, 1.75rem);
    background:
      radial-gradient(120% 120% at 8% 10%, rgba(124, 78, 176, 0.18), transparent 70%),
      rgba(12, 5, 23, 0.82);
    border: 1px solid rgba(124, 78, 176, 0.28);
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
  }

  .post-rail__section {
    display: grid;
    gap: 0.9rem;
  }

  .post-rail__title {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(249, 245, 255, 0.75);
  }

  .post-rail__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .post-rail__card {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--border-accent-subtle);
    background: var(--surface-card);
    color: inherit;
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease,
                background 160ms ease, box-shadow 160ms ease;
  }

  .post-rail__card:hover {
    transform: translateY(-2px) scale(1.01);
    border-color: var(--border-accent-strong);
    background: var(--surface-card-hover);
    box-shadow: var(--shadow-card-hover);
  }

  .post-rail__card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--border-accent-strong);
    background: var(--surface-card-hover);
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .post-rail__card:active {
    transform: translateY(-1px) scale(0.99);
  }

  .post-rail__card-title {
    font-weight: 600;
    font-size: 0.98rem;
  }

  .post-rail__card-excerpt {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .post-rail__card-meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .post-rail__entities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .post-rail__entity {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 0.9rem;
    border-radius: 0.95rem;
    border: 1px solid var(--border-purple-subtle);
    background: var(--surface-muted);
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease,
                background 160ms ease, box-shadow 160ms ease;
  }

  .post-rail__entity:hover {
    transform: translateX(2px);
    border-color: var(--border-purple-medium);
    background: var(--surface-elevated);
    box-shadow: 0 2px 8px rgba(124, 78, 176, 0.15);
  }

  .post-rail__entity:focus-visible {
    transform: translateX(2px);
    border-color: var(--border-purple-medium);
    background: var(--surface-elevated);
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .post-rail__entity:active {
    transform: translateX(1px);
  }

  .post-rail__entity-name {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .post-rail__entity-description {
    font-size: 0.8rem;
    color: var(--text-subtle);
    line-height: 1.45;
  }

  .post-rail__toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: 0.82rem;
  }

  .post-rail__toc-item a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: rgba(249, 245, 255, 0.82);
    text-decoration: none;
  }

  .post-rail__toc-item a:hover,
  .post-rail__toc-item a:focus-visible {
    color: rgba(212, 175, 55, 0.92);
  }

  .post-rail__toc-item--nested {
    padding-left: 1rem;
    position: relative;
  }

  .post-rail__toc-item--nested::before {
    content: "";
    position: absolute;
    left: 0.35rem;
    top: 0.55rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: rgba(124, 78, 176, 0.45);
  }

  :root[data-comfort-theme="dawn"] .post-rail__summary {
    background: rgba(253, 247, 238, 0.92);
    border-color: rgba(155, 134, 200, 0.4);
    color: rgba(87, 63, 115, 0.85);
  }

  :root[data-comfort-theme="dawn"] .post-rail__panel {
    background:
      radial-gradient(120% 120% at 8% 10%, rgba(180, 154, 217, 0.2), transparent 70%),
      rgba(252, 248, 242, 0.96);
    border-color: rgba(155, 134, 200, 0.35);
  }

  :root[data-comfort-theme="dawn"] .post-rail__card {
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(180, 154, 217, 0.28);
    color: rgba(58, 40, 84, 0.95);
  }

  :root[data-comfort-theme="dawn"] .post-rail__card:hover,
  :root[data-comfort-theme="dawn"] .post-rail__card:focus-visible {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(212, 175, 55, 0.4);
  }

  :root[data-comfort-theme="dawn"] .post-rail__card-excerpt {
    color: rgba(87, 63, 115, 0.7);
  }

  :root[data-comfort-theme="dawn"] .post-rail__card-meta {
    color: rgba(155, 134, 200, 0.7);
  }

  :root[data-comfort-theme="dawn"] .post-rail__entity {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(180, 154, 217, 0.3);
    color: rgba(58, 40, 84, 0.95);
  }

  :root[data-comfort-theme="dawn"] .post-rail__entity:hover,
  :root[data-comfort-theme="dawn"] .post-rail__entity:focus-visible {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(212, 175, 55, 0.35);
  }

  :root[data-comfort-theme="dawn"] .post-rail__entity-description {
    color: rgba(87, 63, 115, 0.65);
  }

  :root[data-comfort-theme="dawn"] .post-rail__toc-item--nested::before {
    background: rgba(155, 134, 200, 0.5);
  }

  @media (min-width: 768px) {
    /* Hide mobile trigger on desktop */
    .post-rail__mobile-trigger {
      display: none;
    }

    /* Always show panel on desktop */
    .post-rail__panel {
      display: grid;
      position: sticky;
      top: 7rem;
    }
  }
</style>
