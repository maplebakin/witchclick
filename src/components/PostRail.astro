---
import CtaFooter from "./CtaFooter.astro";

interface Recommendation {
  title: string;
  href: string;
  excerpt?: string;
  readingMinutes?: number;
  spoonLevel?: string;
}

interface EntityItem {
  name: string;
  href: string;
  description?: string;
}

interface TocItem {
  id: string;
  label: string;
  level: number;
}

interface Props {
  recommendations?: Recommendation[];
  entities?: EntityItem[];
  toc?: TocItem[];
  ctaType?: "kofi" | "download" | "none";
  ctaId?: string;
}

const {
  recommendations = [],
  entities = [],
  toc = [],
  ctaType = "none",
  ctaId,
} = Astro.props as Props;

const hasRecommendations = recommendations.length > 0;
const hasEntities = entities.length > 0;
const hasCta = ctaType !== "none";
const hasToc = toc.length > 0;
const showRail = hasRecommendations || hasEntities || hasCta || hasToc;

// Calculate content counts for mobile trigger badge
const contentCount = recommendations.length + entities.length + (hasToc ? 1 : 0);
const contentItems: string[] = [];
if (hasRecommendations) contentItems.push(`${recommendations.length} related ${recommendations.length === 1 ? 'post' : 'posts'}`);
if (hasEntities) contentItems.push(`${entities.length} ${entities.length === 1 ? 'entity' : 'entities'}`);
if (hasToc) contentItems.push('table of contents');
const contentSummary = contentItems.join(' • ');
---
{showRail && (
  <aside class="post-rail" aria-label="Article navigation" data-post-rail>
    <button
      type="button"
      class="post-rail__mobile-trigger"
      data-rail-trigger
      aria-expanded="false"
      aria-controls="post-rail-panel"
      aria-label={`Explore ${contentCount} related ${contentCount === 1 ? 'item' : 'items'}`}
    >
      <span class="post-rail__trigger-content">
        <span class="post-rail__trigger-label">Keep exploring</span>
        <span class="post-rail__trigger-badge">{contentSummary}</span>
      </span>
      <svg class="post-rail__trigger-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>

    <div class="post-rail__panel" id="post-rail-panel" data-rail-panel>
      {hasRecommendations && (
        <section class="post-rail__section" aria-label="Recommended posts">
          <h2 class="post-rail__title">Recommended</h2>
          <ul class="post-rail__cards">
            {recommendations.map((item) => (
              <li>
                <a class="post-rail__card" href={item.href}>
                  <span class="post-rail__card-title">{item.title}</span>
                  {item.excerpt && <span class="post-rail__card-excerpt">{item.excerpt}</span>}
                  <span class="post-rail__card-meta">
                    {item.readingMinutes && <span>{item.readingMinutes} min read</span>}
                    {item.spoonLevel && <span>{item.spoonLevel} spoons</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(hasEntities || hasCta) && (
        <section class="post-rail__section" aria-label="Keep exploring">
          <h2 class="post-rail__title">Keep exploring</h2>
          {hasEntities && (
            <ul class="post-rail__entities">
              {entities.map((entity) => (
                <li>
                  <a class="post-rail__entity" href={entity.href}>
                    <span class="post-rail__entity-name">{entity.name}</span>
                    {entity.description && (
                      <span class="post-rail__entity-description">{entity.description}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {hasCta && <CtaFooter type={ctaType} id={ctaId} />}
        </section>
      )}

      {hasToc && (
        <nav class="post-rail__section post-rail__toc" aria-label="On this page">
          <h2 class="post-rail__title">On this page</h2>
          <ol class="post-rail__toc-list">
            {toc.map((item) => (
              <li class:list={["post-rail__toc-item", item.level > 2 && "post-rail__toc-item--nested"].filter(Boolean)}>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </aside>
)}

<style is:inline>
  .post-rail {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  /* Mobile trigger */
  .post-rail__mobile-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 2px solid color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, transparent 55%);
    background: color-mix(in srgb, var(--theme-color-night, #120725) 88%, transparent 12%);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--theme-text-primary, rgba(249, 245, 255, 0.95));
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 44px; /* Ensure minimum touch target */
  }

  .post-rail__mobile-trigger:hover {
    border-color: color-mix(in srgb, var(--theme-color-gold, #d4af37) 60%, transparent 40%);
    background: color-mix(in srgb, var(--theme-color-night, #120725) 95%, transparent 5%);
    box-shadow: 0 4px 12px var(--theme-glass-shadow-soft, rgba(0, 0, 0, 0.3));
  }

  .post-rail__mobile-trigger:focus-visible {
    outline: 2px solid var(--theme-focus-ring-color, #d4af37);
    outline-offset: 3px;
  }

  :global(.post-rail__mobile-trigger[aria-expanded="true"]) {
    border-color: color-mix(in srgb, var(--theme-color-gold, #d4af37) 55%, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 45%);
    background: color-mix(in srgb, var(--theme-color-night, #120725) 96%, transparent 4%);
  }

  .post-rail__trigger-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: left;
  }

  .post-rail__trigger-label {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--theme-text-primary, rgba(249, 245, 255, 0.95));
  }

  .post-rail__trigger-badge {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--theme-color-gold, rgba(212, 175, 55, 0.85));
  }

  .post-rail__trigger-chevron {
    flex-shrink: 0;
    color: var(--theme-color-gold, rgba(212, 175, 55, 0.7));
    transition: transform 0.2s ease;
  }

  :global(.post-rail__mobile-trigger[aria-expanded="true"] .post-rail__trigger-chevron) {
    transform: rotate(180deg);
  }

  /* Content panel - hidden on mobile by default, shown when trigger active */
  .post-rail__panel {
    display: none;
    gap: 1.5rem;
    border-radius: clamp(1.35rem, 3vw, 1.75rem);
    background:
      radial-gradient(120% 120% at 8% 10%, color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 18%, transparent) 0%, transparent 70%),
      color-mix(in srgb, var(--theme-color-night, #120725) 82%, transparent 18%);
    border: 1px solid color-mix(in srgb, var(--color-gold, #d4af37) 28%, var(--color-iris, var(--color-gold, #d4af37)) 22%);
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  :global(.post-rail__panel.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.post-rail.is-open .post-rail__panel) {
    display: grid;
  }

  .post-rail__section {
    display: grid;
    gap: 0.9rem;
  }

  .post-rail__title {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--theme-text-muted, rgba(249, 245, 255, 0.75));
  }

  .post-rail__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .post-rail__card {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-gold, #d4af37) 25%, transparent 75%);
    background: var(--theme-surface-card, color-mix(in srgb, var(--theme-color-night, #120725) 70%, transparent 30%));
    color: inherit;
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease,
                background 160ms ease, box-shadow 160ms ease;
  }

  .post-rail__card:hover {
    transform: translateY(-2px) scale(1.01);
    border-color: color-mix(in srgb, var(--theme-color-gold, #d4af37) 45%, transparent 55%);
    background: color-mix(in srgb, var(--theme-color-gold, #d4af37) 8%, var(--theme-surface-card, rgba(0, 0, 0, 0.12)) 92%);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 20%, transparent 80%);
  }

  .post-rail__card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--theme-border-strong);
    background: var(--theme-surface-card-hover);
    outline: 2px solid var(--theme-focus-ring-color);
    outline-offset: 3px;
  }

  .post-rail__card:active {
    transform: translateY(-1px) scale(0.99);
  }

  .post-rail__card-title {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--theme-text-strong);
  }

  .post-rail__card-excerpt {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--theme-text-muted);
  }

  .post-rail__card-meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--theme-text-accent);
  }

  .post-rail__entities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .post-rail__entity {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 0.9rem;
    border-radius: 0.95rem;
    border: 1px solid color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 22%, transparent 78%);
    background: color-mix(in srgb, var(--theme-surface-panel, rgba(255, 255, 255, 0.92)) 90%, transparent 10%);
    text-decoration: none;
    transition: transform 160ms ease, border-color 160ms ease,
                background 160ms ease, box-shadow 160ms ease;
  }

  .post-rail__entity:hover {
    transform: translateX(2px);
    border-color: color-mix(in srgb, var(--theme-color-gold, #d4af37) 32%, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 28%);
    background: color-mix(in srgb, var(--theme-surface-elevated, rgba(255, 255, 255, 0.96)) 92%, transparent 8%);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 18%, transparent 82%);
  }

  .post-rail__entity:focus-visible {
    transform: translateX(2px);
    border-color: var(--theme-border-strong);
    background: var(--theme-surface-elevated);
    outline: 2px solid var(--theme-focus-ring-color);
    outline-offset: 3px;
  }

  .post-rail__entity:active {
    transform: translateX(1px);
  }

  .post-rail__entity-name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--theme-text-strong);
  }

  .post-rail__entity-description {
    font-size: 0.8rem;
    color: var(--theme-text-subtle);
    line-height: 1.45;
  }

  .post-rail__toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: 0.82rem;
  }

  .post-rail__toc-item a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--theme-text-primary, rgba(249, 245, 255, 0.82));
    text-decoration: none;
  }

  .post-rail__toc-item a:hover,
  .post-rail__toc-item a:focus-visible {
    color: var(--theme-color-gold, rgba(212, 175, 55, 0.92));
  }

  .post-rail__toc-item--nested {
    padding-left: 1rem;
    position: relative;
  }

  .post-rail__toc-item--nested::before {
    content: "";
    position: absolute;
    left: 0.35rem;
    top: 0.55rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--theme-color-iris, var(--theme-color-gold, #d4af37)) 45%, transparent 55%);
  }

  :root[data-comfort-theme="dawn"] .post-rail__mobile-trigger {
    background: var(--theme-surface-base, rgba(253, 247, 238, 0.95));
    border-color: var(--theme-color-amethyst, rgba(155, 134, 200, 0.45));
    color: var(--theme-text-primary, rgba(87, 63, 115, 0.95));
  }

  :root[data-comfort-theme="dawn"] .post-rail__mobile-trigger:hover {
    border-color: var(--theme-color-amethyst, rgba(155, 134, 200, 0.65));
    background: var(--theme-surface-hover, rgba(253, 247, 238, 1));
    box-shadow: 0 4px 12px var(--theme-glass-shadow-soft, rgba(71, 54, 96, 0.15));
  }

  :global(:root[data-comfort-theme="dawn"] .post-rail__mobile-trigger[aria-expanded="true"]) {
    border-color: var(--theme-color-amethyst, rgba(180, 154, 217, 0.6));
    background: var(--theme-surface-base, rgba(252, 248, 242, 1));
  }

  :root[data-comfort-theme="dawn"] .post-rail__trigger-badge {
    color: var(--theme-color-amethyst, rgba(122, 94, 154, 0.85));
  }

  :root[data-comfort-theme="dawn"] .post-rail__trigger-chevron {
    color: var(--theme-color-amethyst, rgba(122, 94, 154, 0.7));
  }

  :root[data-comfort-theme="dawn"] .post-rail__panel {
    background:
      radial-gradient(120% 120% at 8% 10%, var(--theme-color-amethyst, rgba(180, 154, 217, 0.2)), transparent 70%),
      var(--theme-surface-base, rgba(252, 248, 242, 0.96));
    border-color: var(--theme-color-amethyst, rgba(155, 134, 200, 0.35));
  }

  :root[data-comfort-theme="dawn"] .post-rail__card {
    background: var(--theme-surface-card, rgba(255, 255, 255, 0.88));
    border-color: var(--theme-color-amethyst, rgba(180, 154, 217, 0.28));
    color: var(--theme-text-primary, rgba(58, 40, 84, 0.95));
  }

  :root[data-comfort-theme="dawn"] .post-rail__card:hover,
  :root[data-comfort-theme="dawn"] .post-rail__card:focus-visible {
    background: var(--theme-surface-card-hover, rgba(255, 255, 255, 0.98));
    border-color: var(--theme-color-gold, rgba(212, 175, 55, 0.4));
  }

  :root[data-comfort-theme="dawn"] .post-rail__card-excerpt {
    color: var(--theme-text-muted, rgba(87, 63, 115, 0.7));
  }

  :root[data-comfort-theme="dawn"] .post-rail__card-meta {
    color: var(--theme-color-amethyst, rgba(155, 134, 200, 0.7));
  }

  :root[data-comfort-theme="dawn"] .post-rail__entity {
    background: var(--theme-surface-panel, rgba(255, 255, 255, 0.92));
    border-color: var(--theme-color-amethyst, rgba(180, 154, 217, 0.3));
    color: var(--theme-text-primary, rgba(58, 40, 84, 0.95));
  }

  :root[data-comfort-theme="dawn"] .post-rail__entity:hover,
  :root[data-comfort-theme="dawn"] .post-rail__entity:focus-visible {
    background: var(--theme-surface-elevated, rgba(255, 255, 255, 0.98));
    border-color: var(--theme-color-gold, rgba(212, 175, 55, 0.35));
  }

  :root[data-comfort-theme="dawn"] .post-rail__entity-description {
    color: var(--theme-text-subtle, rgba(87, 63, 115, 0.65));
  }

  :root[data-comfort-theme="dawn"] .post-rail__toc-item--nested::before {
    background: var(--theme-color-amethyst, rgba(155, 134, 200, 0.5));
  }

  @media (min-width: 768px) {
    /* Hide mobile trigger on desktop */
    .post-rail__mobile-trigger {
      display: none;
    }

    /* Always show panel on desktop */
    .post-rail__panel {
      display: grid;
      position: sticky;
      top: 7rem;
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // PostRail mobile toggle functionality
  function initPostRail() {
    const rail = document.querySelector<HTMLElement>('[data-post-rail]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-rail-trigger]');
    const panel = document.querySelector<HTMLDivElement>('[data-rail-panel]');

    if (!rail || !trigger || !panel) return;

    let isOpen = false;

    function toggle() {
      isOpen = !isOpen;

      if (isOpen) {
        rail!.classList.add('is-open');
        trigger!.setAttribute('aria-expanded', 'true');
        panel!.style.display = 'grid';
        // Use requestAnimationFrame to ensure display:grid is applied before animation
        requestAnimationFrame(() => {
          panel!.classList.add('is-visible');
        });
      } else {
        rail!.classList.remove('is-open');
        trigger!.setAttribute('aria-expanded', 'false');
        panel!.classList.remove('is-visible');
        // Wait for transition to complete before hiding
        setTimeout(() => {
          if (!isOpen && panel) {
            panel.style.display = 'none';
          }
        }, 250);
      }
    }

    trigger.addEventListener('click', toggle);

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggle();
        trigger!.focus();
      }
    });
  }

  // Init on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPostRail);
  } else {
    initPostRail();
  }
</script>
