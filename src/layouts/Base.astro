---
// src/layouts/Base.astro
import "@/styles/base.css";
import "@/styles/cards.css";
import "@/styles/tailwind.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import {
  primaryNavLinks,
  secondaryNavLinks,
  headerUtilityLinks,
  footerUtilityLinks,
  adminNavSections,
} from "@/data/navigation";
import { readSettings, buildCanonicalUrl, toAbsoluteUrl } from "@/utils/settings";
import { buildAnalyticsInjection } from "@/utils/analytics";
import { ALL_FIELDS, getActiveThemes } from "@/utils/theme";
import type { ThemeMode } from "@/utils/theme";
import { mixColors } from "@/utils/color";
import cardAnimationsModule from "@/scripts/card-animations.js?url";

interface LayoutProps {
  title?: string;
  description?: string;
  canon?: string;
  wide?: boolean;
  desktopWide?: boolean;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  noindex?: boolean;
  ambientColor?: string;
  bodyDataType?: string;
  mainClass?: string | string[];
  containerClass?: string | string[];
  contentClass?: string | string[];
}

const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  desktopWide = false,
  ogImage = "",
  ogType = "website",
  twitterCard = "summary_large_image",
  noindex = false,
  ambientColor = "",
  bodyDataType = "",
  mainClass: mainClassProp,
  containerClass: containerClassProp,
  contentClass: contentClassProp,
} = Astro.props as LayoutProps;

// Constants
const FALLBACK_COLORS = {
  midnight: {
    primary: "#d18c47",
    accent: "#d4af37",
    background: "#07020f",
  },
  dawn: {
    primary: "#9b86c8",
    accent: "#caa043",
    background: "#f6f0e8",
  },
} as const;

const FALLBACK_TEXT = {
  midnight: {
    textPrimary: "#f4f1ff",
    textHeading: "#f8f3ff",
    textSecondary: "#f4f1ff",
    textTertiary: "#f4f1ff",
    textHint: "#f4f1ff",
    textDisabled: "#f4f1ff",
    textBody: "#f9f5ff",
    textSubtle: "#f9f5ff",
    textAccent: "#d4af37",
    textAccentStrong: "#d4af37",
    textStrong: "#f9f5ff",
    textMuted: "#f9f5ff",
    linkColor: "#e0c07d",
  },
  dawn: {
    textPrimary: "#2c1b3d",
    textHeading: "#3a2854",
    textSecondary: "#2c1b3d",
    textTertiary: "#2c1b3d",
    textHint: "#2c1b3d",
    textDisabled: "#2c1b3d",
    textBody: "#573f73",
    textSubtle: "#573f73",
    textAccent: "#9b86c8",
    textAccentStrong: "#573f73",
    textStrong: "#3a2854",
    textMuted: "#573f73",
    linkColor: "#caa043",
  },
} as const;

const FALLBACK_STATUS_COLORS = {
  midnight: {
    success: "#4ade80",
    warning: "#facc15",
    error: "#f87171",
    info: "#60a5fa",
  },
  dawn: {
    success: "#15803d",
    warning: "#b45309",
    error: "#b91c1c",
    info: "#1d4ed8",
  },
} as const;

const FALLBACK_SHADOWS = {
  midnight: {
    shadowSoft: "0 18px 45px -28px rgba(11, 6, 20, 0.55)",
    shadowStrong: "0 28px 75px -24px rgba(3, 2, 12, 0.72)",
  },
  dawn: {
    shadowSoft: "0 18px 45px -28px rgba(63, 49, 86, 0.22)",
    shadowStrong: "0 32px 85px -36px rgba(99, 80, 128, 0.28)",
  },
} as const;

const FALLBACK_SERIF = '"Lora", "Crimson Text", Georgia, serif';
const FALLBACK_SCRIPT = '"Cormorant Garamond", "Cinzel", serif';
const FALLBACK_HEADING = '"Cinzel", "Cormorant Garamond", "Times New Roman", serif';
const FALLBACK_ACCENT = '"Cormorant Garamond", "Cinzel", serif';

const THEME_FIELD_SET = new Set<string>(ALL_FIELDS);

const PLAIN_READING_ROUTE_PATTERNS = [
  /^\/post\//,
  /^\/entities\//,
  /^\/curses\//,
  /^\/tools\//,
  /^\/about(\/|$)/,
  /^\/privacy(\/|$)/,
];

// Utility Functions
const sanitizeColor = (value: string | null | undefined, fallback: string): string => {
  const trimmed = typeof value === "string" ? value.trim() : "";
  return /^#[0-9a-fA-F]{3,8}$/.test(trimmed) ? trimmed : fallback;
};

const sanitizeToken = (value: string | null | undefined, fallback: string): string => {
  const trimmed = typeof value === "string" ? value.trim() : "";
  return trimmed || fallback;
};

const formatFontStack = (value: string | null | undefined, fallback: string): string => {
  const trimmed = typeof value === "string" ? value.trim() : "";
  if (!trimmed) return fallback;

  const sanitized = trimmed.replace(/[<>]/g, "");
  const escaped = sanitized.replace(/["\\]/g, "\\$&");
  const needsQuotes = /[\s,]/.test(escaped);
  const primary = needsQuotes ? `"${escaped}"` : escaped;

  return `${primary}, ${fallback}`;
};

const toKebabCase = (value: string): string => value.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();

const buildThemeCss = (
  theme: typeof midnightTheme,
  selector: string,
  mode: ThemeMode,
): string => {
  const fallbacks = FALLBACK_COLORS[mode];
  const textFallback = FALLBACK_TEXT[mode];
  const statusFallback = FALLBACK_STATUS_COLORS[mode];
  const shadowFallback = FALLBACK_SHADOWS[mode];

  const primary = sanitizeColor(theme?.primary, fallbacks.primary);
  const accent = sanitizeColor(theme?.accent, fallbacks.accent);
  const background = sanitizeColor(theme?.background, fallbacks.background);

  const serifStack = formatFontStack(theme?.fontSerif, FALLBACK_SERIF);
  const scriptStack = formatFontStack(theme?.fontScript, FALLBACK_SCRIPT);
  const headingStack = formatFontStack(theme?.fontHeading ?? theme?.fontSerif, FALLBACK_HEADING);
  const accentStack = formatFontStack(theme?.fontAccent ?? theme?.fontScript, FALLBACK_ACCENT);

  const colorNightBase = sanitizeToken(theme?.colorNight, `color-mix(in srgb, ${background} 85%, black 15%)`);
  const colorInkBase = sanitizeToken(theme?.colorInk, `color-mix(in srgb, ${background} 18%, black 82%)`);
  const overlay = `color-mix(in srgb, ${background} 45%, transparent 55%)`;
  const overlayStrong = `color-mix(in srgb, ${background} 68%, transparent 32%)`;
  const plainSurface = `color-mix(in srgb, ${background} 92%, black 8%)`;
  const plainBorder = `color-mix(in srgb, ${primary} 28%, transparent 72%)`;
  const inkBody = `color-mix(in srgb, ${colorInkBase} 70%, ${colorNightBase} 30%)`;
  const inkStrong = `color-mix(in srgb, ${colorInkBase} 85%, ${colorNightBase} 15%)`;
  const inkMuted = `color-mix(in srgb, ${colorInkBase} 55%, white 45%)`;
  const focusRingColor = sanitizeToken(
    theme?.focusRingColor,
    `color-mix(in srgb, ${primary} 60%, ${accent} 40%)`,
  );
  const focusRingShadow = sanitizeToken(
    theme?.cardFocusOutline,
    `0 0 0 2px color-mix(in srgb, ${background} 65%, transparent 35%), 0 0 0 4px color-mix(in srgb, ${focusRingColor} 80%, white 20%)`,
  );

  const defaults: Record<string, string> = {
    primary,
    accent,
    background,
    colorMidnight: sanitizeToken(theme?.colorMidnight, background),
    colorNight: colorNightBase,
    colorDusk: sanitizeToken(theme?.colorDusk, `color-mix(in srgb, ${background} 65%, white 35%)`),
    colorIris: sanitizeToken(theme?.colorIris, primary),
    colorAmethyst: sanitizeToken(theme?.colorAmethyst, `color-mix(in srgb, ${primary} 70%, white 30%)`),
    colorFog: sanitizeToken(theme?.colorFog, `color-mix(in srgb, ${primary} 30%, white 70%)`),
    colorGold: sanitizeToken(theme?.colorGold, accent),
    colorRune: sanitizeToken(theme?.colorRune, `color-mix(in srgb, ${background} 12%, white 88%)`),
    colorInk: colorInkBase,
    colorMuted: sanitizeToken(theme?.colorMuted, `color-mix(in srgb, ${primary} 18%, transparent 82%)`),
    colorBorder: sanitizeToken(theme?.colorBorder, `color-mix(in srgb, ${primary} 28%, transparent 72%)`),
    colorBorderStrong: sanitizeToken(theme?.colorBorderStrong, `color-mix(in srgb, ${primary} 42%, transparent 58%)`),
    colorOverlay: sanitizeToken(theme?.colorOverlay, overlay),
    colorOverlayStrong: sanitizeToken(theme?.colorOverlayStrong, overlayStrong),
    surfacePlain: sanitizeToken(theme?.surfacePlain, plainSurface),
    surfacePlainBorder: sanitizeToken(theme?.surfacePlainBorder, plainBorder),
    inkBody,
    inkStrong,
    inkMuted,
    linkColor: sanitizeToken(theme?.linkColor, textFallback.linkColor),
    textPrimary: sanitizeToken(theme?.textPrimary, textFallback.textPrimary),
    textHeading: sanitizeToken(theme?.textHeading, textFallback.textHeading),
    textSecondary: sanitizeToken(theme?.textSecondary, textFallback.textSecondary),
    textTertiary: sanitizeToken(theme?.textTertiary, textFallback.textTertiary),
    textHint: sanitizeToken(theme?.textHint, textFallback.textHint),
    textDisabled: sanitizeToken(theme?.textDisabled, textFallback.textDisabled),
    textBody: sanitizeToken(theme?.textBody, textFallback.textBody),
    textSubtle: sanitizeToken(theme?.textSubtle, textFallback.textSubtle),
    textAccent: sanitizeToken(theme?.textAccent, textFallback.textAccent),
    textAccentStrong: sanitizeToken(theme?.textAccentStrong, textFallback.textAccentStrong),
    textStrong: sanitizeToken(theme?.textStrong, textFallback.textStrong),
    textMuted: sanitizeToken(theme?.textMuted, textFallback.textMuted),
    focusRingColor,
    focusRingShadow,
    success: sanitizeToken(theme?.success, statusFallback.success),
    warning: sanitizeToken(theme?.warning, statusFallback.warning),
    error: sanitizeToken(theme?.error, statusFallback.error),
    info: sanitizeToken(theme?.info, statusFallback.info),
    shadowSoft: sanitizeToken(theme?.shadowSoft, shadowFallback.shadowSoft),
    shadowStrong: sanitizeToken(theme?.shadowStrong, shadowFallback.shadowStrong),
    cardFocusOutline: focusRingShadow,
  };

  const tokens = new Map<string, string>();
  for (const [key, value] of Object.entries(defaults)) {
    tokens.set(`--${toKebabCase(key)}`, value);
  }

  tokens.set("--color-amethyst", defaults.colorAmethyst!);
  tokens.set("--color-fog", defaults.colorFog!);
  tokens.set("--focus-ring-shadow", focusRingShadow);
  tokens.set("--focus-ring-color", focusRingColor);
  tokens.set("--primary", primary);
  tokens.set("--accent", accent);
  tokens.set("--background", background);

  const fontSerifStack = serifStack;
  const fontScriptStack = scriptStack;
  tokens.set("--font-serif", fontSerifStack);
  tokens.set("--font-body-serif", fontSerifStack);
  tokens.set("--font-body", fontSerifStack);
  tokens.set("--font-heading", headingStack);
  tokens.set("--font-accent", accentStack);
  tokens.set("--font-script", fontScriptStack);

  const themeEntries = Object.entries(theme ?? {});
  for (const [rawKey, rawValue] of themeEntries) {
    if (!THEME_FIELD_SET.has(rawKey)) continue;
    if (typeof rawValue !== "string") continue;
    const trimmed = rawValue.trim();
    if (!trimmed) continue;

    switch (rawKey) {
      case "primary":
        tokens.set("--primary", sanitizeColor(trimmed, primary));
        break;
      case "accent":
        tokens.set("--accent", sanitizeColor(trimmed, accent));
        break;
      case "background":
        tokens.set("--background", sanitizeColor(trimmed, background));
        tokens.set("--color-midnight", sanitizeColor(trimmed, background));
        break;
      case "fontSerif": {
        const stack = formatFontStack(trimmed, FALLBACK_SERIF);
        tokens.set("--font-serif", stack);
        tokens.set("--font-body-serif", stack);
        tokens.set("--font-body", stack);
        break;
      }
      case "fontScript": {
        const stack = formatFontStack(trimmed, FALLBACK_SCRIPT);
        tokens.set("--font-script", stack);
        tokens.set("--font-accent", stack);
        break;
      }
      case "fontHeading":
        tokens.set("--font-heading", formatFontStack(trimmed, headingStack));
        break;
      case "fontAccent":
        tokens.set("--font-accent", formatFontStack(trimmed, accentStack));
        break;
      case "backgroundImage":
        tokens.set("--background-image", trimmed);
        break;
      case "cardFocusOutline":
        tokens.set("--card-focus-outline", sanitizeToken(trimmed, tokens.get("--card-focus-outline") ?? focusRingShadow));
        tokens.set("--focus-ring-shadow", sanitizeToken(trimmed, focusRingShadow));
        break;
      case "focusRingColor":
        tokens.set("--focus-ring-color", sanitizeToken(trimmed, focusRingColor));
        break;
      case "focusRingShadow":
        tokens.set("--focus-ring-shadow", sanitizeToken(trimmed, focusRingShadow));
        break;
      default: {
        const cssVar = `--${toKebabCase(rawKey)}`;
        const fallback = tokens.get(cssVar) ?? "";
        tokens.set(cssVar, sanitizeToken(trimmed, fallback || trimmed));
        break;
      }
    }
  }

  const declarations = Array.from(tokens.entries())
    .map(([key, value]) => `  ${key}: ${value};`)
    .join("\n");

  return `${selector} {\n${declarations}\n}`;
};

const normalizeClassList = (value: string | string[] | null | undefined): string[] => {
  if (!value) return [];

  const values = Array.isArray(value) ? value : [value];

  return values
    .filter((item): item is string => typeof item === "string")
    .flatMap((item) => item.split(/\s+/g).filter(Boolean));
};

const normalizeAccountLink = (
  link: { href: string; label: string; rel?: string },
  showAccountLink: boolean,
) => {
  if (link.href !== "/account/") return link;
  if (!showAccountLink) return null;
  return { ...link, href: "/about/#membership" };
};

// Settings and Theme Configuration
const settings = readSettings();
const analytics = buildAnalyticsInjection(settings);
const brandName = settings.brandName ?? "WitchClick";
const disclosure = settings.disclosure ?? "";
const showAccountLink = settings.showAccountLink ?? false;

// Theme Setup
// getActiveThemes memoizes in production but automatically re-reads when
// the admin saves new presets. See src/utils/theme.ts for cache details.
const { midnight: midnightTheme, dawn: dawnTheme } = getActiveThemes();
const midnightCss = buildThemeCss(midnightTheme, ":root", "midnight");
const dawnCss = buildThemeCss(dawnTheme, ':root[data-comfort-theme="dawn"]', "dawn");
const themeStyle = `${midnightCss}\n\n${dawnCss}`;
const themeMetaColor = sanitizeColor(midnightTheme?.primary, FALLBACK_COLORS.midnight.primary);

// Ambient Color Configuration
const fallbackPrimary = sanitizeColor(midnightTheme?.primary, FALLBACK_COLORS.midnight.primary);
const fallbackAccent = sanitizeColor(midnightTheme?.accent, FALLBACK_COLORS.midnight.accent);
const fallbackBackground = sanitizeColor(
  midnightTheme?.background,
  FALLBACK_COLORS.midnight.background,
);

const ambientBase = sanitizeColor(ambientColor, fallbackPrimary);
const ambientHighlight = mixColors(ambientBase, "#ffffff", 0.24);
const ambientAurora = mixColors(ambientBase, fallbackAccent, 0.45);
const ambientDepth = mixColors(ambientBase, fallbackBackground, 0.52);
const ambientShadow = mixColors(fallbackBackground, "#000000", 0.32);
const ambientOverlay = mixColors(ambientBase, "#000000", 0.18);

const bodyStyleEntries = [
  ["--ambient-color", ambientBase],
  ["--ambient-highlight", ambientHighlight],
  ["--ambient-aurora", ambientAurora],
  ["--ambient-depth", ambientDepth],
  ["--ambient-shadow", ambientShadow],
  ["--ambient-overlay", ambientOverlay],
] as const;

const bodyStyle = bodyStyleEntries.map(([key, value]) => `${key}: ${value}`).join("; ");

// SEO and Meta Configuration
const ogUrl = ogImage ? toAbsoluteUrl(ogImage, settings) : "";
const fallbackOgImage = toAbsoluteUrl(
  "/images/hero/focus-hub-intro/tea-and-light-in-the-morning.png",
  settings,
);
const resolvedOgImage = ogUrl || fallbackOgImage;
const canonicalUrl = buildCanonicalUrl(settings, { canonical: canon, astroUrl: Astro.url ?? null });

// Navigation Configuration
const currentPath = Astro.url?.pathname ?? "/";
const isPlainReadingRoute = PLAIN_READING_ROUTE_PATTERNS.some((pattern) => pattern.test(currentPath));

const mainClassList = [
  "site-main",
  isPlainReadingRoute && "site-main--plain",
  ...normalizeClassList(mainClassProp),
].filter(Boolean);

const containerClassList = [
  "site-main__container",
  "wc-container",
  wide && "site-main__container--wide",
  desktopWide && "site-main__container--desktop-wide",
  isPlainReadingRoute && "site-main__container--plain",
  ...normalizeClassList(containerClassProp),
].filter(Boolean);

const contentClassList = ["site-main__content", ...normalizeClassList(contentClassProp)].filter(Boolean);

const navLinks = primaryNavLinks;
const secondaryLinks = secondaryNavLinks;
const headerUtility = headerUtilityLinks
  .map((link) => normalizeAccountLink(link, showAccountLink))
  .filter((link): link is typeof headerUtilityLinks[number] => Boolean(link));
const footerUtilities = footerUtilityLinks
  .map((link) => normalizeAccountLink(link, showAccountLink))
  .filter((link): link is typeof footerUtilityLinks[number] => Boolean(link));

const isDev = import.meta.env.DEV;
const adminSections = isDev ? adminNavSections : [];

// Observability Configuration
const observabilitySettings = settings.observability ?? { enabled: false };
const debugQuery = Astro.url?.searchParams.get("debug") ?? "";
const debugMode = debugQuery === "1";
const siteEnvironment = observabilitySettings.environment ?? (isDev ? "development" : "production");
const shouldLoadObservability = debugMode || (observabilitySettings.enabled && !isDev);

const observabilityConfig = shouldLoadObservability
  ? {
      enabled: Boolean(observabilitySettings.enabled),
      dsn: observabilitySettings.dsn ?? null,
      environment: observabilitySettings.environment ?? null,
      clientErrorEndpoint:
        observabilitySettings.enabled && settings.clientErrorEndpoint
          ? settings.clientErrorEndpoint
          : null,
      debug: debugMode,
      siteEnvironment,
      featureFlags: {
        observability: Boolean(observabilitySettings.enabled),
        analytics: Boolean(settings.analytics?.enabled),
        ads: Boolean(settings.ads?.provider),
      },
    }
  : null;

// Theme Scope Detection
// Determines which theme scope to apply based on the current route
function detectThemeScope(pathname: string): string | null {
  // Homepage
  if (pathname === "/" || pathname === "") {
    return "homepage";
  }

  // Entity Grimoire (main entities directory page)
  if (pathname === "/entities" || pathname === "/entities/") {
    return "grimoire";
  }

  // Individual entity detail pages
  if (/^\/entities\/[^/]+\/[^/]+\/?$/.test(pathname)) {
    return "entity-detail";
  }

  // Post detail pages
  if (/^\/post\/[^/]+\/?$/.test(pathname)) {
    return "post";
  }

  // Start/getting started page
  if (pathname === "/start" || pathname === "/start/") {
    return "start";
  }

  // No specific scope - use global theme
  return null;
}

// Detect theme scope for the current page (reusing existing currentPath variable)
const themeScope = detectThemeScope(currentPath);

// Get active theme slugs for both modes (midnight is default)
const midnightThemeSlug = midnightTheme?.slug || 'cozy-midnight';
const dawnThemeSlug = dawnTheme?.slug || 'cozy-dawn';
---

<!doctype html>
<html lang="en" class="h-full" data-scope={themeScope || undefined} data-theme={midnightThemeSlug} data-theme-midnight={midnightThemeSlug} data-theme-dawn={dawnThemeSlug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:site_name" content={brandName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={resolvedOgImage} />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />
    
    <!-- Theme Color -->
    <meta name="theme-color" content={themeMetaColor} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Theme Styles -->
    <style is:inline set:html={themeStyle}></style>
    
    <!-- Theme Preference Script (must run before body render) -->
    <script is:inline>
      (() => {
        const STORAGE_KEY = 'witchclick-comfort';
        const LEGACY_KEYS = ['comfort-preferences'];

        const migrateLegacy = () => {
          try {
            if (localStorage.getItem(STORAGE_KEY)) return;
            for (const key of LEGACY_KEYS) {
              const value = localStorage.getItem(key);
              if (value) {
                localStorage.setItem(STORAGE_KEY, value);
                localStorage.removeItem(key);
                break;
              }
            }
          } catch (error) {
            /* no-op */
          }
        };

        const readPrefs = () => {
          migrateLegacy();
          try {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (!stored) return null;
            const parsed = JSON.parse(stored);
            if (!parsed || typeof parsed !== 'object') return null;
            return {
              theme: parsed.theme === 'dawn' ? 'dawn' : null,
              font: parsed.font === 'sans' ? 'sans' : null,
            };
          } catch (error) {
            return null;
          }
        };

        try {
          const prefs = readPrefs();
          const root = document.documentElement;

          if (!root) return;

          const applyTheme = (theme) => {
            if (theme === 'dawn') {
              root.setAttribute('data-comfort-theme', 'dawn');
              const dawnSlug = root.getAttribute('data-theme-dawn');
              if (dawnSlug) {
                root.setAttribute('data-theme', dawnSlug);
              }
            } else {
              root.removeAttribute('data-comfort-theme');
              const midnightSlug = root.getAttribute('data-theme-midnight');
              if (midnightSlug) {
                root.setAttribute('data-theme', midnightSlug);
              }
            }
          };

          const applyFont = (font) => {
            if (font) {
              root.setAttribute('data-comfort-font', font);
            } else {
              root.removeAttribute('data-comfort-font');
            }
          };

          const syncBody = (theme, font) => {
            const body = document.body;
            if (!body) return;

            if (theme === 'dawn') {
              body.setAttribute('data-comfort-theme', 'dawn');
            } else {
              body.removeAttribute('data-comfort-theme');
            }

            if (font) {
              body.setAttribute('data-comfort-font', font);
            } else {
              body.removeAttribute('data-comfort-font');
            }
          };

          if (!prefs) {
            applyTheme(null);
            applyFont(null);

            const clearBody = () => syncBody(null, null);
            if (document.readyState === 'complete') {
              clearBody();
            } else {
              document.addEventListener('DOMContentLoaded', clearBody, { once: true });
            }
            return;
          }

          applyTheme(prefs.theme);
          applyFont(prefs.font);

          const applyBody = () => syncBody(prefs.theme, prefs.font);

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', applyBody, { once: true });
          } else {
            applyBody();
          }
        } catch (error) {
          // Silent fail - preferences will use defaults
        }
      })();
    </script>

    <slot name="head" />
  </head>
  
  <body
    id="top"
    class:list={[
      "site-shell",
      wide && "is-wide",
      desktopWide && "is-desktop-wide",
      isPlainReadingRoute && "site-shell--plain",
    ].filter(Boolean)}
    style={bodyStyle}
    data-entity-type={bodyDataType || undefined}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- Base.astro: persistent theme loader (runtime site-wide)

         This script applies custom theme tokens on every page load.
         Token System Architecture:
         - localStorage key: "wc-active-theme" (set by theme-manager.ts)
         - Token format: HSL for colors, hex for status colors
         - Aligned with: src/styles/tokens.css (fallback defaults)
         - Aligned with: theme-manager.ts applyThemeToDocument()

         Both admin and public pages use identical token names for consistency.
    -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("wc-active-theme");
          if (!saved) {
            console.log("[Theme] No saved theme in localStorage");
            return;
          }
          const t = JSON.parse(saved);
          console.log("[Theme] Loaded theme from localStorage:", t.slug, t.mode);
          console.log("[Theme] Tokens:", t.tokens);
          const root = document.documentElement;

          // set mode attributes
          const modeAttr = t.id && t.id.includes("dawn") || t.mode === "light" || t.mode === "dawn" ? "dawn" : "midnight";
          // Use actual theme slug instead of hardcoded values
          const themeSlug = t.slug || t.id || (modeAttr === "dawn" ? "cozy-dawn" : "cozy-midnight");
          root.setAttribute("data-theme", themeSlug);
          // Only set data-comfort-theme for dawn mode (matches applyThemeToDocument behavior)
          if (modeAttr === "dawn") {
            root.setAttribute("data-comfort-theme", "dawn");
          } else {
            root.removeAttribute("data-comfort-theme");
          }

          // apply tokens
          const map = {
            "--accent-1": "accent1","--accent-2": "accent2","--accent-3": "accent3",
            "--surface-base": "surfaceBase","--surface-panel": "surfacePanel","--surface-card": "surfaceCard",
            "--surface-elevated": "surfaceElevated","--surface-hover": "surfaceHover",
            "--text-strong": "textStrong","--text-body": "textBody","--text-muted": "textMuted",
            "--border-subtle": "borderSubtle","--border-strong": "borderStrong",
            "--page-bg-base": "pageBackground",
            "--header-bg-base": "headerBackground","--header-border-base": "headerBorder",
            "--footer-bg-base": "footerBackground","--footer-border-base": "footerBorder"
          };
          const tokens = t.tokens || {};
          let appliedCount = 0;
          Object.entries(map).forEach(([cssVar, key]) => {
            const val = tokens[key];
            if (typeof val === "string" && val.startsWith("hsl(")) {
              // Strip "hsl(" prefix and ")" suffix to get just the HSL components
              const stripped = val.replace("hsl(", "").replace(")", "");
              root.style.setProperty(cssVar, stripped);
              appliedCount++;
            } else if (val) {
              console.warn("[Theme] Token", key, "has unexpected format:", val);
            }
          });
          console.log("[Theme] Applied", appliedCount, "HSL tokens");

          // Status colors (plain hex values)
          const statusMap = {
            "--success": "success","--warning": "warning","--error": "error","--info": "info"
          };
          let statusCount = 0;
          Object.entries(statusMap).forEach(([cssVar, key]) => {
            const val = tokens[key];
            if (typeof val === "string" && val.startsWith("#")) {
              root.style.setProperty(cssVar, val);
              statusCount++;
            }
          });
          console.log("[Theme] Applied", statusCount, "status color tokens");

          // derive accent-linked globals
          const get = (v) => getComputedStyle(root).getPropertyValue(v).trim();
          const accent1Value = get("--accent-1");
          const accent1Full = `hsl(${accent1Value})`;
          root.style.setProperty("--text-accent", accent1Value);
          root.style.setProperty("--ring-focus", `0 0 0 3px ${accent1Full}`);
          root.style.setProperty("--link-color", accent1Full);

          // DEBUG: Check computed values for background/header/footer/cards
          console.log("[Theme] DEBUG - Runtime token values:");
          console.log("  --page-bg-base:", get("--page-bg-base"));
          console.log("  --page-bg-color:", get("--page-bg-color"));
          console.log("  --layout-shell-background:", get("--layout-shell-background"));
          console.log("  --header-bg-base:", get("--header-bg-base"));
          console.log("  --footer-bg-base:", get("--footer-bg-base"));
          console.log("  --surface-card:", get("--surface-card"));

          console.log("[Theme] Theme application complete");
        } catch (e) {
          console.error("[Theme] Error applying theme:", e);
        }
      })();
    </script>

    <Header
      brandName={brandName}
      navLinks={navLinks}
      secondaryLinks={secondaryLinks}
      utilityLinks={headerUtility}
      adminSections={adminSections}
      currentPath={currentPath}
    />

    <div class="site-shell__content">
      <main
        id="main"
        class:list={mainClassList}
        data-plain-reading={isPlainReadingRoute ? "true" : undefined}
      >
        <div
          class:list={containerClassList}
        >
          <div class="site-main__breadcrumbs">
            <slot name="breadcrumbs" />
          </div>
          <div class:list={contentClassList}>
            <slot />
          </div>
        </div>
      </main>
    </div>

    <Footer
      brandName={brandName}
      navLinks={navLinks}
      secondaryNavLinks={secondaryLinks}
      utilityLinks={footerUtilities}
      disclosure={disclosure}
    />
    
    <!-- Analytics -->
    {analytics?.runtime?.inline && (
      <script is:inline set:html={analytics.runtime.inline}></script>
    )}
    
    <!-- Observability -->
    {observabilityConfig && (
      <script type="module" is:inline define:vars={{ observabilityConfig }}>
        import { initObservability } from "@/utils/observability";
        initObservability(observabilityConfig);
      </script>
    )}
    
    <!-- Card Animations -->
    <script type="module" src={cardAnimationsModule}></script>
  </body>
</html>
