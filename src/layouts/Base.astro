---
/* src/layouts/Base.astro */
import "../styles/base.css";
import "../styles/tailwind.css";
import "../styles/cards.css";
import Header from "@/components/Header.astro";
import { typeMetadata } from "../data/typeMetadata";
import { readSettings, getSiteOrigin, toAbsoluteUrl } from "../utils/settings";
import { buildAnalyticsInjection } from "../utils/analytics";
import { getTheme } from "../utils/theme";
import { mixColors, resolveTailwindColor, toRgba } from "../utils/color";
import { Fragment } from "astro/jsx-runtime";

const props = Astro.props || {};
const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  desktopWide = false,
  ogImage = "",
  noindex = false,
  bodyDataType = undefined,
  ambientColor,
} = props;

const settings = readSettings();
const brandName = settings.brandName ?? "WitchClick";
const siteOrigin = getSiteOrigin(settings);
const here = Astro.url?.pathname ?? "/";

const canonicalUrl = canon
  ? canon.startsWith("http")
    ? canon
    : toAbsoluteUrl(canon, settings)
  : siteOrigin
    ? `${siteOrigin}${here}`
    : "";

const pageTitle = title && title !== brandName ? `${title} — ${brandName}` : brandName;
const ogImg = ogImage ? toAbsoluteUrl(ogImage, settings) : (siteOrigin ? `${siteOrigin}/og-default.png` : "");
const theme = getTheme();
const analyticsInjection = buildAnalyticsInjection(settings);

const headerWidthClass = desktopWide
  ? "w-full max-w-7xl 2xl:max-w-[92rem]"
  : wide
    ? "w-full max-w-6xl xl:max-w-7xl"
    : "w-full max-w-5xl lg:max-w-6xl";
const mainWidthClass = desktopWide
  ? "w-full max-w-7xl 2xl:max-w-[92rem]"
  : wide
    ? "w-full max-w-6xl xl:max-w-7xl"
    : "w-full max-w-5xl lg:max-w-6xl";
const layoutPaddingClass = desktopWide ? "px-4 sm:px-6 lg:px-8 xl:px-12 2xl:px-16" : "px-4";
const layoutContentClass = ["layout-content", desktopWide && "layout-content--desktop"].filter(Boolean).join(" ");

const grimoireChapters = Object.entries(typeMetadata).map(([type, metadata]) => ({
  title: metadata.title,
  icon: metadata.icon,
  href: `/entities/${type}`,
}));

const headingFont = "Cinzel";
const accentFont = "Cormorant Garamond";
const bodyFont = "Lora";

const primaryLinks = [
  { href: "/", label: "Rituals" },
  { href: "/entities", label: "Entity Library" },
  { href: "/tools/", label: "Tools & Prints" },
];

const secondaryLinks = [
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const devLinks = import.meta.env.DEV
  ? [
      { href: "/admin", label: "Post Generator", rel: "nofollow" },
      { href: "/admin/write", label: "Write", rel: "nofollow" },
      { href: "/admin/entities", label: "Entities Admin", rel: "nofollow" },
      { href: "/admin/downloads", label: "Downloads Admin", rel: "nofollow" },
      { href: "/admin/hero", label: "Hero Uploader", rel: "nofollow" },
    ]
  : [];
const footerUtilityLinks = [
  { href: "/rss.xml", label: "RSS" },
  { href: "/sitemap-index.xml", label: "Sitemap" },
  { href: "/privacy", label: "Privacy" },
];

const backgroundLayers = [
  "radial-gradient(120% 180% at 50% 0%, rgba(212, 175, 55, 0.16) 0%, transparent 65%)",
  "radial-gradient(150% 120% at 12% 22%, rgba(124, 78, 176, 0.18) 0%, transparent 72%)",
  "radial-gradient(180% 150% at 88% -12%, rgba(59, 31, 89, 0.32) 0%, transparent 70%)",
  "linear-gradient(180deg, #07020f 0%, #120725 100%)",
].join(", ");

const ambientBase = ambientColor ?? theme.primary;
const ambientLight = mixColors("#ffffff", ambientBase, 0.18);
const ambientDeep = mixColors("#0f172a", ambientBase, 0.3);
const ambientGlass = toRgba(ambientBase, 0.14);
const ambientGlassBorder = toRgba(mixColors("#e2e8f0", ambientBase, 0.45), 0.55);
const ambientPillBorder = toRgba(mixColors("#c7d2fe", ambientBase, 0.3), 0.4);
const ambientPillText = toRgba(mixColors("#312e81", ambientBase, 0.45), 0.88);
const ambientPillTextActive = toRgba(mixColors("#1e1b4b", ambientBase, 0.55), 0.95);
const footerSurfaceTop = toRgba(mixColors("#ffffff", ambientBase, 0.22), 0.85);
const footerSurfaceBottom = toRgba(mixColors("#fdf4ff", ambientBase, 0.32), 0.7);
const footerBorder = toRgba(mixColors("#cbd5f5", ambientBase, 0.35), 0.5);
const footerText = mixColors("#1f2937", ambientBase, 0.3);
const footerMuted = toRgba(mixColors("#475569", ambientBase, 0.35), 0.82);
const bodyOverlay = `linear-gradient(160deg, ${toRgba(ambientLight, 0.55)} 0%, ${toRgba(
  ambientBase,
  0.12
)} 35%, ${toRgba(ambientDeep, 0.32)} 75%, transparent 100%)`;
const contentTexture = `radial-gradient(circle at 12% 18%, ${toRgba(ambientBase, 0.08)}, transparent 55%), radial-gradient(circle at 80% 12%, ${toRgba(
  ambientLight,
  0.12
)}, transparent 60%)`;

const activeTypeMetadata = bodyDataType
  ? typeMetadata[bodyDataType as keyof typeof typeMetadata]
  : undefined;
const grimoireRingColor = activeTypeMetadata
  ? resolveTailwindColor(activeTypeMetadata.themeColor)
  : undefined;

const bodyStyle = `
  --color-primary: ${theme.primary};
  --color-accent: ${theme.accent};
  --color-background: ${theme.background};
  --font-body: '${bodyFont}', '${theme.fontSerif}', 'Lora', 'Crimson Text', Georgia, serif;
  --font-heading: '${headingFont}', '${theme.fontSerif}', 'Cormorant Garamond', 'Times New Roman', serif;
  --font-accent: '${accentFont}', '${theme.fontScript}', '${theme.fontSerif}', serif;
  --font-serif: var(--font-heading);
  --font-script: '${accentFont}', '${theme.fontScript}', cursive;
  --ambient-color: ${ambientBase};
  --glass-panel-overlay: ${ambientGlass};
  --glass-panel-border: ${ambientGlassBorder};
  --glass-pill-border: ${ambientPillBorder};
  --glass-pill-border-active: ${toRgba(mixColors("#818cf8", ambientBase, 0.35), 0.55)};
  --glass-pill-text: ${ambientPillText};
  --glass-pill-text-active: ${ambientPillTextActive};
  --panel-muted-surface: linear-gradient(165deg, ${footerSurfaceTop} 0%, ${footerSurfaceBottom} 100%);
  --panel-muted-border: ${footerBorder};
  --panel-muted-text: ${footerMuted};
  --panel-muted-heading: ${footerText};
  --body-overlay: ${bodyOverlay};
  --content-texture: ${contentTexture};
  --grimoire-ring-color: ${grimoireRingColor ?? "var(--glass-pill-border-active)"};
  background: ${backgroundLayers};
  color: var(--color-ink, #f4f1ff);
`;
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* Social defaults */}
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImg && <meta property="og:image" content={ogImg} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={theme.primary} />
    <meta name="color-scheme" content="light" />

    {/* Discoverability helpers */}
    <link rel="alternate" type="application/rss+xml" title={`${brandName} RSS`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {/* Fonts perf */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />

    {analyticsInjection?.head && <Fragment set:html={analyticsInjection.head} />}

    <style is:inline>
      :root {
        font-family: var(--font-body);
        --glass-panel-radius: 1.75rem;
        --glass-panel-border: rgba(126, 90, 173, 0.35);
        --glass-panel-blur: 20px;
        --glass-panel-surface: rgba(28, 14, 38, 0.92);
        --glass-panel-overlay: rgba(124, 78, 176, 0.18);
        --glass-panel-shadow: 0 20px 45px -25px rgba(3, 2, 12, 0.55);
        --glass-panel-shadow-hover: 0 28px 60px -28px rgba(3, 2, 12, 0.68);
        --glass-pill-gradient-start: rgba(212, 175, 55, 0.8);
        --glass-pill-gradient-end: rgba(124, 78, 176, 0.6);
        --glass-pill-border: rgba(212, 175, 55, 0.45);
        --glass-pill-border-active: rgba(212, 175, 55, 0.65);
        --glass-pill-text: rgba(244, 241, 255, 0.85);
        --glass-pill-text-active: rgba(7, 2, 15, 0.92);
        --panel-muted-surface: rgba(21, 8, 32, 0.85);
        --panel-muted-border: rgba(124, 78, 176, 0.25);
        --panel-muted-text: rgba(244, 241, 255, 0.78);
        --panel-muted-heading: rgba(212, 175, 55, 0.95);
      }

      h1,
      h2,
      h3,
      .font-serif {
        font-family: var(--font-serif);
      }

      .font-script {
        font-family: var(--font-script);
      }

      h1.font-serif {
        line-height: 1.05;
      }

      body {
        transition: background 420ms ease, color 220ms ease;
      }

      .layout-content {
        position: relative;
        z-index: 0;
      }

      .layout-content::before {
        content: "";
        position: absolute;
        inset: -1.5rem 0 0;
        border-radius: clamp(2rem, 6vw, 3.5rem);
        background:
          radial-gradient(120% 120% at 18% 6%, rgba(212, 175, 55, 0.22), transparent 72%),
          radial-gradient(140% 120% at 88% 8%, rgba(124, 78, 176, 0.28), transparent 75%),
          linear-gradient(180deg, rgba(7, 2, 15, 0.55), rgba(7, 2, 15, 0.9));
        opacity: 0.32;
        pointer-events: none;
        z-index: -1;
      }

      .layout-content--desktop::after {
        content: "";
        position: absolute;
        inset: -2rem;
        border-radius: clamp(2.5rem, 6vw, 3.75rem);
        pointer-events: none;
        opacity: 0;
        z-index: -1;
        transition: opacity 320ms ease;
      }

      @media (min-width: 1024px) {
        .layout-content--desktop::after {
          opacity: 1;
          background:
            radial-gradient(70% 90% at 15% 18%, rgba(212, 175, 55, 0.25), transparent 72%),
            radial-gradient(80% 85% at 90% 15%, rgba(124, 78, 176, 0.25), transparent 68%),
            linear-gradient(180deg, rgba(18, 7, 37, 0.25), transparent 65%);
        }
      }

      .layout-content > * {
        position: relative;
        z-index: 1;
      }
    </style>

    {/* Page-level head slot */}
    <slot name="head" />
  </head>

  <body class="min-h-screen" style={bodyStyle} data-type={bodyDataType}>
    {analyticsInjection?.config && <Fragment set:html={analyticsInjection.config} />}

    <style is:inline>
      :global(html),
      :global(body) {
        background:
          radial-gradient(120% 180% at 50% 0%, rgba(212, 175, 55, 0.16) 0%, transparent 65%),
          radial-gradient(150% 120% at 12% 22%, rgba(124, 78, 176, 0.18) 0%, transparent 72%),
          radial-gradient(180% 150% at 88% -12%, rgba(59, 31, 89, 0.32) 0%, transparent 70%),
          linear-gradient(180deg, #07020f 0%, #120725 100%);
        background-attachment: fixed, fixed, fixed, fixed;
        background-repeat: no-repeat, no-repeat, no-repeat, no-repeat;
        background-size: cover, cover, cover, cover;
      }
    </style>
    {/* Skip link for a11y */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 rounded bg-black px-3 py-2 text-white"
    >
      Skip to content
    </a>

    <Header />

    <main
      id="main"
      class:list={[
        "mx-auto w-full max-w-7xl",
        layoutPaddingClass,
        "pb-16",
        layoutContentClass,
      ]}
    >
      <slot />
    </main>

    {/* CTA slot (filled only on posts) */}
    <slot name="cta" />

    <footer class="site-footer">
      <div class:list={["wc-container site-footer__inner", layoutPaddingClass]}>
        <div class="site-footer__grid">
          <div>
            <p class="site-footer__title">WitchClick Grimoire</p>
            <p class="site-footer__blurb">
              Cozy secular rituals, printable planners, and gentle tools to keep your routines feeling enchanted and sustainable.
            </p>
            {settings.disclosure && <p class="site-footer__disclosure">{settings.disclosure}</p>}
          </div>
          <div>
            <p class="site-footer__title">Chapters</p>
            <ul class="site-footer__nav">
              {grimoireChapters.map((chapter) => (
                <li>
                  <a href={chapter.href}>{chapter.title}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="site-footer__title">Quick links</p>
            <ul class="site-footer__nav">
              {[...primaryLinks, ...secondaryLinks].map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
              {devLinks.map((link) => (
                <li>
                  <a href={link.href} rel={link.rel} class="site-footer__link--dev">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="section-divider" aria-hidden="true"></div>
        <div class="site-footer__meta">
          <ul class="site-footer__nav site-footer__nav--inline">
            {footerUtilityLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
            {canonicalUrl && (
              <li>
                <a href={canonicalUrl}>Permalink</a>
              </li>
            )}
          </ul>
          <p class="site-footer__copyright">
            © {new Date().getFullYear()} {brandName}. Crafted under a moonlit sky.
          </p>
        </div>
      </div>
    </footer>

    {/* Optional page-tail slot for per-page scripts */}
    <slot name="foot" />

    {analyticsInjection?.runtime && <Fragment set:html={analyticsInjection.runtime} />}

    <script src="/clickthrough.js" defer></script>
  </body>
</html>
