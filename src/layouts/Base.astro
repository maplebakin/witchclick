---
// src/layouts/Base.astro
import "@/styles/base.css";
import "@/styles/cards.css";
import "@/styles/tailwind.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { readSettings, getSiteOrigin, toAbsoluteUrl } from "@/utils/settings";
import { buildAnalyticsInjection } from "@/utils/analytics";
import { Fragment } from "astro/jsx-runtime";

type LayoutProps = {
  title?: string;
  description?: string;
  canon?: string;
  wide?: boolean;
  desktopWide?: boolean;
  ogImage?: string;
  noindex?: boolean;
  ambientColor?: string;
  bodyDataType?: string;
};

const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  desktopWide = false,
  ogImage = "",
  noindex = false,
  ambientColor = "",
  bodyDataType = "",
} = Astro.props as LayoutProps;

const settings = readSettings();
const siteOrigin = getSiteOrigin(settings);
const analytics = buildAnalyticsInjection(settings);
const brandName = settings.brandName ?? "WitchClick";
const disclosure = settings.disclosure ?? "";
const ogUrl = ogImage ? toAbsoluteUrl(ogImage, settings) : "";
const currentPath = Astro.url?.pathname ?? "/";
const canonicalUrl = canon || (siteOrigin ? `${siteOrigin}${currentPath}` : "");

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/curses/", label: "Curses" },
  { href: "/entities/", label: "Entities" },
  { href: "/tools/", label: "Tools & Prints" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const utilityLinks = [
  { href: "/privacy", label: "Privacy" },
  { href: "/feed.json", label: "Feed" },
  { href: "/rss.xml", label: "RSS" },
];

const isDev = import.meta.env.DEV;
const adminLinks = isDev
  ? [
      { href: "/admin/", label: "Admin" },
      { href: "/admin/write", label: "Write" },
      { href: "/admin/entities", label: "Entities" },
      { href: "/admin/downloads", label: "Downloads" },
      { href: "/admin/hero", label: "Hero Uploads" },
    ]
  : [];

const bodyStyle = ambientColor ? `--ambient-color: ${ambientColor};` : undefined;
const comfortId = Math.random().toString(36).slice(2, 10);
const comfortThemeToggleId = `comfort-theme-${comfortId}`;
const comfortFontToggleId = `comfort-font-${comfortId}`;
---
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#4b2a63" />

    {analytics?.head && <Fragment set:html={analytics.head} />}
    {analytics?.config && <Fragment set:html={analytics.config} />}

    <script is:inline>
      try {
        const stored = localStorage.getItem('witchclick-comfort');
        if (!stored) {
          document.documentElement?.removeAttribute('data-comfort-theme');
          document.documentElement?.removeAttribute('data-comfort-font');
          if (document.readyState === 'complete') {
            document.body?.removeAttribute('data-comfort-theme');
            document.body?.removeAttribute('data-comfort-font');
          } else {
            document.addEventListener(
              'DOMContentLoaded',
              () => {
                document.body?.removeAttribute('data-comfort-theme');
                document.body?.removeAttribute('data-comfort-font');
              },
              { once: true }
            );
          }
        } else {
          const prefs = JSON.parse(stored);
          const root = document.documentElement;
          if (prefs && typeof prefs === 'object' && root) {
            const theme = prefs.theme === 'dawn' ? 'dawn' : null;
            const font = prefs.font === 'sans' ? 'sans' : null;

            if (theme) {
              root.setAttribute('data-comfort-theme', theme);
            } else {
              root.removeAttribute('data-comfort-theme');
            }

            if (font) {
              root.setAttribute('data-comfort-font', font);
            } else {
              root.removeAttribute('data-comfort-font');
            }

            const applyToBody = () => {
              const body = document.body;
              if (!body) return;
              if (theme) {
                body.setAttribute('data-comfort-theme', theme);
              } else {
                body.removeAttribute('data-comfort-theme');
              }
              if (font) {
                body.setAttribute('data-comfort-font', font);
              } else {
                body.removeAttribute('data-comfort-font');
              }
            };

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', applyToBody, { once: true });
            } else {
              applyToBody();
            }
          }
        }
      } catch (error) {
        /* no-op */
      }
    </script>

    <slot name="head" />
  </head>
  <body
    class:list={["site-shell", wide && "is-wide", desktopWide && "is-desktop-wide"].filter(Boolean)}
    style={bodyStyle}
    data-entity-type={bodyDataType || undefined}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <Header
      brandName={brandName}
      navLinks={navLinks}
      adminLinks={adminLinks}
      currentPath={currentPath}
    />
    <div class="comfort-toolbar" role="region" aria-label="Display comfort preferences">
      <div class="wc-container comfort-toolbar__inner">
        <div class="comfort-toolbar__group" role="group" aria-label="Theme and contrast">
          <input
            id={comfortThemeToggleId}
            class="comfort-toolbar__control"
            type="checkbox"
            data-comfort-theme-toggle
          />
          <label class="comfort-toolbar__label" for={comfortThemeToggleId}>
            <span class="comfort-toolbar__title">Gentle dawn theme</span>
            <span class="comfort-toolbar__hint">Softer contrast, parchment glow</span>
          </label>
        </div>
        <div class="comfort-toolbar__group" role="group" aria-label="Body font preference">
          <input
            id={comfortFontToggleId}
            class="comfort-toolbar__control"
            type="checkbox"
            data-comfort-font-toggle
          />
          <label class="comfort-toolbar__label" for={comfortFontToggleId}>
            <span class="comfort-toolbar__title">Sans-serif body text</span>
            <span class="comfort-toolbar__hint">Switch to Inter for easy scanning</span>
          </label>
        </div>
      </div>
    </div>
    <main id="main" class="site-main">
      <div
        class:list={[
          "site-main__container",
          "wc-container",
          wide && "site-main__container--wide",
          desktopWide && "site-main__container--desktop-wide",
        ].filter(Boolean)}
      >
        <slot />
      </div>
    </main>
    <Footer
      brandName={brandName}
      navLinks={navLinks}
      utilityLinks={utilityLinks}
      adminLinks={adminLinks}
      disclosure={disclosure}
    />
    {analytics?.runtime && <Fragment set:html={analytics.runtime} />}
  </body>
</html>

<style is:inline>
  .skip-link {
    position: absolute;
    left: -999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: var(--color-night, #120725);
    color: var(--color-muted, #f4f1ff);
    z-index: 100;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    width: auto;
    height: auto;
  }

  .comfort-toolbar {
    background: rgba(10, 4, 20, 0.6);
    border-bottom: 1px solid rgba(212, 175, 55, 0.22);
    box-shadow: inset 0 -1px 0 rgba(12, 5, 23, 0.35);
  }

  .comfort-toolbar__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: stretch;
    justify-content: flex-end;
    padding: 0.75rem 1.5rem;
  }

  .comfort-toolbar__group {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.32);
    background: rgba(18, 7, 37, 0.72);
    backdrop-filter: blur(12px);
  }

  .comfort-toolbar__control {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 0.35rem;
    border: 1px solid rgba(212, 175, 55, 0.45);
    background: rgba(6, 3, 12, 0.8);
    appearance: none;
    display: grid;
    place-content: center;
    cursor: pointer;
  }

  .comfort-toolbar__control::after {
    content: "";
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 0.2rem;
    background: rgba(212, 175, 55, 0.7);
    transform: scale(0);
    transition: transform 160ms ease;
  }

  .comfort-toolbar__control:checked::after {
    transform: scale(1);
  }

  .comfort-toolbar__control:focus-visible {
    outline: 2px solid rgba(212, 175, 55, 0.65);
    outline-offset: 3px;
  }

  .comfort-toolbar__label {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-body-ui, var(--font-body));
    cursor: pointer;
  }

  .comfort-toolbar__title {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .comfort-toolbar__hint {
    font-size: 0.65rem;
    opacity: 0.75;
  }

  :root[data-comfort-theme="dawn"] .comfort-toolbar {
    background: rgba(250, 245, 236, 0.82);
    border-bottom-color: rgba(122, 94, 154, 0.28);
    box-shadow: inset 0 -1px 0 rgba(214, 200, 236, 0.35);
  }

  :root[data-comfort-theme="dawn"] .comfort-toolbar__group {
    border-color: rgba(122, 94, 154, 0.38);
    background: rgba(255, 252, 247, 0.82);
  }

  :root[data-comfort-theme="dawn"] .comfort-toolbar__control {
    border-color: rgba(122, 94, 154, 0.5);
    background: rgba(247, 240, 232, 0.85);
  }

  :root[data-comfort-theme="dawn"] .comfort-toolbar__control::after {
    background: rgba(122, 94, 154, 0.6);
  }

  :root[data-comfort-theme="dawn"] .comfort-toolbar__hint {
    opacity: 0.85;
  }

  .site-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(120% 160% at 50% 0%, rgba(212, 175, 55, 0.16) 0%, transparent 60%),
      radial-gradient(140% 200% at 10% 20%, rgba(124, 78, 176, 0.22) 0%, transparent 70%),
      linear-gradient(180deg, var(--color-midnight, #07020f) 0%, var(--color-night, #120725) 100%);
    color: var(--color-ink, #f4f1ff);
  }

  .site-main {
    flex: 1 1 auto;
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(3rem, 7vw, 4.5rem);
  }

  .site-main__container {
    display: block;
  }

  .site-main__container--wide {
    max-width: 72rem;
  }

  .site-main__container--desktop-wide {
    max-width: 72rem;
  }

  @media (min-width: 1024px) {
    .site-main__container--desktop-wide {
      max-width: 82rem;
    }
  }
</style>
