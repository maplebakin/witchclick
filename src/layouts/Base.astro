---
// src/layouts/Base.astro
import "@/styles/base.css";
import "@/styles/cards.css";
import "@/styles/tailwind.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import {
  primaryNavLinks,
  secondaryNavLinks,
  headerUtilityLinks,
  footerUtilityLinks,
} from "@/data/navigation";
import { readSettings, getSiteOrigin, toAbsoluteUrl } from "@/utils/settings";
import { buildAnalyticsInjection } from "@/utils/analytics";
import { Fragment } from "astro/jsx-runtime";

type LayoutProps = {
  title?: string;
  description?: string;
  canon?: string;
  wide?: boolean;
  desktopWide?: boolean;
  ogImage?: string;
  noindex?: boolean;
  ambientColor?: string;
  bodyDataType?: string;
};

const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  desktopWide = false,
  ogImage = "",
  noindex = false,
  ambientColor = "",
  bodyDataType = "",
} = Astro.props as LayoutProps;

const settings = readSettings();
const siteOrigin = getSiteOrigin(settings);
const analytics = buildAnalyticsInjection(settings);
const brandName = settings.brandName ?? "WitchClick";
const disclosure = settings.disclosure ?? "";
const ogUrl = ogImage ? toAbsoluteUrl(ogImage, settings) : "";
const currentPath = Astro.url?.pathname ?? "/";
const canonicalUrl = canon || (siteOrigin ? `${siteOrigin}${currentPath}` : "");

const showAccountLink = settings.showAccountLink ?? false;

const normalizeAccountLink = (link: { href: string; label: string; rel?: string }) => {
  if (link.href !== "/account/") return link;
  if (!showAccountLink) return null;
  return { ...link, href: "/about/#membership" };
};

const navLinks = primaryNavLinks;
const secondaryLinks = secondaryNavLinks;
const headerUtility = headerUtilityLinks
  .map(normalizeAccountLink)
  .filter((link): link is typeof headerUtilityLinks[number] => Boolean(link));
const footerUtilities = footerUtilityLinks
  .map(normalizeAccountLink)
  .filter((link): link is typeof footerUtilityLinks[number] => Boolean(link));

const isDev = import.meta.env.DEV;
const adminLinks = isDev
  ? [
      { href: "/admin/", label: "Admin" },
      { href: "/admin/write", label: "Write" },
      { href: "/admin/entities", label: "Entities" },
      { href: "/admin/downloads", label: "Downloads" },
      { href: "/admin/hero", label: "Hero Uploads" },
    ]
  : [];

const bodyStyle = ambientColor ? `--ambient-color: ${ambientColor};` : undefined;
---
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#4b2a63" />

    {analytics?.head && <Fragment set:html={analytics.head} />}
    {analytics?.config && <Fragment set:html={analytics.config} />}

    <script is:inline>
      try {
        const stored = localStorage.getItem('witchclick-comfort');
        if (!stored) {
          document.documentElement?.removeAttribute('data-comfort-theme');
          document.documentElement?.removeAttribute('data-comfort-font');
          if (document.readyState === 'complete') {
            document.body?.removeAttribute('data-comfort-theme');
            document.body?.removeAttribute('data-comfort-font');
          } else {
            document.addEventListener(
              'DOMContentLoaded',
              () => {
                document.body?.removeAttribute('data-comfort-theme');
                document.body?.removeAttribute('data-comfort-font');
              },
              { once: true }
            );
          }
        } else {
          const prefs = JSON.parse(stored);
          const root = document.documentElement;
          if (prefs && typeof prefs === 'object' && root) {
            const theme = prefs.theme === 'dawn' ? 'dawn' : null;
            const font = prefs.font === 'sans' ? 'sans' : null;

            if (theme) {
              root.setAttribute('data-comfort-theme', theme);
            } else {
              root.removeAttribute('data-comfort-theme');
            }

            if (font) {
              root.setAttribute('data-comfort-font', font);
            } else {
              root.removeAttribute('data-comfort-font');
            }

            const applyToBody = () => {
              const body = document.body;
              if (!body) return;
              if (theme) {
                body.setAttribute('data-comfort-theme', theme);
              } else {
                body.removeAttribute('data-comfort-theme');
              }
              if (font) {
                body.setAttribute('data-comfort-font', font);
              } else {
                body.removeAttribute('data-comfort-font');
              }
            };

            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', applyToBody, { once: true });
            } else {
              applyToBody();
            }
          }
        }
      } catch (error) {
        /* no-op */
      }
    </script>

    <slot name="head" />
  </head>
  <body
    id="top"
    class:list={["site-shell", wide && "is-wide", desktopWide && "is-desktop-wide"].filter(Boolean)}
    style={bodyStyle}
    data-entity-type={bodyDataType || undefined}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <Header
      brandName={brandName}
      navLinks={navLinks}
      secondaryLinks={secondaryLinks}
      utilityLinks={headerUtility}
      adminLinks={adminLinks}
      currentPath={currentPath}
    />
    <main id="main" class="site-main">
      <div
        class:list={[
          "site-main__container",
          "wc-container",
          wide && "site-main__container--wide",
          desktopWide && "site-main__container--desktop-wide",
        ].filter(Boolean)}
      >
        <div class="site-main__breadcrumbs">
          <slot name="breadcrumbs" />
        </div>
        <div class="site-main__content">
          <slot />
        </div>
      </div>
    </main>
    <Footer
      brandName={brandName}
      navLinks={navLinks}
      secondaryNavLinks={secondaryLinks}
      utilityLinks={footerUtilities}
      adminLinks={adminLinks}
      disclosure={disclosure}
    />
    {analytics?.runtime && <Fragment set:html={analytics.runtime} />}
  </body>
</html>

<style is:inline>
  .skip-link {
    position: absolute;
    left: -999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: var(--color-night, #120725);
    color: var(--color-muted, #f4f1ff);
    z-index: 100;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    width: auto;
    height: auto;
  }

  .site-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(120% 160% at 50% 0%, rgba(212, 175, 55, 0.16) 0%, transparent 60%),
      radial-gradient(140% 200% at 10% 20%, rgba(124, 78, 176, 0.22) 0%, transparent 70%),
      linear-gradient(180deg, var(--color-midnight, #07020f) 0%, var(--color-night, #120725) 100%);
    color: var(--color-ink, #f4f1ff);
  }

  .site-main {
    flex: 1 1 auto;
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(3rem, 7vw, 4.5rem);
  }

  .site-main__container {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .site-main__breadcrumbs:empty {
    display: none;
  }

  .site-main__content {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .site-main__container--wide {
    max-width: 72rem;
  }

  .site-main__container--desktop-wide {
    max-width: 72rem;
  }

  @media (min-width: 1024px) {
    .site-main__container--desktop-wide {
      max-width: 82rem;
    }
  }
</style>
