---
// src/layouts/Base.astro
import "@/styles/base.css";
import "@/styles/cards.css";
import "@/styles/tailwind.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ComfortFab from "@/components/ComfortFab.astro";
import {
  primaryNavLinks,
  secondaryNavLinks,
  headerUtilityLinks,
  footerUtilityLinks,
  adminNavSections,
} from "@/data/navigation";
import { readSettings, buildCanonicalUrl, toAbsoluteUrl } from "@/utils/settings";
import { buildAnalyticsInjection } from "@/utils/analytics";
import { getActiveThemes } from "@/utils/theme";
import { mixColors } from "@/utils/color";

interface LayoutProps {
  title?: string;
  description?: string;
  canon?: string;
  wide?: boolean;
  desktopWide?: boolean;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  noindex?: boolean;
  ambientColor?: string;
  bodyDataType?: string;
}

const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  desktopWide = false,
  ogImage = "",
  ogType = "website",
  twitterCard = "summary_large_image",
  noindex = false,
  ambientColor = "",
  bodyDataType = "",
} = Astro.props as LayoutProps;

// Constants
const FALLBACK_COLORS = {
  midnight: {
    primary: "#4b2a63",
    accent: "#d4af37",
    background: "#07020f",
  },
  dawn: {
    primary: "#9b86c8",
    accent: "#caa043",
    background: "#f6f0e8",
  },
} as const;

const FALLBACK_SERIF = '"Lora", "Crimson Text", Georgia, serif';
const FALLBACK_SCRIPT = '"Cormorant Garamond", "Cinzel", serif';

const PLAIN_READING_ROUTE_PATTERNS = [
  /^\/post\//,
  /^\/entities\//,
  /^\/curses\//,
  /^\/tools\//,
  /^\/about(\/|$)/,
  /^\/privacy(\/|$)/,
];

type ModeFallback = (typeof FALLBACK_COLORS)[keyof typeof FALLBACK_COLORS];

// Utility Functions
const sanitizeColor = (value: string | null | undefined, fallback: string): string => {
  const trimmed = typeof value === "string" ? value.trim() : "";
  return /^#[0-9a-fA-F]{3,8}$/.test(trimmed) ? trimmed : fallback;
};

const formatFontStack = (value: string | null | undefined, fallback: string): string => {
  const trimmed = typeof value === "string" ? value.trim() : "";
  if (!trimmed) return fallback;
  
  const sanitized = trimmed.replace(/[<>]/g, "");
  const escaped = sanitized.replace(/["\\]/g, "\\$&");
  const needsQuotes = /[\s,]/.test(escaped);
  const primary = needsQuotes ? `"${escaped}"` : escaped;
  
  return `${primary}, ${fallback}`;
};

const buildThemeCss = (
  theme: typeof midnightTheme,
  selector: string,
  fallbacks: ModeFallback,
): string => {
  const primary = sanitizeColor(theme?.primary, fallbacks.primary);
  const accent = sanitizeColor(theme?.accent, fallbacks.accent);
  const background = sanitizeColor(theme?.background, fallbacks.background);
  const serifStack = formatFontStack(theme?.fontSerif, FALLBACK_SERIF);
  const scriptStack = formatFontStack(theme?.fontScript, FALLBACK_SCRIPT);
  
  // Color mixins
  const overlay = `color-mix(in srgb, ${background} 45%, transparent 55%)`;
  const overlayStrong = `color-mix(in srgb, ${background} 68%, transparent 32%)`;
  const plainSurface = `color-mix(in srgb, ${background} 92%, black 8%)`;
  const plainBorder = `color-mix(in srgb, ${primary} 28%, transparent 72%)`;
  const plainShadow = `0 28px 60px -30px color-mix(in srgb, ${primary} 18%, black 82%)`;

  return `${selector} {
  --color-midnight: ${background};
  --color-night: color-mix(in srgb, ${background} 85%, black 15%);
  --color-dusk: color-mix(in srgb, ${background} 65%, white 35%);
  --color-iris: ${primary};
  --color-amethyst: color-mix(in srgb, ${primary} 70%, white 30%);
  --color-fog: color-mix(in srgb, ${primary} 30%, white 70%);
  --color-gold: ${accent};
  --color-rune: color-mix(in srgb, ${background} 12%, white 88%);
  --color-ink: color-mix(in srgb, ${background} 18%, black 82%);
  --color-muted: color-mix(in srgb, ${primary} 18%, transparent 82%);
  --color-border: color-mix(in srgb, ${primary} 28%, transparent 72%);
  --color-border-strong: color-mix(in srgb, ${primary} 42%, transparent 58%);
  --color-overlay: ${overlay};
  --color-overlay-strong: ${overlayStrong};
  --surface-plain: ${plainSurface};
  --surface-plain-border: ${plainBorder};
  --surface-plain-shadow: ${plainShadow};
  --ink-body: color-mix(in srgb, var(--color-ink) 70%, var(--color-night) 30%);
  --ink-strong: color-mix(in srgb, var(--color-ink) 85%, var(--color-night) 15%);
  --ink-muted: color-mix(in srgb, var(--color-ink) 55%, white 45%);
  --link-color: color-mix(in srgb, var(--color-iris) 55%, var(--color-gold) 45%);
  --focus-ring-color: color-mix(in srgb, var(--color-iris) 60%, var(--color-gold) 40%);
  --focus-ring-shadow: 0 0 0 2px color-mix(in srgb, var(--color-night) 65%, transparent 35%),
    0 0 0 4px color-mix(in srgb, var(--focus-ring-color) 80%, white 20%);
  --font-body-serif: ${serifStack};
  --font-body: ${serifStack};
  --font-heading: ${serifStack};
  --font-accent: ${scriptStack};
}`;
};

const normalizeAccountLink = (
  link: { href: string; label: string; rel?: string },
  showAccountLink: boolean,
) => {
  if (link.href !== "/account/") return link;
  if (!showAccountLink) return null;
  return { ...link, href: "/about/#membership" };
};

// Settings and Theme Configuration
const settings = readSettings();
const analytics = buildAnalyticsInjection(settings);
const brandName = settings.brandName ?? "WitchClick";
const disclosure = settings.disclosure ?? "";
const showAccountLink = settings.showAccountLink ?? false;

// Theme Setup
const { midnight: midnightTheme, dawn: dawnTheme } = getActiveThemes();
const midnightCss = buildThemeCss(midnightTheme, ":root", FALLBACK_COLORS.midnight);
const dawnCss = buildThemeCss(dawnTheme, ':root[data-comfort-theme="dawn"]', FALLBACK_COLORS.dawn);
const themeStyle = `${midnightCss}\n\n${dawnCss}`;
const themeMetaColor = sanitizeColor(midnightTheme?.primary, FALLBACK_COLORS.midnight.primary);

// Ambient Color Configuration
const fallbackPrimary = sanitizeColor(midnightTheme?.primary, FALLBACK_COLORS.midnight.primary);
const fallbackAccent = sanitizeColor(midnightTheme?.accent, FALLBACK_COLORS.midnight.accent);
const fallbackBackground = sanitizeColor(
  midnightTheme?.background,
  FALLBACK_COLORS.midnight.background,
);

const ambientBase = sanitizeColor(ambientColor, fallbackPrimary);
const ambientHighlight = mixColors(ambientBase, "#ffffff", 0.24);
const ambientAurora = mixColors(ambientBase, fallbackAccent, 0.45);
const ambientDepth = mixColors(ambientBase, fallbackBackground, 0.52);
const ambientShadow = mixColors(fallbackBackground, "#000000", 0.32);
const ambientOverlay = mixColors(ambientBase, "#000000", 0.18);

const bodyStyleEntries = [
  ["--ambient-color", ambientBase],
  ["--ambient-highlight", ambientHighlight],
  ["--ambient-aurora", ambientAurora],
  ["--ambient-depth", ambientDepth],
  ["--ambient-shadow", ambientShadow],
  ["--ambient-overlay", ambientOverlay],
] as const;

const bodyStyle = bodyStyleEntries.map(([key, value]) => `${key}: ${value}`).join("; ");

// SEO and Meta Configuration
const ogUrl = ogImage ? toAbsoluteUrl(ogImage, settings) : "";
const fallbackOgImage = toAbsoluteUrl(
  "/images/hero/focus-hub-intro/tea-and-light-in-the-morning.png",
  settings,
);
const resolvedOgImage = ogUrl || fallbackOgImage;
const canonicalUrl = buildCanonicalUrl(settings, { canonical: canon, astroUrl: Astro.url ?? null });

// Navigation Configuration
const currentPath = Astro.url?.pathname ?? "/";
const isPlainReadingRoute = PLAIN_READING_ROUTE_PATTERNS.some((pattern) => pattern.test(currentPath));

const navLinks = primaryNavLinks;
const secondaryLinks = secondaryNavLinks;
const headerUtility = headerUtilityLinks
  .map((link) => normalizeAccountLink(link, showAccountLink))
  .filter((link): link is typeof headerUtilityLinks[number] => Boolean(link));
const footerUtilities = footerUtilityLinks
  .map((link) => normalizeAccountLink(link, showAccountLink))
  .filter((link): link is typeof footerUtilityLinks[number] => Boolean(link));

const isDev = import.meta.env.DEV;
const adminSections = isDev ? adminNavSections : [];

// Observability Configuration
const observabilitySettings = settings.observability ?? { enabled: false };
const debugQuery = Astro.url?.searchParams.get("debug") ?? "";
const debugMode = debugQuery === "1";
const siteEnvironment = observabilitySettings.environment ?? (isDev ? "development" : "production");
const shouldLoadObservability = debugMode || (observabilitySettings.enabled && !isDev);

const observabilityConfig = shouldLoadObservability
  ? {
      enabled: Boolean(observabilitySettings.enabled),
      dsn: observabilitySettings.dsn ?? null,
      environment: observabilitySettings.environment ?? null,
      clientErrorEndpoint:
        observabilitySettings.enabled && settings.clientErrorEndpoint
          ? settings.clientErrorEndpoint
          : null,
      debug: debugMode,
      siteEnvironment,
      featureFlags: {
        observability: Boolean(observabilitySettings.enabled),
        analytics: Boolean(settings.analytics?.enabled),
        ads: Boolean(settings.ads?.provider),
      },
    }
  : null;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:site_name" content={brandName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={resolvedOgImage} />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />
    
    <!-- Theme Color -->
    <meta name="theme-color" content={themeMetaColor} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Theme Styles -->
    <style is:inline set:html={themeStyle}></style>
    
    <!-- Theme Preference Script (must run before body render) -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('comfort-preferences');
          
          if (!stored) {
            document.documentElement?.removeAttribute('data-comfort-theme');
            document.documentElement?.removeAttribute('data-comfort-font');
            
            const removeBodyAttrs = () => {
              document.body?.removeAttribute('data-comfort-theme');
              document.body?.removeAttribute('data-comfort-font');
            };
            
            if (document.readyState === 'complete') {
              removeBodyAttrs();
            } else {
              document.addEventListener('DOMContentLoaded', removeBodyAttrs, { once: true });
            }
          } else {
            const prefs = JSON.parse(stored);
            const root = document.documentElement;
            
            if (prefs && typeof prefs === 'object' && root) {
              const theme = prefs.theme === 'dawn' ? 'dawn' : null;
              const font = prefs.font === 'sans' ? 'sans' : null;

              // Apply to documentElement immediately
              if (theme) {
                root.setAttribute('data-comfort-theme', theme);
              } else {
                root.removeAttribute('data-comfort-theme');
              }

              if (font) {
                root.setAttribute('data-comfort-font', font);
              } else {
                root.removeAttribute('data-comfort-font');
              }

              // Apply to body when ready
              const applyToBody = () => {
                const body = document.body;
                if (!body) return;
                
                if (theme) {
                  body.setAttribute('data-comfort-theme', theme);
                } else {
                  body.removeAttribute('data-comfort-theme');
                }
                
                if (font) {
                  body.setAttribute('data-comfort-font', font);
                } else {
                  body.removeAttribute('data-comfort-font');
                }
              };

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', applyToBody, { once: true });
              } else {
                applyToBody();
              }
            }
          }
        } catch (error) {
          // Silent fail - preferences will use defaults
        }
      })();
    </script>

    <slot name="head" />
  </head>
  
  <body
    id="top"
    class:list={[
      "site-shell",
      wide && "is-wide",
      desktopWide && "is-desktop-wide",
      isPlainReadingRoute && "site-shell--plain",
    ].filter(Boolean)}
    style={bodyStyle}
    data-entity-type={bodyDataType || undefined}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    
    <Header
      brandName={brandName}
      navLinks={navLinks}
      secondaryLinks={secondaryLinks}
      utilityLinks={headerUtility}
      adminSections={adminSections}
      currentPath={currentPath}
    />
    
    <main
      id="main"
      class:list={["site-main", isPlainReadingRoute && "site-main--plain"].filter(Boolean)}
      data-plain-reading={isPlainReadingRoute ? "true" : undefined}
    >
      <div
        class:list={[
          "site-main__container",
          "wc-container",
          wide && "site-main__container--wide",
          desktopWide && "site-main__container--desktop-wide",
          isPlainReadingRoute && "site-main__container--plain",
        ].filter(Boolean)}
      >
        <div class="site-main__breadcrumbs">
          <slot name="breadcrumbs" />
        </div>
        <div class="site-main__content">
          <slot />
        </div>
      </div>
    </main>
    
    <Footer
      brandName={brandName}
      navLinks={navLinks}
      secondaryNavLinks={secondaryLinks}
      utilityLinks={footerUtilities}
      disclosure={disclosure}
    />
    
    <ComfortFab />
    
    <!-- Analytics -->
    {analytics?.runtime?.inline && (
      <script is:inline set:html={analytics.runtime.inline}></script>
    )}
    
    <!-- Observability -->
    {observabilityConfig && (
      <script type="module" define:vars={{ observabilityConfig }}>
        import { initObservability } from "@/utils/observability";
        initObservability(observabilityConfig);
      </script>
    )}
    
    <!-- Card Animations -->
    <script type="module">
      import "@/scripts/card-animations";
    </script>
  </body>
</html>

<style is:inline>
  .skip-link {
    position: absolute;
    left: -999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: var(--color-night, #120725);
    color: var(--color-muted, #f4f1ff);
    z-index: 100;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    width: auto;
    height: auto;
  }

  .site-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #1a1325;
    color: color-mix(in srgb, var(--ink-strong, #f4f1ff) 92%, var(--ambient-highlight, #e9d4ff) 8%);
  }

  .site-shell--plain {
    background: #1a1325;
  }

  .site-main {
    flex: 1 1 auto;
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(3rem, 7vw, 4.5rem);
  }

  .site-main--plain {
    padding: clamp(2rem, 5.5vw, 3.5rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  .site-main__container {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .site-main__container--plain {
    position: relative;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--surface-plain-border, rgba(124, 78, 176, 0.32));
    background: var(--surface-plain, rgba(18, 7, 37, 0.88));
    box-shadow: var(--surface-plain-shadow, 0 24px 55px -28px rgba(3, 2, 12, 0.72));
    backdrop-filter: blur(18px);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
  }

  .site-main__container--plain::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-overlay-strong, rgba(18, 7, 37, 0.6)) 65%, transparent 35%) 0%,
      transparent 70%
    );
    opacity: 0.5;
    pointer-events: none;
  }

  .site-main__container--plain > * {
    position: relative;
    z-index: 1;
  }

  .site-main__breadcrumbs:empty {
    display: none;
  }

  .site-main__content {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .site-main__container--wide {
    max-width: 72rem;
  }

  .site-main__container--desktop-wide {
    max-width: 72rem;
  }

  @media (max-width: 640px) {
    .site-main__container--plain {
      padding: clamp(1.25rem, 6vw, 1.75rem);
      border-radius: clamp(1rem, 6vw, 1.75rem);
      gap: clamp(1.25rem, 4vw, 1.75rem);
    }
  }

  @media (min-width: 1024px) {
    .site-main__container--desktop-wide {
      max-width: 82rem;
    }
  }
</style>
