---
/* src/layouts/Base.astro */
import "../styles/tailwind.css";
import "../styles/cards.css";
import SearchBox from "../components/SearchBox.astro";
import { typeMetadata } from "../data/typeMetadata";
import { readSettings, getSiteOrigin, toAbsoluteUrl } from "../utils/settings";
import { getTheme } from "../utils/theme";
import { mixColors, resolveTailwindColor, toRgba } from "../utils/color";

const props = Astro.props || {};
const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  ogImage = "",
  noindex = false,
  bodyDataType = undefined,
  ambientColor,
} = props;

const settings = readSettings();
const brandName = settings.brandName ?? "WitchClick";
const siteOrigin = getSiteOrigin(settings);
const here = Astro.url?.pathname ?? "/";

const canonicalUrl = canon
  ? canon.startsWith("http")
    ? canon
    : toAbsoluteUrl(canon, settings)
  : siteOrigin
    ? `${siteOrigin}${here}`
    : "";

const pageTitle = title && title !== brandName ? `${title} — ${brandName}` : brandName;
const ogImg = ogImage ? toAbsoluteUrl(ogImage, settings) : (siteOrigin ? `${siteOrigin}/og-default.png` : "");
const theme = getTheme();

const headerWidthClass = wide ? "max-w-6xl" : "max-w-4xl";
const mainWidthClass = wide ? "max-w-6xl" : "max-w-3xl";

const grimoireChapters = Object.entries(typeMetadata).map(([type, metadata]) => ({
  title: metadata.title,
  icon: metadata.icon,
  href: `/entities/${type}`,
}));

const links = [
  { href: "/", label: "Home" },
  { href: "/downloads", label: "Downloads" },
  ...(import.meta.env.DEV
    ? [
        { href: "/admin", label: "Post Generator", rel: "nofollow" },
        { href: "/admin/write", label: "Write", rel: "nofollow" },
        { href: "/admin/entities", label: "Entities Admin", rel: "nofollow" },
        { href: "/admin/downloads", label: "Downloads Admin", rel: "nofollow" },
        { href: "/admin/hero", label: "Hero Uploader", rel: "nofollow" },
      ]
    : []),
];

const backgroundLayers = [
  "var(--body-overlay, var(--surface-parchment-overlay))",
  "var(--body-texture, var(--surface-starfield))",
  "var(--body-surface, var(--surface-parchment))",
  "var(--color-background)",
].join(", ");

const ambientBase = ambientColor ?? theme.primary;
const ambientLight = mixColors("#ffffff", ambientBase, 0.18);
const ambientDeep = mixColors("#0f172a", ambientBase, 0.3);
const ambientGlass = toRgba(ambientBase, 0.14);
const ambientGlassBorder = toRgba(mixColors("#e2e8f0", ambientBase, 0.45), 0.55);
const ambientPillBorder = toRgba(mixColors("#c7d2fe", ambientBase, 0.3), 0.4);
const ambientPillText = toRgba(mixColors("#312e81", ambientBase, 0.45), 0.88);
const ambientPillTextActive = toRgba(mixColors("#1e1b4b", ambientBase, 0.55), 0.95);
const footerSurfaceTop = toRgba(mixColors("#ffffff", ambientBase, 0.22), 0.85);
const footerSurfaceBottom = toRgba(mixColors("#fdf4ff", ambientBase, 0.32), 0.7);
const footerBorder = toRgba(mixColors("#cbd5f5", ambientBase, 0.35), 0.5);
const footerText = mixColors("#1f2937", ambientBase, 0.3);
const footerMuted = toRgba(mixColors("#475569", ambientBase, 0.35), 0.82);
const bodyOverlay = `linear-gradient(160deg, ${toRgba(ambientLight, 0.55)} 0%, ${toRgba(
  ambientBase,
  0.12
)} 35%, ${toRgba(ambientDeep, 0.32)} 75%, transparent 100%)`;
const contentTexture = `radial-gradient(circle at 12% 18%, ${toRgba(ambientBase, 0.08)}, transparent 55%), radial-gradient(circle at 80% 12%, ${toRgba(
  ambientLight,
  0.12
)}, transparent 60%)`;

const activeTypeMetadata = bodyDataType
  ? typeMetadata[bodyDataType as keyof typeof typeMetadata]
  : undefined;
const grimoireRingColor = activeTypeMetadata
  ? resolveTailwindColor(activeTypeMetadata.themeColor)
  : undefined;

const bodyStyle = `
  --color-primary: ${theme.primary};
  --color-accent: ${theme.accent};
  --color-background: ${theme.background};
  --font-serif: '${theme.fontSerif}', ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
  --font-script: '${theme.fontScript}', cursive;
  --ambient-color: ${ambientBase};
  --glass-panel-overlay: ${ambientGlass};
  --glass-panel-border: ${ambientGlassBorder};
  --glass-pill-border: ${ambientPillBorder};
  --glass-pill-border-active: ${toRgba(mixColors("#818cf8", ambientBase, 0.35), 0.55)};
  --glass-pill-text: ${ambientPillText};
  --glass-pill-text-active: ${ambientPillTextActive};
  --panel-muted-surface: linear-gradient(165deg, ${footerSurfaceTop} 0%, ${footerSurfaceBottom} 100%);
  --panel-muted-border: ${footerBorder};
  --panel-muted-text: ${footerMuted};
  --panel-muted-heading: ${footerText};
  --body-overlay: ${bodyOverlay};
  --content-texture: ${contentTexture};
  --grimoire-ring-color: ${grimoireRingColor ?? "var(--glass-pill-border-active)"};
  background: ${backgroundLayers};
`;
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* Social defaults */}
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImg && <meta property="og:image" content={ogImg} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={theme.primary} />
    <meta name="color-scheme" content="light" />

    {/* Discoverability helpers */}
    <link rel="alternate" type="application/rss+xml" title={`${brandName} RSS`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {/* Fonts perf */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,300;7..72,400;7..72,700&family=Parisienne&display=swap"
    />

    <style is:inline>
      :root {
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --glass-panel-radius: 1.75rem;
        --glass-panel-border: rgba(124, 58, 237, 0.28);
        --glass-panel-blur: 18px;
        --glass-panel-surface: rgba(255, 255, 255, 0.88);
        --glass-panel-overlay: rgba(124, 58, 237, 0.12);
        --glass-panel-shadow: 0 20px 45px -25px rgba(15, 23, 42, 0.35);
        --glass-panel-shadow-hover: 0 25px 60px -30px rgba(15, 23, 42, 0.45);
        --glass-pill-gradient-start: rgba(246, 241, 255, 0.9);
        --glass-pill-gradient-end: rgba(221, 214, 254, 0.55);
        --glass-pill-border: rgba(124, 58, 237, 0.35);
        --glass-pill-border-active: rgba(91, 33, 182, 0.48);
        --glass-pill-text: rgba(76, 29, 149, 0.85);
        --glass-pill-text-active: rgba(59, 7, 100, 0.95);
        --panel-muted-surface: rgba(255, 255, 255, 0.84);
        --panel-muted-border: rgba(148, 163, 184, 0.35);
        --panel-muted-text: rgba(71, 85, 105, 0.85);
        --panel-muted-heading: #1f2937;
      }

      h1, h2, h3, .font-serif {
        font-family: var(--font-serif);
      }

      .font-script {
        font-family: var(--font-script);
      }

      h1.font-serif {
        line-height: 1.05;
      }

      body {
        transition: background 420ms ease, color 220ms ease;
      }

      body[data-type] .grimoire-header-panel,
      body[data-type] .layout-footer,
      body[data-type] .layout-content::before {
        transition: background 320ms ease, box-shadow 320ms ease, border-color 320ms ease, opacity 320ms ease;
      }

      .grimoire-header-panel {
        position: relative;
        overflow: hidden;
        border-radius: var(--glass-panel-radius);
        border: 1px solid var(--glass-panel-border);
        background: linear-gradient(145deg, var(--glass-panel-surface), rgba(255, 255, 255, 0.65));
        backdrop-filter: blur(var(--glass-panel-blur));
        -webkit-backdrop-filter: blur(var(--glass-panel-blur));
        box-shadow: var(--glass-panel-shadow);
      }

      .grimoire-header-panel::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(140deg, var(--glass-panel-overlay), transparent 65%);
        mix-blend-mode: multiply;
        pointer-events: none;
        z-index: 0;
      }

      .grimoire-header-panel::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.35), transparent 65%);
        z-index: 0;
      }

      .grimoire-header-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        padding: clamp(1.25rem, 4vw, 2rem) clamp(1.5rem, 4vw, 2.75rem);
      }

      .grimoire-brand {
        color: var(--glass-pill-text-active);
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
      }

      .grimoire-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .grimoire-nav-item {
        position: relative;
      }

      .grimoire-nav-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.55rem 1.15rem;
        border-radius: calc(var(--glass-panel-radius) / 2.2);
        border: 1px solid var(--glass-pill-border);
        background: linear-gradient(135deg, var(--glass-pill-gradient-start), var(--glass-pill-gradient-end));
        color: var(--glass-pill-text);
        text-transform: uppercase;
        font-variant: small-caps;
        font-variant-caps: all-small-caps;
        letter-spacing: 0.22em;
        font-size: 0.72rem;
        line-height: 1;
        transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease, color 220ms ease,
          background 220ms ease;
        box-shadow: var(--glass-panel-shadow);
        text-decoration: none;
      }

      .grimoire-nav-toggle-icon {
        font-size: 0.8em;
        transition: transform 220ms ease;
      }

      .grimoire-nav-link:hover,
      .grimoire-nav-link:focus-visible,
      .grimoire-nav-link.is-active {
        transform: translateY(-4px);
        border-color: var(--glass-pill-border-active);
        box-shadow: var(--glass-panel-shadow-hover);
        color: var(--glass-pill-text-active);
        background: linear-gradient(140deg, rgba(255, 255, 255, 0.95), rgba(221, 214, 254, 0.7));
      }

      .grimoire-nav-item.is-open > .grimoire-nav-link {
        transform: translateY(-4px);
      }

      .grimoire-nav-item.is-open > .grimoire-nav-link .grimoire-nav-toggle-icon {
        transform: rotateX(180deg);
      }

      .grimoire-nav-link:focus-visible {
        outline: none;
        box-shadow: var(--glass-panel-shadow-hover), 0 0 0 3px rgba(221, 214, 254, 0.75);
      }

      .grimoire-nav-link::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
        opacity: 0.9;
        pointer-events: none;
      }

      .grimoire-menu-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        transform: translateY(-0.35rem);
        min-width: 18rem;
        padding: 0.95rem;
        border-radius: calc(var(--glass-panel-radius) / 1.8);
        border: 1px solid var(--glass-panel-border);
        background: linear-gradient(150deg, var(--glass-panel-surface), var(--glass-panel-overlay));
        box-shadow: var(--glass-panel-shadow-hover);
        backdrop-filter: blur(var(--glass-panel-blur));
        -webkit-backdrop-filter: blur(var(--glass-panel-blur));
        opacity: 0;
        visibility: hidden;
        transition: opacity 180ms ease, transform 200ms ease;
        transform-origin: top right;
      }

      .grimoire-menu-panel.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .grimoire-menu-panel[data-floating="true"] {
        position: fixed;
        inset: auto;
        min-width: 220px;
        max-width: 92vw;
        max-height: min(60vh, calc(100vh - 24px));
        overflow: auto;
        margin: 0;
        z-index: 70;
      }

      .grimoire-menu-list {
        display: grid;
        gap: 0.35rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .grimoire-menu-link {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.55rem 0.75rem;
        border-radius: 0.85rem;
        border: 1px solid transparent;
        text-decoration: none;
        color: var(--panel-muted-heading);
        font-size: 0.9rem;
        line-height: 1.35;
        transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease, color 160ms ease;
      }

      .grimoire-menu-link:hover,
      .grimoire-menu-link:focus-visible {
        outline: none;
        background: rgba(255, 255, 255, 0.65);
        border-color: var(--glass-pill-border-active);
        box-shadow: 0 0 0 2px var(--grimoire-ring-color);
        color: var(--glass-pill-text-active);
      }

      .grimoire-menu-link:focus-visible {
        box-shadow: 0 0 0 3px rgba(221, 214, 254, 0.75), 0 0 0 6px var(--grimoire-ring-color);
      }

      .grimoire-menu-icon {
        font-size: 1.05rem;
      }

      .grimoire-menu-subtitle {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--panel-muted-text);
      }

      @media (max-width: 639px) {
        .grimoire-header-content {
          padding-inline: 1.25rem;
          padding-block: 1.15rem;
        }

        .grimoire-header-content nav {
          flex-basis: 100%;
        }

        .grimoire-nav {
          gap: 0.5rem;
        }

        .grimoire-nav-link {
          padding-inline: 1rem;
          padding-block: 0.5rem;
          letter-spacing: 0.18em;
        }

        .grimoire-nav-item {
          flex-basis: 100%;
        }

        .grimoire-menu-panel {
          position: static;
          transform: none;
          opacity: 1;
          visibility: visible;
          margin-top: 0.25rem;
          min-width: 0;
          width: 100%;
          max-width: none;
          max-height: none;
          overflow: visible;
        }

        .grimoire-menu-panel:not(.is-open) {
          display: none;
        }

        .grimoire-menu-list {
          display: flex;
          flex-direction: column;
          gap: 0.5rem;
        }

        .grimoire-menu-link {
          padding: 0.85rem 1rem;
          font-size: 1rem;
        }
      }

      .layout-content {
        position: relative;
        z-index: 0;
      }

      .layout-content::before {
        content: "";
        position: absolute;
        inset: -1.5rem 0 0;
        border-radius: clamp(2rem, 4vw, 3rem);
        background-image: var(--content-texture), var(--surface-parchment-overlay);
        background-size: 120% 120%, cover;
        background-repeat: no-repeat, no-repeat;
        opacity: 0.35;
        mix-blend-mode: multiply;
        pointer-events: none;
        z-index: -1;
      }

      .layout-content > * {
        position: relative;
        z-index: 1;
      }

      .layout-footer {
        margin-top: auto;
        position: relative;
        padding: clamp(2rem, 5vw, 3rem) 0;
        background: transparent;
      }

      .layout-footer::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          radial-gradient(140% 120% at 10% 0%, color-mix(in srgb, white 55%, transparent) 0%, transparent 72%),
          radial-gradient(135% 125% at 95% 120%, color-mix(in srgb, var(--glow-horizon, transparent) 65%, transparent) 0%, transparent 78%);
        opacity: 0.45;
        pointer-events: none;
      }

      .layout-footer-panel {
        position: relative;
        z-index: 1;
        color: var(--panel-muted-text);
      }

      .layout-footer h2 {
        color: var(--panel-muted-heading);
      }

      .footer-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.1rem 0.35rem;
        border-radius: 9999px;
        color: inherit;
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, currentColor 65%, transparent);
        text-decoration-thickness: 1px;
        text-underline-offset: 6px;
        transition: color 220ms ease, text-decoration-color 220ms ease, box-shadow 220ms ease;
      }

      .footer-link:hover,
      .footer-link:focus-visible {
        color: color-mix(in srgb, var(--panel-muted-heading) 65%, #111827 35%);
        text-decoration: none;
      }

      .footer-link:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px color-mix(in srgb, #ffffff 40%, var(--ambient-color) 60%),
          0 0 0 5px color-mix(in srgb, var(--panel-muted-border) 70%, transparent);
      }
    </style>

    {/* Page-level head slot */}
    <slot name="head" />
  </head>

  <body class="min-h-screen text-gray-900" style={bodyStyle} data-type={bodyDataType}>
    {/* Skip link for a11y */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 rounded bg-black px-3 py-2 text-white"
    >
      Skip to content
    </a>

    <header class={`mx-auto ${headerWidthClass} px-4 pb-6 pt-6`}>
      <div class="grimoire-header-panel">
        <div class="grimoire-header-content">
          <a href="/" class="grimoire-brand text-3xl font-script text-[var(--color-primary)]">{brandName}</a>
          <nav aria-label="Primary">
            <ul class="grimoire-nav">
              <li class="grimoire-nav-item" data-grimoire-menu>
                <button
                  type="button"
                  class="grimoire-nav-link"
                  data-grimoire-toggle
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls="grimoire-menu"
                >
                  Grimoire
                  <span class="grimoire-nav-toggle-icon" aria-hidden="true">⌄</span>
                </button>
                <div
                  id="grimoire-menu"
                  role="menu"
                  aria-label="Grimoire chapters"
                  class="grimoire-menu-panel"
                  data-grimoire-panel
                  hidden
                >
                  <ul class="grimoire-menu-list">
                    {grimoireChapters.map((chapter) => (
                      <li>
                        <a
                          href={chapter.href}
                          role="menuitem"
                          class="grimoire-menu-link"
                          data-grimoire-item
                        >
                          <span class="grimoire-menu-icon" aria-hidden="true">{chapter.icon}</span>
                          <span>
                            {chapter.title}
                            <span class="grimoire-menu-subtitle">Chapter</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
              {links.map((l) => {
                const active = here === l.href || (l.href !== "/" && here.startsWith(l.href + "/"));
                return (
                  <li class="grimoire-nav-item">
                    <a
                      href={l.href}
                      rel={l.rel}
                      aria-current={active ? "page" : undefined}
                      class:list={["grimoire-nav-link", active && "is-active"]}
                    >
                      {l.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
          <div class="hidden sm:block"><SearchBox /></div>
        </div>
      </div>
    </header>

    <main id="main" class={`mx-auto ${mainWidthClass} px-4 pb-16 layout-content`}>
      <div class="sm:hidden mb-6"><SearchBox /></div>
      <slot />
    </main>

    {/* CTA slot (filled only on posts) */}
    <slot name="cta" />

    <footer class="layout-footer">
      <div class={`layout-footer-panel panel-muted shadow-1 mx-auto ${mainWidthClass} px-4 py-8 text-sm leading-relaxed`}>
        <h2 class="font-serif text-base tracking-tight">WitchClick Grimoire</h2>
        {settings.disclosure && <p class="mt-3 text-xs sm:text-sm">{settings.disclosure}</p>}
        <p class="mt-4 flex flex-wrap items-center gap-3 text-sm">
          <a class="footer-link" href="/rss.xml">RSS</a>
          <span aria-hidden="true">•</span>
          <a class="footer-link" href="/sitemap-index.xml">Sitemap</a>
          {canonicalUrl && (
            <span class="inline-flex items-center gap-3">
              <span aria-hidden="true">•</span>
              <a class="footer-link" href={canonicalUrl}>Permalink</a>
            </span>
          )}
        </p>
        <p class="mt-4 text-xs uppercase tracking-[0.2em] text-slate-600/80">© {new Date().getFullYear()} {brandName}.</p>
      </div>
    </footer>

    {/* Optional page-tail slot for per-page scripts */}
    <slot name="foot" />

    <script is:inline>
      (() => {
        const menu = document.querySelector("[data-grimoire-menu]");
        if (!menu) return;

        const button = menu.querySelector("[data-grimoire-toggle]");
        const panel = menu.querySelector("[data-grimoire-panel]");
        const panelList = panel ? panel.querySelector(".grimoire-menu-list") : null;
        const pointerQuery = window.matchMedia("(pointer: fine)");
        const mobileQuery = window.matchMedia("(max-width: 639px)");
        let open = false;
        let closeTimeout = null;

        const placeholder = panel && panel.parentNode ? document.createElement("div") : null;
        if (panel && placeholder && panel.parentNode) {
          placeholder.style.display = "none";
          panel.parentNode.insertBefore(placeholder, panel);
        }

        const viewportMargin = 12;

        const getItems = () => {
          if (!panel) return [];
          return Array.from(panel.querySelectorAll("[data-grimoire-item]"));
        };
        const getFocusables = () => {
          const items = getItems();
          const focusables = [];
          if (button instanceof HTMLElement) {
            focusables.push(button);
          }
          items.forEach((item) => {
            if (item instanceof HTMLElement) {
              focusables.push(item);
            }
          });
          return focusables;
        };

        const focusElement = (element) => {
          if (element instanceof HTMLElement) {
            element.focus();
          }
        };

        const setAria = (expanded) => {
          if (button) {
            button.setAttribute("aria-expanded", expanded ? "true" : "false");
          }
          if (panel) {
            if (expanded) {
              panel.removeAttribute("hidden");
            } else {
              panel.setAttribute("hidden", "");
            }
          }
        };

        const isWithinMenu = (node) => {
          if (!(node instanceof Node)) return false;
          if (menu.contains(node)) return true;
          if (panel && panel.contains(node)) return true;
          return false;
        };

        const updateFloatingState = () => {
          if (!panel) return;
          const shouldFloat = !mobileQuery.matches;
          if (shouldFloat) {
            if (panel.dataset.floating !== "true") {
              panel.setAttribute("data-floating", "true");
              document.body.appendChild(panel);
            }
          } else if (panel.dataset.floating === "true") {
            panel.removeAttribute("data-floating");
            if (placeholder && placeholder.parentNode) {
              const parent = placeholder.parentNode;
              if (placeholder.nextSibling) {
                parent.insertBefore(panel, placeholder.nextSibling);
              } else {
                parent.appendChild(panel);
              }
            }
            panel.style.removeProperty("top");
            panel.style.removeProperty("left");
            panel.style.removeProperty("right");
            panel.style.removeProperty("bottom");
          }
        };

        const positionPanel = () => {
          if (!panel || panel.dataset.floating !== "true" || !button || panel.hasAttribute("hidden")) {
            return;
          }

          const previousVisibility = panel.style.visibility;
          const previousDisplay = panel.style.display;

          panel.style.visibility = "hidden";
          panel.style.display = "block";
          panel.style.left = "auto";
          panel.style.right = "auto";
          panel.style.top = "auto";
          panel.style.bottom = "auto";

          const triggerRect = button.getBoundingClientRect();
          const panelWidth = panel.offsetWidth;
          const panelHeight = panel.offsetHeight;
          const viewportWidth = window.innerWidth;
          const viewportHeight = window.innerHeight;

          let left = triggerRect.right - panelWidth;
          if (left + panelWidth > viewportWidth - viewportMargin) {
            left = Math.min(triggerRect.left, viewportWidth - viewportMargin - panelWidth);
          }
          if (left < viewportMargin) {
            left = viewportMargin;
          }

          let top = triggerRect.bottom + 8;
          if (top + panelHeight > viewportHeight - viewportMargin) {
            top = Math.max(viewportMargin, viewportHeight - viewportMargin - panelHeight);
          }
          top = Math.max(viewportMargin, top);

          panel.style.top = `${top}px`;
          panel.style.left = `${left}px`;
          panel.style.right = "auto";
          panel.style.bottom = "auto";
          panel.style.visibility = previousVisibility;
          panel.style.display = previousDisplay;
        };

        updateFloatingState();

        const openMenu = () => {
          if (open) return;
          open = true;
          menu.classList.add("is-open");
          if (panel) {
            panel.classList.add("is-open");
          }
          updateFloatingState();
          setAria(true);
          positionPanel();
        };

        const closeMenu = (focusButton = false) => {
          if (!open) return;
          open = false;
          menu.classList.remove("is-open");
          if (panel) {
            panel.classList.remove("is-open");
            panel.style.removeProperty("top");
            panel.style.removeProperty("left");
            panel.style.removeProperty("right");
            panel.style.removeProperty("bottom");
          }
          setAria(false);
          if (focusButton) {
            focusElement(button);
          }
        };

        const clearCloseTimeout = () => {
          if (closeTimeout !== null) {
            window.clearTimeout(closeTimeout);
            closeTimeout = null;
          }
        };

        const scheduleClose = () => {
          clearCloseTimeout();
          closeTimeout = window.setTimeout(() => {
            closeMenu();
          }, 120);
        };

        if (button) {
          button.addEventListener("click", () => {
            if (open) {
              closeMenu();
            } else {
              openMenu();
              focusElement(getItems()[0]);
            }
          });
        }

        const handlePointerEnter = () => {
          if (!pointerQuery.matches) return;
          clearCloseTimeout();
          openMenu();
        };

        const handlePointerLeave = () => {
          if (!pointerQuery.matches) return;
          scheduleClose();
        };

        menu.addEventListener("pointerenter", handlePointerEnter);
        menu.addEventListener("pointerleave", handlePointerLeave);
        if (panel) {
          panel.addEventListener("pointerenter", handlePointerEnter);
          panel.addEventListener("pointerleave", handlePointerLeave);
        }

        const handleFocusIn = () => {
          clearCloseTimeout();
          openMenu();
        };

        const handleFocusOut = (event) => {
          const nextTarget = event.relatedTarget;
          if (!isWithinMenu(nextTarget)) {
            scheduleClose();
          }
        };

        menu.addEventListener("focusin", handleFocusIn);
        menu.addEventListener("focusout", handleFocusOut);
        if (panel) {
          panel.addEventListener("focusin", handleFocusIn);
          panel.addEventListener("focusout", handleFocusOut);
        }

        document.addEventListener("pointerdown", (event) => {
          if (!open) return;
          if (!(event.target instanceof Node) || !isWithinMenu(event.target)) {
            closeMenu();
          }
        });

        if (panelList) {
          panelList.addEventListener("click", (event) => {
            const target = event.target;
            if (target instanceof Element) {
              const item = target.closest("[data-grimoire-item]");
              if (item) {
                closeMenu();
              }
            }
          });
        }

        const handleKeyDown = (event) => {
          if (!button) return;

          if (event.target === button && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
            event.preventDefault();
            openMenu();
            const items = getItems();
            if (!items.length) return;
            const targetItem = event.key === "ArrowDown" ? items[0] : items[items.length - 1];
            focusElement(targetItem);
            return;
          }

          if (!open) return;

          if (event.key === "Escape") {
            event.preventDefault();
            closeMenu(true);
            return;
          }

          if (event.key === "ArrowDown" || event.key === "ArrowUp") {
            const items = getItems();
            if (!items.length) return;
            event.preventDefault();
            const current = document.activeElement;
            let index = current instanceof Element ? items.indexOf(current) : -1;
            if (index === -1) {
              index = event.key === "ArrowDown" ? -1 : 0;
            }
            const nextIndex =
              event.key === "ArrowDown"
                ? (index + 1) % items.length
                : (index - 1 + items.length) % items.length;
            focusElement(items[nextIndex]);
            return;
          }

          if (event.key === "Tab") {
            const focusables = getFocusables();
            const active = document.activeElement;
            const index = active instanceof HTMLElement ? focusables.indexOf(active) : -1;
            if (index === -1) return;
            event.preventDefault();
            const nextIndex = event.shiftKey
              ? (index - 1 + focusables.length) % focusables.length
              : (index + 1) % focusables.length;
            focusElement(focusables[nextIndex]);
          }
        };

        menu.addEventListener("keydown", handleKeyDown);
        if (panel) {
          panel.addEventListener("keydown", (event) => {
            if (panel.dataset.floating !== "true") {
              return;
            }
            handleKeyDown(event);
          });
        }

        pointerQuery.addEventListener("change", () => {
          if (!pointerQuery.matches) {
            clearCloseTimeout();
          }
        });

        mobileQuery.addEventListener("change", () => {
          updateFloatingState();
          if (open) {
            positionPanel();
          }
        });

        const handleViewportChange = () => {
          if (open) {
            positionPanel();
          }
        };

        window.addEventListener("resize", handleViewportChange);
        window.addEventListener("scroll", handleViewportChange, true);
      })();
    </script>
  </body>
</html>
