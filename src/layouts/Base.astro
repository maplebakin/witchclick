--- 
// src/layouts/Base.astro
import "@/styles/base.css";
import "@/styles/cards.css";
import "@/styles/tailwind.css";

import { existsSync } from "node:fs";
import path from "node:path";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import {
  primaryNavLinks,
  secondaryNavLinks,
  headerUtilityLinks,
  footerUtilityLinks,
  adminNavSections,
} from "@/data/navigation";
import { readSettings, buildCanonicalUrl, toAbsoluteUrl, getFormEndpoint } from "@/utils/settings";
import { buildAnalyticsInjection } from "@/utils/analytics";
import { getActiveThemes } from "@/utils/theme";
import { mixColors } from "@/utils/color";
import cardAnimationsModule from "@/scripts/card-animations.js?url";
import revealAnimationsModule from "@/scripts/reveal-animations.js?url";

interface LayoutProps {
  title?: string;
  description?: string;
  canon?: string;
  wide?: boolean;
  desktopWide?: boolean;
  ogImage?: string;
  ogType?: string;
  twitterCard?: string;
  noindex?: boolean;
  ambientColor?: string;
  bodyDataType?: string;
  mainClass?: string | string[];
  containerClass?: string | string[];
  contentClass?: string | string[];
}

const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  desktopWide = false,
  ogImage = "",
  ogType = "website",
  twitterCard = "summary_large_image",
  noindex = false,
  ambientColor = "",
  bodyDataType = "",
  mainClass: _mainClassProp,
  containerClass: containerClassProp,
  contentClass: contentClassProp,
} = Astro.props as LayoutProps;

// Constants
const FALLBACK_COLORS = {
  midnight: {
    primary: "#d18c47",
    accent: "#d4af37",
    background: "#07020f",
  },
  dawn: {
    primary: "#9b86c8",
    accent: "#caa043",
    background: "#f6f0e8",
  },
} as const;

const PLAIN_READING_ROUTE_PATTERNS = [
  new RegExp('^\\/post\\/'),
  new RegExp('^\\/entities\\/'),
  new RegExp('^\\/curses\\/'),
  new RegExp('^\\/tools\\/'),
  new RegExp('^\\/about(\\/|$)'),
  new RegExp('^\\/privacy(\\/|$)'),
];

// Utility Functions
const sanitizeColor = (value: string | null | undefined, fallback: string): string => {
  const trimmed = typeof value === "string" ? value.trim() : "";
  return /^#[0-9a-fA-F]{3,8}$/.test(trimmed) ? trimmed : fallback;
};

const normalizeClassList = (value: string | string[] | null | undefined): string[] => {
  if (!value) return [];

  const values = Array.isArray(value) ? value : [value];

  return values
    .filter((item): item is string => typeof item === "string")
    .flatMap((item) => item.split(/\s+/g).filter(Boolean));
};

const normalizeAccountLink = (
  link: { href: string; label: string; rel?: string },
  showAccountLink: boolean,
) => {
  if (link.href !== "/account/") return link;
  if (!showAccountLink) return null;
  return { ...link, href: "/about/#membership" };
};

// Settings and Theme Configuration
const settings = readSettings();
const analytics = import.meta.env.DEV ? null : buildAnalyticsInjection(settings);
const formEndpoint = getFormEndpoint(settings);
const brandName = settings.brandName ?? "WitchClick";
const pageDescription = description.trim() || "Small rituals, grounded tarot, symbolic tools, and field notes for when life feels loud.";
const disclosure = settings.disclosure ?? "";
const showAccountLink = settings.showAccountLink ?? false;

// Theme Setup
// getActiveThemes memoizes in production but automatically re-reads when
// the admin saves new presets. See src/utils/theme.ts for cache details.
const { midnight: midnightTheme, dawn: dawnTheme } = getActiveThemes();
const themeMetaColor = sanitizeColor(midnightTheme?.primary, FALLBACK_COLORS.midnight.primary);

// Ambient Color Configuration
const fallbackPrimary = sanitizeColor(midnightTheme?.primary, FALLBACK_COLORS.midnight.primary);
const fallbackAccent = sanitizeColor(midnightTheme?.accent, FALLBACK_COLORS.midnight.accent);
const fallbackBackground = sanitizeColor(
  midnightTheme?.background,
  FALLBACK_COLORS.midnight.background,
);

const ambientBase = sanitizeColor(ambientColor, fallbackPrimary);
const ambientHighlight = mixColors(ambientBase, "#ffffff", 0.24);
const ambientAurora = mixColors(ambientBase, fallbackAccent, 0.45);
const ambientDepth = mixColors(ambientBase, fallbackBackground, 0.52);
const ambientShadow = mixColors(fallbackBackground, "#000000", 0.32);
const ambientOverlay = mixColors(ambientBase, "#000000", 0.18);

const bodyStyleEntries = [
  ["--ambient-color", ambientBase],
  ["--ambient-highlight", ambientHighlight],
  ["--ambient-aurora", ambientAurora],
  ["--ambient-depth", ambientDepth],
  ["--ambient-shadow", ambientShadow],
  ["--ambient-overlay", ambientOverlay],
] as const;

const bodyStyle = bodyStyleEntries.map(([key, value]) => `${key}: ${value}`).join("; ");

// SEO and Meta Configuration
const ogUrl = ogImage ? toAbsoluteUrl(ogImage, settings) : "";
const fallbackOgImage = toAbsoluteUrl(
  "/images/hero/focus-hub-intro/tea-and-light-in-the-morning.webp",
  settings,
);

const resolvePublicOgImage = (candidate: string): string => {
  if (!candidate) return fallbackOgImage;

  try {
    const url = new URL(candidate);
    const siteUrl = settings.siteUrl ? new URL(settings.siteUrl) : null;
    const isSameOrigin = !siteUrl || url.origin === siteUrl.origin;

    if (!isSameOrigin) return candidate;

    const relativePath = decodeURIComponent(url.pathname).replace(/^\/+/, "");
    if (!relativePath) return fallbackOgImage;

    const publicPath = path.join(process.cwd(), "public", relativePath);
    return existsSync(publicPath) ? candidate : fallbackOgImage;
  } catch {
    return fallbackOgImage;
  }
};

const resolvedOgImage = resolvePublicOgImage(ogUrl);
const canonicalUrl = buildCanonicalUrl(settings, { canonical: canon, astroUrl: Astro.url ?? null });

// Navigation Configuration
const currentPath = Astro.url?.pathname ?? "/";
const isPlainReadingRoute = PLAIN_READING_ROUTE_PATTERNS.some((pattern) => pattern.test(currentPath));

const containerClassList = [
  "site-main__container",
  "wc-container",
  wide && "site-main__container--wide",
  desktopWide && "site-main__container--desktop-wide",
  isPlainReadingRoute && "site-main__container--plain",
  ...normalizeClassList(containerClassProp),
].filter(Boolean);

const contentClassList = ["site-main__content", ...normalizeClassList(contentClassProp)].filter(Boolean);

const navLinks = primaryNavLinks;
const secondaryLinks = secondaryNavLinks;
const headerUtility = headerUtilityLinks
  .map((link) => normalizeAccountLink(link, showAccountLink))
  .filter((link): link is typeof headerUtilityLinks[number] => Boolean(link));
const footerUtilities = footerUtilityLinks
  .map((link) => normalizeAccountLink(link, showAccountLink))
  .filter((link): link is typeof footerUtilityLinks[number] => Boolean(link));

const isDev = import.meta.env.DEV;
const adminSections = isDev ? adminNavSections : [];

// Observability Configuration
const observabilitySettings = settings.observability ?? { enabled: false };
const debugQuery = Astro.url?.searchParams.get("debug") ?? "";
const debugMode = debugQuery === "1";
const siteEnvironment = observabilitySettings.environment ?? (isDev ? "development" : "production");
const shouldLoadObservability = debugMode || (observabilitySettings.enabled && !isDev);

const observabilityConfig = shouldLoadObservability
  ? {
      enabled: Boolean(observabilitySettings.enabled),
      dsn: observabilitySettings.dsn ?? null,
      environment: observabilitySettings.environment ?? null,
      clientErrorEndpoint:
        observabilitySettings.enabled && settings.clientErrorEndpoint
          ? settings.clientErrorEndpoint
          : null,
      debug: debugMode,
      siteEnvironment,
      featureFlags: {
        observability: Boolean(observabilitySettings.enabled),
        analytics: Boolean(settings.analytics?.enabled),
        ads: Boolean(settings.ads?.provider),
      },
    }
  : null;

// Theme Scope Detection
// Determines which theme scope to apply based on the current route
function detectThemeScope(pathname: string): string | null {
  // Homepage
  if (pathname === "/" || pathname === "") {
    return "homepage";
  }

  // Entity Grimoire (main entities directory page)
  if (pathname === "/entities" || pathname === "/entities/") {
    return "grimoire";
  }

  // Individual entity detail pages
  if (/^\u002Fentities\u002F[^\/]+\u002F[^\/]+\/?$/.test(pathname)) {
    return "entity-detail";
  }

  // Post detail pages
  if (/^\u002Fpost\u002F[^\/]+\/?$/.test(pathname)) {
    return "post";
  }

  // Start/getting started page
  if (pathname === "/start" || pathname === "/start/") {
    return "start";
  }

  // No specific scope - use global theme
  return null;
}

// Detect theme scope for the current page (reusing existing currentPath variable)
const themeScope = detectThemeScope(currentPath);

// Get active theme slugs for both modes (midnight is default)
const midnightThemeSlug = midnightTheme?.slug || 'cozy-midnight';
const dawnThemeSlug = dawnTheme?.slug || 'cozy-dawn';
---

<!doctype html>
<html lang="en" class="h-full" data-scope={themeScope || undefined} data-theme={midnightThemeSlug} data-theme-midnight={midnightThemeSlug} data-theme-dawn={dawnThemeSlug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:site_name" content={brandName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={resolvedOgImage} />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    
    <!-- Theme Color -->
    <meta name="theme-color" content={themeMetaColor} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Webfont loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Great+Vibes&family=Inter:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600;7..72,700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Parisienne&display=swap"
    />
    
    <!-- Theme Preference Script (must run before body render) -->
    <script is:inline>
      (() => {
        const STORAGE_KEY = 'witchclick-comfort';
        const LEGACY_KEYS = ['comfort-preferences'];

        const migrateLegacy = () => {
          try {
            if (localStorage.getItem(STORAGE_KEY)) return;
            for (const key of LEGACY_KEYS) {
              const value = localStorage.getItem(key);
              if (value) {
                localStorage.setItem(STORAGE_KEY, value);
                localStorage.removeItem(key);
                break;
              }
            }
          } catch (error) {
            /* no-op */
          }
        };

        const readPrefs = () => {
          migrateLegacy();
          try {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (!stored) return null;
            const parsed = JSON.parse(stored);
            if (!parsed || typeof parsed !== 'object') return null;
            return {
              theme: parsed.theme === 'dawn' ? 'dawn' : null,
              font: parsed.font === 'sans' ? 'sans' : null,
            };
          } catch (error) {
            return null;
          }
        };

        try {
          const prefs = readPrefs();
          const root = document.documentElement;

          if (!root) return;

          const applyTheme = (theme) => {
            if (theme === 'dawn') {
              root.setAttribute('data-comfort-theme', 'dawn');
              root.classList.remove('dark'); // REMOVE 'dark' class for dawn theme
              const dawnSlug = root.getAttribute('data-theme-dawn');
              if (dawnSlug) {
                root.setAttribute('data-theme', dawnSlug);
              }
            } else {
              root.removeAttribute('data-comfort-theme');
              root.classList.add('dark'); // ADD 'dark' class for midnight/dark theme
              const midnightSlug = root.getAttribute('data-theme-midnight');
              if (midnightSlug) {
                root.setAttribute('data-theme', midnightSlug);
              }
            }
          };

          const applyFont = (font) => {
            if (font) {
              root.setAttribute('data-comfort-font', font);
            } else {
              root.removeAttribute('data-comfort-font');
            }
          };

          const syncBody = (theme, font) => {
            const body = document.body;
            if (!body) return;

            if (theme === 'dawn') {
              body.setAttribute('data-comfort-theme', 'dawn');
            } else {
              body.removeAttribute('data-comfort-theme');
            }

            if (font) {
              body.setAttribute('data-comfort-font', font);
            } else {
              body.removeAttribute('data-comfort-font');
            }
          };

          if (!prefs) {
            applyTheme(null);
            applyFont(null);

            const clearBody = () => syncBody(null, null);
            if (document.readyState === 'complete') {
              clearBody();
            } else {
              document.addEventListener('DOMContentLoaded', clearBody, { once: true });
            }
            return;
          }

          applyTheme(prefs.theme);
          applyFont(prefs.font);

          const applyBody = () => syncBody(prefs.theme, prefs.font);

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', applyBody, { once: true });
          } else {
            applyBody();
          }
        } catch (error) {
          // Silent fail - preferences will use defaults
        }
      })();
    </script>

    <slot name="head" />
    {analytics?.head?.attributes && (
      <script is:inline {...analytics.head.attributes}></script>
    )}
  </head>
  
  <body
    id="top"
    class:list={
      [
        "site-shell",
        wide && "is-wide",
        desktopWide && "is-desktop-wide",
        isPlainReadingRoute && "site-shell--plain",
      ].filter(Boolean)
    }
    style={bodyStyle}
    data-entity-type={bodyDataType || undefined}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- Base.astro: persistent theme loader (runtime site-wide)

         This script applies custom theme tokens on every page load.
         Token System Architecture:
         - localStorage key: "wc-active-theme" (set by theme-manager.ts)
         - Token format: HSL for colors, hex for status colors
         - Aligned with: src/styles/tokens.css (fallback defaults)
         - Aligned with: theme-manager.ts applyThemeToDocument()

         Both admin and public pages use identical token names for consistency.
    -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("wc-active-theme");
          if (!saved) {
            return;
          }
          const t = JSON.parse(saved);
          const root = document.documentElement;

          // set mode attributes
          const modeAttr = t.id && t.id.includes("dawn") || t.mode === "light" || t.mode === "dawn" ? "dawn" : "midnight";
          // Use actual theme slug instead of hardcoded values
          const themeSlug = t.slug || t.id || (modeAttr === "dawn" ? "cozy-dawn" : "cozy-midnight");
          root.setAttribute("data-theme", themeSlug);
          // Only set data-comfort-theme for dawn mode (matches applyThemeToDocument behavior)
          if (modeAttr === "dawn") {
            root.setAttribute("data-comfort-theme", "dawn");
          } else {
            root.removeAttribute("data-comfort-theme");
          }

          // apply tokens
          const map = {
            "--accent-1": "accent1","--accent-2": "accent2","--accent-3": "accent3",
            "--surface-base": "surfaceBase","--surface-panel": "surfacePanel","--surface-card": "surfaceCard",
            "--surface-elevated": "surfaceElevated","--surface-hover": "surfaceHover",
            "--text-strong": "textStrong","--text-body": "textBody","--text-muted": "textMuted",
            "--border-subtle": "borderSubtle","--border-strong": "borderStrong",
            "--page-bg-base": "pageBackground",
            "--header-bg-base": "headerBackground","--header-border-base": "headerBorder",
            "--footer-bg-base": "footerBackground","--footer-border-base": "footerBorder"
          };
          const tokens = t.tokens || {};
          let appliedCount = 0;
          Object.entries(map).forEach(([cssVar, key]) => {
            const val = tokens[key];
            if (typeof val === "string" && val.startsWith("hsl(")) {
              // Strip "hsl(" prefix and ")" suffix to get just the HSL components
              const stripped = val.replace("hsl(", "").replace(")", "");
              root.style.setProperty(cssVar, stripped);
              appliedCount++;
            }
          });

          // Status colors (plain hex values)
          const statusMap = {
            "--success": "success","--warning": "warning","--error": "error","--info": "info"
          };
          let statusCount = 0;
          Object.entries(statusMap).forEach(([cssVar, key]) => {
            const val = tokens[key];
            if (typeof val === "string" && val.startsWith("#")) {
              root.style.setProperty(cssVar, val);
              statusCount++;
            }
          });

          // derive accent-linked globals
          const get = (v) => getComputedStyle(root).getPropertyValue(v).trim();
          const accent1Value = get("--accent-1");
          const accent1Full = `hsl(${accent1Value})`;
          root.style.setProperty("--text-accent", accent1Value);
          root.style.setProperty("--ring-focus", `0 0 0 3px ${accent1Full}`);
          root.style.setProperty("--link-color", accent1Full);

          void appliedCount;
          void statusCount;
          void get;
        } catch (e) {
          // Theme token overrides are optional; fail silent in production.
        }
      })();
    </script>

    <Header
      brandName={brandName}
      navLinks={navLinks}
      secondaryLinks={secondaryLinks}
      utilityLinks={headerUtility}
      adminSections={adminSections}
      currentPath={currentPath}
    />

    <div class="site-shell__content">
      <main
        id="main"
        tabindex="-1"
        class:list={
          [
            "site-main",
            wide && "is-wide",
            desktopWide && "is-desktop-wide",
            isPlainReadingRoute && "site-main--plain",
          ].filter(Boolean)
        }
        style={bodyStyle}
        data-entity-type={bodyDataType || undefined}
      >
        <div
          class:list={containerClassList}
        >
          <div class="site-main__breadcrumbs">
            <slot name="breadcrumbs" />
          </div>
          <div class:list={contentClassList}>
            <slot />
          </div>
        </div>
      </main>
    </div>

    <Footer
      brandName={brandName}
      navLinks={navLinks}
      secondaryNavLinks={secondaryLinks}
      utilityLinks={footerUtilities}
      disclosure={disclosure}
      currentPath={currentPath}
    />
    
	    <!-- Analytics -->
	    {analytics?.config?.inline && (
	      <script is:inline set:html={analytics.config.inline}></script>
	    )}
		    {analytics?.runtime?.inline && (
		      <script is:inline set:html={analytics.runtime.inline}></script>
		    )}
		    <script is:inline src="/clickthrough.js"></script>
		    <script is:inline define:vars={{ formEndpoint }}>
		      (() => {
		        const configuredEndpoint = typeof formEndpoint === "string" ? formEndpoint.trim() : "";
		        const forms = Array.from(document.querySelectorAll('form[data-netlify="true"]'));
		        if (!forms.length) return;

		        const ensureStatusNode = (form) => {
		          const existing = form.querySelector("[data-form-status]");
		          if (existing instanceof HTMLElement) return existing;
		          const node = document.createElement("p");
		          node.className = "wc-form-status";
		          node.dataset.formStatus = "";
		          node.hidden = true;
		          node.setAttribute("aria-live", "polite");
		          form.appendChild(node);
		          return node;
		        };

		        const setStatus = (node, state, message) => {
		          node.hidden = false;
		          node.className = "wc-form-status";
		          node.dataset.state = state;
		          if (state) node.classList.add(`wc-form-status--${state}`);
		          node.textContent = message;
		          node.setAttribute("role", state === "error" ? "alert" : "status");
		          node.setAttribute("aria-live", state === "error" ? "assertive" : "polite");
		        };

		        const clearStatus = (node) => {
		          node.hidden = true;
		          node.className = "wc-form-status";
		          node.dataset.state = "";
		          node.textContent = "";
		          node.removeAttribute("role");
		          node.setAttribute("aria-live", "polite");
		        };

		        const resolveEndpoint = (form) => {
		          const perForm = (form.getAttribute("data-form-endpoint") || "").trim();
		          return perForm || configuredEndpoint;
		        };

		        const toggleSubmitting = (form, isSubmitting) => {
		          form.setAttribute("aria-busy", isSubmitting ? "true" : "false");
		          const submitControls = form.querySelectorAll('button[type="submit"], input[type="submit"]');
		          submitControls.forEach((control) => {
		            if (control instanceof HTMLButtonElement || control instanceof HTMLInputElement) {
		              control.disabled = isSubmitting;
		            }
		          });
		        };

		        const toBodyString = (formData) => {
		          const params = new URLSearchParams();
		          for (const [key, value] of formData.entries()) {
		            if (typeof value === "string") {
		              params.append(key, value);
		            }
		          }
		          return params.toString();
		        };

		        const parseErrorDetail = async (response) => {
		          const contentType = response.headers.get("content-type") || "";
		          if (contentType.includes("application/json")) {
		            try {
		              const payload = await response.json();
		              if (payload && typeof payload === "object") {
		                const message = payload.error || payload.message;
		                if (typeof message === "string" && message.trim()) {
		                  return message.trim();
		                }
		              }
		            } catch (_error) {
		              // Ignore parse issues and fall back to status text.
		            }
		          }
		          const statusText = response.statusText ? ` ${response.statusText}` : "";
		          return `HTTP ${response.status}${statusText}`.trim();
		        };

		        forms.forEach((node) => {
		          if (!(node instanceof HTMLFormElement)) return;
		          const form = node;
		          const statusNode = ensureStatusNode(form);
		          const successMessage =
		            form.getAttribute("data-form-success") || "Thanks! Your message was sent.";
		          const defaultErrorMessage =
		            form.getAttribute("data-form-error") ||
		            "We couldn't send that right now. Please try again in a moment.";

		          form.addEventListener("submit", async (event) => {
		            event.preventDefault();
		            if (!form.reportValidity()) return;
		            clearStatus(statusNode);

		            const endpoint = resolveEndpoint(form);
		            if (!endpoint) {
		              setStatus(
		                statusNode,
		                "error",
		                "Form delivery is not configured yet. Please set formEndpoint in content/settings.json.",
		              );
		              return;
		            }

		            const payload = new FormData(form);
		            if (!payload.get("form-name")) {
		              const formName = form.getAttribute("name");
		              if (formName) payload.set("form-name", formName);
		            }

		            setStatus(statusNode, "pending", "Sending...");
		            toggleSubmitting(form, true);

		            try {
		              const response = await fetch(endpoint, {
		                method: "POST",
		                headers: {
		                  "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
		                  Accept: "application/json",
		                },
		                body: toBodyString(payload),
		              });

		              if (!response.ok) {
		                const detail = await parseErrorDetail(response);
		                throw new Error(detail);
		              }

		              form.reset();
		              setStatus(statusNode, "success", successMessage);
		            } catch (error) {
		              const detail = error instanceof Error ? error.message : "";
		              const suffix = detail ? ` (${detail})` : "";
		              setStatus(statusNode, "error", `${defaultErrorMessage}${suffix}`);
		            } finally {
		              toggleSubmitting(form, false);
		            }
		          });
		        });
		      })();
		    </script>
		    
		    <!-- Observability -->
		    {observabilityConfig && (
	      <script type="module" is:inline define:vars={{ observabilityConfig }}>
	        import { initObservability } from "@/utils/observability";
        initObservability(observabilityConfig);
      </script>
    )}
    
    <!-- Card Animations -->
    <script type="module" is:inline src={cardAnimationsModule}></script>
    
