---
/* src/layouts/Base.astro */
import "../styles/tailwind.css";
import SearchBox from "../components/SearchBox.astro";
import { readSettings, getSiteOrigin, toAbsoluteUrl } from "../utils/settings";
import { getTheme } from "../utils/theme";

const props = Astro.props || {};
const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  ogImage = "",
  noindex = false,
} = props;

const settings = readSettings();
const brandName = settings.brandName ?? "WitchClick";
const siteOrigin = getSiteOrigin(settings);
const here = Astro.url?.pathname ?? "/";

const canonicalUrl = canon
  ? canon.startsWith("http")
    ? canon
    : toAbsoluteUrl(canon, settings)
  : siteOrigin
    ? `${siteOrigin}${here}`
    : "";

const pageTitle = title && title !== brandName ? `${title} — ${brandName}` : brandName;
const ogImg = ogImage ? toAbsoluteUrl(ogImage, settings) : (siteOrigin ? `${siteOrigin}/og-default.png` : "");
const theme = getTheme();

const headerWidthClass = wide ? "max-w-6xl" : "max-w-4xl";
const mainWidthClass = wide ? "max-w-6xl" : "max-w-3xl";

const links = [
  { href: "/", label: "Home" },
  { href: "/entities", label: "Entities" },
  { href: "/downloads", label: "Downloads" },
  ...(import.meta.env.DEV
    ? [
        { href: "/admin", label: "Post Generator", rel: "nofollow" },
        { href: "/admin/write", label: "Write", rel: "nofollow" },
        { href: "/admin/entities", label: "Entities Admin", rel: "nofollow" },
        { href: "/admin/downloads", label: "Downloads Admin", rel: "nofollow" },
        { href: "/admin/hero", label: "Hero Uploader", rel: "nofollow" },
      ]
    : []),
];

const bodyStyle = `
  --color-primary: ${theme.primary};
  --color-accent: ${theme.accent};
  --color-background: ${theme.background};
  --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-serif: '${theme.fontSerif}', ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
  --font-script: '${theme.fontScript}', cursive;
  background: ${theme.background};
`;
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* Social defaults */}
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImg && <meta property="og:image" content={ogImg} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={theme.primary} />
    <meta name="color-scheme" content="light" />

    {/* Discoverability helpers */}
    <link rel="alternate" type="application/rss+xml" title={`${brandName} RSS`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {/* Fonts perf */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,300;7..72,400;7..72,700&family=Parisienne&display=swap"
    />

    <style is:inline>
      :root {
        font-family: var(--font-sans, "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
      }

      h1, h2, h3, h4, .font-serif {
        font-family: var(--font-serif, Literata, ui-serif, Georgia, Cambria, "Times New Roman", Times, serif);
      }

      .font-script {
        font-family: var(--font-script);
      }
    </style>

    {/* Page-level head slot */}
    <slot name="head" />
  </head>

  <body class="min-h-screen text-gray-900 wc-sans-body" style={bodyStyle}>
    {/* Skip link for a11y */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 rounded bg-black px-3 py-2 text-white"
    >
      Skip to content
    </a>

    <header class={`mx-auto ${headerWidthClass} px-4 pb-4 pt-6`}> 
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a href="/" class="text-3xl wc-serif-heading text-[var(--color-primary)]">{brandName}</a>
        <nav class="text-sm wc-smallcaps" aria-label="Primary">
          <ul class="flex flex-wrap items-center gap-4">
            {links.map((l) => {
              const active = here === l.href || (l.href !== "/" && here.startsWith(l.href + "/"));
              return (
                <li>
                  <a
                    href={l.href}
                    rel={l.rel}
                    aria-current={active ? "page" : undefined}
                    class={`rounded-full px-3 py-1 text-sm transition-colors hover:bg-purple-50 ${
                      active ? "bg-purple-100 text-purple-900" : "text-purple-700"
                    }`}
                  >
                    {l.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <div class="hidden sm:block"><SearchBox /></div>
      </div>
    </header>

    <main id="main" class={`mx-auto ${mainWidthClass} px-4 pb-16`}>
      <div class="sm:hidden mb-6"><SearchBox /></div>
      <slot />
    </main>

    {/* CTA slot (filled only on posts) */}
    <slot name="cta" />

    <footer class="mt-auto border-t border-purple-100/60 bg-white/70">
      <div class={`mx-auto ${mainWidthClass} px-4 py-8 text-sm leading-relaxed text-gray-700`}>
        {settings.disclosure && <p class="mb-2">{settings.disclosure}</p>}
        <p class="flex flex-wrap items-center gap-3">
          <a class="underline underline-offset-4 hover:no-underline" href="/rss.xml">RSS</a>
          <span aria-hidden="true">•</span>
          <a class="underline underline-offset-4 hover:no-underline" href="/sitemap-index.xml">Sitemap</a>
          {canonicalUrl && (
            <span class="inline-flex items-center gap-3">
              <span aria-hidden="true">•</span>
              <a class="underline underline-offset-4 hover:no-underline" href={canonicalUrl}>Permalink</a>
            </span>
          )}
        </p>
        <p class="mt-3 text-gray-500">© {new Date().getFullYear()} {brandName}.</p>
      </div>
    </footer>

    {/* Optional page-tail slot for per-page scripts */}
    <slot name="foot" />
  </body>
</html>
