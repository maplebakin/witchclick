---
/* src/layouts/Base.astro */
import "../styles/tailwind.css";
import SearchBox from "../components/SearchBox.astro";
import { readSettings, getSiteOrigin, toAbsoluteUrl, getTheme } from "../utils/settings";

const props = Astro.props || {};
const {
  title = "WitchClick",
  description = "",
  canon = "",
  wide = false,
  ogImage = "",
  noindex = false,
} = props;

const settings = readSettings();
const brandName = settings.brandName ?? "WitchClick";
const siteOrigin = getSiteOrigin(settings);
const here = Astro.url?.pathname ?? "/";

const canonicalUrl = canon
  ? canon.startsWith("http")
    ? canon
    : toAbsoluteUrl(canon, settings)
  : siteOrigin
    ? `${siteOrigin}${here}`
    : "";

const pageTitle = title && title !== brandName ? `${title} — ${brandName}` : brandName;
const ogImg = ogImage ? toAbsoluteUrl(ogImage, settings) : (siteOrigin ? `${siteOrigin}/og-default.png` : "");
const theme = getTheme(settings);

const headerWidthClass = wide ? "max-w-6xl" : "max-w-4xl";
const mainWidthClass = wide ? "max-w-6xl" : "max-w-3xl";

const links = [
  { href: "/", label: "Home" },
  { href: "/entities", label: "Entities" },
  { href: "/downloads", label: "Downloads" },
  ...(import.meta.env.DEV
    ? [
        { href: "/admin", label: "Post Generator", rel: "nofollow" },
        { href: "/admin/write", label: "Write", rel: "nofollow" },
        { href: "/admin/entities", label: "Entities Admin", rel: "nofollow" },
        { href: "/admin/downloads", label: "Downloads Admin", rel: "nofollow" },
      ]
    : []),
];

const bodyStyle = `
  --color-primary: ${theme.primary};
  --color-accent: ${theme.accent};
  --color-background: ${theme.background};
  --font-serif: '${theme.fontSerif}', ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
  --font-script: '${theme.fontScript}', cursive;
  background: ${theme.background};
  background-image: radial-gradient(circle at top left, rgba(167, 139, 250, 0.18), transparent 45%),
    radial-gradient(circle at bottom right, rgba(251, 191, 36, 0.16), transparent 40%);
  background-attachment: fixed;
`;
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {noindex && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {/* Social defaults */}
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImg && <meta property="og:image" content={ogImg} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={theme.primary} />
    <meta name="color-scheme" content="light" />

    {/* Discoverability helpers */}
    <link rel="alternate" type="application/rss+xml" title={`${brandName} RSS`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {/* Fonts perf */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,300;7..72,400;7..72,700&family=Parisienne&display=swap"
    />

    <style is:inline>
      :root {
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      h1, h2, h3, .font-serif {
        font-family: var(--font-serif);
      }

      .font-script {
        font-family: var(--font-script);
      }
    </style>

    {/* Page-level head slot */}
    <slot name="head" />
  </head>

  <body class="relative min-h-screen text-slate-900" style={bodyStyle}>
    <div class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(circle_at_10%_20%,rgba(199,181,255,0.35),transparent_55%),radial-gradient(circle_at_90%_80%,rgba(254,215,170,0.3),transparent_45%)]"></div>

    <div class="relative flex min-h-screen flex-col">
      {/* Skip link for a11y */}
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 rounded bg-black px-3 py-2 text-white"
      >
        Skip to content
      </a>

      <header class={`mx-auto ${headerWidthClass} px-4 pb-4 pt-6`}>
        <div class="glass-panel flex flex-wrap items-center justify-between gap-4 px-6 py-4">
          <a href="/" class="text-3xl font-script text-[var(--color-primary)]">{brandName}</a>
          <nav class="text-sm" aria-label="Primary">
            <ul class="flex flex-wrap items-center gap-2 sm:gap-3">
              {links.map((l) => {
                const active = here === l.href || (l.href !== "/" && here.startsWith(l.href + "/"));
                return (
                  <li>
                    <a
                      href={l.href}
                      rel={l.rel}
                      aria-current={active ? "page" : undefined}
                      class={`inline-flex items-center rounded-full px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400 ${
                        active
                          ? "bg-purple-600 text-white shadow-sm"
                          : "text-purple-700 hover:bg-purple-100/80"
                      }`}
                    >
                      {l.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
          <div class="hidden sm:block"><SearchBox /></div>
        </div>
      </header>

      <main id="main" class={`mx-auto ${mainWidthClass} px-4 pb-16`}>
        <div class="mb-6 sm:hidden">
          <SearchBox />
        </div>
        <div class="flex flex-col gap-12">
          <slot />
        </div>
      </main>

      {/* CTA slot (filled only on posts) */}
      <slot name="cta" />

      <footer class="mt-auto pb-12 pt-4">
        <div class={`mx-auto ${mainWidthClass} px-4`}>
          <div class="glass-panel flex flex-col gap-4 text-sm leading-relaxed text-slate-600">
            {settings.disclosure && <p>{settings.disclosure}</p>}
            <p class="flex flex-wrap items-center gap-3 text-slate-500">
              <a class="font-medium text-purple-700 underline-offset-4 transition hover:text-purple-900 hover:underline" href="/rss.xml">RSS</a>
              <span aria-hidden="true">•</span>
              <a class="font-medium text-purple-700 underline-offset-4 transition hover:text-purple-900 hover:underline" href="/sitemap-index.xml">Sitemap</a>
              {canonicalUrl && (
                <span class="inline-flex items-center gap-3">
                  <span aria-hidden="true">•</span>
                  <a class="font-medium text-purple-700 underline-offset-4 transition hover:text-purple-900 hover:underline" href={canonicalUrl}>Permalink</a>
                </span>
              )}
            </p>
            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">© {new Date().getFullYear()} {brandName}</p>
          </div>
        </div>
      </footer>

      {/* Optional page-tail slot for per-page scripts */}
      <slot name="foot" />
    </div>
  </body>
</html>
