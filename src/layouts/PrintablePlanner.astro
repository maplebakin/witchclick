---
import { readSettings } from '../utils/settings';

const settings = readSettings();
const {
  title = "Printable Planner",
  description = "",
  accent: propAccent,
} = Astro.props;

// Determine active theme's accent for a dynamic accent
const activeMidnight = settings.activeThemes?.midnight;
const activeDawn = settings.activeThemes?.dawn;
const themeAccent = activeMidnight?.accent || activeDawn?.accent || propAccent || '#B04F5C'; // Use Yule Cranberry Red as default fallback if no theme accent
const accent = themeAccent;

// Get thematic fonts and colors
const defaultText = '#2C3E50'; // Dark Charcoal
const defaultMuted = '#6A807E'; // Muted Green-Gray
const defaultPlainSurface = '#F5F8F7'; // Pale Icy Blue/White
const defaultCardSurface = '#E8ECEB'; // Slightly darker surface
const defaultElevatedSurface = '#D9DFDE'; // More elevated surface
const defaultBorder = '#CCD3D2'; // Pale Border
const defaultShadow = '0 8px 24px rgba(44, 62, 80, 0.1)'; // Subtle dark shadow

const currentFontHeading = activeMidnight?.fontHeading || activeDawn?.fontHeading || 'Cinzel';
const currentFontBody = activeMidnight?.fontSerif || activeDawn?.fontSerif || 'Cormorant Garamond';

const currentSurfacePlain = activeMidnight?.surfacePlain || activeDawn?.surfacePlain || defaultPlainSurface;
const currentSurfaceCard = activeMidnight?.cardPanelSurface || activeDawn?.cardPanelSurface || defaultCardSurface;
const currentSurfaceElevated = activeMidnight?.cardPanelSurfaceStrong || activeDawn?.cardPanelSurfaceStrong || defaultElevatedSurface;
const currentBorderSubtle = activeMidnight?.cardPanelBorderSoft || activeDawn?.cardPanelBorderSoft || defaultBorder;
const currentShadowSoft = activeMidnight?.shadowSoft || activeDawn?.shadowSoft || defaultShadow;

const currentText = activeMidnight?.textBody || activeDawn?.textBody || defaultText;
const currentTextMuted = activeMidnight?.textMuted || activeDawn?.textMuted || defaultMuted;

const rootStyle = {
  '--accent': accent,
  '--text': currentText,
  '--muted': currentTextMuted,
  '--surface-plain': currentSurfacePlain,
  '--surface-card': currentSurfaceCard,
  '--surface-elevated': currentSurfaceElevated,
  '--border-subtle': currentBorderSubtle,
  '--shadow-soft': currentShadowSoft,
  '--font-heading': `"${currentFontHeading}", serif`,
  '--font-body': `"${currentFontBody}", serif`,
};
---
<!DOCTYPE html>
<html lang="en" style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style>
      @page {
        size: A4;
        margin: 0.5in;
      }

      :root {
        color-scheme: light;
        font-family: var(--font-heading);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        color: var(--text);
        background: var(--surface-plain);
        font-family: var(--font-body);
      }

      main {
        background: var(--surface-card);
        border-radius: 16px;
        padding: clamp(1rem, 5vw, 2.5rem);
        box-shadow: var(--shadow-soft);
        min-height: calc(100vh - 2rem);
      }

      h1 {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: var(--accent);
      }

      :global(h2) {
        font-family: var(--font-heading);
        font-size: 1.75rem;
        margin-top: 2.5rem;
        margin-bottom: 0.75rem;
        color: var(--text);
      }

      :global(p),
      :global(li) {
        font-size: 1rem;
        line-height: 1.6;
      }

      :global(.grid) {
        display: grid;
        gap: 1.5rem;
      }

      :global(.three-columns) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      :global(.card) {
        border: 2px solid var(--border-subtle);
        border-radius: 16px;
        padding: 1.25rem;
        background: var(--surface-elevated);
        min-height: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      :global(.card h3) {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--accent);
      }

      :global(.card ul) {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.5rem;
      }

      :global(.checkbox-row) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.75rem;
      }

      :global(.checkbox) {
        height: 20px;
        width: 20px;
        border: 2px solid var(--accent);
        border-radius: 6px;
        background: var(--theme-surface-plain);
      }

      footer {
        margin-top: 2.5rem;
        font-size: 0.8rem;
        color: var(--muted);
        text-align: center;
      }

      .print-control {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 10;
        min-height: 44px;
        border: 2px solid var(--accent);
        border-radius: 999px;
        padding: 0.65rem 1rem;
        background: var(--surface-plain);
        color: var(--text);
        font: 600 0.9rem/1 var(--font-body);
        cursor: pointer;
      }

      .print-control:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
      }

      @media print {
        body {
          background: white;
        }
        main {
          box-shadow: none;
          border-radius: 0;
          padding: 0;
          min-height: auto;
        }
        .print-control { display: none; }
      }
    </style>
  </head>
  <body>
    <button type="button" class="print-control" data-print-control>Print / save PDF</button>
    <main style={{ "--accent": accent }}>
      <header>
        <h1>{title}</h1>
        {description && <p>{description}</p>}
      </header>
      <slot />
      <footer>Crafted by WitchClick. May your rituals be kind and your spells true.</footer>
    </main>
    <script is:inline>
      document.querySelector('[data-print-control]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
