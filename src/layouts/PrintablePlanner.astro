---
const {
  title = "Printable Planner",
  description = "",
  accent = "#7c3aed",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style>
      @page {
        size: A4;
        margin: 1in;
      }

      :root {
        color-scheme: light;
        font-family: "Crimson Pro", "Georgia", serif;
        --accent: #7c3aed;
        --text: #1f1f1f;
        --muted: #6b7280;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        color: var(--text);
        background: #f9f9fb;
        font-family: "Inter", "Helvetica Neue", sans-serif;
      }

      main {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 15px 45px rgba(67, 56, 202, 0.08);
        min-height: calc(100vh - 2rem);
      }

      h1 {
        font-family: "Crimson Pro", "Georgia", serif;
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: var(--accent);
      }

      h2 {
        font-family: "Crimson Pro", "Georgia", serif;
        font-size: 1.75rem;
        margin-top: 2.5rem;
        margin-bottom: 0.75rem;
        color: var(--text);
      }

      p, li {
        font-size: 1rem;
        line-height: 1.6;
      }

      .grid {
        display: grid;
        gap: 1.5rem;
      }

      .three-columns {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .card {
        border: 2px solid rgba(124, 58, 237, 0.25);
        border-radius: 16px;
        padding: 1.25rem;
        background: rgba(124, 58, 237, 0.05);
        min-height: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .card h3 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--accent);
      }

      .card ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.5rem;
      }

      .checkbox-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.75rem;
      }

      .checkbox {
        height: 20px;
        width: 20px;
        border: 2px solid var(--accent);
        border-radius: 6px;
      }

      footer {
        margin-top: 2.5rem;
        font-size: 0.8rem;
        color: var(--muted);
        text-align: center;
      }

      @media print {
        body {
          background: white;
        }
        main {
          box-shadow: none;
          border-radius: 0;
          padding: 1.25in;
        }
      }
    </style>
  </head>
  <body>
    <main style={{ "--accent": accent }}>
      <header>
        <h1>{title}</h1>
        {description && <p>{description}</p>}
      </header>
      <slot />
      <footer>Crafted for WitchClick ritual lab printables. Print to PDF or keep as a reusable digital planner.</footer>
    </main>
  </body>
</html>
