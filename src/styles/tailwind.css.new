/* ===========================================================================
   TAILWIND INTEGRATION & CUSTOM UTILITIES - WitchClick
   Tailwind base + custom components and utilities
   =========================================================================== */

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ---------------------------------------------------------------------------
   CSS Variables - Extended Design Tokens
   --------------------------------------------------------------------------- */

:root {
  /* Canvas & Background */
  --wc-canvas-from: hsl(270 60% 98%);
  --wc-canvas-to: hsl(270 40% 92%);
  --wc-canvas-vignette: 0 0 0 / 0.08;

  /* Surface Tint & Patterns */
  --surface-tint: hsl(270 55% 62%);
  --surface-parchment: radial-gradient(
    125% 125% at 50% 0%,
    color-mix(in oklab, white 96%, var(--surface-tint) 4%) 0%,
    color-mix(in oklab, white 92%, var(--surface-tint) 8%) 55%,
    color-mix(in oklab, white 88%, var(--surface-tint) 12%) 100%
  );
  --surface-parchment-overlay: linear-gradient(
    180deg,
    color-mix(in oklab, white 92%, var(--surface-tint) 8%) 0%,
    color-mix(in oklab, white 88%, var(--surface-tint) 12%) 100%
  );
  --surface-starfield: 
    radial-gradient(circle at 12% 18%, rgba(255, 255, 255, 0.18), transparent 42%),
    radial-gradient(circle at 82% 8%, rgba(255, 255, 255, 0.16), transparent 50%),
    radial-gradient(circle at 65% 72%, rgba(255, 255, 255, 0.14), transparent 58%),
    radial-gradient(circle at 28% 68%, rgba(255, 255, 255, 0.1), transparent 55%);

  /* Glow Effects */
  --glow-iris: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 24%, transparent);
  --glow-horizon: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 16%, white 10%);
  --glow-ember: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 12%, black 4%);

  /* Ink Colors */
  --ink-strong: color-mix(in srgb, black 38%, var(--ambient-color, var(--color-primary)) 24%);
  --ink-body: color-mix(in srgb, black 28%, var(--ambient-color, var(--color-primary)) 18%);
  --ink-muted: color-mix(in srgb, black 18%, var(--ambient-color, var(--color-primary)) 14%);
  --wc-ink-label: color-mix(in oklab, var(--ink-strong) 72%, var(--ink-muted) 28%);

  /* Panel Surfaces */
  --panel-surface-strong: color-mix(in srgb, var(--color-night, #120725) 78%, var(--surface-tint) 22%);
  --panel-surface-soft: color-mix(in srgb, var(--color-dusk, #271534) 72%, var(--surface-tint) 28%);
  --panel-border-strong: hsl(270 30% 75% / 0.35);
  --panel-border-soft: hsl(270 30% 82% / 0.3);
  --panel-muted-surface: var(--panel-surface-soft);
  --panel-muted-border: var(--panel-border-soft);
  --panel-muted-text: var(--ink-body);

  /* Shadows */
  --shadow-1: var(--elevation-tier-1);
  --shadow-2: var(--elevation-tier-2);
  --wc-shadow-soft: 0 12px 30px -18px rgb(17 24 39 / 0.18);
  --wc-shadow-strong: 0 22px 60px -28px rgb(17 24 39 / 0.3);
  --wc-shadow-lifted: 0 28px 60px -35px rgb(17 24 39 / 0.35);

  /* Actions (Buttons) */
  --action-primary: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 88%, black 12%);
  --action-primary-hover: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 90%, black 18%);
  --action-primary-text: color-mix(in srgb, white 92%, var(--ambient-color, var(--color-primary)) 8%);
  --action-secondary-surface: color-mix(in srgb, white 94%, var(--ambient-color, var(--color-primary)) 6%);
  --action-secondary-hover: color-mix(in srgb, white 90%, var(--ambient-color, var(--color-primary)) 10%);
  --action-secondary-border: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 35%, transparent);
  --action-secondary-text: color-mix(in srgb, var(--ambient-color, var(--color-primary)) 62%, var(--ink-body) 38%);

  /* Border Radii */
  --wc-radius-lg: 1.5rem;
  --wc-radius-xl: 1.75rem;
  --wc-radius-xxl: 2rem;

  /* Glass Panel */
  --glass-panel-radius: 1.75rem;
  --glass-panel-blur: 18px;
  --glass-panel-border: rgba(124, 58, 237, 0.18);
  --glass-panel-overlay: transparent;
  --glass-panel-shadow: var(--elevation-tier-1);

  /* Background Layers */
  --wc-bg-layer-1: radial-gradient(140% 80% at 50% -20%, oklch(0.94 0.08 300) 0%, transparent 65%);
  --wc-bg-layer-2: linear-gradient(180deg, oklch(0.97 0.04 305) 0%, oklch(0.9 0.06 295) 100%);

  /* Section Variables */
  --section-border: rgba(124, 58, 237, 0.18);
  --section-glow: rgba(124, 58, 237, 0.18);
  --section-highlight: rgba(212, 175, 55, 0.12);
  --section-surface-top: rgba(255, 255, 255, 0.96);
  --section-surface-bottom: rgba(248, 244, 255, 0.98);
  --section-text: color-mix(in srgb, #2a1a3f 92%, black 8%);
  --section-veil: rgba(255, 255, 255, 0.32);
}

/* ---------------------------------------------------------------------------
   Body Styles
   --------------------------------------------------------------------------- */

body {
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--card-panel-surface-strong);
}

/* Prose (Content) Font */
.prose {
  font-family: var(--font-serif, Literata, ui-serif, Georgia, Cambria, "Times New Roman", Times, serif);
}

/* Link Reset */
a {
  color: inherit;
}

/* ---------------------------------------------------------------------------
   Custom Components
   --------------------------------------------------------------------------- */

@layer components {
  /* Panel Components */
  .panel,
  .soft-card {
    position: relative;
    border-radius: var(--wc-radius-xl, var(--glass-panel-radius));
    border: 1px solid var(--panel-border-strong);
    background: 
      radial-gradient(
        130% 120% at 18% -12%,
        color-mix(in srgb, var(--surface-tint, hsl(270 55% 62%)) 24%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--panel-surface-strong) 88%, var(--color-night, #120725) 12%) 0%,
        color-mix(in srgb, var(--color-night, #120725) 85%, black 15%) 100%
      );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--wc-shadow-soft, var(--shadow-2));
    overflow: hidden;
  }

  .soft-card {
    border-color: var(--panel-border-soft);
    background: 
      radial-gradient(
        130% 120% at 18% -12%,
        color-mix(in srgb, var(--surface-tint, hsl(270 55% 62%)) 18%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--panel-surface-soft) 88%, var(--color-night, #120725) 12%) 0%,
        color-mix(in srgb, var(--color-dusk, #271534) 82%, black 18%) 100%
      );
    box-shadow: var(--wc-shadow-soft, var(--shadow-1));
  }

  /* Dawn Theme Overrides */
  :root[data-comfort-theme="dawn"] .panel,
  :root[data-comfort-theme="dawn"] .soft-card {
    border-color: rgba(122, 94, 154, 0.28);
    background: 
      radial-gradient(
        130% 120% at 18% -12%,
        color-mix(in srgb, var(--surface-tint, hsl(270 55% 62%)) 12%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(
        160deg,
        rgba(255, 252, 247, 0.92) 0%,
        rgba(245, 238, 232, 0.95) 100%
      );
  }

  :root[data-comfort-theme="dawn"] .soft-card {
    border-color: rgba(166, 138, 198, 0.25);
    background: 
      radial-gradient(
        130% 120% at 18% -12%,
        color-mix(in srgb, var(--surface-tint, hsl(270 55% 62%)) 8%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(
        160deg,
        rgba(255, 252, 247, 0.88) 0%,
        rgba(248, 242, 238, 0.92) 100%
      );
  }

  /* Muted Panel */
  .panel-muted {
    position: relative;
    border-radius: clamp(1.6rem, 4vw, 2.5rem);
    border: 1px solid var(--panel-muted-border);
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--panel-muted-surface) 95%, transparent) 0%,
      color-mix(in srgb, var(--panel-muted-surface) 82%, transparent) 75%
    );
    color: var(--panel-muted-text);
    backdrop-filter: blur(var(--glass-panel-blur));
    -webkit-backdrop-filter: blur(var(--glass-panel-blur));
    overflow: hidden;
  }

  .panel-muted::before {
    content: "";
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(
        135% 135% at 12% -10%,
        color-mix(in srgb, var(--panel-muted-border) 45%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        135% 135% at 105% 115%,
        color-mix(in srgb, var(--panel-muted-border) 35%, transparent) 0%,
        transparent 78%
      );
    opacity: 0.5;
    pointer-events: none;
  }

  /* Ensure children are above pseudo-elements */
  .panel > *,
  .soft-card > * {
    position: relative;
    z-index: 1;
  }

  /* Ad Component */
  .ad {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-radius: var(--wc-radius-lg);
    border: 1px solid rgba(124, 58, 237, 0.2);
    background: transparent;
    padding: clamp(1.15rem, 3vw, 1.6rem);
    color: var(--ink-body);
  }

  .ad-shell {
    display: flex;
    justify-content: center;
  }

  .ad-shell > .ad {
    width: min(100%, 22rem);
  }

  .ad__label {
    margin: 0;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgba(212, 175, 55, 0.7);
  }

  .ad__frame {
    width: 100%;
  }

  .ad__frame > ins {
    display: block !important;
    width: 100% !important;
    min-height: 160px;
    border-radius: calc(var(--wc-radius-lg) - 0.6rem);
    overflow: hidden;
  }

  .ad__copy {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(244, 241, 255, 0.7);
  }

  .ad__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .ad__link {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    color: rgba(212, 175, 55, 0.85);
  }

  .ad__link:hover,
  .ad__link:focus-visible {
    color: rgba(212, 175, 55, 1);
    text-decoration-thickness: 2px;
  }

  .ad--side {
    align-items: stretch;
  }

  .ad--end,
  .ad--lead {
    align-items: flex-start;
  }

  /* Section Shell */
  .wc-section-shell {
    position: relative;
    isolation: isolate;
    padding: clamp(2rem, 5vw, 3.25rem);
    border-radius: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid color-mix(in srgb, var(--section-border) 78%, transparent 22%);
    background: 
      radial-gradient(
        120% 120% at 12% -20%,
        color-mix(in srgb, var(--section-glow) 85%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        110% 110% at 85% 0%,
        color-mix(in srgb, var(--section-highlight) 82%, transparent) 0%,
        transparent 78%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--section-surface-top) 92%, white 8%) 0%,
        color-mix(in srgb, var(--section-surface-bottom) 94%, white 6%) 100%
      );
    box-shadow: var(--wc-shadow-soft);
    color: var(--section-text);
    overflow: hidden;
  }

  .wc-section-shell::before {
    content: "";
    position: absolute;
    inset: -12% -8% -18%;
    border-radius: clamp(2.5rem, 6vw, 3.5rem);
    background: radial-gradient(
      135% 120% at 50% -20%,
      color-mix(in srgb, var(--section-veil) 78%, transparent) 0%,
      transparent 70%
    );
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .wc-section-shell > * {
    position: relative;
    z-index: 1;
  }

  /* Grimoire Card */
  .grimoire-card {
    position: relative;
    border-radius: var(--glass-panel-radius);
    border: 1px solid color-mix(in srgb, var(--glass-panel-border) 78%, transparent);
    background: 
      radial-gradient(
        125% 120% at 18% -8%,
        color-mix(in srgb, var(--glass-panel-overlay) 75%, transparent) 0%,
        transparent 68%
      ),
      radial-gradient(
        115% 115% at 82% -6%,
        color-mix(in srgb, var(--glass-panel-overlay) 55%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, rgba(255, 255, 255, 0.96) 88%, transparent) 0%,
        color-mix(in srgb, rgba(248, 244, 255, 0.92) 68%, transparent) 55%,
        color-mix(in srgb, rgba(243, 236, 231, 0.88) 82%, transparent) 100%
      );
    backdrop-filter: blur(calc(var(--glass-panel-blur) * 1.08));
    -webkit-backdrop-filter: blur(calc(var(--glass-panel-blur) * 1.08));
    box-shadow: var(--glass-panel-shadow);
    overflow: hidden;
  }

  .grimoire-card::before {
    content: "";
    position: absolute;
    inset: -18% -16% -28%;
    background: 
      radial-gradient(
        120% 120% at 12% -15%,
        color-mix(in srgb, var(--glow-iris, rgba(167, 139, 250, 0.35)) 82%, transparent) 0%,
        transparent 72%
      ),
      radial-gradient(
        145% 135% at 88% -12%,
        color-mix(in srgb, var(--glow-horizon, rgba(244, 219, 255, 0.32)) 78%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        160% 120% at 50% 112%,
        color-mix(in srgb, var(--glow-ember, rgba(91, 33, 182, 0.22)) 75%, transparent) 0%,
        transparent 72%
      );
    opacity: 0.65;
    mix-blend-mode: soft-light;
    pointer-events: none;
    z-index: 0;
  }

  .grimoire-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(80% 75% at 50% 15%, rgba(255, 255, 255, 0.55), transparent 68%),
      radial-gradient(100% 100% at 50% 120%, rgba(15, 23, 42, 0.08), transparent 70%);
    opacity: 0.75;
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: 0;
  }

  .grimoire-card > * {
    position: relative;
    z-index: 1;
  }
}

/* ---------------------------------------------------------------------------
   Custom Utilities
   --------------------------------------------------------------------------- */

@layer utilities {
  .shadow-1 {
    box-shadow: var(--elevation-tier-1);
  }

  .shadow-2 {
    box-shadow: var(--elevation-tier-2);
  }
}

/* ---------------------------------------------------------------------------
   Grimoire Background
   --------------------------------------------------------------------------- */

.grimoire-bg {
  position: relative;
  isolation: isolate;
  min-height: 100%;
  background: 
    radial-gradient(1200px 700px at 50% -10%, var(--wc-canvas-from), transparent 70%),
    linear-gradient(to bottom, var(--wc-canvas-from), var(--wc-canvas-to));
  background-repeat: no-repeat;
  background-size: cover;
}

.grimoire-bg::before {
  content: "";
  position: absolute;
  inset: -8% -10% -14%;
  background: var(--surface-starfield);
  box-shadow: inset 0 0 140px 70px rgb(var(--wc-canvas-vignette));
  opacity: 0.08;
  mix-blend-mode: multiply;
  pointer-events: none;
  z-index: 0;
}

.grimoire-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    135% 120% at 50% 10%,
    color-mix(in oklab, white 22%, var(--surface-tint) 18%) 0%,
    transparent 72%
  );
  opacity: 0.35;
  mix-blend-mode: screen;
  pointer-events: none;
  z-index: 0;
}

.grimoire-bg > * {
  position: relative;
  z-index: 1;
}
