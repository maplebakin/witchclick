/* ===========================================================================
   BASE STYLES - WitchClick
   Core design tokens, resets, and foundational styles
   =========================================================================== */

/* ---------------------------------------------------------------------------
   Design Tokens
   --------------------------------------------------------------------------- */

:root {
  /* Typography */
  --font-body-serif: "Lora", "Crimson Text", Georgia, serif;
  --font-body: var(--font-body-serif);
  --font-heading: "Cinzel", "Cormorant Garamond", "Times New Roman", serif;
  --font-accent: "Cormorant Garamond", "Cinzel", serif;
  --font-sans: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
  --font-body-ui: var(--font-body);
  --font-body-letter-spacing: normal;

  /* Spacing Scale */
  --space-0: 0;
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.5rem;
  --space-6: 2rem;
  --space-7: 2.5rem;
  --space-8: 3rem;
  --space-9: 4rem;

  /* Core Brand Colors */
  --color-midnight: #07020f;
  --color-night: #120725;
  --color-iris: #4b2a63;
  --color-amethyst: #7c4eb0;
  --color-dusk: #271534;
  --color-gold: #d4af37;
  --color-rune: #f8f3ff;
  --color-fog: #d7c8f3;
  --color-ink: #f4f1ff;
  --color-muted: rgba(244, 241, 255, 0.72);
  --color-border: rgba(125, 98, 162, 0.45);
  --color-border-strong: rgba(212, 175, 55, 0.65);
  --color-overlay: rgba(18, 7, 37, 0.48);
  --color-overlay-strong: rgba(18, 7, 37, 0.62);

  /* Surface Colors */
  --surface-plain: rgba(18, 10, 30, 0.92);
  --surface-plain-border: rgba(124, 78, 176, 0.32);
  --surface-plain-shadow: 0 24px 55px -28px rgba(3, 2, 12, 0.72);

  /* Accessible Text Colors - WCAG AA Compliant */
  --text-primary: rgba(244, 241, 255, 0.96); /* ~16:1 contrast */
  --text-secondary: rgba(244, 241, 255, 0.85); /* ~9:1 contrast */
  --text-tertiary: rgba(244, 241, 255, 0.75); /* ~6:1 contrast */
  --text-hint: rgba(244, 241, 255, 0.65); /* ~4.5:1 contrast */
  --text-disabled: rgba(244, 241, 255, 0.45); /* Disabled states only */

  /* Shadows */
  --shadow-soft: 0 18px 45px -28px rgba(11, 6, 20, 0.55);
  --shadow-strong: 0 28px 75px -24px rgba(3, 2, 12, 0.72);

  /* Semantic Colors (derived from core) */
  --ink-body: color-mix(in srgb, var(--color-ink) 70%, var(--color-night) 30%);
  --ink-strong: color-mix(in srgb, var(--color-ink) 85%, var(--color-night) 15%);
  --ink-muted: color-mix(in srgb, var(--color-ink) 55%, white 45%);
  --link-color: color-mix(in srgb, var(--color-fog) 55%, var(--color-gold) 45%);
  
  /* Focus Ring Styles */
  --focus-ring-color: color-mix(in srgb, var(--color-gold) 72%, white 28%);
  --focus-ring-offset: 4px;
  --focus-ring-base-shadow: color-mix(in srgb, var(--color-night) 70%, transparent 30%);
  --focus-ring-shadow: 
    0 0 0 2px var(--focus-ring-base-shadow),
    0 0 0 calc(var(--focus-ring-offset) + 2px) color-mix(in srgb, var(--focus-ring-color) 85%, white 15%);

  color-scheme: dark light;
}

/* Font Variant - Sans Serif */
:root[data-comfort-font="sans"] {
  --font-body-ui: var(--font-sans);
  --font-body-letter-spacing: 0.01em;
}

/* Dawn Theme (Light Mode) */
:root[data-comfort-theme="dawn"] {
  /* Core Brand Colors - Dawn Variants */
  --color-midnight: #f6f0e8;
  --color-night: #ede5dc;
  --color-iris: #9b86c8;
  --color-amethyst: #b49ad9;
  --color-dusk: #f2ecfa;
  --color-gold: #caa043;
  --color-rune: #fffdf6;
  --color-fog: #e5daf5;
  --color-ink: #2c1b3d;
  --color-muted: rgba(43, 28, 65, 0.88);
  --color-border: rgba(122, 94, 154, 0.35);
  --color-border-strong: rgba(122, 94, 154, 0.55);
  --color-overlay: rgba(242, 236, 229, 0.48);
  --color-overlay-strong: rgba(242, 236, 229, 0.6);

  /* Surface Colors - Dawn Variants */
  --surface-plain: rgba(252, 248, 242, 0.96);
  --surface-plain-border: rgba(155, 134, 200, 0.28);
  --surface-plain-shadow: 0 24px 50px -28px rgba(84, 62, 116, 0.18);

  /* Shadows - Dawn Variants */
  --shadow-soft: 0 18px 45px -28px rgba(63, 49, 86, 0.22);
  --shadow-strong: 0 28px 75px -24px rgba(63, 49, 86, 0.32);

  /* Semantic Colors - Dawn Variants */
  --ink-body: color-mix(in srgb, var(--color-ink) 80%, var(--color-night) 20%);
  --ink-strong: color-mix(in srgb, var(--color-ink) 90%, var(--color-night) 10%);
  --ink-muted: color-mix(in srgb, var(--color-ink) 60%, white 40%);
  --link-color: color-mix(in srgb, var(--color-iris) 45%, var(--color-gold) 55%);
  
  /* Focus Ring - Dawn Variants */
  --focus-ring-color: color-mix(in srgb, var(--color-iris) 58%, var(--color-gold) 42%);
  --focus-ring-base-shadow: color-mix(in srgb, var(--color-iris) 30%, var(--color-night) 70%);

  /* Accessible Text Colors - Dawn Variants (WCAG AA) */
  --text-primary: rgba(44, 27, 61, 1); /* ~16:1 contrast */
  --text-secondary: rgba(44, 27, 61, 0.9); /* ~10:1 contrast */
  --text-tertiary: rgba(44, 27, 61, 0.75); /* ~6.5:1 contrast */
  --text-hint: rgba(44, 27, 61, 0.6); /* ~4.5:1 contrast */
  --text-disabled: rgba(44, 27, 61, 0.4); /* Disabled states only */
}

/* ---------------------------------------------------------------------------
   CSS Reset (Modern)
   --------------------------------------------------------------------------- */

*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  margin: 0;
  min-width: 0;
}

html:focus-within {
  scroll-behavior: smooth;
}

/* Reduce Motion for Accessibility */
@media (prefers-reduced-motion: reduce) {
  html:focus-within {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  .blur-3xl,
  .blur-2xl,
  .blur-xl {
    filter: none !important;
  }
}

/* ---------------------------------------------------------------------------
   Base Element Styles
   --------------------------------------------------------------------------- */

body {
  min-height: 100vh;
  font-family: var(--font-body-ui, var(--font-body));
  line-height: 1.7;
  font-size: 1rem;
  color: var(--ink-body, #1f1633);
  letter-spacing: var(--font-body-letter-spacing, normal);
  background: #0f0820; /* Solid midnight background */
  background-attachment: fixed;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  transition: background-color 220ms ease, color 180ms ease;
}

:root[data-comfort-theme="dawn"] body {
  color: var(--ink-body, #2c1b3d);
  background: #f7f3f8; /* Solid dawn background */
}

/* Transparent overlay for solid backgrounds */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: transparent;
  z-index: -1;
}

:root[data-comfort-theme="dawn"] body::before {
  background: transparent;
}

body[data-menu-open="true"] {
  overflow: hidden;
}

/* Typography */
h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-heading);
  letter-spacing: 0.045em;
  color: var(--ink-strong, #1a102c);
  text-transform: uppercase;
}

h1 {
  font-size: clamp(2.5rem, 6vw, 3.75rem);
  line-height: 1.05;
}

h2 {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  line-height: 1.2;
}

h3 {
  font-size: clamp(1.35rem, 3vw, 1.9rem);
  line-height: 1.25;
}

p {
  max-width: 65ch;
}

small,
.text-sm {
  font-size: 0.875rem;
}

strong {
  color: var(--color-gold);
  font-weight: 600;
}

blockquote {
  margin: var(--space-6) 0;
  padding: var(--space-4) var(--space-5);
  border-left: 3px solid var(--color-gold);
  background: rgba(14, 6, 26, 0.6);
  border-radius: 0.75rem;
  color: var(--text-primary);
  font-style: italic;
}

:root[data-comfort-theme="dawn"] blockquote {
  background: rgba(242, 236, 229, 0.7);
  color: var(--text-primary);
}

/* Links */
a {
  color: var(--link-color);
  text-decoration: none;
  transition: color 160ms ease;
}

a:hover,
a:focus-visible {
  color: color-mix(in srgb, var(--focus-ring-color) 60%, var(--link-color) 40%);
}

/* Media Elements */
img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

/* Form Elements */
button,
input,
select,
textarea {
  font: inherit;
  color: inherit;
}

/* Main Content */
main {
  display: block;
}

/* ---------------------------------------------------------------------------
   Focus States
   --------------------------------------------------------------------------- */

:where(a, button, input, select, textarea, summary, [role="button"]):focus-visible {
  outline: 2px solid var(--focus-ring-color);
  outline-offset: var(--focus-ring-offset);
  box-shadow: var(--focus-ring-shadow);
}

.focus-ring {
  outline: none;
}

.focus-ring:focus-visible {
  outline: 2px solid var(--focus-ring-color);
  outline-offset: var(--focus-ring-offset);
  box-shadow: var(--focus-ring-shadow);
}

:focus-visible {
  outline: 2px solid var(--color-gold);
  outline-offset: 4px;
}

/* ---------------------------------------------------------------------------
   Layout Utilities
   --------------------------------------------------------------------------- */

.wc-container {
  width: min(100% - var(--space-6), 80rem);
  max-width: 84rem;
  margin-inline: auto;
}

@media (min-width: 768px) {
  .wc-container {
    width: min(100% - var(--space-6), 84rem);
  }
}

@media (min-width: 1024px) {
  .wc-container {
    width: min(100% - var(--space-7), 88rem);
  }
}

/* Ensure transparent backgrounds for nested containers */
.site-main__container,
.site-main__content {
  background-color: transparent !important;
}

/* ---------------------------------------------------------------------------
   Page-Specific Backgrounds
   --------------------------------------------------------------------------- */

/* 1. Homepage - Welcoming & Grounding */
.bg-home {
  background-color: #faf7f5;
  background-image: linear-gradient(135deg, #faf7f5 0%, #f5ebe0 50%, #fce4ec 100%);
  position: relative;
}

:root[data-comfort-theme="dawn"] .bg-home {
  background-color: #f6f0e8;
  background-image: linear-gradient(135deg, #f6f0e8 0%, #ede5dc 50%, #f2ecfa 100%);
}

/* Subtle noise texture */
.bg-noise {
  background-image: 
    repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0, 0, 0, 0.03) 2px, rgba(0, 0, 0, 0.03) 4px),
    repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0, 0, 0, 0.03) 2px, rgba(0, 0, 0, 0.03) 4px);
}

:root[data-comfort-theme="dawn"] .bg-noise {
  background-image: 
    repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0, 0, 0, 0.015) 2px, rgba(0, 0, 0, 0.015) 4px),
    repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0, 0, 0, 0.015) 2px, rgba(0, 0, 0, 0.015) 4px);
}

/* 2. Curses - Darker Symbolic Energy */
.bg-curses {
  background-color: #581c87;
  background-image: linear-gradient(180deg, #4c1d95 0%, #581c87 50%, #0f172a 100%);
  position: relative;
}

:root[data-comfort-theme="dawn"] .bg-curses {
  background-color: #9b86c8;
  background-image: linear-gradient(180deg, #b49ad9 0%, #9b86c8 50%, #6b5b95 100%);
}

/* Symbolic cross/sigil pattern */
.bg-sigil-pattern {
  background-image: 
    radial-gradient(circle at 20% 80%, rgba(217, 178, 196, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(217, 178, 196, 0.08) 0%, transparent 50%),
    repeating-conic-gradient(
      from 45deg at 50% 50%,
      transparent 0deg,
      transparent 85deg,
      rgba(139, 92, 246, 0.02) 85deg,
      rgba(139, 92, 246, 0.02) 95deg
    );
  background-size: 100% 100%, 100% 100%, 200px 200px;
}

:root[data-comfort-theme="dawn"] .bg-sigil-pattern {
  background-image: 
    radial-gradient(circle at 20% 80%, rgba(155, 134, 200, 0.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(202, 160, 67, 0.06) 0%, transparent 50%),
    repeating-conic-gradient(
      from 45deg at 50% 50%,
      transparent 0deg,
      transparent 85deg,
      rgba(122, 94, 154, 0.015) 85deg,
      rgba(122, 94, 154, 0.015) 95deg
    );
  background-size: 100% 100%, 100% 100%, 200px 200px;
}

/* Soft vignette for depth */
.bg-radial-vignette {
  background: radial-gradient(
    ellipse at center,
    transparent 0%,
    transparent 60%,
    rgba(0, 0, 0, 0.3) 100%
  );
}

/* 3. Entities - Moonlight & Mist */
.bg-entities {
  background-color: #1e293b;
  background-image: linear-gradient(180deg, #0f172a 0%, rgba(30, 27, 75, 0.8) 50%, #1e293b 100%);
  position: relative;
  overflow: hidden;
}

:root[data-comfort-theme="dawn"] .bg-entities {
  background-color: #e5daf5;
  background-image: linear-gradient(180deg, #f2ecfa 0%, #e5daf5 50%, #d7c8f3 100%);
}

/* Moonlight glow */
.bg-moon-glow {
  background: radial-gradient(
    ellipse at center,
    rgba(224, 231, 255, 0.4) 0%,
    rgba(165, 180, 252, 0.2) 40%,
    transparent 70%
  );
}

:root[data-comfort-theme="dawn"] .bg-moon-glow {
  background: radial-gradient(
    ellipse at center,
    rgba(155, 134, 200, 0.25) 0%,
    rgba(202, 160, 67, 0.12) 40%,
    transparent 70%
  );
}

/* Star field effect */
.bg-stars {
  background-image: 
    radial-gradient(1px 1px at 20% 30%, white, transparent),
    radial-gradient(1px 1px at 60% 70%, white, transparent),
    radial-gradient(1px 1px at 50% 50%, white, transparent),
    radial-gradient(1px 1px at 80% 10%, white, transparent),
    radial-gradient(1px 1px at 90% 60%, white, transparent),
    radial-gradient(0.5px 0.5px at 33% 80%, rgba(255, 255, 255, 0.5), transparent),
    radial-gradient(0.5px 0.5px at 15% 90%, rgba(255, 255, 255, 0.5), transparent);
  background-size: 200% 200%;
  background-position: 0% 0%, 40% 60%, 130% 270%, 70% 100%, 200% 50%, 110% 180%, 90% 240%;
}

:root[data-comfort-theme="dawn"] .bg-stars {
  background-image: 
    radial-gradient(1px 1px at 20% 30%, rgba(155, 134, 200, 0.4), transparent),
    radial-gradient(1px 1px at 60% 70%, rgba(202, 160, 67, 0.3), transparent),
    radial-gradient(1px 1px at 50% 50%, rgba(155, 134, 200, 0.35), transparent),
    radial-gradient(1px 1px at 80% 10%, rgba(202, 160, 67, 0.4), transparent),
    radial-gradient(1px 1px at 90% 60%, rgba(155, 134, 200, 0.3), transparent),
    radial-gradient(0.5px 0.5px at 33% 80%, rgba(122, 94, 154, 0.25), transparent),
    radial-gradient(0.5px 0.5px at 15% 90%, rgba(122, 94, 154, 0.2), transparent);
  background-size: 200% 200%;
  background-position: 0% 0%, 40% 60%, 130% 270%, 70% 100%, 200% 50%, 110% 180%, 90% 240%;
}

/* 4. Tools & Prints - Altar Meets Shop */
.bg-tools {
  background-color: #fefce8;
  position: relative;
}

:root[data-comfort-theme="dawn"] .bg-tools {
  background-color: #fffdf6;
}

/* Woven linen texture */
.bg-linen {
  background-image: 
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 2px,
      rgba(139, 92, 46, 0.02) 2px,
      rgba(139, 92, 46, 0.02) 4px
    ),
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(139, 92, 46, 0.015) 2px,
      rgba(139, 92, 46, 0.015) 4px
    );
}

:root[data-comfort-theme="dawn"] .bg-linen {
  background-image: 
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 2px,
      rgba(122, 94, 154, 0.015) 2px,
      rgba(122, 94, 154, 0.015) 4px
    ),
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(122, 94, 154, 0.01) 2px,
      rgba(122, 94, 154, 0.01) 4px
    );
}

/* Radial gradient helper */
.bg-gradient-radial {
  background: radial-gradient(circle, currentColor 0%, transparent 70%);
}

/* 5. Salon - Tea & Ink Study */
.bg-salon {
  background-color: #f5f5f4;
  background-image: linear-gradient(135deg, #f5f5f4 0%, #fafaf9 40%, #f1f5f9 100%);
  position: relative;
}

:root[data-comfort-theme="dawn"] .bg-salon {
  background-color: #fafaf9;
  background-image: linear-gradient(135deg, #fafaf9 0%, #f5f5f4 40%, #f2ecfa 100%);
}

/* Ink wash effect */
.bg-ink-wash {
  background: radial-gradient(
    ellipse at top,
    rgba(71, 85, 105, 0.15) 0%,
    rgba(100, 116, 139, 0.08) 40%,
    transparent 70%
  );
}

:root[data-comfort-theme="dawn"] .bg-ink-wash {
  background: radial-gradient(
    ellipse at top,
    rgba(155, 134, 200, 0.08) 0%,
    rgba(122, 94, 154, 0.04) 40%,
    transparent 70%
  );
}

/* Fine grain texture */
.bg-grain {
  background-image: repeating-radial-gradient(
    circle at 0 0,
    transparent 0,
    rgba(0, 0, 0, 0.1) 1px,
    transparent 2px
  );
  background-size: 4px 4px;
}

:root[data-comfort-theme="dawn"] .bg-grain {
  background-image: repeating-radial-gradient(
    circle at 0 0,
    transparent 0,
    rgba(122, 94, 154, 0.05) 1px,
    transparent 2px
  );
  background-size: 4px 4px;
}

/* ---------------------------------------------------------------------------
   Card Metadata Styles
   --------------------------------------------------------------------------- */

.card-metadata {
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-tertiary);
}

.card-metadata span::before {
  content: "✹";
  margin-right: 0.35rem;
  color: var(--color-gold);
}

/* ---------------------------------------------------------------------------
   Responsive Navigation
   --------------------------------------------------------------------------- */

@media (max-width: 920px) {
  .site-nav__list {
    display: none;
  }

  .site-nav__toggle {
    display: inline-flex;
  }
}

@media (min-width: 921px) {
  .site-nav__toggle {
    display: none;
  }

  .site-nav__mobile {
    display: none;
  }

  .site-nav__actions {
    display: flex;
  }
}
