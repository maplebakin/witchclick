{
  "name": "witchclick",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-with-api.mjs",
    "dev:host": "HOST=0.0.0.0 node ./scripts/dev-with-api.mjs",
    "dev:all": "node ./scripts/dev-with-api.mjs",
    "prebuild": "node ./scripts/ensure-npm-proxy.mjs && node ./scripts/generate-theme-css.mjs",
    "build": "node --import tsx ./scripts/build-post-cache.mjs && node ./scripts/build-clean.mjs && node ./scripts/generate-sitemap.mjs && node ./scripts/verify-no-draft-leaks.mjs",
    "build:public": "npm run build && node ./scripts/prune-nonpublic.mjs",
    "ingest:quick": "node ./scripts/ingest.mjs",
    "drafts:sync": "node ./scripts/drafts-sync.mjs",
    "postbuild": "echo '✅ Build complete with sitemap'",
    "preview": "astro preview",
    "format": "prettier -w .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs,.mjs,.astro",
    "check": "astro check && tsc -p . --noEmit && npm run lint",
    "check:links": "npm run linkcheck",
    "check:prepub": "npm run check && npm run build:public && npm run check:links",
    "audit:seo": "node scripts/audit-seo.mjs",
    "check:affiliates": "node ./scripts/check-affiliate-ids.mjs",
    "themes:lint": "node ./scripts/themes-lint.mjs",
    "test:e2e": "playwright test",
    "linkcheck": "node ./scripts/check-internal-links.mjs",
    "themes:build": "node ./scripts/generate-theme-css.mjs",
    "themes:watch": "node ./scripts/generate-theme-css.mjs --watch",
    "genprompt": "node ./tools/wc.js genprompt",
    "ingest": "node ./scripts/ingest.mjs",
    "curses": "node ./tools/wc.js curses",
    "ingest:curses": "node ./tools/wc.js curses:ingest",
    "export:curses": "node ./tools/wc.js curses:export",
    "ship": "bash ./scripts/ship.sh",
    "zip": "zip -r witchclick-backup.zip . -x \"node_modules/*\" \".git/*\" \"dist/*\"",
    "tools:export:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "@sentry/browser": "^8.41.0",
    "astro": "^5.15.2",
    "dompurify": "^3.3.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.0.0",
    "marked": "^16.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/node": "^9.5.0",
    "@astrojs/sitemap": "^3.6.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.18.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "astro-eslint-parser": "^1.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.16.0",
    "eslint-plugin-astro": "^0.33.1",
    "linkinator": "^6.1.2",
    "playwright": "^1.49.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  }
}
